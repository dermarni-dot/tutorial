			local rainbow = { Color3.fromRGB(255, 70, 90), Color3.fromRGB(255, 180, 50), Color3.fromRGB(255, 240, 80), Color3.fromRGB(80, 230, 120), Color3.fromRGB(70, 170, 255), Color3.fromRGB(190, 100, 255) }
