	add("Belly", "Blob", Vector3.new(T.X * 0.7, T.Y * 0.7, S * 0.2), CFrame.new(0, -T.Y * 0.05, -T.Z * 0.42), ctx.light)
	for _, sx in ipairs({ -1, 1 }) do
