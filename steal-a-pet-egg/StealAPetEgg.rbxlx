		headAdd("InnerEar", "Cyl", Vector3.new(H * 0.05, H * 0.36, H * 0.36), CFrame.new(sx * H * 0.36, H * 0.42, 0) * CFrame.Angles(0, math.rad(90 - 20 * sx), 0), BLUSH)
	end
	local prev = CFrame.new(0, -ctx.T.Y * 0.1, ctx.T.Z * 0.5)
	for i = 1, 5 do
