      <Item class="ModuleScript" referent="45">
        <Properties>
          <string name="Name">BodySurfaces</string>
          <string name="Source"><![CDATA[-- BodySurfaces (v16): the skin surface maps on the muscle-tier body parts. Each swapped full-detail part gets a clone
-- of the authored SurfaceAppearance for its (surface tier, part type): a tangent-space NormalMap (pores, striations,
-- veins, creases), a near-white greyscale ColorMap (the ambient occlusion and cavity) and a RoughnessMap.
--
-- * Scripts may not write a SurfaceAppearance's ColorMap / NormalMap / RoughnessMap (PluginSecurity), so the maps are
--   authored into the place by Rojo (BodySurfaceSet.model.json -> ReplicatedStorage.Shared.BodySurfaceSet.T<n>.<Part>,
--   generated by tools/body/publish_skin.py) and cloned here; Color and AlphaMode are script-writable.
-- * Skin tone: SurfaceAppearance.Color tints the ColorMap (a multiplier; the map is white where nothing is occluded),
--   and the MeshPart's own Color no longer shows once a SurfaceAppearance with an opaque ColorMap covers it. So the
--   clone's Color follows the part's Color: set at the swap, and kept in step by a Color-changed connection (any code
--   that recolours the part - the skin tone, a flush - recolours the tint too).
-- * Sharing: one set per (surface tier, part type) serves every frame (the UVs and the grooves' places are the same on
--   every frame); a frame's surface tier is its body tier minus BodySurfaceData.shift[frame] (Power Build one softer,
--   Heavyweight Build two). Left limbs share the right limb's set. Hands, feet and the LowerTorso (gloves / wraps,
--   boots, trunks) and every lite (crowd) part get none.
local Shared = script.Parent

local BodySurfaces = {}

local okData, Data = pcall(function()
	return require(Shared:FindFirstChild("BodySurfaceData"))
end)
if not okData or type(Data) ~= "table" then
	Data = { shift = {}, parts = {}, tiers = {} }
end
BodySurfaces.Data = Data

BodySurfaces.NAME = "BodySkin"
BodySurfaces.BASE = {
	UpperTorso = "UpperTorso",
	LeftUpperArm = "UpperArm",
	RightUpperArm = "UpperArm",
	LeftLowerArm = "LowerArm",
	RightLowerArm = "LowerArm",
	LeftUpperLeg = "UpperLeg",
	RightUpperLeg = "UpperLeg",
	LeftLowerLeg = "LowerLeg",
	RightLowerLeg = "LowerLeg",
}

local source = nil -- a test (or a tool) may hand over its own folder of T<n> folders
function BodySurfaces.SetSource(folder)
	source = folder
end

local function setFolder()
	if source then
		return source
	end
	return Shared:FindFirstChild("BodySurfaceSet")
end
BodySurfaces.Folder = setFolder

-- the surface tier a part of body tier `tier` on `frame` wears
function BodySurfaces.TierFor(frame, tier)
	tier = tonumber(tier) or 0
	if tier < 1 then
		return nil
	end
	local shift = (Data.shift and Data.shift[frame]) or 0
	return math.max(1, tier - shift)
end

-- the authored SurfaceAppearance for (body tier, part name, frame), or nil
function BodySurfaces.Template(tier, partName, frame)
	local base = BodySurfaces.BASE[partName]
	local st = base and BodySurfaces.TierFor(frame, tier)
	local f = st and setFolder()
	local tf = f and f:FindFirstChild("T" .. st)
	local sa = tf and tf:FindFirstChild(base)
	if sa and sa:IsA("SurfaceAppearance") then
		return sa
	end
	return nil
end

local function follow(part, sa)
	sa.Color = part.Color
	part:GetPropertyChangedSignal("Color"):Connect(function()
		if sa.Parent == part then
			sa.Color = part.Color
		end
	end)
end

-- gives a swapped body part its skin surface (or takes it off: a lite part, a part type without maps, no authored set);
-- reads the part's BodyTier / BodyFrame / BodyLite attributes. Returns the SurfaceAppearance or nil
function BodySurfaces.Attach(part)
	if not (part and part:IsA("BasePart")) then
		return nil
	end
	local old = part:FindFirstChild(BodySurfaces.NAME)
	if old then
		old:Destroy()
	end
	if part:GetAttribute("BodyLite") then
		return nil
	end
	local t = BodySurfaces.Template(part:GetAttribute("BodyTier"), part.Name, part:GetAttribute("BodyFrame"))
	if not t then
		return nil
	end
	local sa = t:Clone()
	sa.Name = BodySurfaces.NAME
	follow(part, sa)
	sa.Parent = part
	return sa
end

-- every body part's tint back on its part's Color (after a bulk recolour that bypassed the connection, e.g. a clone)
function BodySurfaces.Sync(model)
	for name in pairs(BodySurfaces.BASE) do
		local p = model and model:FindFirstChild(name)
		local sa = p and p:FindFirstChild(BodySurfaces.NAME)
		if sa then
			sa.Color = p.Color
		end
	end
end

return BodySurfaces
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="46">
        <Properties>
          <string name="Name">BodyTiers</string>
          <string name="Source"><![CDATA[-- BodyTiers: the pure half of the standard R15 body (tools/body/CONTRACT.md). No Instances, deterministic, so
-- the server (BuilderTiers swaps the parts), the client (FaceFX swaps the face texture), the Creator and the
-- lune tests read the same rules.
-- * the muscle tiers: every one of the 14 non-head body parts shows one of 5 Blender-modelled tiers (1 lean,
--   2 toned, 3 athletic, 4 muscular, 5 elite) picked from the boxer's build: the muscles that part carries
--   (MAP), each read as Body.Resolve reads it (the value against the frame's potential), averaged into a
--   level, and the level cut into tiers (BANDS) with a little hysteresis so a part never flickers at a
--   boundary. Hands follow their forearm, feet their calf (FOLLOW)
-- * the body frames (v12): every Config.BodyTypes frame has its own family of the 5 tiers (BodyAssetData.frames,
--   keyed by the frame id; the Athletic frame is the default family, BodyAssetData.tiers): a Lean frame's narrow
--   shoulders and a Power Build's traps are in the meshes, not only in the description's Width / Depth. The tiers
--   table a build gives carries the frame (tiers.frame, FrameOf: the opts' frame id, else the BodyTypes entry whose
--   potential the caller passed), and PartEntry(tier, name, d, lite, frame) picks that family's part (the default
--   family's when the frame has none uploaded; the lite set is one per tier, the default family's)
-- * the classic faces: BodyAssetData.faces (a key, a name, an Image id, creator = shown in the picker), the
--   default smile, the face key sanitiser (look.face.key) and the texture a key draws (rbxassetid, or the
--   engine's own smile while an id is 0)
-- * the expressions: the game's mood drivers (the Expr attribute names, the transient hit / effort / shout
--   layers) -> BodyAssetData.expressions moods -> a face key; nil = the boxer's own face
-- BodyAssetData is generated (tools/body/publish_body.py); every id 0 means "not uploaded" and every path
-- here then falls back to the default body part / the default smile.
local BodyTiers = {}

BodyTiers.PARTS = {
	"UpperTorso", "LowerTorso", "LeftUpperArm", "LeftLowerArm", "LeftHand", "RightUpperArm", "RightLowerArm",
	"RightHand", "LeftUpperLeg", "LeftLowerLeg", "LeftFoot", "RightUpperLeg", "RightLowerLeg", "RightFoot",
}
BodyTiers.TIERS = 5
BodyTiers.TIER_NAMES = { "Lean", "Toned", "Athletic", "Muscular", "Elite" }
-- the frame whose family BodyAssetData.tiers holds (the gear is fitted on it)
BodyTiers.DEFAULT_FRAME = "Athletic"

-- the muscles each body part carries (Config.MuscleParts ids, weights sum to 1); Left / Right share a group
BodyTiers.MAP = {
	UpperTorso = { pecs = 0.22, upperChest = 0.14, lats = 0.18, upperBack = 0.1, traps = 0.1, abs = 0.14, obliques = 0.06, serratus = 0.06 },
	LowerTorso = { lowerAbs = 0.25, obliques = 0.15, glutes = 0.4, lowerBack = 0.2 },
	UpperArm = { biceps = 0.34, triceps = 0.34, frontDelt = 0.1, sideDelt = 0.16, rearDelt = 0.06 },
	LowerArm = { forearms = 1 },
	UpperLeg = { quads = 0.55, hamstrings = 0.3, glutes = 0.15 },
	LowerLeg = { calves = 1 },
}
-- parts with no muscle group of their own take their limb's tier
BodyTiers.FOLLOW = { Hand = "LowerArm", Foot = "LowerLeg" }
-- level (0 .. ~1.15) where tier 2, 3, 4 and 5 begin. An untrained boxer (8 in every muscle) reads ~0.08: tier 1;
-- a muscle at half its frame's cap ~0.5: tier 3; tier 5 from ~80 % of the cap (Athletic: 76 of 95)
BodyTiers.BANDS = { 0.18, 0.36, 0.56, 0.78 }
-- a part keeps its tier until its level leaves the band by this much (no flicker on a 0.04 level step)
BodyTiers.HYST = 0.03
-- women's levels (the tiers are modelled on the men's default rig): elite needs more work
BodyTiers.FEMALE_K = 0.8
-- the untrained value Config.PartValue gives a missing muscle
local UNTRAINED = 8

-- "LeftUpperArm" -> "UpperArm", "UpperTorso" -> "UpperTorso"
function BodyTiers.Group(name)
	local g = string.match(name, "^Left(.+)$") or string.match(name, "^Right(.+)$") or name
	return g
end

local function num(v, d)
	v = tonumber(v)
	if v == nil or v ~= v or v == math.huge or v == -math.huge then
		return d
	end
	return v
end

-- a sub-muscle's value (Config.PartValue's rule without needing Config: the part, else its group, else 8)
local GROUP_OF = {
	pecs = "chest", upperChest = "chest", frontDelt = "shoulders", sideDelt = "shoulders", rearDelt = "shoulders",
	biceps = "arms", triceps = "arms", forearms = "arms", lats = "back", traps = "back", upperBack = "back",
	lowerBack = "back", abs = "core", lowerAbs = "core", obliques = "core", serratus = "core", quads = "legs",
	hamstrings = "legs", glutes = "legs", calves = "legs", neckSCM = "neck",
}
local function partValue(build, id)
	if type(build) ~= "table" then
		return UNTRAINED
	end
	local v = tonumber(build[id])
	if v == nil then
		v = tonumber(build[GROUP_OF[id] or id])
	end
	return num(v, UNTRAINED)
end
BodyTiers.PartValue = partValue

-- one muscle's level as Body.Resolve reads it: value / 100, half of the frame's potential normalised back out
-- (a maxed Lean frame still looks trained, a maxed Heavyweight frame still out-sizes it)
function BodyTiers.MuscleLevel(build, id, potential, female)
	local pot = math.max(num(potential, 0.95), 0.2)
	local v = partValue(build, id) / 100 * (0.55 + 0.45 / pot)
	if female then
		v *= BodyTiers.FEMALE_K
	end
	return math.clamp(v, 0, 1.5)
end

-- { [group] = level } for the six muscle groups of MAP; opts = { potential = BodyTypes potential, female }
function BodyTiers.GroupLevels(build, opts)
	opts = type(opts) == "table" and opts or {}
	local out = {}
	for g, w in pairs(BodyTiers.MAP) do
		local t = 0
		for id, k in pairs(w) do
			t += k * BodyTiers.MuscleLevel(build, id, opts.potential, opts.female)
		end
		out[g] = t
	end
	return out
end

-- level -> tier 1..5; prev (optional) = the tier the part shows now (hysteresis)
function BodyTiers.TierOf(level, prev)
	level = num(level, 0)
	local B, H = BodyTiers.BANDS, BodyTiers.HYST
	local t = 1
	for i, b in ipairs(B) do
		if level >= b then
			t = i + 1
		end
	end
	prev = tonumber(prev)
	if prev and prev >= 1 and prev <= BodyTiers.TIERS and prev ~= t then
		prev = math.floor(prev)
		-- the band prev covers: [lo, hi); stay while the level is within HYST of it
		local lo = prev > 1 and B[prev - 1] or -math.huge
		local hi = prev <= #B and B[prev] or math.huge
		if level >= lo - H and level < hi + H then
			return prev
		end
	end
	return t
end

-- Config (lazily; the client and the tests load this module without it)
local cfgMod
local function config()
	if cfgMod == nil then
		local here = script and script.Parent
		local m = here and here:FindFirstChild("Config")
		local ok, cfg = false, nil
		if m then
			ok, cfg = pcall(require, m)
		end
		cfgMod = (ok and type(cfg) == "table") and cfg or false
	end
	return cfgMod or nil
end
-- tests / tools: the Config table to read BodyTypes from (nil: the module again)
function BodyTiers.SetConfig(c)
	cfgMod = c
end

-- the frame id a Tiers() call is for: opts.frame when it is a string, else the Config.BodyTypes entry whose potential
-- is opts.potential (Builder passes the frame's potential), else the default frame
function BodyTiers.FrameOf(opts)
	opts = type(opts) == "table" and opts or {}
	if type(opts.frame) == "string" and opts.frame ~= "" then
		return opts.frame
	end
	local pot = tonumber(opts.potential)
	local cfg = config()
	if pot and cfg and type(cfg.BodyTypes) == "table" then
		for _, bt in ipairs(cfg.BodyTypes) do
			if type(bt) == "table" and tonumber(bt.potential) and math.abs(bt.potential - pot) < 1e-6 then
				return bt.id
			end
		end
	end
	return BodyTiers.DEFAULT_FRAME
end

-- { [part name] = tier } for all 14 parts, plus .frame = the frame id (FrameOf). prev (optional): { [part name] =
-- current tier } or a function (name) -> current tier
function BodyTiers.Tiers(build, opts, prev)
	local lv = BodyTiers.GroupLevels(build, opts)
	local function prevOf(name)
		if type(prev) == "function" then
			return prev(name)
		elseif type(prev) == "table" then
			return prev[name]
		end
		return nil
	end
	local out = {}
	-- the muscle groups first, then the parts that follow them (a hand with its forearm's tier)
	for _, name in ipairs(BodyTiers.PARTS) do
		local g = BodyTiers.Group(name)
		if lv[g] then
			out[name] = BodyTiers.TierOf(lv[g], prevOf(name))
		end
	end
	for _, name in ipairs(BodyTiers.PARTS) do
		local g = BodyTiers.Group(name)
		local f = BodyTiers.FOLLOW[g]
		if f then
			local side = string.match(name, "^(Left)") or string.match(name, "^(Right)") or ""
			out[name] = out[side .. f] or 1
		end
	end
	out.frame = BodyTiers.FrameOf(opts)
	return out, lv
end

-- compact signature of a tier table (the model attribute BodyTiers): one digit per part in PARTS order
function BodyTiers.Key(tiers)
	local s = table.create(#BodyTiers.PARTS)
	for i, name in ipairs(BodyTiers.PARTS) do
		s[i] = tostring(math.clamp(math.floor(num(tiers and tiers[name], 0)), 0, 9))
	end
	return table.concat(s)
end

------------------------------------------------------------------------
-- BodyAssetData
------------------------------------------------------------------------
local data -- the loaded table (or a test's)
local function load()
	if data == nil then
		local ok, res = false, nil
		local here = script and script.Parent
		local m = here and here:FindFirstChild("BodyAssetData")
		if m then
			ok, res = pcall(require, m)
		end
		data = (ok and type(res) == "table") and res or {}
	end
	return data
end
function BodyTiers.Data()
	return load()
end
-- tests / tools: use this table instead of the module (nil: load the module again)
function BodyTiers.SetData(d)
	data = d
end

local function idOf(v)
	local n = tonumber(v)
	return (n and n > 0) and math.floor(n) or nil
end
BodyTiers.Id = idOf

local function vec3(t)
	if type(t) ~= "table" then
		return nil
	end
	local x, y, z = tonumber(t[1] or t.x or t.X), tonumber(t[2] or t.y or t.Y), tonumber(t[3] or t.z or t.Z)
	if not (x and y and z) then
		return nil
	end
	return { x, y, z }
end
BodyTiers.Vec3 = vec3

-- the tier table of a frame's family: BodyAssetData.frames[frame].tiers, or the default family (BodyAssetData.tiers)
-- when the frame is the default one, unknown or has no meshes. Returns tiers, the frame id the family belongs to
local function familyOf(d, frame)
	local fr = type(d) == "table" and type(d.frames) == "table" and type(frame) == "string" and d.frames[frame] or nil
	if type(fr) == "table" and type(fr.tiers) == "table" then
		return fr.tiers, frame
	end
	return type(d) == "table" and type(d.tiers) == "table" and d.tiers or nil, BodyTiers.DEFAULT_FRAME
end
local function tierOf(tiers, tier)
	return tiers and (tiers[tier] or tiers[tostring(tier)]) or nil
end

-- the frame ids with a mesh family in the data (the default frame first, then BodyAssetData.frames' keys, sorted)
function BodyTiers.Frames(d)
	d = d or load()
	local out = { BodyTiers.DEFAULT_FRAME }
	local names = {}
	if type(d) == "table" and type(d.frames) == "table" then
		for k, v in pairs(d.frames) do
			if type(k) == "string" and k ~= BodyTiers.DEFAULT_FRAME and type(v) == "table" and type(v.tiers) == "table" then
				table.insert(names, k)
			end
		end
	end
	table.sort(names)
	for _, k in ipairs(names) do
		table.insert(out, k)
	end
	return out
end

-- true when the frame has its own mesh family (false: it wears the default family)
function BodyTiers.HasFrame(frame, d)
	local _, fid = familyOf(d or load(), frame)
	return fid == frame
end

-- the frame's folder key (tools/body/out/frames/<key>; nil for the default family)
function BodyTiers.FrameKey(frame, d)
	d = d or load()
	local fr = type(d) == "table" and type(d.frames) == "table" and type(frame) == "string" and d.frames[frame] or nil
	return type(fr) == "table" and type(fr.key) == "string" and fr.key or nil
end

-- the frame's gear scale on a body part base ("UpperLeg", "Hand", ...): the factors the frame's part is the default
-- family's part scaled by (BodyAssetData.frames[id].gearScale; the trunks, gloves and boots fitted on the default
-- family follow them, BuilderGear). { x, y, z }; 1, 1, 1 for the default family / an unknown frame
function BodyTiers.GearScale(frame, base, d)
	d = d or load()
	local fr = type(d) == "table" and type(d.frames) == "table" and type(frame) == "string" and d.frames[frame] or nil
	local g = type(fr) == "table" and type(fr.gearScale) == "table" and fr.gearScale[base] or nil
	return vec3(g) or { 1, 1, 1 }
end

-- the frame's rig heights (BodyAssetData.frames[id].unit: joints, hipHeight, shoulderHeight, neckHeight, the frame's
-- head (studs) and headScale, standingHeight = neckHeight + head), the default family's unit for the default frame /
-- an unknown one. Builder.Scales normalises the HeightScale from neckHeight and the head so every frame stands the
-- chosen height (v13)
function BodyTiers.Unit(frame, d)
	d = d or load()
	local fr = type(d) == "table" and type(d.frames) == "table" and type(frame) == "string" and d.frames[frame] or nil
	if type(fr) == "table" and type(fr.unit) == "table" then
		return fr.unit
	end
	return type(d) == "table" and d.unit or nil
end

-- a tier part's entry: { id, size = {x,y,z}, attachments = { [name] = {x,y,z} }, tier, name, frame, lite }, or nil
-- when the mesh is not uploaded (id 0) or the entry is malformed (the default body part stays). lite = true: the
-- part's `lite` mesh (the v9 set the low detail level wears, Config.Detail.meshes), its own size and attachments; the
-- full mesh when the entry has no usable lite one. frame = the frame id (BodyAssetData.frames): that family's part,
-- the default family's when the frame has none; the lite set is the default family's at every frame
function BodyTiers.PartEntry(tier, name, d, lite, frame)
	d = d or load()
	local tiers, fid = familyOf(d, frame)
	local t = tierOf(tiers, tier)
	local parts = type(t) == "table" and type(t.parts) == "table" and t.parts or nil
	local e = parts and parts[name]
	if type(e) ~= "table" then
		return nil
	end
	local isLite = false
	if lite then
		local le = e.lite
		if not (type(le) == "table" and idOf(le.mesh) and vec3(le.size)) and fid ~= BodyTiers.DEFAULT_FRAME then
			-- (the frames carry no lite set: the default family's lite part)
			local dt = tierOf(type(d) == "table" and d.tiers or nil, tier)
			local de = type(dt) == "table" and type(dt.parts) == "table" and dt.parts[name] or nil
			le = type(de) == "table" and de.lite or nil
		end
		if type(le) == "table" and idOf(le.mesh) and vec3(le.size) then
			e, isLite, fid = le, true, BodyTiers.DEFAULT_FRAME
		end
	end
	local id = idOf(e.mesh)
	local size = vec3(e.size)
	if not (id and size) or size[1] <= 0 or size[2] <= 0 or size[3] <= 0 then
		return nil
	end
	local atts = {}
	if type(e.attachments) == "table" then
		for k, v in pairs(e.attachments) do
			local p = type(k) == "string" and vec3(v)
			if p then
				atts[k] = p
			end
		end
	end
	-- (v17) core = the body's own box (the UpperTorso without its shoulder caps; = size otherwise): what the game
	-- reads as the torso's width (BodyTiers.CoreSize)
	local core = (not isLite and vec3(e.core)) or size
	return { id = id, size = size, core = core, attachments = atts, tier = tier, name = name, lite = isLite, frame = fid }
end

-- (v17) the body's own size of a part: the UpperTorso's mesh box includes the shoulder caps over the arms' domes, which
-- are not the torso's width; BuilderTiers sets BodyCoreSize (scaled like Size). Any other part, or a part without the
-- attribute: its Size
function BodyTiers.CoreSize(part)
	local c = part and part:GetAttribute("BodyCoreSize")
	if typeof(c) == "Vector3" then
		return c
	end
	return part and part.Size
end

-- a tier's gear-fit measure (BodyAssetData tiers[n].fit[key]: { width, depth, girth, y }, unscaled studs), or nil;
-- frame (optional) = that frame's family's measure
function BodyTiers.Fit(tier, key, d, frame)
	d = d or load()
	local tiers = familyOf(d, frame)
	local t = tierOf(tiers, tier)
	local f = type(t) == "table" and type(t.fit) == "table" and t.fit[key] or nil
	if type(f) == "table" and tonumber(f.width) and tonumber(f.depth) then
		return f
	end
	return nil
end

------------------------------------------------------------------------
-- Faces
------------------------------------------------------------------------
BodyTiers.DEFAULT_FACE = "smile" -- (BodyAssetData.defaultFace)
-- the engine's own classic smile (what an id 0 draws)
BodyTiers.DEFAULT_TEXTURE = "rbxasset://textures/face.png"

-- Face styles (look.face.style): one of the drawn Boxer faces (the user's pack, tools/body/faces.py PACK): the head
-- wears that drawn face as its front Decal, and FaceFX swaps it for a mood face by mood (STYLE_MOODS). Every boxer
-- has one (DefaultStyle). "built" = the face BuilderHead builds from parts: no longer a player option, only the
-- emergency fallback while no drawn face is uploaded (old "built" saves read as the default drawn face)
BodyTiers.BUILT_STYLE = "built"
-- the resting faces a boxer can wear (the Creator offers them, in this order): the user's four, then the faces
-- drawn after them in the same style (tools/body/wcb_faces_draw.py)
BodyTiers.STYLE_KEYS = {
	"wcb_neutral", "wcb_focused", "wcb_smirk", "wcb_grit",
	"wcb_confident", "wcb_grin", "wcb_cool", "wcb_wink", "wcb_stern", "wcb_determined", "wcb_toothy", "wcb_scarred",
}
-- faces only a mood shows (FaceFX, STYLE_MOODS): never a boxer's chosen face
BodyTiers.STYLE_MOOD_KEYS = { "wcb_shout", "wcb_hurt", "wcb_dazed", "wcb_ko", "wcb_tired", "wcb_surprised" }
-- every drawn face key (resting first); RESTING marks the ones a look may keep
BodyTiers.STYLE_INDEX = {}
BodyTiers.STYLE_RESTING = {}
for i, k in ipairs(BodyTiers.STYLE_KEYS) do
	BodyTiers.STYLE_INDEX[k] = i
	BodyTiers.STYLE_RESTING[k] = true
end
for i, k in ipairs(BodyTiers.STYLE_MOOD_KEYS) do
	BodyTiers.STYLE_INDEX[k] = #BodyTiers.STYLE_KEYS + i
end

-- the face list (always starts with the smile, even when the data has none)
function BodyTiers.Faces(d)
	d = d or load()
	local out, seen = {}, {}
	local list = type(d) == "table" and type(d.faces) == "table" and d.faces or {}
	for _, f in ipairs(list) do
		if type(f) == "table" and type(f.key) == "string" and f.key ~= "" and not seen[f.key] then
			seen[f.key] = true
			table.insert(out, { key = f.key, name = type(f.name) == "string" and f.name or f.key, id = idOf(f.id), creator = f.creator ~= false })
		end
	end
	if not seen[BodyTiers.DEFAULT_FACE] then
		table.insert(out, 1, { key = BodyTiers.DEFAULT_FACE, name = "Smile", id = nil, creator = true })
	end
	return out
end

function BodyTiers.Face(key, d)
	for _, f in ipairs(BodyTiers.Faces(d)) do
		if f.key == key then
			return f
		end
	end
	return nil
end

-- the faces a player picks from in the Creator (creator ~= false); the smile first. The drawn face STYLES
-- (STYLE_KEYS below) are whole-face alternatives to the built face (look.face.style), never a face.key
function BodyTiers.Pickable(d)
	local out = {}
	for _, f in ipairs(BodyTiers.Faces(d)) do
		if f.creator and not BodyTiers.STYLE_INDEX[f.key] then
			table.insert(out, f)
		end
	end
	return out
end

-- look.face.key from untrusted input: a pickable key, else the old (saved) key when that is valid, else the smile
function BodyTiers.SanitizeFace(key, old, d)
	local function ok(k)
		if type(k) ~= "string" then
			return false
		end
		local f = BodyTiers.Face(k, d)
		return f ~= nil and f.creator and not BodyTiers.STYLE_INDEX[k]
	end
	if ok(key) then
		return key
	elseif ok(old) then
		return old
	end
	return BodyTiers.DEFAULT_FACE
end

-- the Decal texture of a face key: its uploaded image, else the engine's smile
function BodyTiers.FaceTexture(key, d)
	local f = type(key) == "string" and BodyTiers.Face(key, d) or nil
	if f and f.id then
		return "rbxassetid://" .. f.id
	end
	if key ~= BodyTiers.DEFAULT_FACE then
		local s = BodyTiers.Face(BodyTiers.DEFAULT_FACE, d)
		if s and s.id then
			return "rbxassetid://" .. s.id
		end
	end
	return BodyTiers.DEFAULT_TEXTURE
end

------------------------------------------------------------------------
-- Expressions
------------------------------------------------------------------------
-- the game's expression drivers (Config.Expressions: the server's Expr attribute, ExprPreview, the Animator's
-- hints, and FaceFX's transient layers hit / effort / shout) -> a BodyAssetData.expressions mood
BodyTiers.MOODS = {
	neutral = "neutral", confident = "confident", determined = "attack", anger = "angry", fear = "surprised",
	fatigue = "tired", pain = "hurt", dazed = "dazed", effort = "effort", happy = "happy", ko = "ko",
	-- FaceFX's transient layers
	hit = "hurt", shout = "angry", down = "stunned",
}

function BodyTiers.MoodOf(expr)
	if type(expr) ~= "string" then
		return "neutral"
	end
	return BodyTiers.MOODS[expr] or (type((load().expressions or {})[expr]) == "string" and expr) or "neutral"
end

-- the face key a mood shows: the expressions table's face (when it exists and is uploaded), else the boxer's own
function BodyTiers.MoodFace(mood, chosen, d)
	d = d or load()
	chosen = type(chosen) == "string" and chosen or BodyTiers.DEFAULT_FACE
	local ex = type(d) == "table" and type(d.expressions) == "table" and d.expressions or {}
	local k = mood ~= "neutral" and ex[mood] or nil
	if type(k) == "string" then
		local f = BodyTiers.Face(k, d)
		if f and f.id then
			return k
		end
	end
	return chosen
end

-- the texture a mood shows on this boxer (FaceFX): MoodFace's key through FaceTexture
function BodyTiers.MoodTexture(mood, chosen, d)
	return BodyTiers.FaceTexture(BodyTiers.MoodFace(mood, chosen, d), d)
end

------------------------------------------------------------------------
-- Face styles (look.face.style; the keys are above)
------------------------------------------------------------------------
-- a drawn face key (resting or mood) that is uploaded (an id 0 = not offered)
function BodyTiers.IsDrawnFace(key, d)
	if type(key) ~= "string" or not BodyTiers.STYLE_INDEX[key] then
		return false
	end
	local f = BodyTiers.Face(key, d)
	return f ~= nil and f.id ~= nil
end

-- a drawn style a look may wear (a resting face, uploaded): mood-only faces are never anyone's chosen face
function BodyTiers.IsDrawnStyle(style, d)
	return BodyTiers.STYLE_RESTING[style] == true and BodyTiers.IsDrawnFace(style, d)
end

-- the face style every boxer gets when none was chosen (new boxers, old saves, a "built" save, NPCs without
-- one): the drawn Boxer Neutral, else the first uploaded drawn face, else (no drawn face uploaded at all, an
-- emergency fallback only) the built face
BodyTiers.DEFAULT_STYLE = "wcb_neutral"
function BodyTiers.DefaultStyle(d)
	if BodyTiers.IsDrawnStyle(BodyTiers.DEFAULT_STYLE, d) then
		return BodyTiers.DEFAULT_STYLE
	end
	for _, k in ipairs(BodyTiers.STYLE_KEYS) do
		if BodyTiers.IsDrawnStyle(k, d) then
			return k
		end
	end
	return BodyTiers.BUILT_STYLE
end

-- true while any drawn face is uploaded: every boxer wears one, and the built face (its parts, its rig and the
-- Creator controls that only shape it) is out of the game
function BodyTiers.DrawnFaces(d)
	return BodyTiers.DefaultStyle(d) ~= BodyTiers.BUILT_STYLE
end

-- the Creator's choices: every uploaded drawn face in STYLE_KEYS order ({ key, name }). The built face is no
-- player option (empty when nothing is uploaded: the emergency built fallback has no UI)
function BodyTiers.FaceStyles(d)
	local out = {}
	for _, k in ipairs(BodyTiers.STYLE_KEYS) do
		if BodyTiers.IsDrawnStyle(k, d) then
			table.insert(out, { key = k, name = BodyTiers.Face(k, d).name })
		end
	end
	return out
end

-- look.face.style from untrusted input: an uploaded drawn style, else the old (saved) one when it is still one,
-- else the default (old saves with no style and "built" saves get the drawn Boxer Neutral)
function BodyTiers.SanitizeFaceStyle(style, old, d)
	if BodyTiers.IsDrawnStyle(style, d) then
		return style
	elseif BodyTiers.IsDrawnStyle(old, d) then
		return old
	end
	return BodyTiers.DefaultStyle(d)
end

-- the drawn style a boxer's head shows: app.face.style when it is drawn and uploaded, else the default drawn face
-- (a missing or "built" style, any look at all). nil only when no drawn face is uploaded (the built fallback)
function BodyTiers.DrawnStyleOf(app, d)
	local face = type(app) == "table" and type(app.face) == "table" and app.face or nil
	local st = face and face.style
	if BodyTiers.IsDrawnStyle(st, d) then
		return st
	end
	local def = BodyTiers.DefaultStyle(d)
	return def ~= BodyTiers.BUILT_STYLE and def or nil
end

-- the look's face keys and options that only shape the part-built face (its eyes, brows, nose and lips, the lip
-- tint the undertone gives): a drawn face draws its own features, so the look editors (LookKit.FaceShown) hide them
-- while drawn faces are in. (tools/sim/test_bodytiers checks each one changes nothing on the drawn face, and every
-- face control left shown changes it)
BodyTiers.BUILT_ONLY = {
	noseWidth = true, noseLength = true, noseBridge = true, lips = true, browThick = true, browHeight = true,
	browAngle = true, mouthWidth = true, asym = true, eyeShape = true, eyeSize = true, eyeDist = true, lashes = true,
	eyeTilt = true, lidHeavy = true, noseBreak = true,
	-- (the birthmark: on a drawn face it always lands on the padded ink, so it is never drawn)
	marks = true,
	browStyle = true, eyeColor = true, eyeColor2 = true, undertone = true, noseType = true,
}
-- the face keys that, on the drawn face, only place the hair (the forehead moves the generated hairline and the
-- built face's brow): with every boxer bald (Config.BaldMode) they change nothing the player can see, so the look
-- editors hide them too
BodyTiers.HAIR_ONLY = { forehead = true }
local function bald()
	local here = script and script.Parent
	local m = here and here:FindFirstChild("Config")
	local ok, cfg = false, nil
	if m then
		ok, cfg = pcall(require, m)
	end
	return ok and type(cfg) == "table" and cfg.BaldMode == true
end
function BodyTiers.FaceControlShown(key, d)
	if not BodyTiers.DrawnFaces(d) then
		return true
	end
	return not (BodyTiers.BUILT_ONLY[key] or (BodyTiers.HAIR_ONLY[key] and bald()))
end

-- the moods (BodyAssetData.expressions' names, MoodOf, plus FaceFX's "guard" / "train") -> a drawn face; nil = the
-- boxer's own chosen (resting) face. A mood whose face is not uploaded keeps the chosen face
BodyTiers.STYLE_MOODS = {
	neutral = nil, rest = nil,
	guard = "wcb_focused", block = "wcb_focused",
	attack = "wcb_determined", train = "wcb_determined",
	effort = "wcb_grit",
	hurt = "wcb_hurt",
	angry = "wcb_shout",
	taunt = "wcb_smirk",
	confident = "wcb_confident",
	happy = "wcb_grin",
	celebrate = "wcb_toothy",
	ko = "wcb_ko",
	stunned = "wcb_dazed", dazed = "wcb_dazed",
	tired = "wcb_tired", lose = "wcb_tired",
	surprised = "wcb_surprised",
}

-- the drawn face a mood shows on a boxer whose chosen style is `chosen` (the chosen face when the mood keeps it or
-- its face is not uploaded)
function BodyTiers.StyleMoodFace(mood, chosen, d)
	local k = type(mood) == "string" and BodyTiers.STYLE_MOODS[mood] or nil
	if k and BodyTiers.IsDrawnFace(k, d) then
		return k
	end
	return chosen
end

------------------------------------------------------------------------
-- Fight damage overlays (optional uploaded decals: BodyAssetData.damage = { blackEyeL = id, ... })
------------------------------------------------------------------------
-- each layer is a full-face texture in the faces' layout, shown with Decal.Transparency = 1 - strength
BodyTiers.DAMAGE_LAYERS = { "blackEyeL", "blackEyeR", "cutL", "cutR", "bruise", "swelling" }

-- the damage table (CONTRACTS section 8) -> { [layer] = strength 0..1 } (0 = hidden)
function BodyTiers.DamageStrengths(dmg)
	dmg = type(dmg) == "table" and dmg or {}
	local function n(k)
		return math.clamp(num(dmg[k], 0), 0, 1.5)
	end
	local fade = math.clamp(1 - math.max(0, num(dmg.age, 0)) / 8, 0.15, 1)
	local function s(v, from)
		return math.clamp((v - from) / (1 - from), 0, 1) * fade
	end
	local cutSide = num(dmg.cutSide, 1) < 0 and -1 or 1
	local cut2Side = num(dmg.cutSide2, -cutSide) < 0 and -1 or 1
	local cutL = math.max(cutSide < 0 and n("cut") or 0, cut2Side < 0 and n("cut2") or 0)
	local cutR = math.max(cutSide > 0 and n("cut") or 0, cut2Side > 0 and n("cut2") or 0)
	return {
		blackEyeL = s(n("leftEye"), 0.15),
		blackEyeR = s(n("rightEye"), 0.15),
		cutL = cutL > 0.05 and math.clamp(cutL, 0, 1) or 0,
		cutR = cutR > 0.05 and math.clamp(cutR, 0, 1) or 0,
		bruise = s(math.max(n("bruise"), 0.6 * math.max(n("cheekL"), n("cheekR"))), 0.2),
		swelling = s(math.max(n("forehead"), n("lip")), 0.25),
	}
end

-- the uploaded id of a damage layer (nil: not uploaded, the part-built overlays draw it)
function BodyTiers.DamageId(layer, d)
	d = d or load()
	local dm = type(d) == "table" and type(d.damage) == "table" and d.damage or nil
	return dm and idOf(dm[layer]) or nil
end

return BodyTiers
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="47">
        <Properties>
          <string name="Name">Builder</string>
          <string name="Source"><![CDATA[-- Builder: turns a boxer's look data into a 3D character (server side). Public facade.
-- * Scales / Description / ScaleKey: the standard R15 body's HumanoidDescription (height, frame, gender)
-- * Tiers: the muscle tier of every body part from the build (BodyTiers); BuilderTiers swaps the parts
-- * Cosmetics / Apply / CreateNPC: build every layer on a character, in order, with per-folder rebuild
--   caching, detail levels and the CONTRACTS section 4 opts
-- The layers live in sub-modules that share the part helpers in BuilderKit:
-- * BuilderTiers: the 14 muscle-tier body parts (Humanoid:ReplaceBodyPartR15, only on a tier change)
-- * BuilderHead: the classic head and the face built on it (Parts, a FaceFX rig), beard, fight damage, sweat, headgear
--   (every boxer wears it while Config.AlwaysHeadgear: a Cosmetics step, recoloured by SetHeadgear while sparring),
--   and the officials' caps instead of it (Config.OfficialCaps: the Hat step, Head.SetCap)
-- * BuilderHair: hair styles x hair types, strands, sway joints, hair under headgear / hoods, wet hair
-- * BuilderBody: skin/trunks/shoe colours, attire, gloves and wraps, robe, body sweat / bruises
-- FaceLayout, SetDamage, SetSweat, SetHeadgear, SetHairHidden and SetRobe are forwarded from them.
-- Every Cosmetics run also publishes LookData (+ LookSig and the section sigs) on the model, change-only, and
-- SetDamage publishes LookFx: the inputs the client-side asset hair is built from (LookData.lua).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Looks = require(Shared:WaitForChild("Looks"))
local Kit = require(script.Parent:WaitForChild("BuilderKit"))
local Head = require(script.Parent:WaitForChild("BuilderHead"))
local Hair = require(script.Parent:WaitForChild("BuilderHair"))
local Body = require(script.Parent:WaitForChild("BuilderBody"))
local LookData = require(script.Parent:WaitForChild("LookData"))
local BodyTiers = require(script.Parent:WaitForChild("BodyTiers"))
local BuilderTiers = require(script.Parent:WaitForChild("BuilderTiers"))
local BuilderGear = require(script.Parent:WaitForChild("BuilderGear"))
local AvatarLook = require(script.Parent:WaitForChild("AvatarLook"))

local Builder = {}

local frameOf = Body.frameOf
local setAttr = Kit.setAttr

-- run one build step; a failing layer warns instead of taking the whole character down with it
local function step(name, fn, ...)
	if type(fn) ~= "function" then
		return false
	end
	local ok, res = pcall(fn, ...)
	if not ok then
		warn("[Boxer] " .. name .. " failed:", res)
	end
	return ok, res
end

------------------------------------------------------------------------
-- Scales / HumanoidDescription
------------------------------------------------------------------------
-- The standard R15 body (tools/body/CONTRACT.md): the description has empty body-part ids (the engine's default
-- parts), BodyTypeScale 0 and ProportionScale 0, and BuilderTiers then swaps the 14 non-head parts for their
-- muscle-tier MeshParts. The tiers are modelled at the game's proportions (the athletic 70-inch Athletic man the
-- old Rthro blend made: about 6.2 studs, 7 heads), so Height / Width / Depth only carry the boxer's height, his
-- frame's build (BodyTypes width / depth) and the women's narrower shoulders; training never widens the frame
-- (the tiers carry the muscle). The head is the standard head at the frame's head share: FRAME_PROPORTIONS'
-- head x RTHRO_HEAD (what BodyTypeScale 1 used to take off it): 0.927 studs on the Athletic frame, a little
-- smaller on the Lean, bigger on the Power Build / Heavyweight (tools/body/build_body.py FRAMES[id].head is the
-- same table: the neck column is modelled under that head). With every id 0 the default parts stay: the classic
-- block body at these scales.
--
-- THE HEIGHT (v13): the frame changes the build, never the height. Every frame's mesh family has its own unit rig
-- (BodyAssetData.frames[id].unit: the neck pivot's height neckHeight with the frame's skeleton, its head), so the
-- HeightScale is normalised per frame: the chosen height in inches is the standing height of the Athletic unit x
-- inches / 70 (the 70-inch Athletic man stands unit.standingHeight = 6.2161 studs, the game's inch), and
--   HeightScale = (standing - head) / unit[frame].neckHeight     (head = 1.2 x HeadScale: the head is not height-scaled)
-- so the sole-to-crown height, and with it the eye line, is the same for every frame at the same inches (the frames'
-- skeletons are tuned so the hip line follows within 1 %: BuilderTiers.FixHipHeight follows the scaled legs anyway).
-- A missing unit (no neckHeight) falls back to inches / 70.
local FRAME_PROPORTIONS = {
	Lean = { head = 0.79 },
	Athletic = { head = 0.82 },
	Muscular = { head = 0.835 },
	["Power Build"] = { head = 0.85 },
	["Heavyweight Build"] = { head = 0.865 },
}
Builder.FRAME_PROPORTIONS = FRAME_PROPORTIONS
local RTHRO_HEAD = 0.942
Builder.RTHRO_HEAD = RTHRO_HEAD
-- the classic head's nominal size the HeadScale scales (the plain head Part BuilderHead swaps in)
local HEAD_NOMINAL = 1.2
-- the share of Config.BodyTypes' width / depth that still goes into the description: the frames' mesh families carry
-- the build (a Lean frame's narrow shoulders, the heavyweight's wide pelvis are IN the meshes, v12), so the whole-body
-- Width / Depth is only the fine-tune on top; at the full BodyTypes values the pelvis of a Heavyweight came out 1.16
-- (mesh) x 1.17 (description) = 1.36 x the Athletic one, and every hand, foot and shin with it
local FRAME_WIDTH_SHARE = 0.5
Builder.FRAME_WIDTH_SHARE = FRAME_WIDTH_SHARE

-- the inches the creator / the records carry (Looks: 60..84), the Athletic unit's studs per 70 inches
local HEIGHT_MIN, HEIGHT_MAX = 60, 84
local UNIT_STAND_FALLBACK = 6.2161

-- the frame's unit rig heights (BodyTiers.Unit) and the Athletic unit's standing height: nil, nil without data
local function unitOf(frameId)
	local ok, u = pcall(BodyTiers.Unit, frameId)
	return ok and type(u) == "table" and u or nil
end

-- the standing height in studs a boxer of `inches` is built to (every frame): the Athletic unit's x inches / 70
function Builder.StandingHeight(inches)
	local ath = unitOf(BodyTiers.DEFAULT_FRAME)
	local unitStand = ath and type(ath.standingHeight) == "number" and ath.standingHeight or UNIT_STAND_FALLBACK
	return math.clamp(tonumber(inches) or 70, HEIGHT_MIN, HEIGHT_MAX) / 70 * unitStand
end

-- (build, opts: kept for the callers; the physique and training no longer change the scales)
function Builder.Scales(app, build, opts)
	local frame = frameOf(app)
	local female = app.gender == 2
	local pr = FRAME_PROPORTIONS[frame.id] or FRAME_PROPORTIONS.Athletic
	local headScale = pr.head * RTHRO_HEAD * (female and 0.97 or 1)
	local inches = math.clamp(tonumber(app.height) or 70, HEIGHT_MIN, HEIGHT_MAX)
	-- the frame's own neck height: the height scale that puts the crown of its head at the chosen height
	local u = unitOf(frame.id)
	local height = inches / 70
	if u and type(u.neckHeight) == "number" and u.neckHeight > 1 then
		height = (Builder.StandingHeight(inches) - HEAD_NOMINAL * headScale) / u.neckHeight
	end
	local wk = (female and 0.92 or 1)
	local dk = (female and 0.94 or 1)
	return {
		height = math.clamp(height, 0.8, 1.3),
		width = math.clamp((1 + (frame.width - 1) * FRAME_WIDTH_SHARE) * wk, 0.7, 1.4),
		depth = math.clamp((1 + (frame.depth - 1) * FRAME_WIDTH_SHARE) * dk, 0.7, 1.4),
		bodyType = 0,
		proportion = 0,
		head = headScale,
	}
end

function Builder.Description(app, build, opts)
	local desc = Instance.new("HumanoidDescription")
	local skin = Looks.Color(Looks.SkinTones[app.skin or 5])
	desc.HeadColor = skin
	desc.TorsoColor = skin
	desc.LeftArmColor = skin
	desc.RightArmColor = skin
	-- legs are skin: the trunks are separate loose shells built over the thighs
	desc.LeftLegColor = skin
	desc.RightLegColor = skin
	local sc = Builder.Scales(app, build, opts)
	desc.HeightScale = sc.height
	desc.WidthScale = sc.width
	desc.DepthScale = sc.depth
	desc.HeadScale = sc.head
	desc.BodyTypeScale = sc.bodyType
	desc.ProportionScale = sc.proportion
	-- a player's own avatar hair and face (opts.avatar = an AvatarLook record; players only, never NPCs): the
	-- engine loads and attaches the hair accessories and puts on the face / Dynamic Head. Nothing else of the
	-- avatar is copied: the body stays the muscle-tier body
	local av = opts and opts.avatar
	if type(av) == "table" then
		-- (Config.BaldMode: never the avatar's hair accessories)
		if av.useHair and not Config.BaldMode then
			desc.HairAccessory = av.hair or ""
		end
		desc.Face = av.face or 0
		desc.Head = av.head or 0
	end
	return desc
end

-- quantised to 0.01 so only real changes re-apply the description (which yields); "p4" = the standard R15
-- body at BodyTypeScale 0 with the frame-normalised height (characters scaled under an older key re-apply once).
-- A player's avatar hair / face
-- (opts.avatar) adds its AvatarLook.Key: a new avatar, the setting turned on / off re-apply once; the game
-- look's key is exactly the old one
function Builder.ScaleKey(app, build, opts)
	local sc = Builder.Scales(app, build, opts)
	local av = AvatarLook.Key(opts and opts.avatar)
	return string.format("%.2f|%.2f|%.2f|%d|%.2f|%.2f|%.2f|%sp4", sc.height, sc.width, sc.depth, app.gender or 1, sc.bodyType, sc.proportion, sc.head,
		av ~= "" and (av .. "|") or "")
end

-- the avatar hair / face this rig carries (what the last ApplyDescription put on: the AvatarLook attribute
-- Builder.Apply writes), as AvatarHair / AvatarFace attributes the hair and face steps, FaceFX and the clients
-- read. Every Cosmetics caller (fights included) follows the rig, not its own opts
local function avatarState(model)
	local st = AvatarLook.State(model:GetAttribute("AvatarLook"))
	setAttr(model, "AvatarHair", st.hair or nil)
	setAttr(model, "AvatarFace", st.face or nil)
	return st
end
Builder.AvatarState = avatarState

-- the muscle tier of every body part from the build (BodyTiers) and the swap (BuilderTiers, change-only)
function Builder.Tiers(app, build, sp)
	local frame = sp and sp.frame or frameOf(app)
	return BodyTiers.Tiers(build, { potential = frame.potential, female = app.gender == 2 })
end

local function tiersStep(model, app, build, opts, sp)
	local tiers = BodyTiers.Tiers(build, { potential = sp.frame.potential, female = sp.female }, BuilderTiers.Current(model))
	local sc = Builder.Scales(app, build, opts)
	-- (the detail level's mesh set: the low level's crowd NPCs wear the lighter v9 meshes, Config.Detail.meshes)
	BuilderTiers.Apply(model, tiers, Vector3.new(sc.width, sc.height, sc.depth), sp.cfg ~= nil and sp.cfg.meshes == "lite")
end

------------------------------------------------------------------------
-- Head / body API (implemented in BuilderHead / BuilderBody)
------------------------------------------------------------------------
-- returns head-local positions for face features (shared with damage visuals)
Builder.FaceLayout = Head.FaceLayout -- (head, face)

-- dmg = the CONTRACTS section 8 table (every field optional): face damage (Head) + rib bruises (Body);
-- also published as the LookFx attribute for the anatomy meshes (change-only)
function Builder.SetDamage(model, app, dmg)
	dmg = type(dmg) == "table" and dmg or {}
	step("SetDamage", Head.SetDamage, model, app, dmg)
	step("Body.SetDamage", Body.SetDamage, model, app, dmg)
	step("LookFx", LookData.PublishFx, model, dmg)
end

-- level 0..1: skin / hair / beard (Head, writes the Sweat attribute) then muscles / gloves / wraps (Body)
function Builder.SetSweat(model, app, level)
	level = math.clamp(tonumber(level) or 0, 0, 1)
	step("SetSweat", Head.SetSweat, model, app, level)
	step("Body.SetSweat", Body.SetSweat, model, app, level)
	-- belt and braces: the attribute is the single source of truth, quantised (0.05) and change-only
	setAttr(model, "Sweat", math.floor(level * 20 + 0.5) / 20)
end

------------------------------------------------------------------------
-- Headgear: every boxer's own (Config.AlwaysHeadgear), a Cosmetics step
------------------------------------------------------------------------
-- The model carries HeadgearColor (Color3: the boxer's own, Looks.HeadgearColor, written by Cosmetics) and, while
-- sparring, HeadgearCorner (the corner's colour SetHeadgear put on). The folder is cached on its colour, the head's
-- size and the detail level, so a rebuild, a tier swap or a respawn keeps (or rebuilds) it and a clone copies it.
local function wantsHeadgear(opts)
	return Config.AlwaysHeadgear == true and (opts == nil or opts.outfit == nil or Config.HeadgearOfficials ~= false)
end
Builder.WantsHeadgear = wantsHeadgear

local function headgearStep(model, detail)
	local corner, own = model:GetAttribute("HeadgearCorner"), model:GetAttribute("HeadgearColor")
	local col = (typeof(corner) == "Color3" and corner) or (typeof(own) == "Color3" and own) or Looks.Color(Looks.Palette[1])
	detail = Config.DetailLevel(detail)
	local head = model:FindFirstChild("Head")
	local key = Kit.sig("HG1", col, head and head.Size or false, detail)
	if Kit.cached(model, "Headgear", key) then
		return
	end
	local ok = step("Headgear", Head.SetHeadgear, model, col, true, detail)
	if ok then
		Kit.seal(model, "Headgear", key)
	end
end

-- a boxer's headgear (own colour from the look; no headgear when Config.AlwaysHeadgear is off or he is an exempt
-- official: the folder goes unless a spar put a corner's on)
local function headgearLook(model, app, opts, detail)
	if wantsHeadgear(opts) then
		setAttr(model, "HeadgearColor", Looks.Color(Looks.HeadgearColor(app)))
		headgearStep(model, detail)
	elseif model:GetAttribute("HeadgearColor") ~= nil then
		-- (switched off since the last build)
		setAttr(model, "HeadgearColor", nil)
		if model:GetAttribute("HeadgearCorner") == nil then
			Head.SetHeadgear(model, nil, false)
		end
	end
end

------------------------------------------------------------------------
-- Officials' caps (Config.OfficialCaps): a Cosmetics step after the headgear
------------------------------------------------------------------------
-- the referee (opts.outfit "referee") wears his peaked referee cap, the spar coach ("cornerman") a team baseball cap,
-- whenever he wears no headgear (Config.HeadgearOfficials off). Colours from opts.officialColors (Officials.Colors:
-- cap / capTrim / capBadge). BoxerLook/Hat is cached on the style, colours, head size and detail (Kit.cached checks
-- the welds still hold the current head), so a rebuild, a tier swap or a respawn keeps or rebuilds it, a clone
-- copies it; anyone else (a boxer, a switched-off flag) has the folder removed.
local CAP_STYLE = { referee = "referee", cornerman = "baseball" }
local function capStyle(opts)
	if Config.OfficialCaps == false or type(opts) ~= "table" or wantsHeadgear(opts) then
		return nil
	end
	return CAP_STYLE[opts.outfit or ""]
end
Builder.CapStyle = capStyle

local function capLook(model, opts, detail)
	local style = capStyle(opts)
	local look = model:FindFirstChild("BoxerLook")
	if not style then
		local f = look and look:FindFirstChild("Hat")
		if f then
			f:Destroy()
		end
		return
	end
	local oc = type(opts.officialColors) == "table" and opts.officialColors or {}
	local function col(t)
		return type(t) == "table" and Looks.Color(t) or nil
	end
	local colors = { cap = col(oc.cap), trim = col(oc.capTrim), badge = col(oc.capBadge) }
	detail = Config.DetailLevel(detail)
	local head = model:FindFirstChild("Head")
	local key = Kit.sig("CAP1", style, colors, head and head.Size or false, detail)
	if Kit.cached(model, "Hat", key) then
		return
	end
	local ok = step("Hat", Head.SetCap, model, style, colors, detail)
	if ok then
		Kit.seal(model, "Hat", key)
	end
end

-- The late re-fit (BuilderHead.RefitHeadgear): the gear folders checked against the live head (its instance, Size,
-- class, mesh; welds still there) and rebuilt from their own record when they no longer fit, each rebuild warned as
-- "[Boxer] headgear refit <name>: ..."; a rebuilt folder is re-sealed under the key its step would have used, so the
-- next Cosmetics keeps it. The Neck is checked too (Head.EnsureNeck: a rig the swap left without one is dead on
-- RequiresNeck). Change-only: nil while everything fits.
function Builder.RefitHeadgear(model)
	if not (model and model.Parent) then
		return nil
	end
	local okN, neck = pcall(Head.EnsureNeck, model)
	if okN and neck == "rebuilt" then
		warn("[Boxer] headgear refit " .. tostring(model.Name) .. ": no Neck joint on the rig; a Motor6D Neck was rebuilt from the RigAttachments")
	end
	local ok, res = pcall(Head.RefitHeadgear, model)
	if not ok then
		warn("[Boxer] headgear refit failed:", res)
		return nil
	end
	if type(res) ~= "table" then
		return nil
	end
	local head = model:FindFirstChild("Head")
	local look = model:FindFirstChild("BoxerLook")
	if res.Headgear then
		local f = look and look:FindFirstChild("Headgear")
		local col = f and f:GetAttribute("Color")
		if f and typeof(col) == "Color3" then
			Kit.seal(model, "Headgear", Kit.sig("HG1", col, head and head.Size or false, f:GetAttribute("Detail")))
		end
	end
	if res.Hat then
		local f = look and look:FindFirstChild("Hat")
		if f then
			local colors = { cap = f:GetAttribute("CapColor"), trim = f:GetAttribute("CapTrim"), badge = f:GetAttribute("CapBadge") }
			Kit.seal(model, "Hat", Kit.sig("CAP1", f:GetAttribute("Style"), colors, head and head.Size or false, f:GetAttribute("Detail")))
		end
	end
	return res
end

-- A model placed in Workspace (an NPC parented in by Ambient / Venues / FightEngine, a player after Builder.Apply):
-- the engine's deferred passes (the Humanoid's scaling, the MeshPart head conversion, a death on a missing Neck)
-- run after the parent, so the gear is re-fitted 0.3 s and 2 s later (Builder.RefitHeadgear; a no-op while it
-- fits). One schedule per model at a time.
Builder.REFIT_DELAYS = { 0.3, 2 }
local refitPending = setmetatable({}, { __mode = "k" })
function Builder.OnPlaced(model)
	if model == nil or refitPending[model] then
		return
	end
	refitPending[model] = true
	local last = Builder.REFIT_DELAYS[#Builder.REFIT_DELAYS]
	for _, delay in ipairs(Builder.REFIT_DELAYS) do
		task.delay(delay, function()
			if delay == last then
				refitPending[model] = nil
			end
			if model.Parent then
				Builder.RefitHeadgear(model)
			end
		end)
	end
end

-- Every built character / NPC keeps its joints and its gear whatever happens to its Neck: the rigs the engine hands
-- out now carry AnimationConstraint joints (the avatar joint upgrade) or lose the Neck in a head swap, and with
-- RequiresNeck on the Humanoid dies and BreakJointsOnDeath then drops every weld (the headgear lying studs away,
-- every motor gone: the Studio diagnostic). FightEngine / Ragdoll set these per fight already; this is the baseline.
local function hardenHumanoid(model)
	local hum = model and model:FindFirstChildOfClass("Humanoid")
	if not hum then
		return
	end
	pcall(function()
		if hum.RequiresNeck ~= false then
			hum.RequiresNeck = false
		end
		if hum.BreakJointsOnDeath ~= false then
			hum.BreakJointsOnDeath = false
		end
	end)
end
Builder.HardenHumanoid = hardenHumanoid

-- Sparring: on = the corner's colour over the boxer's own headgear, off = his own colour back. A model without its
-- own headgear (Config.AlwaysHeadgear off, an exempt official) gets the old toggle: built on, removed off
function Builder.SetHeadgear(model, color, on)
	if model:GetAttribute("HeadgearColor") ~= nil then
		setAttr(model, "HeadgearCorner", (on and typeof(color) == "Color3") and color or nil)
		local look = model:FindFirstChild("BoxerLook")
		local f = look and look:FindFirstChild("Headgear")
		step("Headgear", headgearStep, model, (f and f:GetAttribute("Detail")) or model:GetAttribute("Detail"))
		return
	end
	setAttr(model, "HeadgearCorner", nil)
	step("SetHeadgear", Head.SetHeadgear, model, color, on, model:GetAttribute("Detail"))
end

-- true while the model wears its own all-the-time headgear (fight cleanup keeps that folder)
function Builder.HasOwnHeadgear(model)
	return model:GetAttribute("HeadgearColor") ~= nil
end

-- region = "hood" | "headgear"
function Builder.SetHairHidden(model, region, on)
	step("SetHairHidden", Hair.SetHairHidden, model, region, on)
end

Builder.SetRobe = Body.SetRobe -- (model, app, on, opts)

-- face damage stage 0..4 (the Config thresholds; never re-implemented here)
function Builder.DamageLevel(dmg)
	return (Config.FaceDamageStage(dmg))
end

-- visual archetype id the body is drawn with (opts.physique > app.body.physique > classification)
function Builder.Physique(app, build, opts)
	return Body.Resolve(app, build, opts).ph.id
end
Builder.Resolve = Body.Resolve -- (app, build, opts) -> body spec (levels, fat, definition, veins, detail)

------------------------------------------------------------------------
-- Rebuild caching for the head steps (the body steps cache themselves in BuilderBody)
------------------------------------------------------------------------
-- opts keys the head steps never read; everything else that is a plain value goes in the signature
local HEAD_SIG_SKIP = {
	sweat = true, hands = true, robe = true, waistText = true, name = true, nick = true, nat = true,
	fightNight = true, physique = true, tier = true, sponsorTrunks = true, sponsorRobe = true, grime = true,
	mouthguard = true, damage = true,
}
-- Inputs the head steps read beyond the plain opts. Face = the built face's sliders, face fat, opts.grime (stored
-- on the face folder as OptGrime), the mouthguard colour and its bloodied tint (opts.damage.lip > 0.6), the fight
-- wear (app.battle) and only the hair / beard fields it really uses (Head.FaceSigParts: brow colour, lips
-- covered), so a barber visit never rebuilds the face. The Grime ATTRIBUTE (CONTRACTS section 7: set after
-- roadwork, cleared by the shower) is deliberately not in the key: BuilderHead draws face dirt in its own
-- FaceGrime folder from it on every Head.SetSweat, which Cosmetics always runs last, so roadwork and the shower
-- never cost a face rebuild. HD4: the built face is back (folders sealed under HD3's decal face rebuild once).
local function headSig(model, app, build, opts, name)
	local head = model:FindFirstChild("Head")
	local avHair, avFace = model:GetAttribute("AvatarHair") == true, model:GetAttribute("AvatarFace") == true
	local o = {}
	for k, v in pairs(opts) do
		local t = type(v)
		if (t == "number" or t == "string" or t == "boolean") and not HEAD_SIG_SKIP[k] then
			o[k] = v
		end
	end
	local fat, extra = 0, false
	local hair, beard = app.hair, app.beard
	if name == "Face" then
		-- whole percent steps are plenty for cheeks / jowls
		fat = build and tonumber(build.fat) or 0
		local at = type(app.attire) == "table" and app.attire or {}
		local og = tonumber(opts.grime)
		local dmg = type(opts.damage) == "table" and opts.damage or nil
		extra = {
			grime = og and math.floor(math.clamp(og, 0, 1) * 10 + 0.5) or "attr",
			guard = opts.mouthguard and (at.mouthguard or true) or false,
			guardBlood = opts.mouthguard and dmg ~= nil and (tonumber(dmg.lip) or 0) > 0.6 or false,
			avatar = avFace,
			-- the face style (look.face.style): the drawn Boxer face decal every boxer wears (built only in the
			-- emergency fallback with no drawn face uploaded)
			style = BodyTiers.DrawnStyleOf(app) or BodyTiers.BUILT_STYLE,
		}
		if type(Head.FaceSigParts) == "function" then
			local ok, parts = pcall(Head.FaceSigParts, app)
			if ok and type(parts) == "table" then
				hair, beard = parts, false
			end
		end
	end
	-- (the beard sits its moustache over the mouth of the face style: the drawn style keys it too)
	return Kit.sig("HD4", name, app.gender, app.skin, app.height, app.face, hair, beard, app.battle, o,
		math.floor(fat + 0.5), head and head.Size or false, Config.BaldMode, extra, name == "Hair" and avHair or false,
		name == "Beard" and (BodyTiers.DrawnStyleOf(app) or BodyTiers.BUILT_STYLE) or false)
end

-- The head is scaled (HeadScale), and BuilderHead swaps the engine's default head (a MeshPart) for the classic
-- head (a plain Part with the Head SpecialMesh, the built face sits on it) of the same size once. Humanoid:ReplaceBodyPartR15 scales the new part "as
-- normal", so the engine may take that already-scaled size as unscaled and scale it a second time (with the
-- old Classic HeadScale 1 that was harmless). headRecord / keepHeadScale put back the size, the OriginalSize
-- record and the attachments the engine gave the original head, and re-aim the neck: the head is scaled
-- exactly once. A no-op when the swap kept the size (the simulator's ReplaceBodyPartR15 does).
local function headRecord(model)
	local head = model:FindFirstChild("Head")
	if not (head and head:IsA("BasePart")) then
		return nil
	end
	local orig = head:FindFirstChild("OriginalSize")
	local rec = { part = head, size = head.Size, orig = orig and orig:IsA("Vector3Value") and orig.Value or nil, att = {} }
	for _, c in ipairs(head:GetChildren()) do
		if c:IsA("Attachment") then
			rec.att[c.Name] = c.CFrame
		end
	end
	return rec
end

-- true when the head had to be corrected (its folders were built on the wrong size: rebuild them)
local function keepHeadScale(model, rec)
	local head = model:FindFirstChild("Head")
	if not (rec and head and head ~= rec.part and head:IsA("BasePart")) then
		return false
	end
	local fixed = false
	if (head.Size - rec.size).Magnitude > 1e-3 then
		head.Size = rec.size
		fixed = true
	end
	if rec.orig then
		local o = head:FindFirstChild("OriginalSize")
		if not (o and o:IsA("Vector3Value")) then
			o = Instance.new("Vector3Value")
			o.Name = "OriginalSize"
			o.Parent = head
		end
		if o.Value ~= rec.orig then
			o.Value = rec.orig
		end
	end
	for name, cf in pairs(rec.att) do
		local a = head:FindFirstChild(name)
		if a and a:IsA("Attachment") and (a.CFrame.Position - cf.Position).Magnitude > 1e-4 then
			a.CFrame = cf
			fixed = true
		end
	end
	local neck, na = head:FindFirstChild("Neck"), head:FindFirstChild("NeckRigAttachment")
	if neck and neck:IsA("Motor6D") and na and na:IsA("Attachment") and (neck.C1.Position - na.CFrame.Position).Magnitude > 1e-4 then
		neck.C1 = na.CFrame
		fixed = true
	end
	return fixed
end

-- the neck: the classic head sits on the Neck pivot (the tiers' UpperTorso ends just above it), its base at the
-- pivot whatever head the engine or the swap left: the Head's NeckRigAttachment (and Neck.C1) at -half its
-- height. Absolute (from the head's size): idempotent across rebuilds, rescales and head swaps.
local function seatHead(model)
	local head = model:FindFirstChild("Head")
	local na = head and head:FindFirstChild("NeckRigAttachment")
	if not (head and head:IsA("BasePart") and na and na:IsA("Attachment")) then
		return
	end
	local y = -0.5 * head.Size.Y
	local p = na.Position
	if math.abs(p.Y - y) > 1e-4 then
		na.Position = Vector3.new(p.X, y, p.Z)
	end
	local neck = head:FindFirstChild("Neck")
	if neck and neck:IsA("Motor6D") and (neck.C1.Position - na.CFrame.Position).Magnitude > 1e-4 then
		neck.C1 = na.CFrame
	end
end

-- Head.Face(model, app, opts, build) / Hair.Build(model, app, opts) / Head.Beard(model, app, opts)
local function headStep(model, app, build, opts, name)
	local key = headSig(model, app, build, opts, name)
	if Kit.cached(model, name, key) then
		return
	end
	local ok
	if name == "Face" then
		if model:GetAttribute("AvatarFace") == true then
			ok = step("Face", Head.AvatarFace, model, app, opts)
		else
			ok = step("Face", Head.Face, model, app, opts, build)
		end
	elseif name == "Hair" then
		ok = step("Hair", Hair.Build, model, app, opts)
	else
		ok = step(name, Head[name], model, app, opts)
	end
	if ok then
		Kit.seal(model, name, key)
	end
end

-- the Face step (the classic head swap and the built face), kept at the engine's head scale; the face is rebuilt
-- once on the corrected head (its size is in the Face cache key) when the swap changed it
local function faceStep(model, app, build, opts)
	-- quiet pcalls: the guard is a safety net, it must never cost a face
	local okR, rec = pcall(headRecord, model)
	headStep(model, app, build, opts, "Face")
	local okK, fixed = pcall(keepHeadScale, model, okR and rec or nil)
	if okK and fixed then
		-- the face was sealed under the key taken before the swap (the original head's size, which the corrected
		-- head has again): drop the seal so the folder really is rebuilt on the corrected head
		local look = model:FindFirstChild("BoxerLook")
		local face = look and look:FindFirstChild("Face")
		if face then
			face:SetAttribute("Sig", nil)
		end
		headStep(model, app, build, opts, "Face")
	end
	pcall(seatHead, model)
	-- a drawn face style's decal stays on the head when the face is served from cache (an ApplyDescription or a
	-- head swap since may have replaced it); a built face: nothing
	step("FaceDecal", Head.EnsureFaceDecal, model)
	-- avatar hair accessories put on before a head swap hang on the old head: weld them to the new one
	step("Accessories", Hair.FixAccessories, model)
end

------------------------------------------------------------------------
-- LookData (anatomy meshes): what the clients build each character's meshes from
------------------------------------------------------------------------
-- cheap and change-only: the encoded look is compared with the attribute before anything is written.
-- look.attire.gear: what the boxer wears on the hands and feet (the Body meshes draw the gloves / wraps /
-- shoes); a head-only preview rebuild (gear = nil) keeps the gear the last full build published
local function publishLook(model, app, build, opts, sp, gear)
	sp = sp or Body.Resolve(app, build, opts, model)
	local look = LookData.FromBuilder(model, app, build, opts, sp, Builder.Scales(app, build, opts))
	if type(look.attire) == "table" then
		if gear ~= nil then
			local ok, g = pcall(Body.GearLook, app, gear, opts)
			if ok and type(g) == "table" then
				look.attire.gear = LookData.Quantize(g)
			end
		else
			local prev = LookData.Get(model)
			local g = prev and type(prev.attire) == "table" and prev.attire.gear
			if type(g) == "table" then
				look.attire.gear = g
			end
		end
	end
	LookData.Publish(model, look)
end

------------------------------------------------------------------------
-- Public entry points
------------------------------------------------------------------------
-- what the rig measured when its layers were built (attributes the diagnostic compares with the live rig: a head the
-- engine rescaled after the headgear was fitted to it, a HipHeight the engine's deferred scaling pass put back), and
-- the tier legs' HipHeight checked again a moment later (BuilderTiers.FixHipHeight: change-only, see there)
local function buildRecord(model)
	local head = model:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		setAttr(model, "HeadSizeAtBuild", head.Size)
	end
	local hum = model:FindFirstChildOfClass("Humanoid")
	if hum then
		setAttr(model, "HipHeightAtBuild", hum.HipHeight)
		-- [Studio] a Neck joint missing for a frame (a head swap, a headgear rebuild, a ragdoll) must never kill the rig
		pcall(function()
			hum.RequiresNeck = false
		end)
	end
	for _, delay in ipairs({ 0.25, 1.5 }) do
		task.delay(delay, function()
			if model.Parent then
				local h = BuilderTiers.FixHipHeight(model)
				if h then
					model:SetAttribute("HipHeightRefixed", h)
				end
			end
		end)
	end
end

-- opts (all optional, CONTRACTS section 4): hands = "gloves"|"wraps"|"bare", mouthguard, name, nick,
-- nat, waistText, robe, detail ("full"|"medium"|"low"), damage, sweat, grime, age, tier, physique,
-- fightNight, sponsorTrunks / sponsorRobe ({ text, fg, bg }), dry, outfit ("referee"|"cornerman"),
-- only ({ Face, Hair, Beard }), previewGrowth. gear = { gloves, glovesCond, wraps, wrapsCond, shoes,
-- shoesCond, mouthguard, robe } (missing ids default to the starter kit).
function Builder.Cosmetics(model, app, build, gear, opts)
	opts = opts or {}
	app = app or Looks.Defaults(1)
	hardenHumanoid(model)
	avatarState(model)
	-- preview path: rebuild only the requested head folders, in order. only.Colors (a colour swatch in the Creator /
	-- locker room: skin, trunks, gloves, shoes, headgear ...) recolours instead of running the whole Cosmetics: the
	-- body colours, then the coloured layers (attire, hands; the face and beard for a skin tone), each kept when its
	-- signature did not move. No tier swap, no hair, no muscles, no damage reset: none of them take a colour
	if type(opts.only) == "table" then
		local colors = opts.only.Colors == true
		local cgear, csp
		if colors then
			cgear = Body.Gear(gear)
			csp = Body.Resolve(app, build, opts, model)
			step("Colors", Body.Colors, model, app, cgear, opts)
			faceStep(model, app, build, opts)
			headStep(model, app, build, opts, "Beard")
		end
		for _, name in ipairs({ "Face", "Hair", "Beard" }) do
			if opts.only[name] then
				if name == "Face" then
					faceStep(model, app, build, opts)
				else
					headStep(model, app, build, opts, name)
				end
			end
		end
		-- a rebuilt face reopens swollen lids and clears the sclera / mouthguard tint: redraw the damage
		if (opts.only.Face or colors) and type(opts.damage) == "table" then
			Builder.SetDamage(model, app, opts.damage)
		end
		step("Bald", Hair.StripBald, model)
		-- (the headgear follows the head: a head swap or a colour change in the Creator rebuilds it)
		step("Headgear", headgearLook, model, app, opts, colors and csp.detail or opts.detail)
		step("Hat", capLook, model, opts, colors and csp.detail or opts.detail)
		if colors then
			step("Attire", Body.Attire, model, app, opts, cgear, csp, nil)
			step("Hands", Body.Hands, model, app, cgear, opts, csp)
		end
		Builder.SetSweat(model, app, opts.sweat or model:GetAttribute("Sweat") or 0)
		-- previews (Creator / barber) change the look too: the meshes follow (a colour preview: the gloves' too)
		step("LookData", publishLook, model, app, build, opts, csp, colors and cgear or nil)
		buildRecord(model)
		return
	end
	gear = Body.Gear(gear)
	local sp = Body.Resolve(app, build, opts, model)
	-- hair hidden under a headgear / hood that is gone (fight cleanup destroys those folders directly)
	local look = model:FindFirstChild("BoxerLook")
	local hg = look and look:FindFirstChild("Headgear")
	if model:GetAttribute("HairHiddenHeadgear") and not (hg and #hg:GetChildren() > 0) then
		Builder.SetHairHidden(model, "headgear", false)
	end
	local robe = look and look:FindFirstChild("Robe")
	if model:GetAttribute("HairHiddenHood") and not (robe and robe:FindFirstChild("Hood")) then
		Builder.SetHairHidden(model, "hood", false)
	end
	-- the muscle-tier body parts first: every layer below is built on (and coloured over) the final parts
	step("Tiers", tiersStep, model, app, build, opts, sp)
	step("Colors", Body.Colors, model, app, gear, opts)
	faceStep(model, app, build, opts)
	headStep(model, app, build, opts, "Hair")
	headStep(model, app, build, opts, "Beard")
	-- Config.BaldMode: no hair accessory or old hair / beard part survives on anyone (uncached: cheap, and an
	-- accessory can arrive with any ApplyDescription)
	step("Bald", Hair.StripBald, model)
	-- the headgear every boxer wears (on the final head; its own cache)
	step("Headgear", headgearLook, model, app, opts, sp.detail)
	-- the officials' caps (the referee's, the coach's) when they wear no headgear
	step("Hat", capLook, model, opts, sp.detail)
	-- avatar hair accessories (re)attached by ApplyDescription stay hidden under a headgear / hood
	if model:GetAttribute("AvatarHair") == true then
		step("HairHidden", Hair.ApplyHairHidden, model)
	end
	local _, env = step("Muscles", Body.Muscles, model, app, build, opts, sp, gear)
	step("Attire", Body.Attire, model, app, opts, gear, sp, type(env) == "table" and env or nil)
	step("Hands", Body.Hands, model, app, gear, opts, sp)
	-- body attributes the client reads (stance, veins, LOD); change-only
	setAttr(model, "Female", app.gender == 2)
	setAttr(model, "Frame", sp.frame.id)
	setAttr(model, "Physique", sp.ph.id)
	setAttr(model, "Bulk", sp.bulk)
	setAttr(model, "Definition", sp.def)
	setAttr(model, "VeinLevel", sp.vein)
	setAttr(model, "Detail", sp.detail)
	-- damage and sweat go on last: rebuilt layers reset materials and eyelids
	if type(opts.damage) == "table" then
		Builder.SetDamage(model, app, opts.damage)
	else
		-- the face may be cached: reopen eyes an earlier SetDamage swelled shut, then drop the folder
		step("SetDamage", Head.SetDamage, model, app, {})
		step("LookFx", LookData.PublishFx, model, nil)
		look = model:FindFirstChild("BoxerLook")
		local dmg = look and look:FindFirstChild("Damage")
		if dmg then
			dmg:Destroy()
		end
	end
	Builder.SetSweat(model, app, opts.sweat or model:GetAttribute("Sweat") or 0)
	-- last: the rig is final (head swap, rescale) and every attribute above is set
	step("LookData", publishLook, model, app, build, opts, sp, gear)
	buildRecord(model)
	Builder.NoteForRetry(model, app, build, gear, opts)
end

------------------------------------------------------------------------
-- A mesh that failed loads later: the boxers built meanwhile are rebuilt on it
------------------------------------------------------------------------
-- A body part or gear mesh that did not load leaves the default part / the part-built gear (never a box). BuilderTiers
-- and BuilderGear retry it on a backoff (Kit.ASSET_BACKOFF, a few minutes); when it loads (Kit.AssetReady) every boxer
-- whose last full Cosmetics ran while a load was failing is built again from that same call (the layers whose inputs
-- did not change stay cached; the one that fell back now resolves to the mesh). A boxer whose look changed since
-- (LookSig moved: a newer build or preview) or who left the DataModel is skipped and forgotten.
Builder.RETRY_SETTLE = 0.5 -- seconds: several meshes arriving together rebuild a boxer once
local retryArgs = setmetatable({}, { __mode = "k" }) -- model -> { app, build, gear, opts, sig }
local retryQueued = setmetatable({}, { __mode = "k" })
function Builder.NoteForRetry(model, app, build, gear, opts)
	if BuilderTiers.Failing() or BuilderGear.Failing() then
		retryArgs[model] = { app = app, build = build, gear = gear, opts = opts, sig = model:GetAttribute("LookSig") }
	else
		retryArgs[model] = nil
	end
end
function Builder.PendingRetries()
	local n = 0
	for _ in pairs(retryArgs) do
		n += 1
	end
	return n
end
function Builder.RetryBuilds()
	local n = 0
	for model, a in pairs(retryArgs) do
		local inGame = false
		pcall(function()
			inGame = model:IsDescendantOf(game) or model:FindFirstAncestorWhichIsA("Workspace") ~= nil
		end)
		if not inGame or model:GetAttribute("LookSig") ~= a.sig then
			retryArgs[model] = nil
		elseif not retryQueued[model] then
			retryQueued[model] = true
			n += 1
			task.delay(Builder.RETRY_SETTLE, function()
				retryQueued[model] = nil
				local cur = retryArgs[model]
				if cur ~= a or not model.Parent then
					return
				end
				retryArgs[model] = nil
				local ok, err = pcall(Builder.Cosmetics, model, a.app, a.build, a.gear, a.opts)
				if not ok then
					warn("[Boxer] rebuild after a mesh loaded failed on " .. tostring(model.Name) .. ":", err)
				end
				pcall(Builder.OnPlaced, model)
			end)
		end
	end
	return n
end
Kit.OnAssetReady(function()
	Builder.RetryBuilds()
end)

-- Apply to a live player character (yields). Re-scales only when the body changed.
function Builder.Apply(character, app, build, gear, opts)
	local hum = character:WaitForChild("Humanoid", 10)
	if not hum then
		return
	end
	local key = Builder.ScaleKey(app, build, opts)
	if character:GetAttribute("ScaleKey") ~= key then
		local ok, err = pcall(function()
			hum:ApplyDescription(Builder.Description(app, build, opts))
		end)
		local av = opts and opts.avatar
		if not ok and type(av) == "table" then
			-- the avatar's items would not load (offsale, deleted, moderated, a web hiccup): the game look,
			-- and the avatar again only after AvatarLook's back-off
			warn("[Boxer] ApplyDescription with the avatar look failed (game look instead):", err)
			if opts.avatarUser then
				AvatarLook.ApplyFailed(opts.avatarUser)
			end
			av = nil
			local plain = table.clone(opts)
			plain.avatar = nil
			key = Builder.ScaleKey(app, build, plain)
			ok, err = pcall(function()
				hum:ApplyDescription(Builder.Description(app, build, plain))
			end)
		end
		if not ok then
			warn("[Boxer] ApplyDescription failed:", err)
		end
		character:SetAttribute("ScaleKey", key)
		local avKey = AvatarLook.Key(av)
		character:SetAttribute("AvatarLook", avKey ~= "" and avKey or nil)
	end
	-- [Studio] the Avatar Joint Upgrade's AnimationConstraint joints -> Motor6Ds before the layers are fitted (RigJoints)
	pcall(function()
		require(script.Parent:WaitForChild("RigJoints")).WatchMotors(character)
	end)
	if character.Parent then
		-- a player's own boxer: his meshes load before any background / NPC load (Kit.Priority)
		Kit.Priority(Builder.Cosmetics, character, app, build, gear, opts)
		-- the engine's deferred passes after the description (scaling, the head conversion) run after this returns
		Builder.OnPlaced(character)
	end
end

-- The staging container an NPC is built in. CreateHumanoidModelFromDescription hands back a model OUTSIDE the
-- DataModel, and the Humanoid's rig operations the Cosmetics run on it (ReplaceBodyPartR15 for the tier parts and the
-- classic head, the body scaling they trigger) read engine state through the model's DataModel: outside it the
-- engine logs "Instance outside of DataModel; could not read property Workspace.MeshPartHeadsAndAccessories" and a
-- swap can be refused or come out at the wrong size / class (the default MeshPart head under a headgear built for
-- the classic one). So the model is parented into ServerStorage first (inside the DataModel, no replication, no
-- physics), built, then handed back unparented as before (every caller parents it where it goes).
-- Builder.Services.Stage: an override (tests) or any container; nil when no container could be made (the old,
-- unparented build, warned once).
Builder.Services = Builder.Services or {}
local stageWarned = false
local function stageFolder()
	local s = Builder.Services.Stage
	if s ~= nil then
		return s or nil
	end
	local ok, f = pcall(function()
		local ss = game:GetService("ServerStorage")
		local f = ss:FindFirstChild("BoxerStaging")
		if not f then
			f = Instance.new("Folder")
			f.Name = "BoxerStaging"
			f.Parent = ss
		end
		return f
	end)
	if ok and f then
		Builder.Services.Stage = f
		return f
	end
	if not stageWarned then
		stageWarned = true
		warn("[Boxer] no staging container for NPC builds (rigs are built outside the DataModel):", f)
	end
	Builder.Services.Stage = false
	return nil
end
Builder.StageFolder = stageFolder

function Builder.CreateNPC(app, build, gear, displayName, opts)
	local model
	local ok, err = pcall(function()
		model = Players:CreateHumanoidModelFromDescription(Builder.Description(app, build, opts), Enum.HumanoidRigType.R15)
	end)
	if not ok or not model then
		warn("[Boxer] CreateHumanoidModelFromDescription failed:", err)
		return nil
	end
	model.Name = displayName or "Boxer"
	-- [Studio] the Avatar Joint Upgrade's AnimationConstraint joints -> Motor6Ds before anything is built on it (RigJoints)
	pcall(function()
		require(script.Parent:WaitForChild("RigJoints")).WatchMotors(model)
	end)
	local animate = model:FindFirstChild("Animate")
	if animate then
		animate:Destroy()
	end
	local hum = model:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.DisplayName = displayName or "Boxer"
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end
	-- inside the DataModel for every rig operation (see stageFolder); the root held still while the build yields
	local stage = stageFolder()
	local root = model:FindFirstChild("HumanoidRootPart")
	local wasAnchored = root and root:IsA("BasePart") and root.Anchored
	if stage then
		if root and root:IsA("BasePart") then
			root.Anchored = true
		end
		model.Parent = stage
	end
	local okC, errC = pcall(Builder.Cosmetics, model, app, build, gear, opts)
	if stage then
		model.Parent = nil
		if root and root.Parent and wasAnchored ~= nil then
			root.Anchored = wasAnchored
		end
	end
	if not okC then
		-- (as before the staging: the error is the caller's - SpawnReferee's pcall, Ambient's spawn thread)
		error(errC, 0)
	end
	-- nothing in the game listens for touches: an NPC's parts that report none cost the physics less (the
	-- built layers' parts already have it off; this is the R15 body itself)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CanTouch = false
		end
	end
	-- the late re-fit once the caller places it in Workspace (Builder.OnPlaced; the callers' own hook covers a clone,
	-- which carries no connection)
	pcall(function()
		local conn
		conn = model.AncestryChanged:Connect(function()
			if model:FindFirstAncestorWhichIsA("Workspace") then
				conn:Disconnect()
				Builder.OnPlaced(model)
			end
		end)
	end)
	return model
end

return Builder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="48">
        <Properties>
          <string name="Name">BuilderBody</string>
          <string name="Source"><![CDATA[-- BuilderBody: everything built on the body below the head (server side), split out of Builder.
-- * the body itself is the standard R15 rig with the muscle-tier parts (BuilderTiers, BodyTiers): the round-1
--   part-built muscles, hull, veins and fat layers are retired (Muscles only clears what an older build left)
-- * body resolution (Resolve): physique archetype, per-muscle levels, fat, definition, veins, detail level
--   (the model attributes, LookData and the training screens read it)
-- * colours: skin, satin trunks, shoes, referee / cornerman outfits on the R15 parts
-- * the gear is the Blender-modelled meshes of BuilderGear (tools/body/build_gear.py) fitted to every muscle tier:
--   trunks per style (waistband, seat, legs, side stripe, hem), boots / low-tops (foot, sole, laces, shaft, sock),
--   the women's sports top, gloves (glove, cuff, strap) and hand wraps, coloured from the look's gear colours.
--   Whatever is not available (a default part, an id 0, a failed load) falls back to the part-built gear below:
-- * attire: trunks, sponsor patches, socks, trainers / boxing boots by brand (sole types, laces with swinging
--   tails), referee and cornerman outfits, robe: sized from the parts' own boxes (the tier meshes' bounding
--   boxes, BodyAssetData sizes x the description's scales), so they fit every tier
-- * gloves with brand signatures (shape, oz, lace / velcro closure, piping, stitching, palm tone,
--   wordmark, plates, fight-night tape), visible wear and sweat; layered hand wraps
-- * level of detail (Config.DetailLevel) and per-folder rebuild caching (Kit.cached / Kit.seal)
-- Builder.Cosmetics runs Colors first, then (after the head) Muscles, Attire and Hands; Builder
-- forwards SetRobe here and uses Resolve / frameOf / Gear for scales and model attributes.
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Catalog = require(Shared:WaitForChild("Catalog"))
local Looks = require(Shared:WaitForChild("Looks"))
local Kit = require(script.Parent:WaitForChild("BuilderKit"))
local BodyTiers = require(script.Parent:WaitForChild("BodyTiers"))
local Hair = require(script.Parent:WaitForChild("BuilderHair")) -- (IsHairAccessory: the avatar's hair stays)
local Gear = require(script.Parent:WaitForChild("BuilderGear")) -- the Blender-modelled gear meshes

local Body = {}

local V3, CF, ANG, SMOOTH = Kit.V3, Kit.CF, Kit.ANG, Kit.SMOOTH
local lerpColor, darken, contrast, rgb = Kit.lerpColor, Kit.darken, Kit.contrast, Kit.rgb
local mk, textPatch, getFolder, part = Kit.mk, Kit.textPatch, Kit.getFolder, Kit.part
local RAD = math.rad
local WHITE = Color3.new(1, 1, 1)
local GOLD = Color3.fromRGB(255, 200, 40)
local FABRIC, LEATHER, RUBBER = Enum.Material.Fabric, Enum.Material.Leather, Enum.Material.Rubber

local LOD = { low = 1, medium = 2, full = 3 }

local function q(v, step)
	return math.floor(v / step + 0.5) * step
end

------------------------------------------------------------------------
-- Frame / training helpers (also used by Builder.Scales)
------------------------------------------------------------------------
local function frameOf(app)
	return Config.FindById(Config.BodyTypes, app.body and app.body.frame or "Athletic") or Config.BodyTypes[2]
end

local function avgDev(build, keys)
	local t = 0
	for _, k in ipairs(keys) do
		t += (build and tonumber(build[k]) or 10)
	end
	return t / #keys / 100
end

-- gear table with the CONTRACTS section 4 defaults filled in (never mutates the caller's table)
local GEAR_DEFAULTS = { gloves = "Worn", wraps = "OldWraps", shoes = "Sneakers", mouthguard = "BoilBite", glovesCond = 100, wrapsCond = 100, shoesCond = 100 }
local function gearOf(gear)
	local out = {}
	if type(gear) == "table" then
		for k, v in pairs(gear) do
			out[k] = v
		end
	end
	for k, v in pairs(GEAR_DEFAULTS) do
		if out[k] == nil then
			out[k] = v
		end
	end
	return out
end

------------------------------------------------------------------------
-- Physique & body resolution (one table every body layer reads)
------------------------------------------------------------------------
-- body sliders that scale a muscle group (back follows half the shoulder slider)
local GROUP_SLIDER = { chest = "chest", shoulders = "shoulders", arms = "arms", legs = "legs", neck = "neck", back = "shoulders" }
local GROUP_SLIDER_K = { back = 0.5 }

-- silhouette knobs per physique on top of Config.Physiques (shape / defBonus / width are data there):
-- elong = muscle length (long and wiry vs short and round), flat = protrusion, groove = separation
-- lines, waist = love handles / hip width, taper = lat flare (V-taper)
local PV = {
	BeginnerLean = { elong = 1.0, flat = 0.85, groove = 0.6, waist = 1.0, taper = 0.9 },
	LeanTechnical = { elong = 1.08, flat = 0.9, groove = 1.15, waist = 0.92, taper = 1.0 },
	Balanced = { elong = 1.0, flat = 1.0, groove = 1.0, waist = 1.0, taper = 1.0 },
	PowerPuncher = { elong = 0.95, flat = 1.12, groove = 0.95, waist = 1.05, taper = 1.1 },
	Heavyweight = { elong = 0.94, flat = 1.0, groove = 0.55, waist = 1.2, taper = 0.95 },
	EliteChampion = { elong = 1.03, flat = 1.06, groove = 1.35, waist = 0.95, taper = 1.2 },
}

-- visual archetype: opts.physique (players always get it from Training.PhysiqueInfo via LookOpts) >
-- a pinned app.body.physique > classification of the build (NPCs and previews only)
local function physiqueOf(app, build, opts)
	local id = opts and opts.physique
	if type(id) ~= "string" or not Config.FindById(Config.Physiques, id) then
		local pinned = app.body and app.body.physique
		if type(pinned) == "string" and pinned ~= "Auto" and Config.FindById(Config.Physiques, pinned) then
			id = pinned
		else
			local ok, res = pcall(Config.ClassifyPhysique, build or {}, { frame = app.body and app.body.frame, tier = opts and opts.tier })
			id = ok and res or "Balanced"
		end
	end
	return Config.FindById(Config.Physiques, id) or Config.FindById(Config.Physiques, "Balanced") or Config.Physiques[1]
end

-- (app, build, opts, model?) -> spec: physique, per-part levels, fat, definition, veins, detail level.
-- model (optional) supplies the Grime attribute when opts.grime is not given.
local function resolve(app, build, opts, model)
	app = app or {}
	opts = opts or {}
	build = type(build) == "table" and build or {}
	local frame = frameOf(app)
	local ph = physiqueOf(app, build, opts)
	local pv = PV[ph.id] or PV.Balanced
	local sl = app.body or {}
	local female = app.gender == 2
	local BF = Config.BodyFat
	-- quantised so the small fat / water changes of every session do not defeat the rebuild cache
	local fat = q(math.clamp(tonumber(build.fat) or BF.default, BF.min, BF.max), 0.5)
	local dry = q(math.clamp(tonumber(opts.dry) or 0, 0, 1), 0.1)
	-- a weight cut strips water: reads ~1.5% leaner and drier than the scale says
	local def = Config.Definition(fat - 1.5 * dry, (ph.defBonus or 0) + 0.15 * dry)
	local fatK = math.clamp((fat - 12) / 14, 0, 1)
	-- part values are capped at 100 * potential by training; normalise half of that back out so a
	-- maxed Lean frame still looks trained while a Heavyweight frame still out-sizes it
	local norm = 0.55 + 0.45 / (frame.potential or 1)
	local lv = {}
	for _, p in ipairs(Config.MuscleParts) do
		local g = p.group
		local slider = tonumber(sl[GROUP_SLIDER[g] or ""]) or 0
		local v = Config.PartValue(build, p.id) / 100 * norm * ((ph.shape and ph.shape[g]) or 1) * (1 + 0.3 * slider * (GROUP_SLIDER_K[g] or 1))
		if female then
			v *= 0.7
		end
		-- 0.04 of a level is < 0.01 stud of muscle: invisible, but it keeps rebuilds rare
		lv[p.id] = q(math.clamp(v, 0, 1.35), 0.04)
	end
	local vasc = math.clamp(tonumber(build.vasc) or 0, 0, 100) / 100
	local arm = (lv.forearms + lv.biceps) / 2
	local vein = 0.5 * vasc + 0.4 * math.clamp((def - BF.veinDef) / (1 - BF.veinDef), 0, 1) + 0.25 * math.clamp(arm - 0.35, 0, 1)
	vein *= (ph.vein or 1) * (1 + 0.3 * dry) * (1 - math.clamp((fat - 15) / 6, 0, 1))
	local bulk = (lv.pecs + lv.upperChest + lv.frontDelt + lv.sideDelt + lv.biceps + lv.triceps + lv.lats + lv.traps) / 8
	local d, cfg = Config.DetailLevel(opts)
	local grime = tonumber(opts.grime) or (model and tonumber(model:GetAttribute("Grime"))) or 0
	grime = math.clamp(grime, 0, 1)
	return {
		frame = frame, ph = ph, pv = pv, female = female, fat = fat, fatK = fatK, dry = dry,
		def = q(def, 0.05), lv = lv, vein = q(math.clamp(vein, 0, 1), 0.05), bulk = q(math.clamp(bulk, 0, 1), 0.05),
		detail = d, cfg = cfg, lod = LOD[d] or 3, outfit = opts.outfit, grime = q(grime, 0.1),
		skin = Looks.Color(Looks.SkinTones[app.skin or 5]),
	}
end

------------------------------------------------------------------------
-- Muscles: retired (the muscle-tier body parts carry the muscle)
------------------------------------------------------------------------
-- attire / robe clipping envelope: how far (ratio of the half size) the body reaches past each part's box. The
-- tier meshes fill their parts' boxes (Size = the mesh's bounding box), so it is 1 everywhere now; an older
-- build's Muscles folder attributes are still read until Muscles clears it
local ENV_FAMS = { "UT", "UA", "UL", "LL", "LA", "LT" }
local function readEnv(model)
	local look = model:FindFirstChild("BoxerLook")
	local f = look and look:FindFirstChild("Muscles")
	local env = {}
	for _, fam in ipairs(ENV_FAMS) do
		local v = f and f:GetAttribute("Env" .. fam)
		local top = f and f:GetAttribute("EnvTop" .. fam)
		env[fam] = { x = v and v.X or 1, zf = v and v.Y or 1, zb = v and v.Z or 1, y = top or 1 }
	end
	return env
end

local function sizesOf(model, names)
	local out = {}
	for _, n in ipairs(names) do
		local p = part(model, n)
		out[#out + 1] = p and p.Size or false
	end
	return out
end
local function shoeOf(gear)
	return Catalog.Find(Catalog.Shoes, gear.shoes) or Catalog.Shoes[1]
end

-- an official's outfit colours: opts.officialColors (Officials.Colors: the venue's / a title fight's shirt) or the
-- defaults. -> shirt, trousers, the whole table (Color3 values) or nil for a boxer
local OFFICIAL_DEFAULTS = {
	referee = { shirt = { 150, 190, 226 }, trousers = { 22, 22, 26 }, shoes = { 14, 14, 16 } },
	cornerman = { shirt = nil, trousers = { 38, 38, 44 }, shoes = { 236, 236, 232 } },
}
local function outfitColors(app, outfit, opts)
	local def = OFFICIAL_DEFAULTS[outfit or ""]
	if not def then
		return nil
	end
	local oc = (opts and type(opts.officialColors) == "table") and opts.officialColors or {}
	local out = {}
	for k, v in pairs(oc) do
		out[k] = rgb(v, nil)
	end
	local fallbackShirt = outfit == "cornerman" and Looks.Color(app.attire and app.attire.trim, Color3.fromRGB(30, 30, 34))
		or rgb(def.shirt, WHITE)
	out.shirt = out.shirt or fallbackShirt
	out.trousers = out.trousers or rgb(def.trousers, Color3.fromRGB(24, 24, 28))
	out.shoes = out.shoes or rgb(def.shoes, Color3.fromRGB(20, 20, 22))
	return out.shirt, out.trousers, out
end

-- the R15 parts the retired hull hid (Transparency 1): shown again when an older build's folder is cleared
local HULL_PARTS = { "UpperTorso", "LeftUpperArm", "RightUpperArm", "LeftLowerArm", "RightLowerArm", "LeftUpperLeg", "RightUpperLeg", "LeftLowerLeg", "RightLowerLeg" }

-- (model, ...) -> the attire envelope. Clears the round-1 muscle layer an older build left (its folder, and the
-- R15 blocks its hull hid); the arguments of the old step are accepted and ignored
local function musclesBuild(model)
	local look = model:FindFirstChild("BoxerLook")
	local f = look and look:FindFirstChild("Muscles")
	if f then
		f:Destroy()
		for _, n in ipairs(HULL_PARTS) do
			local p = part(model, n)
			if p and p:IsA("BasePart") and p.Transparency >= 1 then
				p.Transparency = 0
			end
		end
	end
	return readEnv(model)
end

------------------------------------------------------------------------
-- Colours of the R15 parts (skin, trunks, shoes, outfits)
------------------------------------------------------------------------
-- shoe wear in 5-point steps (60 = like new): the uncached R15 feet and the cached Attire overlays
-- (toe box, collar, boot shaft, tongue) both use this bucket, and the Attire key includes it, so the
-- two never drift into a clean toe and a grubby heel
local function shoeCond(gear)
	return math.min(60, q(tonumber(gear.shoesCond) or 100, 5))
end

local function shoeColorOf(app, gear)
	local a = app.attire or {}
	local c = Looks.Color(a.shoes, Color3.fromRGB(25, 25, 25))
	local cond = shoeCond(gear)
	if cond < 60 then
		-- worn-out shoes fade and get grubby
		c = lerpColor(c, Color3.fromRGB(95, 85, 70), (60 - cond) / 60 * 0.45)
	end
	return c
end

local function colorBody(model, app, gear, opts)
	opts = opts or {}
	gear = gearOf(gear)
	local skin = Looks.Color(Looks.SkinTones[app.skin or 5])
	local a = app.attire or {}
	local shoeColor = shoeColorOf(app, gear)
	local trainer = shoeOf(gear).style == "trainer"
	local trunks = Looks.Color(a.trunks, Color3.fromRGB(200, 25, 30))
	local shirt, trousers, oc = outfitColors(app, opts.outfit, opts)
	local bc = model:FindFirstChildOfClass("BodyColors")
	if bc then
		bc:Destroy()
	end
	local smooth = (app.face and app.face.smooth or 0.5) >= 0.5
	for _, p in ipairs(model:GetChildren()) do
		if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
			local n = p.Name
			if n == "LowerTorso" then
				p.Color = trousers or trunks
				p.Material = trousers and FABRIC or SMOOTH -- satin trunks (the Fabric texture reads as noise at play distance)
			elseif n:find("Foot") then
				if trousers then
					-- (under the officials' mesh shoes: their colour)
					p.Color = oc and oc.shoes or Color3.fromRGB(20, 20, 22)
					p.Material = SMOOTH
				else
					p.Color = shoeColor
					p.Material = trainer and FABRIC or LEATHER
				end
			elseif shirt and (n == "UpperTorso" or n:find("UpperArm")) then
				p.Color = shirt
				p.Material = FABRIC
			elseif trousers and (n:find("UpperLeg") or n:find("LowerLeg")) then
				p.Color = trousers
				p.Material = FABRIC
			elseif n == "Head" then
				-- the face step owns the head's material (skin pores / smoothness) and may be cached
				p.Color = skin
			else
				p.Color = skin
				p.Material = smooth and SMOOTH or Enum.Material.Plastic
			end
		end
	end
	-- women: the sports top. The mesh top (Attire) goes over a skin torso; without it the whole UpperTorso takes the
	-- top's colour (the part-built look; Attire repaints it should the mesh top fail to load)
	if app.gender == 2 and not shirt and not Gear.Available(model, "top", "Top") then
		local ut = model:FindFirstChild("UpperTorso")
		if ut then
			ut.Color = Looks.Color(a.trim, WHITE)
			ut.Material = SMOOTH
		end
	end
	-- (a player's avatar hair accessories stay: Builder's AvatarHair, the description put them on)
	local keepHair = model:GetAttribute("AvatarHair") == true
	for _, c in ipairs(model:GetChildren()) do
		if c:IsA("Shirt") or c:IsA("Pants") or c:IsA("ShirtGraphic") or (c:IsA("Accessory") and not (keepHair and Hair.IsHairAccessory(c))) then
			c:Destroy()
		end
	end
end

------------------------------------------------------------------------
-- Attire: trunks, sponsor patches, shoes / boots, officials' outfits
------------------------------------------------------------------------
-- swinging lace / wrap ends: a Motor6D chain tagged HairSway (the Animator's hair sway drives it)
local function tail(folder, anchor, startCF, look, segs, segLen, w, color, mat, stiff, mass, name)
	local parent = anchor
	local pos = startCF.Position
	for i = 1, segs do
		local orient = CFrame.lookAt(pos, pos + look) * ANG(RAD(90), 0, 0) -- -Y along the hanging direction
		local p = mk(folder, nil, name, V3(w, segLen, w * 0.6), orient * CF(0, -segLen / 2, 0), color, "Block", mat)
		local m = Instance.new("Motor6D")
		m.Name = "HairJoint"
		m.Part0 = parent
		m.Part1 = p
		m.C0 = parent.CFrame:Inverse() * orient
		m.C1 = p.CFrame:Inverse() * orient
		m:SetAttribute("Depth", i)
		m:SetAttribute("Stiff", stiff)
		m:SetAttribute("Mass", mass)
		m.Parent = p
		CollectionService:AddTag(m, "HairSway")
		parent = p
		pos = (orient * CF(0, -segLen, 0)).Position
		look = (look + V3(0, -0.8, 0)).Unit
	end
end

local function initials(name)
	local out = ""
	for w in tostring(name or ""):gmatch("%S+") do
		out ..= w:sub(1, 1):upper()
	end
	return out:sub(1, 3)
end

-- sponsor { text, fg = {r,g,b}, bg = {r,g,b} } (Career.LookOpts) -> text, fg, bg or nil
local function sponsorOf(s)
	if type(s) ~= "table" or type(s.text) ~= "string" or s.text == "" then
		return nil
	end
	return s.text:upper():sub(1, 14), rgb(s.fg, WHITE), rgb(s.bg, Color3.fromRGB(20, 20, 20))
end

local SOLE = {
	Foam = { h = 0.15, color = Color3.fromRGB(236, 236, 230), mat = SMOOTH },
	Rubber = { h = 0.13, mat = RUBBER }, -- colour = trim (boots: red laces, red soles)
	Gum = { h = 0.12, color = Color3.fromRGB(178, 124, 70), mat = RUBBER },
	Suede = { h = 0.07, color = Color3.fromRGB(52, 46, 40), mat = FABRIC },
	Split = { h = 0.11, mat = RUBBER },
}

local function soleBuild(folder, foot, kind, trim, lod)
	local fs = foot.Size
	local so = SOLE[kind] or SOLE.Rubber
	local color = so.color or trim
	local y = -fs.Y * 0.5 + so.h * 0.25
	if kind == "Split" and lod >= 2 then
		-- split sole: forefoot pad and heel pad with a flexible arch gap (elite footwork boots)
		mk(folder, foot, "Sole", V3(fs.X * 1.06, so.h, fs.Z * 0.6), foot.CFrame * CF(0, y, -fs.Z * 0.24), color, "Block", so.mat)
		mk(folder, foot, "SoleHeel", V3(fs.X * 1.04, so.h, fs.Z * 0.3), foot.CFrame * CF(0, y, fs.Z * 0.39), color, "Block", so.mat)
	else
		mk(folder, foot, "Sole", V3(fs.X * 1.06, so.h, fs.Z * 1.08), foot.CFrame * CF(0, y, 0), color, "Block", so.mat)
	end
end

local function shoesBuild(folder, model, app, opts, gear, sp, env)
	local a = app.attire or {}
	local lod, cfg = sp.lod, sp.cfg
	local shoe = shoeOf(gear)
	local brand = Catalog.GearBrand("shoes", shoe.id)
	local style = shoe.style or "boot"
	local trainer = style == "trainer"
	local tall = a.shoeStyle ~= "Low-Top"
	local cond = gear.shoesCond or 100
	local shoeColor = shoeColorOf(app, gear)
	local trim = Looks.Color(a.trim, WHITE)
	local socks = Looks.Color(a.socks, WHITE)
	local laceColor = Looks.Color(a.laces, Color3.fromRGB(240, 240, 240))
	if cond < 40 then
		laceColor = lerpColor(laceColor, Color3.fromRGB(170, 160, 140), 0.5)
	end
	local pal = brand.palette or {}
	local accent = rgb(pal.secondary, WHITE)
	if (accent.R + accent.G + accent.B) - (shoeColor.R + shoeColor.G + shoeColor.B) < 0.25 and (shoeColor.R + shoeColor.G + shoeColor.B) - (accent.R + accent.G + accent.B) < 0.25 then
		accent = rgb(pal.accent, contrast(shoeColor)) -- keep the brand stripe readable on a same-colour shoe
	end
	local soleKind = shoe.sole or brand.sole or "Rubber"
	local metal = style == "eliteBoot" and Enum.Material.Foil or Enum.Material.Metal
	local eyeletColor = style == "eliteBoot" and Color3.fromRGB(230, 190, 80) or Color3.fromRGB(210, 210, 216)
	for _, side in ipairs({ "Left", "Right" }) do
		local sign = side == "Left" and -1 or 1
		local ll, foot = part(model, side .. "LowerLeg"), part(model, side .. "Foot")
		local laceTop -- world CFrame where the bow sits
		if ll then
			local s = ll.Size
			if trainer then
				if tall then
					-- hi-top trainer collar round the ankle
					mk(folder, ll, "Collar", V3(s.X * 1.07, s.Y * 0.22, s.Z * 1.09), ll.CFrame * CF(0, -s.Y * 0.39, 0.01), shoeColor, "Block", FABRIC)
					laceTop = ll.CFrame * CF(0, -s.Y * 0.32, -s.Z * 0.56 - 0.02)
				else
					mk(folder, ll, "Sock", V3(s.X * 1.03, s.Y * 0.38, s.Z * 1.03), ll.CFrame * CF(0, -s.Y * 0.31, 0), socks, "Block", SMOOTH)
				end
			else
				-- boxing boot: laced leather shaft (to mid-calf, or the ankle for low-cut boots), sock above it
				local topY = tall and -0.02 or -0.3
				local h = 0.5 + topY
				local cy = -0.5 + h / 2
				local zb = 1.16 -- the calves sit above the shaft top, so the shaft never needs to grow
				mk(folder, ll, "BootShaft", V3(s.X * 1.1, s.Y * h, s.Z * zb), ll.CFrame * CF(0, s.Y * cy, s.Z * 0.02), shoeColor, "Block", LEATHER)
				mk(folder, ll, "Sock", V3(s.X * 1.05, s.Y * 0.09, s.Z * 1.08), ll.CFrame * CF(0, s.Y * (topY + 0.045), s.Z * 0.01), socks, "Block", SMOOTH)
				local fz = -s.Z * 0.56 - 0.012
				if lod >= 2 and cfg.laces ~= "full" then
					-- eyelet rows (the full criss-cross laces cover that line, so they are skipped there)
					for _, ex in ipairs({ -1, 1 }) do
						mk(folder, ll, "Eyelets", V3(0.035, s.Y * (h - 0.14), 0.03), ll.CFrame * CF(ex * s.X * 0.15, s.Y * (cy + 0.03), fz - 0.004), eyeletColor, "Block", metal)
					end
				end
				if lod >= 2 then
					-- padded tongue rising out of the shaft top
					mk(folder, ll, "Tongue", V3(s.X * 0.32, 0.16, 0.06), ll.CFrame * CF(0, s.Y * topY + 0.05, fz + 0.01), darken(shoeColor, 0.9), "Block", LEATHER)
				end
				if cfg.laces == "full" then
					local n = tall and 2 or 1
					local span = s.Y * (h - 0.16)
					for k = 0, n - 1 do
						local y = -s.Y * 0.5 + s.Y * 0.1 + (k + 0.5) * span / n
						for _, rot in ipairs({ 1, -1 }) do
							mk(folder, ll, "Lace", V3(s.X * 0.33, 0.035, 0.03), ll.CFrame * CF(0, y, fz - 0.01) * ANG(0, 0, rot * RAD(26)), laceColor, "Block", SMOOTH)
						end
					end
				elseif cfg.laces == "merged" then
					mk(folder, ll, "Laces", V3(s.X * 0.26, s.Y * (h - 0.16), 0.03), ll.CFrame * CF(0, s.Y * (cy + 0.03), fz - 0.01), laceColor, "Block", FABRIC)
				end
				laceTop = ll.CFrame * CF(0, s.Y * (topY - 0.04), fz - 0.02)
				if lod >= 2 and style == "proBoot" then
					-- pro boots: breathable mesh panel on the outside of the shaft
					mk(folder, ll, "MeshPanel", V3(0.03, s.Y * (h - 0.12), s.Z * 0.6), ll.CFrame * CF(sign * (s.X * 0.55 + 0.012), s.Y * cy, s.Z * 0.04), darken(shoeColor, 0.75), "Block", FABRIC)
				elseif lod >= 2 and style == "eliteBoot" then
					mk(folder, ll, "AccentStripe", V3(0.03, s.Y * (h - 0.08), 0.07), ll.CFrame * CF(sign * (s.X * 0.55 + 0.012), s.Y * cy, -s.Z * 0.12) * ANG(RAD(12), 0, 0), rgb(pal.accent, GOLD), "Block", Enum.Material.Foil)
				end
				if cfg.wordmarks and (brand.wordmark or "") ~= "" then
					textPatch(folder, ll, "Wordmark", V3(0.02, s.Y * math.min(0.12, h * 0.3), s.Z * 0.8), ll.CFrame * CF(sign * (s.X * 0.55 + 0.016), s.Y * (cy + h * 0.18), s.Z * 0.02),
						brand.wordmark, rgb(brand.wordColor, contrast(shoeColor)), sign > 0 and Enum.NormalId.Right or Enum.NormalId.Left, brand.font)
				end
				if cfg.wordmarks and style == "eliteBoot" then
					-- elite boots: the boxer's initials on a heel nameplate
					local heel = initials(opts.name)
					if heel ~= "" then
						textPatch(folder, ll, "HeelMark", V3(s.X * 0.5, s.Y * math.min(0.14, h * 0.4), 0.02), ll.CFrame * CF(0, s.Y * (cy - h * 0.15), s.Z * zb * 0.5 + 0.03),
							heel, GOLD, Enum.NormalId.Back, brand.font)
					end
				end
			end
		end
		if foot then
			local fs = foot.Size
			if trainer then
				-- running-shoe build: foam midsole, rubber outsole, rounded toe box, brand stripe, heel tab
				local outsole = soleKind == "Gum" and SOLE.Gum.color or Color3.fromRGB(42, 42, 44)
				mk(folder, foot, "Midsole", V3(fs.X * 1.05, 0.13, fs.Z * 1.07), foot.CFrame * CF(0, -fs.Y * 0.5 + 0.03, 0), Color3.fromRGB(238, 238, 232), "Block", SMOOTH)
				if lod >= 2 then
					mk(folder, foot, "Outsole", V3(fs.X * 1.03, 0.045, fs.Z * 1.05), foot.CFrame * CF(0, -fs.Y * 0.5 - 0.045, 0), outsole, "Block", RUBBER)
					mk(folder, foot, "ToeBox", V3(fs.X * 1.0, fs.Y * 1.05, fs.Z * 0.5), foot.CFrame * CF(0, -0.01, -fs.Z * 0.3), shoeColor, "Ellipsoid", FABRIC)
				end
				if lod >= 3 then
					mk(folder, foot, "Stripe", V3(0.03, 0.09, fs.Z * 0.62), foot.CFrame * CF(sign * (fs.X * 0.5 + 0.012), 0, 0.04) * ANG(RAD(-18), 0, 0), accent, "Block", SMOOTH)
					mk(folder, foot, "HeelTab", V3(fs.X * 0.28, 0.16, 0.05), foot.CFrame * CF(0, fs.Y * 0.3, fs.Z * 0.5 + 0.02), accent, "Block", SMOOTH)
					mk(folder, foot, "Tongue", V3(fs.X * 0.34, 0.05, fs.Z * 0.34), foot.CFrame * CF(0, fs.Y * 0.5 + 0.02, -fs.Z * 0.08) * ANG(RAD(-12), 0, 0), lerpColor(shoeColor, WHITE, 0.08), "Block", FABRIC)
				end
				if cfg.laces == "full" then
					for k = 0, 1 do
						mk(folder, foot, "LaceBar", V3(fs.X * 0.3, 0.03, 0.045), foot.CFrame * CF(0, fs.Y * 0.5 + 0.035, -fs.Z * (0.3 - k * 0.16)), laceColor, "Block", SMOOTH)
					end
				elseif cfg.laces == "merged" then
					mk(folder, foot, "Laces", V3(0.25, 0.04, fs.Z * 0.4), foot.CFrame * CF(0, fs.Y * 0.5 + 0.01, -fs.Z * 0.2), laceColor, "Block", SMOOTH)
				end
				laceTop = laceTop or (foot.CFrame * CF(0, fs.Y * 0.5 + 0.05, -fs.Z * 0.06))
			else
				soleBuild(folder, foot, soleKind, trim, lod)
				if lod >= 2 then
					mk(folder, foot, "ToeBox", V3(fs.X * 1.0, fs.Y * 1.05, fs.Z * 0.5), foot.CFrame * CF(0, 0, -fs.Z * 0.3), shoeColor, "Ellipsoid", LEATHER)
				end
				-- foot lacing strip, unless the criss-cross laces are already drawn on the shaft
				if cfg.laces ~= "none" and not (cfg.laces == "full" and ll) then
					mk(folder, foot, "Laces", V3(0.25, 0.04, fs.Z * 0.5), foot.CFrame * CF(0, fs.Y * 0.5, -fs.Z * 0.1), laceColor, "Block", SMOOTH)
				end
			end
			if cond < 60 and lod >= 2 then
				-- creased toe box
				mk(folder, foot, "Crease", V3(fs.X * 0.6, 0.02, 0.03), foot.CFrame * CF(0, fs.Y * 0.5 + 0.005, -fs.Z * 0.28), darken(shoeColor, 0.6), "Block", SMOOTH, 0.3)
			end
			if cond < 40 then
				-- scuffed toes and a split sole
				mk(folder, foot, "Scuff", V3(fs.X * 0.7, fs.Y * 0.5, 0.05), foot.CFrame * CF(0, 0, -fs.Z * 0.5 - 0.01), Color3.fromRGB(120, 110, 95), "Ellipsoid", SMOOTH, 0.3)
				mk(folder, foot, "SoleSplit", V3(fs.X * 0.5, 0.05, 0.08), foot.CFrame * CF(0, -fs.Y * 0.45, -fs.Z * 0.35), Color3.fromRGB(30, 30, 30), "Block")
			end
		end
		-- bow with two swinging lace ends
		if laceTop and cfg.laces == "full" then
			local anchor = trainer and not tall and foot or ll
			if anchor then
				mk(folder, anchor, "LaceBow", V3(0.2, 0.06, 0.05), laceTop, laceColor, "Ellipsoid", SMOOTH)
				for _, dx in ipairs({ -1, 1 }) do
					local start = laceTop * CF(dx * 0.05, -0.01, -0.02)
					local look = anchor.CFrame:VectorToWorldSpace(V3(dx * 0.35, -1, -0.35)).Unit
					tail(folder, anchor, start, look, 1, 0.16, 0.03, laceColor, SMOOTH, 0.3, 0.5, "LaceTail")
				end
			end
		end
	end
end

-- the mesh boots / shoes (BuilderGear): upper in the shoe colour (leather boots, fabric trainers), the sole by its
-- kind (SOLE: foam, rubber in the trim colour, gum, suede, split), laces, socks
local function shoesMesh(folder, app, gear, pieces)
	local a = app.attire or {}
	local shoe = shoeOf(gear)
	local brand = Catalog.GearBrand("shoes", shoe.id)
	local trainer = shoe.style == "trainer"
	local soleKind = shoe.sole or brand.sole or "Rubber"
	local so = SOLE[soleKind] or SOLE.Rubber
	local soleColor = so.color or Looks.Color(a.trim, WHITE)
	if trainer and soleKind ~= "Gum" then
		soleColor = Color3.fromRGB(238, 238, 232) -- (a trainer's foam midsole)
	end
	local laceColor = Looks.Color(a.laces, Color3.fromRGB(240, 240, 240))
	if (gear.shoesCond or 100) < 40 then
		laceColor = lerpColor(laceColor, Color3.fromRGB(170, 160, 140), 0.5)
	end
	local shoeColor = shoeColorOf(app, gear)
	local socks = Looks.Color(a.socks, WHITE)
	return Gear.Build(folder, pieces, function(slot)
		if slot == "soles" then
			return soleColor, trainer and SMOOTH or so.mat, 0
		elseif slot == "laces" then
			return laceColor, SMOOTH, 0
		elseif slot == "socks" then
			return socks, FABRIC, 0
		end
		return shoeColor, trainer and FABRIC or LEATHER, 0
	end)
end

-- the officials' mesh outfit (BuilderGear group "official", tools/body/build_official.py): the referee's button shirt,
-- bow tie, belted dress trousers and leather shoes; the coach's polo, towel, trousers and white shoes. Painted per
-- slot from outfitColors (the venue's shirt)
local OFFICIAL_SLOTS = {
	shirt = { "shirt", FABRIC }, shirtTrim = { "trim", FABRIC }, buttons = { "buttons", SMOOTH }, badge = { "badge", Enum.Material.Metal },
	bowtie = { "bowtie", SMOOTH }, trousers = { "trousers", FABRIC }, belt = { "belt", LEATHER }, buckle = { "buckle", Enum.Material.Metal },
	dressShoes = { "shoes", SMOOTH }, dressSoles = { "soles", RUBBER }, dressLaces = { "laces", FABRIC }, towel = { "towel", FABRIC },
}
local function officialStyle(outfit)
	return outfit == "referee" and "Referee" or "Coach"
end
local function outfitMesh(folder, model, app, opts, sp, pieces)
	local shirt, trousers, oc = outfitColors(app, sp.outfit, opts)
	local made = Gear.Build(folder, pieces, function(slot)
		local e = OFFICIAL_SLOTS[slot]
		local c = e and oc[e[1]]
		if not c then
			c = (slot == "shirtTrim" and darken(shirt, 0.93)) or (slot == "buttons" and WHITE) or (slot == "towel" and WHITE)
				or (slot == "dressSoles" and Color3.fromRGB(30, 26, 24)) or (slot == "badge" and GOLD) or trousers
		end
		-- (polished leather shoes: a little sheen)
		return c, e and e[2] or FABRIC, slot == "dressShoes" and 0.06 or (slot == "buckle" and 0.2 or 0)
	end)
	for _, p in pairs(made) do
		if p:GetAttribute("GearSlot") ~= "buttons" and p:GetAttribute("GearSlot") ~= "buckle" then
			p:SetAttribute("Wet", "cloth")
			p:SetAttribute("BaseColor", p.Color)
			p:SetAttribute("BaseRefl", p.Reflectance)
		end
	end
	-- the coach's team lettering on the polo's back
	local back = made.OffShirt
	local ut = part(model, "UpperTorso")
	if sp.outfit == "cornerman" and back and ut and sp.cfg.wordmarks then
		local bs = back.Size
		textPatch(folder, ut, "TeamText", V3(bs.X * 0.5, bs.Y * 0.09, 0.02), back.CFrame * CF(0, bs.Y * 0.2, bs.Z * 0.5 + 0.01), "CORNER",
			contrast(shirt), Enum.NormalId.Back, "Oswald")
	end
	return made
end

-- the height of the neck (the Neck pivot the head's base sits on) in the UpperTorso's space. A tier UpperTorso's box
-- reaches past it (the mesh's neck stub runs up into the head), so its top is NOT the shoulder line the round-1 blocks
-- were placed from: a collar or a robe at the box top rings the jaw. The default block: its top
local function neckHeight(ut)
	local a = ut and ut:FindFirstChild("NeckRigAttachment")
	if a and a:IsA("Attachment") then
		return math.min(a.Position.Y, ut.Size.Y * 0.5)
	end
	return ut and ut.Size.Y * 0.5 or 0
end
Body.NeckHeight = neckHeight

local function outfitBuild(folder, model, app, opts, sp)
	local outfit = sp.outfit
	local shirt = outfitColors(app, outfit, opts)
	local lod = sp.lod
	local ut, lt, head = part(model, "UpperTorso"), part(model, "LowerTorso"), part(model, "Head")
	local black = Color3.fromRGB(16, 16, 18)
	if ut then
		local s = BodyTiers.CoreSize(ut) -- (v17: the torso's own width, not the shoulder caps')
		-- shirt collar round the base of the neck (the ring's top just under the head's base: never up round the jaw),
		-- wide enough to stand round the tier torso's neck stub; button placket down the front
		local span = head and math.min(head.Size.X, head.Size.Y, head.Size.Z) or 1.2
		local d = 0.86 * span
		local ny = neckHeight(ut)
		local cy = ny - 0.09
		mk(folder, ut, "Collar", V3(0.14, d, d), ut.CFrame * CF(0, cy, 0.02) * ANG(0, 0, RAD(90)), shirt, "Cylinder", FABRIC)
		if outfit == "referee" then
			-- the bow tie on the collar's front, under the chin
			mk(folder, ut, "BowTie", V3(0.34, 0.12, 0.06), ut.CFrame * CF(0, cy - 0.04, 0.02 - d * 0.5 - 0.03), black, "Ellipsoid", SMOOTH)
			mk(folder, ut, "BowKnot", V3(0.08, 0.09, 0.07), ut.CFrame * CF(0, cy - 0.04, 0.02 - d * 0.5 - 0.06), Color3.fromRGB(30, 30, 34), "Ellipsoid", SMOOTH)
			if lod >= 2 then
				mk(folder, ut, "Placket", V3(0.1, s.Y * 0.82, 0.02), ut.CFrame * CF(0, -s.Y * 0.06, -s.Z * 0.5 - 0.012), darken(shirt, 0.94), "Block", FABRIC)
			end
		else
			-- cornerman: team polo with a towel over the shoulder and CORNER on the back
			-- (on the shoulder's top, out of the neck column, under the head's base)
			mk(folder, ut, "Towel", V3(0.5, 0.12, s.Z * 1.25), ut.CFrame * CF(math.max(s.X * 0.3, 0.55 * span), ny - 0.12, 0) * ANG(0, 0, RAD(-12)),
				Color3.fromRGB(235, 235, 230), "Block", FABRIC)
			if sp.cfg.wordmarks then
				textPatch(folder, ut, "TeamText", V3(s.X * 0.8, s.Y * 0.22, 0.02), ut.CFrame * CF(0, s.Y * 0.18, s.Z * 0.5 + 0.012), "CORNER", contrast(shirt), Enum.NormalId.Back, "Oswald")
			end
		end
	end
	for _, side in ipairs({ "Left", "Right" }) do
		local ua, foot = part(model, side .. "UpperArm"), part(model, side .. "Foot")
		if ua then
			-- short sleeve hem
			mk(folder, ua, "SleeveHem", V3(ua.Size.X * 1.08, 0.12, ua.Size.Z * 1.08), ua.CFrame * CF(0, -ua.Size.Y * 0.44, 0), darken(shirt, 0.95), "Block", FABRIC)
		end
		if foot then
			local fs = foot.Size
			mk(folder, foot, "Sole", V3(fs.X * 1.04, 0.06, fs.Z * 1.06), foot.CFrame * CF(0, -fs.Y * 0.5, 0), outfit == "referee" and black or Color3.fromRGB(235, 235, 235), "Block", RUBBER)
		end
	end
	if lt then
		local s = lt.Size
		mk(folder, lt, "Belt", V3(s.X * 1.06, s.Y * 0.4, s.Z * 1.08), lt.CFrame * CF(0, s.Y * 0.3, 0), black, "Block", LEATHER)
		if lod >= 2 then
			mk(folder, lt, "Buckle", V3(0.22, s.Y * 0.36, 0.03), lt.CFrame * CF(0, s.Y * 0.3, -s.Z * 0.54 - 0.012), Color3.fromRGB(200, 200, 205), "Block", Enum.Material.Metal)
		end
	end
end

-- the waistband: the top of the trunks at the waist joint, a little under half the waist-to-hip drop deep (the
-- default 0.4-stud block: 0.18 at +0.115, as before; a tier LowerTorso reaches down over the hips, so its box
-- size alone would put the band over the belly). -> height, centre (part space)
local function waistBand(lt)
	local s = lt.Size
	local wa, ha = lt:FindFirstChild("WaistRigAttachment"), lt:FindFirstChild("RightHipRigAttachment")
	local top = (wa and wa:IsA("Attachment")) and wa.Position.Y or s.Y * 0.5
	local hip = (ha and ha:IsA("Attachment")) and ha.Position.Y or -s.Y * 0.5
	local h = math.max(0.45 * (top - hip), 0.08)
	return h, top + 0.03 * h - h / 2
end

-- a tier part's measured girth (BodyAssetData tiers[n].fit[key]) at the part's scale: width (X), depth (Z), or nil
local function fitOf(p, key)
	local t = p and tonumber(p:GetAttribute("BodyTier"))
	local f = t and BodyTiers.Fit(t, key)
	if not f then
		return nil
	end
	local r = p:GetAttribute("BodyRatio")
	local kx, kz = 1, 1
	if typeof(r) == "Vector3" then
		kx, kz = r.X, r.Z
	end
	return f.width * kx, f.depth * kz
end

-- a joint's frame in world space from a part's rig attachment (the arm axis moves out per tier: gloves and wraps
-- follow the wrist joint, never a fixed offset), else the fallback offset
local function jointCF(p, attName, fallback)
	local a = p and p:FindFirstChild(attName)
	if a and a:IsA("Attachment") and p:GetAttribute("BodyTier") ~= nil then
		return p.CFrame * CF(a.Position)
	end
	return p.CFrame * fallback
end

local ATTIRE_PARTS = { "LowerTorso", "LeftUpperLeg", "LeftLowerLeg", "LeftFoot", "LeftUpperArm", "UpperTorso", "Head" }

-- top of the trunk leg shells relative to the thigh (depends on the hip, so it goes in the signature)
local function trunkTop(model, lt, ul, low)
	if not (lt and ul) then
		return 0.5
	end
	return math.clamp(((lt.Position.Y - lt.Size.Y * 0.5) - ul.Position.Y) / ul.Size.Y + 0.03, low + 0.3, 0.5)
end

local function attireBuild(model, app, opts, gear, sp, env)
	opts = opts or {}
	gear = gearOf(gear)
	sp = sp or resolve(app, nil, opts)
	env = env or readEnv(model)
	local a = app.attire or {}
	local lt, ulL = part(model, "LowerTorso"), part(model, "LeftUpperLeg")
	local low = a.trunkStyle == "Long" and -0.5 or -0.2 -- trunk leg opening, in leg heights from the centre
	local topRel = q(trunkTop(model, lt, ulL, low), 0.02)
	-- the trunks only care about the thigh envelope, rounded UP (always covers) in coarse steps
	local function up(x)
		return math.ceil(x / 0.05 - 1e-6) * 0.05
	end
	local eUL = { x = up(env.UL.x), zf = up(env.UL.zf), zb = up(env.UL.zb) }
	local eLL = { x = up(env.LL.x), zf = up(env.LL.zf), zb = up(env.LL.zb) }
	local spT, spF, spB = sponsorOf(opts.sponsorTrunks)
	-- the Blender-modelled gear for the tiers the parts show (BuilderGear); nil = the part-built gear below
	local official = sp.outfit == "referee" or sp.outfit == "cornerman"
	local meshTrunks, meshShoes, meshTop, meshOutfit
	local whyTrunks, whyShoes, whyTop, whyOutfit
	if official then
		meshOutfit, whyOutfit = Gear.Resolve(model, "official", officialStyle(sp.outfit))
	else
		meshTrunks, whyTrunks = Gear.Resolve(model, "trunks", table.find(Looks.TrunkStyles, a.trunkStyle) and a.trunkStyle or "Classic")
		meshShoes, whyShoes = Gear.Resolve(model, "shoes", a.shoeStyle == "Low-Top" and "Low-Top" or "High-Top")
		if app.gender == 2 then
			meshTop, whyTop = Gear.Resolve(model, "top", "Top")
		end
	end
	-- (what each group is, readable on the folder in Studio: "mesh", or "blocks: <why the mesh gear was not built>")
	local function record(folder)
		local function state(pieces, why)
			return pieces and "mesh" or ("blocks: " .. tostring(why))
		end
		if official then
			folder:SetAttribute("Outfit", state(meshOutfit, whyOutfit))
		else
			folder:SetAttribute("Trunks", state(meshTrunks, whyTrunks))
			folder:SetAttribute("Shoes", state(meshShoes, whyShoes))
			if app.gender == 2 then
				folder:SetAttribute("Top", state(meshTop, whyTop))
			end
		end
	end
	local key = Kit.sig("A4", a, opts.waistText or "", spT or "", spF or "", spB or "", sp.outfit, sp.detail, gear.shoes, shoeCond(gear), gear.shoesCond >= 60, gear.shoesCond >= 40,
		eUL, a.trunkStyle == "Long" and eLL or false, topRel, opts.name or "", app.gender, sizesOf(model, ATTIRE_PARTS),
		Gear.Key(meshTrunks), Gear.Key(meshShoes), Gear.Key(meshTop), Gear.Key(meshOutfit), official and Kit.sig("OC", outfitColors(app, sp.outfit, opts)) or "")
	if Kit.cached(model, "Attire", key) then
		return
	end
	local folder = getFolder(model, "Attire")
	record(folder)
	if official then
		if meshOutfit then
			outfitMesh(folder, model, app, opts, sp, meshOutfit)
		else
			outfitBuild(folder, model, app, opts, sp)
		end
		Kit.seal(model, "Attire", key)
		return
	end
	local trunks = Looks.Color(a.trunks, Color3.fromRGB(200, 25, 30))
	local trim = Looks.Color(a.trim, WHITE)
	if app.gender == 2 then
		local ut = part(model, "UpperTorso")
		if meshTop then
			-- the sports top in the top colour (trim) with an underband in the trunks colour
			Gear.Build(folder, meshTop, function(slot)
				return slot == "topTrim" and trunks or trim, SMOOTH, 0
			end)
		elseif ut then
			ut.Color = trim -- (no mesh top: the whole torso is the top, as colorBody paints it without one)
			ut.Material = SMOOTH
		end
	end
	if meshTrunks then
		-- satin trunks: the seat and legs in the trunks colour, the waistband, side stripe and hem in the trim
		local made = Gear.Build(folder, meshTrunks, function(slot)
			if slot == "trim" then
				return trim, SMOOTH, 0.02
			end
			return trunks, SMOOTH, 0.03
		end)
		-- (v10) satin soaks a little darker with sweat (Body.SetSweat)
		for _, p in pairs(made) do
			p:SetAttribute("Wet", "cloth")
			p:SetAttribute("BaseColor", p.Color)
			p:SetAttribute("BaseRefl", p.Reflectance)
		end
		local band = made.Waistband
		local text = opts.waistText or ""
		if text == "" and sp.cfg.wordmarks then
			text = "WCB" -- (v10) the game's mark on the elastic when the boxer has no lettering of their own
		end
		if band and lt and text ~= "" then
			local bs = band.Size
			textPatch(folder, lt, "WaistText", V3(bs.X * 0.42, bs.Y * 0.55, 0.02), band.CFrame * CF(0, 0, -bs.Z / 2 - 0.012), text:upper(), contrast(trim))
		end
		local leg = made.TrunkLeg_R or made.TrunkLegLong_R
		local ul = part(model, "RightUpperLeg")
		if spT and leg and ul and sp.lod >= 2 then
			-- the sponsor on the front of the right leg (the left leg carries the boxer's own colours)
			local ls = leg.Size
			textPatch(folder, ul, "SponsorPatch", V3(ls.X * 0.5, math.min(0.2, ls.Y * 0.2), 0.02), leg.CFrame * CF(0, ls.Y * 0.08, -ls.Z / 2 - 0.012), spT, spF, Enum.NormalId.Front, "GothamBlack", spB)
		end
	end
	if meshShoes then
		shoesMesh(folder, app, gear, meshShoes)
	end
	if meshTrunks then
		if not meshShoes then
			shoesBuild(folder, model, app, opts, gear, sp, env)
		end
		Kit.seal(model, "Attire", key)
		return
	end
	if lt then
		local s = lt.Size
		local bh, by = waistBand(lt)
		-- a tier mesh fills its box, narrowest at the waist: the band hugs it; the default block takes the old margin
		local tier = lt:GetAttribute("BodyTier") ~= nil
		local band = mk(folder, lt, "Waistband", V3(s.X * (tier and 1.02 or 1.1), bh, s.Z * (tier and 1.08 or 1.18)), lt.CFrame * CF(0, by, 0), trim, "Block", SMOOTH)
		local text = opts.waistText or ""
		if text ~= "" then
			textPatch(folder, lt, "WaistText", V3(s.X * 0.8, s.Y * 0.45, 0.02), band.CFrame * CF(0, 0, -band.Size.Z / 2 - 0.012), text:upper(), contrast(trim))
		end
	end
	local white = Color3.fromRGB(240, 240, 240)
	for _, side in ipairs({ "Left", "Right" }) do
		local ul = part(model, side .. "UpperLeg")
		local ll = part(model, side .. "LowerLeg")
		local sign = side == "Left" and -1 or 1
		if ul then
			-- loose trunks over the thigh, ending above the knee (long trunks reach the knee).
			-- The shell tops out just above the bottom of the (trunk coloured) lower torso, well under the
			-- waistband: it turns with the thigh, and a high front edge would swing up over the band when
			-- the boxer bends at the hips. It is sized around the quads / hamstrings so muscle never clips.
			local us = ul.Size
			local top = trunkTop(model, lt, ul, low)
			local h = top - low
			local cy = (top + low) / 2
			local wX = math.max(1.12, eUL.x + 0.07)
			local front = math.max(0.63 * us.Z, eUL.zf * us.Z / 2 + 0.035)
			local back = math.max(0.57 * us.Z, eUL.zb * us.Z / 2 + 0.035)
			local zc = (back - front) / 2
			local dZ = front + back
			mk(folder, ul, "TrunkShell", V3(us.X * wX, us.Y * h, dZ), ul.CFrame * CF(0, us.Y * cy, zc), trunks, "Block", SMOOTH)
			local px = sign * (us.X * wX / 2 + 0.02)
			local panelH = top - low - 0.12
			local panelY = low + 0.08 + panelH / 2
			if a.trunkStyle == "Striped" then
				mk(folder, ul, "TrunkStripe", V3(0.05, us.Y * panelH, dZ * 0.38), ul.CFrame * CF(px, us.Y * panelY, zc), trim, "Block", SMOOTH)
			elseif a.trunkStyle == "Pro" then
				-- pro trunks: trim hem at the leg opening and a trim side panel with white stripes
				mk(folder, ul, "Hem", V3(us.X * (wX + 0.02), us.Y * 0.1, dZ + 0.024), ul.CFrame * CF(0, us.Y * (low + 0.05), zc), trim, "Block", SMOOTH)
				mk(folder, ul, "SidePanel", V3(0.05, us.Y * panelH, dZ * 0.52), ul.CFrame * CF(px, us.Y * panelY, zc), trim, "Block", SMOOTH)
				if sp.lod >= 2 then
					-- one broad white stripe down the panel (three thin ones cost 4 parts for little at range)
					mk(folder, ul, "SideStripe", V3(0.062, us.Y * (panelH - 0.02), dZ * 0.2), ul.CFrame * CF(px + sign * 0.006, us.Y * panelY, zc), white, "Block", SMOOTH)
				end
			end
			-- sponsor patch on the front of the right leg (left leg carries the boxer's own colours)
			if spT and sign > 0 and sp.lod >= 2 then
				textPatch(folder, ul, "SponsorPatch", V3(us.X * 0.62, us.Y * 0.2, 0.02), ul.CFrame * CF(0, us.Y * (low + h * 0.42), zc - dZ / 2 - 0.012), spT, spF, Enum.NormalId.Front, "GothamBlack", spB)
			end
		end
		if ll and a.trunkStyle == "Long" then
			-- the knee-length cuff, sized around the calf heads (the envelope, rounded up) so they never clip
			local s = ll.Size
			local wx = math.max(1.06, eLL.x + 0.06)
			local fr = math.max(0.53 * s.Z, eLL.zf * s.Z / 2 + 0.03)
			local bk = math.max(0.53 * s.Z, eLL.zb * s.Z / 2 + 0.03)
			mk(folder, ll, "TrunkLeg", V3(s.X * wx, s.Y * 0.25, fr + bk), ll.CFrame * CF(0, s.Y * 0.38, (bk - fr) / 2), trunks, "Block", SMOOTH)
		end
	end
	if not meshShoes then
		shoesBuild(folder, model, app, opts, gear, sp, env)
	end
	Kit.seal(model, "Attire", key)
end

------------------------------------------------------------------------
-- Gloves / wraps
------------------------------------------------------------------------
local function wearColor(c, cond)
	local t = math.clamp((80 - (cond or 100)) / 80, 0, 1)
	local h, s, v = c:ToHSV()
	return Color3.fromHSV(h, s * (1 - 0.35 * t), v * (1 - 0.3 * t))
end

local function wet(p, kind, refl)
	p:SetAttribute("Wet", kind)
	p:SetAttribute("BaseColor", p.Color)
	p:SetAttribute("BaseRefl", refl or p.Reflectance)
end

local function wrapColors(app, gear)
	local a = app.attire or {}
	local wc = wearColor(Looks.Color(a.wraps, WHITE), gear.wrapsCond)
	if (gear.wrapsCond or 100) < 40 then
		wc = lerpColor(wc, Color3.fromRGB(150, 130, 100), 0.35) -- dirty wraps
	end
	local pattern = a.wrapPattern or "Solid"
	local c2, c3 = wc, wc
	if pattern == "TwoTone" then
		c2 = wearColor(Looks.Color(a.trim, WHITE), gear.wrapsCond)
		c3 = c2
	elseif pattern == "Flag" then
		-- tricolour bands: trunks / trim / the wrap colour
		c2 = wearColor(Looks.Color(a.trunks, Color3.fromRGB(200, 25, 30)), gear.wrapsCond)
		c3 = wearColor(Looks.Color(a.trim, WHITE), gear.wrapsCond)
	end
	return wc, c2, c3
end

local function wrapsBuild(folder, model, app, gear, opts, sp)
	local wrapDef = Catalog.Find(Catalog.Wraps, gear.wraps) or Catalog.Wraps[1]
	local brand = Catalog.GearBrand("wraps", wrapDef.id)
	local wc, c2, c3 = wrapColors(app, gear)
	local gel = wrapDef.style == "gel"
	local lod, cfg = sp.lod, sp.cfg
	for _, side in ipairs({ "Left", "Right" }) do
		local sign = side == "Left" and -1 or 1
		local hand, la = part(model, side .. "Hand"), part(model, side .. "LowerArm")
		if hand then
			local hs = hand.Size
			-- a tier hand's box holds the fingers too: the wrap covers the palm and the knuckles above them (the
			-- default block hand is all palm: the wrap reaches past it)
			local tierHand = hand:GetAttribute("BodyTier") ~= nil
			local wy, wk, ky = 1.4, 0, -0.62
			if tierHand then
				wy, wk, ky = 0.62, 0.12, -0.2
			end
			wet(mk(folder, hand, "Wrap", hs * V3(1.08, wy, 1.08), hand.CFrame * CF(0, hs.Y * wk, 0), wc, "Block", FABRIC), "wrap")
			if lod >= 2 then
				-- knuckle padding: a thin cotton ridge, or a moulded gel pad on gel wraps
				local kp = gel and V3(hs.X * 0.95, 0.26, hs.Z * 1.06) or V3(hs.X * 0.9, 0.18, hs.Z * 1.02)
				local kc = gel and darken(wc, 0.72) or wc
				wet(mk(folder, hand, "WrapKnuckle", kp, hand.CFrame * CF(sign * 0.05, hs.Y * ky, 0), kc, "Ellipsoid", gel and SMOOTH or FABRIC), "wrap")
			end
			if lod >= 3 then
				-- the X across the back of the hand
				for _, rot in ipairs({ 1, -1 }) do
					wet(mk(folder, hand, "WrapX", V3(0.03, 0.07, hs.Z * 1.12), hand.CFrame * CF(sign * (hs.X * 0.54 + 0.012), 0, 0) * ANG(rot * RAD(21), 0, 0), c2, "Block", FABRIC), "wrap")
				end
			end
		end
		if la then
			local s = la.Size
			local ww, wd = fitOf(la, "wrist")
			local wristSize = ww and V3(ww * 1.12, s.Y * 0.3, wd * 1.12) or V3(s.X * 1.06, s.Y * 0.3, s.Z * 1.06)
			wet(mk(folder, la, "WrapWrist", wristSize, jointCF(la, side .. "WristRigAttachment", CF(0, -s.Y * 0.5, 0)) * CF(0, s.Y * 0.14, 0), wc, "Block", FABRIC), "wrap")
			if lod >= 3 then
				-- stepped top layer and the velcro closure tab with the brand label
				wet(mk(folder, la, "WrapLayer", V3(s.X * 1.09, s.Y * 0.1, s.Z * 1.09), la.CFrame * CF(0, -s.Y * 0.25, 0), c3, "Block", FABRIC), "wrap")
				local tab = mk(folder, la, "WrapTab", V3(0.035, s.Y * 0.16, s.Z * 0.42), la.CFrame * CF(sign * (s.X * 0.545 + 0.018), -s.Y * 0.34, 0), darken(c2, 0.8), "Block", FABRIC)
				wet(tab, "wrap")
				if cfg.wordmarks and (brand.glyph or "") ~= "" then
					textPatch(folder, la, "WrapLabel", V3(0.02, s.Y * 0.12, s.Z * 0.36), tab.CFrame * CF(sign * 0.03, 0, 0), brand.glyph, contrast(tab.Color), sign > 0 and Enum.NormalId.Right or Enum.NormalId.Left, brand.font)
				end
				if wrapDef.frayed then
					-- old wraps: a loose frayed end swinging from the wrist
					local start = la.CFrame * CF(sign * s.X * 0.5, -s.Y * 0.48, s.Z * 0.2)
					tail(folder, la, start, la.CFrame:VectorToWorldSpace(V3(sign * 0.3, -1, 0.2)).Unit, 2, 0.14, 0.07, lerpColor(wc, Color3.fromRGB(180, 165, 135), 0.3), FABRIC, 0.15, 0.4, "WrapFray")
				end
			end
		end
	end
end

local function glovesBuild(folder, model, app, gear, opts, sp)
	local g = app.gloves or {}
	local gloveDef = Catalog.Find(Catalog.Gloves, gear.gloves) or Catalog.Gloves[1]
	local brand = Catalog.GearBrand("gloves", gloveDef.id, g.brand)
	local custom = gloveDef.custom or {}
	local cond = gear.glovesCond or 100
	local lod, cfg = sp.lod, sp.cfg
	local pal = brand.palette or {}
	local main = wearColor(Looks.Color(g.color, rgb(pal.primary, Color3.fromRGB(200, 25, 30))), cond)
	-- a white band round the cuff (customisable on gloves that allow trim colours)
	local trim = custom.trim and Looks.Color(g.trim, WHITE) or wearColor(Color3.fromRGB(236, 234, 228), cond)
	local finish = custom.finish and (g.finish or brand.finish or "Leather") or (brand.finish or "Leather")
	if finish == "Metallic" and not (custom.metallic or brand.finish == "Metallic") then
		finish = "Patent"
	end
	-- leather has a soft sheen, matte none, patent a wet shine, metallic foil
	local material, refl = LEATHER, 0.04
	if finish == "Matte" then
		material, refl = LEATHER, 0
	elseif finish == "Patent" then
		material, refl = SMOOTH, 0.22
	elseif finish == "Metallic" then
		material, refl = Enum.Material.Foil, 0.35
	end
	if gloveDef.id == "WorldChampion" then
		trim = GOLD
	end
	-- seam piping and stitching: brand signature, overridable on gloves that allow custom stitching
	local piping = nil
	if brand.piping == "trim" then
		piping = trim
	elseif type(brand.piping) == "table" then
		piping = rgb(brand.piping)
	end
	local stitch = brand.stitch or "Single"
	if custom.stitching and g.stitching and g.stitching ~= "Classic" then
		stitch = g.stitching
	end
	local lum = 0.299 * main.R + 0.587 * main.G + 0.114 * main.B
	local stitchColor = lum < 0.15 and lerpColor(main, WHITE, 0.35) or darken(main, 0.55)
	if stitch == "Contrast" then
		stitchColor = trim
	elseif stitch == "Gold" then
		stitchColor = GOLD
	end
	local palmColor = darken(main, brand.palm or 0.9)
	local strapColor = custom.trim and trim or rgb(pal.secondary, trim)
	-- size: ounces (16oz bag gloves are big, 8oz fight gloves compact) and the brand's proportions
	local oz = gloveDef.oz or 16
	if opts.fightNight then
		oz = math.min(oz, 10)
	end
	local ozK = 0.86 + 0.014 * oz
	local shape = brand.shape or {}
	local wK, lK, kK, cK = shape.width or 1, shape.len or 1, shape.knuckle or 1, shape.cuff or 1
	local wrapC = wrapColors(app, gear)
	local tape = opts.fightNight == true
	-- worn leather: the striking face scuffs pale first
	local faceColor = main
	if cond < 70 then
		faceColor = lerpColor(main, Color3.fromRGB(205, 195, 180), 0.3 * (70 - cond) / 70)
	end
	if brand.targetArea then
		faceColor = Color3.fromRGB(245, 245, 245) -- amateur competition glove: white striking face
	end
	if cond < 30 then
		palmColor = darken(palmColor, 0.82) -- sweat soaked into the palm
	end
	for _, side in ipairs({ "Left", "Right" }) do
		local sign = side == "Left" and -1 or 1
		local hand, la = part(model, side .. "Hand"), part(model, side .. "LowerArm")
		-- the forearm's round cross-section: the hull cylinder (medium / full), else the R15 block's diagonal
		local dF = 0.8
		if la then
			local s = la.Size
			dF = lod >= 2 and 0.96 * math.max(s.X, s.Z) or math.sqrt(s.X * s.X + s.Z * s.Z)
			-- a tier forearm: its measured girth (the box holds the forearm's widest bulge)
			local fw, fd = fitOf(la, "forearm")
			if fw then
				dF = 1.04 * math.max(fw, fd)
			end
		end
		local dc = dF * (lod >= 2 and 1.1 or 1.02) -- the cuff: padding round the forearm
		if hand then
			-- glove frame: origin at the wrist, x = back of the hand (+) / palm (-), y = down the hand toward
			-- the knuckles, z = thumb side; a padded fist ~1.3 x the forearm wide, as deep as 0.92 x its
			-- width, ~1.15 x its width from the wrist to the striking face (a glove, not a ball or a mitten)
			local hs = hand.Size
			local base = jointCF(hand, side .. "WristRigAttachment", CF(0, hs.Y / 2, 0))
			local function at(x, y, z)
				return base * CF(sign * x, -y, -z)
			end
			local Wd = dF * 1.3 * ozK * wK * (sp.female and 0.93 or 1)
			local Dd = Wd * 0.92
			local Ln = Wd * 1.15 * lK
			local a0 = -0.12 * Wd
			local function glovePart(name, size, cf, color, shapeK)
				local p = mk(folder, hand, name, size, cf, color, shapeK or "Ellipsoid", material)
				p.Reflectance = refl
				wet(p, "glove", refl)
				return p
			end
			-- the fist: the main padding from the wrist to the front
			local mainY = (Ln - a0) * 0.94
			local mainC = (a0 + Ln) / 2 + 0.02 * Wd
			local mainX = -0.03 * Dd
			local glove = glovePart(side == "Left" and "GloveL" or "GloveR", V3(Dd, mainY, Wd * 0.96), at(mainX, mainC, 0), main)
			-- the wrist: rounds the hand compartment over the cuff's end
			glovePart("GloveWrist", V3(dc * 1.04, 0.42 * Wd, dc * 1.04), at(0, 0.07 * Wd, 0), main)
			-- the striking face over the knuckles: the broadest part, a little toward the back of the hand
			glovePart("KnucklePad", V3(Dd * 0.8 * kK, Ln * 0.52, Wd * 1.0 * kK), at(0.07 * Dd, Ln * 0.7, 0), faceColor)
			if lod >= 2 then
				-- the back panel: broad, flat-ish padding from the cuff to the knuckles
				glovePart("BackPad", V3(Dd * 0.56, Ln * 0.84, Wd * 0.92), at(0.2 * Dd, Ln * 0.42, 0), main)
				-- the curled fingers rolling under the knuckles, then the palm in the palm tone
				glovePart("FingerRoll", V3(Dd * 0.56, Ln * 0.42, Wd * 0.88), at(-0.27 * Dd, Ln * 0.66, 0), main)
				glovePart("Palm", V3(Dd * 0.5, Ln * 0.56, Wd * 0.78), at(-0.24 * Dd, Ln * 0.3, -0.03 * Wd), palmColor)
			end
			-- the thumb: a padded roll along the thumb side, palm half, its tip sewn to the finger roll
			local thumbC = lerpColor(main, palmColor, 0.35)
			glovePart("Thumb", V3(Wd * 0.33, Ln * 0.62, Wd * 0.33), at(-0.2 * Dd, Ln * 0.38, 0.43 * Wd) * ANG(RAD(10) * sign, 0, 0) * ANG(0, 0, RAD(-8) * sign), thumbC)
			if lod >= 2 then
				glovePart("ThumbTip", V3(Wd * 0.26, Ln * 0.26, Wd * 0.26), at(-0.3 * Dd, Ln * 0.66, 0.33 * Wd), thumbC)
			end
			if lod >= 3 then
				-- piping / stitching: thin discs in the main padding's middle plane, sized to its section there:
				-- only their rims show, as welt and stitch lines lying on the outline (nothing sticks out)
				local function ring(name, dx, grow, color)
					local k = math.sqrt(math.max(0, 1 - (dx / (Dd / 2)) ^ 2))
					local p = mk(folder, hand, name, V3(0.02, mainY * k * grow, Wd * 0.96 * k * grow), at(mainX + dx, mainC, 0), color, "Ellipsoid", SMOOTH)
					p:SetAttribute("Seam", true)
					return p
				end
				if piping then
					ring("Piping", 0, 1.012, piping)
				end
				if stitch ~= "Hidden" then
					ring("StitchRing", 0.05 * Dd, 1.006, stitchColor)
					if stitch == "Double" then
						ring("StitchRing", -0.05 * Dd, 1.006, stitchColor)
					end
				end
			end
			-- logo on the back panel: the player's glyph, else the brand monogram (a small plate on the flat
			-- middle of the back, so it lies on the leather)
			local glyph
			if custom.logo and g.logo and g.logo ~= "None" then
				glyph = Kit.IconText(Catalog.LogoIcons[g.logo]) or Catalog.LogoGlyphs[g.logo]
				if g.logo == "Initials" then
					glyph = initials(opts.name)
				elseif g.logo == "Flag" then
					glyph = tostring(opts.nat or "USA"):sub(1, 3):upper()
				end
			elseif cfg.wordmarks and (brand.glyph or "") ~= "" then
				glyph = brand.glyph
			end
			if glyph and glyph ~= "" and lod >= 2 then
				textPatch(folder, hand, "Logo", V3(0.02, Ln * 0.26, Wd * 0.3), at(0.48 * Dd + 0.012, Ln * 0.42, 0), glyph, trim,
					sign > 0 and Enum.NormalId.Right or Enum.NormalId.Left, brand.font)
			end
			-- wear: torn foam on the striking face, gym duct tape round the knuckles, a sweat mark on the palm
			if cond < 35 and lod >= 2 then
				mk(folder, hand, "FoamTear", V3(Dd * 0.1, Ln * 0.1, Wd * 0.16), at(0.3 * Dd, Ln * 0.94, 0.1 * Wd), Color3.fromRGB(215, 195, 140), "Ellipsoid", Enum.Material.Sand)
			end
			if cond < 40 and (gloveDef.id == "Worn" or gloveDef.id == "Cheap") then
				mk(folder, hand, "DuctTape", V3(Dd * 0.8 * kK * 1.02, 0.12, Wd * kK * 1.02), at(0.07 * Dd, Ln * 0.7, 0), Color3.fromRGB(150, 150, 155), "Ellipsoid", FABRIC)
			end
			if cond < 30 and lod >= 2 then
				local sm = mk(folder, hand, "SweatMark", V3(Dd * 0.505, Ln * 0.565, Wd * 0.785), at(-0.24 * Dd, Ln * 0.3, -0.03 * Wd), darken(palmColor, 0.7), "Ellipsoid", material, 0.4)
				sm:SetAttribute("BaseTransparency", 0.4)
			end
			if gloveDef.aura then
				local sp2 = Instance.new("Sparkles")
				sp2.SparkleColor = Color3.fromRGB(255, 210, 60)
				sp2.Parent = glove
			end
		end
		if la then
			local s = la.Size
			local cuffLen = s.Y * 0.48 * cK
			local r = dc / 2
			-- cylinders along the forearm (a Part cylinder's axis is its X: turned up onto the arm)
			local wristCF = jointCF(la, side .. "WristRigAttachment", CF(0, -s.Y * 0.5, 0))
			local function band(y, len, grow)
				return V3(len, dc * grow, dc * grow), wristCF * CF(0, y, 0) * ANG(0, 0, RAD(90))
			end
			local function onSurface(y, ang, out)
				-- a point on the cuff's surface at height y, angle ang (0 = outer side, pi/2 = front), facing out
				return wristCF * CF(0, y, 0) * CFrame.Angles(0, -ang, 0) * CF(sign * (r + out), 0, 0)
			end
			local sz, cf = band(cuffLen / 2, cuffLen, 1)
			local cuff = mk(folder, la, "Cuff", sz, cf, main, "Cylinder", material)
			cuff.Reflectance = refl
			wet(cuff, "glove", refl)
			-- the rolled trim band at the top
			sz, cf = band(cuffLen - s.Y * 0.05, s.Y * 0.1, 1.05)
			wet(mk(folder, la, "CuffTrim", sz, cf, trim, "Cylinder", material), "glove", refl)
			-- hand wraps peeking out above the cuff
			if lod >= 3 then
				sz, cf = band(cuffLen + 0.03, 0.08, 0.97)
				mk(folder, la, "WrapPeek", sz, cf, wrapC, "Cylinder", FABRIC)
			end
			local sideFace = sign > 0 and Enum.NormalId.Right or Enum.NormalId.Left
			if tape then
				-- fight night: laces / strap taped over and signed by the commission inspector
				sz, cf = band(cuffLen * 0.42, cuffLen * 0.5, 1.07)
				mk(folder, la, "Tape", sz, cf, Color3.fromRGB(246, 246, 242), "Cylinder", FABRIC)
				if cfg.wordmarks then
					local h = 0
					for c in tostring(opts.name or "x"):gmatch(".") do
						h += string.byte(c)
					end
					local inspectors = { "R.M.", "J.T.", "D.K.", "L.V.", "A.O." }
					textPatch(folder, la, "Signature", V3(0.02, cuffLen * 0.3, dc * 0.4), onSurface(cuffLen * 0.42, 0, dc * 0.035 + 0.012),
						inspectors[h % #inspectors + 1] .. " ok", Color3.fromRGB(30, 40, 120), sideFace, "PermanentMarker")
				end
			elseif brand.closure == "lace" then
				-- lace-up: a lace panel on the palm side with criss-crossed laces, lying on the cuff
				if lod >= 2 then
					mk(folder, la, "LacePanel", V3(0.02, cuffLen * 0.8, dc * 0.24), onSurface(cuffLen * 0.48, math.pi, 0.004), darken(main, 0.8), "Block", material)
				end
				if cfg.laces == "full" then
					for k = 0, 2 do
						for _, rot in ipairs({ 1, -1 }) do
							mk(folder, la, "GloveLace", V3(0.02, dc * 0.24, 0.03), onSurface(cuffLen * (0.22 + 0.24 * k), math.pi, 0.014) * ANG(rot * RAD(55), 0, 0), Color3.fromRGB(240, 240, 235), "Block", SMOOTH)
						end
					end
				end
			elseif lod >= 2 then
				-- velcro: a wide hook-and-loop strap round the cuff with a pull tab lying on it
				sz, cf = band(cuffLen * 0.42, cuffLen * 0.42, 1.05)
				mk(folder, la, "Strap", sz, cf, strapColor, "Cylinder", SMOOTH)
				if lod >= 3 then
					mk(folder, la, "StrapTab", V3(0.02, cuffLen * 0.3, dc * 0.18), onSurface(cuffLen * 0.42, math.pi * 0.7, dc * 0.025 + 0.008), darken(strapColor, 0.7), "Block", SMOOTH)
				end
			end
			-- cuff branding: embroidery (outer side), maker's plate (front), wordmark: small plates tangent to the
			-- round cuff (narrow enough to lie on it)
			local outerTaken = tape
			if custom.embroidery then
				local text = side == "Left" and (g.embName and opts.name or "") or (g.embNick and opts.nick or "")
				if text ~= "" and not tape then
					textPatch(folder, la, "Embroidery", V3(0.02, s.Y * 0.2, dc * 0.38), onSurface(cuffLen * 0.72, 0, 0.012), text:upper(), trim, sideFace)
					outerTaken = true
				end
			end
			local frontFace = Enum.NormalId.Front
			if brand.plate and lod >= 2 then
				local big = brand.beltPlate == true
				local plateCF = wristCF * CF(0, cuffLen * 0.55, -r - 0.02)
				mk(folder, la, big and "BeltPlate" or "Plate", V3(dc * (big and 0.4 or 0.3), cuffLen * (big and 0.4 or 0.28), 0.04), plateCF, big and GOLD or Color3.fromRGB(200, 200, 205), "Block", Enum.Material.Foil)
				if cfg.wordmarks then
					textPatch(folder, la, "PlateText", V3(dc * 0.28, cuffLen * 0.22, 0.02), plateCF * CF(0, 0, -0.032), big and (brand.glyph or "") or initials(opts.name), big and Color3.fromRGB(60, 40, 10) or Color3.fromRGB(30, 30, 34), frontFace, brand.font)
				end
			elseif cfg.wordmarks and (brand.wordmark or "") ~= "" and outerTaken then
				textPatch(folder, la, "Wordmark", V3(dc * 0.36, cuffLen * 0.22, 0.02), wristCF * CF(0, cuffLen * 0.72, -r - 0.012), brand.wordmark, rgb(brand.wordColor, contrast(main)), frontFace, brand.font)
			end
			if cfg.wordmarks and (brand.wordmark or "") ~= "" and not outerTaken then
				textPatch(folder, la, "Wordmark", V3(0.02, cuffLen * 0.22, dc * 0.36), onSurface(cuffLen * 0.72, 0, 0.012), brand.wordmark, rgb(brand.wordColor, contrast(main)), sideFace, brand.font)
			end
		end
	end
end

-- the glove's colours and finish (glovesBuild's derivation, shared by the mesh gloves)
local function gloveStyle(app, gear, opts)
	local g = app.gloves or {}
	local gloveDef = Catalog.Find(Catalog.Gloves, gear.gloves) or Catalog.Gloves[1]
	local brand = Catalog.GearBrand("gloves", gloveDef.id, g.brand)
	local custom = gloveDef.custom or {}
	local cond = gear.glovesCond or 100
	local pal = brand.palette or {}
	local main = wearColor(Looks.Color(g.color, rgb(pal.primary, Color3.fromRGB(200, 25, 30))), cond)
	local trim = custom.trim and Looks.Color(g.trim, WHITE) or wearColor(Color3.fromRGB(236, 234, 228), cond)
	local finish = custom.finish and (g.finish or brand.finish or "Leather") or (brand.finish or "Leather")
	if finish == "Metallic" and not (custom.metallic or brand.finish == "Metallic") then
		finish = "Patent"
	end
	local material, refl = LEATHER, 0.04
	if finish == "Matte" then
		material, refl = LEATHER, 0
	elseif finish == "Patent" then
		material, refl = SMOOTH, 0.22
	elseif finish == "Metallic" then
		material, refl = Enum.Material.Foil, 0.35
	end
	if gloveDef.id == "WorldChampion" then
		trim = GOLD
	end
	local strap = custom.trim and trim or rgb(pal.secondary, trim)
	if brand.closure == "lace" then
		strap = trim -- (lace-ups: the rolled trim band)
	end
	if opts and opts.fightNight then
		strap = Color3.fromRGB(246, 246, 242) -- fight night: the cuffs taped over
	end
	return { def = gloveDef, brand = brand, custom = custom, main = main, trim = trim, strap = strap, material = material, refl = refl }
end

-- the mesh gloves (BuilderGear): the glove (named GloveL / GloveR: the fight animation's contact spheres read them)
-- and its cuff in the glove colour and finish, the strap in the strap / trim colour; the logo on the back of the hand
local function glovesMesh(folder, model, app, gear, opts, sp, pieces)
	local st = gloveStyle(app, gear, opts)
	local made = Gear.Build(folder, pieces, function(slot)
		if slot == "gloveTrim" then
			return st.strap, st.material == Enum.Material.Foil and SMOOTH or st.material, math.min(st.refl, 0.1)
		end
		return st.main, st.material, st.refl
	end, { Glove_L = "GloveL", Glove_R = "GloveR" })
	for name, p in pairs(made) do
		wet(p, "glove", p.Reflectance)
		if st.def.aura and (name == "Glove_L" or name == "Glove_R") then
			local sp2 = Instance.new("Sparkles")
			sp2.SparkleColor = Color3.fromRGB(255, 210, 60)
			sp2.Parent = p
		end
	end
	local g = app.gloves or {}
	local glyph
	if st.custom.logo and g.logo and g.logo ~= "None" then
		glyph = Kit.IconText(Catalog.LogoIcons[g.logo]) or Catalog.LogoGlyphs[g.logo]
		if g.logo == "Initials" then
			glyph = initials(opts.name)
		elseif g.logo == "Flag" then
			glyph = tostring(opts.nat or "USA"):sub(1, 3):upper()
		end
	elseif sp.cfg.wordmarks and (st.brand.glyph or "") ~= "" then
		glyph = st.brand.glyph
	elseif sp.cfg.wordmarks then
		glyph = "WCB" -- (v10) the mesh glove's raised logo panel carries the game's mark when no brand has one
	end
	if glyph and glyph ~= "" and sp.lod >= 2 then
		for _, side in ipairs({ "Left", "Right" }) do
			local gl = made["Glove_" .. side:sub(1, 1)]
			local hand = part(model, side .. "Hand")
			if gl and hand then
				local sign = side == "Left" and -1 or 1
				local gs = gl.Size
				textPatch(folder, hand, "Logo", V3(0.02, gs.Y * 0.22, gs.Z * 0.3), gl.CFrame * CF(sign * (gs.X * 0.5 + 0.004), -gs.Y * 0.08, 0), glyph, st.trim,
					sign > 0 and Enum.NormalId.Right or Enum.NormalId.Left, st.brand.font)
			end
		end
	end
	return made
end

-- the mesh wraps (BuilderGear): the hand in the wrap colour, the wrist turns in the pattern's second colour
local function wrapsMesh(folder, app, gear, pieces)
	local wc, c2 = wrapColors(app, gear)
	local made = Gear.Build(folder, pieces, function(slot)
		return slot == "wraps2" and c2 or wc, FABRIC, 0
	end)
	for _, p in pairs(made) do
		wet(p, "wrap")
	end
	return made
end

local HAND_PARTS = { "LeftHand", "LeftLowerArm", "RightHand", "RightLowerArm" }

local function handsBuild(model, app, gear, opts, sp)
	opts = opts or {}
	gear = gearOf(gear)
	sp = sp or resolve(app, nil, opts)
	local mode = opts.hands or "gloves"
	if sp.outfit == "referee" or sp.outfit == "cornerman" then
		mode = "bare" -- officials work bare-handed
	end
	local a = app.attire or {}
	-- the Blender-modelled gloves / wraps for the tiers the hands and forearms show (nil: the part-built ones)
	local mesh
	if mode == "wraps" then
		mesh = Gear.Resolve(model, "wraps", "Wraps")
	elseif mode ~= "bare" then
		mesh = Gear.Resolve(model, "gloves", "Gloves")
	end
	local key = Kit.sig("H5", mode, sp.female, sp.detail, gear.gloves, gear.wraps, q(gear.glovesCond or 100, 5), q(gear.wrapsCond or 100, 10), app.gloves, a.wraps, a.wrapPattern or "", a.trim, a.trunks,
		opts.name or "", opts.nick or "", opts.nat or "", opts.fightNight == true, sizesOf(model, HAND_PARTS), Gear.Key(mesh))
	if Kit.cached(model, "Hands", key) then
		return
	end
	local folder = getFolder(model, "Hands")
	-- the blocky R15 hand sits inside the glove: hidden so its corners never poke through the padding (it
	-- still carries the wrist joint and the welds); bare hands and wraps show it
	for _, n in ipairs({ "LeftHand", "RightHand" }) do
		local h = part(model, n)
		local t = (mode ~= "wraps" and mode ~= "bare") and 1 or 0
		if h and h:IsA("BasePart") and h.Transparency ~= t then
			h.Transparency = t
		end
	end
	if mode == "wraps" then
		if mesh then
			wrapsMesh(folder, app, gear, mesh)
		else
			wrapsBuild(folder, model, app, gear, opts, sp)
		end
	elseif mode ~= "bare" then
		if mesh then
			glovesMesh(folder, model, app, gear, opts, sp, mesh)
		else
			glovesBuild(folder, model, app, gear, opts, sp)
		end
	end
	Kit.seal(model, "Hands", key)
end

------------------------------------------------------------------------
-- Robe (toggled during walkouts)
------------------------------------------------------------------------
local function hairHidden(model, on)
	-- BuilderHead is required lazily (and directly, never through Builder) so there is no require cycle
	local ok, err = pcall(function()
		local Head = require(script.Parent:WaitForChild("BuilderHead"))
		if Head.SetHairHidden then
			Head.SetHairHidden(model, "hood", on)
		end
	end)
	if not ok then
		warn("[Boxer] SetHairHidden failed:", err)
	end
end

function Body.SetRobe(model, app, on, opts)
	local folder = getFolder(model, "Robe")
	-- BuilderHead keeps the hood state on the model (HairHiddenHood) so hair rebuilds stay hidden
	local hadHood = model:GetAttribute("HairHiddenHood") == true
	if not on then
		if hadHood then
			hairHidden(model, false)
		end
		return
	end
	local a = app.attire or {}
	local robeId = opts and opts.robe or "Classic"
	if robeId == "None" then
		if hadHood then
			hairHidden(model, false)
		end
		return
	end
	local color = Looks.Color(a.robe, Color3.fromRGB(200, 25, 30))
	local trim = robeId == "Champion" and GOLD or Looks.Color(a.robeTrim, WHITE)
	-- satin robes (a soft sheen); the hooded robe is heavier terry cloth
	local mat = robeId == "Hooded" and FABRIC or SMOOTH
	local refl = robeId == "Hooded" and 0 or 0.04
	local ut, lt = part(model, "UpperTorso"), part(model, "LowerTorso")
	-- Sized to the body it drapes: the tier MeshParts' Size IS the mesh's bounding box (BodyAssetData tiers[n].parts,
	-- scaled by the rig's height / width / depth), so a shell a few hundredths of a stud outside each part's box
	-- clears every muscle of every tier, height and frame without standing off it (the old shells were sized for
	-- the retired muscle hull: 16-25% over the box, and read a size too big on the tier bodies). Satin hangs
	-- closer than the terry-cloth hooded robe.
	local slack = robeId == "Hooded" and 1.4 or 1
	local MT, MA = 0.045 * slack, 0.03 * slack -- studs per side: torso / skirt, sleeves
	-- the rest offset of a limb in its parent's space (the joint's C0 * C1^-1: never the animated pose)
	local function restIn(child, jointName)
		local m = child and child:FindFirstChild(jointName)
		if m and m:IsA("Motor6D") then
			return m.C0 * m.C1:Inverse()
		end
		return nil
	end
	-- what the robe goes OVER besides the skin: the attire (trunks, waistband, the women's top) welded to these body
	-- parts (anchors: body part -> its rest frame in the space of the part the shell hangs on), as the x / z extents
	-- of their boxes between yMin and yMax in that space, grown from x0, x1, z0, z1
	local look = model:FindFirstChild("BoxerLook")
	local attire = look and look:FindFirstChild("Attire")
	local function bounds(anchors, x0, x1, z0, z1, yMin, yMax)
		if not attire then
			return x0, x1, z0, z1
		end
		for _, q in ipairs(attire:GetDescendants()) do
			if q:IsA("BasePart") and q.Transparency < 1 then
				local j = q:FindFirstChildOfClass("Weld") or q:FindFirstChildOfClass("WeldConstraint")
				local a = j and j.Part0
				local rest = a and anchors[a]
				if rest then
					local off
					if j:IsA("WeldConstraint") then
						off = a.CFrame:Inverse() * q.CFrame
					else
						off = j.C0 * j.C1:Inverse()
					end
					local cf = rest * off
					local h = q.Size / 2
					for _, c in ipairs({ V3(h.X, h.Y, h.Z), V3(-h.X, h.Y, h.Z), V3(h.X, -h.Y, h.Z), V3(h.X, h.Y, -h.Z),
						V3(-h.X, -h.Y, h.Z), V3(-h.X, h.Y, -h.Z), V3(h.X, -h.Y, -h.Z), V3(-h.X, -h.Y, -h.Z) }) do
						local p = cf * c
						if p.Y >= yMin and p.Y <= yMax then
							x0, x1 = math.min(x0, p.X), math.max(x1, p.X)
							z0, z1 = math.min(z0, p.Z), math.max(z1, p.Z)
						end
					end
				end
			end
		end
		return x0, x1, z0, z1
	end
	if ut then
		local s = ut.Size
		local x0, x1, z0, z1 = bounds({ [ut] = CF() }, -s.X / 2, s.X / 2, -s.Z / 2, s.Z / 2, -s.Y / 2, s.Y / 2)
		-- the shell from under the torso up to the neck's base (the head's base on the Neck pivot): a tier torso's box
		-- runs on up its neck stub into the head, and a shell to the box top boxed in the jaw
		local top, bottom = neckHeight(ut) - 0.01, -s.Y / 2 - 0.005
		local ty = (top + bottom) / 2
		local rs = V3(x1 - x0 + 2 * MT, top - bottom, z1 - z0 + 2 * MT)
		local shell = mk(folder, ut, "RobeTorso", rs, ut.CFrame * CF((x0 + x1) / 2, ty, (z0 + z1) / 2), color, "Block", mat)
		shell.Reflectance = refl
		local front = rs.Z * 0.5 - (z0 + z1) / 2
		for _, side in ipairs({ -1, 1 }) do
			mk(folder, ut, "Lapel", V3(0.22 * math.min(1, s.X / 1.6), rs.Y - 0.05, 0.04), ut.CFrame * CF(side * 0.14 * s.X / 1.6, ty - 0.025, -front - 0.02) * ANG(0, 0, RAD(-12 * side)), trim, "Block", mat)
		end
		local nick = opts and opts.nick or ""
		if nick == "" then
			nick = opts and opts.name or "" -- (v10: the back carries the boxer's name when there is no nickname)
		end
		if nick ~= "" then
			textPatch(folder, ut, "RobeName", V3(s.X * 0.9, s.Y * 0.22, 0.02), shell.CFrame * CF(0, s.Y * 0.18, front + 0.012), nick:upper(), trim, Enum.NormalId.Back)
		end
		local spT, spF, spB = sponsorOf(opts and opts.sponsorRobe)
		if spT then
			textPatch(folder, ut, "SponsorPatch", V3(s.X * 0.62, s.Y * 0.1, 0.02), shell.CFrame * CF(0, -s.Y * 0.08, front + 0.012), spT, spF, Enum.NormalId.Back, "GothamBlack", spB)
		end
		if robeId == "Hooded" or robeId == "Champion" then
			-- the hood is UP for the walkout (BuilderHead hides the hair under it): a shell over the crown,
			-- sides and back, welded to the head so it turns with it. Its front edge sits at about -0.41 of
			-- the head depth: in front of A's hidden-hair line (-0.36), behind the face (-0.5), so the face
			-- stays open. The drape is the fabric falling from the hood onto the shoulders and upper back.
			-- (its top at the neck's base, behind it: never up the back of the neck when the hood is down)
			mk(folder, ut, "HoodDrape", V3(s.X * 0.62, s.Y * 0.3, s.Z * 0.75), ut.CFrame * CF(0, top - s.Y * 0.15, s.Z * 0.32), color, "Ellipsoid", mat)
			-- (over a boxer's headgear, Builder HeadgearColor: the hood stays DOWN, only the drape. No ellipsoid hood can
			-- close over the headgear's shell without reaching in front of the face)
			local head = model:GetAttribute("HeadgearColor") == nil and part(model, "Head")
			if head then
				local hs = head.Size
				-- keep the name "Hood": Builder.Cosmetics checks for it before restoring hidden hair
				mk(folder, head, "Hood", V3(hs.X * 1.2, hs.Y * 1.14, hs.Z * 1.1), head.CFrame * CF(0, hs.Y * 0.08, hs.Z * 0.14), color, "Ellipsoid", mat)
				-- (v10) the trim round the face opening: the hood's shell a hair larger and 0.03 forward in the trim
				-- colour, so only its front sliver shows (still behind the face at -0.5)
				mk(folder, head, "HoodTrim", V3(hs.X * 1.215, hs.Y * 1.155, hs.Z * 1.1), head.CFrame * CF(0, hs.Y * 0.08, hs.Z * 0.14 - 0.03), trim, "Ellipsoid", mat)
			end
		end
	end
	if lt then
		-- skirt and belt: round the hips AND both thighs at rest (the hips' box alone is narrower than the legs'
		-- spread on the wider frames), from the waist to just above the knees
		local s = lt.Size
		local x0, x1, z0, z1 = -s.X / 2, s.X / 2, -s.Z / 2, s.Z / 2
		local bottom = -s.Y / 2 - 0.9
		local anchors = { [lt] = CF() }
		for _, side in ipairs({ "Left", "Right" }) do
			local ul = part(model, side .. "UpperLeg")
			local off = restIn(ul, side .. "Hip")
			if ul and off then
				local p, us = off.Position, ul.Size
				x0, x1 = math.min(x0, p.X - us.X / 2), math.max(x1, p.X + us.X / 2)
				z0, z1 = math.min(z0, p.Z - us.Z / 2), math.max(z1, p.Z + us.Z / 2)
				bottom = p.Y - us.Y * 0.28
				anchors[ul] = off
			end
		end
		local waist = restIn(ut, "Waist")
		local top = waist and waist.Position.Y or s.Y * 0.45
		-- the trunks under it (their seat and legs stand off the body's boxes), down to the skirt's hem
		x0, x1, z0, z1 = bounds(anchors, x0, x1, z0, z1, bottom, top + 0.3)
		local h = math.max(0.6, top - bottom)
		local cx, cz = (x0 + x1) / 2, (z0 + z1) / 2
		local w, d = x1 - x0 + 2 * MT, z1 - z0 + 2 * MT
		mk(folder, lt, "RobeSkirt", V3(w, h, d), lt.CFrame * CF(cx, top - h / 2, cz), color, "Block", mat).Reflectance = refl
		local belt = mk(folder, lt, "RobeBelt", V3(w + 0.03, 0.18, d + 0.03), lt.CFrame * CF(cx, top - 0.16, cz), trim, "Block", mat)
		-- (v10) the belt's knot at the front and its two tails hanging from it (welded to the belt they hang from: over
		-- a big man's trunks the robe's front stands well off the hips' box, and the knot rides on the robe, not the hips)
		local fz = cz - (d + 0.03) / 2
		mk(folder, belt, "BeltKnot", V3(0.24, 0.2, 0.08), lt.CFrame * CF(cx + 0.12, top - 0.16, fz - 0.03), trim, "Block", mat)
		for i, ang in ipairs({ -8, 10 }) do
			mk(folder, belt, "BeltTail", V3(0.13, 0.5, 0.035), lt.CFrame * CF(cx + 0.06 + 0.13 * i, top - 0.45, fz - 0.035) * ANG(0, 0, RAD(ang)), trim, "Block", mat)
		end
	end
	for _, side in ipairs({ "Left", "Right" }) do
		local ua, la = part(model, side .. "UpperArm"), part(model, side .. "LowerArm")
		if ua then
			local us = ua.Size
			mk(folder, ua, "Sleeve", V3(us.X + 2 * MA, us.Y + 0.03, us.Z + 2 * MA), ua.CFrame * CF(0, 0.015, 0), color, "Block", mat).Reflectance = refl
		end
		if la then
			-- forearm sleeve: the upper 70% of the forearm, the trim at its cuff
			local ls = la.Size
			local len = ls.Y * 0.7
			local cy = ls.Y * 0.5 - len / 2
			mk(folder, la, "SleeveLow", V3(ls.X + 2 * MA, len, ls.Z + 2 * MA), la.CFrame * CF(0, cy, 0), color, "Block", mat).Reflectance = refl
			mk(folder, la, "SleeveTrim", V3(ls.X + 2 * MA + 0.03, 0.08, ls.Z + 2 * MA + 0.03), la.CFrame * CF(0, cy - len / 2 + 0.04, 0), trim, "Block", mat)
		end
	end
	local hood = robeId == "Hooded" or robeId == "Champion"
	if hood or hadHood then
		hairHidden(model, hood)
	end
end

------------------------------------------------------------------------
-- Sweat (body side: muscles, gloves, wraps) and body bruising
------------------------------------------------------------------------
-- Builder.SetSweat calls Head.SetSweat (skin, hair, beard; writes the Sweat attribute) then this
function Body.SetSweat(model, app, level)
	level = math.clamp(tonumber(level) or 0, 0, 1)
	local look = model:FindFirstChild("BoxerLook")
	if not look then
		return
	end
	-- a subtle sheen: Reflectance mirrors the sky, so keep it low or skin glows white
	local base = (app and app.face and app.face.shine or 0) * 0.03
	local r = math.clamp(base + level * 0.05, 0, 0.08)
	local muscles = look:FindFirstChild("Muscles")
	if muscles then
		for _, p in ipairs(muscles:GetChildren()) do
			if p:IsA("BasePart") and not (p:GetAttribute("Groove") or p:GetAttribute("Fat") or p:GetAttribute("Cloth") or p:GetAttribute("Grime")) then
				p.Reflectance = r
			end
		end
	end
	-- (v10) the trunks' satin: a touch darker and a hint more sheen as it soaks
	local attire = look:FindFirstChild("Attire")
	if attire then
		for _, p in ipairs(attire:GetChildren()) do
			if p:IsA("BasePart") and p:GetAttribute("Wet") == "cloth" then
				local bc = p:GetAttribute("BaseColor")
				if typeof(bc) == "Color3" then
					p.Color = bc:Lerp(darken(bc, 0.86), level * 0.6)
					local br = p:GetAttribute("BaseRefl") or 0
					p.Reflectance = math.min(br + 0.03 * level, 0.08)
				end
			end
		end
	end
	local hands = look:FindFirstChild("Hands")
	if hands then
		for _, p in ipairs(hands:GetChildren()) do
			if p:IsA("BasePart") then
				local kind = p:GetAttribute("Wet")
				local bc = p:GetAttribute("BaseColor")
				if kind == "glove" and typeof(bc) == "Color3" then
					-- sweat darkens leather and adds a little shine
					p.Color = bc:Lerp(darken(bc, 0.8), level * 0.7)
					-- never below the build value: metallic (Foil, 0.35) gloves keep their designed shine
					local br = p:GetAttribute("BaseRefl") or 0
					p.Reflectance = math.max(br, math.min(br + 0.05 * level, 0.27))
				elseif kind == "wrap" and typeof(bc) == "Color3" then
					-- soaked cotton goes grey and darker
					p.Color = bc:Lerp(darken(bc, 0.84), level * 0.8)
				elseif p.Name == "SweatMark" then
					local bt = p:GetAttribute("BaseTransparency") or 0.4
					p.Transparency = bt + (0.2 - bt) * level
				end
			end
		end
	end
end

local function bruiseColor(skin, age)
	local list = Config.FaceDamage.bruiseColors
	age = tonumber(age) or 0
	local function col(e)
		return e and e.rgb and rgb(e.rgb) or skin
	end
	for i = #list, 1, -1 do
		if age >= list[i].day then
			local nxt = list[i + 1]
			if not nxt then
				return col(list[i])
			end
			return col(list[i]):Lerp(col(nxt), math.clamp((age - list[i].day) / (nxt.day - list[i].day), 0, 1))
		end
	end
	return col(list[1])
end

-- The tier torsos' skin (each tier's UpperTorso.mesh sampled into its box, the same for both genders: the women's
-- torso is the same mesh, scaled): per row v (-0.45 .. 0.45 of Size.Y by 0.1), per azimuth from the front (0) to the
-- side (90 deg) by 15, the radius r of the skin, box-normalised: the skin is at (sin a r, v, -cos a r) x Size
-- (both sides averaged). A torso without a tier is the plain box. Generated by tools/body/torso_surf.py --write from the
-- detailed (v10) meshes; the lite set's torsos (Config.Detail.meshes) differ by at most 0.023 of the box (a mark there
-- sinks or rises that little: SurfaceMark lenses are 0.004+ proud and translucent).
local TORSO_SURF = {
	[1] = { { 0.318, 0.324, 0.327, 0.314, 0.293, 0.275, 0.267 }, { 0.462, 0.471, 0.474, 0.456, 0.424, 0.397, 0.386 }, { 0.449, 0.460, 0.458, 0.438, 0.405, 0.379, 0.369 }, { 0.449, 0.460, 0.463, 0.445, 0.414, 0.387, 0.377 }, { 0.453, 0.464, 0.472, 0.458, 0.428, 0.400, 0.389 }, { 0.470, 0.483, 0.494, 0.481, 0.449, 0.420, 0.408 }, { 0.483, 0.510, 0.526, 0.508, 0.471, 0.440, 0.428 }, { 0.487, 0.515, 0.539, 0.536, 0.509, 0.484, 0.472 }, { 0.455, 0.470, 0.505, 0.523, 0.521, 0.503, 0.491 }, { 0.331, 0.341, 0.364, 0.381, 0.376, 0.361, 0.354 } },
	[2] = { { 0.294, 0.300, 0.305, 0.299, 0.282, 0.265, 0.258 }, { 0.427, 0.435, 0.442, 0.437, 0.411, 0.383, 0.372 }, { 0.410, 0.437, 0.427, 0.416, 0.392, 0.367, 0.356 }, { 0.411, 0.440, 0.434, 0.426, 0.401, 0.375, 0.366 }, { 0.421, 0.441, 0.447, 0.444, 0.421, 0.393, 0.385 }, { 0.436, 0.464, 0.473, 0.470, 0.448, 0.419, 0.411 }, { 0.449, 0.512, 0.530, 0.509, 0.469, 0.439, 0.431 }, { 0.461, 0.513, 0.541, 0.536, 0.507, 0.485, 0.475 }, { 0.432, 0.448, 0.488, 0.506, 0.514, 0.499, 0.489 }, { 0.290, 0.298, 0.324, 0.348, 0.351, 0.338, 0.335 } },
	[3] = { { 0.271, 0.277, 0.284, 0.283, 0.272, 0.255, 0.249 }, { 0.394, 0.402, 0.412, 0.419, 0.399, 0.371, 0.359 }, { 0.375, 0.416, 0.397, 0.392, 0.378, 0.355, 0.344 }, { 0.377, 0.423, 0.408, 0.407, 0.389, 0.364, 0.356 }, { 0.392, 0.424, 0.423, 0.429, 0.417, 0.388, 0.382 }, { 0.404, 0.451, 0.459, 0.458, 0.447, 0.419, 0.414 }, { 0.418, 0.512, 0.533, 0.510, 0.467, 0.439, 0.434 }, { 0.437, 0.509, 0.539, 0.532, 0.505, 0.486, 0.478 }, { 0.410, 0.424, 0.467, 0.489, 0.507, 0.494, 0.487 }, { 0.251, 0.258, 0.286, 0.321, 0.330, 0.322, 0.322 } },
	[4] = { { 0.255, 0.261, 0.269, 0.270, 0.263, 0.247, 0.241 }, { 0.367, 0.376, 0.387, 0.402, 0.388, 0.362, 0.348 }, { 0.347, 0.397, 0.373, 0.371, 0.365, 0.343, 0.332 }, { 0.351, 0.406, 0.386, 0.389, 0.377, 0.355, 0.346 }, { 0.370, 0.412, 0.404, 0.415, 0.413, 0.384, 0.380 }, { 0.380, 0.445, 0.452, 0.446, 0.444, 0.419, 0.418 }, { 0.395, 0.513, 0.536, 0.511, 0.465, 0.439, 0.436 }, { 0.418, 0.504, 0.537, 0.529, 0.503, 0.489, 0.482 }, { 0.390, 0.402, 0.447, 0.469, 0.502, 0.492, 0.485 }, { 0.213, 0.219, 0.256, 0.299, 0.313, 0.310, 0.311 } },
	[5] = { { 0.241, 0.246, 0.256, 0.258, 0.253, 0.240, 0.233 }, { 0.344, 0.352, 0.365, 0.383, 0.377, 0.352, 0.338 }, { 0.324, 0.378, 0.352, 0.352, 0.352, 0.332, 0.320 }, { 0.330, 0.390, 0.365, 0.374, 0.366, 0.346, 0.338 }, { 0.352, 0.399, 0.387, 0.402, 0.409, 0.380, 0.379 }, { 0.359, 0.445, 0.450, 0.437, 0.438, 0.419, 0.422 }, { 0.376, 0.513, 0.538, 0.511, 0.464, 0.440, 0.438 }, { 0.402, 0.499, 0.535, 0.526, 0.503, 0.492, 0.486 }, { 0.371, 0.383, 0.427, 0.451, 0.489, 0.489, 0.483 }, { 0.161, 0.166, 0.194, 0.280, 0.299, 0.301, 0.304 } },
}

local function torsoPoint(torso, a, v)
	local T = TORSO_SURF[torso:GetAttribute("BodyTier")]
	local r
	if T then
		local fv = math.clamp((v + 0.45) / 0.1, 0, 9)
		local i0 = math.floor(fv)
		local i1, tv = math.min(i0 + 1, 9), fv - i0
		local fa = math.clamp(math.abs(math.deg(a)) / 15, 0, 6)
		local j0 = math.floor(fa)
		local j1, ta = math.min(j0 + 1, 6), fa - j0
		local r0 = T[i0 + 1][j0 + 1] + (T[i0 + 1][j1 + 1] - T[i0 + 1][j0 + 1]) * ta
		local r1 = T[i1 + 1][j0 + 1] + (T[i1 + 1][j1 + 1] - T[i1 + 1][j0 + 1]) * ta
		r = r0 + (r1 - r0) * tv
	else
		r = 0.5 / math.max(math.abs(math.sin(a)), math.abs(math.cos(a)), 1e-3)
	end
	local s = BodyTiers.CoreSize(torso) -- (v17: TORSO_SURF is measured on the torso without its shoulder caps)
	return V3(math.sin(a) * r * s.X, v * s.Y, -math.cos(a) * r * s.Z)
end

-- a mark lying on the torso's skin (the face's lens: an ellipsoid sunk so a footprint w x h shows, rising `rise`): at u
-- across (fraction of Size.X, + = +X) and v up (fraction of Size.Y) on the front half; welded to the torso
function Body.SurfaceMark(folder, torso, name, u, v, w, h, color, transparency, rise, dk)
	rise = rise or 0.004
	local a = 0
	for _ = 1, 16 do
		local x = torsoPoint(torso, a, v).X / BodyTiers.CoreSize(torso).X
		a = math.clamp(a + (u - x) * 1.5, -1.5, 1.5)
	end
	local p = torsoPoint(torso, a, v)
	local ta = torsoPoint(torso, a + 0.02, v) - torsoPoint(torso, a - 0.02, v)
	local tv = torsoPoint(torso, a, v + 0.02) - torsoPoint(torso, a, v - 0.02)
	local nrm = ta:Cross(tv).Unit
	if nrm:Dot(V3(p.X, 0, p.Z)) < 0 then
		nrm = -nrm
	end
	local cf = CFrame.lookAt(p, p + nrm, tv.Unit)
	local function sagAt(da, dv)
		return math.max((p - torsoPoint(torso, a + da, v + dv)):Dot(nrm), 0)
	end
	local da = (w / 2) / math.max(ta.Magnitude / 0.04, 1e-3)
	local dv = (h / 2) / torso.Size.Y
	local sx = math.max(sagAt(da, 0), sagAt(-da, 0))
	local sy = math.max(sagAt(0, dv), sagAt(0, -dv))
	local D = math.max(rise / (1 - math.clamp(dk or 0.8, 0.05, 0.95)), 0.01)
	local c = D - rise
	local need = math.max(sx, sy) * 1.1 + 0.001
	if c < need then
		c = need
		D = rise + need
	end
	local fx = math.sqrt(math.max(1 - ((c - sx) / D) ^ 2, 0.04))
	local fy = math.sqrt(math.max(1 - ((c - sy) / D) ^ 2, 0.04))
	return mk(folder, torso, name, V3(w / fx, h / fy, 2 * D), torso.CFrame * cf * CF(0, 0, c), color, "Ellipsoid", SMOOTH, transparency)
end

-- body shots: soft translucent bruising lying on the ribs (dmg.ribsL / ribsR), from the flank round toward the front.
-- Adds to BoxerLook/Damage after Head.SetDamage (which recreates the folder); never destroys the face damage.
-- Partial tables are fine.
function Body.SetDamage(model, app, dmg)
	local look = model:FindFirstChild("BoxerLook")
	local ut = part(model, "UpperTorso")
	if not (look and ut) then
		return
	end
	local folder = look:FindFirstChild("Damage")
	if folder then
		for _, c in ipairs(folder:GetChildren()) do
			if c.Name == "RibBruise" or c.Name == "BodyFlush" or c.Name == "AbBruise" then
				c:Destroy()
			end
		end
	end
	if type(dmg) ~= "table" then
		return
	end
	local skin = Looks.Color(Looks.SkinTones[(app and app.skin) or 5])
	local s = BodyTiers.CoreSize(ut) -- (v17: the ribs' width, not the shoulder caps')
	-- women: on the bare midriff, under the sports top (which ends at -0.18 Y)
	local female = app and app.gender == 2
	local cy, cy2, hMax = -0.2, -0.24, 0.36
	if female then
		cy, cy2, hMax = -0.34, -0.37, 0.2
	end
	for _, e in ipairs({ { -1, "ribsL" }, { 1, "ribsR" } }) do
		local side, v = e[1], math.clamp(tonumber(dmg[e[2]]) or 0, 0, 1)
		if v > 0.08 then
			if not folder then
				folder = Instance.new("Folder")
				folder.Name = "Damage"
				folder.Parent = look
			end
			local c = lerpColor(skin, bruiseColor(skin, dmg.age), 0.8)
			Body.SurfaceMark(folder, ut, "RibBruise", side * 0.29, cy, (0.26 + 0.08 * v) * s.X, math.min(0.18 + 0.1 * v, hMax) * s.Y, c,
				math.clamp(0.8 - 0.3 * v, 0.52, 0.84), 0.004, 0.8)
			if v > 0.5 then
				-- a darker core inside it, off its middle
				Body.SurfaceMark(folder, ut, "RibBruise", side * 0.31, cy2, 0.13 * s.X, math.min(0.1, hMax) * s.Y, darken(c, 0.85),
					math.clamp(0.84 - 0.34 * v, 0.55, 0.84), 0.0065, 0.75)
			end
			-- (v10) the fresh red flush where the shots land, a little in front of the bruise (fades with the bruise's age)
			local age = tonumber(dmg.age) or 0
			if v > 0.25 and age < 0.5 then
				Body.SurfaceMark(folder, ut, "BodyFlush", side * 0.22, cy + 0.04, 0.2 * s.X, math.min(0.16, hMax) * s.Y,
					lerpColor(skin, Color3.fromRGB(200, 70, 60), 0.45), math.clamp(0.9 - 0.25 * v, 0.68, 0.9), 0.003, 0.8)
			end
		end
	end
	-- (v10) heavy body work on both sides: a bruise over the lower abs too (one lens, translucent)
	local both = math.min(math.clamp(tonumber(dmg.ribsL) or 0, 0, 1), math.clamp(tonumber(dmg.ribsR) or 0, 0, 1))
	if both > 0.45 and folder then
		local c = lerpColor(skin, bruiseColor(skin, dmg.age), 0.7)
		Body.SurfaceMark(folder, ut, "AbBruise", 0.06, female and -0.4 or -0.32, 0.18 * s.X, math.min(0.12, hMax) * s.Y, c,
			math.clamp(0.86 - 0.3 * both, 0.6, 0.86), 0.004, 0.8)
	end
end

------------------------------------------------------------------------
-- Build steps (called by Builder.Cosmetics) and helpers shared with Builder
------------------------------------------------------------------------
------------------------------------------------------------------------
-- The gear's look for the anatomy meshes (look.attire.gear): AnatomyBody draws the gloves / wraps / shoes
-- itself when the meshes are on, from the same colours, styles and sizes the round-1 parts are built with
------------------------------------------------------------------------
local function c255(c)
	return { math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5) }
end

local function gearLook(app, gear, opts)
	opts = opts or {}
	gear = gearOf(gear)
	local a = app.attire or {}
	-- gloves (glovesBuild's derivation)
	local g = app.gloves or {}
	local gloveDef = Catalog.Find(Catalog.Gloves, gear.gloves) or Catalog.Gloves[1]
	local brand = Catalog.GearBrand("gloves", gloveDef.id, g.brand)
	local custom = gloveDef.custom or {}
	local cond = gear.glovesCond or 100
	local pal = brand.palette or {}
	local main = wearColor(Looks.Color(g.color, rgb(pal.primary, Color3.fromRGB(200, 25, 30))), cond)
	local trim = custom.trim and Looks.Color(g.trim, WHITE) or wearColor(Color3.fromRGB(236, 234, 228), cond)
	local finish = custom.finish and (g.finish or brand.finish or "Leather") or (brand.finish or "Leather")
	if finish == "Metallic" and not (custom.metallic or brand.finish == "Metallic") then
		finish = "Patent"
	end
	if gloveDef.id == "WorldChampion" then
		trim = GOLD
	end
	local piping = nil
	if brand.piping == "trim" then
		piping = trim
	elseif type(brand.piping) == "table" then
		piping = rgb(brand.piping)
	end
	local stitch = brand.stitch or "Single"
	if custom.stitching and g.stitching and g.stitching ~= "Classic" then
		stitch = g.stitching
	end
	local lum = 0.299 * main.R + 0.587 * main.G + 0.114 * main.B
	local stitchColor = lum < 0.15 and lerpColor(main, WHITE, 0.35) or darken(main, 0.55)
	if stitch == "Contrast" then
		stitchColor = trim
	elseif stitch == "Gold" then
		stitchColor = GOLD
	end
	local strapColor = custom.trim and trim or rgb(pal.secondary, trim)
	local oz = gloveDef.oz or 16
	if opts.fightNight then
		oz = math.min(oz, 10)
	end
	local shape = brand.shape or {}
	local glove = {
		c = c255(main), trim = c255(trim), palm = c255(darken(main, brand.palm or 0.9)), stitch = c255(stitchColor), stitchKind = stitch,
		piping = piping and c255(piping) or nil, strap = c255(strapColor), finish = finish, oz = oz, w = shape.width or 1, l = shape.len or 1,
		k = shape.knuckle or 1, cuff = shape.cuff or 1, closure = brand.closure or "velcro", tape = opts.fightNight == true,
		target = brand.targetArea == true, cond = q(cond, 10),
	}
	-- wraps
	local wc, c2, c3 = wrapColors(app, gear)
	local wrapDef = Catalog.Find(Catalog.Wraps, gear.wraps) or Catalog.Wraps[1]
	local wrap = { c = c255(wc), c2 = c255(c2), c3 = c255(c3), gel = wrapDef.style == "gel", cond = q(gear.wrapsCond or 100, 10) }
	-- shoes (shoesBuild's derivation)
	local shoe = shoeOf(gear)
	local sBrand = Catalog.GearBrand("shoes", shoe.id)
	local shoeColor = shoeColorOf(app, gear)
	local sPal = sBrand.palette or {}
	local accent = rgb(sPal.secondary, WHITE)
	if (accent.R + accent.G + accent.B) - (shoeColor.R + shoeColor.G + shoeColor.B) < 0.25 and (shoeColor.R + shoeColor.G + shoeColor.B) - (accent.R + accent.G + accent.B) < 0.25 then
		accent = rgb(sPal.accent, contrast(shoeColor))
	end
	local soleKind = shoe.sole or sBrand.sole or "Rubber"
	local so = SOLE[soleKind] or SOLE.Rubber
	local laceColor = Looks.Color(a.laces, Color3.fromRGB(240, 240, 240))
	if (gear.shoesCond or 100) < 40 then
		laceColor = lerpColor(laceColor, Color3.fromRGB(170, 160, 140), 0.5)
	end
	local shoeL = {
		c = c255(shoeColor), accent = c255(accent), sole = c255(so.color or Looks.Color(a.trim, WHITE)), soleKind = soleKind, lace = c255(laceColor),
		sock = c255(Looks.Color(a.socks, WHITE)), style = shoe.style or "boot", tall = a.shoeStyle ~= "Low-Top", cond = q(shoeCond(gear) / 60 * 100, 10),
	}
	return { glove = glove, wrap = wrap, shoe = shoeL }
end

Body.Colors = colorBody -- (model, app, gear, opts)
Body.GearLook = gearLook -- (app, gear, opts) -> look.attire.gear for the anatomy meshes
Body.Muscles = musclesBuild -- (model, app, build, opts?, spec?, gear?) -> envelope
Body.Attire = attireBuild -- (model, app, opts, gear, spec?, envelope?)
Body.Hands = handsBuild -- (model, app, gear, opts, spec?)
Body.Resolve = resolve -- (app, build, opts, model?) -> spec { ph, lv, fat, def, vein, bulk, detail, ... }
Body.Gear = gearOf -- (gear) -> gear with the section 4 defaults
Body.PV = PV
Body.frameOf = frameOf -- (app)
Body.avgDev = avgDev -- (build, keys)

return Body
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="49">
        <Properties>
          <string name="Name">BuilderGear</string>
          <string name="Source"><![CDATA[-- BuilderGear: the Blender-modelled boxing gear on the server (tools/body/build_gear.py, uploaded by
-- tools/body/publish_gear.py into the generated GearAssetData). Every piece is fitted to ONE body part of ONE muscle
-- tier (the waistband and the seat to the LowerTorso, a shorts leg to its UpperLeg, the cuff to the LowerArm, the
-- boot shaft to the LowerLeg...; the glove, wrap and boot foot are the same at every tier) and is welded to it:
-- * templates: one MeshPart per mesh id, made once per server with AssetService:CreateMeshPartAsync (pcall;
--   concurrent callers wait for the same load; a failed id is retried after RETRY seconds), like BuilderTiers
-- * Resolve(model, group, style): the pieces a style wears (GearAssetData.sets) for the tiers the model's parts show
--   (their BodyTier attribute; a piece with tierOf - the trunks' band and seat - takes the highest tier among those
--   parts, its offset moved onto the part's own tier: PieceTier). Nothing is half built: when a part is not a tier part, an id is 0 or a load failed,
--   it returns nil and the caller builds its part-built gear (BuilderBody's blocks)
-- * Build(folder, pieces, paint): a clone per piece, sized ONCE to the template's size x the body part's scale
--   ratio (Size / OriginalSize: the ratio BuilderTiers gave the part, so the gear scales exactly with the mesh under
--   it), welded at part.CFrame * CFrame.new(offset x ratio) (a Weld: it follows the part through every pose), and
--   painted per colour slot: paint(slot, piece name) -> colour, material, reflectance
-- * a tier change swaps the body part; the caller's cache signature carries Key(pieces) (the mesh ids and the
--   parts' sizes), so the gear is rebuilt for the new tier on the next Cosmetics
-- * checks for Studio: a template whose engine box (CreateMeshPartAsync's Size = the uploaded mesh's bounding box) is
--   not the manifest's size warns once (the upload and GearAssetData disagree); BuilderBody writes each group's state on
--   the Attire folder ("Trunks = mesh" / "blocks: <reason>"); Audit(model, true) prints every piece's mesh, part,
--   tier, ratio and size against the manifest - from the Studio command bar (server side, while playing):
--   require(game.ReplicatedStorage.Shared.BuilderGear).Audit(workspace.<Name>, true)
-- Tests: BuilderGear.Services = { AssetService = fake, Content = fake }, BuilderGear.SetData(t), BuilderGear.Reset().
local BuilderGear = {}

local Shared = script.Parent
local BuilderTiers = require(Shared:WaitForChild("BuilderTiers"))
local BodyTiers = require(Shared:WaitForChild("BodyTiers"))
local Kit = require(Shared:WaitForChild("BuilderKit"))

local V3 = Vector3.new
BuilderGear.RETRY = 120 -- seconds between on-demand retries once the backoff schedule (Kit.ASSET_BACKOFF) is spent
-- every built gear piece carries this CollectionService tag: the clients watch its mesh arrive (BoxerClient.MeshGuard)
-- and show a rounded stand-in instead of the engine's box while it cannot be drawn
BuilderGear.TAG = "WCBGearMesh"
BuilderGear.BBOX_TOL = 0.02 -- the uploaded mesh's box may differ from the manifest's size by this fraction before a warning
BuilderGear.Services = {}

------------------------------------------------------------------------
-- GearAssetData
------------------------------------------------------------------------
local data
local function load()
	if data == nil then
		local ok, res = false, nil
		local m = Shared:FindFirstChild("GearAssetData")
		if m then
			ok, res = pcall(require, m)
		end
		data = (ok and type(res) == "table") and res or {}
	end
	return data
end
function BuilderGear.Data()
	return load()
end
-- tests / tools: use this table instead of the module (nil: load the module again)
function BuilderGear.SetData(d)
	data = d
end

local function idOf(v)
	local n = tonumber(v)
	return (n and n > 0) and math.floor(n) or nil
end
local function vec(t)
	if type(t) ~= "table" or type(t[1]) ~= "number" or type(t[2]) ~= "number" or type(t[3]) ~= "number" then
		return nil
	end
	return V3(t[1], t[2], t[3])
end

-- the piece `name` for a body part of tier `tier`: { id, offset, size, part, slot, group, name } or nil. lite = true:
-- the piece's `lite` mesh (the v9 set worn on lite body parts, Config.Detail.meshes), the full one when it has none
function BuilderGear.Entry(tier, name, d, lite)
	d = d or load()
	local tiers = type(d.tiers) == "table" and d.tiers or nil
	local t = tiers and (tiers[tier] or tiers[tostring(tier)])
	local e = type(t) == "table" and t[name] or nil
	local p = type(d.pieces) == "table" and d.pieces[name] or nil
	if type(e) ~= "table" or type(p) ~= "table" then
		return nil
	end
	local isLite = false
	if lite and type(e.lite) == "table" and idOf(e.lite.mesh) and vec(e.lite.offset) and vec(e.lite.size) then
		e, isLite = e.lite, true
	end
	local id, offset, size = idOf(e.mesh), vec(e.offset), vec(e.size)
	if not (id and offset and size) or size.X <= 0 or size.Y <= 0 or size.Z <= 0 then
		return nil
	end
	return { id = id, offset = offset, size = size, part = p.part, slot = p.slot, group = p.group, name = name, tier = tier,
		lite = isLite }
end

-- the piece names a style wears (sided names expanded to _L / _R), or nil when the manifest has no such set
function BuilderGear.SetPieces(group, style, d)
	d = d or load()
	local g = type(d.sets) == "table" and d.sets[group] or nil
	local list = type(g) == "table" and g[style] or nil
	if type(list) ~= "table" then
		return nil
	end
	local out = {}
	for _, base in ipairs(list) do
		local pieces = type(d.pieces) == "table" and d.pieces or {}
		if pieces[base .. "_R"] or pieces[base .. "_L"] then
			table.insert(out, base .. "_L")
			table.insert(out, base .. "_R")
		else
			table.insert(out, base)
		end
	end
	return out
end

------------------------------------------------------------------------
-- Templates
------------------------------------------------------------------------
local cache = {} -- id -> { part = template } | { loading = true } | { failed = os.clock() }
local stats = { loads = 0, failed = 0, built = 0 }

function BuilderGear.Reset()
	for _, e in pairs(cache) do
		if e.part then
			pcall(function()
				e.part:Destroy()
			end)
		end
	end
	table.clear(cache)
	stats.loads, stats.failed, stats.built = 0, 0, 0
end

function BuilderGear.Stats()
	return table.clone(stats)
end

local function assetService()
	return BuilderGear.Services.AssetService or game:GetService("AssetService")
end

local function contentOf(uri)
	local C = BuilderGear.Services.Content or Content
	if C and C.fromUri then
		return C.fromUri(uri)
	end
	return uri
end

-- the template MeshPart for a mesh id (unscaled: Size = the mesh bbox), or nil + reason. Yields on the first call
-- for an id (CreateMeshPartAsync); later calls are free. force: retry a failed id now (the background retry)
function BuilderGear.Template(id, size, force)
	if not idOf(id) then
		return nil, "not uploaded"
	end
	local c = cache[id]
	while c and c.loading do
		task.wait()
		c = cache[id]
	end
	if c and c.part then
		return c.part
	elseif c and c.failed and not force and os.clock() < (c.retryAt or c.failed + BuilderGear.RETRY) then
		return nil, "failed"
	end
	local prev = c
	cache[id] = { loading = true }
	stats.loads += 1
	local ok, mp = Kit.Load(function()
		return pcall(function()
			return assetService():CreateMeshPartAsync(contentOf("rbxassetid://" .. id), {
				CollisionFidelity = Enum.CollisionFidelity.Box, RenderFidelity = Enum.RenderFidelity.Automatic,
			})
		end)
	end)
	if ok and mp then
		-- a part without geometry (an empty MeshId, a zero MeshSize) is drawn as its box: never a template
		local good, why = Kit.MeshLoaded(mp)
		if not good then
			pcall(function()
				mp:Destroy()
			end)
			ok, mp = false, why
		end
	end
	if ok and mp then
		ok = pcall(function()
			-- the engine's own Size for the loaded mesh = its bounding box: the manifest's `size` must be the same
			-- number (the mesh is drawn recentred on that box and scaled to Size per axis), else the uploaded mesh is
			-- not the one build_gear.py measured (a stale manifest, an id pointing at an older upload): say so
			-- (a 1 x 1 x 1 Size is a stub part that never loaded a mesh - the simulators' fakes - not a measurement)
			local bbox = mp.Size
			if typeof(bbox) == "Vector3" and bbox.X > 1e-4 and bbox.Y > 1e-4 and bbox.Z > 1e-4 and (bbox - V3(1, 1, 1)).Magnitude > 1e-6 then
				mp:SetAttribute("GearBBox", bbox)
				if size then
					local d = V3(math.abs(bbox.X / size.X - 1), math.abs(bbox.Y / size.Y - 1), math.abs(bbox.Z / size.Z - 1))
					if math.max(d.X, d.Y, d.Z) > BuilderGear.BBOX_TOL then
						warn(string.format("[Gear] mesh %d: the uploaded mesh's box %s is not the manifest's size %s (GearAssetData is "
							.. "out of step with the upload: rebuild and re-run publish_gear.py); drawn at the manifest's size", id,
							tostring(bbox), tostring(size)))
					end
				end
			end
			mp.Anchored = false
			mp.CanCollide = false
			mp.CanQuery = false
			mp.CanTouch = false
			mp.Massless = true
			mp.CastShadow = false
			if size then
				mp.Size = size
			end
			mp:SetAttribute("GearMesh", id)
		end)
	end
	if not (ok and mp) then
		stats.failed += 1
		-- retried in the background on a backoff (Kit.ASSET_BACKOFF: a fresh upload whose content is still being
		-- generated loads a few minutes later), then on demand every RETRY seconds
		local tries = (prev and prev.tries or 0) + 1
		local delay = Kit.RetryDelay(tries)
		local now = os.clock()
		cache[id] = { failed = now, tries = tries, retryAt = now + (delay or BuilderGear.RETRY), err = tostring(mp) }
		if tries == 1 or not delay then
			warn(string.format("[Gear] mesh %d did not load (%s); the part-built gear stays%s", id, tostring(mp),
				delay and string.format(" (retrying in %ds, then on a backoff for a few minutes)", delay) or ""))
		end
		if delay then
			Kit.Schedule(delay, function()
				local e = cache[id]
				if e and e.failed and e.tries == tries then
					BuilderGear.Template(id, size, true)
				end
			end)
		end
		return nil, "failed"
	end
	cache[id] = { part = mp }
	if prev and prev.failed then
		print(string.format("[Gear] mesh %d loaded after %d failed attempt(s); the boxers built without it are refitted", id, prev.tries or 1))
		Kit.AssetReady("gear", id)
	end
	return mp
end

-- true while any gear mesh is in its failed state (Builder keeps the boxers built meanwhile for a rebuild)
function BuilderGear.Failing()
	for _, e in pairs(cache) do
		if e.failed then
			return true
		end
	end
	return false
end

-- load every uploaded gear mesh in the background (server start). ~520 meshes: fired back to back at boot they held
-- the asset pipeline for the first minute (in Studio the client's too) while the player's own body and gear, the
-- menu's boxer and the gym's NPCs waited behind them. Now: nothing for PRELOAD_DEFER seconds (the first player's
-- build and the gym's NPCs ask for their own pieces on demand), then one load every PRELOAD_GAP seconds, the pieces
-- worn most first (gloves, wraps, shoes, trunks; the default tier before the others; the full set before the lite
-- one), each yielding to the player's own loads (Kit.Load). opts = { gap, defer } (tests / tools)
BuilderGear.PRELOAD_GAP = 0.1
BuilderGear.PRELOAD_DEFER = 8
local GROUP_ORDER = { gloves = 1, wraps = 2, shoes = 3, trunks = 4, top = 5, official = 6 }
function BuilderGear.PreloadList()
	local d = load()
	local seen, list = {}, {}
	for _, lite in ipairs({ false, true }) do
		for tier, t in pairs(type(d.tiers) == "table" and d.tiers or {}) do
			for name in pairs(type(t) == "table" and t or {}) do
				local e = BuilderGear.Entry(tier, name, d, lite)
				if e and not seen[e.id] then
					seen[e.id] = true
					local tn = tonumber(tier) or 9
					table.insert(list, { id = e.id, size = e.size, name = name, lite = lite,
						rank = (lite and 1000 or 0) + (GROUP_ORDER[e.group or ""] or 9) * 10 + (tn == 1 and 0 or tn) })
				end
			end
		end
	end
	table.sort(list, function(a, b)
		if a.rank ~= b.rank then
			return a.rank < b.rank
		end
		return a.id < b.id
	end)
	return list
end
function BuilderGear.Preload(opts)
	opts = type(opts) == "table" and opts or {}
	local gap = tonumber(opts.gap) or BuilderGear.PRELOAD_GAP
	local defer = tonumber(opts.defer) or BuilderGear.PRELOAD_DEFER
	task.spawn(function()
		if defer > 0 then
			task.wait(defer)
		end
		for _, q in ipairs(BuilderGear.PreloadList()) do
			if not cache[q.id] then
				BuilderGear.Template(q.id, q.size)
				if gap > 0 then
					task.wait(gap)
				end
			end
		end
	end)
end

------------------------------------------------------------------------
-- Resolve / build
------------------------------------------------------------------------
-- the tier whose piece a model wears and the body part it welds to: the part's own BodyTier, or for a piece with
-- tierOf (the trunks' band and seat: fitted round the LowerTorso, the UpperTorso's hem and both thighs) the highest
-- tier among those parts, the piece then fitted to them all. nil when a part is not a tier part
local function pieceTier(model, p)
	local body = model:FindFirstChild(p.part)
	local own = body and tonumber(body:GetAttribute("BodyTier"))
	if not own then
		return nil
	end
	local tier = own
	if type(p.tierOf) == "table" then
		for _, pn in ipairs(p.tierOf) do
			local o = model:FindFirstChild(pn)
			local t = o and tonumber(o:GetAttribute("BodyTier"))
			if not t then
				return nil
			end
			tier = math.max(tier, t)
		end
	end
	-- (the detail set: a lite body part wears the lite gear fitted to it)
	return tier, body, own, body:GetAttribute("BodyLite") == true
end
BuilderGear.PieceTier = pieceTier

-- a piece of tier `tier` worn on a body part of tier `own`: the offset is in the part's space of ITS tier; the
-- LowerTorso's rig attachments are the same rest-space points at every tier, so the difference of the RootRigAttachment's
-- part-space positions moves the offset onto the part the model really shows
local function onPart(e, partName, tier, own, lite, frame)
	if tier == own then
		return e
	end
	local a = BodyTiers.PartEntry(own, partName, nil, lite, frame)
	local b = BodyTiers.PartEntry(tier, partName, nil, lite, frame)
	local pa = a and a.attachments.RootRigAttachment
	local pb = b and b.attachments.RootRigAttachment
	if not (pa and pb) then
		return e
	end
	local out = table.clone(e)
	out.offset = e.offset + V3(pa[1] - pb[1], pa[2] - pb[2], pa[3] - pb[3])
	return out
end
-- the pieces `style` of `group` puts on this model: { { name, entry, body, template, ratio } ... }, or nil + reason
-- (the caller builds its part-built gear). Every body part must be a muscle-tier part (BodyTier attribute)
function BuilderGear.Resolve(model, group, style)
	local names = BuilderGear.SetPieces(group, style)
	if not names or #names == 0 then
		return nil, "no set"
	end
	local out = {}
	for _, name in ipairs(names) do
		local d = load()
		local p = type(d.pieces) == "table" and d.pieces[name] or nil
		local tier, body, own, lite
		if p then
			tier, body, own, lite = pieceTier(model, p)
		end
		if not tier then
			return nil, "not a tier part: " .. tostring(p and p.part or name)
		end
		local e = BuilderGear.Entry(tier, name, d, lite)
		if not e then
			return nil, "not uploaded: " .. name
		end
		-- (v12 frames: the piece is fitted on the default family; the body part of another frame is that part scaled by
		-- the frame's gear scale, so the piece takes the same scale on top of the engine's ratio)
		local frame = (not lite) and body:GetAttribute("BodyFrame") or nil
		e = onPart(e, p.part, tier, own, lite, frame)
		local template = BuilderGear.Template(e.id, e.size)
		if not template then
			return nil, "failed: " .. name
		end
		local ratio = BuilderTiers.RatioOf(body) or V3(1, 1, 1)
		local g = BodyTiers.GearScale(frame, BodyTiers.Group(p.part))
		ratio = V3(ratio.X * g[1], ratio.Y * g[2], ratio.Z * g[3])
		-- the frames' torsos differ from the default family's in girth, not in the skeleton gearScale carries (its
		-- UpperTorso X / Z are 1): a piece on the UpperTorso (the sports top, the officials' shirts) takes the chest's
		-- width / depth against the default family's at its tier, or it sinks into a Muscular / Power / Heavyweight
		-- chest (the skin through the top, the straps buried) and stands off a Lean one
		if frame and p.part == "UpperTorso" then
			local fF = BodyTiers.Fit(own, "chest", nil, frame)
			local fD = BodyTiers.Fit(tier, "chest")
			if fF and fD and fD.width > 0 and fD.depth > 0 then
				ratio = V3(ratio.X * fF.width / fD.width, ratio.Y, ratio.Z * fF.depth / fD.depth)
			end
		end
		table.insert(out, { name = name, entry = e, body = body, template = template, ratio = ratio })
	end
	return out
end

-- a signature of resolved pieces (mesh ids + the body parts' sizes) for the callers' rebuild caches
function BuilderGear.Key(pieces)
	if not pieces then
		return "blocks"
	end
	local parts = {}
	for _, r in ipairs(pieces) do
		local s = r.body.Size
		table.insert(parts, string.format("%s:%d:%.3f,%.3f,%.3f", r.name, r.entry.id, s.X, s.Y, s.Z))
	end
	return table.concat(parts, "|")
end

-- clone, size, weld and paint every resolved piece into folder. paint(slot, name) -> Color3, Material, reflectance.
-- Returns { [name] = MeshPart }
function BuilderGear.Build(folder, pieces, paint, rename)
	local made = {}
	for _, r in ipairs(pieces) do
		local e, body, ratio = r.entry, r.body, r.ratio
		local p = r.template:Clone()
		p.Name = (rename and rename[r.name]) or r.name
		p.Size = e.size * ratio
		local c0 = CFrame.new(e.offset * ratio)
		p.CFrame = body.CFrame * c0
		local color, material, refl = paint(e.slot, r.name)
		if color then
			p.Color = color
		end
		if material then
			p.Material = material
		end
		p.Reflectance = refl or 0
		p:SetAttribute("GearPiece", r.name)
		p:SetAttribute("GearSlot", e.slot)
		pcall(function()
			p:AddTag(BuilderGear.TAG)
		end)
		local w = Instance.new("Weld")
		w.Name = "GearWeld"
		w.Part0 = body
		w.Part1 = p
		w.C0 = c0
		w.C1 = CFrame.new()
		w.Parent = p
		p.Parent = folder
		made[r.name] = p
		stats.built += 1
	end
	return made
end

-- what a model wears, for the Output / a Studio check (one line per mesh piece: the piece, its mesh id, the body part
-- it is welded to with that part's tier / set / scale ratio, the piece's Size against the manifest's size x ratio, and
-- the uploaded mesh's own box when it differs), then every look folder's group records (BuilderBody: "Trunks = mesh",
-- "Shoes = blocks: failed: BootFoot_L"...). Returns the lines and prints them when `print` is true
function BuilderGear.Audit(model, doPrint)
	local lines = {}
	local look = model and model:FindFirstChild("BoxerLook")
	if not look then
		table.insert(lines, "no BoxerLook folder (Cosmetics has not run)")
	else
		for _, f in ipairs(look:GetChildren()) do
			for _, p in ipairs(f:GetChildren()) do
				local name = p:IsA("BasePart") and p:GetAttribute("GearPiece")
				if name then
					local w = p:FindFirstChild("GearWeld")
					local body = w and w.Part0
					local ratio = BuilderTiers.RatioOf(body)
					local tier = body and body:GetAttribute("BodyTier")
					local e = tier and BuilderGear.Entry(tier, name, nil, body:GetAttribute("BodyLite") == true)
					local want = (e and ratio) and (e.size * ratio) or nil
					local c = cache[p:GetAttribute("GearMesh")]
					local bbox = c and c.part and c.part:GetAttribute("GearBBox")
					table.insert(lines, string.format("%s/%s mesh %s on %s (tier %s%s, ratio %s): size %s%s%s", f.Name, name,
						tostring(p:GetAttribute("GearMesh")), body and body.Name or "?", tostring(tier),
						(body and body:GetAttribute("BodyLite")) and " lite" or "", ratio and tostring(ratio) or "?", tostring(p.Size),
						(want and (p.Size - want).Magnitude > 1e-3) and (" EXPECTED " .. tostring(want)) or "",
						(bbox and e and (bbox - e.size).Magnitude > 1e-3) and (" UPLOADED BOX " .. tostring(bbox)) or ""))
				end
			end
			for k, v in pairs(f:GetAttributes()) do
				if k ~= "Sig" then
					table.insert(lines, string.format("%s.%s = %s", f.Name, k, tostring(v)))
				end
			end
		end
	end
	if doPrint then
		print("[Gear] audit of " .. tostring(model and model.Name) .. ":\n  " .. table.concat(lines, "\n  "))
	end
	return lines
end

-- true when the model shows tier parts for every piece of the style and every one of them is uploaded (no loads:
-- for colour decisions made before the gear is built, e.g. the women's top over the UpperTorso)
function BuilderGear.Available(model, group, style)
	local names = BuilderGear.SetPieces(group, style)
	if not names or #names == 0 then
		return false
	end
	local d = load()
	for _, name in ipairs(names) do
		local p = type(d.pieces) == "table" and d.pieces[name] or nil
		local tier, lite
		if p then
			local _b, _o
			tier, _b, _o, lite = pieceTier(model, p)
		end
		local e = tier and BuilderGear.Entry(tier, name, d, lite)
		if not e then
			return false
		end
		local c = cache[e.id]
		if c and c.failed and os.clock() < (c.retryAt or c.failed + BuilderGear.RETRY) then
			return false
		end
	end
	return true
end

return BuilderGear
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="50">
        <Properties>
          <string name="Name">BuilderHair</string>
          <string name="Source"><![CDATA[-- BuilderHair: the hair on the head (server side), split verbatim out of BuilderHead so the hair and
-- the head have separate owners. Behaviour is identical to the pre-split BuilderHead (proven by
-- /tmp/claude-0/tests/anatomy_foundation/run_equiv.py: identical instance dumps, mutations detected).
-- * every Looks.HairStyles id x 5 hair types (shrinkage, curl size, sheen, material), fades with
--   gradient bands and a sharp line-up, hairlines and parts, visible growth stages, Beam strands
--   (tag HairStrand) for depth, sway joints (tag HairSway) on locs/braids/long hair and a bounce
--   joint on curl clusters (CONTRACTS section 5)
-- * hidden under headgear / robe hoods (SetHairHidden / ApplyHairHidden), wet hair (Wet, from SetSweat)
-- Shares A's part budget, the face layout and the head-surface helpers with BuilderHead (Head.Shared),
-- which requires this module while it loads: BuilderHead is therefore required lazily, on first use.
-- Builder.Cosmetics runs Hair.Build after the face and before the beard; BuilderHead keeps
-- Head.Hair / Head.SetHairHidden / Head.ApplyHairHidden as forwards for older callers.
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Looks = require(Shared:WaitForChild("Looks"))
local Kit = require(script.Parent:WaitForChild("BuilderKit"))

local Hair = {}

local V3, CF, ANG, SMOOTH = Kit.V3, Kit.CF, Kit.ANG, Kit.SMOOTH
local lerpColor, darken = Kit.lerpColor, Kit.darken
local mk, getFolder, part = Kit.mk, Kit.getFolder, Kit.part
local FABRIC, SAND = Enum.Material.Fabric, Enum.Material.Sand
local clamp = math.clamp

-- BuilderHead and the helpers it shares (Head.Shared), bound on first use: BuilderHead requires this
-- module at load time, so requiring it back here at load time would be a require cycle
local Head
local lum, skinOf, joint, axisCF, surfPoint, surfCF, surfacePath, countParts, extraOf
local A_BUDGET, FACE_CAP, BEARD_RESERVE, HAIR_MAX
local function bind()
	if Head then
		return
	end
	local H = require(script.Parent:WaitForChild("BuilderHead"))
	local S = H.Shared
	lum, skinOf, joint, axisCF = S.lum, S.skinOf, S.joint, S.axisCF
	surfPoint, surfCF, surfacePath = S.surfPoint, S.surfCF, S.surfacePath
	countParts, extraOf = S.countParts, S.extraOf
	A_BUDGET, FACE_CAP, BEARD_RESERVE, HAIR_MAX = S.A_BUDGET, S.FACE_CAP, S.BEARD_RESERVE, S.HAIR_MAX
	Head = H
end

------------------------------------------------------------------------
-- Hair
------------------------------------------------------------------------
-- per hair type: shrinkage (share of the stretched length a hanging style shows), curl size,
-- sheen (Reflectance; above ~0.08 it mirrors the sky), material and sway physics
local HAIR_TYPES = {
	Straight = { shrink = 1, curl = 0, radius = 1, sheen = 0.04, mat = SMOOTH, stiff = 0.1, mass = 0.8 },
	Wavy = { shrink = 0.9, curl = 0.35, radius = 1, sheen = 0.03, mat = SMOOTH, stiff = 0.2, mass = 0.9 },
	Curly = { shrink = 0.75, curl = 0.7, radius = 1.2, sheen = 0.015, mat = FABRIC, stiff = 0.45, mass = 1 },
	Coiled = { shrink = 0.6, curl = 0.9, radius = 0.8, sheen = 0, mat = SAND, stiff = 0.7, mass = 1.2 },
	Kinky = { shrink = 0.5, curl = 1, radius = 0.65, sheen = 0, mat = SAND, stiff = 0.75, mass = 1.25 },
}
local CURLY = { Curly = true, Coiled = true, Kinky = true }
-- styles with a dedicated branch below; any other id draws Looks.HairStyleBase[id] (or Fade)
local DRAWN = {}
for _, id in ipairs({
	"Bald", "Buzz Cut", "Crew Cut", "Fade", "Low Fade", "Mid Fade", "High Fade", "Afro", "High Top", "Short Dreads",
	"Dreadlocks", "Twists", "Braids", "Cornrows", "Short Curly", "Long Curly", "Messy Hair", "Slick Back", "Undercut",
	"Mohawk", "Caesar Cut", "Long Hair", "Ponytail", "Wolf Cut", "Modern Athlete", "Taper Fade", "Textured Crop",
	"Curly Top", "Burst Fade", "360 Waves", "Box Braids",
}) do
	DRAWN[id] = true
end
local SHORT = {
	["Buzz Cut"] = 0.035, ["Crew Cut"] = 0.06, Fade = 0.08, ["Low Fade"] = 0.08, ["Mid Fade"] = 0.08, ["High Fade"] = 0.09,
	["Caesar Cut"] = 0.06, ["Modern Athlete"] = 0.08, ["Taper Fade"] = 0.08, ["Textured Crop"] = 0.07, ["360 Waves"] = 0.03,
}

-- lower bound on the part count of the pre-overhaul hair (the CONTRACTS 16 B budget baseline), from
-- the old builder's own counts; a style it did not have counts as its Looks.HairStyleBase style
local OLD_SHORT = {
	["Buzz Cut"] = 1, ["Crew Cut"] = 2, Fade = 2, ["Low Fade"] = 2, ["Mid Fade"] = 2, ["High Fade"] = 2,
	["Caesar Cut"] = 2, ["Modern Athlete"] = 9,
}
local function oldHairParts(hair, style)
	style = Looks.HairStyleBase[style] or style
	local d = clamp(tonumber(hair.density) or 0.7, 0, 1)
	local L = clamp((tonumber(hair.length) or 0.5) + (tonumber(hair.growth) or 0) * 0.6, 0, 1.5)
	local htype = hair.type or "Straight"
	local floor = math.floor
	-- the old top texture: curl bumps on curly types, four wave bands on wavy hair
	local function tex(count)
		return CURLY[htype] and floor(count * (0.5 + d)) or (htype == "Wavy" and 4 or 0)
	end
	if style == "Bald" then
		return 0
	elseif OLD_SHORT[style] then
		return OLD_SHORT[style] + tex(18)
	elseif style == "Afro" then
		return 2 + floor(floor(34 * (0.5 + d)) * 0.94) -- a few curls were skipped in front of the face
	elseif style == "High Top" then
		return 2
	elseif style == "Mohawk" then
		return 7
	elseif style == "Slick Back" then
		return 6 + (L > 0.6 and 2 or 0)
	elseif style == "Undercut" then
		return 7 + tex(10)
	elseif style == "Messy Hair" then
		return 1 + floor(10 + d * 10)
	elseif style == "Cornrows" then
		local rows = 5 + floor(d * 3)
		return 1 + rows * 4 + (L > 0.45 and floor(rows / 2) * 2 or 0)
	elseif style == "Dreadlocks" or style == "Twists" or style == "Braids" then
		local n = floor(8 + d * 12)
		local segs = style == "Twists" and 1 or (L > 0.7 and 3 or 2)
		return 1 + floor(n * 0.75) * segs + floor(n / 2) * 2
	elseif style == "Short Dreads" then
		return 47 + floor(23 * d)
	elseif style == "Short Curly" then
		return 1 + floor(28 * (0.6 + d))
	elseif style == "Long Curly" then
		return 2 + floor(26 * (0.6 + d)) + floor(6 + d * 6) * (L > 0.6 and 3 or 2)
	elseif style == "Long Hair" then
		return 2 + 3 * (L > 0.75 and 3 or 2) + tex(12)
	elseif style == "Wolf Cut" then
		return 19 + tex(12)
	elseif style == "Ponytail" then
		return 3 + (L > 0.6 and 4 or 3)
	end
	return 1 + tex(14)
end

local function hairPalette(hair)
	local base = Looks.Color(hair.color, Color3.fromRGB(25, 20, 18))
	local alt = Looks.Color(hair.hcolor, Color3.fromRGB(200, 160, 90))
	local dye = hair.dye or "None"
	return function(index, t, x)
		if dye == "Tips" then
			return t > 0.62 and alt or base
		elseif dye == "Ombre" then
			return lerpColor(base, alt, t)
		elseif dye == "Streaks" then
			return (index % 3 == 0) and alt or base
		elseif dye == "Split" then
			return (x or 0) > 0 and alt or base
		elseif hair.hl then
			return (index % 4 == 0) and lerpColor(base, alt, 0.75) or base
		end
		return base
	end
end

local function hairMaterial(htype)
	return (HAIR_TYPES[htype] or HAIR_TYPES.Straight).mat
end

-- detail-dependent count: full, medium, low
local function lod(H, full, medium, low)
	if H.detail == "full" then
		return full
	elseif H.detail == "medium" then
		return medium
	end
	return low
end

local function hpart(H, name, size, localCF, color, shape, material, transparency, anchor)
	return mk(H.folder, anchor or H.head, name, size, H.hcf * localCF, color, shape or "Ellipsoid", material or H.mat, transparency)
end

-- a decoration part (curl, tuft, wave band...) queued until the cut's structure exists; hairBuild then
-- draws as many as the part budget leaves room for, in queue order. The material is resolved now
-- (styles swap H.mat around their curl clusters).
local function later(H, name, size, localCF, color, shape, material, transparency, anchor)
	local mat = material or H.mat
	H.deco[#H.deco + 1] = function()
		hpart(H, name, size, localCF, color, shape, mat, transparency, anchor)
	end
end

-- parts the cut may still add before reaching its cap (structural choices that scale use this); one
-- part stays reserved for the strand anchor until it exists (strands themselves cost no parts)
local function room(H, reserve)
	local anchor = (H.anchor or H.maxStrands <= 0) and 0 or 1
	return H.cap - countParts(H.folder) - (reserve or 0) - anchor
end

-- invisible part that carries every strand attachment (never parented to the Head: getFolder's
-- destroy must clean them up on each rebuild)
local function strandAnchor(H)
	if not H.anchor then
		H.anchor = mk(H.folder, H.head, "StrandAnchor", V3(0.05, 0.05, 0.05), H.hcf, H.base, "Block", SMOOTH, 1)
	end
	return H.anchor
end

-- one Beam strand cluster from p0 (leaving along d0) to p1 (arriving along d1), head-local
local function strand(H, p0, d0, p1, d1, width, curve, idx, t0, t1, depth, transparency)
	if H.strands >= H.maxStrands then
		return nil
	end
	H.strands += 1
	local anchor = strandAnchor(H)
	local a0 = Instance.new("Attachment")
	a0.Name = "StrandRoot"
	a0.CFrame = axisCF(p0, d0)
	a0.Parent = anchor
	local a1 = Instance.new("Attachment")
	a1.Name = "StrandTip"
	a1.CFrame = axisCF(p1, d1)
	a1.Parent = anchor
	local len = (p1 - p0).Magnitude
	local c0 = darken(H.colorFn(idx, t0 or 0, p0.X), 0.82) -- roots read darker: depth
	local c1 = H.colorFn(idx, t1 or 1, p1.X)
	local b = Instance.new("Beam")
	b.Name = "Strand"
	b.Attachment0 = a0
	b.Attachment1 = a1
	b.CurveSize0 = len * curve
	b.CurveSize1 = len * curve
	b.Width0 = width
	b.Width1 = width * 0.3
	b.Segments = H.detail == "full" and 8 or 4
	b.FaceCamera = true
	b.LightInfluence = 1
	b.Color = ColorSequence.new(c0, c1)
	b.Transparency = NumberSequence.new(transparency or 0.05, math.min(1, (transparency or 0.05) + 0.35))
	b:SetAttribute("BaseCurve0", b.CurveSize0)
	b:SetAttribute("BaseCurve1", b.CurveSize1)
	b:SetAttribute("Depth", depth or 1)
	b:SetAttribute("DryColor0", c0)
	b:SetAttribute("DryColor1", c1)
	b.Parent = anchor
	CollectionService:AddTag(b, "HairStrand")
	return b
end

-- point on the current hair shell (H.capC / H.capR, head-local): polar angle th from the crown
-- (0 = top), azimuth ph (0 = back, pi = front, +pi/2 = the character's right)
local function shellDir(th, ph)
	return V3(math.sin(th) * math.sin(ph), math.cos(th), math.sin(th) * math.cos(ph))
end
local function shellPoint(H, th, ph, out)
	local d = shellDir(th, ph)
	local r = H.capR
	return H.capC + V3(d.X * (r.X + out), d.Y * (r.Y + out), d.Z * (r.Z + out))
end

-- strands lying along the shell from (th0, ph0) to (th1, ph1)
local function shellStrand(H, th0, ph0, th1, ph1, width, lift, idx, curl)
	local p0 = shellPoint(H, th0, ph0, 0.004)
	local p1 = shellPoint(H, th1, ph1, 0.004 + lift)
	-- tangents: the direction of travel, bent outward a touch so the strand arcs over the shell
	local mid = shellPoint(H, (th0 + th1) / 2, (ph0 + ph1) / 2, 0.01 + lift)
	local d0 = (mid - p0)
	local d1 = (p1 - mid)
	return strand(H, p0, d0, p1, d1, width, 0.33 + 0.25 * (curl or 0), idx, 0, 1, 1)
end

-- loose flyaway strands over a short or medium cut (straight / wavy) or curl loops (curly types)
local function flyaways(H, count, len, yMinTh, yMaxTh)
	if not H.capC then
		return
	end
	local rng = Random.new(H.seed + 41)
	local w = (0.025 + 0.025 * H.thick) * H.s.X
	for i = 1, count do
		local th = rng:NextNumber(yMinTh or 0.15, yMaxTh or 1.2)
		local ph = rng:NextNumber(-2.4, 2.4)
		local dth = len * (0.6 + 0.6 * rng:NextNumber())
		if CURLY[H.htype] then
			-- a springy loop that stands off the shell
			local p0 = shellPoint(H, th, ph, 0.004)
			local p1 = shellPoint(H, th + dth * 0.4, ph + rng:NextNumber(-0.3, 0.3), 0.03 + 0.03 * H.T.curl)
			local out = (p0 - H.capC).Unit
			strand(H, p0, out, p1, -out, w * 0.8, 0.6 + 0.6 * H.T.curl, i, 0.3, 0.8, 1)
		else
			shellStrand(H, th, ph, th + dth, ph + rng:NextNumber(-0.15, 0.15) + (H.htype == "Wavy" and (i % 2 == 0 and 0.12 or -0.12) or 0), w, 0.01, i, H.T.curl)
		end
	end
end

-- point on the hair shell in a front-to-back sweep: f = sideways (-1 .. 1, the character's left to
-- right), psi = 0 on top, negative toward the face, positive toward the nape
local function combPoint(H, f, psi, out)
	local d = V3(f, math.cos(psi), math.sin(psi)).Unit
	local r = H.capR
	return H.capC + V3(d.X * (r.X + out), d.Y * (r.Y + out), d.Z * (r.Z + out))
end

-- point on the front hairline (the forehead surface), dipping toward the temples
local function hairlinePoint(H, x, out)
	local k = x / (0.38 * H.s.X)
	return surfPoint(H.Lay, x, H.hlY - 0.16 * H.s.Y * k * k, out)
end

-- strips between consecutive head-local points lying on the hair (parts, box partings)
local function pathLine(H, name, points, width, color, transparency)
	for i = 1, #points - 1 do
		local p0, p1 = points[i], points[i + 1]
		local dir = p1 - p0
		if dir.Magnitude > 1e-3 then
			local pm = (p0 + p1) / 2
			local n = (pm - (H.capC or V3())).Unit
			hpart(H, name, V3(width, 0.012 * H.s.Y, dir.Magnitude + width * 0.5), CFrame.lookAt(pm, pm + dir, n), color, "Ellipsoid", SMOOTH, transparency)
		end
	end
end

-- combed lines from the front hairline back over the crown (slick back, undercut, long hair):
-- two beziers per line (hairline -> crown, crown -> nape), one cannot follow half the shell
local function combLines(H, count, spread, back, width, sweep)
	if not H.capC then
		return
	end
	local rng = Random.new(H.seed + 57)
	sweep = sweep or 0
	for i = 1, count do
		local f = (count == 1 and 0 or (i - 1) / (count - 1) - 0.5) * 2 * spread
		local p0 = hairlinePoint(H, f * 0.38 * H.s.X, 0.012)
		local p1 = combPoint(H, f * 0.55 + sweep, -0.1 + rng:NextNumber(-0.08, 0.08), 0.006)
		strand(H, p0, (p1 - p0) + V3(0, 0.25 * H.s.Y, 0), p1, V3(sweep, -0.15, 1), width, 0.35, i, 0, back and 0.5 or 1, 1)
		if back then
			local p2 = combPoint(H, f * 0.7 + sweep, back, 0.006)
			strand(H, p1, V3(sweep, -0.15, 1), p2, V3(0, -math.sin(back), math.cos(back)), width, 0.35, i, 0.5, 1, 1)
		end
	end
end

-- a swinging chain of segments (dreads, braids, long hair, ponytail); stiff / mass feed the
-- client's spring (CONTRACTS section 5)
local function chain(H, startLocal, dir, segs, segLen, width, depth, idx, htype, beads, stiff, mass)
	local folder, head, colorFn = H.folder, H.head, H.colorFn
	local parent = head
	local jointWorld = head.CFrame * CF(startLocal)
	local look = head.CFrame:VectorToWorldSpace((dir.Magnitude > 0.01) and dir.Unit or V3(0, -1, 0))
	local mat = hairMaterial(htype)
	local T = HAIR_TYPES[htype] or HAIR_TYPES.Straight
	for i = 1, segs do
		local t = i / segs
		local color = colorFn(idx, t, startLocal.X)
		-- frame whose -Y axis points along the hanging direction
		local orient = CFrame.lookAt(jointWorld.Position, jointWorld.Position + look) * ANG(math.rad(90), 0, 0)
		local segCF = orient * CF(0, -segLen / 2, 0)
		local p
		local w = width * (1 - 0.18 * t)
		if CURLY[htype] or beads then
			p = mk(folder, nil, "HairSeg", V3(w * 1.1, segLen, w * 1.1), segCF, color, "Ellipsoid", mat)
		elseif htype == "Wavy" then
			-- soft rounded locks (an ellipsoid a little longer than the segment overlaps its neighbours: no
			-- gaps, no box corners)
			p = mk(folder, nil, "HairSeg", V3(w * 1.12, segLen * 1.28, depth * 1.15), segCF * ANG(0, 0, math.rad((i % 2 == 0) and 7 or -7)), color, "Ellipsoid", mat)
		else
			p = mk(folder, nil, "HairSeg", V3(w * 1.12, segLen * 1.28, depth * 1.15), segCF, color, "Ellipsoid", mat)
		end
		local m = Instance.new("Motor6D")
		m.Name = "HairJoint"
		m.Part0 = parent
		m.Part1 = p
		m.C0 = parent.CFrame:Inverse() * orient
		m.C1 = p.CFrame:Inverse() * orient
		m:SetAttribute("Depth", i)
		m:SetAttribute("Stiff", stiff or T.stiff)
		m:SetAttribute("Mass", mass or T.mass)
		m.Parent = p
		CollectionService:AddTag(m, "HairSway")
		parent = p
		jointWorld = orient * CF(0, -segLen, 0)
		look = (look + V3(0, -0.6, 0)).Unit -- gravity pulls lower segments down
	end
end

-- curl clusters ride on one pivot with a bounce joint so the client can jiggle them as a mass
local function bouncePivot(H, localPos)
	if H.detail == "low" then
		return H.head
	end
	local p = mk(H.folder, nil, "BouncePivot", V3(0.05, 0.05, 0.05), H.hcf * CF(localPos), H.base, "Block", SMOOTH, 1)
	local m = joint(H.head, p, "HairBounce")
	m:SetAttribute("Depth", 1)
	m:SetAttribute("Bounce", true)
	m:SetAttribute("Stiff", H.T.stiff)
	m:SetAttribute("Mass", 1.4)
	CollectionService:AddTag(m, "HairSway")
	return p
end

local function bumps(H, count, radius, yMin, seed, anchor)
	local s = H.s
	local rng = Random.new(seed)
	count = math.min(count, H.D.hairBumps or count)
	for i = 1, count do
		local a = rng:NextNumber(0, math.pi * 2)
		local yN = rng:NextNumber(yMin, 0.98)
		local ring = math.sqrt(math.max(0, 1 - yN * yN))
		local x = math.cos(a) * ring * 0.55 * s.X
		local z = math.sin(a) * ring * 0.55 * s.Z
		if z < -0.3 * s.Z and yN < 0.45 then
			z = math.abs(z) -- keep the forehead clear
		end
		local y = 0.18 * s.Y + yN * 0.42 * s.Y
		local r = radius * rng:NextNumber(0.8, 1.25)
		later(H, "Curl", V3(r, r, r), CF(x, y, z), H.colorFn(i, yN, x), "Ball", H.mat, nil, anchor)
	end
end

-- tiny coil strands breaking up the silhouette of a curl cluster
local function coilHalo(H, count, center, radii, seed)
	local rng = Random.new(seed)
	local w = (0.018 + 0.012 * H.thick) * H.s.X
	for i = 1, count do
		local th = rng:NextNumber(0.1, 1.5)
		local ph = rng:NextNumber(-2.6, 2.6)
		local d = shellDir(th, ph)
		local p0 = center + V3(d.X * radii.X, d.Y * radii.Y, d.Z * radii.Z)
		local p1 = p0 + d * (0.03 + 0.04 * H.T.curl) * H.s.X + V3(rng:NextNumber(-0.02, 0.02), 0, rng:NextNumber(-0.02, 0.02))
		strand(H, p0, d + V3(0, 0.5, 0), p1, -d + V3(0, 0.3, 0), w, 1.1, i, 0.4, 0.9, 1)
	end
end

local function hairBuild(model, app, opts)
	bind()
	opts = opts or {}
	app = app or {}
	if Config.BaldMode then
		-- debug kill-switch: every boxer is bald
		local look = model:FindFirstChild("BoxerLook")
		local old = look and look:FindFirstChild("Hair")
		if old then
			old:Destroy()
		end
		return
	end
	local head = model:FindFirstChild("Head")
	if not head then
		return
	end
	local folder = getFolder(model, "Hair")
	if model:GetAttribute("AvatarHair") == true then
		-- the player's avatar hair (accessories the engine attached from the description) replaces the game's:
		-- an empty folder (it seals the step's cache; the beard reads Extra 0)
		folder:SetAttribute("Avatar", true)
		folder:SetAttribute("Extra", 0)
		Hair.ApplyHairHidden(model)
		return
	end
	local hair = app.hair or Looks.Defaults(app.gender).hair
	local style = hair.style or "Fade"
	if not DRAWN[style] then
		style = Looks.HairStyleBase[style] or "Fade"
		if not DRAWN[style] then
			style = "Fade"
		end
	end
	local detail, D = Config.DetailLevel(opts)
	local htype = HAIR_TYPES[hair.type] and hair.type or "Straight"
	local T = HAIR_TYPES[htype]
	local growth = clamp(tonumber(opts.previewGrowth) or tonumber(hair.growth) or 0, 0, 1.5)
	local s = head.Size
	local H = {
		folder = folder, head = head, s = s, hcf = head.CFrame, hair = hair, htype = htype, T = T, mat = T.mat,
		colorFn = hairPalette(hair), detail = detail, D = D, growth = growth,
		density = hair.density or 0.7, thick = hair.thickness or 0.5,
		seed = app.face and app.face.seed or 7, fore = app.face and app.face.forehead or 0,
		recede = hair.hairline == "Receding" and 1 or 0,
		strands = 0, maxStrands = D.strands or 0, skin = skinOf(app), deco = {},
	}
	-- part cap: the old hair's count plus what is left of A's budget after the face (already built)
	-- and a reserve for the beard (built after the hair)
	local faceExtra = extraOf(model, "Face", FACE_CAP[detail])
	H.cap = math.min(HAIR_MAX[detail], oldHairParts(hair, style) + A_BUDGET[detail] - faceExtra - BEARD_RESERVE[detail])
	H.base = H.colorFn(1, 0, 0)
	H.Lay = Head.FaceLayout(head, app.face or {})
	H.hlY = (0.37 + 0.03 * H.fore + 0.06 * H.recede) * s.Y
	local base, skin, mat, colorFn = H.base, H.skin, H.mat, H.colorFn
	local L = clamp((hair.length or 0.5) + growth * 0.6, 0, 1.5)
	local hang = L * T.shrink -- curly hair springs up: hanging styles show less of their length
	local density, thick = H.density, H.thick
	local grow = clamp(growth / 0.5, 0, 1) -- 0 fresh cut .. 1 grown out
	local fore = H.fore
	folder:SetAttribute("Detail", detail)
	folder:SetAttribute("Style", style)
	local function at(x, y, z)
		return CF(x, y, z)
	end
	local function add(name, size, cf, color, shape, material, transparency, anchor)
		return hpart(H, name, size, cf, color, shape, material, transparency, anchor)
	end
	local function setShell(c, size)
		H.capC, H.capR = c, size / 2
	end

	-- snug hair shell: covers the crown, sides and back with the hairline above the forehead
	local function cap(t, backDrop, transparency)
		local lift = 0.03 * fore + 0.04 * H.recede
		local c = V3(0, (0.16 + lift) * s.Y, (0.12 + 0.06 * H.recede) * s.Z)
		local size = V3(s.X * (1.04 + t * 0.7), s.Y * (0.9 + t * 1.2), s.Z * (0.98 + t * 0.7))
		local p = add("HairCap", size, CF(c), base, "Ellipsoid", mat, transparency)
		setShell(c, size)
		if backDrop and backDrop > 0 then
			add("HairBack", V3(s.X * 1.0, s.Y * (0.5 + backDrop), s.Z * 0.62), at(0, (-0.02 - backDrop * 0.35) * s.Y, 0.24 * s.Z), base, "Ellipsoid", mat)
		end
		return p
	end
	-- short top with gradient faded sides: each lower band hugs the head tighter and shows more
	-- scalp; level 0 = low fade .. 1 = high fade, k = how much skin shows at the bottom
	local function fadeCut(t, level, k)
		k *= 1 - 0.8 * grow -- the sides grow back in
		local lift = 0.03 * fore + 0.04 * H.recede
		local c = V3(0, (0.24 + level * 0.06 + lift) * s.Y, (0.1 + 0.05 * H.recede) * s.Z)
		local size = V3(s.X * (0.98 + t), s.Y * (0.66 + t - level * 0.1), s.Z * (0.96 + t))
		add("HairTop", size, CF(c), base, "Ellipsoid", mat)
		setShell(c, size)
		-- medium keeps the old two-tone cut (top + sides): the bands only read up close
		local bands = lod(H, 3, 1, 1)
		for i = 1, bands do
			local f = bands == 1 and 1 or (i - 1) / (bands - 1)
			local shade = k * (0.3 + 0.7 * f)
			local band = add(i == 1 and "FadeSides" or ("FadeBand" .. i), V3(s.X * (1.035 - 0.008 * (i - 1)), s.Y * (0.6 - level * 0.12) * (1 - 0.1 * (i - 1)), s.Z * (0.93 - 0.01 * (i - 1))),
				at(0, (0.08 + level * 0.05 - 0.075 * (i - 1)) * s.Y, 0.16 * s.Z), lerpColor(base, skin, shade), "Ellipsoid", i == 1 and mat or SMOOTH, (i == bands and k > 0.5) and 0.25 or 0)
			band:SetAttribute("Fade", i)
		end
	end
	-- top texture by hair type
	local function texture(count, radius, anchor)
		if CURLY[htype] then
			local r = radius * T.radius
			bumps(H, math.min(math.floor(count * (0.5 + density)), lod(H, 24, 8, 4)), r * s.X * (0.8 + 0.4 * thick), 0.25, H.seed + 3, anchor)
		elseif htype == "Wavy" and H.detail ~= "low" then
			for i = 1, 4 do
				later(H, "Wave", V3(s.X * 0.9, 0.025 * s.Y, 0.12 * s.Z), at(0, (0.3 + i * 0.045) * s.Y, (-0.35 + i * 0.16) * s.Z) * ANG(math.rad(-20 + i * 10), 0, 0), darken(base, 0.85), "Ellipsoid", mat)
			end
		end
	end
	-- hairline shape, visible part, crisp line-up while the cut is fresh. The front band lies on the
	-- forehead up to where the shell takes over, so every cut has a defined hairline.
	local hlY = H.hlY
	local function hairline(shaved, frontTransparency)
		local Lay = H.Lay
		local kind = hair.hairline or "Natural"
		local sx = s.X
		if frontTransparency ~= false then
			local segs = lod(H, 4, 2, 1)
			if segs > 1 and room(H) < 2 * segs then
				segs = 1 -- a tight budget: one strip still marks the hairline
			end
			local pts = {}
			for i = 0, segs do
				local x = (-0.34 + 0.68 * i / segs) * sx
				local k = x / (0.38 * sx)
				pts[i + 1] = { x, hlY + 0.06 * s.Y - 0.12 * s.Y * k * k }
			end
			surfacePath(H.folder, head, head, Lay, "HairFront", pts, 0.14 * s.Y, 0.022 * s.Z, base, frontTransparency or 0, 0.006, mat)
		end
		if kind == "Widow's Peak" then
			add("WidowsPeak", V3(0.08 * sx, 0.08 * sx, 0.03 * s.Z), surfCF(Lay, 0, hlY - 0.02 * s.Y, 0.008) * ANG(0, 0, math.rad(45)), base, "Ellipsoid", mat)
		elseif kind == "Straight" and H.detail ~= "low" and room(H) >= 2 then
			surfacePath(H.folder, head, head, Lay, "HairlineEdge", { { -0.28 * sx, hlY - 0.005 * s.Y }, { 0, hlY - 0.012 * s.Y }, { 0.28 * sx, hlY - 0.005 * s.Y } }, 0.045 * s.Y, 0.03 * s.Z, base, 0, 0.01, mat)
		end
		-- the line-up: barber-sharp edges at the hairline, temple corners and sideburns (gone in ~2 weeks)
		if (kind == "Line-Up" or (shaved and kind == "Straight")) and growth < 0.35 and H.detail == "full" and room(H) >= 8 then
			local edge = lerpColor(darken(base, 0.7), base, growth * 2)
			local y0 = hlY - 0.015 * s.Y
			for side = -1, 1, 2 do
				surfacePath(H.folder, head, head, Lay, "LineUp", {
					{ 0, y0 }, { side * 0.13 * sx, y0 }, { side * 0.26 * sx, y0 - 0.004 * s.Y }, { side * 0.36 * sx, y0 - 0.13 * s.Y },
				}, 0.022 * s.Y, 0.02 * s.Z, edge, 0, 0.012)
				add("Sideburn", V3(0.03 * sx, 0.24 * s.Y, 0.09 * s.Z), at(side * 0.5 * sx, 0.06 * s.Y, -0.1 * s.Z), lerpColor(base, skin, 0.15), "Ellipsoid", SMOOTH)
			end
		end
		-- a part: a clean shaved line on short cuts, the scalp showing through on longer hair
		local p = hair.part or "None"
		if p ~= "None" and H.capC and H.detail == "full" and room(H) >= 2 then
			local f = p == "Left" and -0.32 or (p == "Right" and 0.32 or 0)
			local col = lerpColor(base, skin, shaved and 0.75 or 0.45)
			pathLine(H, "HairPart", { hairlinePoint(H, f * 0.5 * sx, 0.016), combPoint(H, f, -0.45, 0.005), combPoint(H, f * 0.95, 0.1, 0.005) },
				(shaved and 0.02 or 0.013) * sx, col, 0)
		end
	end
	-- growth stages: hair creeps down the nape and over the ears as a cut grows out
	local function grownOut()
		if growth > 0.6 and H.detail ~= "low" and room(H) >= 1 then
			add("Nape", V3(0.78 * s.X, (0.16 + 0.12 * grow) * s.Y, 0.3 * s.Z), at(0, -0.12 * s.Y, 0.42 * s.Z), lerpColor(base, skin, 0.15), "Ellipsoid", mat)
			if growth > 0.9 and room(H) >= 2 then
				for side = -1, 1, 2 do
					add("EarTuft", V3(0.08 * s.X, 0.12 * s.Y, 0.18 * s.Z), at(side * 0.5 * s.X, 0.16 * s.Y, 0.08 * s.Z), base, "Ellipsoid", mat)
				end
			end
		end
	end

	if style == "Bald" then
		-- a shaved head grows back in as a shadow
		if growth > 0.05 then
			cap(0.01, nil, clamp(0.93 - 0.4 * growth, 0.4, 0.93)).Name = "Regrowth"
		end
	elseif SHORT[style] then
		local t = SHORT[style] + L * 0.05
		local shaved = true
		local frontT = nil
		if style == "Fade" or style == "Mid Fade" then
			fadeCut(t, 0.5, 0.45)
		elseif style == "Low Fade" then
			fadeCut(t, 0, 0.3)
		elseif style == "High Fade" then
			fadeCut(t, 1, 0.65)
		elseif style == "Taper Fade" then
			-- the fade only tapers at the sideburns and the nape
			fadeCut(t, 0.15, 0.25)
			if H.detail ~= "low" and room(H, lod(H, 5, 3, 2)) >= 1 then
				add("NapeTaper", V3(0.8 * s.X, 0.22 * s.Y, 0.3 * s.Z), at(0, -0.08 * s.Y, 0.42 * s.Z), lerpColor(base, skin, 0.7 * (1 - 0.8 * grow)), "Ellipsoid", SMOOTH)
				if H.detail == "full" or room(H, 3) >= 2 then
					for side = -1, 1, 2 do
						add("SideburnTaper", V3(0.05 * s.X, 0.2 * s.Y, 0.12 * s.Z), at(side * 0.5 * s.X, 0.02 * s.Y, -0.06 * s.Z), lerpColor(base, skin, 0.5 * (1 - 0.8 * grow)), "Ellipsoid", SMOOTH)
					end
				end
			end
		elseif style == "Buzz Cut" or style == "360 Waves" then
			-- clipper-short: the scalp shows through until it grows in
			frontT = clamp(0.3 - 0.25 * grow, 0.02, 0.3)
			local p = cap(t, nil, frontT)
			if style == "360 Waves" then
				-- brushed waves: concentric rings around the crown whorl, with a soft sheen
				p.Material = SMOOTH
				p.Reflectance = 0.03
				-- the whorl sits on the crown, behind the top of the head
				local tilt = 0.4
				local function wave(th, ph)
					local d = shellDir(th, ph)
					d = V3(d.X, d.Y * math.cos(tilt) - d.Z * math.sin(tilt), d.Y * math.sin(tilt) + d.Z * math.cos(tilt))
					local r = H.capR
					return H.capC + V3(d.X * (r.X + 0.004), d.Y * (r.Y + 0.004), d.Z * (r.Z + 0.004))
				end
				for r = 1, lod(H, 5, 3, 0) do
					local th = 0.16 + 0.19 * r
					for q = 0, 3 do
						local ph0, ph1 = q * math.pi / 2 + r * 0.3, (q + 1) * math.pi / 2 + r * 0.3
						local p0, p1 = wave(th, ph0), wave(th, ph1)
						strand(H, p0, wave(th, ph0 + 0.05) - p0, p1, p1 - wave(th, ph1 - 0.05), 0.026 * s.X, 0.3, r, 0.3, 0.3, 1, 0.15)
					end
				end
			end
		elseif style == "Caesar Cut" then
			cap(t)
			-- short, straight-cut fringe brushed forward at the hairline
			add("Fringe", V3(s.X * 0.62, 0.05 * s.Y, 0.12 * s.Z), at(0, 0.41 * s.Y, -0.43 * s.Z), base, "Ellipsoid", mat)
			shaved = false
		elseif style == "Modern Athlete" then
			fadeCut(t, 0.7, 0.55)
			for i = 1, lod(H, 7, 4, 2) do
				local x = (i - 4) * 0.12 * s.X
				later(H, "Texture", V3(0.13 * s.X, (0.09 + L * 0.06) * s.Y, 0.5 * s.Z), at(x, 0.55 * s.Y, -0.05 * s.Z) * ANG(math.rad(-10), 0, math.rad((i % 2 == 0) and 6 or -6)),
					colorFn(i, 0.2, x), "Ellipsoid", mat)
			end
		elseif style == "Textured Crop" then
			-- choppy top pushed forward to a blunt fringe over mid fade sides
			fadeCut(t, 0.6, 0.5)
			add("CropFringe", V3(s.X * 0.6, (0.06 + 0.03 * L) * s.Y, 0.14 * s.Z), at(0, 0.39 * s.Y, -0.42 * s.Z) * ANG(math.rad(-12), 0, 0), base, "Ellipsoid", mat)
			local rng = Random.new(H.seed + 61)
			for i = 1, lod(H, 10, 5, 3) do
				local x = rng:NextNumber(-0.3, 0.3) * s.X
				local z = rng:NextNumber(-0.38, 0.15) * s.Z
				later(H, "Tuft", V3(0.11 * s.X, (0.1 + 0.06 * L) * s.Y, 0.12 * s.Z), at(x, (0.55 - 0.15 * (z / s.Z + 0.38) * 0.4) * s.Y, z) * ANG(rng:NextNumber(-0.9, -0.4), rng:NextNumber(-0.4, 0.4), rng:NextNumber(-0.3, 0.3)),
					colorFn(i, 0.3, x), "Ellipsoid", mat)
			end
			shaved = false
		else -- Crew Cut
			cap(t)
			add("CrewTop", V3(s.X * 0.8, (0.12 + L * 0.06) * s.Y, s.Z * 0.6), at(0, 0.55 * s.Y, -0.12 * s.Z), base, "Ellipsoid", mat)
		end
		if style ~= "360 Waves" then
			texture(18, 0.08)
		end
		hairline(shaved, frontT)
		grownOut()
		if not CURLY[htype] and style ~= "Buzz Cut" and style ~= "360 Waves" then
			flyaways(H, lod(H, 14, 6, 0), 0.35 + 0.3 * L, 0.1, 0.9)
		end
	elseif style == "Burst Fade" then
		-- fade bursts in a half circle around each ear; full hair stays at the back and on top
		cap(0.07 + L * 0.04)
		local k = 0.75 * (1 - 0.8 * grow)
		for side = -1, 1, 2 do
			add("Burst", V3(0.14 * s.X, 0.5 * s.Y, 0.6 * s.Z), at(side * 0.5 * s.X, 0.02 * s.Y, 0.04 * s.Z), lerpColor(base, skin, k * 0.55), "Ellipsoid", SMOOTH)
			if H.detail ~= "low" and room(H, lod(H, 5, 3, 2)) >= 1 then
				add("BurstSkin", V3(0.1 * s.X, 0.34 * s.Y, 0.42 * s.Z), at(side * 0.53 * s.X, -0.02 * s.Y, 0.04 * s.Z), lerpColor(base, skin, k), "Ellipsoid", SMOOTH, 0.15)
			end
		end
		if CURLY[htype] then
			local pivot = bouncePivot(H, V3(0, 0.4 * s.Y, 0))
			bumps(H, math.floor(lod(H, 26, 14, 8) * (0.6 + 0.5 * density)), (0.1 + 0.05 * thick) * T.radius * s.X, 0.5, H.seed + 13, pivot)
			coilHalo(H, lod(H, 10, 4, 0), V3(0, 0.3 * s.Y, 0.08 * s.Z), V3(0.5 * s.X, 0.42 * s.Y, 0.5 * s.Z), H.seed + 14)
		else
			add("BurstTop", V3(s.X * 0.7, (0.16 + 0.1 * L) * s.Y, s.Z * 0.8), at(0, 0.54 * s.Y, -0.02 * s.Z), base, "Ellipsoid", mat)
			flyaways(H, lod(H, 12, 5, 0), 0.4 + 0.3 * L, 0.1, 0.8)
		end
		hairline(true)
		grownOut()
	elseif style == "Curly Top" then
		-- tight high-fade sides under a crown of springy curls
		fadeCut(0.06, 0.8, 0.6)
		local htex = CURLY[htype] and htype or "Curly"
		local TT = HAIR_TYPES[htex]
		local pivot = bouncePivot(H, V3(0, 0.45 * s.Y, 0))
		local oldMat = H.mat
		H.mat = TT.mat
		bumps(H, math.floor(lod(H, 30, 10, 6) * (0.6 + 0.5 * density)), (0.1 + 0.05 * thick + 0.04 * L * TT.shrink) * TT.radius * s.X, 0.55, H.seed + 23, pivot)
		H.mat = oldMat
		coilHalo(H, lod(H, 14, 5, 0), V3(0, 0.36 * s.Y, 0.06 * s.Z), V3(0.46 * s.X, 0.36 * s.Y, 0.46 * s.Z), H.seed + 24)
		hairline(true)
		grownOut()
	elseif style == "Afro" then
		-- a big round crown that sits above and behind the hairline, leaving the face clear;
		-- tighter coils shrink more, so the same length makes a denser, rounder shape
		local htex = CURLY[htype] and htype or "Kinky"
		local TT = HAIR_TYPES[htex]
		-- (a little smaller than it was: the part-built afro read as a helmet twice the head's size)
		local size = 1.12 + 0.46 * L * (0.5 + 0.5 * TT.shrink)
		local hm = TT.mat
		local hx, hy, hz = 0.5 * size * s.X, 0.425 * size * s.Y, 0.475 * size * s.Z
		local cy = 0.3 * s.Y + 0.4 * hy -- the front edge meets the hairline at 0.3 of the head height
		local cz = -0.48 * s.Z + 0.9165 * hz
		local pivot = bouncePivot(H, V3(0, 0.3 * s.Y, 0.05 * s.Z))
		add("Afro", V3(hx * 2, hy * 2, hz * 2), at(0, cy, cz), base, "Ellipsoid", hm, nil, pivot)
		cap(0.06)
		setShell(V3(0, cy, cz), V3(hx * 2, hy * 2, hz * 2))
		local rng = Random.new(H.seed + 11)
		local n = math.min(math.floor(34 * (0.5 + density) * (htex == "Curly" and 0.8 or 1.1)), lod(H, 40, D.hairBumps or 18, D.hairBumps or 10))
		for i = 1, n do
			local u = rng:NextNumber(-0.45, 1)
			local a = rng:NextNumber(0, math.pi * 2)
			local ring = math.sqrt(1 - u * u)
			-- curls sunk into the mass (a low, lumpy outline instead of balls stuck on a sphere)
			local px, py, pz = math.cos(a) * ring * hx * 0.9, cy + u * hy * 0.9, cz + math.sin(a) * ring * hz * 0.9
			if not (pz < -0.2 * s.Z and py < 0.34 * s.Y) then
				local r = (0.15 + 0.05 * thick) * s.X * rng:NextNumber(0.8, 1.25) * (0.7 + 0.3 * TT.radius)
				later(H, "Curl", V3(r, r, r), at(px, py, pz), colorFn(i, (u + 1) / 2, px), "Ball", hm, nil, pivot)
			end
		end
		coilHalo(H, lod(H, 18, 6, 0), V3(0, cy, cz), V3(hx, hy, hz), H.seed + 12)
		hairline(false)
	elseif style == "High Top" then
		local hgt = 0.5 + 0.55 * L * (0.6 + 0.4 * T.shrink)
		local hm = hairMaterial(CURLY[htype] and htype or "Kinky")
		local pivot = bouncePivot(H, V3(0, 0.45 * s.Y, 0))
		-- a round column (a cylinder standing up, the flat top a high top has) instead of a box, with a
		-- domed rim so the top edge is not a hard ring
		add("HighTop", V3(s.Y * hgt, s.X * 0.92, s.Z * 0.92), at(0, (0.45 + hgt / 2) * s.Y, 0.03 * s.Z) * ANG(0, 0, math.rad(90)), base, "Cylinder", hm, nil, pivot)
		add("HighTopRim", V3(s.X * 0.95, s.Y * 0.16, s.Z * 0.95), at(0, (0.45 + hgt - 0.05) * s.Y, 0.03 * s.Z), base, "Ellipsoid", hm, nil, pivot)
		add("FadeSides", V3(s.X * 1.02, s.Y * 0.5, s.Z * 1.02), at(0, 0.2 * s.Y, 0.08 * s.Z), lerpColor(base, skin, 0.5 * (1 - 0.7 * grow)), "Ellipsoid", SMOOTH, 0.2)
		setShell(V3(0, (0.45 + hgt / 2) * s.Y, 0.03 * s.Z), V3(s.X * 0.92, s.Y * hgt, s.Z * 0.92))
		-- sponge-twist texture across the flat top
		local rng = Random.new(H.seed + 17)
		for i = 1, lod(H, 10, 5, 0) do
			local x, z = rng:NextNumber(-0.4, 0.4) * s.X, rng:NextNumber(-0.4, 0.4) * s.Z
			local r = 0.09 * s.X * rng:NextNumber(0.8, 1.2)
			-- flattened twists: a Ball part is always a sphere, so these are ellipsoids
			later(H, "Curl", V3(r, r * 0.6, r), at(x, (0.45 + hgt) * s.Y, z), colorFn(i, 1, x), "Ellipsoid", hm, nil, pivot)
		end
		hairline(true)
	elseif style == "Mohawk" then
		add("ShavedSides", V3(s.X * 1.02, s.Y * 0.55, s.Z * 1.03), at(0, 0.28 * s.Y, 0.05 * s.Z), lerpColor(base, skin, 0.75 * (1 - 0.7 * grow)), "Ellipsoid", SMOOTH, 0.35)
		setShell(V3(0, 0.28 * s.Y, 0.05 * s.Z), V3(s.X * 1.02, s.Y * 0.55, s.Z * 1.03))
		local n = 6
		for i = 1, n do
			local z = (-0.45 + (i - 1) * 0.18) * s.Z
			local hgt = (0.18 + 0.4 * L * T.shrink) * s.Y * (1 - math.abs(i - n / 2) * 0.06)
			add("Spike", V3(0.14 * s.X, hgt, 0.2 * s.Z), at(0, 0.5 * s.Y + hgt * 0.4, z), colorFn(i, i / n, 0), "Ellipsoid", mat)
		end
		-- strands standing up out of the crest
		local rng = Random.new(H.seed + 19)
		for i = 1, lod(H, 12, 4, 0) do
			local z = rng:NextNumber(-0.42, 0.42) * s.Z
			local p0 = V3(rng:NextNumber(-0.04, 0.04) * s.X, 0.5 * s.Y, z)
			local p1 = p0 + V3(rng:NextNumber(-0.05, 0.05), (0.2 + 0.35 * L * T.shrink) * s.Y, rng:NextNumber(-0.05, 0.08))
			strand(H, p0, V3(0, 1, 0), p1, V3(0, 0.6, 0.4), 0.035 * s.X, 0.3 + 0.4 * T.curl, i, 0.2, 1, 2)
		end
	elseif style == "Slick Back" then
		local p = cap(0.05 + L * 0.04, 0.1)
		for _, c in ipairs(folder:GetChildren()) do
			if c:IsA("BasePart") then
				-- wet-look gel: a soft sheen (strong reflectance mirrors the sky and turns the hair blue)
				c.Material = SMOOTH
				c.Reflectance = 0.05
			end
		end
		if H.detail == "full" then
			for i = 1, 4 do
				local x = (i - 2.5) * 0.18 * s.X
				later(H, "Groove", V3(0.02 * s.X, 0.02 * s.Y, 0.7 * s.Z), at(x, 0.56 * s.Y, 0.02 * s.Z), darken(base, 0.6), "Ellipsoid", SMOOTH)
			end
		end
		combLines(H, lod(H, 14, 6, 0), 0.75, 1.5, (0.03 + 0.02 * thick) * s.X)
		if hang > 0.6 then
			chain(H, V3(0, 0.05 * s.Y, 0.5 * s.Z), V3(0, -1, 0.4), 2, 0.25 * s.Y * hang, 0.5 * s.X, 0.1 * s.Z, 1, htype, false, 0.3, 0.9)
		end
		p.Reflectance = 0.05
		hairline(false)
	elseif style == "Undercut" then
		add("ShavedSides", V3(s.X * 1.02, s.Y * 0.55, s.Z * 1.03), at(0, 0.2 * s.Y, 0.06 * s.Z), lerpColor(base, skin, 0.6 * (1 - 0.7 * grow)), "Ellipsoid", SMOOTH, 0.3)
		-- a full top section swept to one side, sitting on the crown rather than floating like a cap
		local topH = (0.34 + L * 0.2) * s.Y
		add("TopSweep", V3(s.X * 0.9, topH, s.Z * 1.04), at(0.04 * s.X, 0.5 * s.Y - topH * 0.18, 0.0), base, "Ellipsoid", mat)
		setShell(V3(0.04 * s.X, 0.5 * s.Y - topH * 0.18, 0), V3(s.X * 0.9, topH, s.Z * 1.04))
		for i = 1, lod(H, 5, 3, 1) do
			local x = (i - 3) * 0.15 * s.X
			later(H, "Sweep", V3(0.16 * s.X, (0.1 + L * 0.06) * s.Y, 0.6 * s.Z), at(x + 0.05 * s.X, 0.5 * s.Y + topH * 0.3, -0.12 * s.Z) * ANG(math.rad(-14), 0, math.rad(-12)),
				colorFn(i, 0.2, x), "Ellipsoid", mat)
		end
		texture(10, 0.08)
		combLines(H, lod(H, 12, 5, 0), 0.5, nil, (0.03 + 0.02 * thick) * s.X, 0.25)
		hairline(false)
	elseif style == "Messy Hair" then
		cap(0.08)
		local rng = Random.new(H.seed + 5)
		for i = 1, math.floor(lod(H, 10, 6, 4) + density * lod(H, 10, 4, 0)) do
			local a = rng:NextNumber(0, math.pi * 2)
			local x, z = math.cos(a) * 0.35 * s.X, math.sin(a) * 0.35 * s.Z
			later(H, "Tuft", V3(0.12 * s.X, (0.15 + L * 0.2 * T.shrink) * s.Y, 0.12 * s.Z),
				at(x, 0.52 * s.Y, z) * ANG(rng:NextNumber(-0.7, 0.7), 0, rng:NextNumber(-0.7, 0.7)), colorFn(i, 0.3, x), "Ellipsoid", mat)
		end
		flyaways(H, lod(H, 20, 8, 0), 0.5 + 0.4 * L, 0.05, 1.3)
		hairline(false)
	elseif style == "Cornrows" then
		add("Scalp", V3(s.X * 1.03, s.Y * 0.5, s.Z * 1.05), at(0, 0.36 * s.Y, 0.03 * s.Z), lerpColor(base, skin, 0.25), "Ellipsoid", SMOOTH)
		setShell(V3(0, 0.36 * s.Y, 0.03 * s.Z), V3(s.X * 1.03, s.Y * 0.5, s.Z * 1.05))
		local per = lod(H, 4, 3, 2)
		local tail = lod(H, 5, 2, 1) + 2 + ((growth > 0.4 and H.detail ~= "low") and 1 or 0)
		-- rows fit the cap (at least three); the hanging ends below only while there is room left
		local rows = clamp(math.floor(room(H, tail) / per), 3, lod(H, 5 + math.floor(density * 3), 5, 3))
		for i = 1, rows do
			local x = (i - (rows + 1) / 2) * (0.85 / rows) * s.X
			for j = 0, per - 1 do
				local a = math.rad(-50 + j * (152 / per))
				local y = 0.3 * s.Y + math.cos(a) * 0.25 * s.Y
				local z = math.sin(a) * 0.58 * s.Z
				-- alternate a slight twist so each row reads as plaited
				add("Row", V3(0.07 * s.X * (0.8 + thick * 0.5), 0.07 * s.Y, 0.24 * s.Z), at(x, y, z) * ANG(a, 0, math.rad((j % 2 == 0) and 8 or -8)), colorFn(i, j / 3, x), "Ellipsoid", mat)
			end
			if hang > 0.45 and i % 2 == 0 and H.detail ~= "low" and room(H, tail + (rows - i) * per) >= 2 then
				chain(H, V3(x, -0.05 * s.Y, 0.5 * s.Z), V3(0, -1, 0.2), 2, 0.25 * s.Y * hang, 0.07 * s.X, 0.07 * s.Z, i, htype, true, 0.5, 1.3)
			end
		end
		if growth > 0.4 and H.detail ~= "low" then
			add("RootFrizz", V3(s.X * 1.06, s.Y * 0.52, s.Z * 1.08), at(0, 0.36 * s.Y, 0.03 * s.Z), lerpColor(base, darken(base, 0.8), 0.5), "Ellipsoid", SAND, clamp(0.85 - 0.4 * (growth - 0.4), 0.45, 0.85))
		end
		hairline(true, false)
	elseif style == "Dreadlocks" or style == "Twists" or style == "Braids" or style == "Box Braids" then
		cap(0.07)
		local box = style == "Box Braids"
		local braided = style == "Braids" or box
		local twists = style == "Twists"
		-- locs, twists and braids keep their length (the hair is set), but grow heavier and stiffer
		local n = math.floor(lod(H, box and 14 or 10, box and 6 or 8, 5) + density * lod(H, box and 4 or 6, 2, 1))
		local segs = twists and 1 or ((hang > 0.7 or L > 0.7) and lod(H, 3, 1, 1) or lod(H, 2, 1, 1))
		local segLen = (twists and 0.22 or 0.28 + 0.2 * L) * s.Y
		if segs == 1 and not twists then
			segLen *= 1.6
		end
		local w = (box and 0.06 or (braided and 0.07 or 0.1)) * s.X * (0.8 + 0.5 * thick)
		-- keep the chains inside the part budget (hero ~50, NPC ~22 segments, and the cut's cap less what
		-- the parting grid, root frizz and hairline still add), never fewer than four locs
		local crownSegs = segs >= 3 and 1 or segs
		local tail = lod(H, 5, 2, 1) + 2 + ((box and H.detail ~= "low") and lod(H, 6, 4, 0) or 0) + ((growth > 0.4 and H.detail ~= "low") and 1 or 0)
		n = math.min(n, math.floor(math.min(lod(H, 50, 22, 10), room(H, tail)) / (segs + 0.5 * crownSegs)))
		n = math.max(n, 4)
		local stiff = braided and 0.55 or 0.7
		local mass = braided and 1.3 or 1.6
		local ltype = braided and (CURLY[htype] and htype or "Curly") or "Coiled"
		for i = 1, n do
			local a = math.rad(-150 + (i - 1) * (300 / math.max(1, n - 1)))
			local x = math.sin(a) * 0.5 * s.X
			local z = math.cos(a) * 0.5 * s.Z
			if z > -0.3 * s.Z then
				local y = (0.05 + math.abs(math.cos(a)) * 0.15) * s.Y
				chain(H, V3(x, y, z), V3(x * 0.4, -1, z * 0.4 + 0.2), segs, segLen, w, w, i, ltype, braided, stiff, mass)
			end
		end
		-- locs from the crown fall back over the head
		for i = 1, math.floor(n / 2) do
			local x = (i - n / 4) * 0.14 * s.X
			chain(H, V3(x, 0.5 * s.Y, 0.1 * s.Z), V3(x * 0.3, -0.35, 1), crownSegs, segLen * (crownSegs == 1 and 0.9 or 0.6), w, w, i + 50, ltype, braided, stiff, mass)
		end
		if box and H.detail ~= "low" then
			-- box parting grid on the scalp
			local col = lerpColor(base, skin, 0.55)
			for i = 1, lod(H, 3, 2, 0) do
				local f = (i - 2) * 0.45
				pathLine(H, "BoxPart", { hairlinePoint(H, f * 0.4 * s.X, 0.016), combPoint(H, f, -0.4, 0.005), combPoint(H, f, 0.3, 0.005) }, 0.012 * s.X, col, 0.2)
			end
		end
		-- new growth at the roots: a soft halo before the next retwist
		if growth > 0.4 and H.detail ~= "low" then
			add("RootFrizz", V3(s.X * 1.1, s.Y * 1.02, s.Z * 1.06), at(0, 0.18 * s.Y, 0.14 * s.Z), lerpColor(base, darken(base, 0.8), 0.5), "Ellipsoid", SAND, clamp(0.85 - 0.4 * (growth - 0.4), 0.45, 0.85))
		end
		hairline(false)
	elseif style == "Short Dreads" then
		-- short freeform locs: a crown of locs that spring up and out before drooping, a fringe that
		-- falls over the forehead (stopping above the brows so the face stays clear) and locs
		-- hanging over the sides and back - a spiky silhouette wider than the head
		cap(0.08)
		local w = 0.085 * s.X * (0.85 + 0.5 * thick)
		local len = (0.22 + 0.12 * L) * s.Y
		local rng = Random.new(H.seed + 31)
		local idx = 0
		local twoSeg = H.detail == "full"
		local function loc(x, y, z, dir, segs, segLen, width)
			idx += 1
			if not twoSeg and segs > 1 then
				segLen *= segs * 0.8
				segs = 1
			end
			chain(H, V3(x, y, z), dir, segs, segLen, width or w, width or w, idx, "Coiled", false, 0.7, 1.3)
		end
		local nf = lod(H, 5 + math.floor(density * 2), 4, 3)
		for i = 1, nf do
			local x = (i - (nf + 1) / 2) * (0.7 / nf) * s.X
			local k = math.clamp(x / (s.X * 0.5), -0.97, 0.97)
			local z = -0.5 * s.Z * math.sqrt(1 - k * k) + 0.05 * s.Z
			loc(x, 0.5 * s.Y, z, V3(x * 0.35 + rng:NextNumber(-0.08, 0.08), -1, -0.25), 1, (0.2 + 0.05 * L) * s.Y * rng:NextNumber(0.9, 1.1))
		end
		local nc = lod(H, 9 + math.floor(density * 4), 6, 4)
		for i = 1, nc do
			local a = (i - 0.5) / nc * math.pi * 2 + rng:NextNumber(-0.12, 0.12)
			local dx, dz = math.sin(a), math.cos(a) -- dz < 0 is towards the face
			if dz > -0.8 then
				local r0 = rng:NextNumber(0.12, 0.3)
				loc(dx * r0 * s.X, 0.56 * s.Y, dz * r0 * s.Z + 0.04 * s.Z, V3(dx, rng:NextNumber(-0.05, 0.25), dz), 2, len * rng:NextNumber(0.85, 1.15))
			end
		end
		local ns = lod(H, 8 + math.floor(density * 4), 6, 3)
		for i = 1, ns do
			local a = math.rad(-118 + (i - 1) * (236 / math.max(1, ns - 1)))
			local dx, dz = math.sin(a), math.cos(a)
			loc(dx * 0.5 * s.X, 0.3 * s.Y, dz * 0.5 * s.Z, V3(dx * 0.5, -1, dz * 0.5), 2, len * rng:NextNumber(0.8, 1.0))
		end
		for _, p in ipairs(folder:GetDescendants()) do
			if p:IsA("BasePart") then
				p.Material = SMOOTH
			end
		end
		if growth > 0.4 and H.detail ~= "low" then
			add("RootFrizz", V3(s.X * 1.1, s.Y * 0.98, s.Z * 1.06), at(0, 0.2 * s.Y, 0.12 * s.Z), lerpColor(base, darken(base, 0.8), 0.5), "Ellipsoid", SAND, clamp(0.85 - 0.4 * (growth - 0.4), 0.45, 0.85))
		end
		hairline(false)
	elseif style == "Short Curly" then
		local ctype = CURLY[htype] and htype or "Curly"
		local TT = HAIR_TYPES[ctype]
		cap(0.08)
		local pivot = bouncePivot(H, V3(0, 0.35 * s.Y, 0.05 * s.Z))
		local oldMat = H.mat
		H.mat = TT.mat
		bumps(H, math.floor(lod(H, 26, 14, 8) * (0.6 + density)), (0.11 + 0.05 * thick) * TT.radius * s.X, 0.3, H.seed + 21, pivot)
		H.mat = oldMat
		coilHalo(H, lod(H, 12, 4, 0), V3(0, 0.25 * s.Y, 0.1 * s.Z), V3(0.56 * s.X, 0.5 * s.Y, 0.56 * s.Z), H.seed + 22)
		hairline(false)
	elseif style == "Long Curly" or ((style == "Long Hair" or style == "Wolf Cut") and (htype == "Coiled" or htype == "Kinky")) then
		-- long coily hair shrinks into big curls instead of hanging straight
		local ctype = CURLY[htype] and htype or "Curly"
		local TT = HAIR_TYPES[ctype]
		cap(0.1, 0.1)
		local pivot = bouncePivot(H, V3(0, 0.3 * s.Y, 0.05 * s.Z))
		local oldMat = H.mat
		H.mat = TT.mat
		bumps(H, math.floor(lod(H, 22, 12, 6) * (0.6 + 0.5 * density)), (0.13 + 0.05 * thick) * TT.radius * s.X, 0.2, H.seed + 22, pivot)
		H.mat = oldMat
		local n = math.floor(lod(H, 5, 3, 2) + density * lod(H, 3, 1, 0))
		local hl = TT.shrink * L
		for i = 1, n do
			local a = math.rad(-120 + (i - 1) * (240 / math.max(1, n - 1)))
			local x, z = math.sin(a) * 0.52 * s.X, math.cos(a) * 0.52 * s.Z
			chain(H, V3(x, 0.05 * s.Y, z), V3(x * 0.3, -1, z * 0.3 + 0.2), lod(H, hl > 0.6 and 3 or 2, 1, 1), (0.25 + 0.15 * hl) * s.Y, 0.18 * s.X * (0.8 + 0.4 * TT.radius), 0.18 * s.Z, i, ctype, false, TT.stiff, TT.mass)
		end
		coilHalo(H, lod(H, 14, 5, 0), V3(0, 0.22 * s.Y, 0.12 * s.Z), V3(0.58 * s.X, 0.55 * s.Y, 0.58 * s.Z), H.seed + 25)
		hairline(false)
	elseif style == "Long Hair" or style == "Wolf Cut" then
		cap(0.09, 0.12)
		local isWolf = style == "Wolf Cut"
		local segs = isWolf and 1 or lod(H, hang > 0.75 and 3 or 2, 2, 1)
		local segLen = (isWolf and 0.25 or 0.3 + 0.25 * hang) * s.Y
		-- back curtain
		chain(H, V3(0, 0.05 * s.Y, 0.5 * s.Z), V3(0, -1, 0.3), segs, segLen, 0.9 * s.X, (0.12 + 0.08 * thick) * s.Z, 1, htype, false, T.stiff, T.mass)
		-- side curtains
		for side = -1, 1, 2 do
			chain(H, V3(side * 0.5 * s.X, 0.15 * s.Y, 0.05 * s.Z), V3(side * 0.2, -1, 0.1), segs, segLen * 0.9, 0.12 * s.X, 0.5 * s.Z, side + 3, htype, false, T.stiff, T.mass)
		end
		if isWolf then
			local rng = Random.new(H.seed + 9)
			for i = 1, lod(H, 9, 5, 2) do
				local a = rng:NextNumber(0, math.pi * 2)
				local x, z = math.cos(a) * 0.38 * s.X, math.sin(a) * 0.38 * s.Z
				later(H, "Shag", V3(0.16 * s.X, 0.2 * s.Y, 0.16 * s.Z), at(x, 0.52 * s.Y, z) * ANG(rng:NextNumber(-0.5, 0.5), 0, rng:NextNumber(-0.5, 0.5)), colorFn(i, 0.2, x), "Ellipsoid", mat)
			end
			-- choppy fringe: separate strands that follow the curve of the forehead
			for i = 1, lod(H, 5, 3, 0) do
				local x = (i - 3) * 0.14 * s.X
				local k = math.clamp(x / (s.X * 0.5), -0.97, 0.97)
				local z = -0.5 * s.Z * math.sqrt(1 - k * k) * 0.93
				add("Bangs", V3(0.15 * s.X, (0.2 + 0.06 * L) * s.Y, 0.07 * s.Z), at(x, 0.38 * s.Y, z) * ANG(math.rad(-10), 0, math.rad((i - 3) * -6)),
					colorFn(i, 0.1, x), "Ellipsoid", mat)
			end
		end
		-- the outer layer: strands from the crown over the curtains
		local rng = Random.new(H.seed + 71)
		local nOuter = lod(H, 18, 6, 0)
		local drop = (isWolf and 0.45 or 0.5 + 0.55 * hang) * s.Y
		for i = 1, nOuter do
			local ph = rng:NextNumber(-1.9, 1.9)
			local p0 = shellPoint(H, 0.55 + rng:NextNumber(-0.1, 0.1), ph, 0.006)
			local out = V3(math.sin(ph), 0, math.cos(ph))
			local p1 = V3(p0.X * 1.05, p0.Y - drop * rng:NextNumber(0.75, 1.05), p0.Z) + out * 0.04 * s.X
			local wave = htype == "Wavy" and ((i % 2 == 0) and 0.45 or -0.25) or 0.25
			strand(H, p0, out + V3(0, -0.3, 0), p1, V3(0, -1, 0) + out * 0.2, (0.04 + 0.03 * thick) * s.X, wave, i, 0.1, 1, 2)
		end
		combLines(H, lod(H, 8, 3, 0), 0.6, nil, (0.03 + 0.02 * thick) * s.X)
		texture(12, 0.08)
		hairline(false)
	elseif style == "Ponytail" then
		cap(0.06, 0.05)
		for _, p in ipairs(folder:GetChildren()) do
			if p:IsA("BasePart") and htype == "Straight" then
				p.Reflectance = 0.05
			end
		end
		local tie = V3(0, 0.28 * s.Y, 0.56 * s.Z)
		-- a hair elastic in a shade of the hair (it only depends on hair data: the head cache key for the
		-- Hair step does not cover attire); dark hair gets a soft charcoal band so it still reads
		local tieColor = lum(base) > 0.22 and darken(base, 0.45) or Color3.fromRGB(62, 60, 66)
		add("HairTie", V3(0.14 * s.X, 0.14 * s.Y, 0.1 * s.Z), CF(tie), tieColor, "Ellipsoid", SMOOTH)
		chain(H, V3(0, 0.28 * s.Y, 0.6 * s.Z), V3(0, -0.8, 0.6), lod(H, hang > 0.6 and 4 or 3, 2, 1), (0.22 + 0.12 * hang) * s.Y * lod(H, 1, 1.5, 3), (0.2 + 0.1 * thick) * s.X, (0.2 + 0.1 * thick) * s.Z, 1, htype, false, T.stiff, T.mass)
		-- hair pulled back tight from the hairline to the tie
		local n = lod(H, 11, 5, 0)
		local w = (0.03 + 0.02 * thick) * s.X
		for i = 1, n do
			local f = n == 1 and 0 or (i - 1) / (n - 1) - 0.5
			local p0 = hairlinePoint(H, f * 0.72 * s.X, 0.012)
			local p1 = combPoint(H, f * 0.6, 0.15, 0.008)
			strand(H, p0, (p1 - p0) + V3(0, 0.25 * s.Y, 0), p1, V3(-f * 0.4, -0.1, 1), w, 0.35, i, 0, 0.6, 1)
			strand(H, p1, V3(-f * 0.4, -0.1, 1), tie + V3(f * 0.06 * s.X, 0, -0.02), tie - p1, w, 0.3, i, 0.6, 1, 1)
		end
		hairline(false)
	else
		cap(0.08)
		texture(14, 0.08)
		hairline(false)
	end

	-- decorations (curls, tufts, wave bands...) in queue order while the cap leaves room
	for i = 1, math.min(#H.deco, math.max(0, room(H))) do
		H.deco[i]()
	end
	-- parts over the old hair (the beard reads this to share A's budget)
	folder:SetAttribute("Extra", countParts(folder) - oldHairParts(hair, style))
	-- sheen by hair type on the hair material (curls and coils stay matte)
	if T.sheen > 0 then
		for _, p in ipairs(folder:GetDescendants()) do
			if p:IsA("BasePart") and p.Transparency < 1 and p.Material == T.mat and p.Reflectance < T.sheen then
				p.Reflectance = T.sheen
			end
		end
	end
	-- the client spring reads the stiffness of the whole cut too (locs / coils barely move)
	folder:SetAttribute("Stiff", T.stiff)
	Hair.ApplyHairHidden(model)
end

------------------------------------------------------------------------
-- Hair under headgear / a robe hood
------------------------------------------------------------------------
-- the avatar's hair accessories on the rig (an Accessory whose AccessoryType is Hair, or whose handle hangs
-- from the HairAttachment: older items carry no type)
local function isHairAccessory(acc)
	if not acc:IsA("Accessory") then
		return false
	end
	local okT, t = pcall(function()
		return acc.AccessoryType
	end)
	local handle = acc:FindFirstChild("Handle")
	return (okT and t == Enum.AccessoryType.Hair) or (handle ~= nil and handle:FindFirstChild("HairAttachment") ~= nil)
end
Hair.IsHairAccessory = isHairAccessory

local function hairAccessories(model)
	local out = {}
	for _, acc in ipairs(model:GetChildren()) do
		if isHairAccessory(acc) then
			table.insert(out, acc)
		end
	end
	return out
end
Hair.HairAccessories = hairAccessories

-- Config.BaldMode: nothing hair-like stays on the model whatever put it there - the avatar hair accessories an
-- ApplyDescription attached (a player who joined with them, a description from before the switch) and any built
-- Hair / Beard folder left from an earlier build (the hair and beard steps build nothing in BaldMode). Builder runs
-- it on every Cosmetics, uncached (an accessory can arrive with any ApplyDescription). Returns how many went
function Hair.StripBald(model)
	if not Config.BaldMode then
		return 0
	end
	local n = 0
	for _, acc in ipairs(hairAccessories(model)) do
		acc:Destroy()
		n += 1
	end
	local look = model:FindFirstChild("BoxerLook")
	for _, fname in ipairs({ "Hair", "Beard" }) do
		local f = look and look:FindFirstChild(fname)
		if f then
			for _, d in ipairs(f:GetChildren()) do
				d:Destroy()
				n += 1
			end
		end
	end
	return n
end

-- hides / restores one part (HGHidden, HGBaseT: the transparency to restore)
local function hidePart(d, hide)
	if hide then
		if not d:GetAttribute("HGHidden") then
			d:SetAttribute("HGBaseT", d.Transparency)
		end
		d:SetAttribute("HGHidden", true)
		d.Transparency = 1
	elseif d:GetAttribute("HGHidden") then
		d.Transparency = d:GetAttribute("HGBaseT") or 0
		d:SetAttribute("HGHidden", nil)
		d:SetAttribute("HGBaseT", nil)
	end
end

-- hides every hair part / strand the shell or hood would swallow and restores them afterwards.
-- Parts get attribute HGHidden (and HGBaseT, the transparency to restore); strands are disabled.
-- Avatar hair accessories hide whole (an accessory mesh cannot be cut): their Handle and any parts in them.
function Hair.ApplyHairHidden(model)
	bind()
	local hg = model:GetAttribute("HairHiddenHeadgear") == true
	local hood = model:GetAttribute("HairHiddenHood") == true
	for _, acc in ipairs(hairAccessories(model)) do
		for _, d in ipairs(acc:GetDescendants()) do
			if d:IsA("BasePart") then
				hidePart(d, hg or hood)
			end
		end
	end
	local look = model:FindFirstChild("BoxerLook")
	local hair = look and look:FindFirstChild("Hair")
	local head = part(model, "Head")
	if not (hair and head) then
		return
	end
	local s = head.Size
	local hcf = head.CFrame
	local function hidden(p, size)
		local big = size and (size.X > 0.62 * s.X or size.Z > 0.62 * s.Z)
		if hg and (p.Y > 0.3 * s.Y or (big and p.Y > -0.1 * s.Y)) then
			return true
		end
		-- a hood covers the crown, sides and back; a fringe on the face stays visible
		-- (and everything over the top of the head: curls and an afro's front bulge sit forward of that line
		-- and were left floating over the hidden cap)
		return hood and p.Y > -0.4 * s.Y and (p.Z > -0.36 * s.Z or p.Y > 0.28 * s.Y)
	end
	for _, d in ipairs(hair:GetDescendants()) do
		if d:IsA("BasePart") then
			if d.Name ~= "StrandAnchor" and d.Name ~= "BouncePivot" then
				hidePart(d, hidden(hcf:PointToObjectSpace(d.Position), d.Size))
			end
		elseif d:IsA("Beam") then
			local a0 = d.Attachment0
			d.Enabled = not (a0 and hidden(a0.Position, nil))
		end
	end
end

-- region = "headgear" | "hood"; the state is kept on the model so a rebuild stays hidden
function Hair.SetHairHidden(model, region, on)
	bind()
	model:SetAttribute(region == "hood" and "HairHiddenHood" or "HairHiddenHeadgear", on and true or nil)
	Hair.ApplyHairHidden(model)
end

-- avatar accessories whose AccessoryWeld lost its head (BuilderHead's classic head swap after ApplyDescription
-- attached them, a head the engine replaced): welded again, handle attachment on the head's attachment of the
-- same name (what Humanoid:AddAccessory does). Returns how many were re-welded
function Hair.FixAccessories(model)
	local head = model:FindFirstChild("Head")
	if not (head and head:IsA("BasePart")) then
		return 0
	end
	local n = 0
	for _, acc in ipairs(model:GetChildren()) do
		local handle = acc:IsA("Accessory") and acc:FindFirstChild("Handle")
		if handle and handle:IsA("BasePart") then
			-- (an avatar's hair hangs off the head's side: no mass for the Humanoid to balance against, no collision to
			-- catch on a door frame, no ray hit - as every part the Builder puts on)
			if handle.Massless ~= true then
				handle.Massless = true
			end
			if handle.CanCollide then
				handle.CanCollide = false
			end
			if handle.CanQuery then
				handle.CanQuery = false
			end
			if handle.CanTouch then
				handle.CanTouch = false
			end
			local weld = handle:FindFirstChild("AccessoryWeld")
			local p0 = weld and weld.Part0
			local p1 = weld and weld.Part1
			local onModel = p0 and p1 and p0:IsDescendantOf(model) and p1:IsDescendantOf(model)
			if not onModel then
				-- the handle attachment that has a partner on the head (hair: HairAttachment; hats: HatAttachment...)
				local ha, pa
				for _, a in ipairs(handle:GetChildren()) do
					if a:IsA("Attachment") then
						local partner = head:FindFirstChild(a.Name)
						if partner and partner:IsA("Attachment") then
							ha, pa = a, partner
							break
						end
					end
				end
				if ha then
					if weld then
						weld:Destroy()
					end
					local w = Instance.new("Weld")
					w.Name = "AccessoryWeld"
					w.Part0 = handle
					w.Part1 = head
					w.C0 = ha.CFrame
					w.C1 = pa.CFrame
					w.Parent = handle
					n += 1
				end
			end
		end
	end
	return n
end

------------------------------------------------------------------------
-- Sweat
------------------------------------------------------------------------
-- wet hair darkens and (except coils) gains a slight sheen; strands darken too
local function wetHair(model, q)
	bind()
	local look = model:FindFirstChild("BoxerLook")
	if not look then
		return
	end
	for _, fname in ipairs({ "Hair", "Beard" }) do
		local f = look:FindFirstChild(fname)
		if f then
			for _, d in ipairs(f:GetDescendants()) do
				if d:IsA("BasePart") and d.Transparency < 1 then
					local dry = d:GetAttribute("DryColor")
					if typeof(dry) ~= "Color3" then
						if q <= 0 then
							-- dry and never wetted since this build: nothing to restore, no attribute writes
							continue
						end
						dry = d.Color
						d:SetAttribute("DryColor", dry)
						d:SetAttribute("DryRefl", d.Reflectance)
					end
					d.Color = lerpColor(dry, darken(dry, 0.7), q)
					if d.Material ~= SAND then
						d.Reflectance = math.min(0.06, (d:GetAttribute("DryRefl") or 0) + 0.04 * q)
					end
				elseif d:IsA("Beam") then
					local c0, c1 = d:GetAttribute("DryColor0"), d:GetAttribute("DryColor1")
					if typeof(c0) == "Color3" and typeof(c1) == "Color3" then
						d.Color = ColorSequence.new(lerpColor(c0, darken(c0, 0.7), q), lerpColor(c1, darken(c1, 0.7), q))
					end
				end
			end
		end
	end
end

------------------------------------------------------------------------
-- Public API
------------------------------------------------------------------------
Hair.Build = hairBuild -- (model, app, opts): BoxerLook/Hair (Builder.Cosmetics step "Hair")
Hair.Wet = wetHair -- (model, q 0..1): wet hair / beard look (Head.SetSweat calls it)
Hair.TYPES = HAIR_TYPES -- per hair type: shrink, curl, radius, sheen, mat, stiff, mass (read-only data)
Hair.CURLY = CURLY
Hair.Drawn = DRAWN -- styles with a dedicated branch (others draw Looks.HairStyleBase[id])
Hair.Palette = hairPalette -- (hair) -> fn(index, t, x) -> Color3

return Hair
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="51">
        <Properties>
          <string name="Name">BuilderHead</string>
          <string name="Source"><![CDATA[-- BuilderHead: everything built on the head (server side; the Creator also calls SetDamage locally).
-- * the head: the engine's default head is swapped once for the classic head (a Part with the Head SpecialMesh,
--   classicHead) and the face is BUILT on it from Parts (no decal, no EditableMesh). Every feature is a lens: an
--   ellipsoid sunk into the classic head's exact surface (AnatomyHairKit.CLASSIC, FaceLayout surf / normal) so only
--   a low dome of the size asked shows, its rim on the skin; nothing floats or sinks. Ears flush on the side wall,
--   eyes set in (a shallow white, limbal ring, iris, pupil, catchlight; an upper lid fold whose edge is the lash
--   line, a low lower lid), solid 3-piece brows on the style's arch (6 styles), a nose with a bridge, tip, wings and
--   nostrils, two low lips overlapping at a dark seam with rigged corner pieces, teeth + interior behind them;
--   cheekbones, jaw angles and a heavy brow ridge only where the sliders ask for them. No default blush. From the
--   creator's face shape and Face / Eye / Skin / Wear sliders (Looks); heterochromia, asymmetry, undertone
-- * boxer wear and skin: cauliflower ear, bent nose, permanent fight scars (app.battle), a stitched
--   surgical repair scar, acne (active spots when young, pitted scars on adult skin), wrinkles by age,
--   pore texture (an honest approximation: material + sparse dots), temple/forehead veins, face fat
--   (full cheeks, jowls) and weight-cut hollows, grime (own folder, refreshed by SetSweat)
-- * part budget: A's share of Config.Detail partBudget (+60 / +10 / 0 over the old face, hair and beard);
--   optional face details and hair decorations are drawn in priority order while it lasts
-- * the built face above is dormant: every boxer wears a drawn face (BodyTiers.DrawnStyleOf never returns nil while
--   one is uploaded), so its parts and rig are only built in the emergency fallback with no drawn face uploaded
--   (and by the lune tests through BodyTiers.SetData). The code stays in place, unused
-- * drawn face styles (look.face.style = a BodyTiers.STYLE_KEYS key, the user's Boxer faces): the head wears the
--   drawn face as its front Decal "face" (white, opaque, the whole square canvas) instead of the built eyes, brows,
--   nose and lips (none of those parts, no face rig; the ears, head shape and skin details stay). Damage, sweat, grime
--   and the beard then follow the drawn features (Head.DecalLayout); FaceFX swaps the decal by mood
-- * face rig the client animates (FaceFX; Motor6D "FaceJoint", tag FaceRig, attribute Role): brows, lids,
--   lower lids, eyes (invisible EyeBall pivots), lips, mouth corners, mouth interior; BlinkLid parts
-- * hair: in BuilderHair (split out verbatim; Head.Hair, SetHairHidden and ApplyHairHidden forward
--   there and Head.Shared lends it the budget and head-surface helpers below)
-- * beards: growth stages, own colour, salt & pepper with age, 10 styles, material by hair type
-- * fight damage light .. severe (bruise colour by age), sweat (skin sheen, beads, drips, wet hair)
-- Builder.Cosmetics runs Face, Hair (BuilderHair) and Beard (in that order) and forwards FaceLayout,
-- SetDamage, SetSweat and SetHeadgear here. Level of detail: opts.detail through Config.DetailLevel.
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Looks = require(Shared:WaitForChild("Looks"))
-- the drawn face styles (look.face.style) and their uploaded textures
local BodyTiers = require(Shared:WaitForChild("BodyTiers"))
local Kit = require(script.Parent:WaitForChild("BuilderKit"))
-- hair lives in BuilderHair (it requires this module lazily, on first use: no require cycle)
local Hair = require(script.Parent:WaitForChild("BuilderHair"))

local Head = {}

local V3, CF, ANG, SMOOTH = Kit.V3, Kit.CF, Kit.ANG, Kit.SMOOTH
local lerpColor, darken = Kit.lerpColor, Kit.darken
local mk, getFolder, part = Kit.mk, Kit.getFolder, Kit.part
local FABRIC, SAND, PLASTIC = Enum.Material.Fabric, Enum.Material.Sand, Enum.Material.Plastic
local clamp, rad = math.clamp, math.rad
local WHITE = Color3.new(1, 1, 1)

------------------------------------------------------------------------
-- Shared helpers
------------------------------------------------------------------------
local function lum(c)
	return 0.299 * c.R + 0.587 * c.G + 0.114 * c.B
end

local function skinOf(app)
	return Looks.Color(Looks.SkinTones[app.skin or 5])
end

-- flush / lip tint per undertone (lips, blush, ear lobes, inner eye corners)
local UNDERTONE = {
	Neutral = Color3.fromRGB(196, 108, 104),
	Warm = Color3.fromRGB(212, 122, 88),
	Cool = Color3.fromRGB(188, 98, 128),
	Olive = Color3.fromRGB(168, 120, 86),
}

-- animatable cosmetic joint (CONTRACTS section 5): Part0 = the head, Part1 = the moving part, C0 holds
-- the build pose, C1 = identity; the client only writes Motor6D.Transform
local function joint(part0, part1, name)
	local m = Instance.new("Motor6D")
	m.Name = name
	m.Part0 = part0
	m.Part1 = part1
	m.C0 = part0.CFrame:Inverse() * part1.CFrame
	m.C1 = CF()
	m.Parent = part1
	return m
end

-- attachment frame whose X axis (the Beam curve axis) points along dir
local function axisCF(pos, dir)
	if dir.Magnitude < 1e-4 then
		dir = V3(0, -1, 0)
	end
	dir = dir.Unit
	local up = math.abs(dir.Y) > 0.95 and V3(0, 0, -1) or V3(0, 1, 0)
	return CFrame.lookAt(pos, pos + dir, up) * ANG(0, math.pi / 2, 0)
end

-- the head surface: the classic head (FaceLayout: L.surf / L.normal, AnatomyHairKit.CLASSIC exactly)
local function surfNormal(L, x, y)
	if L.normal then
		return L.normal(x, y)
	end
	local e = 0.01
	local px = V3(2 * e, 0, L.surf(x + e, y) - L.surf(x - e, y))
	local py = V3(0, 2 * e, L.surf(x, y + e) - L.surf(x, y - e))
	local n = py:Cross(px)
	if n.Z > 0 then
		n = -n
	end
	return n.Unit
end

local function surfPoint(L, x, y, out)
	return V3(x, y, L.surf(x, y)) + surfNormal(L, x, y) * (out or 0)
end

-- head-local frame on the surface at (x, y): -Z (LookVector) points out of the skin
local function surfCF(L, x, y, out)
	local p = surfPoint(L, x, y, out)
	return CFrame.lookAt(p, p + surfNormal(L, x, y), V3(0, 1, 0))
end

-- a thin strip lying on the head surface between head-local (x0, y0) and (x1, y1):
-- size X = visible width, Y = thickness along the skin normal, Z = length
local function surfaceLine(folder, anchor, head, L, name, x0, y0, x1, y1, width, depth, color, transparency, out, material)
	out = out or 0.004
	local p0 = surfPoint(L, x0, y0, out)
	local p1 = surfPoint(L, x1, y1, out)
	local pm = surfPoint(L, (x0 + x1) / 2, (y0 + y1) / 2, out)
	local dir = p1 - p0
	local len = dir.Magnitude
	if len < 1e-3 then
		return nil
	end
	local cf = head.CFrame * CFrame.lookAt(pm, pm + dir, surfNormal(L, (x0 + x1) / 2, (y0 + y1) / 2))
	return mk(folder, anchor, name, V3(width, depth, len + width * 0.5), cf, color, "Ellipsoid", material or SMOOTH, transparency)
end

-- the same along a polyline { {x, y}, ... } (short segments keep a curved path on the skin)
local function surfacePath(folder, anchor, head, L, name, pts, width, depth, color, transparency, out, material)
	for i = 1, #pts - 1 do
		surfaceLine(folder, anchor, head, L, name, pts[i][1], pts[i][2], pts[i + 1][1], pts[i + 1][2], width, depth, color, transparency, out, material)
	end
end

-- a lens: an ellipsoid sunk into the head so that a footprint w x h (along the surface frame's X / Y at (x, y),
-- turned `roll` about the normal) shows and its middle rises `rise` above the skin. dk = the share of its depth
-- below the skin (0.3 a full dome with a steep rim .. 0.9 a nearly flat patch with a soft one). The head falls
-- away under a wide footprint (the round wall, the rounded brow and chin): the ellipsoid is sunk at least that far
-- so its rim never stands off the skin, and widened so the rim still lands at w / 2, h / 2. base lifts it off the
-- skin (a brow on the brow ridge). Returns the head-local CFrame (-Z out of the skin) and the Size, plus the
-- depth semi-axis D and the sink c (its height above the skin at (u, v) is D sqrt(1 - (u/a)^2 - (v/b)^2) - c).
local function lens(L, x, y, w, h, rise, dk, roll, base)
	local cf = surfCF(L, x, y, 0)
	if roll and roll ~= 0 then
		cf = cf * ANG(0, 0, roll)
	end
	local n, p0 = cf.LookVector, cf.Position
	local function sagAt(dx, dy)
		local t = p0 + cf.RightVector * dx + cf.UpVector * dy
		return math.max((p0 - V3(t.X, t.Y, L.surf(t.X, t.Y))):Dot(n), 0)
	end
	local sx = math.max(sagAt(w / 2, 0), sagAt(-w / 2, 0))
	local sy = math.max(sagAt(0, h / 2), sagAt(0, -h / 2))
	if (dk or 0.6) >= 0.7 then
		-- a flat patch (a bruise, a shadow, a scar): an ellipsoid barely flatter than the head under it would meet it in
		-- a squarish outline, so it is shaped from the curvatures instead: the head's (from the sag) plus what it takes to
		-- rise `rise` at the middle and come back to the skin at the footprint's edge, a near paraboloid there
		-- (at least 1.7 x the head's curvature, or the outline goes diamond-shaped; a wide patch on the round wall
		-- therefore rises a little more than asked. Neither semi-axis runs past 2.2 x the footprint: a long one poked
		-- out of the head where it rounds off)
		local hw, hh = w / 2, h / 2
		rise = math.max(rise, 0.4 * math.max(sx, sy))
		local kLx = math.max((2 * sx + 2 * rise) / (hw * hw), 1.7 * 2 * sx / (hw * hw))
		local kLy = math.max((2 * sy + 2 * rise) / (hh * hh), 1.7 * 2 * sy / (hh * hh))
		local m = 1.15 + (dk - 0.7) * 2
		local D = math.max(kLx * (hw * m) ^ 2, kLy * (hh * m) ^ 2, 0.01)
		local a = math.min(math.sqrt(D / kLx), 2.2 * hw)
		local b = math.min(math.sqrt(D / kLy), 2.2 * hh)
		return cf * CF(0, 0, D - rise - (base or 0)), V3(2 * a, 2 * b, 2 * D), D, D - rise
	end
	-- (Kit.mk keeps every axis >= 0.02: never thinner than that)
	local D = math.max(rise / (1 - clamp(dk or 0.6, 0.05, 0.95)), 0.01)
	local c = D - rise
	local need = math.max(sx, sy) * 1.1 + 0.0006
	if c < need then
		c = need
		D = rise + need
	end
	local fx = math.sqrt(math.max(1 - ((c - sx) / D) ^ 2, 0.04))
	local fy = math.sqrt(math.max(1 - ((c - sy) / D) ^ 2, 0.04))
	return cf * CF(0, 0, c - (base or 0)), V3(w / fx, h / fy, 2 * D), D, c
end

-- an ellipsoid on top of a dome (an iris on the white, a pupil on the iris): its middle stands rTop above the skin and
-- its rim meets the dome, hBase above the skin, at radius rho. Returns the semi-axis across, the depth semi-axis and the
-- sink below the skin.
local function capOn(rTop, rho, hBase, D)
	D = math.max(D or 0, 0.01, rTop + 0.0015)
	local c = D - rTop
	local f = math.sqrt(math.max(1 - ((math.max(hBase, 0) + c) / D) ^ 2, 0.04))
	return rho / f, D, c
end

------------------------------------------------------------------------
-- Face layout
------------------------------------------------------------------------
-- the classic head (AnatomyHairKit.CLASSIC, nominal 1.2 box: a vertical cylinder r 0.6, half height 0.6, its top and
-- bottom edges rounded by 0.24, centred on the part); real = nominal x Size / 1.2 per axis. A copy (requiring the hair kit
-- would load MeshKit on the server for three numbers); test_bodytiers checks it against AnatomyHairKit.CLASSIC
local CLASSIC = { r = 0.6, h = 0.6, round = 0.24 }
Head.CLASSIC = CLASSIC

-- returns head-local positions for face features (shared with hair, beard and damage visuals)
-- Fields: s, front(x), surf(x, y), normal(x, y), shellCF(az, y, out), eyeX, eyeY, mouthY, eyeSize, eyeW, eyeHt, eyeH,
-- browY, noseLen, noseW, noseB, noseTopY, noseBottomY, mouthW, eyeTilt, eyeYS[side], browTiltS[side], mouthTilt, noseDev
function Head.FaceLayout(head, face)
	face = face or {}
	local s = head.Size
	local kx, ky, kz = s.X / 1.2, s.Y / 1.2, s.Z / 1.2
	local R, RR = CLASSIC.r, CLASSIC.round
	local core, flat = R - RR, CLASSIC.h - RR
	-- the head's radius at nominal height yn and the tilt of its normal there (the rounded top / bottom edge)
	local function rhoN(yn)
		local e = math.abs(yn) - flat
		if e <= 0 then
			return R, 1, 0
		end
		e = math.min(e, RR * 0.995)
		local r = core + math.sqrt(RR * RR - e * e)
		return r, (r - core) / RR, (yn > 0 and 1 or -1) * e / RR
	end
	local function surf(x, y)
		local r = rhoN(y / ky)
		local xn = clamp(x / kx, -r * 0.985, r * 0.985)
		return -kz * math.sqrt(r * r - xn * xn)
	end
	local function front(x)
		return surf(x, 0)
	end
	local function normal(x, y)
		local r, ct, st = rhoN(y / ky)
		local xn = clamp(x / kx, -r * 0.985, r * 0.985)
		local zn = -math.sqrt(r * r - xn * xn)
		return V3(ct * xn / r / kx, st / ky, ct * zn / r / kz).Unit
	end
	-- a frame anywhere on the head: azimuth az from the front (+ towards +X), height y; -Z out of the skin
	local function shellCF(az, y, out)
		local yn = clamp(y / ky, -0.598, 0.598)
		local r, ct, st = rhoN(yn)
		local hx, hz = math.sin(az), -math.cos(az)
		local nn = V3(ct * hx / kx, st / ky, ct * hz / kz).Unit
		local p = V3(r * hx * kx, yn * ky, r * hz * kz) + nn * (out or 0)
		return CFrame.lookAt(p, p + nn, V3(0, 1, 0))
	end
	-- how far a head-local point lies outside the head (studs, radially; < 0 inside; above / below the head: its height
	-- past the top / bottom)
	local function outside(p)
		local yn = p.Y / ky
		if math.abs(yn) >= CLASSIC.h then
			return (math.abs(yn) - CLASSIC.h) * ky
		end
		local r = rhoN(yn)
		local k = math.sqrt((kx * kx + kz * kz) / 2)
		return (math.sqrt((p.X / kx) ^ 2 + (p.Z / kz) ^ 2) - r) * k
	end
	local eyeX = (0.19 + 0.035 * (face.eyeDist or 0)) * s.X
	local eyeY = 0.1 * s.Y
	local mouthY = -0.215 * s.Y
	local L = {
		s = s, front = front, surf = surf, normal = normal, shellCF = shellCF, outside = outside, eyeX = eyeX, eyeY = eyeY, mouthY = mouthY,
		eyeSize = 1 + 0.25 * (face.eyeSize or 0),
		eyeH = 1 - 0.45 * (face.eyeShape or 0.5),
		browY = eyeY + (0.13 + 0.025 * (face.forehead or 0) + 0.03 * (face.browHeight or 0)) * s.Y,
		noseLen = (0.2 + 0.07 * (face.noseLength or 0)) * s.Y,
		noseW = (0.11 + 0.05 * (face.noseWidth or 0)) * s.X,
		noseB = (0.085 + 0.05 * (face.noseBridge or 0)) * s.Z,
	}
	-- the visible eye opening (round .. almond)
	L.eyeW = 0.132 * L.eyeSize * s.X
	L.eyeHt = L.eyeW * (0.9 - 0.46 * clamp(face.eyeShape or 0.5, 0, 1))
	L.noseTopY = eyeY - 0.02 * s.Y
	L.noseBottomY = L.noseTopY - L.noseLen
	L.mouthW = (0.235 + 0.02 * (face.lips or 0) + 0.045 * (face.mouthWidth or 0)) * s.X
	L.eyeTilt = clamp(face.eyeTilt or 0, -1, 1) * rad(8)
	-- asymmetry: its own random stream so the skin-detail stream never shifts
	local asym = clamp(face.asym or 0, 0, 1)
	local r = Random.new((face.seed or 7) + 101)
	local dy, bl, br, mt, nd = r:NextNumber(-1, 1), r:NextNumber(-1, 1), r:NextNumber(-1, 1), r:NextNumber(-1, 1), r:NextNumber(-1, 1)
	L.eyeYS = { [-1] = eyeY + dy * asym * 0.014 * s.Y, [1] = eyeY - dy * asym * 0.014 * s.Y }
	L.browTiltS = { [-1] = bl * asym * rad(6), [1] = br * asym * rad(6) }
	L.mouthTilt = mt * asym * rad(4)
	L.noseDev = nd * asym * 0.018 * s.X
	return L
end

-- The drawn Boxer faces (look.face.style): where their features lie on the head. The decal spans the head's front
-- (Size.X x Size.Y, u = 0 at +X: the image as the viewer sees it), so a canvas point (u, v) is head-local
-- ((0.5 - u) * Size.X, (0.5 - v) * Size.Y). Measured from the registered 1254 px set (tools/body/faces.py
-- register_pack: every face's eye centres at x 443 / 807, y 575): eyes +-0.145, y +0.0415, ink 0.057 x 0.101; brows
-- ~0.15 (0.13 .. 0.155 by face); mouths ~-0.175 (ink -0.12 .. -0.22, 0.14 .. 0.22 wide). eyeW / eyeH: the eye's
-- socket (what FaceLayout readers see as the eye opening), not the ink; SetDamage draws a drawn eye's marks itself.
local DECAL = {
	eyeX = 0.145, eyeY = 0.0415, eyeW = 0.1, eyeH = 0.1, browY = 0.15, mouthY = -0.175, mouthW = 0.2,
	noseBottomY = -0.085, noseW = 0.1,
}
Head.DECAL = DECAL
-- the drawn ink (fractions of the head size, |x| ranges: both sides), padded: skin spots keep off it
local DECAL_INK = {
	{ 0.085, 0.205, -0.05, 0.11 }, -- eyes
	{ 0.02, 0.285, 0.065, 0.21 }, -- brows
	{ 0, 0.2, -0.235, -0.105 }, -- mouth
}
Head.DECAL_INK = DECAL_INK

-- a FaceLayout moved onto the drawn features (in place; returns L): the eyes, brows, mouth and a nose line between
-- them (no nose is drawn: only the bleed and the sweat use it), no asymmetry or tilt
function Head.DecalLayout(L)
	local s = L.s
	L.eyeX, L.eyeY = DECAL.eyeX * s.X, DECAL.eyeY * s.Y
	L.eyeYS = { [-1] = L.eyeY, [1] = L.eyeY }
	L.eyeW, L.eyeHt, L.eyeSize, L.eyeTilt = DECAL.eyeW * s.X, DECAL.eyeH * s.Y, 1, 0
	L.browY = DECAL.browY * s.Y
	L.browTiltS = { [-1] = 0, [1] = 0 }
	L.mouthY, L.mouthW, L.mouthTilt = DECAL.mouthY * s.Y, DECAL.mouthW * s.X, 0
	L.noseTopY = L.eyeY - 0.02 * s.Y
	L.noseBottomY = DECAL.noseBottomY * s.Y
	L.noseLen = L.noseTopY - L.noseBottomY
	L.noseW, L.noseB, L.noseDev = DECAL.noseW * s.X, 0, 0
	L.decal = true
	return L
end

-- true when a mark of size w x h at head-local (x, y) would cover the drawn ink
function Head.DecalInkHit(L, x, y, w, h)
	local s = L.s
	local ax, rx, ry = math.abs(x) / s.X, (w or 0) / 2 / s.X, (h or 0) / 2 / s.Y
	local yy = y / s.Y
	for _, b in ipairs(DECAL_INK) do
		if ax + rx > b[1] and ax - rx < b[2] and yy + ry > b[3] and yy - ry < b[4] then
			return true
		end
	end
	return false
end

-- the drawn style the head's face was built with (the Face folder's FaceStyle attribute; nil = the built face)
function Head.FaceStyle(model)
	local look = model:FindFirstChild("BoxerLook")
	local f = look and look:FindFirstChild("Face")
	local st = f and f:GetAttribute("FaceStyle")
	return type(st) == "string" and st or nil
end

-- the head's front Decal "face" for a drawn style: one decal (any other decal on the head goes: an engine face, an
-- older build's), Front, white, opaque, the uploaded texture of the chosen face; tagged FaceDecal (FaceFX finds it
-- and swaps its Texture by mood on the client; the server's Texture stays the chosen face)
local function putFaceDecal(head, style)
	local keep
	for _, d in ipairs(head:GetChildren()) do
		if d:IsA("Decal") then
			if not keep and d.Name == "face" and d:GetAttribute("FaceStyle") == style then
				keep = d
			else
				d:Destroy()
			end
		end
	end
	local dec = keep or Instance.new("Decal")
	dec.Name = "face"
	dec.Face = Enum.NormalId.Front
	dec.Color3 = WHITE
	dec.Transparency = 0
	local tex = BodyTiers.FaceTexture(style)
	if dec.Texture ~= tex then
		dec.Texture = tex
	end
	dec:SetAttribute("FaceStyle", style)
	dec.Parent = head
	-- (tagged once parented: the tag's added signal finds the model from it)
	if not CollectionService:HasTag(dec, "FaceDecal") then
		CollectionService:AddTag(dec, "FaceDecal")
	end
	return dec
end

-- Builder's Face step, also when the face is served from cache: a drawn style's decal is on the head (something
-- may have replaced or removed it since the face was built: an ApplyDescription, a head swap). Built faces: no-op
function Head.EnsureFaceDecal(model)
	local head = model:FindFirstChild("Head")
	local style = Head.FaceStyle(model)
	if not (head and style) then
		return
	end
	local cur = head:FindFirstChild("face")
	local n = 0
	for _, d in ipairs(head:GetChildren()) do
		if d:IsA("Decal") then
			n += 1
		end
	end
	if n == 1 and cur and cur:IsA("Decal") and cur:GetAttribute("FaceStyle") == style and cur.Transparency == 0 then
		return
	end
	putFaceDecal(head, style)
end

------------------------------------------------------------------------
-- Face
------------------------------------------------------------------------
-- eyebrow shapes: thickness, arch (inner rise / tail drop), length, tail taper
local BROWS = {
	Natural = { thick = 1, arch = 0.4, len = 1, taper = 0.75 },
	Straight = { thick = 1, arch = 0.05, len = 1.03, taper = 0.85 },
	["Soft Arch"] = { thick = 0.85, arch = 0.65, len = 1, taper = 0.65 },
	["High Arch"] = { thick = 0.75, arch = 1, len = 0.98, taper = 0.55 },
	Thick = { thick = 1.45, arch = 0.3, len = 1.05, taper = 0.85 },
	Thin = { thick = 0.6, arch = 0.55, len = 0.95, taper = 0.5 },
}

-- which face rig roles exist at each detail level (CONTRACTS section 5)
local function rigOn(detail, role)
	if detail == "full" then
		return true
	end
	return detail == "medium" and (role == "EyeL" or role == "EyeR" or role == "BrowL" or role == "BrowR")
end

------------------------------------------------------------------------
-- Part budget (CONTRACTS section 16 B: baseline = the pre-overhaul face + old hair + old beard)
------------------------------------------------------------------------
-- A's share of Config.Detail[d].partBudget (B owns the other half; medium / low are whole-character
-- limits, so A keeps half of medium and nothing at low). Every head step records its parts over the
-- baseline in its folder's attribute "Extra"; the face is built first and takes what it needs (capped
-- by FACE_CAP), the hair gets the rest minus a beard reserve, the beard builds last into what is left.
local A_BUDGET = { full = 60, medium = 10, low = 0 }
local FACE_CAP = { full = 38, medium = 6, low = -2 }
local BEARD_RESERVE = { full = 4, medium = 2, low = 0 }
-- per-cut ceiling (section 16 A: hero ~60, NPC ~30 hair parts) even where the old hair had more
local HAIR_MAX = { full = 60, medium = 30, low = 15 }

local function countParts(folder)
	local n = 0
	if folder then
		for _, d in ipairs(folder:GetDescendants()) do
			if d:IsA("BasePart") then
				n += 1
			end
		end
	end
	return n
end

-- the Extra a step recorded (nil-safe: a missing folder costs its default)
local function extraOf(model, name, default)
	local look = model:FindFirstChild("BoxerLook")
	local f = look and look:FindFirstChild(name)
	local v = f and f:GetAttribute("Extra")
	return type(v) == "number" and v or default
end

-- part count of the pre-overhaul face for these sliders (it had no detail levels)
local function oldFaceParts(face, opts)
	local shape = face.shape or "Oval"
	local jawW, cheek, cheekFat, chinDrop, browRidge = face.jawWidth or 0, face.cheek or 0, 0, 0, 0
	if shape == "Square" then
		jawW += 0.6
	elseif shape == "Diamond" then
		cheek += 0.7
		jawW -= 0.5
	elseif shape == "Round" then
		cheekFat = 0.8
		jawW += 0.3
	elseif shape == "Long" then
		chinDrop = 0.12
		cheek -= 0.3
	elseif shape == "Heart" then
		browRidge = 0.6
		jawW -= 0.4
	end
	-- ears, chin, 2 x (sclera, iris, pupil, glint, lid, brow), nose + tip, nostrils, lips + mouth line
	local n = 22
	n += (jawW > 0.1 and 1 or 0) + (chinDrop > 0 and 1 or 0) + (cheek > -0.5 and 2 or 0) + (cheekFat > 0 and 2 or 0)
	n += (math.max(browRidge, (face.forehead or 0) * 0.6) > 0.2 and 1 or 0) + ((face.lashes or 0) > 0.15 and 2 or 0)
	n += math.floor((face.freckles or 0) * 26) + math.floor(face.moles or 0) + math.floor(face.scars or 0)
	n += math.floor((face.acne or 0) * 14) + ((face.marks or 0) > 0.05 and 1 or 0) + (opts.mouthguard and 1 or 0)
	return n
end

-- the beard style beardBuild draws for this app (nil = none), whether it is a mere shadow, its growth and
-- whether the style comes from growth alone (no style chosen); shared with the face (lips through a beard)
local function beardStyle(app)
	-- Config.BaldMode: no hair on anyone, facial hair included (clean-shaven; the face keeps its own lips)
	if app.gender == 2 or Config.BaldMode then
		return nil
	end
	local beard = type(app.beard) == "table" and app.beard or {}
	local style = beard.style or "None"
	if not table.find(Looks.BeardStyles, style) then
		style = Looks.BeardStyleBase[style] or "None"
	end
	local g = clamp(tonumber(beard.growth) or 0, 0, 1)
	if style == "None" then
		if g < 0.2 then
			return nil
		elseif g < 0.8 then
			return "Stubble", g < 0.45, g, true
		end
		return "Short Boxed", false, (g - 0.8) * 2, true
	end
	return style, false, g, false
end

-- part count of the pre-overhaul beard
local function oldBeardParts(app)
	if app.gender == 2 then
		return 0
	end
	local beard = type(app.beard) == "table" and app.beard or {}
	local style = beard.style or "None"
	if style == "None" then
		return clamp(tonumber(beard.growth) or 0, 0, 1) >= 0.45 and 1 or 0
	end
	return (style == "Stubble" or style == "Moustache") and 1 or (style == "Chin Strap" and 3 or 2)
end

-- everything the Face step reads from app.hair / app.beard / app.attire, for B's head cache key (Builder
-- headSig) in place of the whole tables: the brow colour, whether a beard covers the lips and the
-- mouthguard colour. Any other hair / beard / attire change never changes the face.
function Head.FaceSigParts(app)
	app = type(app) == "table" and app or {}
	local style = beardStyle(app)
	return {
		hairColor = (type(app.hair) == "table" and app.hair.color) or false,
		lipsCovered = style ~= nil and style ~= "Stubble",
		mouthguard = (type(app.attire) == "table" and app.attire.mouthguard) or false,
	}
end

-- road dirt on the face (CONTRACTS section 7: I sets the model attribute Grime after roadwork and clears
-- it at the shower; an opts.grime given to the last face build wins). Its own folder keyed by level,
-- detail and head, so Head.SetSweat - which B runs at the end of every Cosmetics, head-only rebuilds
-- included - shows and clears it without a face rebuild (the face itself may be served from cache).
local function faceGrime(model, app)
	local head = part(model, "Head")
	local look = model:FindFirstChild("BoxerLook")
	if not (head and look) then
		return
	end
	local faceF = look:FindFirstChild("Face")
	local detail = (faceF and faceF:GetAttribute("Detail")) or model:GetAttribute("Detail") or "full"
	local g = tonumber(faceF and faceF:GetAttribute("OptGrime")) or tonumber(model:GetAttribute("Grime")) or 0
	g = math.floor(clamp(g, 0, 1) * 10 + 0.5) / 10
	local old = look:FindFirstChild("FaceGrime")
	if g <= 0.1 or detail ~= "full" then
		if old then
			old:Destroy()
		end
		return
	end
	local L = Head.FaceLayout(head, (app and app.face) or {})
	if faceF and faceF:GetAttribute("FaceStyle") then
		Head.DecalLayout(L)
	end
	local key = string.format("%.1f|%.3f|%.3f", g, head.Size.X, L.browY)
	if old and old:GetAttribute("Key") == key then
		local p = old:FindFirstChildWhichIsA("BasePart")
		local w = p and p:FindFirstChildOfClass("WeldConstraint")
		if w and w.Part0 == head then
			return
		end
	end
	local folder = getFolder(model, "FaceGrime")
	folder:SetAttribute("Key", key)
	local s, hcf = L.s, head.CFrame
	local dirt = Color3.fromRGB(110, 90, 70)
	-- (flat translucent patches lying on the skin)
	local function patch(x, y, w, h, t)
		local cf, size = lens(L, x, y, w, h, 0.0018, 0.85)
		mk(folder, head, "Grime", size, hcf * cf, dirt, "Ellipsoid", SMOOTH, t)
	end
	patch(-0.1 * s.X, L.browY + 0.08 * s.Y, 0.26 * s.X, 0.1 * s.Y, 0.88 - 0.22 * g)
	if g > 0.5 then
		patch(0.3 * s.X, -0.15 * s.Y, 0.16 * s.X, 0.12 * s.Y, 0.9 - 0.22 * g)
	end
end

-- the classic head: the engine's default head (a MeshPart; a dynamic head bakes its face into the mesh, and that
-- texture cannot be removed while the game runs) is swapped once for a plain Part of the same size with the
-- Head SpecialMesh, the classic Roblox head the built face sits on. Builder keeps it at the engine's scale.
local function classicHead(model, head)
	if not head:IsA("MeshPart") then
		return head
	end
	local hum = model:FindFirstChildOfClass("Humanoid")
	local clean = Instance.new("Part")
	clean.Name = "Head"
	clean.Size = head.Size
	clean.Color = head.Color
	clean.Material = head.Material
	clean.CFrame = head.CFrame
	clean.CanCollide = head.CanCollide
	clean.Massless = head.Massless
	clean.TopSurface = Enum.SurfaceType.Smooth
	clean.BottomSurface = Enum.SurfaceType.Smooth
	local hm = Instance.new("SpecialMesh")
	hm.MeshType = Enum.MeshType.Head
	hm.Parent = clean
	for _, c in ipairs(head:GetChildren()) do
		if c:IsA("Attachment") then
			c:Clone().Parent = clean
		end
	end
	local swapped, err = false, "no Humanoid"
	if hum then
		swapped, err = pcall(function()
			hum:ReplaceBodyPartR15(Enum.BodyPartR15.Head, clean)
		end)
	end
	local got = model:FindFirstChild("Head")
	if swapped and got == clean then
		if not clean:FindFirstChildOfClass("SpecialMesh") then
			Head.SwapFailed(model, "the engine dropped the Head SpecialMesh from the classic head")
		end
		-- the Neck must survive the swap whatever joint type the rig uses (Humanoid.RequiresNeck otherwise kills the
		-- character and BreakJointsOnDeath drops every weld): rebuilt from the RigAttachments when it is gone
		local okN, neck = pcall(Head.EnsureNeck, model)
		if okN and neck == "rebuilt" then
			warn("[Boxer] classic head swap on " .. tostring(model.Name) .. " left no Neck joint: a Motor6D Neck was rebuilt from the RigAttachments")
		end
		return clean
	end
	-- the face, the headgear and the caps are built for the classic head's profile: on the engine's MeshPart head
	-- they sit in or off the skull. One Output line per reason
	Head.SwapFailed(model, swapped and ("the model still carries " .. (got and (got.ClassName .. " " .. got.Name) or "no Head")) or tostring(err))
	clean:Destroy()
	pcall(function()
		head.TextureID = ""
	end)
	return head
end
Head.ClassicHead = classicHead

-- the classic head swap did not take (warned once per reason; Head.SwapFailures counts them for tests / the diagnostic)
Head.SwapFailures = 0
local headSwapWarned = {}
function Head.SwapFailed(model, reason)
	Head.SwapFailures += 1
	local inGame = false
	pcall(function()
		inGame = model:IsDescendantOf(game)
	end)
	local key = tostring(reason) .. "|" .. tostring(inGame)
	if headSwapWarned[key] then
		return
	end
	headSwapWarned[key] = true
	warn(string.format("[Boxer] classic head swap did not take on %s: %s; %s (the headgear / face are built for the classic head)",
		tostring(model and model.Name), tostring(reason),
		inGame and "the model is in the DataModel" or "the model is OUTSIDE the DataModel: the engine cannot swap its parts there"))
end

-- a player's avatar face (Builder: the AvatarFace attribute, Config.AvatarLook.face): the head and face the
-- engine put on from the avatar's description stay exactly as they are; no built face. An empty Face folder
-- seals the step's cache (Extra 0: the hair and beard keep their share of the budget)
function Head.AvatarFace(model, _app, opts)
	if not model:FindFirstChild("Head") then
		return
	end
	local folder = getFolder(model, "Face")
	folder:SetAttribute("Detail", (Config.DetailLevel(opts or {})))
	folder:SetAttribute("Extra", 0)
	folder:SetAttribute("Avatar", true)
end

local function faceBuild(model, app, opts, build)
	opts = opts or {}
	app = app or {}
	local head = model:FindFirstChild("Head")
	if not head then
		return
	end
	local face = app.face or Looks.Defaults(app.gender).face
	-- the classic head (the default head's baked face cannot be removed while the game runs), then only the
	-- built face: an engine face decal, an older build's classic-face / damage decals, face controls go
	head = classicHead(model, head)
	for _, d in ipairs(head:GetChildren()) do
		if d:IsA("Decal") or d:IsA("FaceControls") or d:IsA("SurfaceAppearance") then
			d:Destroy()
		end
	end
	if model:GetAttribute("FaceKey") ~= nil then
		model:SetAttribute("FaceKey", nil) -- (the retired classic decal face's key)
	end
	-- a drawn face style: its decal on the head front instead of the built eyes, brows, nose and mouth (every boxer:
	-- DrawnStyleOf falls back to the default drawn face; nil only with no drawn face uploaded)
	local drawn = BodyTiers.DrawnStyleOf(app)
	if drawn then
		putFaceDecal(head, drawn)
	end
	local detail, D = Config.DetailLevel(opts)
	local full, low = detail == "full", detail == "low"
	local folder = getFolder(model, "Face")
	folder:SetAttribute("Detail", detail)
	folder:SetAttribute("FaceStyle", drawn)
	local L = Head.FaceLayout(head, face)
	if drawn then
		Head.DecalLayout(L)
	end
	local s = L.s
	local hcf = head.CFrame
	local skin = skinOf(app)
	local skinL = lum(skin)
	local under = UNDERTONE[face.undertone or "Neutral"] or UNDERTONE.Neutral
	local hairColor = Looks.Color(app.hair and app.hair.color, Color3.fromRGB(30, 22, 18))
	local battle = type(app.battle) == "table" and app.battle or {}
	local female = app.gender == 2
	local age = tonumber(opts.age) or 24
	local FB = Config.BodyFat
	local fat = (type(build) == "table" and tonumber(build.fat)) or FB.default
	local function at(x, y, z)
		return hcf * CF(x, y, z)
	end
	local function add(name, size, cf, color, shape, material, transparency)
		return mk(folder, head, name, size, cf, color, shape or "Ellipsoid", material, transparency)
	end
	local function rig(role, side, name, size, cf, color, shape, material, transparency)
		if not rigOn(detail, role) then
			return add(name, size, cf, color, shape, material, transparency)
		end
		local p = mk(folder, nil, name, size, cf, color, shape or "Ellipsoid", material, transparency)
		local m = joint(head, p, "FaceJoint")
		m:SetAttribute("Role", role)
		if side then
			m:SetAttribute("Side", side)
		end
		CollectionService:AddTag(m, "FaceRig")
		return p
	end
	-- a thin mark lying on the skin, rising `rise` (default 0.0015) above it (Kit.mk's 0.02 floor is its thickness)
	local function line(name, x0, y0, x1, y1, width, color, transparency, rise)
		return surfaceLine(folder, head, head, L, name, x0, y0, x1, y1, width, 0.02, color, transparency, (rise or 0.0015) - 0.01)
	end
	-- a lens on the skin (see lens above); o = { roll, base, mat, t (transparency), anchor, role, side }
	local function lp(name, x, y, w, h, rise, dk, color, o)
		o = o or {}
		local cf, size = lens(L, x, y, w, h, rise, dk, o.roll, o.base)
		cf = hcf * cf
		if o.role then
			return rig(o.role, o.side, name, size, cf, color, "Ellipsoid", o.mat, o.t)
		end
		return mk(folder, o.anchor or head, name, size, cf, color, "Ellipsoid", o.mat, o.t)
	end
	-- skin finish: a pore-heavy or rough skin uses Plastic (a fine grain), smooth skin SmoothPlastic
	head.Material = ((face.smooth or 0.5) >= 0.5 and (face.pores or 0) < 0.5) and SMOOTH or PLASTIC
	head.Reflectance = (face.shine or 0) * 0.03

	-- face shape presets layered on top of the sliders
	local shape = face.shape or "Oval"
	local jawW, jawDef, chin, cheek = face.jawWidth or 0, face.jawDef or 0.5, face.chin or 0, face.cheek or 0
	local chinDrop, chinNarrow, cheekFat, browRidge = 0, 0, 0, 0
	if shape == "Square" then
		jawW += 0.6
		jawDef = math.max(jawDef, 0.85)
	elseif shape == "Diamond" then
		cheek += 0.7
		jawW -= 0.5
		chinNarrow = 0.35
	elseif shape == "Round" then
		cheekFat = 0.8
		jawW += 0.3
		jawDef = math.min(jawDef, 0.2)
	elseif shape == "Long" then
		chinDrop = 0.12
		cheek -= 0.3
	elseif shape == "Heart" then
		browRidge = 0.6
		jawW -= 0.4
		chinNarrow = 0.45
	end
	-- body fat shows in the face first: fuller cheeks, then jowls; lean or weight-cut faces hollow out
	local faceFat = clamp((fat - FB.faceFatAt) / 8, 0, 1)
	local jowl = clamp((fat - FB.jowlsAt) / 7, 0, 1)
	local gaunt = math.max(clamp((FB.gauntBelow + 1 - fat) / 3, 0, 1), clamp(tonumber(opts.dry) or 0, 0, 1))
	local cheekFull = face.cheekFull or 0
	cheekFat = math.max(cheekFat, faceFat * 0.9, cheekFull * 0.8) * (1 - 0.7 * gaunt)
	local hollow = clamp(math.max(gaunt, -cheekFull * 0.8) - cheekFat, 0, 1)
	-- wear a boxer chose plus wear earned in fights (server-only app.battle)
	local cauli = math.max(face.cauliflower or 0, tonumber(battle.ears) or 0)
	local noseBreak = math.max(face.noseBreak or 0, tonumber(battle.nose) or 0)
	local wr = math.max(face.wrinkles or 0, clamp((age - 30) / 26, 0, 1) * 0.85)
	local scarCount = type(battle.scars) == "table" and #battle.scars or 0
	-- optional detail spends from two small budgets so a veteran, aged, pore-heavy face stays inside
	-- the part budget: wear (scars, cauliflower, bent nose) first, then age / skin cosmetics. A spend
	-- also never takes the face past FACE_CAP parts over the old face, leaving the hair its share.
	local budget = { wear = full and 8 or (detail == "medium" and 2 or 0), skin = full and 8 or (detail == "medium" and 1 or 0) }
	local oldParts = oldFaceParts(face, opts)
	local function spend(kind, n)
		if budget[kind] < n or countParts(folder) + n - oldParts > FACE_CAP[detail] then
			return false
		end
		budget[kind] -= n
		return true
	end
	-- optional details are queued and drawn at the end in this order, when every fixed part exists and
	-- the cap check above sees the real count (fn may spend() again for nested extras)
	local queued = {}
	local function opt(kind, n, fn)
		queued[#queued + 1] = { kind, n, fn }
	end
	-- left / right halves of one detail are queued as a pair so a face is never shaded on one side only
	local sides = {}
	local function side2(key, kind, n, fn)
		local entry = sides[key]
		if not entry then
			entry = {}
			sides[key] = entry
			opt(kind, n * 2, function()
				for _, f in ipairs(entry) do
					f()
				end
			end)
		end
		entry[#entry + 1] = fn
	end

	-- Every feature is a lens on the classic head (lens / lp above: an ellipsoid sunk into the skin so only a low
	-- dome of the size asked shows, its rim on the skin): nothing stands off the face or sinks into it. Heights
	-- (rise) are fractions of s.Z: skin sculpt 0.005 .. 0.02, the eye 0.006 .. 0.012, lids and brows ~0.01 .. 0.02,
	-- the nose tip ~0.05 (the one feature that stands out).

	-- ears: a low shell flush on the side wall, inside the arc the hair keeps clear (Kit.CLASSIC_HAIR.ear: centre y
	-- 0.035, z 0.06 nominal), its back edge turned out a little, the darker bowl of the concha in it; cauliflower
	-- lumps fill the upper rim
	local earS = 1 + 0.2 * (face.earSize or 0)
	local earW, earH = 0.13 * s.Z * earS, 0.26 * s.Y * earS
	local earRise = (0.026 + 0.012 * cauli) * s.X
	for side = -1, 1, 2 do
		-- (shellCF's local +X is the back on the right side, the front on the left)
		local ecf = hcf * L.shellCF(side * rad(96), 0.03 * s.Y, 0) * ANG(0, side * rad(10 + 12 * cauli), 0)
		local D = earRise / 0.55
		local f = math.sqrt(1 - 0.45 * 0.45)
		add("Ear", V3(earW / f, earH / f, 2 * D), ecf * CF(0, 0, D - earRise), skin, "Ellipsoid")
		if full then
			-- the concha: a darker hollow toward the front of the ear, just above its surface
			add("EarHelix", V3(earW * 0.5, earH * 0.5, 0.02), ecf * CF(-side * 0.12 * earW, -0.06 * earH, 0.01 - earRise * 0.92 - 0.0015),
				darken(skin, 0.86), "Ellipsoid")
		end
		if cauli > 0.15 and not low then
			local lumps = full and math.min(2, 1 + math.floor(cauli * 2)) or 1
			side2("cauli", "wear", lumps, function()
				for i = 1, lumps do
					local sz = (0.045 + 0.04 * cauli) * s.X * (1 - 0.15 * (i - 1))
					add("Cauliflower", V3(sz, sz * 1.1, sz * 0.8), ecf * CF(side * 0.12 * earW, (0.24 - 0.2 * (i - 1)) * earH, -earRise * 0.7),
						lerpColor(skin, Color3.fromRGB(150, 100, 100), 0.12 + 0.1 * cauli), "Ellipsoid")
				end
			end)
		end
	end
	-- jaw angles: low swells at the corners of the jaw (wider jaws further out, defined jaws higher)
	-- (only on defined or wide jaws: on the round classic head a soft jaw is the head itself)
	local jw = clamp(jawW, -1, 1.6)
	local ja = (female and 0.7 or 1) * (clamp((jawDef - 0.45) / 0.55, 0, 1) + 0.5 * clamp(jw - 0.3, 0, 1))
	if full and ja > 0.2 then
		for side = -1, 1, 2 do
			lp("JawAngle", side * (0.39 + 0.03 * jw) * s.X, -0.33 * s.Y, 0.24 * s.Y, (0.075 + 0.015 * jw) * s.X, (0.002 + 0.008 * ja) * s.Z, 0.6, skin,
				{ roll = side * rad(-48) })
		end
	end
	-- chin: a soft swell on the rounded bottom edge of the head
	local chinY = (-0.385 - 0.025 * chin - chinDrop * 0.5) * s.Y
	local chinRise = (0.0065 + 0.0055 * chin + 0.003 * jawDef) * s.Z
	lp("Chin", 0, chinY + 0.005 * s.Y, (0.24 + 0.07 * chin) * (1 - chinNarrow) * s.X, (0.11 + 0.03 * chin + chinDrop * 0.3) * s.Y, math.max(chinRise, 0.0015), 0.72, skin)
	-- long face: a fuller lower jaw, a lens on the rounded bottom edge of the head. Never a part hung under the head:
	-- the head sits on the tier torso's neck (its base on the Neck pivot), so anything below its base is a lump on the
	-- neck (the old 0.7-wide ellipsoid centred on the base stuck out round the jaw and under it)
	if chinDrop > 0 then
		lp("LowerFace", 0, -0.39 * s.Y, 0.5 * s.X, (0.1 + chinDrop) * s.Y, (0.006 + 0.04 * chinDrop) * s.Z, 0.72, skin)
	end
	if (face.chinCleft or 0) > 0.15 and full then
		opt("skin", 1, function()
			local c = face.chinCleft
			lp("ChinCleft", 0, chinY + 0.005 * s.Y, 0.014 * s.X, (0.05 + 0.05 * c) * s.Y, 0.0015, 0.85, darken(skin, 0.8), { base = chinRise * 0.85, t = 0.75 - 0.35 * c })
		end)
	end
	if jowl > 0.05 and full then
		opt("skin", 2, function()
			for side = -1, 1, 2 do
				add("Jowl", V3(0.2 * s.X, (0.14 + 0.06 * jowl) * s.Y, 0.24 * s.Z), at(side * 0.3 * s.X, -0.38 * s.Y, -0.24 * s.Z), skin, "Ellipsoid")
			end
		end)
	end
	if jowl > 0.3 and not low then
		opt("skin", 1, function()
			-- (a lens under the chin on the head's rounded bottom edge: never below the head's base, on the neck)
			lp("DoubleChin", 0, -0.42 * s.Y, (0.36 + 0.12 * jowl) * s.X, (0.1 + 0.04 * jowl) * s.Y, (0.006 + 0.008 * jowl) * s.Z, 0.75, skin)
		end)
	end
	-- cheekbones and cheeks (lean faces show more bone); below full detail full cheeks replace the bone. The
	-- slider and the Diamond preset reach cheek = 1.7: clamped, so high cheekbones stay a swell
	-- (flat cheeks shade in under the bone; high cheekbones stand out as a long swell up to the ear)
	hollow = math.max(hollow, clamp((-cheek - 0.2) / 0.8, 0, 1) * 0.6)
	local fullCheeks = cheekFat > 0.05 and hollow <= 0.1
	local ck = clamp(cheek, -0.5, 1)
	local boneRise = 0.0075 * clamp((ck - 0.05) / 0.95, 0, 1) + 0.003 * hollow
	if boneRise > 0.0015 and (full or not fullCheeks) then
		for side = -1, 1, 2 do
			lp("Cheekbone", side * 0.33 * s.X, -0.03 * s.Y, (0.26 + 0.03 * ck) * s.X, (0.085 + 0.015 * ck) * s.Y, boneRise * s.Z, 0.78, skin, { roll = side * rad(20) })
		end
	end
	if fullCheeks then
		for side = -1, 1, 2 do
			lp("Cheek", side * 0.37 * s.X, -0.17 * s.Y, 0.26 * s.X, 0.28 * s.Y, (0.005 + 0.008 * math.min(cheekFat, 1)) * s.Z, 0.82, skin)
		end
	end
	if hollow > 0.1 and full then
		for side = -1, 1, 2 do
			lp("Hollow", side * 0.3 * s.X, -0.13 * s.Y, 0.16 * s.X, 0.14 * s.Y, 0.0015, 0.88, darken(skin, 0.8), { t = 0.82 - 0.3 * hollow })
		end
	end
	-- brow ridge: two low swells over the eyes the brows lie on (scar tissue thickens it on veterans); its height
	-- under any point is kept so the brows sit on it, never floating off it or sinking in
	local ridge = math.max(browRidge, (face.forehead or 0) * 0.6, female and 0 or 0.25, math.min(scarCount, 3) * 0.15)
	local ridges = {}
	local function ridgeAt(x, y)
		local best = 0
		for _, r in ipairs(ridges) do
			local q = 1 - ((x - r.x) / r.a) ^ 2 - ((y - r.y) / r.b) ^ 2
			if q > 0 then
				best = math.max(best, r.D * math.sqrt(q) - r.c)
			end
		end
		return best
	end
	local function ridgeLens(x, y, w, h, rise, roll)
		local p = lp("BrowRidge", x, y, w, h, rise, 0.6, skin, { roll = roll })
		local _, size, D, c = lens(L, x, y, w, h, rise, 0.6, roll)
		table.insert(ridges, { x = x, y = y, a = size.X / 2, b = size.Y / 2, D = D, c = c })
		return p
	end
	-- (a heavy brow only: a heart face, a big forehead, scar tissue; an ordinary brow lies on the flat front. Full detail
	-- only: across both brows at a distance it read as a band over the forehead)
	if full and ridge > 0.3 and not drawn then
		for side = -1, 1, 2 do
			-- (no taller than the brow on it, which hides its rim: a taller one drew a second line over the brow)
			local rb = (0.03 + 0.018 * ((face.browThick or 0) + 1)) * s.Y * (BROWS[face.browStyle or "Natural"] or BROWS.Natural).thick
			ridgeLens(side * 0.18 * s.X, L.browY - 0.006 * s.Y, (0.26 + 0.04 * ridge) * s.X, rb * 1.05, (0.002 + 0.01 * (ridge - 0.25)) * s.Z, side * rad(-4))
		end
	end

	-- eyes: set into the head. A shallow white, the iris (limbal ring) and pupil just proud of it, the upper lid a
	-- fold that covers the top of the iris (its edge the lash line), a low lower lid; nothing stands far off the face.
	local eyeColors = {
		[-1] = Looks.Color(Looks.EyeColors[face.eyeColor or 2]),
		[1] = Looks.Color(Looks.EyeColors[(face.eyeColor2 or 0) > 0 and face.eyeColor2 or (face.eyeColor or 2)]),
	}
	local lidColor = darken(skin, 0.92)
	-- whites of the eye are never pure white; they yellow slightly with age
	local scleraColor = lerpColor(Color3.fromRGB(236, 232, 224), Color3.fromRGB(230, 220, 200), clamp((age - 25) / 30, 0, 1))
	local heavy = clamp(face.lidHeavy or 0, 0, 1)
	local brow = BROWS[face.browStyle or "Natural"] or BROWS.Natural
	local browColor = darken(hairColor, 0.88)
	local bt = (0.03 + 0.018 * ((face.browThick or 0) + 1)) * s.Y * brow.thick
	local lashT = 1 - (0.35 + 0.6 * clamp(face.lashes or 0, 0, 1))
	local underEye = full and (wr > 0.3 or heavy > 0.6)
	local w, h = L.eyeW, L.eyeHt
	local rWhite, rLimb, rIris, rPupil, rGlint = 0.006 * s.Z, 0.0088 * s.Z, 0.0095 * s.Z, 0.0104 * s.Z, 0.0116 * s.Z
	local browInfo = {}
	-- (a drawn face style: the eyes and brows are its decal; none of these parts or their rig joints)
	if not drawn then
		for side = -1, 1, 2 do
			local roleSide = side == -1 and "L" or "R"
			local x0, y0 = side * L.eyeX, L.eyeYS[side]
			-- eye frame: canthal tilt raises the outer corner
			local roll = side * L.eyeTilt
			local cr, sr = math.cos(roll), math.sin(roll)
			local function ep(dx, dy)
				return x0 + dx * cr - dy * sr, y0 + dx * sr + dy * cr
			end
			local ef = surfCF(L, x0, y0, 0) * ANG(0, 0, roll)
			local eyeColor = eyeColors[side]
			local scf, ssz, sD, sc = lens(L, x0, y0, w, h, rWhite, 0.72, roll)
			local sclera = add("Sclera", ssz, hcf * scf, scleraColor, "Ellipsoid")
			sclera:SetAttribute("BaseColor", scleraColor)
			sclera:SetAttribute("Side", side)
			sclera:SetAttribute("VisW", w)
			sclera:SetAttribute("VisH", h)
			local sa, sb = ssz.X / 2, ssz.Y / 2
			local function hWhite(u, v)
				local q = 1 - (u / sa) ^ 2 - (v / sb) ^ 2
				return q > 0 and sD * math.sqrt(q) - sc or 0
			end
			-- iris, limbal ring and pupil ride on an invisible EyeBall pivot behind the eye so the client can turn the
			-- gaze; the catchlight stays fixed to the head like a real reflection. Each is shaped (across and up apart)
			-- so its rim meets the white in a circle.
			local rho = 0.5 * math.min(0.58 * w, 0.98 * h)
			local holder = head
			if rigOn(detail, "Eye" .. roleSide) then
				holder = rig("Eye" .. roleSide, side, "EyeBall", V3(0.04, 0.04, 0.04), hcf * ef * CF(0, 0, 0.03), scleraColor, "Ball", SMOOTH, 1)
				holder:SetAttribute("Side", side)
			end
			local iD = rIris + 0.004 * s.Z
			local iax = capOn(rIris, rho, hWhite(rho, 0), iD)
			local iay, _, ic = capOn(rIris, rho, hWhite(0, rho), iD)
			local function hIris(u, v)
				local q = 1 - (u / iax) ^ 2 - (v / iay) ^ 2
				return q > 0 and iD * math.sqrt(q) - ic or 0
			end
			if full then
				local lD = rLimb + 0.004 * s.Z
				local lax = capOn(rLimb, rho * 1.13, hWhite(rho * 1.13, 0), lD)
				local lay, _, lc = capOn(rLimb, rho * 1.13, hWhite(0, rho * 1.13), lD)
				mk(folder, holder, "Limbal", V3(2 * lax, 2 * lay, 2 * lD), hcf * ef * CF(0, 0, lc), darken(eyeColor, 0.45), "Ellipsoid")
			end
			local iris = mk(folder, holder, "Iris", V3(2 * iax, 2 * iay, 2 * iD), hcf * ef * CF(0, 0, ic), eyeColor, "Ellipsoid")
			iris:SetAttribute("VisW", 2 * rho)
			local pr = rho * 0.44
			local pD = rPupil + 0.003 * s.Z
			local pax = capOn(rPupil, pr, hIris(pr, 0), pD)
			local pay, _, pc = capOn(rPupil, pr, hIris(0, pr), pD)
			mk(folder, holder, "Pupil", V3(2 * pax, 2 * pay, 2 * pD), hcf * ef * CF(0, 0, pc), Color3.fromRGB(10, 9, 10), "Ellipsoid")
			local gx, gy = side * rho * 0.28, rho * 0.3
			local ga, gD, gc = capOn(rGlint, rho * 0.15, hIris(gx, gy) + 0.0006, 0.01)
			local glint = add("Glint", V3(2 * ga, 2 * ga, 2 * gD), hcf * ef * CF(gx, gy, gc), WHITE, "Ellipsoid")
			glint:SetAttribute("Side", side) -- (SetDamage hides it while a swollen lid has the eye shut)
			-- upper lid: a fold over the top of the eye; its lower edge (where it meets the eye) is the lid line, at 0.3 of
			-- the eye's height above its middle (hooded lids come lower). CloseY: how far that edge travels to shut the eye
			-- (FaceFX); damage swelling hides it
			local lidLine = h * (0.36 - 0.2 * heavy)
			local lb = (h * 0.98 - lidLine) / 1.75
			local lx, ly = ep(0, lidLine + 0.8 * lb)
			local lid = lp("Lid", lx, ly, w * 1.16, 1.9 * lb, (0.0128 + 0.005 * heavy) * s.Z, 0.3, lidColor, { roll = roll, role = "Lid" .. roleSide, side = side })
			lid:SetAttribute("Side", side)
			lid:SetAttribute("CloseY", lidLine + h * 0.5)
			if not low then
				-- the lash line along the lid's edge, welded to the lid so it follows a blink or squint
				local ax, ay = ep(0, lidLine)
				local lashes = lp("Lashes", ax, ay, w * 1.05, (0.011 + 0.008 * clamp(face.lashes or 0, 0, 1)) * s.Y, 0.0122 * s.Z, 0.5,
					Color3.fromRGB(18, 13, 11), { roll = roll, anchor = lid, t = math.max(0.08, lashT) })
				lashes:SetAttribute("BaseT", lashes.Transparency)
				lashes:SetAttribute("Side", side)
			end
			if full then
				-- the lid crease shows on hooded and ageing lids
				if heavy > 0.3 or wr > 0.4 then
					side2("crease", "skin", 1, function()
						local cx, cy = ep(0, h * 1.0)
						lp("Crease", cx, cy, w * 0.95, 0.01 * s.Y, 0.0015, 0.8, darken(skin, 0.74), { roll = roll, t = 0.45 + 0.4 * heavy })
					end)
				end
				-- lower lid: a low rim under the eye with the wet line in its colour, rigged for squints
				local ux, uy = ep(0, -h * 0.56)
				local lower = lp("LowerLid", ux, uy, w * 1.0, h * 0.28, 0.008 * s.Z, 0.45,
					lerpColor(lerpColor(lidColor, skin, 0.5), Color3.fromRGB(226, 160, 158), 0.12), { roll = roll, role = "LowerLid" .. roleSide, side = side })
				lower:SetAttribute("Side", side)
			end
			if not low then
				-- the closed lid the client shows for a blink (never the Lid, which SetDamage hides)
				local kx, ky = ep(0, h * 0.04)
				local blink = lp("BlinkLid", kx, ky, w * 1.14, h * 1.18, 0.0165 * s.Z, 0.5, lerpColor(lidColor, skin, 0.4), { roll = roll, t = 1 })
				blink:SetAttribute("Side", side)
			end
			if underEye then
				side2("underEye", "skin", 1, function()
					local ux, uy = ep(0, -h * 0.92)
					lp("UnderEye", ux, uy, w * 1.1, h * 0.5, 0.0015, 0.86, darken(skin, 0.82), { roll = roll, t = 0.82 - 0.3 * wr })
				end)
			end
			-- eyebrow: a solid strip on the brow ridge in three overlapping pieces along the style's arch (inner head,
			-- body, tapering tail); the body is the rigged part, the others are welded to it. Below full detail the body
			-- alone spans the brow.
			local bx = side * L.eyeX * 1.02
			local by = L.browY + (L.eyeYS[side] - L.eyeY)
			local tilt = side * ((face.browAngle or 0) * rad(9)) + L.browTiltS[side]
			local blen = 0.21 * s.X * brow.len
			local ar = brow.arch
			local ct, st = math.cos(tilt), math.sin(tilt)
			-- a point along the brow: t -0.5 (inner end) .. 0.5 (tail), its height on the arch
			local function bpt(t)
				local dy
				-- (the arch's peak on the brow line: the hair's front edge keeps clear of it, ref/classic browTop)
				if t <= 0.1 then
					dy = bt * (-0.5 * ar * ((t - 0.1) / 0.6) ^ 2)
				else
					dy = bt * (-(0.25 + 1.15 * ar) * ((t - 0.1) / 0.4) ^ 2)
				end
				local dx = side * t * blen
				return bx + dx * ct - dy * st, by + dx * st + dy * ct
			end
			local browRise = (0.0055 + 0.003 * brow.thick) * s.Z
			local function seg(name, t0, t1, thick, anchorPart)
				local xa, ya = bpt(t0)
				local xb, yb = bpt(t1)
				local xm, ym = bpt((t0 + t1) / 2)
				local cx, cy = (xa + xb) / 2 * 0.5 + xm * 0.5, (ya + yb) / 2 * 0.5 + ym * 0.5
				local dx, dy = xb - xa, yb - ya
				local len = math.sqrt(dx * dx + dy * dy)
				local base = 0.5 * (math.min(ridgeAt(xa, ya), ridgeAt(xb, yb)) + ridgeAt(cx, cy))
				local sg = dx < 0 and -1 or 1
				local o = { roll = math.atan2(dy * sg, dx * sg), base = base, mat = FABRIC }
				if anchorPart then
					o.anchor = anchorPart
				else
					o.role, o.side = "Brow" .. roleSide, side
				end
				return lp(name, cx, cy, len * 1.1, thick, browRise, 0.4, browColor, o), base
			end
			local browPart, bBase
			if full then
				browPart, bBase = seg("Brow", -0.3, 0.32, bt * 0.94)
				seg("BrowInner", -0.5, 0.0, bt * (1 + 0.08 * brow.thick), browPart)
				seg("BrowOuter", 0.15, 0.5, bt * brow.taper * 0.8, browPart)
			else
				browPart, bBase = seg("Brow", -0.5, 0.5, bt * 0.9)
			end
			browPart:SetAttribute("Side", side)
			browInfo[side] = { part = browPart, base = bBase, rise = browRise, y = by }
		end
	end

	-- nose: a bridge running down from between the eyes into a rounded tip, the alar wings either side of it and the
	-- nostrils under it; a broken nose sits flatter, wider and bent
	local bend = (Random.new((face.seed or 7) + 303):NextNumber() < 0.5) and -1 or 1
	local nW = L.noseW * (1 + 0.2 * noseBreak)
	local proj = L.noseB * (0.56 - 0.14 * noseBreak) -- how far the tip stands off the face
	local dev = L.noseDev + 0.03 * noseBreak * bend * s.X
	local noseCol = darken(skin, 0.97)
	local nroll = rad(-7 * noseBreak * bend)
	local tipY = L.noseBottomY + nW * 0.3
	-- the bridge: a narrow ridge pitched out of the face, sunk into the forehead at the top, meeting the tip below
	local bTop, bBot = L.noseTopY + 0.03 * s.Y, tipY + nW * 0.05
	local ay = (bTop - bBot) * 0.56
	local pitch = math.atan2(0.4 * proj, ay)
	local bD = 0.5 * proj
	if not drawn then
		local nose = add("Nose", V3(nW * (0.62 + 0.1 * noseBreak), 2 * ay, 2 * bD),
			hcf * surfCF(L, dev * 0.5, (bTop + bBot) / 2, 0) * ANG(0, 0, nroll) * ANG(pitch, 0, 0) * CF(0, 0, 0.1 * proj), noseCol, "Ellipsoid")
		nose:SetAttribute("Base", true)
		-- the tip: a rounded ball whose back sinks into the face (the overhang under it is the columella's shadow)
		local tD = proj * 0.55
		add("NoseTip", V3(nW * (full and 0.76 or 0.88), nW * 0.52, 2 * tD), hcf * surfCF(L, dev, tipY, proj - tD) * ANG(0, 0, nroll), noseCol, "Ellipsoid")
		if full then
			for side = -1, 1, 2 do
				add("NoseWing", V3(nW * 0.44, nW * 0.4, 0.64 * proj), hcf * surfCF(L, dev + side * nW * 0.38, L.noseBottomY + nW * 0.2, 0.08 * proj) * ANG(0, 0, side * rad(-20)),
					darken(skin, 0.95), "Ellipsoid")
				add("Nostril", V3(nW * 0.26, nW * 0.11, 0.24 * proj), hcf * surfCF(L, dev + side * nW * 0.18, L.noseBottomY + 0.012 * s.Y, 0.24 * proj) * ANG(0, 0, side * rad(-15)),
					darken(skin, 0.42), "Ellipsoid")
			end
		end
		if noseBreak > 0.3 and full then
			opt("wear", 1, function()
				add("NoseBump", V3(nW * 0.5, L.noseLen * 0.2, 0.25 * proj), hcf * surfCF(L, dev * 0.3, L.noseTopY - L.noseLen * 0.32, 0.12 * proj), noseCol, "Ellipsoid")
			end)
		end
	end
	-- nasolabial folds: deepen with age, fat and a big smile line
	if full and not drawn then
		local fold = clamp(0.3 + 0.5 * wr + 0.25 * faceFat, 0, 1)
		for side = -1, 1, 2 do
			line("Nasolabial", dev + side * nW * 0.6, L.noseBottomY + nW * 0.12, side * L.mouthW * 0.6, L.mouthY - 0.02 * s.Y,
				(0.012 + 0.008 * fold) * s.X, darken(skin, 0.78), 0.86 - 0.35 * fold, 0.0012)
		end
	end

	-- mouth: two low lips that overlap at the seam (so nothing behind them shows until they part), the dark seam line
	-- riding on the upper lip, corner pieces of that line (rigged: they curl up in a smile), and behind them the
	-- interior and teeth (full). A mouthguard parts the lips.
	local guard = (opts.mouthguard and not drawn) and true or false -- (a drawn mouth wears no guard lens)
	local lt = face.lips or 0
	local mw = L.mouthW
	local upperH = (0.032 + 0.016 * lt + (female and 0.006 or 0)) * s.Y
	local lowerH = (0.042 + 0.02 * lt + (female and 0.008 or 0)) * s.Y
	local gap = guard and 0.03 * s.Y or 0
	local bulge = guard and 0.004 * s.Z or 0
	local mroll = L.mouthTilt
	local mcr, msr = math.cos(mroll), math.sin(mroll)
	local function mp(dx, dy)
		return dx * mcr - dy * msr, L.mouthY + dx * msr + dy * mcr
	end
	-- pigmented lips: a shade of the skin, darker on deep skin tones, a little rosier on light ones
	local lipColor = lerpColor(darken(skin, 0.86 + 0.08 * skinL), under, 0.1 + 0.22 * skinL + (female and 0.08 or 0))
	local seamRise = (0.0085 + 0.003 * lt) * s.Z + bulge
	if full and not drawn then
		local ix, iy = mp(0, -gap * 0.5)
		local inside = lp("MouthInside", ix, iy, mw * 0.8, (upperH + lowerH) * 0.55 + gap, 0.003 * s.Z, 0.6, Color3.fromRGB(62, 20, 24),
			{ roll = mroll, role = "MouthInside" })
		local tx, ty = mp(0, upperH * 0.05 - gap * 0.3)
		lp("TeethUpper", tx, ty, mw * 0.56, upperH * 0.75, 0.0045 * s.Z, 0.6, Color3.fromRGB(232, 226, 208), { roll = mroll })
		local qx, qy = mp(0, -gap - lowerH * 0.22)
		lp("TeethLower", qx, qy, mw * 0.5, lowerH * 0.5, 0.0042 * s.Z, 0.6, Color3.fromRGB(222, 214, 194), { roll = mroll, anchor = inside })
	end
	-- (a drawn face style draws its own mouth: no lips, seam, corners, philtrum or lip fold)
	if not drawn then
		local ux, uy = mp(0, upperH * 0.32 + gap * 0.5)
		local upper = lp("UpperLip", ux, uy, mw, upperH * 1.3, (0.0095 + 0.004 * lt) * s.Z + bulge, 0.55, lipColor, { roll = mroll, role = "UpperLip" })
		local lx, ly = mp(0, -lowerH * 0.38 - gap * 0.5)
		local lower = lp("LowerLip", lx, ly, mw * 0.84, lowerH * 1.2, (0.012 + 0.005 * lt) * s.Z + bulge, 0.55, lerpColor(lipColor, WHITE, 0.04),
			{ roll = mroll, role = "LowerLip" })
		upper:SetAttribute("BaseSize", upper.Size)
		upper:SetAttribute("VisW", mw)
		lower:SetAttribute("BaseSize", lower.Size)
		local sx, sy = mp(0, -gap * 0.5)
		local mline = lp("MouthLine", sx, sy, mw * 0.88, 0.008 * s.Y, seamRise, 0.5, darken(lipColor, 0.45), { roll = mroll, anchor = upper, t = guard and 0.7 or 0 })
		mline:SetAttribute("BaseSize", mline.Size)
		-- a beard covering the mouth pushes the lips out so they show through it. The face does this itself
		-- (the same rule beardBuild applies from BaseSize) so a face-only rebuild, e.g. after a body fat
		-- change while the beard is cached, never buries the lips.
		local bStyle = beardStyle(app)
		if bStyle and bStyle ~= "Stubble" then
			for _, p in ipairs({ upper, lower, mline }) do
				p.Size = p:GetAttribute("BaseSize") + V3(0, 0, 0.03)
			end
		end
		if full then
			for side = -1, 1, 2 do
				local cx, cy = mp(side * mw * 0.4, -gap * 0.5)
				local corner = lp("MouthCorner", cx, cy, mw * 0.26, 0.01 * s.Y, seamRise + 0.0008, 0.5, darken(lipColor, 0.42),
					{ roll = mroll, role = "MouthCorner" .. (side == -1 and "L" or "R"), side = side })
				corner:SetAttribute("Side", side)
			end
			-- philtrum groove and the fold under the lower lip
			local py0 = L.noseBottomY - 0.004 * s.Y
			local py1 = L.mouthY + upperH * 1.0
			if py0 > py1 then
				opt("skin", 1, function()
					lp("Philtrum", dev * 0.5, (py0 + py1) / 2, 0.05 * s.X, py0 - py1, 0.0015, 0.88, darken(skin, 0.88), { t = 0.6 })
				end)
			end
			opt("skin", 1, function()
				line("LipFold", -mw * 0.26, L.mouthY - lowerH * 1.25 - gap, mw * 0.26, L.mouthY - lowerH * 1.25 - gap, 0.012 * s.Y, darken(skin, 0.8), 0.6, 0.0012)
			end)
		end
	end

	-- skin details (deterministic from the face seed; draw order is load-bearing, keep it)
	local rng = Random.new(face.seed or 7)
	-- a mark on the skin: flat (rise ~0.001) unless it is a raised spot
	local function spot(name, size, color, xMin, xMax, yMin, yMax, transparency, skip, rise)
		local x = rng:NextNumber(xMin, xMax) * s.X * (rng:NextNumber() < 0.5 and -1 or 1)
		local y = rng:NextNumber(yMin, yMax) * s.Y
		if skip or (drawn and Head.DecalInkHit(L, x, y, size.X, size.Y)) then
			return nil
		end
		return lp(name, x, y, size.X, size.Y, rise or 0.001, rise and 0.5 or 0.85, color, { t = transparency })
	end
	local freck = math.floor((face.freckles or 0) * 26)
	for i = 1, freck do
		local sz = rng:NextNumber(0.018, 0.03)
		spot("Freckle", V3(sz, sz, 0.01), darken(skin, 0.72), 0.06, 0.34, -0.1, 0.06, 0.25, i > (D.freckles or 26))
	end
	for _ = 1, math.floor(face.moles or 0) do
		spot("Mole", V3(0.032, 0.032, 0.015), darken(skin, 0.35), 0.1, 0.36, -0.32, 0.25, nil, nil, 0.004)
	end
	for _ = 1, math.floor(face.scars or 0) do
		local x = rng:NextNumber(0.08, 0.32) * s.X * (rng:NextNumber() < 0.5 and -1 or 1)
		local y = rng:NextNumber(-0.12, 0.3) * s.Y
		local a = math.rad(rng:NextNumber(-40, 40))
		local len = rng:NextNumber(0.1, 0.2) * s.Y
		if drawn and Head.DecalInkHit(L, x, y, 0.016, len) then
			continue
		end
		lp("Scar", x, y, 0.016, len, 0.0015, 0.8, lerpColor(skin, Color3.fromRGB(235, 190, 190), 0.55), { roll = a })
	end
	-- acne: inflamed spots on a young face; from the mid twenties (or with heavy acne) what is left are
	-- pitted scars, slightly darker shallow dents rather than red bumps. Same rng draws either way. An
	-- unknown age (Creator preview) keeps the spots the player is choosing.
	local acneScars = (tonumber(opts.age) or 0) >= 25 or (face.acne or 0) > 0.6
	for i = 1, math.floor((face.acne or 0) * 14) do
		if acneScars and i % 3 ~= 0 then
			spot("AcneScar", V3(0.03, 0.026, 0.008), darken(skin, 0.86), 0.05, 0.36, -0.32, 0.32, 0.55, low)
		else
			spot("Acne", V3(0.024, 0.024, 0.012), lerpColor(skin, Color3.fromRGB(190, 60, 60), 0.5), 0.05, 0.36, -0.32, 0.32, nil, low, 0.003)
		end
	end
	if (face.marks or 0) > 0.05 then
		local sz = 0.08 + 0.14 * face.marks
		spot("Birthmark", V3(sz, sz * 0.7, 0.01), lerpColor(skin, Color3.fromRGB(150, 70, 70), 0.35), 0.15, 0.32, -0.2, 0.25, 0.35)
	end

	-- v2 skin detail stream (separate so the stream above never shifts)
	local r2 = Random.new((face.seed or 7) + 202)
	local scarColor = lerpColor(skin, Color3.fromRGB(236, 196, 192), 0.5)
	-- permanent fight scars where the cuts happened
	if full and type(battle.scars) == "table" then
		for i, sc in ipairs(battle.scars) do
			if i <= 6 and type(sc) == "table" then
				opt("wear", 1, function()
					local side = (tonumber(sc.side) or 1) < 0 and -1 or 1
					local t = clamp(tonumber(sc.at) or 0.5, 0, 1)
					local size = clamp(tonumber(sc.size) or 0.5, 0, 1)
					local len = (0.06 + 0.1 * size) * s.Y
					local kind = sc.kind
					local x, y, ang = side * L.eyeX * (0.55 + 0.7 * t), L.browY + 0.01 * s.Y, side * rad(70)
					if kind == "cheek" then
						x, y, ang = side * (0.2 + 0.12 * t) * s.X, -0.06 * s.Y, side * rad(20)
					elseif kind == "nose" then
						x, y, ang = side * 0.015 * s.X, L.noseTopY - t * L.noseLen * 0.55, rad(80)
					elseif kind == "lip" then
						x, y, ang = side * mw * 0.3 * t, L.mouthY + upperH * 1.3, rad(95)
					elseif kind == "chin" then
						x, y, ang = side * 0.09 * t * s.X, chinY + 0.02 * s.Y, rad(15 * side)
					end
					local dx, dy = math.cos(ang) * len * 0.5, math.sin(ang) * len * 0.5
					line("BattleScar", x - dx, y - dy, x + dx, y + dy, (0.012 + 0.01 * size) * s.X, scarColor, 0.1, 0.002 + ((kind == "brow" or kind == nil) and ridgeAt(x, y) or 0))
					if (kind == "brow" or kind == nil) and not drawn and spend("wear", 1) then
						-- the hair never grows back through a brow scar: a skin-coloured notch over the brow
						local bi = browInfo[side]
						lp("BrowGap", x, bi.y, 0.02 * s.X, bt * 1.5, bi.base + bi.rise + 0.002, 0.5, skin, { anchor = bi.part })
					end
				end)
			end
		end
	end
	-- a surgically repaired cut: a straight, pale scar over the brow with the cross-marks the stitches
	-- left ("railroad tracks"); for a chosen scarred face or a boxer who has been cut more than once
	if full and ((face.scars or 0) >= 1 or scarCount >= 2) then
		local r3 = Random.new((face.seed or 7) + 204)
		local side = r3:NextNumber() < 0.5 and -1 or 1
		local x0 = side * L.eyeX * r3:NextNumber(0.45, 0.7)
		local x1 = side * L.eyeX * r3:NextNumber(1.25, 1.5)
		local y0 = L.browY + r3:NextNumber(0.03, 0.05) * s.Y
		local y1 = y0 + r3:NextNumber(-0.03, 0.02) * s.Y
		opt("skin", 4, function()
			line("SurgicalScar", x0, y0, x1, y1, 0.011 * s.X, scarColor, 0.05, 0.002 + ridgeAt((x0 + x1) / 2, (y0 + y1) / 2))
			local dx, dy = x1 - x0, y1 - y0
			local len = math.sqrt(dx * dx + dy * dy)
			local nx, ny = -dy / len * 0.016 * s.Y, dx / len * 0.016 * s.Y
			for k = 1, 3 do
				local px, py = x0 + dx * k / 4, y0 + dy * k / 4
				line("Suture", px - nx, py - ny, px + nx, py + ny, 0.006 * s.X, lerpColor(scarColor, WHITE, 0.15), 0.15, 0.003 + ridgeAt(px, py))
			end
		end)
	end
	-- wrinkles with age (forehead lines, crow's feet)
	if D.wrinkles and full and wr > 0.25 then
		opt("skin", 2, function()
			local lines = (wr > 0.75 and spend("skin", 2)) and 2 or 1
			for i = 1, lines do
				local yy = L.browY + (0.08 + 0.05 * i) * s.Y
				local wob = r2:NextNumber(-0.01, 0.01) * s.Y
				for side = -1, 1, 2 do
					line("ForeheadLine", side * 0.01 * s.X, yy + wob, side * (0.22 - 0.03 * i) * s.X, yy - 0.012 * s.Y, 0.01 * s.Y, darken(skin, 0.8), 0.86 - 0.3 * wr, 0.001)
				end
			end
			if wr > 0.35 and spend("skin", 2) then
				for side = -1, 1, 2 do
					local x0 = side * (L.eyeX + 0.1 * s.X)
					line("CrowFeet", x0, L.eyeY + 0.01 * s.Y, x0 + side * 0.06 * s.X, L.eyeY - 0.015 * s.Y + r2:NextNumber(-0.01, 0.01) * s.Y, 0.008 * s.Y, darken(skin, 0.8), 0.86 - 0.3 * wr, 0.001)
				end
			end
		end)
	end
	-- pores: textures are not possible here, so a pore-heavy skin gets a grainy material (above)
	-- plus a few sparse darker dots on the nose and cheeks at full detail
	if full and (face.pores or 0) > 0.3 then
		opt("skin", 0, function()
			local n = math.min(5, math.floor((face.pores - 0.3) / 0.7 * 5 + 0.5))
			for _ = 1, n do
				if not spend("skin", 1) then
					break
				end
				local x = r2:NextNumber(-0.28, 0.28) * s.X
				local y = r2:NextNumber(-0.14, 0.02) * s.Y
				if not (drawn and Head.DecalInkHit(L, x, y, 0.014, 0.014)) then
					lp("Pore", x, y, 0.014, 0.014, 0.001, 0.85, darken(skin, 0.8), { t = 0.6 })
				end
			end
		end)
	end
	-- veins the client reveals during effort / anger / heavy sweat; leaner faces show them more
	if full then
		local veinColor = lerpColor(darken(skin, 0.86), Color3.fromRGB(70, 92, 140), 0.18)
		local vis = clamp(0.62 - 0.25 * clamp((FB.defZero - fat) / (FB.defZero - FB.defFull), 0, 1), 0.3, 0.7)
		-- one temple (seeded side) and the classic diagonal forehead vein on the other
		local vs = (Random.new((face.seed or 7) + 203):NextNumber() < 0.5) and -1 or 1
		local veins = {
			line("TempleVein", vs * 0.36 * s.X, L.browY + 0.02 * s.Y, vs * 0.33 * s.X, L.browY + 0.14 * s.Y, 0.014 * s.X, veinColor, 1, 0.0028),
			line("ForeheadVein", -vs * 0.07 * s.X, L.browY + 0.05 * s.Y, -vs * 0.1 * s.X, L.browY + 0.19 * s.Y, 0.014 * s.X, veinColor, 1, 0.0028),
		}
		for _, v in ipairs(veins) do
			v:SetAttribute("BaseTransparency", vis)
		end
	end
	-- mouthguard sits at teeth depth, showing between the parted lips. Head.SetDamage tints it after a
	-- split lip (from BaseColor), so in-fight damage shows without a face rebuild.
	if guard then
		local mg = Looks.Color(app.attire and app.attire.mouthguard, Color3.fromRGB(40, 80, 200))
		local gx, gy = mp(0, -gap * 0.5)
		local mgPart = lp("Mouthguard", gx, gy, mw * 0.86, gap * 1.4 + (0.012 + 0.004 * lt) * s.Y, 0.0062 * s.Z, 0.6, mg, { roll = mroll })
		mgPart:SetAttribute("BaseColor", mg)
	end

	-- optional details, in priority order, while the budget lasts
	for _, q in ipairs(queued) do
		if spend(q[1], q[2]) then
			q[3]()
		end
	end
	-- what the damage marks lie on (Head.SetDamage: a bruise over a full cheek, a split in the lower lip)
	folder:SetAttribute("CheekRise", math.max(boneRise, fullCheeks and (0.005 + 0.008 * math.min(cheekFat, 1)) or 0) * s.Z * 0.6)
	folder:SetAttribute("RidgeRise", ridgeAt(L.eyeX, L.browY + 0.03 * s.Y))
	folder:SetAttribute("LowerLipRise", drawn and 0 or (0.012 + 0.005 * lt) * s.Z + bulge)
	folder:SetAttribute("LipColor", lipColor)
	-- parts over the old face (the hair and beard steps read this to share A's budget)
	folder:SetAttribute("Extra", countParts(folder) - oldParts)
	-- grime lives in its own folder (Head.SetSweat refreshes it); a grime opt rides on the face folder
	folder:SetAttribute("OptGrime", tonumber(opts.grime))
	faceGrime(model, app)
end

------------------------------------------------------------------------
-- Beard
------------------------------------------------------------------------
local function beardBuild(model, app, opts)
	opts = opts or {}
	app = app or {}
	local head = model:FindFirstChild("Head")
	if not head then
		return
	end
	local folder = getFolder(model, "Beard")
	local face = model:FindFirstChild("BoxerLook") and model.BoxerLook:FindFirstChild("Face")
	-- lips back to their own size (a previous beard build may have pushed them out)
	if face then
		for _, c in ipairs(face:GetChildren()) do
			local bs = c:GetAttribute("BaseSize")
			if bs and c:IsA("BasePart") then
				c.Size = bs
			end
		end
	end
	local detail = Config.DetailLevel(opts)
	local full, low = detail == "full", detail == "low"
	-- growth stages without a chosen style: shadow -> stubble -> a short natural beard (beardStyle)
	local style, shadow, g, grown = beardStyle(app)
	-- the lips follow the full-detail rule at every detail level, exactly as faceBuild pushes them
	local coversLips = style ~= nil and style ~= "Stubble"
	if style and low and grown then
		-- far away a five o'clock shadow is invisible and a grown-in beard reads as stubble (old budget)
		if shadow then
			style = nil
		elseif style == "Short Boxed" then
			style, g = "Stubble", 1
		end
	end
	if not style then
		folder:SetAttribute("Extra", 0 - oldBeardParts(app))
		return
	end
	local beard = app.beard or {}
	local s = head.Size
	local hcf = head.CFrame
	local L = Head.FaceLayout(head, app.face or {})
	if Head.FaceStyle(model) then
		Head.DecalLayout(L) -- (the moustache over the drawn mouth; the beard's cache key holds the style)
	end
	local hair = app.hair or {}
	local color = Looks.Color(beard.color or hair.color, Color3.fromRGB(25, 20, 18))
	-- salt & pepper: beards grey before the hair does
	local age = tonumber(opts.age) or 24
	local grey = clamp((age - 38) / 25, 0, 0.6)
	if grey > 0 then
		color = lerpColor(color, Color3.fromRGB(165, 162, 158), grey * 0.55)
	end
	local htype = hair.type or "Straight"
	local mat = (htype == "Kinky" or htype == "Coiled") and SAND or FABRIC
	-- part cap: the old beard plus what the face and hair left of A's budget (both are built first)
	local old = oldBeardParts(app)
	local cap = old + A_BUDGET[detail] - extraOf(model, "Face", FACE_CAP[detail]) - extraOf(model, "Hair", 0)
	local function fits(n)
		return countParts(folder) + n <= cap
	end
	local function at(x, y, z)
		return hcf * CF(x, y, z)
	end
	local function add(name, size, cf, col, shape, material, transparency)
		return mk(folder, head, name, size, cf, col or color, shape or "Ellipsoid", material or mat, transparency)
	end
	local mw = L.mouthW
	local function moustache(width, drop)
		if full and fits(2) then
			-- two halves angled down toward the mouth corners
			for side = -1, 1, 2 do
				add("Moustache", V3((width or 0.17) * s.X, (0.045 + 0.03 * g) * s.Y, 0.06 * s.Z),
					at(side * 0.075 * s.X, L.mouthY + 0.062 * s.Y, L.front(side * 0.075 * s.X) - 0.025) * ANG(0, 0, L.mouthTilt + side * math.rad(-(drop or 10))))
			end
		else
			-- one centred bar (medium / low detail, or no room left)
			add("Moustache", V3(((width or 0.17) + 0.13) * s.X, (0.045 + 0.03 * g) * s.Y, 0.06 * s.Z),
				at(0, L.mouthY + 0.064 * s.Y, L.front(0) - 0.025) * ANG(0, 0, L.mouthTilt))
		end
	end
	local function chinPatch(w, h, y)
		add("Goatee", V3(w * s.X, (h + 0.08 * g) * s.Y, 0.16 * s.Z), at(0, (y or -0.44) * s.Y, L.front(0) * 0.82))
	end
	-- optional pieces, drawn after the style's own parts while the cap leaves room
	local wantSideburns, wantNeck, neckT = false, false, nil
	if style == "Stubble" then
		-- front-biased shell: covers the jaw, chin and upper lip but never the back of the head
		local t = shadow and 0.9 or (0.8 - 0.12 * g)
		-- (top edge kept under the cheekbones: a shell up to the eyes read as a mask)
		add("Stubble", V3(s.X * 1.05, s.Y * 0.42, s.Z * 0.99), at(0, -0.33 * s.Y, -0.07 * s.Z), color, "Ellipsoid", SMOOTH, t)
		wantNeck, neckT = true, math.min(0.95, t + 0.05)
	elseif style == "Goatee" then
		chinPatch(0.24, 0.2)
		moustache()
	elseif style == "Van Dyke" then
		-- pointed chin beard and a moustache that does not connect to it
		add("Goatee", V3(0.2 * s.X, (0.22 + 0.08 * g) * s.Y, 0.15 * s.Z), at(0, -0.46 * s.Y, L.front(0) * 0.8), color, "Ellipsoid")
		if not low then
			add("SoulPatch", V3(0.06 * s.X, 0.06 * s.Y, 0.05 * s.Z), at(0, L.mouthY - 0.085 * s.Y, L.front(0) - 0.02))
		end
		moustache(0.16, 18)
	elseif style == "Circle Beard" then
		chinPatch(0.26, 0.18)
		moustache()
		-- the ring around the mouth joining moustache and chin
		if not low then
			for side = -1, 1, 2 do
				local x = side * mw * 0.62
				add("CircleSide", V3(0.05 * s.X, 0.16 * s.Y, 0.05 * s.Z), at(x, L.mouthY - 0.03 * s.Y, L.front(x) - 0.012) * ANG(0, 0, side * math.rad(8)))
			end
		end
	elseif style == "Moustache" then
		moustache()
	elseif style == "Chin Strap" then
		for side = -1, 1, 2 do
			add("Strap", V3(0.06 * s.X, 0.42 * s.Y, 0.5 * s.Z), at(side * 0.46 * s.X, -0.25 * s.Y, -0.05 * s.Z) * ANG(0, 0, math.rad(side * 12)), color, "Ellipsoid")
		end
		add("StrapChin", V3(0.55 * s.X, 0.08 * s.Y, 0.3 * s.Z), at(0, -0.5 * s.Y, L.front(0) * 0.55))
	elseif style == "Mutton Chops" then
		-- broad sideburns down to the jaw, a clean chin
		for side = -1, 1, 2 do
			add("Chop", V3(0.12 * s.X, (0.36 + 0.06 * g) * s.Y, 0.42 * s.Z), at(side * 0.45 * s.X, -0.18 * s.Y, -0.08 * s.Z) * ANG(0, 0, math.rad(side * 8)))
		end
		moustache(0.18, 6)
	elseif style == "Short Boxed" then
		-- a denser core under a sparser, slightly larger edge layer: the outline thins into the skin
		-- instead of ending in a hard shell rim (the edge layer only when the part cap leaves room)
		add("Beard", V3(s.X * 1.03, s.Y * (0.42 + 0.06 * g), s.Z * 1.0), at(0, -0.35 * s.Y, -0.06 * s.Z))
		if not low and fits(2) then
			add("BeardEdge", V3(s.X * 1.07, s.Y * (0.47 + 0.06 * g), s.Z * 1.03), at(0, -0.33 * s.Y, -0.06 * s.Z), color, "Ellipsoid", mat, 0.55)
		end
		moustache()
		wantSideburns, wantNeck = true, true
	else -- Full Beard
		-- core + sparser edge layer (see Short Boxed); the top stays below the cheekbones
		add("Beard", V3(s.X * 1.06, s.Y * (0.5 + 0.14 * g), s.Z * 1.04), at(0, -0.41 * s.Y, -0.06 * s.Z))
		if not low and fits(3) then
			add("BeardEdge", V3(s.X * 1.1, s.Y * (0.56 + 0.14 * g), s.Z * 1.07), at(0, -0.39 * s.Y, -0.06 * s.Z), color, "Ellipsoid", mat, 0.55)
		end
		if not low then
			add("BeardChin", V3(0.5 * s.X, (0.2 + 0.1 * g) * s.Y, 0.3 * s.Z), at(0, (-0.55 - 0.05 * g) * s.Y, -0.3 * s.Z))
		end
		moustache(0.18, 8)
		wantSideburns, wantNeck = true, true
	end
	-- sideburns joining the beard to the hair, then the neck line (full detail only)
	if wantSideburns and full and fits(2) then
		for side = -1, 1, 2 do
			-- lying on the side wall just in front of the ear (a low shell, its rim on the skin)
			local rise = 0.012 * s.X
			add("Sideburn", V3(0.065 * s.Z, 0.27 * s.Y, 2 * rise / 0.5), hcf * L.shellCF(side * rad(76), -0.01 * s.Y, 0) * CF(0, 0, rise / 0.5 - rise), color, "Ellipsoid", mat)
		end
	end
	if wantNeck and full and fits(1) then
		add("NeckBeard", V3(0.72 * s.X, 0.12 * s.Y, 0.6 * s.Z), at(0, -0.49 * s.Y, -0.12 * s.Z), color, "Ellipsoid", mat, neckT)
	end
	-- grey flecks on older beards
	if grey > 0.15 and full and style ~= "Stubble" then
		local rng = Random.new((app.face and app.face.seed or 7) + 404)
		for _ = 1, 2 + math.floor(grey * 4) do
			local x = rng:NextNumber(-0.12, 0.12) * s.X
			local y = rng:NextNumber(-0.47, -0.36) * s.Y
			if not fits(1) then
				break
			end
			add("GreyFleck", V3(0.05 * s.X, 0.04 * s.Y, 0.03 * s.Z), at(x, y, L.front(x) * 0.84 - 0.03), Color3.fromRGB(200, 198, 192), "Ellipsoid", mat, 0.3)
		end
	end
	folder:SetAttribute("Extra", countParts(folder) - old)
	-- keep the lips visible through the beard (from their base size: rebuilds never stack; faceBuild
	-- applies the same rule when it is rebuilt on its own)
	if face and coversLips then
		for _, n in ipairs({ "UpperLip", "LowerLip", "MouthLine" }) do
			local p = face:FindFirstChild(n)
			if p then
				local bs = p:GetAttribute("BaseSize") or p.Size
				p.Size = bs + V3(0, 0, 0.03)
			end
		end
	end
end

------------------------------------------------------------------------
-- Headgear (every boxer's, Config.AlwaysHeadgear; else only while sparring)
------------------------------------------------------------------------
-- An open-face amateur headgear built from explicit pads: the face opening is geometry, never an accident of overlap.
-- Only shapes the engine sizes from the part (Sphere meshes = ellipsoids, Cylinder parts, Blocks): NO Head mesh (the
-- engine scales that one uniformly by the smallest axis and never stretches it; two rebuilds were bitten by it).
-- Everything is sized and placed from the head's live size (Head.HeadSpan, its smallest axis) in head spans
-- (y up from the head's centre, -z the face), welded to the head, so it fits every head and follows a rescale
-- (followHead below rebuilds it when the Head's Size changes after the build).
-- The pads (Head.HG, in spans; see tools/sim/test_bodytiers / test_referee, which check these against the
-- forbidden front region without any model of the head mesh):
-- * HGBrow: the brow roll, a ring round the head just above the brows (its rim meets the forehead at y 0.27,
--   above HEADGEAR_OPENING.top; 0.07 proud at the front, sunk inside the head at the back)
-- * HGTop: the crown cap over the top, flush with the forehead under the brow roll, 0.11 thick on the crown
-- * HGShell: the back shell, a half-dome behind the ears down to the nape (the part Diag measures)
-- * HGCheek x2: the cheek bolsters, upright rolls beside the face from the brow roll to under the jaw, outside
--   the eyes (|x| >= 0.37; the drawn ink ends at 0.237), never across the face (z >= -0.29)
-- * HGSide x2 (full) / HGEars (medium: one drum through the head whose ends are the two ear pads): the ear pads
--   flush on the side walls, 0.1 proud; HGEarHole x2 (full): the dark openings over the ears
-- * HGStrap x2 (full): the chin strap from under each ear pad to a point under the chin, its tip tucked into the
--   jaw's rounded underside (never below the head's base: the head sits on the tier torso's neck, a strap end under
--   the base shows as a dark stub on the neck)
-- Nothing in front of the face: no part reaches z < -0.35 spans below the brow line (HEADGEAR_OPENING.top), none
-- covers the eye points (+-0.2, 0, -0.5); the ear pads stand >= 0.03 off the side planes, the crown cap >= 0.03
-- above the top. The opening (fractions of the head): the band from y = top up, nothing at |x| < side above the
-- mouth line (y > -0.1) or at |x| < sideLow below it; checked against every drawn face by test_bodytiers.
-- detail = Config.DetailLevel: full 11 parts, medium 6, low 3 (the crowd: brow roll, crown cap, back shell).
Head.HEADGEAR_OPENING = { top = 0.225, side = 0.29, sideLow = 0.24 }
local HG_PARTS = { full = 11, medium = 6, low = 3 }
Head.HEADGEAR_PARTS = HG_PARTS

-- The engine's Head SpecialMesh is NOT stretched by the part's Size per axis (unlike the Sphere mesh): it is the one
-- head shape, scaled uniformly by the part's smallest axis. Every head-worn part is therefore sized from the head's
-- smallest axis (Head.HeadSpan); the headgear and the caps use no Head mesh at all.
function Head.HeadSpan(head)
	local s = head.Size
	return math.min(s.X, s.Y, s.Z)
end

-- the pads in head spans (centre x / y / z, then the size w x h x d; cheek: a roll of radius r and length h; strap:
-- its end points a (under the ear pad) and b (under the chin), its width w and thickness t)
Head.HG = {
	brow = { y = 0.33, z = -0.04, w = 1.14, h = 0.22, d = 1.06 },
	top = { y = 0.36, z = 0.04, w = 1.14, h = 0.5, d = 1.08 },
	back = { y = 0.02, z = 0.2, w = 1.22, h = 0.84, d = 0.86 },
	cheek = { x = 0.46, y = -0.04, z = -0.2, r = 0.09, h = 0.62 },
	side = { x = 0.52, y = 0, z = -0.02, w = 0.14, h = 0.56, d = 0.58 },
	ears = { y = 0, z = -0.02, d = 0.56, len = 1.18 },
	hole = { x = 0.585, y = 0.02, z = -0.02, w = 0.03, h = 0.16, d = 0.12 },
	strap = { a = { 0.5, -0.28, 0.02 }, b = { 0.08, -0.46, -0.26 }, w = 0.07, t = 0.025 },
}

-- A pad colour within a hair of the skin reads as a bare, bulging head (Looks.Palette's brown {110, 70, 40} against
-- SkinTones[9] {112, 70, 44}: a seed-coloured NPC's headgear, a cornerman's team cap). Such a colour is nudged away
-- from the skin: darker on a light skin, lighter on a dark one. Returns the colour and whether it was adjusted.
function Head.OffSkin(color, skin)
	if typeof(color) ~= "Color3" or typeof(skin) ~= "Color3" then
		return color, false
	end
	local d = math.abs(color.R - skin.R) + math.abs(color.G - skin.G) + math.abs(color.B - skin.B)
	if d >= 0.12 then
		return color, false
	end
	if lum(skin) > 0.3 then
		return darken(color, 0.6), true
	end
	return lerpColor(color, WHITE, 0.3), true
end

-- Every head-worn part is joined to the head by a Weld (a JointInstance, as the gear meshes and the engine's own
-- accessories are), parented to the part, Part0 = the head, C0 = the part in head space, C1 = identity. Not a
-- WeldConstraint: the engine re-points JointInstances when it replaces the head (ReplaceBodyPartR15, the MeshPart
-- head conversion) and never a constraint, a WeldConstraint only records its offset once it goes live, and a Weld's
-- C0 places the part from the head deterministically wherever the model goes (a clone, out of and back into the
-- DataModel). Massless, no collisions / queries / touches (Kit.mk), the head's collision group.
local function weldToHead(p, head)
	for _, c in ipairs(p:GetChildren()) do
		if c:IsA("WeldConstraint") or c:IsA("Weld") then
			c:Destroy()
		end
	end
	local w = Instance.new("Weld")
	w.Name = "HeadWeld"
	w.Part0 = head
	w.Part1 = p
	w.C0 = head.CFrame:ToObjectSpace(p.CFrame)
	w.C1 = CF()
	w.Parent = p
	pcall(function()
		p.CollisionGroup = head.CollisionGroup
	end)
	return w
end
Head.WeldToHead = weldToHead

-- what the gear is fitted to, as one string: the head's mesh (a MeshPart's id and MeshSize, a SpecialMesh's type and
-- Scale) - the engine swaps a classic head for a MeshPart (and back) without a Size change
local function v3s(v)
	if typeof(v) ~= "Vector3" then
		return "?"
	end
	return string.format("%.3f,%.3f,%.3f", v.X, v.Y, v.Z)
end
function Head.HeadMeshSig(head)
	if not (head and head:IsA("BasePart")) then
		return "none"
	end
	if head:IsA("MeshPart") then
		local id, ms
		pcall(function()
			id = tostring(head.MeshId):gsub("rbxassetid://", "")
			ms = head.MeshSize
		end)
		return "MeshPart " .. tostring(id) .. " " .. v3s(ms)
	end
	local sm = head:FindFirstChildOfClass("SpecialMesh")
	if sm then
		local mt, sc
		pcall(function()
			mt = tostring(sm.MeshType):match("(%w+)$")
			sc = sm.Scale
		end)
		return "SpecialMesh " .. tostring(mt) .. " " .. v3s(sc)
	end
	return head.ClassName .. " nomesh"
end

-- the folder records the head it was fitted to: its Size, class and mesh (HeadSize / HeadClass / HeadMesh)
function Head.StampHead(folder, head)
	folder:SetAttribute("HeadSize", head.Size)
	folder:SetAttribute("HeadClass", head.ClassName)
	folder:SetAttribute("HeadMesh", Head.HeadMeshSig(head))
end

-- Why a gear folder (Headgear / Hat) no longer fits the model's live head, or nil while it does: parts whose weld is
-- gone (the Humanoid died with BreakJointsOnDeath, a broken rig: they fall or stay behind), parts welded to a head
-- that is no longer in the model (the engine replaced the instance), the head's Size / class / mesh differing from
-- what the folder was fitted to (a rescale after the build, the MeshPart conversion). nil with no head or no parts.
function Head.GearStale(model, folder)
	local head = model:FindFirstChild("Head")
	if not (head and head:IsA("BasePart")) or folder == nil or folder.Parent == nil then
		return nil
	end
	local parts, loose, other = 0, 0, nil
	for _, p in ipairs(folder:GetDescendants()) do
		if p:IsA("BasePart") then
			parts += 1
			local w = p:FindFirstChildOfClass("Weld") or p:FindFirstChildOfClass("WeldConstraint")
			if not (w and w.Part0 and w.Part1 == p) then
				loose += 1
			elseif w.Part0 ~= head then
				other = w.Part0
			end
		end
	end
	if parts == 0 then
		return nil
	end
	local why = {}
	if loose > 0 then
		why[#why + 1] = string.format("%d of %d parts with no weld", loose, parts)
	end
	if other then
		why[#why + 1] = string.format("welded to a head no longer in the model (%s%s); the live Head is a %s", other.ClassName,
			other.Parent and (" under " .. other.Parent.Name) or ", orphaned", head.ClassName)
	end
	local was = folder:GetAttribute("HeadSize")
	if typeof(was) == "Vector3" and (head.Size - was).Magnitude > 1e-3 then
		why[#why + 1] = string.format("Head.Size (%s) -> (%s)", v3s(was), v3s(head.Size))
	end
	local cls = folder:GetAttribute("HeadClass")
	if type(cls) == "string" and cls ~= head.ClassName then
		why[#why + 1] = "Head " .. cls .. " -> " .. head.ClassName
	end
	local mesh = folder:GetAttribute("HeadMesh")
	local live = Head.HeadMeshSig(head)
	if type(mesh) == "string" and mesh ~= live then
		why[#why + 1] = "head mesh " .. mesh .. " -> " .. live
	end
	if #why == 0 then
		return nil
	end
	return table.concat(why, "; ")
end

-- one Output line per rebuild, counted on the module (tests) and the model (HeadgearRefits / HeadgearRefitLast: Diag)
Head.Refits = 0
local function refitNote(model, fname, why)
	Head.Refits += 1
	pcall(function()
		model:SetAttribute("HeadgearRefits", (tonumber(model:GetAttribute("HeadgearRefits")) or 0) + 1)
		model:SetAttribute("HeadgearRefitLast", fname .. ": " .. why)
	end)
	warn(string.format("[Boxer] headgear refit %s: %s %s", tostring(model and model.Name), fname, why))
end

-- The head changes after a build at times: scaled (ApplyDescription, a head swap kept at the engine's scale, the
-- Humanoid's deferred scaling pass once the model is in Workspace) or REPLACED (the engine's MeshPart head
-- conversion, a later ReplaceBodyPartR15): the gear was fitted to another head. The folder records the head it
-- was fitted to (Head.StampHead) and watches, while it lives, the head's Size, the head leaving the model and a new
-- Head arriving (model.ChildAdded); any of them re-checks (deferred: one rebuild per burst) and rebuilds the folder
-- through `rebuild(why)` when Head.GearStale says it no longer fits. Builder's cache keys carry the head size too,
-- so a Cosmetics after a change rebuilds either way; this covers a change with no Cosmetics after it, and the late
-- re-fit (Head.RefitHeadgear, from Builder.OnPlaced) covers a clone (no watch) and anything the signals miss.
local function followHead(folder, head, rebuild)
	Head.StampHead(folder, head)
	local look = folder.Parent
	local model = look and look.Parent
	local conns, done = {}, false
	local function stop()
		done = true
		for _, c in ipairs(conns) do
			pcall(c.Disconnect, c)
		end
	end
	local function changed()
		if done then
			return
		end
		task.defer(function()
			if done or folder.Parent == nil or model == nil then
				return
			end
			local why = Head.GearStale(model, folder)
			if why then
				stop()
				rebuild(why)
			end
		end)
	end
	local function watch(sig)
		local ok, c = pcall(function()
			return sig:Connect(changed)
		end)
		if ok and c then
			conns[#conns + 1] = c
		end
	end
	watch(head:GetPropertyChangedSignal("Size"))
	watch(head.AncestryChanged)
	if model then
		watch(model.ChildAdded)
	end
	-- (the folder goes with the model, a rebuild or a fight cleanup: the watch goes with it)
	pcall(function()
		folder.Destroying:Once(stop)
	end)
end

-- The late re-fit: every gear folder checked against the live head (Head.GearStale) and rebuilt from its own record
-- (the Headgear folder's Color / Detail, the Hat's Style / CapColor / CapTrim / CapBadge / Detail) when it no longer
-- fits, with one "[Boxer] headgear refit" line each. A no-op (nil) while everything fits. Builder.OnPlaced runs it
-- 0.3 s and 2 s after a model is placed in Workspace (and after a player's Builder.Apply).
-- Returns { Headgear = why, Hat = why } for what was rebuilt, or nil.
function Head.RefitHeadgear(model)
	local look = model and model:FindFirstChild("BoxerLook")
	if not look then
		return nil
	end
	local out = nil
	local hg = look:FindFirstChild("Headgear")
	local why = hg and Head.GearStale(model, hg)
	if why then
		local color, detail = hg:GetAttribute("Color"), hg:GetAttribute("Detail")
		refitNote(model, "Headgear", why)
		Head.SetHeadgear(model, color, true, detail)
		out = out or {}
		out.Headgear = why
	end
	local hat = look:FindFirstChild("Hat")
	why = hat and Head.GearStale(model, hat)
	if why then
		local style, detail = hat:GetAttribute("Style"), hat:GetAttribute("Detail")
		local colors = { cap = hat:GetAttribute("CapColor"), trim = hat:GetAttribute("CapTrim"), badge = hat:GetAttribute("CapBadge") }
		refitNote(model, "Hat", why)
		Head.SetCap(model, style, colors, detail)
		out = out or {}
		out.Hat = why
	end
	return out
end

-- The Neck after a head swap. Whatever joint the rig uses stays as it is (a Motor6D "Neck" under the head, or the
-- AnimationConstraint an upgraded avatar rig carries); with none at all joining the UpperTorso to the head (the
-- swap dropped it) a Motor6D Neck is rebuilt from the two NeckRigAttachments: without one Humanoid.RequiresNeck
-- kills the character and BreakJointsOnDeath then drops every weld (the gear falls off, the joints go).
-- Returns "ok", "rebuilt" or nil (no head / torso / attachments to build from).
function Head.EnsureNeck(model)
	local head, torso = model:FindFirstChild("Head"), model:FindFirstChild("UpperTorso")
	if not (head and torso and head:IsA("BasePart") and torso:IsA("BasePart")) then
		return nil
	end
	local function joins(c)
		if c:IsA("Motor6D") or c:IsA("Weld") then
			return (c.Part0 == torso and c.Part1 == head) or (c.Part0 == head and c.Part1 == torso)
		end
		if c:IsA("AnimationConstraint") then
			local a0, a1 = c.Attachment0, c.Attachment1
			return a0 ~= nil and a1 ~= nil and ((a0.Parent == torso and a1.Parent == head) or (a0.Parent == head and a1.Parent == torso))
		end
		return false
	end
	for _, holder in ipairs({ head, torso }) do
		for _, c in ipairs(holder:GetChildren()) do
			if joins(c) then
				return "ok"
			end
		end
	end
	local a0, a1 = torso:FindFirstChild("NeckRigAttachment"), head:FindFirstChild("NeckRigAttachment")
	if not (a0 and a1 and a0:IsA("Attachment") and a1:IsA("Attachment")) then
		return nil
	end
	local m = Instance.new("Motor6D")
	m.Name = "Neck"
	m.Part0 = torso
	m.Part1 = head
	m.C0 = a0.CFrame
	m.C1 = a1.CFrame
	m.Parent = head
	return "rebuilt"
end

function Head.SetHeadgear(model, color, on, detail)
	local folder = getFolder(model, "Headgear")
	Head.SetHairHidden(model, "headgear", on)
	if not on then
		return
	end
	local head = part(model, "Head")
	if not head then
		return
	end
	detail = Config.DetailLevel(detail or model:GetAttribute("Detail"))
	local full, low = detail == "full", detail == "low"
	folder:SetAttribute("Detail", detail)
	color = typeof(color) == "Color3" and color or Color3.fromRGB(200, 25, 30)
	local asked = color
	local adjusted
	color, adjusted = Head.OffSkin(color, head.Color)
	folder:SetAttribute("Color", asked)
	folder:SetAttribute("ColorAdjusted", adjusted)
	local hs = Head.HeadSpan(head)
	local hcf = head.CFrame
	local mat = Enum.Material.Leather
	local G = Head.HG
	local function at(x, y, z)
		return hcf * CF(x * hs, y * hs, z * hs)
	end
	-- a part on the head: Kit.mk, then the Weld to the head (weldToHead) in place of mk's WeldConstraint
	local function piece(name, size, cf, c, shape, m)
		local p = mk(folder, head, name, size, cf, c, shape, m)
		weldToHead(p, head)
		return p
	end
	-- an ellipsoid pad: centre (x, y, z) and size w x h x d in spans
	local function pad(name, x, y, z, w, h, d, c, m)
		return piece(name, V3(w * hs, h * hs, d * hs), at(x, y, z), c, "Ellipsoid", m or mat)
	end
	local function rebuild(why)
		refitNote(model, "Headgear", why)
		Head.SetHeadgear(model, asked, true, detail)
	end
	local browC, strapC, holeC = darken(color, 0.9), darken(color, 0.55), darken(color, 0.35)
	-- the brow roll, the crown cap and the back shell: every detail level
	pad("HGBrow", 0, G.brow.y, G.brow.z, G.brow.w, G.brow.h, G.brow.d, browC)
	pad("HGTop", 0, G.top.y, G.top.z, G.top.w, G.top.h, G.top.d, color)
	pad("HGShell", 0, G.back.y, G.back.z, G.back.w, G.back.h, G.back.d, color)
	if low then
		followHead(folder, head, rebuild)
		return folder
	end
	-- the cheek bolsters: upright rolls (long ellipsoids) beside the face, outside the eyes
	local C = G.cheek
	for side = -1, 1, 2 do
		pad("HGCheek", side * C.x, C.y, C.z, 2 * C.r, C.h, 2 * C.r, color)
	end
	if not full then
		-- one drum through the head along X: its two ends are the ear pads (a Cylinder part's axis is its X)
		local E = G.ears
		piece("HGEars", V3(E.len * hs, E.d * hs, E.d * hs), at(0, E.y, E.z), color, "Cylinder", mat)
		followHead(folder, head, rebuild)
		return folder
	end
	local S, Hh, St = G.side, G.hole, G.strap
	for side = -1, 1, 2 do
		-- the ear pad flush on the side wall, the dark ear hole in its outer face
		pad("HGSide", side * S.x, S.y, S.z, S.w, S.h, S.d, color)
		pad("HGEarHole", side * Hh.x, Hh.y, Hh.z, Hh.w, Hh.h, Hh.d, holeC)
		-- the chin strap: from under the ear pad along the jaw to a point under the chin
		local a = at(side * St.a[1], St.a[2], St.a[3]).Position
		local b = at(side * St.b[1], St.b[2], St.b[3]).Position
		local mid = (a + b) * 0.5
		local out = mid - at(0, -0.1, 0).Position
		piece("HGStrap", V3(St.w * hs, St.t * hs, (b - a).Magnitude), CFrame.lookAt(mid, b, out.Unit), strapC, "Block", SMOOTH)
	end
	followHead(folder, head, rebuild)
	return folder
end

------------------------------------------------------------------------
-- Officials' caps (the referee's peaked cap, the spar coach's team cap): Builder's "Hat" Cosmetics step
------------------------------------------------------------------------
-- Parts on the classic head (no uploaded mesh), welded to the head and sized from it (Head.HeadSpan), so they scale
-- with the head; BoxerLook/Hat is cached by Builder on the style, colours, head size and detail. Only shapes the
-- engine sizes from the part (Cylinder parts, Sphere meshes = ellipsoids): no Head mesh, which it never stretches.
-- * "referee": a black flat-topped peaked cap: a band hugging the head just above the brows (a Cylinder standing
--   on end, a little wider than the head) in the venue shirt's colour (light blue at the clubs, white for a title
--   fight), the crown over it (a wider, taller Cylinder: the flat top overhangs the band), a short stiff visor (a
--   flat ellipsoid rooted under the band, pitched down a little) and a gold WCB badge on the crown's front (a gold
--   disc and the "WCB" wordmark, GothamBlack in ink, as UI.Brand's); full adds the gold cord across the band
-- * "baseball": the coach's team cap: a domed six-panel crown (an ellipsoid) in his team colour, a longer bill in its
--   darker shade, the top button and a white "WCB" on the front; full adds the front seam
-- Nothing reaches the drawn face: every part stays above Head.CAP_CLEAR (fractions of the head height, the drawn
-- ink's padded brow top Head.DECAL_INK is 0.21, the measured ink 0.183) in front of the face, so the brows and eyes
-- show from the front, the 3/4 and a camera up to ~10 deg above (test_bodytiers casts the rays).
-- detail = Config.DetailLevel: referee full 6 parts, medium 5, low 2; baseball full 5, medium 4, low 2.
Head.CAP_CLEAR = 0.235
Head.CAP_PARTS = { referee = { full = 6, medium = 5, low = 2 }, baseball = { full = 5, medium = 4, low = 2 } }
-- referee cap geometry (fractions of the head span; y up from the head's centre, z: -0.5 = the forehead). The band
-- from bandLo up bandH (its diameter bandW: the head is 1.0 wide there), the crown from crownBase (inside the band's
-- top) up crownH at crownW; the visor's root centre at visorY, visorT thick, reaching visorReach ahead of the forehead
Head.REFCAP = { bandLo = 0.25, bandH = 0.12, bandW = 1.04, crownBase = 0.36, crownH = 0.3, crownW = 1.08,
	visorY = 0.268, visorT = 0.034, visorReach = 0.24, visorW = 0.78, visorTilt = 3, badgeY = 0.46 }
Head.BALLCAP = { domeY = 0.33, domeH = 0.27, domeW = 1.07, domeD = 1.09, billY = 0.27, billT = 0.034, billReach = 0.36,
	billW = 0.68, billTilt = 3 }

-- colors = { cap, trim, badge } (Color3, all optional); style = "referee" | "baseball" | nil (none: the folder goes)
function Head.SetCap(model, style, colors, detail)
	local folder = getFolder(model, "Hat")
	if style ~= "referee" and style ~= "baseball" then
		folder:Destroy()
		return nil
	end
	local head = part(model, "Head")
	if not head then
		return folder
	end
	detail = Config.DetailLevel(detail or model:GetAttribute("Detail"))
	local full, low = detail == "full", detail == "low"
	folder:SetAttribute("Detail", detail)
	folder:SetAttribute("Style", style)
	colors = type(colors) == "table" and colors or {}
	-- the asked colours: what the late re-fit (Head.RefitHeadgear) rebuilds the cap from
	for k, a in pairs({ cap = "CapColor", trim = "CapTrim", badge = "CapBadge" }) do
		folder:SetAttribute(a, typeof(colors[k]) == "Color3" and colors[k] or nil)
	end
	local ref = style == "referee"
	local capC = typeof(colors.cap) == "Color3" and colors.cap or (ref and Color3.fromRGB(18, 18, 21) or Color3.fromRGB(30, 30, 34))
	-- (a team colour within a hair of the skin reads as a bare head: nudged off it, Head.OffSkin)
	local adjusted
	capC, adjusted = Head.OffSkin(capC, head.Color)
	folder:SetAttribute("ColorAdjusted", adjusted)
	local trimC = typeof(colors.trim) == "Color3" and colors.trim or (ref and Color3.fromRGB(150, 190, 226) or darken(capC, 0.75))
	local badgeC = typeof(colors.badge) == "Color3" and colors.badge or (ref and Color3.fromRGB(212, 172, 64) or Color3.fromRGB(238, 238, 232))
	local hs = Head.HeadSpan(head)
	local hcf = head.CFrame
	-- the cap follows a head rescale / replacement after the build (followHead above); every piece (the text patches
	-- too) is joined to the head by a Weld (weldToHead)
	local function done()
		for _, p in ipairs(folder:GetChildren()) do
			if p:IsA("BasePart") and not p:FindFirstChildOfClass("Weld") then
				weldToHead(p, head)
			end
		end
		followHead(folder, head, function(why)
			refitNote(model, "Hat", why)
			Head.SetCap(model, style, colors, detail)
		end)
		return folder
	end
	local function ell(name, size, cf, c, m)
		local p = mk(folder, head, name, size, cf, c, "Ellipsoid", m or FABRIC)
		weldToHead(p, head)
		return p
	end
	-- a round, flat-topped drum standing on end: diameter d, height h (fractions of the head span), its centre y up
	-- from the head's centre (a Cylinder part's axis is its X: stood up with a 90 deg roll)
	local function drum(name, d, h, y, c, m)
		local p = mk(folder, head, name, V3(h * hs, d * hs, d * hs), hcf * CF(0, y * hs, 0) * ANG(0, 0, math.pi / 2), c, "Cylinder", m or FABRIC)
		weldToHead(p, head)
		return p
	end
	-- a flat ellipsoid visor reaching `reach` ahead of the forehead, its root under the band, pitched down by tilt
	-- degrees about its root (its back end 0.1 behind the forehead, inside the head; the tip at 0.5 + reach in front
	-- of the head's centre)
	local function visor(name, y, t, reach, w, tilt, c)
		local hl = (0.4 + reach) / 2
		local root = hcf * CF(0, y * hs, -0.5 * hs) * ANG(rad(-tilt), 0, 0)
		return ell(name, V3(w * hs, t * hs, 2 * hl * hs), root * CF(0, 0, (0.4 - hl) * hs), c, SMOOTH)
	end
	if ref then
		local R = Head.REFCAP
		-- the crown (at low detail, without the band, it comes down to the band's foot)
		local base = low and R.bandLo or R.crownBase
		local top = R.crownBase + R.crownH
		drum("RCCrown", R.crownW, top - base, (base + top) / 2, capC)
		visor("RCVisor", R.visorY, R.visorT, R.visorReach, R.visorW, R.visorTilt, darken(capC, 0.8))
		if low then
			return done()
		end
		drum("RCBand", R.bandW, R.bandH, R.bandLo + R.bandH / 2, trimC)
		-- the WCB badge on the crown's front, above the band: a gold disc standing 0.02 proud, the wordmark on it
		local fz = -R.crownW / 2 * hs
		local by = R.badgeY * hs
		ell("RCBadge", V3(0.2 * hs, 0.14 * hs, 0.05 * hs), hcf * CF(0, by, fz - 0.005 * hs), badgeC, Enum.Material.Metal)
		Kit.textPatch(folder, head, "RCBadgeText", V3(0.16 * hs, 0.07 * hs, 0.01), hcf * CF(0, by, fz - 0.034 * hs), "WCB",
			Color3.fromRGB(20, 22, 30), Enum.NormalId.Front, "GothamBlack")
		if full then
			-- the gold cord across the band's front, over the visor's root
			ell("RCCord", V3(0.78 * hs, 0.022 * hs, 0.2 * hs), hcf * CF(0, (R.bandLo + 0.04) * hs, -0.47 * hs), badgeC, Enum.Material.Metal)
		end
		return done()
	end
	local B = Head.BALLCAP
	ell("BCCrown", V3(hs * B.domeW, hs * B.domeH * 2, hs * B.domeD), hcf * CF(0, B.domeY * hs, 0.01 * hs), capC)
	visor("BCBill", B.billY, B.billT, B.billReach, B.billW, B.billTilt, trimC)
	if low then
		return done()
	end
	ell("BCButton", V3(0.09 * hs, 0.05 * hs, 0.09 * hs), hcf * CF(0, (B.domeY + B.domeH - 0.008) * hs, 0.01 * hs), capC)
	-- the front panel's WCB (on the dome's front at y 0.41: inside the dome's skin there, the wordmark just out of it)
	local ly = 0.41
	local dz = 0.01 - B.domeD / 2 * math.sqrt(math.max(1 - ((ly - B.domeY) / B.domeH) ^ 2, 0))
	Kit.textPatch(folder, head, "BCLogo", V3(0.2 * hs, 0.08 * hs, 0.01), hcf * CF(0, ly * hs, (dz - 0.012) * hs)
		* ANG(rad(22), 0, 0), "WCB", badgeC, Enum.NormalId.Front, "GothamBlack")
	if full then
		ell("BCSeam", V3(0.03 * hs, hs * B.domeH * 2 + 0.006, hs * B.domeD + 0.006), hcf * CF(0, B.domeY * hs, 0.01 * hs), darken(capC, 0.8))
	end
	return done()
end

------------------------------------------------------------------------
-- Damage
------------------------------------------------------------------------
-- bruise colour by age (Config.FaceDamage.bruiseColors: fresh red-purple, blue-purple, yellow-green,
-- then skin); on deep skin tones bruises read darker rather than coloured
local function bruiseColor(skin, age)
	local stops = Config.FaceDamage.bruiseColors
	local function col(stop)
		return stop.rgb and Color3.fromRGB(stop.rgb[1], stop.rgb[2], stop.rgb[3]) or skin
	end
	local c = col(stops[1])
	for i = 1, #stops - 1 do
		local a, b = stops[i], stops[i + 1]
		if age >= a.day and age <= b.day then
			c = lerpColor(col(a), col(b), (age - a.day) / math.max(0.01, b.day - a.day))
			break
		elseif age > b.day then
			c = col(b)
		end
	end
	local dark = clamp((0.45 - lum(skin)) / 0.3, 0, 1)
	return lerpColor(c, darken(skin, 0.55), dark * 0.55)
end

-- dmg = the CONTRACTS section 8 table (every field optional): leftEye, rightEye, cut, cutSide, cut2,
-- cutSide2, noseBleed, nose (broken), bruise, lip, cheekL, cheekR, forehead, earL, earR, redness, age.
-- folderName (optional) lets the Creator preview into its own folder. Sets attribute FaceDmgTier.
-- About 20 parts at the worst, every one a lens lying on the skin (no Beams: blood is a thin trickle part).
function Head.SetDamage(model, app, dmg, folderName)
	app = app or {}
	dmg = type(dmg) == "table" and dmg or {}
	local stage = Config.FaceDamageStage(dmg)
	model:SetAttribute("FaceDmgTier", stage)
	local head = part(model, "Head")
	if not head then
		return
	end
	local folder = getFolder(model, folderName or "Damage")
	local function n(k)
		return clamp(tonumber(dmg[k]) or 0, 0, 1.5)
	end
	local face = app.face or {}
	local L = Head.FaceLayout(head, face)
	-- a drawn face style: the marks lie on the skin at the drawn features (the swollen lid and the black eye are
	-- surface patches over the drawn eye; no built lid, lashes or white to tint)
	local drawnFace = Head.FaceStyle(model) ~= nil
	if drawnFace then
		Head.DecalLayout(L)
	end
	local s = L.s
	local hcf = head.CFrame
	local skin = skinOf(app)
	local age = math.max(0, tonumber(dmg.age) or 0)
	-- old bruises fade toward the skin over about a week
	local fade = clamp(1 - age / 8, 0.15, 1)
	local bruise = bruiseColor(skin, age)
	local blood = Color3.fromRGB(122, 6, 10)
	local fresh = age < 0.5 -- blood only on fresh damage
	local faceFolder = model:FindFirstChild("BoxerLook") and model.BoxerLook:FindFirstChild("Face")
	local function fattr(k, d)
		local v = faceFolder and faceFolder:GetAttribute(k)
		return v ~= nil and v or d
	end
	-- every mark is a lens on the skin (or on the feature it lies on: base = that feature's height); t = transparency
	local function mark(name, x, y, w, h, rise, dk, color, t, roll, base)
		local cf, size = lens(L, x, y, w, h, rise, dk, roll, base)
		return mk(folder, head, name, size, hcf * cf, color, "Ellipsoid", SMOOTH, t)
	end
	-- blood: a thin trickle lying on the skin from (x0, y0) to (x1, y1)
	local function trickle(x0, y0, x1, y1, width, base)
		if not fresh then
			return
		end
		local dx, dy = x1 - x0, y1 - y0
		local len = math.sqrt(dx * dx + dy * dy)
		if len < 1e-3 then
			return
		end
		local sg = dx < 0 and -1 or 1
		local roll = math.atan2(dy * sg, dx * sg)
		-- two pieces: a fuller drop where it starts, a thinner run below
		mark("Blood", x0 + dx * 0.22, y0 + dy * 0.22, len * 0.5, width, 0.0024 + (base or 0), 0.7, blood, 0.05, roll)
		return mark("Blood", x0 + dx * 0.62, y0 + dy * 0.62, len * 0.62, width * 0.62, 0.0022 + (base or 0), 0.7, darken(blood, 0.9), 0.12, roll)
	end
	-- face parts the damage changes: restore first so a lighter state heals visually
	local eyeV = { [-1] = n("leftEye"), [1] = n("rightEye") }
	local severe = stage >= 4
	local brokenNose = dmg.nose == true
	if faceFolder then
		for _, c in ipairs(faceFolder:GetDescendants()) do
			if c:IsA("BasePart") then
				local side = c:GetAttribute("Side")
				local nm = c.Name
				local shut = side and clamp((eyeV[side] - 0.3) / 0.7, 0, 1) > 0
				if nm == "Lid" or nm == "LowerLid" or nm == "BlinkLid" or nm == "Nose" or nm == "NoseTip" or nm == "NoseWing" then
					-- a black eye darkens the lids, a broken nose the nose (from the build colour: a lighter state heals it)
					local baseC = c:GetAttribute("BaseColor")
					if typeof(baseC) ~= "Color3" then
						baseC = c.Color
						c:SetAttribute("BaseColor", baseC)
					end
					local k = 0
					if nm == "Lid" or nm == "BlinkLid" then
						k = (side and eyeV[side] or 0) > 0.12 and clamp(eyeV[side], 0, 1) * 0.6 * fade or 0
					elseif nm == "LowerLid" then
						k = (side and eyeV[side] or 0) > 0.12 and clamp(eyeV[side], 0, 1) * 0.5 * fade or 0
					elseif brokenNose then
						k = 0.35 * fade
					end
					c.Color = k > 0 and lerpColor(baseC, bruise, k) or baseC
					if nm == "Lid" then
						c.Transparency = shut and 1 or 0
					end
				elseif nm == "Glint" then
					c.Transparency = shut and 1 or 0
				elseif nm == "Lashes" then
					-- the lash line rides on its lid: hidden while the swollen lid replaces it
					c.Transparency = shut and 1 or (c:GetAttribute("BaseT") or c.Transparency)
				elseif nm == "Sclera" then
					local baseC = c:GetAttribute("BaseColor")
					if typeof(baseC) == "Color3" then
						local red = clamp((side and eyeV[side] or 0) * 0.5 + (severe and 0.35 or 0) + n("redness") * 0.15, 0, 0.8)
						c.Color = lerpColor(baseC, Color3.fromRGB(228, 150, 140), red)
					end
				elseif nm == "Mouthguard" then
					-- bloodied after a split lip; SetDamage(model, app, {}) cleans it again
					local baseC = c:GetAttribute("BaseColor")
					if typeof(baseC) == "Color3" then
						c.Color = n("lip") > 0.6 and lerpColor(baseC, Color3.fromRGB(140, 10, 16), 0.3) or baseC
					end
				end
			end
		end
	end
	local w, h = L.eyeW, L.eyeHt
	local lidColor = darken(skin, 0.92)
	-- the eyes: a black eye is the socket going dark (a translucent tint that lies under the eye's own parts, so the
	-- eye stays open and readable inside it) with the darker, puffy crescent under the eye where the blood pools; the
	-- lids take the bruise (above). Past 0.3 the upper lid swells: a puffy dome that grows down over the eye until it
	-- shuts it.
	for side = -1, 1, 2 do
		local v = eyeV[side]
		local x, y = side * L.eyeX, L.eyeYS[side]
		local closing = clamp((v - 0.3) / 0.7, 0, 1)
		local k = clamp(v, 0, 1) * fade
		if drawnFace then
			-- a drawn eye (ink ~0.057 x 0.1 of the head, at x, y): the socket darkens round it, a crescent pools under
			-- it, and past 0.3 a puffy lid grows down over it from above until it hides the drawn eye (a slit when shut)
			if closing > 0 then
				local top = y + 0.065 * s.Y
				local bottom = top - (0.04 + 0.1 * closing) * s.Y
				local rise = (0.0115 + 0.005 * closing) * s.Z
				mark("SwollenLid", x + side * 0.004 * s.X, (top + bottom) / 2, (0.105 + 0.02 * closing) * s.X, top - bottom, rise, 0.62,
					lerpColor(darken(skin, 0.94), bruise, 0.12 + 0.2 * k))
				if closing > 0.6 then
					mark("SwollenSlit", x, bottom + 0.012 * s.Y, 0.075 * s.X, 0.009 * s.Y, rise * 0.62, 0.5, Color3.fromRGB(62, 36, 34), 0.15)
				end
			end
			if v > 0.15 then
				mark("BlackEye", x, y + 0.005 * s.Y, (0.15 + 0.02 * k) * s.X, (0.16 + 0.02 * k) * s.Y, 0.0022, 0.75, bruise, clamp(0.8 - 0.32 * k, 0.45, 0.85))
				mark("BlackEyeLow", x + side * 0.006 * s.X, y - (0.075 + 0.006 * k) * s.Y, (0.11 + 0.02 * k) * s.X, (0.035 + 0.015 * k) * s.Y, (0.003 + 0.005 * k) * s.Z, 0.62,
					lerpColor(skin, darken(bruise, 0.85), 0.45 + 0.4 * k), clamp(0.55 - 0.25 * k, 0.3, 0.7), side * rad(-6))
			end
		elseif closing > 0 then
			-- (a wide, low swelling: the lid puffs out sideways more than it stands off the face)
			local top, bottom = y + h * 0.95, y + h * (0.5 - (0.4 + 0.66 * closing))
			local rise = (0.0115 + 0.005 * closing) * s.Z
			mark("SwollenLid", x + side * 0.006 * s.X, (top + bottom) / 2, w * (1.42 + 0.12 * closing), top - bottom, rise, 0.62,
				lerpColor(lidColor, bruise, 0.1 + 0.18 * k), nil, side * L.eyeTilt)
			if closing > 0.6 then
				-- shut: the lash line pressed into a slit at the swelling's lower edge
				mark("SwollenSlit", x, bottom + h * 0.2, w * 0.95, 0.009 * s.Y, rise * 0.62, 0.5, Color3.fromRGB(62, 36, 34), 0.15, side * L.eyeTilt)
			end
		end
		if v > 0.15 and not drawnFace then
			mark("BlackEye", x, y + h * 0.25, w * (1.32 + 0.16 * k), h * (2.1 + 0.3 * k), 0.0022, 0.75, bruise, clamp(0.8 - 0.32 * k, 0.45, 0.85), side * L.eyeTilt)
			mark("BlackEyeLow", x + side * 0.008 * s.X, y - h * (0.8 + 0.06 * k), w * (1.0 + 0.18 * k), h * (0.5 + 0.22 * k), (0.003 + 0.005 * k) * s.Z, 0.62,
				lerpColor(skin, darken(bruise, 0.85), 0.45 + 0.4 * k), clamp(0.55 - 0.25 * k, 0.3, 0.7), side * rad(-6))
		end
		-- a swelling on the cheekbone (a "mouse"): a low smooth dome, the skin going bruise-coloured
		local ck = n(side == -1 and "cheekL" or "cheekR")
		if ck > 0.15 then
			local kk = clamp(ck, 0, 1)
			mark("CheekSwell", side * 0.29 * s.X, -0.05 * s.Y, (0.22 + 0.06 * kk) * s.X, (0.15 + 0.04 * kk) * s.Y, (0.003 + 0.007 * kk) * s.Z + fattr("CheekRise", 0), 0.75,
				lerpColor(skin, bruise, 0.06 + 0.15 * kk * fade), nil, side * rad(14))
		end
		-- swollen ear (the hematoma that becomes a cauliflower ear): a swelling on the upper ear
		local ear = n(side == -1 and "earL" or "earR")
		if ear > 0.25 then
			local earS = 1 + 0.2 * (face.earSize or 0)
			local ecf = hcf * L.shellCF(side * rad(96), 0.03 * s.Y, 0) * ANG(0, side * rad(10), 0)
			local r = (0.026 + 0.016 * ear) * s.X
			mk(folder, head, "EarSwell", V3(0.1 * s.Z * earS, (0.12 + 0.05 * ear) * s.Y * earS, 2 * r), ecf * CF(side * 0.01 * s.Z, 0.06 * s.Y * earS, 0.2 * r),
				lerpColor(skin, bruise, 0.25 + 0.35 * fade), "Ellipsoid", SMOOTH)
		end
	end
	-- cuts: a thin split lying flat on the skin with a little blood. The first opens over the outer end of the brow
	-- (the blood runs down past the outside of the eye), the second on the other cheekbone
	local ridgeRise = fattr("RidgeRise", 0)
	local cutColor = Color3.fromRGB(110, 8, 12)
	local c1, side1 = n("cut"), (tonumber(dmg.cutSide) or 1) < 0 and -1 or 1
	if c1 > 0.05 then
		local v = math.min(c1, 1)
		-- across the tail of the brow (over the brow hairs: the brow lens is ~0.008 high)
		local x, y = side1 * 0.27 * s.X, L.browY + 0.004 * s.Y
		local len = (0.05 + 0.06 * v) * s.X
		mark("Cut", x, y, len, (0.01 + 0.006 * v) * s.Y, 0.0026 + (0.0055 + 0.003) * s.Z + ridgeRise, 0.7, cutColor, nil, side1 * rad(28))
		if v > 0.35 then
			-- the blood runs down past the outside of the eye
			local x0 = side1 * 0.325 * s.X
			trickle(x0, y - 0.015 * s.Y, x0 + side1 * 0.012 * s.X, L.eyeY - (0.0 + 0.04 * v) * s.Y, (0.016 + 0.006 * v) * s.X)
		end
	end
	local c2 = n("cut2")
	if c2 > 0.05 then
		local side2 = tonumber(dmg.cutSide2) and ((tonumber(dmg.cutSide2) < 0) and -1 or 1) or -side1
		local v = math.min(c2, 1)
		mark("Cut", side2 * 0.3 * s.X, -0.01 * s.Y, (0.04 + 0.05 * v) * s.X, (0.009 + 0.005 * v) * s.Y, 0.0026 + fattr("CheekRise", 0), 0.7, cutColor, nil,
			side2 * rad(30))
	end
	-- nose: a broken nose takes the bruise (above); a bleed runs from the nostrils down to the upper lip
	local bleed = n("noseBleed")
	if bleed > 0.2 then
		for side = -1, 1, 2 do
			local x = side * L.noseW * 0.2
			trickle(x, L.noseBottomY - 0.004 * s.Y, x * 1.15, L.mouthY + (0.06 - 0.03 * math.min(bleed, 1)) * s.Y, (0.016 + 0.008 * bleed) * s.X)
		end
	end
	-- bruised face (or a red flush when only lightly marked): a soft translucent tint over the cheek
	local br = n("bruise")
	local cheekBase = fattr("CheekRise", 0)
	if br > 0.2 then
		for side = -1, 1, 2 do
			-- an uneven patch: a wide pale one and a darker core off its middle
			mark("Bruise", side * 0.29 * s.X, -0.06 * s.Y, 0.18 * s.X, 0.12 * s.Y, 0.0022 + cheekBase, 0.7, bruise, math.clamp(0.88 - br * 0.3 * fade, 0.62, 0.9), side * rad(14))
			if br > 0.45 then
				mark("Bruise", side * 0.31 * s.X, -0.045 * s.Y, 0.09 * s.X, 0.065 * s.Y, 0.0032 + cheekBase, 0.7, darken(bruise, 0.9),
					math.clamp(0.86 - br * 0.3 * fade, 0.6, 0.88), side * rad(30))
			end
		end
	elseif stage >= 1 or n("redness") > 0.1 then
		local r = math.max(n("redness"), 0.3)
		for side = -1, 1, 2 do
			mark("Flush", side * 0.28 * s.X, -0.05 * s.Y, 0.18 * s.X, 0.12 * s.Y, 0.002 + cheekBase, 0.7, Color3.fromRGB(196, 70, 66), 0.91 - 0.12 * r, side * rad(14))
		end
	end
	-- a lump over the brow (a "mouse" from a clash of heads or a hook): a low swelling just above the brow
	local lump = n("forehead")
	if lump > 0.2 then
		local side = (tonumber(dmg.cutSide) or 1) < 0 and -1 or 1
		local kk = clamp(lump, 0, 1)
		mark("Lump", side * 0.17 * s.X, L.browY + 0.075 * s.Y, (0.18 + 0.05 * kk) * s.X, (0.1 + 0.03 * kk) * s.Y, (0.003 + 0.006 * kk) * s.Z + ridgeRise * 0.5, 0.75,
			lerpColor(skin, bruise, 0.1 + 0.25 * kk * fade))
	end
	-- busted lip: the lower lip swells on one side, a dark split in it, a little blood running down from it
	local lip = n("lip")
	if lip > 0.25 then
		local lipBase = fattr("LowerLipRise", 0.012 * s.Z)
		local lipC = fattr("LipColor", darken(skin, 0.86))
		local ly = L.mouthY - (0.042 + 0.02 * (face.lips or 0)) * s.Y * 0.38
		if drawnFace then
			ly = L.mouthY - 0.045 * s.Y -- (under the drawn mouth line: the lower lip)
		end
		local top = lipBase
		if lip > 0.45 then
			local kk = clamp(lip, 0, 1)
			top = lipBase + (0.004 + 0.007 * kk) * s.Z
			mark("SwollenLip", 0.045 * s.X, ly, L.mouthW * (0.42 + 0.18 * kk), (0.05 + 0.02 * kk) * s.Y, top, 0.5, lerpColor(lipC, bruise, 0.3 * fade + 0.1))
		end
		mark("SplitLip", 0.05 * s.X, ly + 0.004 * s.Y, 0.028 * s.X, 0.012 * s.Y, top + 0.0012, 0.6, Color3.fromRGB(120, 4, 12))
		if lip > 0.6 then
			trickle(0.055 * s.X, ly - 0.02 * s.Y, 0.06 * s.X, (-0.33 - 0.05 * (severe and 1 or 0)) * s.Y, 0.018 * s.X)
		end
	end
	-- severe: blood on the chest, a mark on the skin over the upper chest (BuilderBody's torso surface)
	if severe and fresh and (n("cut") > 0.3 or bleed > 0.3 or lip > 0.5) then
		local torso = part(model, "UpperTorso")
		-- (required here, never at load: BuilderBody requires this module lazily too)
		local Body = require(script.Parent:WaitForChild("BuilderBody"))
		if torso and Body and Body.SurfaceMark then
			Body.SurfaceMark(folder, torso, "BloodChest", 0.12, 0.3, 0.18, 0.3, Color3.fromRGB(110, 6, 10), 0.35)
		end
	end
end

------------------------------------------------------------------------
-- Sweat
------------------------------------------------------------------------
local SKIN_PARTS = {
	"Head", "UpperTorso", "LowerTorso", "LeftUpperArm", "RightUpperArm", "LeftLowerArm", "RightLowerArm",
	"LeftUpperLeg", "RightUpperLeg", "LeftLowerLeg", "RightLowerLeg",
}

-- sheen spots, beads and drips on the face (its own folder: it survives face rebuilds as long as
-- the level and the head are unchanged)
local function faceSweat(model, app, q)
	local head = part(model, "Head")
	local look = model:FindFirstChild("BoxerLook")
	if not (head and look) then
		return
	end
	local faceF = look:FindFirstChild("Face")
	local detail = (faceF and faceF:GetAttribute("Detail")) or model:GetAttribute("Detail") or "full"
	local L = Head.FaceLayout(head, app.face or {})
	local drawnStyle = faceF and faceF:GetAttribute("FaceStyle")
	if drawnStyle then
		Head.DecalLayout(L)
	end
	-- the face sliders move the brow / nose the sheen follows: they are part of the key too (and the face style)
	local key = string.format("%.2f|%s|%.3f|%.3f|%.3f|%s", q, tostring(detail), head.Size.X, L.browY, L.noseTopY, tostring(drawnStyle or ""))
	local old = look:FindFirstChild("FaceSweat")
	if old and old:GetAttribute("Key") == key then
		local a = old:FindFirstChild("SweatAnchor")
		local w = a and a:FindFirstChildOfClass("WeldConstraint")
		if w and w.Part0 == head then
			return
		end
	end
	if q < 0.1 or detail == "low" then
		if old then
			old:Destroy()
		end
		return
	end
	local folder = getFolder(model, "FaceSweat")
	folder:SetAttribute("Key", key)
	local s = L.s
	local hcf = head.CFrame
	local anchor = mk(folder, head, "SweatAnchor", V3(0.05, 0.05, 0.05), hcf, WHITE, "Block", SMOOTH, 1)
	-- specular highlights where a wet face catches the light (transparent parts, not Reflectance)
	local cheekRise = (faceF and faceF:GetAttribute("CheekRise")) or 0
	local spots = {
		-- (x, y, w, h, base: what it lies on, the nose bridge or a full cheek)
		{ 0, L.browY + 0.08 * s.Y, 0.24, 0.1 }, { 0, L.noseTopY - L.noseLen * 0.45, 0.05, 0.1, L.noseB * 0.2 },
		{ -0.28 * s.X, -0.02 * s.Y, 0.12, 0.07, cheekRise }, { 0.28 * s.X, -0.02 * s.Y, 0.12, 0.07, cheekRise }, { 0, -0.36 * s.Y, 0.12, 0.06 },
	}
	for i, sp in ipairs(spots) do
		if detail == "full" or i <= 3 then
			-- (faint: a wet face catches the light, it does not wear white patches)
			local cf, size = lens(L, sp[1], sp[2], sp[3] * s.X * 0.85, sp[4] * s.Y * 0.85, 0.0016, 0.85, nil, sp[5])
			mk(folder, head, "Sheen", size, hcf * cf, WHITE, "Ellipsoid", SMOOTH, 0.985 - 0.04 * q)
		end
	end
	if detail ~= "full" then
		return
	end
	if q >= 0.35 then
		local rng = Random.new(((app.face and app.face.seed) or 7) + 505)
		for _ = 1, math.floor(3 + 7 * q) do
			local x = rng:NextNumber(-0.3, 0.3) * s.X
			-- (on a drawn face the beads sit on the forehead above the drawn brows, never on their ink)
			local y = L.browY + rng:NextNumber(-0.02, 0.18) * s.Y + (drawnStyle and 0.07 * s.Y or 0)
			local sz = rng:NextNumber(0.018, 0.03)
			if not (drawnStyle and Head.DecalInkHit(L, x, y, sz, sz * 1.3)) then
				local cf, size = lens(L, x, y, sz, sz * 1.3, 0.006, 0.4)
				local bead = mk(folder, head, "SweatBead", size, hcf * cf, lerpColor(skinOf(app), WHITE, 0.32), "Ellipsoid", SMOOTH, 0.5)
				bead.Reflectance = 0.08
			end
		end
	end
	if q >= 0.4 then
		for _, pos in ipairs({ surfPoint(L, 0.05 * s.X, L.browY + 0.05 * s.Y, 0.01), V3(0, -0.5 * s.Y, L.front(0) * 0.8) }) do
			local a = Instance.new("Attachment")
			a.Name = "Drip"
			a.Position = pos
			a.Parent = anchor
			local pe = Instance.new("ParticleEmitter")
			pe.Name = "SweatDrip"
			pe.Rate = 4 * q
			pe.Lifetime = NumberRange.new(0.5, 0.8)
			pe.Speed = NumberRange.new(0, 0.2)
			pe.Acceleration = V3(0, -14, 0)
			pe.Size = NumberSequence.new(0.035)
			pe.Transparency = NumberSequence.new(0.3, 0.7)
			pe.Color = ColorSequence.new(Color3.fromRGB(235, 240, 245))
			pe.LightInfluence = 1
			pe.Parent = a
		end
	end
end

-- level 0..1; the model attribute "Sweat" is the single source of truth (0.05 steps).
-- Body.SetSweat (BuilderBody) handles muscles, gloves and wraps after this.
function Head.SetSweat(model, app, level)
	app = app or {}
	local q = math.floor(clamp(tonumber(level) or 0, 0, 1) * 20 + 0.5) / 20
	model:SetAttribute("Sweat", q)
	-- a subtle skin sheen: Reflectance mirrors the sky, so keep it low or skin glows white
	local base = (app.face and app.face.shine or 0) * 0.03
	local r = clamp(base + q * 0.05, 0, 0.08)
	for _, n in ipairs(SKIN_PARTS) do
		local p = part(model, n)
		if p and p:IsA("BasePart") then
			if math.abs(p.Reflectance - r) > 1e-4 then
				p.Reflectance = r
			end
			if q > 0.05 then
				if p:GetAttribute("DryMaterial") == nil then
					local ok, name = pcall(function()
						return p.Material.Name
					end)
					p:SetAttribute("DryMaterial", ok and name or "")
				end
				p.Material = SMOOTH
			elseif p:GetAttribute("DryMaterial") ~= nil then
				local name = p:GetAttribute("DryMaterial")
				p:SetAttribute("DryMaterial", nil)
				pcall(function()
					if name ~= "" then
						p.Material = Enum.Material[name]
					end
				end)
			end
		end
	end
	Hair.Wet(model, q)
	faceSweat(model, app, q)
	faceGrime(model, app)
end

------------------------------------------------------------------------
-- Build steps (called by Builder.Cosmetics)
------------------------------------------------------------------------
Head.Face = faceBuild -- (model, app, opts, build)
Head.Hair = Hair.Build -- (model, app, opts): BuilderHair
Head.Beard = beardBuild -- (model, app, opts)

------------------------------------------------------------------------
-- Hair forwards (BuilderHair) and the helpers the hair shares with the face
------------------------------------------------------------------------
-- hides every hair part / strand a sparring headgear or a robe hood would swallow (BuilderHair)
function Head.ApplyHairHidden(model)
	return Hair.ApplyHairHidden(model)
end

-- region = "headgear" | "hood"; BuilderBody's SetRobe and SetHeadgear below call this
function Head.SetHairHidden(model, region, on)
	return Hair.SetHairHidden(model, region, on)
end

-- A's part budget, the head-surface helpers and the face layout's neighbours, shared with BuilderHair
Head.Shared = {
	lum = lum, skinOf = skinOf, joint = joint, axisCF = axisCF,
	surfNormal = surfNormal, surfPoint = surfPoint, surfCF = surfCF, surfaceLine = surfaceLine, surfacePath = surfacePath,
	countParts = countParts, extraOf = extraOf,
	A_BUDGET = A_BUDGET, FACE_CAP = FACE_CAP, BEARD_RESERVE = BEARD_RESERVE, HAIR_MAX = HAIR_MAX,
}

return Head
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="52">
        <Properties>
          <string name="Name">BuilderKit</string>
          <string name="Source"><![CDATA[-- BuilderKit: part and colour helpers shared by the character builder modules.
-- Builder (facade: scales, HumanoidDescription, Cosmetics/Apply/CreateNPC), BuilderHead (face, hair,
-- beard, damage, sweat, headgear) and BuilderBody (colours, muscles, attire, hands, robe) all make their
-- extra parts with these, so every layer is welded, named and foldered the same way.
-- * V3 / CF / ANG / SMOOTH short aliases; lerpColor / darken / contrast / rgb colour maths
-- * weld, mk (part factory), textPatch (SurfaceGui text), getFolder (fresh BoxerLook sub-folder), part
-- * joint (animatable Motor6D, CONTRACTS section 5), font (safe Enum.Font lookup), setAttr (change-only)
-- * sig / cached / seal: per-folder rebuild caching (skip rebuilding a layer whose inputs did not change)
-- Requires none of the other builder modules, so they can all require it without a cycle.
local Kit = {}

-- the game's faces (the default text of a patch is the sign face; a Catalog brand names its own Enum.Font)
local Typography
do
	local ok, m = pcall(function()
		return require(script.Parent:WaitForChild("Typography", 5))
	end)
	Typography = ok and type(m) == "table" and m or nil
end

local V3 = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local SMOOTH = Enum.Material.SmoothPlastic

-- false = always rebuild every layer (debug switch for the per-folder signature cache)
Kit.CACHE = true

local function lerpColor(a, b, t)
	return a:Lerp(b, math.clamp(t, 0, 1))
end

local function darken(c, k)
	return Color3.new(c.R * k, c.G * k, c.B * k)
end

local function contrast(c)
	local lum = 0.299 * c.R + 0.587 * c.G + 0.114 * c.B
	return lum > 0.55 and Color3.fromRGB(20, 20, 24) or Color3.fromRGB(245, 245, 245)
end

-- {r,g,b} (0..255, the save / Catalog format) -> Color3; anything else -> fallback
local function rgb(t, fallback)
	if type(t) == "table" and type(t[1]) == "number" then
		return Color3.fromRGB(t[1], t[2] or 0, t[3] or 0)
	end
	return fallback or Color3.new(1, 1, 1)
end

-- Enum.Font by NAME (Catalog brand fonts); unknown names fall back to GothamBlack instead of erroring
local fontCache = {}
local function font(name)
	if type(name) ~= "string" or name == "" then
		return Enum.Font.GothamBlack
	end
	local f = fontCache[name]
	if f == nil then
		local ok, res = pcall(function()
			return Enum.Font[name]
		end)
		f = ok and res or Enum.Font.GothamBlack
		fontCache[name] = f
	end
	return f
end

-- attributes replicate on every write, so only write real changes
local function setAttr(inst, key, value)
	if inst:GetAttribute(key) ~= value then
		inst:SetAttribute(key, value)
	end
end

------------------------------------------------------------------------
-- Part helpers
------------------------------------------------------------------------
local function weld(part, anchor)
	local w = Instance.new("WeldConstraint")
	w.Part0 = anchor
	w.Part1 = part
	w.Parent = part
end

-- shape: "Block" (default), "Ball", "Cylinder", "Ellipsoid", "Wedge"
local function mk(folder, anchor, name, size, cf, color, shape, material, transparency)
	local p = (shape == "Wedge") and Instance.new("WedgePart") or Instance.new("Part")
	p.Name = name
	p.Size = V3(math.max(size.X, 0.02), math.max(size.Y, 0.02), math.max(size.Z, 0.02))
	p.Color = color
	p.Material = material or SMOOTH
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CastShadow = false
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.Anchored = false
	if shape == "Ball" then
		p.Shape = Enum.PartType.Ball
	elseif shape == "Cylinder" then
		p.Shape = Enum.PartType.Cylinder
	elseif shape == "Ellipsoid" then
		local m = Instance.new("SpecialMesh")
		m.MeshType = Enum.MeshType.Sphere
		m.Parent = p
	end
	if transparency then
		p.Transparency = transparency
	end
	p.CFrame = cf
	if anchor then
		weld(p, anchor)
	end
	p.Parent = folder
	return p
end

-- fontName (optional) = an Enum.Font name; bg (optional Color3) = a filled label (sponsor patches)
-- the game's icon set (Shared.IconData, tools/ui): a glove logo prints its icon instead of a text glyph
local IconData
do
	local ok, m = pcall(function()
		return require(script.Parent:WaitForChild("IconData", 5))
	end)
	IconData = ok and type(m) == "table" and m or nil
end
local function iconEntry(name)
	local e = name and IconData and IconData.icons and IconData.icons[name]
	return (e and (tonumber(e.id) or 0) > 0) and e or nil
end
-- "icon:<name>" for textPatch when that icon is uploaded (nil otherwise: the caller keeps its text)
function Kit.IconText(name)
	return iconEntry(name) and ("icon:" .. name) or nil
end

local function textPatch(folder, anchor, name, size, cf, text, textColor, face, fontName, bg)
	local p = mk(folder, anchor, name, size, cf, Color3.new(0, 0, 0), "Block", SMOOTH, 1)
	local sg = Instance.new("SurfaceGui")
	sg.Face = face or Enum.NormalId.Front
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 120
	sg.LightInfluence = 0.6
	local e = iconEntry(type(text) == "string" and text:match("^icon:(%w+)$"))
	if e then
		-- an icon: the white glyph tinted the text colour, fitted to the patch
		local img = Instance.new("ImageLabel")
		img.Size = UDim2.fromScale(1, 1)
		img.BackgroundTransparency = 1
		img.Image = "rbxassetid://" .. tostring(e.id)
		img.ImageRectOffset = Vector2.new(e.x, e.y)
		img.ImageRectSize = Vector2.new(IconData.cell or 256, IconData.cell or 256)
		img.ImageColor3 = textColor
		img.ScaleType = Enum.ScaleType.Fit
		img.Parent = sg
		sg.Parent = p
		return p
	end
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = bg and 0 or 1
	if bg then
		t.BackgroundColor3 = bg
		t.BorderSizePixel = 0
	end
	t.Text = text
	t.TextScaled = true
	if fontName then
		t.Font = font(fontName)
	elseif Typography then
		Typography.Apply(t, "sign")
	else
		t.Font = Enum.Font.GothamBlack
	end
	t.TextColor3 = textColor
	t.Parent = sg
	sg.Parent = p
	return p
end

local function getFolder(model, name)
	local look = model:FindFirstChild("BoxerLook")
	if not look then
		look = Instance.new("Folder")
		look.Name = "BoxerLook"
		look.Parent = model
	end
	local f = look:FindFirstChild(name)
	if f then
		f:Destroy()
	end
	f = Instance.new("Folder")
	f.Name = name
	f.Parent = look
	return f
end

local function part(model, name)
	return model:FindFirstChild(name)
end

-- animatable cosmetic joint (CONTRACTS section 5): the moving part has no WeldConstraint, the
-- client animates Motor6D.Transform. C0 = where part1 sits in part0's space, C1 = identity.
local function joint(part0, part1, name)
	local m = Instance.new("Motor6D")
	m.Name = name or "Joint"
	m.Part0 = part0
	m.Part1 = part1
	m.C0 = part0.CFrame:Inverse() * part1.CFrame
	m.C1 = CF()
	m.Parent = part1
	return m
end

------------------------------------------------------------------------
-- Rebuild caching. Builder.Cosmetics runs after every session, sleep, purchase and fight; a layer
-- whose inputs did not change keeps its parts instead of destroying and re-replicating ~50 of them.
------------------------------------------------------------------------
-- stable text signature of any mix of numbers (rounded), strings, booleans and nested tables
local function sigInto(out, v)
	local t = typeof(v)
	if t == "number" then
		out[#out + 1] = string.format("%.3f", v)
	elseif t == "table" then
		local keys = {}
		for k in pairs(v) do
			keys[#keys + 1] = k
		end
		table.sort(keys, function(a, b)
			return tostring(a) < tostring(b)
		end)
		out[#out + 1] = "{"
		for _, k in ipairs(keys) do
			out[#out + 1] = tostring(k) .. "="
			sigInto(out, v[k])
		end
		out[#out + 1] = "}"
	elseif t == "Vector3" then
		out[#out + 1] = string.format("%.3f,%.3f,%.3f", v.X, v.Y, v.Z)
	elseif t == "Color3" then
		out[#out + 1] = string.format("%.3f,%.3f,%.3f", v.R, v.G, v.B)
	else
		out[#out + 1] = tostring(v)
	end
	out[#out + 1] = ";"
end

local function sig(...)
	local out = {}
	for i = 1, select("#", ...) do
		sigInto(out, (select(i, ...)))
	end
	return table.concat(out)
end

-- fixed-length digest of a signature: the folder stores 16 hex chars instead of the 400-1100 char key
-- (attributes replicate to every client, and only the server's cached() ever reads them).
-- Two 32-bit rolling hashes, exact in doubles (h1 * 33 < 2^38, h2 * 65599 < 2^49).
local function digest(s)
	local h1, h2 = 5381, 0
	for i = 1, #s do
		local c = string.byte(s, i)
		h1 = (h1 * 33 + c) % 4294967296
		h2 = (h2 * 65599 + c) % 4294967296
	end
	return string.format("%08x%08x", h1, h2)
end

-- every weld / motor in the folder still holds on to a part of this model (a respawn, a head swap or
-- a rescale through ApplyDescription replaces or moves the anchors, so the old parts are stale)
local function intact(model, folder)
	for _, d in ipairs(folder:GetDescendants()) do
		if d:IsA("WeldConstraint") or d:IsA("Motor6D") or d:IsA("Weld") then
			local p0 = d.Part0
			if not (p0 and p0:IsDescendantOf(model)) or not d.Part1 then
				return false
			end
		end
	end
	return true
end

-- true when BoxerLook/<name> was built from exactly this signature and is still attached
local function cached(model, name, key)
	if not Kit.CACHE then
		return false
	end
	local look = model:FindFirstChild("BoxerLook")
	local f = look and look:FindFirstChild(name)
	return f ~= nil and f:GetAttribute("Sig") == digest(key) and intact(model, f)
end

-- stamp a finished folder with the signature it was built from (set last: a build that errors
-- half way never gets a signature, so the next call rebuilds it)
local function seal(model, name, key)
	local look = model:FindFirstChild("BoxerLook")
	local f = look and look:FindFirstChild(name)
	if f then
		f:SetAttribute("Sig", digest(key))
	end
end

Kit.V3 = V3
Kit.CF = CF
Kit.ANG = ANG
Kit.SMOOTH = SMOOTH
Kit.lerpColor = lerpColor
Kit.darken = darken
Kit.contrast = contrast
Kit.rgb = rgb
Kit.font = font
Kit.setAttr = setAttr
Kit.weld = weld
Kit.mk = mk
Kit.textPatch = textPatch
Kit.getFolder = getFolder
Kit.part = part
Kit.joint = joint
Kit.sig = sig
Kit.digest = digest
Kit.intact = intact
Kit.cached = cached
Kit.seal = seal

------------------------------------------------------------------------
-- Mesh templates (BuilderTiers' body parts, BuilderGear's gear): what a load must show before it is used, the
-- retry schedule of a failed load, the "a mesh that failed is ready now" notice, and the player's own loads first
------------------------------------------------------------------------
-- A MeshPart whose mesh never arrived is drawn by the engine as its plain box (a CreateMeshPartAsync that returned a
-- part without geometry, an id whose "content representation is being generated" for minutes after the upload): it
-- must never be cloned onto a boxer. A real load names its content (MeshId, or a MeshContent with a source) and has a
-- finite MeshSize above zero. A property the part does not have (a simulator stub) is no evidence either way.
-- Returns ok, why
function Kit.MeshLoaded(mp)
	if mp == nil then
		return false, "no part"
	end
	local okId, id = pcall(function()
		return mp.MeshId
	end)
	local named = nil
	if okId and type(id) == "string" then
		named = id ~= ""
	end
	if named == false then
		local okC, c = pcall(function()
			return mp.MeshContent
		end)
		if okC and c ~= nil then
			local okU, uri = pcall(function()
				return c.Uri
			end)
			local okO, obj = pcall(function()
				return c.Object
			end)
			named = (okU and type(uri) == "string" and uri ~= "") or (okO and obj ~= nil)
		end
	end
	if named == false then
		return false, "no mesh content (MeshId is empty)"
	end
	local okS, ms = pcall(function()
		return mp.MeshSize
	end)
	if okS and typeof(ms) == "Vector3" then
		for _, v in ipairs({ ms.X, ms.Y, ms.Z }) do
			if v ~= v or v == math.huge or v <= 1e-4 then
				return false, "no geometry (MeshSize " .. tostring(ms) .. ")"
			end
		end
	end
	return true
end

-- seconds before the n-th retry of a failed load (n = 1 after the first failure); nil past the schedule (the caller's
-- own RETRY then applies, on demand). The schedule spans ~4.5 minutes: a freshly uploaded mesh answers "Asset content
-- representation is being generated" for a while and then loads
Kit.ASSET_BACKOFF = { 5, 10, 20, 40, 60, 60, 60 }
function Kit.RetryDelay(n)
	return Kit.ASSET_BACKOFF[n]
end
-- an error worth retrying soon (the asset exists but is not ready / the request did not go through)
function Kit.Transient(err)
	local s = string.lower(tostring(err or ""))
	for _, k in ipairs({ "being generated", "representation", "timeout", "timed out", "throttl", "http", "503", "502", "429", "try again" }) do
		if string.find(s, k, 1, true) then
			return true
		end
	end
	return false
end

-- the background retry: fn() after `delay` seconds on a running server only (a simulator or an edit-mode require has
-- no one to retry for, and a pending timer would keep it alive). Kit.Services.schedule(delay, fn) replaces it (tests)
Kit.Services = Kit.Services or {}
local function running()
	local ok, r = pcall(function()
		return game:GetService("RunService"):IsRunning()
	end)
	return ok and r == true
end
function Kit.Schedule(delay, fn)
	local s = Kit.Services.schedule
	if s then
		return s(delay, fn)
	end
	if not running() then
		return false
	end
	task.delay(delay, fn)
	return true
end

-- "a template that had failed has loaded": Builder rebuilds the boxers that were built without it (their cached
-- layers keep everything else; the layer that fell back now resolves to the mesh and rebuilds)
local readyListeners = {}
function Kit.OnAssetReady(fn)
	table.insert(readyListeners, fn)
	return fn
end
function Kit.AssetReady(kind, id)
	for _, fn in ipairs(readyListeners) do
		task.spawn(function()
			local ok, err = pcall(fn, kind, id)
			if not ok then
				warn("[Boxer] asset-ready listener failed:", err)
			end
		end)
	end
end

-- The player's own loads first: a build that runs Kit.Priority(fn) (Builder.Apply on a player's character) marks its
-- thread; while such a load is in flight, every other template load (the background preloaders, the gym's NPC
-- builds) waits for it, at most PRIORITY_WAIT seconds, so the boxer the menu shows is never queued behind a few
-- hundred background meshes (in Studio the server and the client share one asset pipeline)
Kit.PRIORITY_WAIT = 3
local priorityThreads = setmetatable({}, { __mode = "k" })
local priorityLoads = 0
function Kit.Priority(fn, ...)
	local co = coroutine.running()
	local was = priorityThreads[co]
	priorityThreads[co] = true
	local res = table.pack(pcall(fn, ...))
	priorityThreads[co] = was
	if not res[1] then
		error(res[2], 0)
	end
	return table.unpack(res, 2, res.n)
end
function Kit.IsPriority()
	return priorityThreads[coroutine.running()] == true
end
-- wrap one template load: a priority thread's load is counted; any other thread first waits out the priority loads
function Kit.Load(fn)
	if Kit.IsPriority() then
		priorityLoads += 1
		local res = table.pack(pcall(fn))
		priorityLoads -= 1
		if not res[1] then
			error(res[2], 0)
		end
		return table.unpack(res, 2, res.n)
	end
	local t0 = os.clock()
	while priorityLoads > 0 and os.clock() - t0 < Kit.PRIORITY_WAIT do
		task.wait()
	end
	return fn()
end
function Kit.PriorityLoads()
	return priorityLoads
end

------------------------------------------------------------------------
-- Fit audit: every built piece on a model is welded to a live part of it and sits on that part
------------------------------------------------------------------------
-- For every BasePart under BoxerLook (and every accessory handle): its joint (Weld / WeldConstraint / Motor6D) must
-- hold a part of the model that is still in it; a Weld / Motor6D must put the piece where it is (Part0.CFrame * C0 =
-- Part1.CFrame * C1: a C0 computed for another size or another part shows here); and the piece must touch its anchor:
-- the distance from the piece's centre to the anchor's box (in the anchor's space) at most the piece's half extent +
-- slack (0.15 studs: a buckle on a belt over the trousers, a logo patch on the glove's face anchored to the hand). A
-- piece welded to another built piece is followed to the body part at the end of the chain. The head-worn folders
-- (Headgear, Hat) must also be fitted to the live head: their HeadSize record equal to the head's Size (gear sized for
-- another head sits off it although welded).
-- Returns { problems = { "Folder/Piece: why" ... }, pieces = n }
local function jointOf(p)
	for _, c in ipairs(p:GetChildren()) do
		if c:IsA("Weld") or c:IsA("WeldConstraint") or c:IsA("Motor6D") then
			return c
		end
	end
	return nil
end
local function boxDistance(rel, half)
	local dx = math.max(math.abs(rel.X) - half.X, 0)
	local dy = math.max(math.abs(rel.Y) - half.Y, 0)
	local dz = math.max(math.abs(rel.Z) - half.Z, 0)
	return math.sqrt(dx * dx + dy * dy + dz * dz)
end
function Kit.FitAudit(model, opts)
	opts = opts or {}
	local slack = opts.slack or 0.15
	local out = { problems = {}, pieces = 0 }
	local look = model:FindFirstChild("BoxerLook")
	local list = {}
	if look then
		for _, d in ipairs(look:GetDescendants()) do
			if d:IsA("BasePart") then
				table.insert(list, d)
			end
		end
	end
	for _, acc in ipairs(model:GetChildren()) do
		local h = acc:IsA("Accessory") and acc:FindFirstChild("Handle")
		if h and h:IsA("BasePart") then
			table.insert(list, h)
		end
	end
	local function note(p, why)
		local f = p.Parent and p.Parent.Name or "?"
		table.insert(out.problems, f .. "/" .. p.Name .. ": " .. why)
	end
	local head = model:FindFirstChild("Head")
	for _, fname in ipairs({ "Headgear", "Hat" }) do
		local f = look and look:FindFirstChild(fname)
		local fit = f and f:GetAttribute("HeadSize")
		if f and #f:GetChildren() > 0 and head and head:IsA("BasePart") and typeof(fit) == "Vector3" and (fit - head.Size).Magnitude > 1e-3 then
			table.insert(out.problems, string.format("%s: fitted to a %s head, the head is %s", fname, tostring(fit), tostring(head.Size)))
		end
	end
	for _, p in ipairs(list) do
		out.pieces += 1
		local j = jointOf(p)
		local other = j and ((j.Part0 == p and j.Part1) or j.Part0)
		if not j then
			note(p, "not welded")
		elseif not (other and other:IsA("BasePart") and other:IsDescendantOf(model)) then
			note(p, "welded to " .. (other and other:GetFullName() or "nothing") .. " (not a part of this model)")
		else
			if j:IsA("Weld") or j:IsA("Motor6D") then
				local p0, p1 = j.Part0, j.Part1
				if p0 and p1 then
					local want = p0.CFrame * j.C0
					local have = p1.CFrame * j.C1
					local d = (want.Position - have.Position).Magnitude
					if d > 1e-3 + 0.01 * math.max(p.Size.X, p.Size.Y, p.Size.Z) then
						note(p, string.format("the weld puts it %.3f studs from where it is (C0 for another size or part)", d))
					end
				end
			end
			-- the body part at the end of the chain (a piece welded to a built piece: that piece's anchor)
			local anchor, hops = other, 0
			while anchor and hops < 4 and look and anchor:IsDescendantOf(look) do
				local j2 = jointOf(anchor)
				local o2 = j2 and ((j2.Part0 == anchor and j2.Part1) or j2.Part0)
				anchor, hops = o2, hops + 1
			end
			local target = (anchor and anchor:IsA("BasePart") and not (look and anchor:IsDescendantOf(look))) and anchor or other
			local rel = target.CFrame:PointToObjectSpace(p.Position)
			local reach = 0.5 * math.max(p.Size.X, p.Size.Y, p.Size.Z) + slack
			local gap = boxDistance(rel, target.Size * 0.5)
			if gap > reach then
				note(p, string.format("%.2f studs off %s (its own half extent %.2f)", gap - reach + slack, target.Name, reach - slack))
			end
		end
	end
	return out
end

return Kit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="53">
        <Properties>
          <string name="Name">BuilderTiers</string>
          <string name="Source"><![CDATA[-- BuilderTiers: the muscle-tier body parts on the server (tools/body/CONTRACT.md). The rig is the standard R15
-- body the HumanoidDescription builds (empty body-part ids: the engine's default parts); each of the 14
-- non-head parts is swapped for its tier's MeshPart with Humanoid:ReplaceBodyPartR15, and only when that
-- part's tier changes (a swap replicates one part).
-- * templates: one MeshPart per (frame, tier, part) (the frame's mesh family, BodyTiers.PartEntry; the tiers table's
--   .frame, else the model's Frame attribute), made once per server with AssetService:CreateMeshPartAsync
--   (pcall; concurrent callers wait for the same load; a failed id is retried after RETRY seconds) and given
--   the part-space RigAttachments / accessory attachments from BodyAssetData, an OriginalSize and every
--   attachment's OriginalPosition (the unscaled values the engine's body scaling multiplies) and an
--   AvatarPartScaleType "Classic" (the description runs at BodyTypeScale 0)
-- * the swap: the clone takes the replaced part's colour, material, collision and transparency; welds that held
--   on to the old part are moved to the new one; then the scale is checked once: ReplaceBodyPartR15 scales the
--   new part "as normal", i.e. from its OriginalSize by the humanoid's scales. Whatever the engine did, the part
--   ends at OriginalSize x the ratio the default part had (its Size / its OriginalSize, else the description's
--   Width / Height / Depth), the attachments at OriginalPosition x that ratio, and the joints that touch it are
--   re-aimed at its attachments (Builder.lua's headRecord / keepHeadScale guard the head swap the same way):
--   the part is scaled exactly once, never twice
-- * HipHeight follows the swapped legs (root -> hips -> knees -> ankles -> the soles, R15's rule
--   Height = HipHeight + RootPart.Size.Y / 2)
-- * an id 0 / a failed load keeps the part that is there (the default part, or the last tier that loaded)
-- * detail sets (Config.Detail.meshes): Apply(..., lite = true) swaps in each part's `lite` mesh (the v9 set the low
--   detail level wears) instead of the detailed one; a part showing the other set of its tier is swapped too
--   (attribute BodyMesh = the id it shows, BodyLite = true on a lite part)
-- Builder.Cosmetics runs Apply first (before the colours, so every layer is built on the final parts).
-- Tests: BuilderTiers.Services = { AssetService = fake, Content = fake } and BuilderTiers.Reset().
local BuilderTiers = {}

local Shared = script.Parent
local BodyTiers = require(Shared:WaitForChild("BodyTiers"))
local BodySurfaces = require(Shared:WaitForChild("BodySurfaces"))
local Kit = require(Shared:WaitForChild("BuilderKit"))

local V3 = Vector3.new
BuilderTiers.RETRY = 120 -- seconds between on-demand retries of a failed mesh id once the backoff (Kit.ASSET_BACKOFF) is spent
BuilderTiers.Services = {} -- overrides (tests): AssetService, Content
BuilderTiers.TAG = "WCBBodyMesh"

local cache = {} -- "tier:part" -> { part = template } | { loading = true } | { failed = os.clock() }
local stats = { loads = 0, failed = 0, swaps = 0 }

function BuilderTiers.Reset()
	for _, e in pairs(cache) do
		if e.part then
			pcall(function()
				e.part:Destroy()
			end)
		end
	end
	table.clear(cache)
	stats.loads, stats.failed, stats.swaps = 0, 0, 0
	if BuilderTiers.ResetPreload then
		BuilderTiers.ResetPreload()
	end
end

function BuilderTiers.Stats()
	return table.clone(stats)
end

local function assetService()
	return BuilderTiers.Services.AssetService or game:GetService("AssetService")
end

local function contentOf(uri)
	local C = BuilderTiers.Services.Content or Content
	if C and C.fromUri then
		return C.fromUri(uri)
	end
	return uri
end

local function vec(t)
	return V3(t[1], t[2], t[3])
end

local function valueChild(parent, class, name, value)
	local v = parent:FindFirstChild(name)
	if not (v and v:IsA(class)) then
		v = Instance.new(class)
		v.Name = name
		v.Parent = parent
	end
	v.Value = value
	return v
end

-- one template from a loaded MeshPart (unscaled: the Blender export's size and attachments)
local function prepare(mp, e)
	mp.Name = e.name
	mp.Size = vec(e.size)
	mp.Anchored = false
	mp.CanCollide = false
	mp.CanTouch = false
	mp.Massless = false
	for name, p in pairs(e.attachments) do
		local a = Instance.new("Attachment")
		a.Name = name
		a.Position = vec(p)
		if string.find(name, "GripAttachment", 1, true) then
			-- the tool grip points down the fist (the engine's default hands' grip orientation)
			a.CFrame = CFrame.new(vec(p)) * CFrame.Angles(-math.pi / 2, 0, 0)
		end
		valueChild(a, "Vector3Value", "OriginalPosition", vec(p))
		a.Parent = mp
	end
	valueChild(mp, "Vector3Value", "OriginalSize", vec(e.size))
	valueChild(mp, "StringValue", "AvatarPartScaleType", "Classic")
	mp:SetAttribute("BodyTier", e.tier)
	mp:SetAttribute("BodyMesh", e.id)
	mp:SetAttribute("BodyLite", e.lite == true or nil)
	mp:SetAttribute("BodyFrame", e.frame)
	-- the clients watch the mesh arrive (BoxerClient.MeshGuard: a rounded stand-in instead of the engine's box while it
	-- cannot be drawn); a clone keeps the tag
	pcall(function()
		mp:AddTag(BuilderTiers.TAG)
	end)
	-- (v17) the body's own box over the mesh box (the UpperTorso's shoulder caps widen the latter): BodyCoreSize
	local c = e.core or e.size
	if c[1] ~= e.size[1] or c[2] ~= e.size[2] or c[3] ~= e.size[3] then
		mp:SetAttribute("BodyCoreRatio", Vector3.new(c[1] / e.size[1], c[2] / e.size[2], c[3] / e.size[3]))
	end
	return mp
end

-- the template for (tier, part name) of a frame's family (frame nil = the default family), or nil + reason (not
-- uploaded / failed: the caller keeps its part). Yields on the first call for a key (CreateMeshPartAsync); later calls
-- are free. force: retry a failed key now (the background retry)
function BuilderTiers.Template(tier, name, lite, frame, force)
	local e = BodyTiers.PartEntry(tier, name, nil, lite, frame)
	if not e then
		return nil, "not uploaded"
	end
	local key = tier .. ":" .. name .. ":" .. e.id
	local c = cache[key]
	while c and c.loading do
		task.wait()
		c = cache[key]
	end
	if c and c.part then
		return c.part
	elseif c and c.failed and not force and os.clock() < (c.retryAt or c.failed + BuilderTiers.RETRY) then
		return nil, "failed"
	end
	local prev = c
	cache[key] = { loading = true }
	stats.loads += 1
	local ok, mp = Kit.Load(function()
		return pcall(function()
			return assetService():CreateMeshPartAsync(contentOf("rbxassetid://" .. e.id), {
				CollisionFidelity = Enum.CollisionFidelity.Box, RenderFidelity = Enum.RenderFidelity.Automatic,
			})
		end)
	end)
	if ok and mp then
		-- a part without geometry is drawn as a box: never swapped onto a boxer (the default part stays)
		local good, why = Kit.MeshLoaded(mp)
		if not good then
			pcall(function()
				mp:Destroy()
			end)
			ok, mp = false, why
		end
	end
	if ok and mp then
		ok = pcall(prepare, mp, e)
	end
	if not (ok and mp) then
		stats.failed += 1
		local tries = (prev and prev.tries or 0) + 1
		local delay = Kit.RetryDelay(tries)
		local now = os.clock()
		cache[key] = { failed = now, tries = tries, retryAt = now + (delay or BuilderTiers.RETRY), err = tostring(mp) }
		if tries == 1 or not delay then
			warn(string.format("[BodyTiers] mesh %d (tier %d %s) did not load (%s); the default part stays%s", e.id, tier, name,
				tostring(mp), delay and string.format(" (retrying in %ds, then on a backoff for a few minutes)", delay) or ""))
		end
		if delay then
			Kit.Schedule(delay, function()
				local f = cache[key]
				if f and f.failed and f.tries == tries then
					BuilderTiers.Template(tier, name, lite, frame, true)
				end
			end)
		end
		return nil, "failed"
	end
	cache[key] = { part = mp }
	if prev and prev.failed then
		print(string.format("[BodyTiers] mesh %d (tier %d %s) loaded after %d failed attempt(s); the boxers built without it are refitted",
			e.id, tier, name, prev.tries or 1))
		Kit.AssetReady("tier", e.id)
	end
	return mp
end

-- true while any body mesh is in its failed state (Builder keeps the boxers built meanwhile for a rebuild)
function BuilderTiers.Failing()
	for _, f in pairs(cache) do
		if f.failed then
			return true
		end
	end
	return false
end

-- Preload: the templates a server is about to need, loaded in the background so the first boxers do not wait on
-- them. Only the CURRENT frame's family: at server start the default family (every new boxer and the Creator start
-- on it) and its lite set; any other frame's family the first time a boxer is built on that frame (Apply calls
-- PreloadFrame: the tiers that boxer does not wear yet load behind his own, so a muscle-tier change or the Creator's
-- Starting / Peak toggle on that frame is instant). The other frames are never loaded up front: the whole set is
-- ~420 CreateMeshPartAsync calls (5 frames x 5 tiers x 14 parts + the lite set), and fired at start (in Studio: one
-- process for the server and the client, the moment the main menu opens) they saturated the asset pipeline for the
-- first minute while the player's own parts, the menu's clone and the Creator's previews waited behind them.
-- Paced: PRELOAD_GAP seconds between loads; a load the preloader has not reached yet is made on demand by the boxer
-- that needs it, and one in flight is shared (Template).
-- opts (optional): { gap = seconds, frames = { frame ids } (instead of the default family), lite = false (no lite
-- set), families = true (every frame's family after PRELOAD_DEFER: the old behaviour, tools only), defer = seconds }
BuilderTiers.PRELOAD_GAP = 0.1
BuilderTiers.PRELOAD_DEFER = 15
local preloaded = {} -- [frame id] = true: its family is loaded or queued (PreloadFrame runs once per frame)
local preloadQueue = {} -- { { tier, name, lite, frame } } the paced loader works through, in order
local preloadGap = BuilderTiers.PRELOAD_GAP
local preloadRunning = false

local function queueFamily(frame, lite)
	for tier = 1, BodyTiers.TIERS do
		for _, name in ipairs(BodyTiers.PARTS) do
			local e = BodyTiers.PartEntry(tier, name, nil, lite, frame)
			if e and not cache[tier .. ":" .. name .. ":" .. e.id] then
				preloadQueue[#preloadQueue + 1] = { tier, name, lite, frame }
			end
		end
	end
end

local preloadGen = 0 -- bumped by ResetPreload: a loader of an older generation stops
local function runPreload()
	if preloadRunning then
		return
	end
	preloadRunning = true
	local gen = preloadGen
	task.spawn(function()
		while gen == preloadGen and preloadQueue[1] do
			local q = table.remove(preloadQueue, 1)
			BuilderTiers.Template(q[1], q[2], q[3], q[4])
			if preloadGap > 0 then
				task.wait(preloadGap)
			end
		end
		if gen == preloadGen then
			preloadRunning = false
		end
	end)
end

-- one frame's family (every tier of its 14 parts), in the background, once per frame id (nil = the default family)
function BuilderTiers.PreloadFrame(frame, lite)
	frame = (type(frame) == "string" and frame ~= "") and frame or BodyTiers.DEFAULT_FRAME
	local key = lite and (frame .. "|lite") or frame
	if preloaded[key] then
		return false
	end
	preloaded[key] = true
	queueFamily(frame ~= BodyTiers.DEFAULT_FRAME and frame or nil, lite == true)
	runPreload()
	return true
end

-- one set of tiers (BodyTiers.Tiers: { [part] = tier, frame = id }), in the background behind the queue: the parts a
-- screen is about to show (the Creator's body types at Starting and Peak), not every tier of their families. Paced like
-- the families; parts already loaded or queued are skipped. Returns the number queued.
function BuilderTiers.PreloadTiers(tiers)
	if type(tiers) ~= "table" then
		return 0
	end
	local frame = (type(tiers.frame) == "string" and tiers.frame ~= BodyTiers.DEFAULT_FRAME) and tiers.frame or nil
	local queued = {}
	for _, q in ipairs(preloadQueue) do
		queued[tostring(q[1]) .. ":" .. q[2] .. ":" .. tostring(q[3]) .. ":" .. tostring(q[4])] = true
	end
	local n = 0
	for _, name in ipairs(BodyTiers.PARTS) do
		local tier = tiers[name]
		local e = tier and BodyTiers.PartEntry(tier, name, nil, false, frame)
		local qk = tostring(tier) .. ":" .. name .. ":false:" .. tostring(frame)
		if e and not cache[tier .. ":" .. name .. ":" .. e.id] and not queued[qk] then
			queued[qk] = true
			preloadQueue[#preloadQueue + 1] = { tier, name, false, frame }
			n += 1
		end
	end
	if n > 0 then
		runPreload()
	end
	return n
end

-- (tests) forget which families were queued; a loader in flight finishes its current load and stops
function BuilderTiers.ResetPreload()
	preloadGen += 1
	preloadRunning = false
	table.clear(preloaded)
	table.clear(preloadQueue)
end

function BuilderTiers.Preload(opts)
	opts = type(opts) == "table" and opts or {}
	preloadGap = tonumber(opts.gap) or BuilderTiers.PRELOAD_GAP
	local frames = type(opts.frames) == "table" and opts.frames or { BodyTiers.DEFAULT_FRAME }
	for _, f in ipairs(frames) do
		BuilderTiers.PreloadFrame(f)
		if opts.lite ~= false and f == BodyTiers.DEFAULT_FRAME then
			BuilderTiers.PreloadFrame(f, true)
		end
	end
	if opts.families == true then
		task.delay(tonumber(opts.defer) or BuilderTiers.PRELOAD_DEFER, function()
			for _, f in ipairs(BodyTiers.Frames()) do
				BuilderTiers.PreloadFrame(f)
			end
		end)
	end
end

-- per-axis Size / OriginalSize of a body part (the engine's scale for it), nil when it has no record
local function ratioOf(p)
	local o = p and p:FindFirstChild("OriginalSize")
	if not (o and o:IsA("Vector3Value")) then
		return nil
	end
	local v = o.Value
	if v.X <= 1e-4 or v.Y <= 1e-4 or v.Z <= 1e-4 then
		return nil
	end
	local s = p.Size
	return V3(s.X / v.X, s.Y / v.Y, s.Z / v.Z)
end
BuilderTiers.RatioOf = ratioOf

-- the joints that touch a part, aimed at their rig attachments (Motor6D "X" uses the "XRigAttachment" pair)
local function reaim(model, p)
	for _, m in ipairs(model:GetDescendants()) do
		if m:IsA("Motor6D") and (m.Part0 == p or m.Part1 == p) then
			local an = m.Name .. "RigAttachment"
			local a0 = m.Part0 and m.Part0:FindFirstChild(an)
			local a1 = m.Part1 and m.Part1:FindFirstChild(an)
			if a0 and a0:IsA("Attachment") and (m.C0.Position - a0.CFrame.Position).Magnitude > 1e-4 then
				m.C0 = a0.CFrame
			end
			if a1 and a1:IsA("Attachment") and (m.C1.Position - a1.CFrame.Position).Magnitude > 1e-4 then
				m.C1 = a1.CFrame
			end
		end
	end
end
BuilderTiers.Reaim = reaim

-- the part at exactly OriginalSize x ratio, its attachments at OriginalPosition x ratio (true when fixed)
local function scaleOnce(p, ratio)
	local fixed = false
	local o = p:FindFirstChild("OriginalSize")
	if o and o:IsA("Vector3Value") then
		local want = o.Value * ratio
		if (p.Size - want).Magnitude > 1e-3 then
			p.Size = want
			fixed = true
		end
	end
	for _, a in ipairs(p:GetChildren()) do
		if a:IsA("Attachment") then
			local op = a:FindFirstChild("OriginalPosition")
			if op and op:IsA("Vector3Value") then
				local want = op.Value * ratio
				if (a.Position - want).Magnitude > 1e-4 then
					a.Position = want
					fixed = true
				end
			end
		end
	end
	return fixed
end

-- a body part swap that did not take (ReplaceBodyPartR15 refused it, or something else is in its place): warned once
-- per (part, reason) with where the model was (outside the DataModel the engine's rig operations misbehave), so a
-- silent failure is a visible Output line. SwapFailures: the count, for tests / the diagnostic
BuilderTiers.SwapFailures = 0
local swapWarned = {}
function BuilderTiers.SwapFailed(model, name, reason)
	BuilderTiers.SwapFailures += 1
	local inGame = false
	pcall(function()
		inGame = model:IsDescendantOf(game)
	end)
	local key = name .. "|" .. tostring(reason) .. "|" .. tostring(inGame)
	if swapWarned[key] then
		return
	end
	swapWarned[key] = true
	warn(string.format("[Boxer] body part swap did not take on %s: %s (%s); %s", tostring(model and model.Name), name, tostring(reason),
		inGame and "the model is in the DataModel" or "the model is OUTSIDE the DataModel: the engine cannot swap its parts there"))
end

local COPY = { "Color", "Material", "Transparency", "Reflectance", "CanCollide", "CanQuery", "CanTouch", "Massless", "CastShadow", "CFrame" }

-- swap one part (true when the model now carries the template's tier); scale = the description's
-- Width / Height / Depth (used when the old part has no OriginalSize)
local function swap(model, hum, name, template, scale)
	local old = model:FindFirstChild(name)
	if not (old and old:IsA("BasePart")) then
		return false
	end
	local ratio = ratioOf(old) or scale or V3(1, 1, 1)
	local new = template:Clone()
	for _, k in ipairs(COPY) do
		pcall(function()
			new[k] = old[k]
		end)
	end
	-- welds holding on to the old part (cosmetic layers, a robe, damage marks): moved over, so nothing drops
	local holders = {}
	for _, d in ipairs(model:GetDescendants()) do
		if (d:IsA("WeldConstraint") or d:IsA("Weld")) and (d.Part0 == old or d.Part1 == old) then
			table.insert(holders, d)
		end
	end
	local enum = Enum.BodyPartR15[name]
	local ok, err = pcall(function()
		hum:ReplaceBodyPartR15(enum, new)
	end)
	local got = model:FindFirstChild(name)
	if not ok or got ~= new then
		-- a swap that did not take is a silent default part under tier-fitted gear: one Output line per reason
		BuilderTiers.SwapFailed(model, name, ok and "the model still carries " .. (got and (got.ClassName .. " " .. got.Name) or "no part") or tostring(err))
		new:Destroy()
		return false
	end
	if not new:IsA("MeshPart") then
		BuilderTiers.SwapFailed(model, name, "the engine put a " .. new.ClassName .. " in place of the tier MeshPart")
	end
	scaleOnce(new, ratio)
	reaim(model, new)
	new:SetAttribute("BodyRatio", ratio)
	if scale then
		new:SetAttribute("BodyScale", scale)
	end
	-- (v16) the skin surface maps: a clone of the authored SurfaceAppearance for the part's tier and frame, tinted to
	-- the part's Color and following it (none on a lite part; BodySurfaces)
	pcall(BodySurfaces.Attach, new)
	-- (v17) the body's own size (BodyCoreSize = Size x BodyCoreRatio), kept in step with any later rescale
	local cr = new:GetAttribute("BodyCoreRatio")
	if typeof(cr) == "Vector3" then
		local function core()
			new:SetAttribute("BodyCoreSize", new.Size * cr)
		end
		core()
		new:GetPropertyChangedSignal("Size"):Connect(core)
		-- its mass stays the body's: a Box-fidelity MeshPart weighs its box (Size, caps included), so the density is
		-- scaled by core volume / box volume (the Humanoid is tuned for an R15 body's mass)
		pcall(function()
			local pp = new.CurrentPhysicalProperties
			local k = cr.X * cr.Y * cr.Z
			new.CustomPhysicalProperties = PhysicalProperties.new(pp.Density * k, pp.Friction, pp.Elasticity,
				pp.FrictionWeight, pp.ElasticityWeight)
		end)
	end
	for _, w in ipairs(holders) do
		if w.Parent then
			if w.Part0 == old then
				w.Part0 = new
			end
			if w.Part1 == old then
				w.Part1 = new
			end
		end
	end
	if old.Parent ~= nil then
		old:Destroy()
	end
	stats.swaps += 1
	return true
end

-- R15: Height = HipHeight + RootPart.Size.Y / 2, from the bind pose: root -> hip -> knee -> ankle -> sole
local function legBottom(model, side)
	local root = model:FindFirstChild("HumanoidRootPart")
	local lt = model:FindFirstChild("LowerTorso")
	local ul = model:FindFirstChild(side .. "UpperLeg")
	local ll = model:FindFirstChild(side .. "LowerLeg")
	local ft = model:FindFirstChild(side .. "Foot")
	if not (root and lt and ul and ll and ft) then
		return nil
	end
	local function att(p, n)
		local a = p:FindFirstChild(n)
		return a and a:IsA("Attachment") and a.Position or nil
	end
	local rA, rB = att(root, "RootRigAttachment"), att(lt, "RootRigAttachment")
	local hA, hB = att(lt, side .. "HipRigAttachment"), att(ul, side .. "HipRigAttachment")
	local kA, kB = att(ul, side .. "KneeRigAttachment"), att(ll, side .. "KneeRigAttachment")
	local aA, aB = att(ll, side .. "AnkleRigAttachment"), att(ft, side .. "AnkleRigAttachment")
	if not (rA and rB and hA and hB and kA and kB and aA and aB) then
		return nil
	end
	-- the centre of each part in root space (no rotation in the bind pose)
	local y = rA.Y - rB.Y + hA.Y - hB.Y + kA.Y - kB.Y + aA.Y - aB.Y
	return y - ft.Size.Y / 2
end

function BuilderTiers.HipHeight(model)
	local root = model:FindFirstChild("HumanoidRootPart")
	if not root then
		return nil
	end
	local l, r = legBottom(model, "Left"), legBottom(model, "Right")
	local b = (l and r) and math.min(l, r) or l or r
	if not b then
		return nil
	end
	return math.max(0.1, -b - root.Size.Y / 2)
end

local function fixHipHeight(model, hum)
	local h = BuilderTiers.HipHeight(model)
	if h and math.abs(hum.HipHeight - h) > 0.005 then
		hum.HipHeight = h
	end
end

-- the tier legs' HipHeight put back on a built body (change-only; a body of default parts keeps the engine's). Builder
-- runs it again a moment after a build: the engine's own scaling pass (AutomaticScalingEnabled, deferred to a later
-- frame after a part swap or a scale change) may have put the default body's value back, and the feet would float or
-- sink by the difference. Returns the value set (or nil)
function BuilderTiers.FixHipHeight(model)
	local hum = model and model.Parent and model:FindFirstChildOfClass("Humanoid")
	local key = model and model:GetAttribute("BodyTiers")
	if not (hum and type(key) == "string" and string.find(key, "[1-9]") ~= nil) then
		return nil
	end
	local h = BuilderTiers.HipHeight(model)
	if h and math.abs(hum.HipHeight - h) > 0.005 then
		hum.HipHeight = h
		return h
	end
	return nil
end

-- the frame a swap is for: the tiers table's frame (BodyTiers.Tiers), else the model's Frame attribute (Builder's
-- body attributes), else the default family
function BuilderTiers.FrameFor(model, tiers)
	local f = type(tiers) == "table" and tiers.frame or nil
	if type(f) ~= "string" or f == "" then
		f = model and model:GetAttribute("Frame") or nil
	end
	if type(f) ~= "string" or f == "" then
		f = BodyTiers.DEFAULT_FRAME
	end
	return f
end

-- swap every part whose tier (or frame family / detail set) changed. tiers = { [part] = 1..5, frame = id }
-- (BodyTiers.Tiers); scale = Vector3 (W, H, D) the description applied. Returns the number of parts swapped and the
-- model's tier key (attribute BodyTiers: the tiers the parts really show, 0 = a default part). lite = true: the detail
-- set of the low level (the v9 meshes). frame (optional) overrides the tiers table's frame
function BuilderTiers.Apply(model, tiers, scale, lite, frame)
	local hum = model and model:FindFirstChildOfClass("Humanoid")
	if not (hum and type(tiers) == "table") then
		return 0, nil
	end
	frame = type(frame) == "string" and frame or BuilderTiers.FrameFor(model, tiers)
	-- the first boxer on this frame: the rest of its family loads behind his parts (a table lookup after that)
	if not preloaded[frame] and not lite then
		BuilderTiers.PreloadFrame(frame)
	end
	local n = 0
	for _, name in ipairs(BodyTiers.PARTS) do
		local want = tiers[name]
		local cur = model:FindFirstChild(name)
		-- (the mesh this tier's part shows in the wanted detail set and frame family: a part of the same tier from
		-- another set or family is swapped too)
		local e = want and BodyTiers.PartEntry(want, name, nil, lite, frame)
		local otherSet = e ~= nil and cur ~= nil and cur:GetAttribute("BodyTier") == want and cur:GetAttribute("BodyMesh") ~= e.id
		if want and cur and (cur:GetAttribute("BodyTier") ~= want or otherSet) then
			local wasIn = model.Parent ~= nil
			local template = BuilderTiers.Template(want, name, lite, frame)
			-- (the load may have yielded: a model in the world may be gone; a new NPC is built before it is parented)
			if template and not (wasIn and model.Parent == nil) and swap(model, hum, name, template, scale) then
				n += 1
			end
		elseif cur and scale and cur:GetAttribute("BodyTier") ~= nil then
			-- an unchanged tier part after a rescale (ApplyDescription: a new height / frame): the engine rescales it
			-- from its OriginalSize; should it not have, the swap's ratio follows the description's change
			local r0, s0 = cur:GetAttribute("BodyRatio"), cur:GetAttribute("BodyScale")
			if typeof(r0) == "Vector3" and typeof(s0) == "Vector3" and (scale - s0).Magnitude > 1e-4 then
				local want = r0 * scale / s0
				local r = ratioOf(cur)
				if not (r and (r - want).Magnitude < 1e-3) and scaleOnce(cur, want) then
					reaim(model, cur)
				end
				cur:SetAttribute("BodyRatio", want)
				cur:SetAttribute("BodyScale", scale)
			end
		end
	end
	local shown = {}
	for _, name in ipairs(BodyTiers.PARTS) do
		local p = model:FindFirstChild(name)
		shown[name] = p and tonumber(p:GetAttribute("BodyTier")) or 0
	end
	local key = BodyTiers.Key(shown)
	-- the tier legs' own HipHeight, on every run (change-only inside): a body of default parts keeps the engine's; a
	-- rescale between runs (ApplyDescription: a new height, the avatar look on / off) puts the engine's value back on
	-- a body whose tiers did not change, and the soles would stand off the floor (or in it) until the next swap
	if string.find(key, "[1-9]") ~= nil then
		fixHipHeight(model, hum)
	end
	if model:GetAttribute("BodyTiers") ~= key then
		model:SetAttribute("BodyTiers", key)
	end
	-- the family the parts show (the frame id; the default family's name when the frame has no meshes of its own)
	local ut = model:FindFirstChild("UpperTorso")
	local shownFrame = ut and ut:GetAttribute("BodyFrame") or nil
	if model:GetAttribute("BodyFrame") ~= shownFrame then
		model:SetAttribute("BodyFrame", shownFrame)
	end
	return n, key
end

-- the tiers the model shows now ({ [part] = tier or nil }): the hysteresis' previous state
function BuilderTiers.Current(model)
	local out = {}
	for _, name in ipairs(BodyTiers.PARTS) do
		local p = model and model:FindFirstChild(name)
		out[name] = p and tonumber(p:GetAttribute("BodyTier")) or nil
	end
	return out
end

return BuilderTiers
]]></string>
        </Properties>
      </Item>
