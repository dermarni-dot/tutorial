	{ x0 = -120, x1 = -90, h = 14, color = Color3.fromRGB(200, 222, 240), sign = "SPIN CITY LAUNDROMAT", signBg = Color3.fromRGB(40, 110, 200), signFg = Color3.new(1, 1, 1), awning = Color3.fromRGB(40, 110, 200) },
