------------------------------------------------------------------------
-- Character detail levels (Builder opts.detail) and expressions
------------------------------------------------------------------------
-- full = players + fight opponent, medium = gym NPCs / referee, low = far or crowd NPCs.
-- Budgets are extra parts over the pre-BALD-MODE character WITH its old hair: full = A 60 (face rig,
-- eyes, skin, hair beyond the old hair) + B 60 (body/gear). Fight damage (<= 20, temporary) is counted
-- separately. Strands/veins are Beams (no parts).
Config.Detail = {
	full = { partBudget = 120, eyeExtras = true, freckles = 26, wrinkles = true, sweatBeads = true, strands = 80, hairBumps = 53,
		muscleLayers = 2, grooves = true, veins = true, wordmarks = true, laces = "full", shadows = true },
	medium = { partBudget = 20, eyeExtras = false, freckles = 8, wrinkles = true, sweatBeads = false, strands = 16, hairBumps = 18,
		muscleLayers = 1, grooves = false, veins = false, wordmarks = false, laces = "merged", shadows = false },
	low = { partBudget = 0, eyeExtras = false, freckles = 0, wrinkles = false, sweatBeads = false, strands = 0, hairBumps = 10,
		muscleLayers = 1, grooves = false, veins = false, wordmarks = false, laces = "none", shadows = false },
}
Config.DetailAliases = { hero = "full", npc = "medium", lite = "low" }
-- (opts) -> "full"|"medium"|"low", its Config.Detail entry. Missing/unknown -> full.
function Config.DetailLevel(opts)
	local d = type(opts) == "table" and (opts.detail or opts.lod) or opts
	d = Config.DetailAliases[d] or d
	if not Config.Detail[d] then
		d = "full"
	end
	return d, Config.Detail[d]
end

-- Anatomy meshes (EditableMesh characters built on each client from the server's LookData; the round-1
-- parts stay as the fallback). AnatomyClient reads these; ANATOMY_CONTRACTS.md is the full contract.
-- tris = triangle budgets per section and level of detail (the generators must stay under them).
Config.Anatomy = {
	enabled = true, -- master switch; false = everyone keeps the part-built look
	maxFull = 6, -- full-detail characters near the camera besides the local player and the fight opponent
	fullRange = 70, -- studs: full detail inside, medium beyond
	lodRange = 160, -- studs: no meshes beyond (round-1 parts)
	frameBudget = 0.0025, -- seconds of mesh generation per frame (time-sliced, never a hitch)
	textures = true, -- pieces may carry a generated colour texture (EditableImage)
	-- server NPCs at medium detail (gym members, officials) keep a light part-built muscle layer: the hull
	-- plus the chest, shoulder caps, biceps, traps (and abs when defined) - the Body meshes replace it on
	-- every client that has Editable meshes; that much still reads as a boxer on one without them
	-- (Builder hullOnly: ~18 domes, ~55 instances less per NPC to replicate and walk)
	npcHullOnly = true, -- (retired: the round-1 muscle layer is gone; kept so older tools reading it still load)
	tris = {
		Body = { full = 9000, medium = 4000, low = 1500 },
		Head = { full = 5000, medium = 2000, low = 700 },
		Hair = { full = 10000, medium = 4000, low = 1200 },
	},
}

-- Asset hair: hair-card meshes modelled in Blender (tools/hair) and uploaded as Mesh + Image assets, loaded
-- on each client and fitted to every boxer's skull (client HairAssets; tools/hair/CONTRACT.md). A look whose
-- style has no complete entry, or whose assets fail to load, gets the generated hair as before (AnatomyHair
-- meshes, else the round-1 BuilderHair parts): nothing breaks when an id is missing.
--
-- FOR THE OWNER: the ids are not here. They live in src/shared/HairAssetData.lua, which
-- tools/hair/publish.py writes after uploading the meshes and textures with Open Cloud (every id 0 = that
-- style keeps the generated hair). The assets belong to the group the key uploads to, and group-owned
-- assets load ONLY in an experience owned by that same group: publish the place under the group (File >
-- Publish to Roblox As... > the group), or every boxer quietly keeps the generated hair (the Output warns
-- once per asset). The place also needs Game Settings > Security > Allow Mesh / Image APIs (the tint is an
-- EditableImage). To turn asset hair off, set enabled = false; to drop one style, re-publish without it or
-- set its ids to 0 in HairAssetData.lua.
Config.HairAssets = {
	enabled = true,
	flipV = nil, -- nil = HairAssetData.flipV; true / false overrides it (textures upside down on the cards)
	-- tinted card textures per level of detail (never larger than the upload), and the per-boxer cap texture
	textureSize = { full = 1024, medium = 512, low = 256 },
	capSize = { full = 1024, medium = 512, low = 256 },
	-- NPCs of one hair colour share their tinted images (you, your opponent and previews keep their own)
	shareTints = true,
	-- a card's alpha cut-out shows through only on a part that is itself a little transparent (verify in
	-- Studio: 0 = opaque cards, the part's colour where the texture is clear)
	alphaTransparency = 0.02,
}

-- Avatar hair & face: a PLAYER's boxer wears the hair accessories and the face (a classic face, or a Dynamic
-- Head, which carries its face) of that player's own Roblox avatar, on top of the game's muscle-tier body
-- (AvatarLook.lua; the server fetches Players:GetHumanoidDescriptionFromUserId once per player and session,
-- builds the boxer with the game look meanwhile and re-applies the description when the avatar arrives). Only
-- HairAccessory, Face and Head are copied: never the avatar's body parts, scales, clothes or other accessories.
-- Each player can turn it off ("Use my avatar's hair & face" in the creator, the barber and the settings;
-- saved as appearance.avatar, default on): off = the game's own hair styles and classic faces. NPCs always
-- wear the game look.
--
-- FOR THE OWNER: nothing to upload. enabled = false turns it off for everyone; hair / face = false keeps that
-- part on the game look. A failed fetch keeps the game look and is retried after retry seconds (doubling up to
-- maxRetry); an avatar whose items fail to load (offsale / deleted / moderated) falls back to the game look
-- and is not tried again for maxRetry seconds.
Config.AvatarLook = {
	enabled = true,
	hair = false, -- off: every boxer wears the game's own asset hair (was: the avatar's hair accessories; an avatar without hair = a bald boxer)
	face = false, -- off: every boxer uses the game's classic faces (was: the avatar's face / Dynamic Head (an avatar with neither keeps the chosen classic face)
	maxHair = 8, -- accessory ids copied at most
	retry = 20,
	maxRetry = 600,
}

-- Expr model attribute values (face rig blend targets on the client)
Config.Expressions = { "neutral", "confident", "determined", "anger", "fear", "fatigue", "pain", "dazed", "effort", "happy", "ko" }

-- true = draw no hair at all (the old hard-coded BALD MODE); kept as a one-line debug toggle
Config.BaldMode = false -- off: the asset hair (HairAssetData) is uploaded and drawn; true = every boxer bald

-- daily growth of hair / beard (0..1.5 / 0..1) used by Training.dayTick
Config.HairGrowthPerDay = 0.02
Config.BeardGrowthPerDay = 0.02

