	{ n = "Iliac", on = "UT", mirror = true, ax = "F", u = 0.2, v = -0.42, a = 0.04, b = 0.26, t = 0.06, p = 0.008, r = { 0, 0, -28 }, min = 0.6 },
	{ n = "DeltGroove", on = "UA", ax = "F", u = 0.36, v = 0.06, a = 0.06, b = 0.36, t = 0.06, p = 0.01, r = { 0, 0, -15 } },
