	bell = { id = 79669087847406, x = 256, y = 0 },
	ring = { id = 79669087847406, x = 512, y = 0 },
	ko = { id = 79669087847406, x = 768, y = 0 },
	shield = { id = 79669087847406, x = 0, y = 256 },
