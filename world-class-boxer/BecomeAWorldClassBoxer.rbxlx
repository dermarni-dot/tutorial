89, 0.6292, 0.512, 0.4016, -0.372, -0.3746, 0.6382, 0, -0.1325, -0.1644, 0.6232, -0.128, 0.476, -0.6024, 0.5504, 0.3592, 0.3178, -0.2937, 0.4979, -0.5087, -0.4653, 0.1342, 0.419, 0.5955, -0.0894, 0.1935, -0.0799, 0.6383, -0.3761, 0.1183, 0.6362, 0.1629, -0.6159, 0.1731, 0.1456, -0.5927, 0.4891, -0.126, 0.3768, 0.09, 0.5186, -0.6268, -0.0324, -0.1332, -0.368, 0.0423, 0.5065, 0.1261, 0.4591, 0.5933, 0.2234, 0.6447, -0.3074, -0.1305, 0.4411, 0.6139, -0.4246, -0.1398, 0.4715, 0.4652, -0.1981, 0.4189, 0.2596, -0.31, 0.583, 0.6065, 0.3797, -0.1971, 0.2597, 0.1782, 0.5833, 0.6042, 0.1352, -0.1963, 0.1272, 0.4446, -0.5985, -0.4277, 0.5404, 0.3851, 0.1774, 0.6332, -0.0377, -0.5518, -0.0606, 0.3186, 0.5059, 0.5028, 0.2921, 0.5986, 0.5199, 0.0629, 0.134, 0.0788, 0.6303, 0.5545, -0.0095, 0.3201, -0.5215, 0.3984, -0.3789, 0.6256, -0.0337, -0.133, 0.3442, 0.5007, 0.4737, -0.4621, 0.406, 0.416, -0.5997, 0.4506, 0.1949, -0.5534, 0.2483, -0.3195, -0.6124, 0.3583, -0.1302, -0.3131, 0.3219, 0.5422, 0.627, 0.2487, -0.1333, -0.2534, 0.4557, 0.5692, -0.0494, 0.618, 0.47, 0.3112, 0.64, -0.0662, -0.067, 0.2673, 0.6373, 0.4227, 0.6403, 0.0899, 0.5379, 0.5432, 0.1748, 0.3776, 0.3897, 0.5197, 0.4828, 0.522, -0.3508, 0.3977, 0.5791, 0.3581, 0.5548, 0.5548, -0.1179, 0, 0.6167, -0.4671, -0.2495, 0.6262, 0, -0.1897, 0.6261, 0.2612, 0.3014, 0.4995, -0.522, 0.5637, 0.1123, 0.3254, -0.2572, 0.5891, 0.4455, 0.4764, 0.3245, 0.429, 0.2407, 0.5235, 0.5405, -0.5837, 0.2049, 0.2599, 0.1329, 0.3448, 0.6254, -0.3642, 0.6261, -0.2646, -0.0607, 0.5281, 0.5778, -0.3496, 0.6401, 0.2019, -0.192, 0.6508, -0.1108, 0.6319, 0.2127, 0.0664, -0.2547, 0.2154, 0.572, -0.2966, 0.5828, -0.4083, 0.1282, 0.6278, 0.3947, -0.1322, 0.3631, -0.6221, -0.2603, -0.2106, 0.5847, 0.4652, 0.1304, 0.4189, -0.0654, -0.335, 0.6226, -0.4398, 0.6249, -0.1429, -0.0583, 0.573, -0.5546, -0.4706, 0.58, 0.2717, 0, -0.1332, 0.6484, 0.2547, -0.0799, 0.572 },
					tex = "cap",
				},
			},
			styles = {
				"360 Waves",
			},
			types = nil,
		},
	},
	fit0 = {
		Bz = 0.6,
		Fz = -0.6,
		T = 0.6,
		W = 0.6,
		shape = "classic",
	},
	flipV = false,
	textures = {
		braid = {
			id = 135454388848443,
			size = 1024,
			tile = false,
		},
		clump = {
