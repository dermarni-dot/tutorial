	{ id = "A", min = 1.2, rgb = { 60, 200, 110 } },
	{ id = "B", min = 1.0, rgb = { 70, 140, 255 } },
	{ id = "C", min = 0.8, rgb = { 240, 140, 40 } },
	{ id = "D", min = 0, rgb = { 220, 40, 45 } },
}

