			Hand = { 0.8208, 1.174, 1.034 },
			LowerArm = { 0.8693, 1.342, 0.9509 },
			LowerLeg = { 0.7877, 1.506, 0.8593 },
			LowerTorso = { 0.7954, 1.309, 0.9576 },
			UpperArm = { 0.8693, 1.342, 0.9509 },
			UpperLeg = { 0.7877, 1.506, 0.8593 },
			UpperTorso = { 0.7954, 1.309, 0.9576 },
		},
		rigBox = {
			Foot = { 0.8308, 0.3801, 0.9484 },
			Hand = { 0.8208, 0.3522, 1.034 },
			LowerArm = { 0.8693, 1.4118, 0.9509 },
			LowerLeg = { 0.7877, 1.7967, 0.8593 },
			LowerTorso = { 1.5908, 0.5236, 0.9576 },
			UpperArm = { 0.8693, 1.5688, 0.9509 },
			UpperLeg = { 0.7877, 1.8328, 0.8593 },
			UpperTorso = { 1.5908, 2.0944, 0.9576 },
		},
		rootHeight = 2.933,
		shoulderHeight = 4.9199,
		standingHeight = 6.2161,
		wristHeight = 3.072,
	},
	version = 1,
}
]]></string>
