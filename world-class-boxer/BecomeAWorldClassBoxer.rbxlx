      <Item class="ModuleScript" referent="89">
        <Properties>
          <string name="Name">Ambient</string>
          <string name="Source"><![CDATA[-- Ambient: gym members, coaches and staff that bring the training complex to life.
-- They are server NPCs (everyone sees the same people) whose bodies are animated
-- client-side by the Animator from the "Loop" attribute. Some react to players:
-- the mitt coach puts his pads up, the barber starts cutting, the masseuse works.
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local AssetService = game:GetService("AssetService")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Looks = require(Shared:WaitForChild("Looks"))
local Builder = require(Shared:WaitForChild("Builder"))
local Config = require(Shared:WaitForChild("Config"))
local Typography = require(Shared:WaitForChild("Typography"))
local Poser = require(script.Parent.Poser)
local okDecor, GymDecor = pcall(require, script.Parent.GymDecor)

local Ambient = {}
Ambient.Roles = {} -- role -> model

local V3 = Vector3.new

-- at = where they stand, look = what they face, floor = floor height there.
-- physique = Config.Physiques id (their body type: Builder draws it), sweat = how wet they are
-- from training (Builder.SetSweat), partner = the sparring partner they trade shots with.
local MEMBERS = {
	{ name = "Rico Vance", tag = "Gym Member", loop = "heavybag", at = V3(-36, 0, -26.4), look = V3(-36, 0, -30), hands = "gloves", seed = 101, physique = "PowerPuncher", sweat = 0.6 },
	{ name = "Dee Okafor", tag = "Gym Member", loop = "heavybag", at = V3(-24, 0, -26.4), look = V3(-24, 0, -30), hands = "gloves", seed = 202, gender = 2, physique = "Balanced", sweat = 0.55 },
	{ name = "Coach Benny", tag = "Mitt Trainer", role = "MittCoach", loop = "mittidle", at = V3(14, 0, -13.5), look = V3(14, 0, -10), props = "mitts", seed = 303, age = 52, physique = "Balanced", fit = 0.3, coach = true },
	{ name = "Marco Silva", tag = "Gym Member", loop = "shadow", at = V3(30, 0, -42), look = V3(22, 0, -50), hands = "wraps", seed = 404, physique = "LeanTechnical", sweat = 0.45 },
	{ name = "Tasha Brooks", tag = "Gym Member", loop = "rope", at = V3(60, 0, 8), look = V3(60, 0, 0), props = "rope", seed = 505, gender = 2, stand = 0, physique = "LeanTechnical", sweat = 0.55 },
	{ name = "Andre Cole", tag = "Gym Member", loop = "curl", at = V3(-62, 0, 8), look = V3(-62, 0, 0), props = "curl", seed = 606, physique = "PowerPuncher", sweat = 0.4 },
	{ name = "Yuki Sato", tag = "Gym Member", loop = "stretch", at = V3(100, 0, 64), look = V3(90, 0, 64), seed = 707, gender = 2, physique = "LeanTechnical", sweat = 0.2 },
	{ name = "Big Lou", tag = "Barber", role = "Barber", loop = "idle", at = V3(-97.6, 0, 39.6), look = V3(-95, 0, 38), props = "clippers", seed = 808, age = 46, hands = "bare", physique = "Heavyweight", fit = 0.25 },
	{ name = "Chef Ana", tag = "Nutrition Bar", role = "Chef", loop = "idle", at = V3(-70, 0, 74.5), look = V3(-70, 0, 64), seed = 909, gender = 2, hands = "bare", physique = "Balanced", fit = 0.3 },
	{ name = "Kim Park", tag = "Massage Therapist", role = "Masseuse", loop = "idle", at = V3(61.4, 0, 60.4), look = V3(64, 0, 60.4), seed = 1001, gender = 2, hands = "bare", physique = "Balanced", fit = 0.35 },
	{ name = "Old Pete", tag = "Gym Owner", loop = "sitwatch", at = V3(-20, 0, -45), look = V3(0, 0, -50), seed = 1111, age = 68, hands = "bare", seat = 1.5, bench = true, physique = "BeginnerLean", coach = true },
	{ name = "Jay Ortiz", tag = "Sparring", loop = "spar", at = V3(-2.4, 0, -50), look = V3(2.4, 0, -50), hands = "gloves", seed = 1212, floor = 2.8, headgear = Color3.fromRGB(170, 25, 30), physique = "LeanTechnical", sweat = 0.7, partner = "Kofi Mensah" },
	{ name = "Kofi Mensah", tag = "Sparring", loop = "spar", at = V3(2.4, 0, -50), look = V3(-2.4, 0, -50), hands = "gloves", seed = 1313, floor = 2.8, headgear = Color3.fromRGB(30, 60, 160), physique = "PowerPuncher", sweat = 0.7, partner = "Jay Ortiz" },
	{ name = "Coach Ray", tag = "Head Coach", loop = "walk", walk = { V3(-20, 0, 12), V3(20, 0, 12), V3(24, 0, -28), V3(-8, 0, -32), V3(-30, 0, -6) }, speed = 6, seed = 1414, age = 57, hands = "bare", physique = "Balanced", fit = 0.3, coach = true },
	{ name = "Nia Grant", tag = "Roadwork", loop = "run", walk = { V3(-160, 0, 120), V3(160, 0, 120), V3(160, 0, -190), V3(-160, 0, -190) }, speed = 15, seed = 1515, gender = 2, hands = "wraps", floor = 0.3, physique = "LeanTechnical", sweat = 0.6 },
	{ name = "Maya Reyes", tag = "Front Desk", loop = "idle", at = V3(28, 0, 73.5), look = V3(28, 0, 60), seed = 1616, gender = 2, hands = "bare", floor = 0.4, physique = "Balanced", fit = 0.3 },
	{ name = "Leon Price", tag = "Gym Member", loop = "idle", pose = "run", spot = "treadmill", seed = 1717, hands = "wraps", physique = "LeanTechnical", sweat = 0.5 },
	{ name = "Sofia Marin", tag = "Gym Member", loop = "idle", pose = "bike", spot = "bike", seed = 1818, gender = 2, hands = "bare", physique = "Balanced", sweat = 0.45 },
	{ name = "Hank Duro", tag = "Gym Member", loop = "idle", pose = "bench", at = V3(-62, 0, -49.3), look = V3(-62, 0, -60), lie = 1.675, props = "bench", seed = 1919, hands = "bare", physique = "Heavyweight", sweat = 0.4 },
	{ name = "Gus Ferreira", tag = "Local", loop = "walk", walk = { V3(-150, 0, 184), V3(100, 0, 184) }, speed = 5, seed = 2020, age = 61, hands = "bare", floor = 0.5, physique = "BeginnerLean", fit = 0.1 },
	{ name = "Lena Shaw", tag = "Local", loop = "walk", walk = { V3(90, 0, 184), V3(-140, 0, 184) }, speed = 5.5, seed = 2121, gender = 2, hands = "bare", floor = 0.5, physique = "BeginnerLean", fit = 0.15 },
	-- the sparring ring is a show: a coach calls it from the floor, a cornerman waits in the red
	-- corner and two members watch (Loops coachwatch / cornerman / ringside). The cornerman and the
	-- watchers stand ON the apron (canvas top 2.8, the strip between the rope line at +-11 and the
	-- apron edge at +-13 around the ring centre 0,-50), so their "hands / forearms on the ropes"
	-- poses meet the ropes; from the floor the top rope (y 6.3) is above their heads
	{ name = "Coach Dre", tag = "Sparring Coach", role = "RingCoach", loop = "coachwatch", at = V3(14.6, 0, -55), look = V3(0, 0, -50), seed = 2222, age = 49, hands = "bare", physique = "Balanced", fit = 0.35, coach = true },
	{ name = "Sal Romano", tag = "Cutman", role = "Cornerman", loop = "cornerman", at = V3(-12.4, 0, -62.4), look = V3(0, 0, -50), floor = 2.8, seed = 2323, age = 55, hands = "bare", physique = "Heavyweight", fit = 0.2, coach = true },
	{ name = "Luis Ortega", tag = "Gym Member", loop = "ringside", at = V3(-4.5, 0, -37.9), look = V3(-4.5, 0, -50), floor = 2.8, hands = "wraps", seed = 2424, physique = "Balanced", sweat = 0.3 },
	{ name = "Rosa Diaz", tag = "Gym Member", loop = "ringside", at = V3(5.5, 0, -37.9), look = V3(5.5, 0, -50), floor = 2.8, hands = "wraps", seed = 2525, gender = 2, physique = "LeanTechnical", sweat = 0.35 },
}

-- what their faces show while they loop (E's face rig reads the Expr attribute)
local WORK_LOOPS = { heavybag = true, spar = true, shadow = true, rope = true, run = true, curl = true }

-- members working out on the decorative cardio machines (GymDecor records where they are
-- when the gym is built; these are the fallbacks)
local SPOTS = {
	treadmill = { pos = V3(58, 0, -71.4), stand = 0.61 },
	bike = { pos = V3(92, 0, -70.5), seat = 2.7 },
}
local function getSpot(name)
	if not name then
		return nil
	end
	local live = okDecor and type(GymDecor) == "table" and GymDecor.DecorSpots
	return (live and live[name]) or SPOTS[name]
end

local function setKinematic(model)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("AnimationConstraint") then
			pcall(function()
				d.IsKinematic = true
			end)
		end
	end
end

local function nameTag(model, name, tag)
	local head = model:FindFirstChild("Head")
	if not head then
		return
	end
	local bb = Instance.new("BillboardGui")
	bb.Name = "NameTag"
	bb.Size = UDim2.fromOffset(200, 40)
	bb.StudsOffset = V3(0, 2.2, 0)
	bb.MaxDistance = 45
	bb.Adornee = head
	local t = Instance.new("TextLabel")
	t.Size = UDim2.new(1, 0, 0.6, 0)
	t.BackgroundTransparency = 1
	t.Text = name
	Typography.Apply(t, "label")
	t.TextScaled = true
	t.TextColor3 = Color3.new(1, 1, 1)
	t.TextStrokeTransparency = 0.4
	t.Parent = bb
	local s = Instance.new("TextLabel")
	s.Name = "Role"
	s.Size = UDim2.new(1, 0, 0.4, 0)
	s.Position = UDim2.fromScale(0, 0.6)
	s.BackgroundTransparency = 1
	s.Text = tag
	Typography.Apply(s, "body")
	s.TextScaled = true
	s.TextColor3 = Color3.fromRGB(255, 210, 90)
	s.TextStrokeTransparency = 0.5
	s.Parent = bb
	bb.Parent = head
end

local function yawTo(from, to)
	local d = Vector3.new(to.X - from.X, 0, to.Z - from.Z)
	if d.Magnitude < 0.01 then
		return 0
	end
	return math.atan2(-d.X, -d.Z)
end

-- The part-built detail of a member whose def names none. The body (the muscle-tier parts) and the face are the
-- same at every detail; the detail sets the gear's and the round-1 hair's part counts. Where the Editable APIs
-- work, every client draws the members' hair itself (AnatomyClient, the asset hair) over the round-1 hair, so
-- they are built at low detail (fewer hair and gear parts off every join); where they do not (the experience
-- setting off, an unverified creator) the round-1 hair is what everyone sees: medium.
-- The server's own EditableMesh is the probe; decided once, before the first member is built.
local defaultDetail
local function memberDetail()
	if defaultDetail == nil then
		defaultDetail = "medium"
		local anatomy = Config.Anatomy
		if Config.BaldMode then
			-- no hair is drawn anywhere: no probe mesh (in Studio the server shares the client's Editable budget)
			defaultDetail = "low"
		elseif anatomy and anatomy.enabled then
			local ok, em = pcall(function()
				return AssetService:CreateEditableMesh()
			end)
			if ok and em then
				defaultDetail = "low"
				pcall(em.Destroy, em)
			end
		end
	end
	return defaultDetail
end

local function spawnMember(folder, def)
	local app = Looks.Random(def.seed, def.gender or 1, { age = def.age or 26, class = 5 })
	if def.age and def.age > 50 then
		app.hair.color = { 160, 160, 160 }
		app.beard.growth = 0.8
	end
	local fit = def.fit or (def.loop == "sitwatch" and 0.15 or 0.55)
	local physique = def.physique
	if physique and app.body then
		app.body.physique = physique -- pinned: Builder draws this archetype, not a random one
	end
	local build = Looks.RandomBuild(def.seed, fit, def.age or 26, app.body.frame, physique)
	local gear = { gloves = "Competition", glovesCond = 70, wraps = "OldWraps", wrapsCond = 80, shoes = def.coach and "Sneakers" or nil, shoesCond = 70 }
	local npc = Builder.CreateNPC(app, build, gear, def.name, {
		hands = def.hands or "wraps", name = def.name, nick = "", waistText = "",
		detail = def.detail or memberDetail(), physique = physique, age = def.age or 26, sweat = def.sweat,
	})
	if not npc then
		return nil
	end
	setKinematic(npc)
	npc:SetAttribute("Loop", def.loop)
	if def.pose then
		npc:SetAttribute("Pose", def.pose)
	end
	npc:SetAttribute("AmbientSeed", def.seed)
	if def.partner then
		npc:SetAttribute("SparPartner", def.partner)
	end
	-- a face that fits what they are doing: focused when training, otherwise calm or confident by seed
	local expr = WORK_LOOPS[def.loop] and "determined" or ((def.seed // 101) % 3 == 0 and "confident" or "neutral")
	npc:SetAttribute("Expr", expr)
	if def.headgear then
		Builder.SetHeadgear(npc, def.headgear, true)
	end
	-- members who are mid-workout glisten (Builder keeps the Sweat attribute as the single source)
	if def.sweat and def.sweat > 0 then
		pcall(Builder.SetSweat, npc, app, def.sweat)
	end
	local hum = npc:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		hum.BreakJointsOnDeath = false
	end
	npc.Parent = folder
	-- the headgear re-fitted once the engine's post-parent passes have run (Builder.OnPlaced; a no-op while it fits)
	Builder.OnPlaced(npc)
	local spot = getSpot(def.spot)
	local at = (spot and spot.pos) or def.at or (def.walk and def.walk[1]) or V3(0, 0, 0)
	local yaw = yawTo(at, def.look or (at + V3(0, 0, -1)))
	if def.walk then
		local root = npc:FindFirstChild("HumanoidRootPart")
		local start = def.walk[1]
		npc:PivotTo(CFrame.new(start.X, (def.floor or 0.5) + hum.HipHeight + root.Size.Y / 2 + 0.2, start.Z))
		root:SetNetworkOwner(nil)
		hum.WalkSpeed = def.speed or 8
	else
		Poser.Place(npc, at.X, at.Z, yaw, { floor = def.floor or 0.5, stand = (spot and spot.stand) or def.stand, seat = (spot and spot.seat) or def.seat, lie = def.lie })
		-- an anchored puppet (the clients' Animator poses it): no falling / landing / getting-up
		-- states for the server to evaluate every step
		if hum then
			pcall(function()
				hum.EvaluateStateMachine = false
			end)
		end
	end
	if def.props then
		Poser.AttachProps(npc, def.props, 2)
	end
	nameTag(npc, def.name, def.tag)
	CollectionService:AddTag(npc, "Ambient")
	if def.role then
		Ambient.Roles[def.role] = npc
	end
	return npc
end

local function walker(npc, def)
	local hum = npc:FindFirstChildOfClass("Humanoid")
	local root = npc:FindFirstChild("HumanoidRootPart")
	local i = 1
	local rng = Random.new(def.seed)
	while npc.Parent and hum and root do
		i = i % #def.walk + 1
		local target = def.walk[i]
		local started = os.clock()
		local leg = Vector3.new(root.Position.X - target.X, 0, root.Position.Z - target.Z).Magnitude
		local limit = math.max(40, leg / (def.speed or 8) * 1.6 + 5)
		while npc.Parent do
			hum:MoveTo(target)
			local flat = Vector3.new(root.Position.X - target.X, 0, root.Position.Z - target.Z)
			if flat.Magnitude < 4 or os.clock() - started > limit then
				break
			end
			-- [Studio] Gait: the intended world velocity, for the clients' Animator (a replicated root's own travel
			-- stutters; the gait follows this and only checks it against the travel - CONTRACTS section 7)
			-- (quantized and change-only: on a straight leg the heading only wobbles, so nothing replicates)
			local g = -flat.Unit * hum.WalkSpeed
			g = Vector3.new(math.floor(g.X * 4 + 0.5) / 4, 0, math.floor(g.Z * 4 + 0.5) / 4)
			if npc:GetAttribute("Gait") ~= g then
				npc:SetAttribute("Gait", g)
			end
			task.wait(1)
		end
		npc:SetAttribute("Gait", nil)
		if def.loop == "walk" then
			-- the coach stops to watch for a moment
			hum:MoveTo(root.Position)
			task.wait(rng:NextNumber(2, 6))
		end
	end
end

function Ambient.Start()
	local old = workspace:FindFirstChild("GymMembers")
	if old then
		old:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = "GymMembers"
	folder.Parent = workspace
	for _, def in ipairs(MEMBERS) do
		if def.bench then
			local b = Instance.new("Part")
			b.Name = "WatchBench"
			b.Anchored = true
			b.Size = V3(6, def.seat or 1.5, 2)
			b.CFrame = CFrame.new(def.at.X, (def.floor or 0.5) + (def.seat or 1.5) / 2, def.at.Z) * CFrame.Angles(0, yawTo(def.at, def.look), 0)
			b.Color = Color3.fromRGB(110, 80, 55)
			b.Material = Enum.Material.WoodPlanks
			b.CanTouch = false -- (nothing listens for touches)
			b.Parent = folder
		end
		local ok, npc = pcall(spawnMember, folder, def)
		if not ok then
			warn("[Boxer] ambient member failed:", def.name, npc)
		elseif npc and def.walk then
			task.spawn(walker, npc, def)
		end
		task.wait()
	end
end

-- One athlete outside the gym (the sparring room template in Venues): def.at / def.look are
-- relative to origin, a point on that room's floor. Same Loop / Expr / tag conventions as the
-- members, so the Animator drives them, and they go away with the folder they are parented to.
-- No role and no walking: they are scenery and nothing else looks them up.
function Ambient.SpawnAt(folder, def, origin)
	origin = origin or Vector3.zero
	local d = table.clone(def)
	d.at = origin + (def.at or Vector3.zero)
	d.look = def.look and origin + def.look or nil
	d.floor = origin.Y + (def.floor or 0)
	d.role, d.walk, d.bench, d.spot = nil, nil, nil, nil
	return spawnMember(folder, d)
end

-- change what a role NPC is doing (e.g. the mitt coach raises the pads)
function Ambient.SetLoop(role, loop)
	local npc = Ambient.Roles[role]
	if npc and npc.Parent then
		npc:SetAttribute("Loop", loop)
	end
end

return Ambient
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="90">
        <Properties>
          <string name="Name">Career</string>
          <string name="Source"><![CDATA[-- Career: character creation, fight offers, camps, economy, titles, promotions,
-- rivalries, simulated fights, legacy, retirement and the client summary.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Catalog = require(Shared:WaitForChild("Catalog"))
local Looks = require(Shared:WaitForChild("Looks"))
-- the special moves (unlocks from the career's bouts, wins and KOs), nil-safe if the module is missing
local Moves
do
	local ok, mod = pcall(function()
		return require(Shared:WaitForChild("Moves"))
	end)
	Moves = (ok and type(mod) == "table") and mod or nil
end
-- the combinations' signature combos (Shared.Combos: unlocked by the same fight milestones), nil-safe
local Combos
do
	local ok, mod = pcall(function()
		return require(Shared:WaitForChild("Combos"))
	end)
	Combos = (ok and type(mod) == "table") and mod or nil
end
local World = require(script.Parent.World)
local Training = require(script.Parent.Training)
local Sponsors = require(script.Parent.Sponsors)
-- the tournaments (Shared.Tournaments: the events; Tourney: the brackets, the belts, the calendar)
local Tourney = require(script.Parent.Tourney)
local Tournaments = require(Shared:WaitForChild("Tournaments"))

local Career = {}
local rng = Random.new()

local function clamp(v, a, b)
	return math.clamp(v, a, b)
end

local function round(n)
	return math.floor(n + 0.5)
end

-- a whole number in [lo, hi] from client data; NaN / inf / non-numbers give the default
-- (tonumber passes NaN, and math.floor / math.clamp both return NaN for it)
local function int(v, lo, hi, default)
	v = tonumber(v)
	if v == nil or v ~= v or v == math.huge or v == -math.huge then
		return default
	end
	return clamp(math.floor(v), lo, hi)
end

------------------------------------------------------------------------
-- Creation
------------------------------------------------------------------------
-- d = { first, last, name, nickname, age, nationality, music, voice, weightClass, weight, reachDelta, style, specialty, look }
function Career.CreateProfile(old, d, userId)
	local look = Looks.Sanitize(d.look)
	local ci = int(d.weightClass, 1, #Config.WeightClasses, 5)
	local wc = Config.WeightClasses[ci]
	local age = int(d.age, 16, 35, 20)
	local style = Config.FindById(Config.Styles, d.style) or Config.Styles[4]
	local spec = Config.FindById(Config.Specialties, d.specialty) or Config.Specialties[1]
	local frame = Config.FindById(Config.BodyTypes, look.body.frame) or Config.BodyTypes[2]
	local nat = table.find(Config.Nationalities, d.nationality) and d.nationality or "USA"
	local music = tostring(d.music or ""):gsub("%D", ""):sub(1, 20)
	local voice = table.find(Config.VoiceTypes, d.voice) and d.voice or "Calm"

	local base = 26 + (age - 16) * 0.75
	local stats = {}
	for _, k in ipairs(Config.StatKeys) do
		stats[k] = clamp(base + (style.mods[k] or 0) + (frame.mods[k] or 0) + (spec.stats[k] or 0), 10, 60)
	end
	local profile = {
		v = Config.DataVersion, created = true, retired = false,
		pastCareers = old and old.pastCareers or {},
		identity = {
			first = d.first, last = d.last, name = d.name, nickname = d.nickname, age = age, gender = look.gender,
			nationality = nat, music = music, voice = voice,
		},
		appearance = look,
		physical = {
			height = look.height, weightClass = ci,
			reach = look.height + int(d.reachDelta, -3, 6, 2),
			baseWeight = wc.limit,
		},
		style = style.id, specialty = spec.id,
		stats = stats,
		mental = {
			Confidence = 50, Discipline = 55, Aggression = math.floor(style.ai.aggression * 100),
			Focus = 50, Composure = 45 + (age - 16) * 0.8,
		},
		body = Training.NewBody(frame.id),
		condition = Training.NewCondition(),
		gym = Training.NewGym(),
		gear = Training.NewGear(),
		coaches = Training.NewCoaches(),
		money = 500, popularity = 1, day = 1, ageDays = 0, sessions = 0,
		tier = 1, tierWins = 0,
		record = { w = 0, l = 0, d = 0, ko = 0 },
		amateurRecord = { w = 0, l = 0, d = 0, ko = 0 },
		belts = { WBA = false, WBC = false, IBF = false, WBO = false },
		regional = { regional = false, national = false },
		defenses = 0, titlesWon = 0, qualityWins = 0, undisputedReigns = 0, knockdownsScored = 0,
		owned = {}, camp = nil, offers = nil, history = {},
	}
	-- starting walk-around weight: what the player picked (inside the class range)
	local target = int(d.weight, wc.min, wc.limit, wc.limit - 2)
	Training.SetBaseWeight(profile, target)
	-- the starting muscle is the detraining floor: neglect never shrinks a part below it
	Training.MuscleBase(profile, true)
	profile.world = World.Generate((userId or 1) + os.time())
	profile.overall = Config.Overall(stats)
	return profile
end

------------------------------------------------------------------------
-- Helpers
------------------------------------------------------------------------
function Career.Owned(profile, id)
	return type(profile.owned) == "table" and profile.owned[id] == true
end

-- the player's best home (Mansion > House > Apartment) or nil; homes are Catalog.Shop "Houses"
Career.HomeOrder = { "Mansion", "House", "Apartment" }
function Career.HomeOf(profile)
	for _, id in ipairs(Career.HomeOrder) do
		if Career.Owned(profile, id) then
			return id
		end
	end
	return nil
end

-- pcall wrapper for the Training calls the look / fight hand-off makes: one bad save value must
-- never stop applyLook (it runs outside its own pcall) or a fight from starting
local function safe(fn, ...)
	if type(fn) ~= "function" then
		return nil
	end
	local ok, res = pcall(fn, ...)
	if ok then
		return res
	end
	warn("[Career] " .. tostring(res))
	return nil
end

function Career.OppView(profile, b)
	local ranks = {}
	if profile.tier >= 2 then
		for _, org in ipairs(Config.Orgs) do
			ranks[org] = World.RankOf(profile, b.id, org)
		end
	end
	local style = Config.FindById(Config.Styles, b.style)
	local arch = Config.FindById(Config.Archetypes, b.archetype)
	return {
		id = b.id, name = b.name, nick = b.nick, nat = b.nat, style = style and style.name or b.style,
		archetype = arch and arch.name or "", overall = b.overall, record = b.record, age = b.age,
		personality = b.personality, h2h = b.h2h, heat = b.heat, belts = b.belts, ranks = ranks,
		tbelts = Career.TourneyBelts(b), height = b.height,
	}
end

-- an AI boxer's tournament belts as display names ("City Championship x2"), nil for none
function Career.TourneyBelts(b)
	if type(b) ~= "table" or type(b.tbelts) ~= "table" then
		return nil
	end
	local out = {}
	for _, def in ipairs(Tournaments.List) do
		local n = tonumber(b.tbelts[def.id]) or 0
		if n > 0 then
			table.insert(out, def.name .. (n > 1 and (" x" .. n) or ""))
		end
	end
	return #out > 0 and out or nil
end

local function pickTalk(profile, b)
	local pname = profile.identity.name
	local total = b.h2h.w + b.h2h.l + b.h2h.d
	if total == 2 then
		return string.format(Config.TrilogyTalk[rng:NextInteger(1, #Config.TrilogyTalk)], pname)
	elseif b.h2h.w > b.h2h.l then
		return string.format(Config.RevengeTalk[rng:NextInteger(1, #Config.RevengeTalk)], pname)
	end
	local lines = Config.TrashTalk[b.personality] or Config.TrashTalk["Technician"]
	return string.format(lines[rng:NextInteger(1, #lines)], pname)
end

function Career.PlayerLine(profile, oppName)
	local lines = Config.VoiceLines[profile.identity.voice or "Calm"] or Config.VoiceLines.Calm
	return string.format(lines[rng:NextInteger(1, #lines)], oppName)
end

local function purseFor(profile, b, mult)
	local t = Config.Tiers[profile.tier]
	local lo, hi = t.purse[1], t.purse[2]
	local f = clamp((b.overall - profile.overall + 10) / 25, 0, 1)
	local p = lo + (hi - lo) * f
	p *= 1 + profile.popularity / 250
	return round(p * (mult or 1) / 50) * 50
end

local function makeOffer(profile, b, kind, extra)
	extra = extra or {}
	local tier = Config.Tiers[profile.tier]
	local rounds = tier.rounds
	if kind == "Regional Title" or kind == "National Title" then
		rounds = 10
	elseif kind == "World Title" or kind == "Unification" or kind == "Title Defense" then
		rounds = 12
	end
	local venue = Config.VenueFor(kind, profile.tier)
	return {
		oppId = b.id, kind = kind, rounds = rounds, venue = venue, venueName = Config.Venues[venue].name,
		purse = purseFor(profile, b, extra.purseMult),
		stakes = extra.stakes or {}, playerStakes = extra.playerStakes or {},
		opp = Career.OppView(profile, b), talk = pickTalk(profile, b),
	}
end

Tourney.makeOffer = makeOffer

local function playerBelts(profile)
	local list = {}
	for _, org in ipairs(Config.Orgs) do
		if profile.belts[org] then
			table.insert(list, org)
		end
	end
	return list
end
Career.PlayerBelts = playerBelts

------------------------------------------------------------------------
-- Offers
------------------------------------------------------------------------
function Career.GetOffers(profile)
	if profile.camp or profile.retired then
		return profile.offers or {}
	end
	if profile.offers then
		return profile.offers
	end
	local world = profile.world
	local ci = profile.physical.weightClass
	local pOv = profile.overall
	local offers = {}
	local used = {}
	local function add(o)
		if o and not used[o.oppId] then
			used[o.oppId] = true
			table.insert(offers, o)
		end
	end

	for _, id in ipairs(world.classes[ci]) do
		local b = world.boxers[id]
		local total = b.h2h.w + b.h2h.l + b.h2h.d
		if not b.retired and total > 0 and b.heat >= 50 and math.abs(b.overall - pOv) <= 10 and #offers < 1 then
			local kind = total == 1 and "Rematch" or (total == 2 and "Trilogy" or "Grudge Match")
			add(makeOffer(profile, b, kind, { purseMult = 1.25 + b.heat / 200 }))
		end
	end

	local tier = profile.tier
	local belts = playerBelts(profile)
	local _, bestOrg = World.BestRank(profile)

	if tier == 2 and profile.tierWins >= 3 and not profile.regional.regional then
		local b = world.boxers[world.regional.regional[ci]]
		if b then
			add(makeOffer(profile, b, "Regional Title", { purseMult = 2 }))
		end
	elseif tier == 3 and profile.tierWins >= 3 and not profile.regional.national then
		local b = world.boxers[world.regional.national[ci]]
		if b then
			add(makeOffer(profile, b, "National Title", { purseMult = 2 }))
		end
	end

	if tier >= 7 then
		for _, org in ipairs(Config.Orgs) do
			if not profile.belts[org] then
				local champ = world.boxers[world.champions[org][ci]]
				local rank = World.PlayerRanks(profile)[org]
				if champ and (rank and rank ~= "C" and rank <= 5 or #belts > 0) then
					local stakes = table.clone(champ.belts)
					if #belts > 0 then
						add(makeOffer(profile, champ, "Unification", { stakes = stakes, playerStakes = belts, purseMult = 1.6 }))
					else
						add(makeOffer(profile, champ, "World Title", { stakes = stakes, purseMult = 1.3 }))
					end
				end
			end
		end
	end
	if #belts > 0 then
		-- the best-ranked contender not already offered (the #1 is often another org's champion,
		-- who already has the Unification offer: add() would drop him and there would be no defense)
		for _, e in ipairs(World.Rankings(profile, ci, belts[1])) do
			if not e.isPlayer and e.rank ~= "C" and not used[e.id] and world.boxers[e.id] then
				add(makeOffer(profile, world.boxers[e.id], "Title Defense", { playerStakes = belts, purseMult = 1.2 }))
				break
			end
		end
	end
	if tier == 6 and bestOrg then
		for _, e in ipairs(World.Rankings(profile, ci, bestOrg)) do
			if not e.isPlayer and e.rank ~= "C" and e.rank <= 5 and e.overall <= pOv + 8 and not used[e.id] and world.boxers[e.id] then
				add(makeOffer(profile, world.boxers[e.id], "Title Eliminator", { purseMult = 1.3 }))
				break
			end
		end
	end

	local lo, hi = -8, 3
	if tier == 2 then
		lo, hi = -6, 5
	elseif tier == 3 or tier == 4 then
		lo, hi = -5, 6
	elseif tier >= 5 then
		lo, hi = -5, 8
	end
	local exclude = {}
	if tier < 7 then
		for _, org in ipairs(Config.Orgs) do
			local champ = world.champions[org][ci]
			if champ then
				exclude[champ] = true
			end
		end
	end
	local tries = 0
	while #offers < 4 and tries < 24 do
		tries += 1
		for id in pairs(used) do
			exclude[id] = true
		end
		local widen = math.floor(tries / 4) * 3
		local b = World.Pick(profile, ci, pOv + lo - widen, pOv + hi + widen, exclude, rng)
		if b then
			add(makeOffer(profile, b, tier == 1 and "Amateur Bout" or "Pro Fight"))
		end
	end
	profile.offers = offers
	profile.offersDay = profile.day
	return offers
end

-- The guided debut (Shared.Tutorial: the first career fight of a new boxer, offered right after the creator): an
-- ordinary Amateur Bout offer against a weak amateur from the player's own world and division. opts = { below =
-- { far, near } (his overall this far under the player's: Tutorial.Debut.OPP_BELOW), rng }. Not a defensive
-- specialist or a counter puncher (no first opponent for a beginner), never a champion. The offer counts like any
-- other once it is fought (ApplyResult: record, purse, fame, move unlocks); nil when the world has nobody.
local DEBUT_HARD = { Defensive = true, Counter = true }
function Career.DebutOffer(profile, opts)
	opts = type(opts) == "table" and opts or {}
	local r = opts.rng or rng
	local below = type(opts.below) == "table" and opts.below or { 16, 6 }
	local world = profile.world
	local ci = profile.physical.weightClass
	local pOv = tonumber(profile.overall) or 35
	local exclude = {}
	for _, org in ipairs(Config.Orgs) do
		local champ = world.champions and world.champions[org] and world.champions[org][ci]
		if champ then
			exclude[champ] = true
		end
	end
	for _, id in ipairs(world.classes[ci] or {}) do
		local b = world.boxers[id]
		if b and DEBUT_HARD[b.archetype] then
			exclude[id] = true
		end
	end
	local b
	for widen = 0, 4 do
		b = World.Pick(profile, ci, pOv - below[1] - widen * 4, pOv - below[2], exclude, r)
		if b and b.overall < pOv then
			break
		end
	end
	if not b then
		return nil
	end
	local offer = makeOffer(profile, b, "Amateur Bout")
	offer.debut = true
	if opts.venue and Config.Venues[opts.venue] then
		offer.venue, offer.venueName = opts.venue, Config.Venues[opts.venue].name
	end
	return offer
end

-- the debut opponent's fight-night stats (the copy FighterFromBoxer made, never the world's boxer): a young world
-- can have no amateur under a brand-new boxer, so for this one bout his stats are scaled down until his overall is
-- at least `gap` under the player's. Returns oData.
function Career.DebutOpponent(oData, playerOverall, gap)
	if type(oData) ~= "table" or type(oData.stats) ~= "table" then
		return oData
	end
	local goal = (tonumber(playerOverall) or 35) - (tonumber(gap) or 4)
	for _ = 1, 12 do
		local ov = Config.Overall(oData.stats)
		if ov <= goal then
			break
		end
		local k = math.clamp(goal / math.max(1, ov), 0.6, 0.98)
		for key, v in pairs(oData.stats) do
			if type(v) == "number" then
				oData.stats[key] = math.max(10, math.floor(v * k))
			end
		end
	end
	return oData
end

function Career.AcceptOffer(profile, index)
	if profile.camp or profile.retired then
		return false, "Already in camp"
	end
	local offer = profile.offers and profile.offers[index]
	if not offer then
		return false, "Offer expired"
	end
	local days = Training.CampDays(profile)
	profile.camp = { offer = offer, daysLeft = days, daysTotal = days, log = {} }
	profile.offers = nil
	return true
end

function Career.ChangeWeightClass(profile, dir)
	if profile.camp then
		return false, "Finish your camp first."
	end
	local ci = profile.physical.weightClass + (dir == -1 and -1 or 1)
	if ci < 1 or ci > #Config.WeightClasses then
		return false, "No class that way."
	end
	local vacated = playerBelts(profile)
	for _, org in ipairs(vacated) do
		profile.belts[org] = false
		local cur = profile.physical.weightClass
		local list = profile.world.classes[cur]
		local best, bestOv = nil, -1
		for _, id in ipairs(list) do
			local b = profile.world.boxers[id]
			if not b.retired and b.overall > bestOv then
				best, bestOv = b, b.overall
			end
		end
		if best then
			profile.world.champions[org][cur] = best.id
			table.insert(best.belts, org)
		end
	end
	if profile.regional.regional or profile.regional.national then
		profile.regional = { regional = profile.tier >= 3, national = profile.tier >= 4 }
	end
	profile.physical.weightClass = ci
	profile.offers = nil
	if profile.tier >= 8 then
		profile.tier = 7
	end
	return true, Config.WeightClasses[ci].name, #vacated
end

------------------------------------------------------------------------
-- Shop
------------------------------------------------------------------------
function Career.Buy(profile, id)
	local item = Catalog.Find(Catalog.Shop, id)
	if not item then
		return false, "Unknown item"
	end
	if profile.owned[item.id] then
		return false, "Already owned"
	end
	if item.requiresTier and profile.tier < item.requiresTier then
		return false, "Elite equipment unlocks when you become a World Champion."
	end
	-- home add-ons need somewhere to put them
	if type(item.requiresAny) == "table" then
		local has = false
		for _, need in ipairs(item.requiresAny) do
			if Career.Owned(profile, need) then
				has = true
			end
		end
		if not has then
			local names = {}
			for _, need in ipairs(item.requiresAny) do
				local def = Catalog.Find(Catalog.Shop, need)
				table.insert(names, def and def.name or need)
			end
			return false, "You need a home first: " .. table.concat(names, " / ") .. "."
		end
	end
	if profile.money < item.price then
		return false, "Not enough money"
	end
	profile.money -= item.price
	profile.owned[item.id] = true
	if item.conf then
		profile.mental.Confidence = clamp(profile.mental.Confidence + item.conf, 0, 100)
	end
	if item.pop then
		profile.popularity = clamp(profile.popularity + item.pop, 0, 100)
	end
	return true
end

------------------------------------------------------------------------
-- Sponsors: brand deals with fictional brands (Catalog.Sponsors), run by Server Sponsors.lua (offers,
-- clauses, payouts, perks, the save's profile.sponsors). These wrappers give it the career's ranking.
------------------------------------------------------------------------
-- share of the old popularity formula paid as merch / appearance fees while you have NO deal
local ENDORSE_SHARE = 0.5

local function sponsorState(profile)
	return Sponsors.State(profile)
end

local function sponsorCtx(profile)
	local okRank, best = pcall(World.BestRank, profile)
	return Sponsors.Ctx(profile, okRank and best or nil)
end

-- { [slot] = sponsor id } of the running deals (Venues.New opts.sponsors, LookOpts patches)
function Career.ActiveSponsors(profile)
	return Sponsors.Active(profile)
end

-- the offers on the table (views); `taken` names the deal in that slot, `conflict` the same-category brand
function Career.SponsorOffers(profile)
	return Sponsors.OfferViews(profile)
end

-- sign an offer; replace = true ends what blocks it (the slot's deal, an exclusive rival). -> ok, err | name
function Career.SignSponsor(profile, id, replace)
	return Sponsors.Sign(profile, id, replace, sponsorCtx(profile))
end

function Career.DeclineSponsor(profile, id)
	return Sponsors.Decline(profile, id)
end

-- end a deal early (slot name or sponsor id)
function Career.DropSponsor(profile, key)
	return Sponsors.Drop(profile, key)
end

-- the social post a deal asks for before each fight
function Career.SponsorPost(profile, key)
	return Sponsors.Post(profile, key)
end

-- fight-night pay from every running deal; counts the contracts down. -> total, notes
function Career.SponsorIncome(profile, win, isKO, title, loss)
	local total, notes = Sponsors.Payout(profile, { win = win, ko = isKO, title = title, loss = loss })
	return total, notes
end

-- autograph session with the fans outside (once per day, small popularity bump)
function Career.Autograph(profile)
	if profile.lastAutographDay == profile.day then
		return false, "You already signed for the fans today."
	end
	if (profile.popularity or 0) < 3 then
		return false, "Nobody is asking for your autograph yet. Win some fights first."
	end
	profile.lastAutographDay = profile.day
	profile.popularity = clamp(profile.popularity + 0.2, 0, 100)
	return true
end

-- where the boxer wakes up after sleeping: "here" (default), "home" (bedroom) or "gym"
function Career.SetWakeAt(profile, where)
	if where ~= "home" and where ~= "gym" and where ~= "here" then
		return false, "Unknown place"
	end
	if where == "home" and not Career.HomeOf(profile) then
		return false, "Buy a home first."
	end
	if type(profile.settings) ~= "table" then
		profile.settings = {}
	end
	profile.settings.wakeAt = where ~= "here" and where or nil
	return true
end

------------------------------------------------------------------------
-- Fighters for the fight engine
------------------------------------------------------------------------
function Career.GearView(profile)
	local g = profile.gear
	local eq = g.equipped or {}
	return {
		gloves = eq.gloves, glovesCond = Training.GearCondition(profile, "gloves"),
		wraps = eq.wraps, wrapsCond = Training.GearCondition(profile, "wraps"),
		shoes = eq.shoes, shoesCond = Training.GearCondition(profile, "shoes"),
		mouthguard = eq.mouthguard, robe = eq.robe,
	}
end

-- a running deal's patch for Builder (opts.sponsorTrunks / sponsorRobe = { text, fg, bg })
local function sponsorPatch(profile, slot)
	return Sponsors.Patch(profile, slot)
end

function Career.LookOpts(profile, extra)
	local o = {
		name = profile.identity.name, nick = profile.identity.nickname, nat = profile.identity.nationality,
		waistText = profile.identity.nickname, robe = profile.gear.equipped.robe,
		age = profile.identity.age, tier = profile.tier,
		sponsorTrunks = sponsorPatch(profile, "trunks"), sponsorRobe = sponsorPatch(profile, "robe"),
	}
	-- one physique source of truth (Hub badge == rendered body), residual fight damage
	local info = safe(Training.PhysiqueInfo, profile)
	o.physique = type(info) == "table" and info.id or nil
	o.damage = safe(Training.FaceView, profile)
	-- a hard weight cut (negative water) dries the physique out
	local water = type(profile.condition) == "table" and tonumber(profile.condition.water) or 0
	if water and water == water and water < 0 then
		o.dry = clamp(-water / 5, 0, 1)
	end
	for k, v in pairs(extra or {}) do
		o[k] = v
	end
	return o
end

function Career.FighterFromProfile(profile)
	local mods = Training.FightModifiers(profile)
	local stats = table.clone(profile.stats)
	for k, v in pairs(mods.stats) do
		stats[k] = clamp((stats[k] or 30) + v, 10, Config.StatCap)
	end
	local cond = profile.condition or {}
	return {
		isPlayer = true, name = profile.identity.name, nick = profile.identity.nickname,
		stats = stats, mental = table.clone(profile.mental), style = profile.style,
		class = profile.physical.weightClass, reach = profile.physical.reach, height = profile.physical.height,
		app = profile.appearance, build = profile.body, gear = Career.GearView(profile),
		fatigue = profile.condition.fatigue, mods = mods,
		record = profile.tier == 1 and profile.amateurRecord or profile.record, nat = profile.identity.nationality,
		music = profile.identity.music, voice = profile.identity.voice,
		eliteCorner = Training.EliteCorner(profile), nutrition = Training.Owned(profile, "Nutritionist"),
		lookOpts = Career.LookOpts(profile),
		-- damage persistence (section 8.5): the residual face, career head trauma, an open cut, a concussion
		face = safe(Training.FaceView, profile), trauma = tonumber(cond.trauma) or 0,
		injuryCut = safe(Training.HasInjury, profile, "cut") == true,
		concussed = safe(Training.HasInjury, profile, "concussion") == true,
		age = profile.identity.age,
		-- a tournament: what the last round took out of him (FightEngine caps head / body health), the belt he
		-- wears in the ring walk
		carry = safe(Tourney.Carry, profile), walkBelt = safe(Tourney.WornBelt, profile),
	}
end

function Career.FighterFromBoxer(b)
	local app, build, gear = World.Look(b)
	-- the same build bonuses players get (FightEngine folds mods.chinAdd into Chin once for AI fighters)
	local mods = safe(Training.FightModifiersFromBuild, build) or {}
	return {
		isPlayer = false, id = b.id, name = b.name, nick = b.nick, stats = table.clone(b.stats),
		mental = table.clone(b.mental), style = b.style, archetype = b.archetype, class = b.class,
		reach = (b.height or 70) + (#b.name % 5), height = b.height or 70, app = app, build = build, gear = gear,
		fatigue = 0, record = b.record, nat = b.nat, personality = b.personality,
		learned = table.clone(b.learned or {}), h2h = b.h2h, mods = mods, age = b.age,
		lookOpts = { name = b.name, nick = b.nick, nat = b.nat, waistText = b.nick, robe = "Classic", age = b.age },
	}
end

------------------------------------------------------------------------
-- Simulated fight (for players who want to skip a bout)
------------------------------------------------------------------------
-- A simulated fight has no punch-by-punch face model: turn the damage taken (and knockdowns
-- suffered) into the same dmg table a live fight returns (CONTRACTS section 8), so skipped fights
-- still leave a black eye, a cut or a broken nose that heals over the next days.
function Career.SimFace(damage, kdAgainst, r)
	r = r or rng
	local k = clamp((tonumber(damage) or 0) / 140 + (tonumber(kdAgainst) or 0) * 0.12, 0, 1)
	if k < 0.06 then
		return nil
	end
	local function v(lo, hi)
		return clamp(k * r:NextNumber(lo, hi), 0, 1)
	end
	local face = {
		leftEye = v(0.3, 1.1), rightEye = v(0.3, 1.1), bruise = v(0.6, 1.1), lip = v(0.2, 0.8),
		cheekL = v(0.2, 0.9), cheekR = v(0.2, 0.9), forehead = v(0, 0.6), redness = clamp(k * 1.3, 0, 1),
		noseBleed = k > 0.35 and v(0.4, 1) or 0, earL = v(0, 0.4), earR = v(0, 0.4), age = 0,
	}
	if k > 0.4 and r:NextNumber() < k then
		face.cut = clamp(k * r:NextNumber(0.5, 1.15), 0, 1.2)
		face.cutSide = r:NextNumber() < 0.5 and -1 or 1
	end
	if k > 0.8 and r:NextNumber() < 0.3 then
		face.cut2 = clamp(k * r:NextNumber(0.3, 0.8), 0, 1.2)
		face.cutSide2 = -(face.cutSide or 1)
	end
	if k > 0.7 and r:NextNumber() < 0.2 then
		face.nose = true
	end
	return face
end

-- One judge's 10-point must card: the SAME rule as FightEngine.MustScore (copied, because FightEngine
-- requires Career). diff = punch differential (positive: the first fighter did the better work), kdA /
-- kdB = knockdowns each SCORED. The round winner gets 10, the loser 9; a knockdown wins the round for
-- whoever scored it (equal knockdowns cancel), each net knockdown costs one more point unless the man
-- who went down dominated the rest of the round. 10-10 only for an even round with no knockdowns; never 9-9.
local EVEN_ROUND = 0.25
local DOMINANT_ROUND = 3
local function mustScore(diff, kdA, kdB)
	kdA, kdB = tonumber(kdA) or 0, tonumber(kdB) or 0
	diff = tonumber(diff) or 0
	local net = kdA - kdB
	local aWins
	if net ~= 0 then
		aWins = net > 0
	elseif kdA == 0 and math.abs(diff) < EVEN_ROUND then
		return 10, 10
	else
		aWins = diff >= 0
	end
	local down = math.abs(net)
	if down > 0 and (aWins and -diff or diff) >= DOMINANT_ROUND then
		down -= 1
	end
	local loser = math.max(6, 9 - down)
	if aWins then
		return 10, loser
	end
	return loser, 10
end
Career.MustScore = mustScore

function Career.SimFight(profile, offer)
	local function withFace(res)
		res.face = Career.SimFace(res.damageTaken, res.kdAgainst)
		res.noseBroken = res.face ~= nil and res.face.nose == true
		return res
	end
	local b = profile.world.boxers[offer.oppId]
	local p = Career.FighterFromProfile(profile)
	local pPow = (p.stats.Power + p.stats.PunchSpeed + p.stats.Countering + p.stats.RingIQ) / 4
	local pDef = (p.stats.Blocking + p.stats.HeadMovement + p.stats.Chin + p.stats.Reflexes) / 4
	local oPow = (b.stats.Power + b.stats.PunchSpeed + b.stats.Countering + b.stats.RingIQ) / 4
	local oDef = (b.stats.Blocking + b.stats.HeadMovement + b.stats.Chin + b.stats.Reflexes) / 4
	local fatPen = math.max(0, p.fatigue - 50) / 8 + (1 - p.mods.staminaMul) * 20
	local cards = { { 0, 0 }, { 0, 0 }, { 0, 0 } }
	local pDmg, oDmg, kdFor, kdAg = 0, 0, 0, 0
	-- a tournament's later rounds: he starts with what the earlier ones took out of him
	if type(p.carry) == "table" then
		pDmg = (2 - (tonumber(p.carry.head) or 1) - (tonumber(p.carry.body) or 1)) * 50
	end
	local landed, oLanded = 0, 0
	local punches = { jab = 5, cross = 3, leadhook = 2, rearhook = 1, uppercut = 1 }
	for r = 1, offer.rounds do
		local edge = (profile.overall - b.overall) + ((pPow - oDef) - (oPow - pDef)) * 0.3 - fatPen + (profile.mental.Confidence - 50) / 20
		local pOut = math.max(1, 12 + edge * 0.35 + rng:NextNumber(-6, 6))
		local oOut = math.max(1, 12 - edge * 0.35 + rng:NextNumber(-6, 6))
		landed += round(pOut)
		oLanded += round(oOut)
		oDmg += pOut * (p.stats.Power / b.stats.Chin) * 0.9 * (p.mods.powerMul or 1)
		pDmg += oOut * (b.stats.Power / p.stats.Chin) * 0.9
		local pKD = oDmg > 60 and rng:NextNumber() < 0.25
		local oKD = pDmg > 60 and rng:NextNumber() < 0.25
		if pKD then
			kdFor += 1
			oDmg -= 25
		end
		if oKD then
			kdAg += 1
			pDmg -= 25
		end
		for j = 1, 3 do
			local diff = pOut - oOut + rng:NextNumber(-3, 3)
			local a, c = mustScore(diff, pKD and 1 or 0, oKD and 1 or 0)
			cards[j][1] += a
			cards[j][2] += c
		end
		if kdFor >= 2 and oDmg > 70 or kdFor >= 3 then
			return withFace({ outcome = "win", method = rng:NextNumber() < 0.5 and "KO" or "TKO", round = r, cards = cards,
				kdFor = kdFor, kdAgainst = kdAg, landed = landed, oppLanded = oLanded, punches = punches, simulated = true, damageTaken = pDmg })
		elseif kdAg >= 2 and pDmg > 70 or kdAg >= 3 then
			return withFace({ outcome = "loss", method = rng:NextNumber() < 0.5 and "KO" or "TKO", round = r, cards = cards,
				kdFor = kdFor, kdAgainst = kdAg, landed = landed, oppLanded = oLanded, punches = punches, simulated = true, damageTaken = pDmg })
		end
	end
	local res = Career.DecideCards(cards)
	res.round = offer.rounds
	res.cards = cards
	res.kdFor, res.kdAgainst, res.landed, res.oppLanded = kdFor, kdAg, landed, oLanded
	res.punches = punches
	res.simulated = true
	res.damageTaken = pDmg
	return withFace(res)
end

function Career.DecideCards(cards)
	local pw, ow = 0, 0
	for _, c in ipairs(cards) do
		if c[1] > c[2] then
			pw += 1
		elseif c[2] > c[1] then
			ow += 1
		end
	end
	if pw == 3 then
		return { outcome = "win", method = "UD" }
	elseif ow == 3 then
		return { outcome = "loss", method = "UD" }
	elseif pw == 2 and ow == 1 then
		return { outcome = "win", method = "SD" }
	elseif ow == 2 and pw == 1 then
		return { outcome = "loss", method = "SD" }
	elseif pw == 2 then
		return { outcome = "win", method = "MD" }
	elseif ow == 2 then
		return { outcome = "loss", method = "MD" }
	end
	return { outcome = "draw", method = "Draw" }
end

------------------------------------------------------------------------
-- Results
------------------------------------------------------------------------
local function fightRating(offer, res)
	local r = 2
	local diff = 0
	for _, c in ipairs(res.cards or {}) do
		diff += math.abs(c[1] - c[2])
	end
	r += math.max(0, 3 - diff / 4)
	r += (res.kdFor or 0) * 0.8 + (res.kdAgainst or 0) * 0.8
	if offer.kind ~= "Pro Fight" and offer.kind ~= "Amateur Bout" then
		r += 1.5
	end
	if res.method == "KO" or res.method == "TKO" then
		r += 1
	end
	r += (offer.opp.overall or 50) / 50
	return math.clamp(r, 1, 10)
end

function Career.ApplyResult(profile, res)
	local camp = profile.camp
	local offer = camp.offer
	local world = profile.world
	local ci = profile.physical.weightClass
	local b = world.boxers[offer.oppId]
	local notes = {}
	local win, loss, draw = res.outcome == "win", res.outcome == "loss", res.outcome == "draw"
	local isKO = res.method == "KO" or res.method == "TKO" or res.method == "RTD"
	local rec = profile.tier == 1 and profile.amateurRecord or profile.record
	-- the special moves before this result (a bout, a win, a KO or a promotion may unlock new ones)
	local movesBefore = Moves and Moves.Unlocked(Moves.Info(profile)) or nil
	local sigsBefore = (Moves and Combos) and Combos.UnlockedSignatures(Moves.Info(profile)) or nil

	if win then
		rec.w += 1
		if isKO then
			rec.ko += 1
		end
		b.record.l += 1
		b.h2h.w += 1
		profile.tierWins += 1
	elseif loss then
		rec.l += 1
		b.record.w += 1
		if isKO then
			b.record.ko += 1
		end
		b.h2h.l += 1
	else
		rec.d += 1
		b.record.d += 1
		b.h2h.d += 1
	end
	profile.knockdownsScored += res.kdFor or 0

	local meetings = b.h2h.w + b.h2h.l + b.h2h.d
	b.heat = math.clamp(b.heat + 18 + ((res.method == "SD" or res.method == "MD" or draw) and 20 or 0) + (win and 12 or 0)
		+ ((b.personality == "Trash Talker" or b.personality == "Hothead") and 12 or 0) + ((res.kdFor or 0) + (res.kdAgainst or 0)) * 4, 0, 100)
	if meetings >= 3 and math.abs(b.h2h.w - b.h2h.l) >= 2 then
		b.heat = math.max(0, b.heat - 45)
	end
	b.learned = b.learned or {}
	for k, v in pairs(res.punches or {}) do
		b.learned[k] = (b.learned[k] or 0) * 0.5 + v
	end
	if meetings >= 2 then
		table.insert(notes, string.format("Rivalry: %s %d-%d-%d (you-them-draws).", b.name, b.h2h.w, b.h2h.l, b.h2h.d))
	end

	-- money: purse, sponsors, TV, minus team salaries and weight fines
	local purse = offer.purse
	if win then
		purse = round(purse * 1.2)
	end
	-- sponsors are real deals now (Career.SponsorIncome) and their income REPLACES the old popularity
	-- formula (CONTRACTS s.16 H). Only a career with no deal at all still gets half of that formula as
	-- unsigned merch & appearance fees (the gap map's fallback), so not signing never pays more than
	-- signing: at tier 3+ even the smallest local deal outpays it within a few fights.
	local hadDeals = next(sponsorState(profile).deals) ~= nil -- before SponsorIncome expires any
	local sponsor, sponsorNotes = Career.SponsorIncome(profile, win, isKO, Sponsors.TITLE_KINDS[offer.kind] == true, loss)
	local endorse = 0
	if not hadDeals and profile.tier >= 3 and profile.popularity >= 5 then
		endorse = round((profile.popularity ^ 1.4) * 35 * profile.tier * ENDORSE_SHARE)
	end
	local tv = 0
	if profile.tier >= 5 then
		tv = round(offer.purse * 0.25 + profile.popularity * 1200)
	end
	local salary = Training.TeamSalary(profile)
	local fine = 0
	if res.weighIn and res.weighIn.fine and res.weighIn.fine > 0 then
		fine = round(purse * res.weighIn.fine)
		table.insert(notes, string.format("Missed weight by %.1f lbs: fined %s.", res.weighIn.over, Config.Money(fine)))
	end
	local total = purse + sponsor + endorse + tv - salary - fine
	profile.money += total
	table.insert(notes, string.format("Purse %s  Sponsors %s  Endorsements %s  TV %s  Team salaries -%s", Config.Money(purse), Config.Money(sponsor),
		Config.Money(endorse), Config.Money(tv), Config.Money(salary)))
	for _, n in ipairs(sponsorNotes) do
		table.insert(notes, n)
	end

	local m = profile.mental
	if win then
		-- (a tournament's fame comes per round from Tourney.AfterResult, not the big-night bonus)
		-- (a sponsor's fan-growth perk scales the fame a win brings)
		local fame = (2 + (isKO and 2 or 0) + (offer.kind ~= "Pro Fight" and offer.kind ~= "Amateur Bout" and not offer.tourney and 6 or 0)) * (1 + Sponsors.Perk(profile, "fans"))
		profile.popularity = math.clamp(profile.popularity + fame, 0, 100)
		m.Confidence = math.clamp(m.Confidence + 4 + (isKO and 2 or 0), 25, 100)
	elseif loss then
		profile.popularity = math.clamp(profile.popularity - 1, 0, 100)
		m.Confidence = math.clamp(m.Confidence - 4, 25, 100)
	end
	m.Focus = math.clamp(m.Focus + 1, 0, 100)
	m.Composure = math.clamp(m.Composure + 1 + ((res.kdAgainst or 0) > 0 and win and 3 or 0), 0, 100)
	if win and b.overall >= 70 then
		profile.qualityWins += 1
	end

	-- gear takes a beating on fight night
	Training.WearGear(profile, "gloves", 6)
	Training.WearGear(profile, "shoes", 3)
	Training.WearGear(profile, "wraps", 10)

	local function giveBelt(org)
		profile.belts[org] = true
		local prevB = world.boxers[world.champions[org][ci]]
		if prevB then
			local i = table.find(prevB.belts, org)
			if i then
				table.remove(prevB.belts, i)
			end
		end
		world.champions[org][ci] = "player"
		profile.titlesWon += 1
		table.insert(notes, "NEW " .. org .. " WORLD CHAMPION")
	end
	if win then
		if offer.kind == "Regional Title" then
			profile.regional.regional = true
			world.regional.regional[ci] = "player"
			profile.tier = 3
			profile.tierWins = 0
			table.insert(notes, "You are the REGIONAL CHAMPION")
		elseif offer.kind == "National Title" then
			profile.regional.national = true
			world.regional.national[ci] = "player"
			profile.tier = 4
			profile.tierWins = 0
			table.insert(notes, "You are the NATIONAL CHAMPION")
		end
		for _, org in ipairs(offer.stakes or {}) do
			if not profile.belts[org] then
				giveBelt(org)
			end
		end
		if #(offer.playerStakes or {}) > 0 then
			profile.defenses += 1
			table.insert(notes, "Successful title defense #" .. profile.defenses)
		end
	elseif loss and #(offer.playerStakes or {}) > 0 then
		for _, org in ipairs(offer.playerStakes) do
			if profile.belts[org] then
				profile.belts[org] = false
				world.champions[org][ci] = b.id
				table.insert(b.belts, org)
				table.insert(notes, "You lost your " .. org .. " title.")
			end
		end
	end
	local nBelts = #playerBelts(profile)
	if nBelts == 4 and profile.tier < 9 then
		profile.tier = 9
		profile.undisputedReigns += 1
		table.insert(notes, "UNDISPUTED CHAMPION OF THE WORLD")
	elseif nBelts > 0 and (profile.tier < 8 or (nBelts < 4 and profile.tier >= 9)) then
		profile.tier = 8
	elseif nBelts == 0 and profile.tier >= 8 then
		profile.tier = 7
		table.insert(notes, "You're a former champion. Climb back to a title shot.")
	end

	-- a tournament bout: the bracket moves on (the AI side of the round, the next round booked, or the run's end:
	-- prize money, the belt, the champion on the world's books)
	local trn = offer.tourney and safe(Tourney.AfterResult, profile, offer, res, notes) or nil
	-- time passes: medical suspension / recovery
	local suspension = 21
	if loss and isKO then
		suspension = 45
	elseif loss or (res.kdAgainst or 0) > 0 then
		suspension = 28
	end
	if trn and trn.continuing then
		-- (the next round is days away, not weeks: no suspension, the recovery days the bracket allows)
		suspension = trn.recovery
	end
	for _, n in ipairs(Training.PassDays(profile, suspension)) do
		table.insert(notes, n)
	end
	-- fight damage persists (CONTRACTS 8.3): what is left after the suspension heals over the next
	-- days; head trauma accumulates and a bad concussion / broken nose becomes an injury
	safe(Training.AddFaceDamage, profile, res.face, Config.FaceDamage.postFightCarry)
	-- injuries date from fight night: they have healed through the suspension already
	for _, n in ipairs(safe(Training.AddTrauma, profile, res, suspension) or {}) do
		table.insert(notes, n)
	end
	if trn and trn.continuing and safe(Training.HasInjury, profile, "concussion") == true then
		-- the doctor's look before the next round: a concussion is a medical withdrawal
		safe(Tourney.MedicalCheck, profile, true, notes)
		trn.continuing, trn.nextCamp = false, nil
	end
	if trn and trn.continuing then
		table.insert(notes, string.format("%d day%s of recovery before the next round.", suspension, suspension == 1 and "" or "s"))
	else
		table.insert(notes, string.format("%d days of recovery before your next camp.", suspension))
		-- (the world goes on between camps; a bracket's rounds are only days apart)
		World.SimulateCycle(profile, rng)
	end
	-- the calendar moved on: tournaments the player sat out are settled by the AI
	safe(Tourney.Tick, profile)
	for _, id in ipairs(world.classes[ci]) do
		local x = world.boxers[id]
		x.heat = math.max(0, x.heat - 4)
	end
	profile.overall = Config.Overall(profile.stats)

	if profile.tier == 1 and profile.amateurRecord.w >= 4 then
		profile.tier = 2
		profile.tierWins = 0
		table.insert(notes, "You turned PRO. You are now a Local Pro, and the global rankings include you.")
	elseif profile.tier == 4 and profile.tierWins >= 2 then
		profile.tier = 5
		profile.tierWins = 0
		table.insert(notes, "Promoted: International Contender.")
	end
	local best = World.BestRank(profile)
	if profile.tier == 5 and best <= 10 then
		profile.tier = 6
		table.insert(notes, "You broke into the TOP 10.")
	end
	if profile.tier == 6 and best <= 3 then
		profile.tier = 7
		table.insert(notes, "Title Challenger: world title shots are now available.")
	end
	if profile.tier == 9 and profile.defenses >= 2 and Career.Legacy(profile).score >= 500 then
		profile.tier = 10
		table.insert(notes, "You are now a BOXING LEGEND.")
	end
	-- sponsor offers count down, expire and are topped up for the career as it now stands
	for _, n in ipairs(safe(Sponsors.AfterFight, profile, Sponsors.Ctx(profile, best)) or {}) do
		table.insert(notes, n)
	end

	-- new special moves: one note each on the result screen (ClientMain shows them in gold), with what
	-- unlocked it ("NEW SPECIAL MOVE: Double jab (3 bouts fought)")
	if movesBefore then
		local info = Moves.Info(profile)
		local now = Moves.Unlocked(info)
		for _, id in ipairs(Moves.List) do
			if now[id] and not movesBefore[id] then
				table.insert(notes, string.format("NEW SPECIAL MOVE: %s (%s). Moves & Controls has its keys.", Moves.Data[id].name, tostring(Moves.UnlockedBy(id, info))))
			end
		end
	end
	-- new signature combos (Combos.Signatures: the same fight milestones)
	if sigsBefore then
		local info = Moves.Info(profile)
		local now = Combos.UnlockedSignatures(info)
		for _, c in ipairs(Combos.Signatures) do
			if now[c.id] and not sigsBefore[c.id] then
				table.insert(notes, string.format("NEW SIGNATURE COMBO: %s (%s). Moves & Controls shows how it goes.", c.name, tostring(Combos.SignatureUnlockedBy(c.id, info))))
			end
		end
	end

	local entry = {
		day = profile.day, opp = b.name, oppId = b.id, outcome = res.outcome, method = res.method, round = res.round,
		kind = offer.kind, rating = fightRating(offer, res), kdFor = res.kdFor or 0, kdAgainst = res.kdAgainst or 0,
		stakes = offer.stakes, cards = res.cards, amateur = offer.kind == "Amateur Bout", venue = offer.venueName,
	}
	table.insert(profile.history, entry)
	while #profile.history > 80 do
		table.remove(profile.history, 1)
	end
	profile.camp = nil
	profile.offers = nil
	if trn and trn.continuing and trn.nextCamp then
		-- the next round of the bracket is booked as a camp of its own
		profile.camp = trn.nextCamp
		entry.tourney = offer.tourney.id
	end
	return { notes = notes, earnings = total, entry = entry, tourney = trn }
end

------------------------------------------------------------------------
-- Legacy
------------------------------------------------------------------------
-- tournament belts count toward the legacy: 4 / 8 / 14 / 22 / 40 a win, by the event's level
local TOURNEY_LEGACY = { novice = 4, city = 8, regional = 14, national = 22, world = 40 }
function Career.TourneyLegacy(profile)
	local s = type(profile.tourney) == "table" and profile.tourney
	local total = 0
	for id, b in pairs(s and type(s.belts) == "table" and s.belts or {}) do
		total += (TOURNEY_LEGACY[id] or 0) * math.max(0, math.floor(tonumber(type(b) == "table" and b.n) or 0))
	end
	return total
end
local function legacyParts(profile)
	local r = profile.record
	local parts = {
		{ "Pro wins", r.w * 3 },
		{ "Knockouts", r.ko * 1.5 },
		{ "Losses", -r.l * 3 },
		{ "World titles won", profile.titlesWon * 40 },
		{ "Title defenses", profile.defenses * 12 },
		{ "Undisputed reigns", profile.undisputedReigns * 80 },
		{ "Elite wins", profile.qualityWins * 6 },
		{ "Regional & national titles", (profile.regional.regional and 10 or 0) + (profile.regional.national and 20 or 0) },
		{ "Tournament belts", Career.TourneyLegacy(profile) },
		{ "Legend status", profile.tier >= 10 and 100 or 0 },
	}
	local score = 0
	for _, p in ipairs(parts) do
		score += p[2]
	end
	return parts, math.max(0, round(score))
end

-- where a legacy score ranks among the all-time greats (1 = the GOAT)
local function goatRank(score)
	local rank = 1
	for _, e in ipairs(Config.Legends) do
		if e.score > score then
			rank += 1
		end
	end
	return rank
end

function Career.Legacy(profile)
	local parts, score = legacyParts(profile)
	local list = table.clone(Config.Legends)
	table.insert(list, { name = profile.identity.name .. " (YOU)", score = score, you = true })
	table.sort(list, function(a, b)
		return a.score > b.score
	end)
	local goat = 0
	for i, e in ipairs(list) do
		if e.you then
			goat = i
		end
	end
	local fights = table.clone(profile.history)
	table.sort(fights, function(a, b)
		return a.rating > b.rating
	end)
	local top = {}
	for i = 1, math.min(5, #fights) do
		top[i] = fights[i]
	end
	return {
		score = score, parts = parts, goatRank = goat, goatList = list,
		hallOfFame = score >= Config.HallOfFameScore, greatest = top,
	}
end

function Career.Retire(profile)
	if profile.retired then
		return
	end
	profile.camp = nil
	profile.retired = true
	if type(profile.tourney) == "table" then
		profile.tourney.run = nil
	end
	local lg = Career.Legacy(profile)
	profile.final = lg
	table.insert(profile.pastCareers, 1, {
		name = profile.identity.name, nick = profile.identity.nickname, record = profile.record,
		titles = profile.titlesWon, score = lg.score, goatRank = lg.goatRank, hof = lg.hallOfFame,
	})
	while #profile.pastCareers > 10 do
		table.remove(profile.pastCareers)
	end
end

------------------------------------------------------------------------
-- Client summary
------------------------------------------------------------------------
local function r2(n)
	return math.floor(n * 100 + 0.5) / 100
end

-- residual face damage for the Hub: { stage 0..4, label, days until it reads as fresh } or nil
local function faceSummary(profile)
	local f = safe(Training.FaceView, profile)
	if type(f) ~= "table" then
		return nil
	end
	local FD = Config.FaceDamage
	local stage, def = Config.FaceDamageStage(f)
	-- the slowest field at its daily heal rate decides when the face is clean again
	local days = 0
	for _, k in ipairs(FD.fields) do
		local v, rule = tonumber(f[k]), FD.heal[k]
		if v and v > FD.clearBelow and rule then
			local d = 1
			if rule.sub and rule.sub > 0 then
				d = math.ceil((v - FD.clearBelow) / rule.sub)
			elseif rule.mul and rule.mul > 0 and rule.mul < 1 then
				d = math.ceil(math.log(FD.clearBelow / v) / math.log(rule.mul))
			end
			days = math.max(days, d)
		end
	end
	return {
		stage = stage, label = def and def.label or "", days = days, nose = f.nose == true,
		cut = math.max(tonumber(f.cut) or 0, tonumber(f.cut2) or 0) > 0.05,
		eyes = math.max(tonumber(f.leftEye) or 0, tonumber(f.rightEye) or 0),
	}
end

-- derived gym facility tier (CONTRACTS section 9): never saved
local function gymTierSummary(profile)
	local ok, idx, def, frac, needs = pcall(Catalog.GymTier, profile.gym and profile.gym.levels, profile.owned, profile.tier)
	if not ok or type(def) ~= "table" then
		return { index = 1, id = "Beginner", name = "Beginner Gym", frac = 0, needs = {} }
	end
	local nextDef = Config.GymTiers[idx + 1]
	return {
		index = idx, id = def.id, name = def.name, desc = def.desc, growth = def.growth, frac = r2(frac or 0),
		needs = needs or {}, nextName = nextDef and nextDef.name or nil,
	}
end

local function sponsorSummary(profile)
	return Sponsors.Summary(profile, sponsorCtx(profile))
end

function Career.Summary(profile, storeOk)
	if not profile.created then
		return { created = false, pastCareers = profile.pastCareers, storeOk = storeOk }
	end
	local stats = {}
	for k, v in pairs(profile.stats) do
		stats[k] = r2(v)
	end
	local mental = {}
	for k, v in pairs(profile.mental) do
		mental[k] = math.floor(v)
	end
	local body = {}
	for k, v in pairs(profile.body) do
		body[k] = r2(v)
	end
	local ranks = World.PlayerRanks(profile)
	local best, bestOrg = World.BestRank(profile)
	local hist = {}
	for i = #profile.history, math.max(1, #profile.history - 11), -1 do
		table.insert(hist, profile.history[i])
	end
	local camp
	if profile.camp then
		camp = { daysLeft = profile.camp.daysLeft, daysTotal = profile.camp.daysTotal, offer = profile.camp.offer, log = profile.camp.log }
	end
	local c = profile.condition
	local injuries = {}
	for _, inj in ipairs(Training.ActiveInjuries(profile)) do
		local def = Config.Injuries[inj.id]
		table.insert(injuries, { id = inj.id, name = def and def.name or inj.id, days = math.ceil(inj.days) })
	end
	local gearCond = {}
	for k, v in pairs(profile.gear.cond) do
		gearCond[k] = math.floor(v)
	end
	local gymCond = {}
	for k, v in pairs(profile.gym.cond) do
		gymCond[k] = math.floor(v)
	end
	local style = Config.FindById(Config.Styles, profile.style)
	local wi = Training.WeighIn(profile)
	local physique = safe(Training.PhysiqueInfo, profile) or { id = "Balanced", name = Training.Physique(profile), desc = "" }
	local sore = {}
	for grp, v in pairs(type(c.sore) == "table" and c.sore or {}) do
		v = tonumber(v)
		if type(grp) == "string" and v and v == v and v > 0.01 then
			sore[grp] = r2(math.clamp(v, 0, 1))
		end
	end
	local _, lgScore = legacyParts(profile)
	local trauma = tonumber(c.trauma) or 0
	trauma = trauma == trauma and math.floor(math.clamp(trauma, 0, 100)) or 0
	-- training records per activity: best / last session quality, session count, best numbers
	local records = {}
	if type(profile.records) == "table" then
		for id, r in pairs(profile.records) do
			if type(id) == "string" and type(r) == "table" then
				records[id] = {
					best = r2(tonumber(r.best) or 0), last = r2(tonumber(r.last) or 0), sessions = tonumber(r.sessions) or 0,
					stats = type(r.stats) == "table" and table.clone(r.stats) or nil,
				}
			end
		end
	end
	return {
		created = true, retired = profile.retired, storeOk = storeOk,
		identity = profile.identity, appearance = profile.appearance, physical = profile.physical,
		style = style and style.name or profile.style, styleId = profile.style, specialty = profile.specialty,
		stats = stats, mental = mental, overall = profile.overall, money = profile.money,
		popularity = math.floor(profile.popularity), day = profile.day, tier = profile.tier,
		tierName = Config.Tiers[profile.tier].name, record = profile.record, amateurRecord = profile.amateurRecord,
		belts = profile.belts, regional = profile.regional, defenses = profile.defenses, titlesWon = profile.titlesWon,
		owned = profile.owned, camp = camp, ranks = ranks, bestRank = best < 999 and best or nil, bestOrg = bestOrg,
		history = hist, pastCareers = profile.pastCareers, final = profile.final,
		className = Config.WeightClasses[profile.physical.weightClass].name,
		body = body, physique = Training.Physique(profile), physiqueId = physique.id, physiqueDesc = physique.desc,
		-- [FrameTraits] the body frame (Shared.FrameTraits reads its ring traits for the cards)
		frame = profile.appearance and profile.appearance.body and profile.appearance.body.frame or "Athletic",
		physiquePinned = physique.pinned == true,
		weight = r2(wi.weight), weightLimit = wi.limit, overWeight = r2(wi.over),
		condition = {
			energy = math.floor(c.energy), hydration = math.floor(c.hydration), nutrition = math.floor(c.nutrition),
			fatigue = math.floor(c.fatigue), sleepQ = r2(c.sleepQ or 0.8), injuries = injuries,
			buffs = c.buffs, flexible = c.flexible, water = r2(c.water or 0),
			sore = sore, trauma = trauma, face = faceSummary(profile),
		},
		gym = { levels = profile.gym.levels, cond = gymCond },
		gymTier = gymTierSummary(profile),
		gear = { owned = profile.gear.owned, equipped = profile.gear.equipped, cond = gearCond },
		coaches = profile.coaches, salary = Training.TeamSalary(profile), sessions = profile.sessions or 0,
		records = records,
		-- city & career immersion (Hub Life / Sponsors tabs, CityVisuals)
		home = Career.HomeOf(profile), sponsors = sponsorSummary(profile),
		legacy = { score = lgScore, hof = lgScore >= Config.HallOfFameScore, goatRank = goatRank(lgScore) },
		settings = { wakeAt = type(profile.settings) == "table" and profile.settings.wakeAt or nil },
		autographReady = profile.lastAutographDay ~= profile.day and (profile.popularity or 0) >= 3,
		lastFightDay = tonumber(profile.lastFightDay),
		-- the tournaments: the calendar, the rules, the bracket being fought, the belts won (Hub Tournaments tab)
		tourney = (function()
			safe(Tourney.Tick, profile) -- (idempotent: a new career gets last season's champions on its first summary)
			return safe(Tourney.View, profile)
		end)(),
	}
end

return Career
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="91">
        <Properties>
          <string name="Name">CityHomes</string>
          <string name="Source"><![CDATA[-- CityHomes: the players' home interiors. Per player and server-built (a teleported character must
-- land on real collision), far outside the map, built on demand when the player travels home and
-- furnished from the profile: home kind, add-ons (Home Gym, Trophy Room, Recovery Suite, Pool Deck),
-- belts, fight posters from the history, the record on the TV. Rebuilt only when that signature
-- changes; released when the player leaves. Every home: Sleep prompt by the bed, Exit prompt by the
-- door. CityMap re-exports Enter / Exit / Release / HomeSpec / HomeKind under its old names.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GymDecor = require(script.Parent:WaitForChild("GymDecor"))
local K = require(script.Parent:WaitForChild("CityKit"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

local CityHomes = {}

local V3 = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local RAD = math.rad
local M = Enum.Material
local C = K.C
local part, cyl, vcyl, ball, blob = K.part, K.cyl, K.vcyl, K.ball, K.blob
local label, frame, gui, spot, point, emitter = K.label, K.frame, K.gui, K.spot, K.point, K.emitter
local promptPart, lightZone, roomLight = K.promptPart, K.lightZone, K.roomLight

local homesFolder
local homeSlots = {} -- slot index -> player
local homes = {} -- player -> { model, kind, sig, spawn, slot, tokens, tokAt }
-- interior rebuild budget per player: a burst of REBUILD_BURST, refilling one per REBUILD_GAP seconds
local REBUILD_BURST = 3
local REBUILD_GAP = 1.5

local HOME_SPEC = {
	Apartment = { w = 46, d = 30, h = 13, zone = "Apartment", floor = Color3.fromRGB(150, 112, 78), floorMat = M.WoodPlanks,
		wall = Color3.fromRGB(226, 222, 214), view = "city", sheet = Color3.fromRGB(60, 70, 90), sofa = Color3.fromRGB(70, 72, 80), lights = 3 },
	House = { w = 58, d = 38, h = 14, zone = "Apartment", floor = Color3.fromRGB(170, 132, 92), floorMat = M.WoodPlanks,
		wall = Color3.fromRGB(236, 230, 218), view = "suburb", sheet = Color3.fromRGB(150, 60, 50), sofa = Color3.fromRGB(110, 86, 64), lights = 4 },
	Mansion = { w = 96, d = 60, h = 20, zone = "Mansion", floor = Color3.fromRGB(236, 232, 224), floorMat = M.Marble,
		wall = Color3.fromRGB(246, 244, 238), view = "coast", sheet = Color3.fromRGB(240, 236, 226), sofa = Color3.fromRGB(240, 236, 226), lights = 6 },
}
CityHomes.HomeSpec = HOME_SPEC

local function homeKindFor(profile, kind)
	local owned = type(profile.owned) == "table" and profile.owned or {}
	if kind and HOME_SPEC[kind] and owned[kind] == true then
		return kind
	end
	for _, id in ipairs({ "Mansion", "House", "Apartment" }) do
		if owned[id] == true then
			return id
		end
	end
	return nil
end
CityHomes.HomeKind = homeKindFor

function CityHomes.Init(folder)
	homesFolder = folder
end

-- what you see through the window wall: a lit backdrop panel outside the glass
local function homeView(f, base, w, h, d, view)
	local panel = part(f, "WindowView", V3(w * 1.6, h * 2.4, 0.2), base * CF(0, h * 0.8, -d / 2 - 14), Color3.fromRGB(120, 160, 210), M.SmoothPlastic, { shadow = false })
	local sg = gui(panel, Enum.NormalId.Back, 3, 0, 300)
	local sky = frame(sg, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1) })
	local grad = Instance.new("UIGradient")
	grad.Rotation = 90
	local rng = Random.new(#view * 31)
	if view == "city" then
		grad.Color = ColorSequence.new(Color3.fromRGB(40, 60, 110), Color3.fromRGB(250, 160, 110))
		grad.Parent = sky
		for k = 0, 15 do
			local th = rng:NextNumber(0.25, 0.6)
			local tw = rng:NextNumber(0.04, 0.08)
			local tower = frame(sg, { Size = UDim2.fromScale(tw, th), Position = UDim2.fromScale(k / 16 + rng:NextNumber(-0.01, 0.01), 1 - th), BackgroundColor3 = Color3.fromRGB(30 + k % 3 * 8, 34, 50) })
			for r = 0, 3 do
				frame(tower, { Size = UDim2.fromScale(0.7, 0.03), Position = UDim2.fromScale(0.15, 0.1 + r * 0.2), BackgroundColor3 = Color3.fromRGB(255, 214, 140), BackgroundTransparency = rng:NextNumber() < 0.5 and 0 or 0.7 })
			end
		end
	elseif view == "suburb" then
		grad.Color = ColorSequence.new(Color3.fromRGB(110, 170, 230), Color3.fromRGB(220, 236, 250))
		grad.Parent = sky
		for k = 0, 3 do
			local hill = frame(sg, { Size = UDim2.fromScale(0.6, 0.5), Position = UDim2.fromScale(k * 0.3 - 0.15, 0.62 + (k % 2) * 0.06), BackgroundColor3 = Color3.fromRGB(70 + k * 8, 130 + k * 6, 70) })
			Instance.new("UICorner", hill).CornerRadius = UDim.new(0.5, 0)
		end
		for k = 0, 9 do
			local tree = frame(sg, { Size = UDim2.fromScale(0.07, 0.16), Position = UDim2.fromScale(k * 0.1 + 0.01, 0.58 + rng:NextNumber(0, 0.08)), BackgroundColor3 = Color3.fromRGB(40, 100 + k % 3 * 12, 50) })
			Instance.new("UICorner", tree).CornerRadius = UDim.new(0.5, 0)
		end
		frame(sg, { Size = UDim2.fromScale(1, 0.12), Position = UDim2.fromScale(0, 0.88), BackgroundColor3 = Color3.fromRGB(90, 140, 70) })
	else
		grad.Color = ColorSequence.new(Color3.fromRGB(80, 140, 220), Color3.fromRGB(255, 210, 160))
		grad.Parent = sky
		local sun = frame(sg, { Size = UDim2.fromScale(0.09, 0.14), Position = UDim2.fromScale(0.7, 0.42), BackgroundColor3 = Color3.fromRGB(255, 236, 170) })
		Instance.new("UICorner", sun).CornerRadius = UDim.new(0.5, 0)
		local sea = frame(sg, { Size = UDim2.fromScale(1, 0.4), Position = UDim2.fromScale(0, 0.6), BackgroundColor3 = Color3.new(1, 1, 1) })
		local sg2 = Instance.new("UIGradient")
		sg2.Rotation = 90
		sg2.Color = ColorSequence.new(Color3.fromRGB(70, 150, 200), Color3.fromRGB(20, 70, 130))
		sg2.Parent = sea
		for k = 0, 2 do
			frame(sg, { Size = UDim2.fromScale(0.3, 0.004), Position = UDim2.fromScale(0.55 + k * 0.05, 0.63 + k * 0.03), BackgroundColor3 = Color3.fromRGB(255, 240, 200) })
		end
		for _, x in ipairs({ 0.06, 0.88 }) do
			frame(sg, { Size = UDim2.fromScale(0.012, 0.4), Position = UDim2.fromScale(x, 0.34), BackgroundColor3 = Color3.fromRGB(40, 36, 30) })
			local crown = frame(sg, { Size = UDim2.fromScale(0.1, 0.06), Position = UDim2.fromScale(x - 0.044, 0.31), BackgroundColor3 = Color3.fromRGB(30, 50, 30) })
			Instance.new("UICorner", crown).CornerRadius = UDim.new(0.5, 0)
		end
	end
	return panel
end

-- floor, ceiling, three solid walls, a floor-to-ceiling window wall at local -Z, lights, zone
local function homeShell(f, base, spec)
	local w, d, h = spec.w, spec.d, spec.h
	part(f, "HomeFloor", V3(w + 2, 1, d + 2), base * CF(0, -0.5, 0), spec.floor, spec.floorMat, { collide = true })
	part(f, "HomeCeiling", V3(w + 2, 1, d + 2), base * CF(0, h + 0.5, 0), Color3.fromRGB(244, 242, 236), M.SmoothPlastic, { collide = true })
	part(f, "HomeWall", V3(w + 2, h, 1), base * CF(0, h / 2, d / 2 + 0.5), spec.wall, M.SmoothPlastic, { collide = true })
	for _, sx in ipairs({ -1, 1 }) do
		part(f, "HomeWall", V3(1, h, d + 2), base * CF(sx * (w / 2 + 0.5), h / 2, 0), spec.wall, M.SmoothPlastic, { collide = true })
	end
	part(f, "HomeSill", V3(w, 1.2, 1), base * CF(0, 0.6, -d / 2 - 0.5), spec.wall, M.SmoothPlastic, { collide = true })
	part(f, "HomeGlass", V3(w, h - 1.6, 0.3), base * CF(0, 1.2 + (h - 1.6) / 2, -d / 2 - 0.5), Color3.fromRGB(200, 225, 240), M.Glass, { transparency = 0.7, reflect = 0.08, collide = true, shadow = false })
	part(f, "HomeHeader", V3(w, 0.4, 1), base * CF(0, h - 0.2, -d / 2 - 0.5), spec.wall, M.SmoothPlastic)
	local n = math.floor(w / 9)
	for k = 0, n do
		part(f, "WindowMullion", V3(0.35, h - 1.6, 0.5), base * CF(-w / 2 + k * w / n, 1.2 + (h - 1.6) / 2, -d / 2 - 0.5), Color3.fromRGB(34, 34, 38), M.Metal)
	end
	homeView(f, base, w, h, d, spec.view)
	for k = 1, spec.lights do
		local x = -w / 2 + (k - 0.5) * w / spec.lights
		roomLight(f, base * CF(x, h - 1, 2), Color3.fromRGB(255, 232, 205), math.max(22, h * 1.8), 0.9)
		part(f, "CeilingLight", V3(2.6, 0.15, 2.6), base * CF(x, h - 0.08, 2), Color3.fromRGB(255, 248, 236), M.Neon, { shadow = false })
	end
	lightZone(f, "HomeZone", V3(w, h, d), base * CF(0, h / 2, 0), spec.zone)
end

local function bed(f, cf, w, len, sheet)
	part(f, "BedFrame", V3(w + 0.6, 1.4, len + 0.6), cf * CF(0, 0.7, 0), Color3.fromRGB(70, 50, 36), M.Wood, { collide = true })
	part(f, "Mattress", V3(w, 0.9, len), cf * CF(0, 1.85, 0), Color3.fromRGB(242, 242, 238), M.Fabric)
	part(f, "Blanket", V3(w + 0.12, 0.3, len * 0.62), cf * CF(0, 2.3, -len * 0.19), sheet, M.Fabric)
	part(f, "Headboard", V3(w + 0.6, 4.2, 0.5), cf * CF(0, 2.6, len / 2 + 0.3), Color3.fromRGB(60, 44, 32), M.Fabric)
	for _, x in ipairs({ -1, 1 }) do
		blob(f, "Pillow", V3(w * 0.38, 0.65, 1.6), cf * CF(x * w * 0.22, 2.55, len / 2 - 1.1), Color3.fromRGB(250, 250, 248), M.Fabric)
		part(f, "Nightstand", V3(2, 2, 2), cf * CF(x * (w / 2 + 1.8), 1, len / 2 - 1), Color3.fromRGB(70, 50, 36), M.Wood, { collide = true })
	end
	local lamp = blob(f, "BedLamp", V3(1, 1.2, 1), cf * CF(w / 2 + 1.8, 2.8, len / 2 - 1), Color3.fromRGB(255, 236, 200), M.SmoothPlastic, { shadow = false })
	point(lamp, Color3.fromRGB(255, 210, 160), 10, 0.7)
end

local function sofa(f, cf, len, color)
	part(f, "SofaBase", V3(len, 1.6, 3.2), cf * CF(0, 0.8, 0), color, M.Fabric, { collide = true })
	part(f, "SofaBack", V3(len, 2.4, 0.9), cf * CF(0, 2.2, 1.2), color, M.Fabric)
	for _, x in ipairs({ -1, 1 }) do
		part(f, "SofaArm", V3(0.9, 2.3, 3.2), cf * CF(x * (len / 2 - 0.45), 1.15, 0), color, M.Fabric)
		part(f, "SofaCushion", V3(len / 2 - 1.1, 0.55, 2.3), cf * CF(x * (len / 4 - 0.2), 1.85, -0.2), color:Lerp(Color3.new(1, 1, 1), 0.12), M.Fabric)
	end
end

local function kitchen(f, cf, len, cab, top)
	part(f, "Cabinets", V3(len, 3.2, 2.2), cf * CF(0, 1.6, 0), cab, M.SmoothPlastic, { collide = true })
	part(f, "Worktop", V3(len + 0.2, 0.25, 2.4), cf * CF(0, 3.3, 0), top, M.Marble)
	part(f, "UpperCabinets", V3(len, 2.4, 1.2), cf * CF(0, 7.0, 0.5), cab, M.SmoothPlastic)
	part(f, "Fridge", V3(3, 7.2, 2.6), cf * CF(len / 2 + 1.6, 3.6, 0.1), Color3.fromRGB(200, 202, 206), M.Metal, { collide = true, reflect = 0.1 })
	part(f, "Hob", V3(2.4, 0.08, 1.6), cf * CF(-len / 4, 3.45, 0), Color3.fromRGB(20, 20, 22), M.Glass)
	part(f, "Sink", V3(2, 0.1, 1.4), cf * CF(len / 4, 3.44, 0), Color3.fromRGB(180, 184, 190), M.Metal)
	part(f, "Kettle", V3(0.7, 0.9, 0.7), cf * CF(0, 3.9, 0.2), Color3.fromRGB(200, 40, 40), M.SmoothPlastic)
end

-- "SURNAME vs OPP / WIN by KO R3" poster from a history entry
local function fightPoster(f, cf, entry, surname)
	local p = part(f, "FightPoster", V3(3.2, 4.6, 0.12), cf, C.black, M.SmoothPlastic)
	local win = entry.outcome == "win"
	local opp = tostring(entry.opp or "?")
	local oppLast = opp:match("(%S+)$") or opp
	GymDecor.PosterGui(p, Enum.NormalId.Front, {
		bg = win and Color3.fromRGB(18, 18, 22) or Color3.fromRGB(60, 20, 22), accent = win and C.gold or C.red,
		top = tostring(entry.kind or "FIGHT NIGHT"):upper(), title = string.format("%s\nvs\n%s", surname:upper(), oppLast:upper()),
		sub = string.format("%s - %s R%d", tostring(entry.outcome or ""):upper(), tostring(entry.method or ""), tonumber(entry.round) or 0),
		foot = string.format("%s - DAY %d", tostring(entry.venue or "WCB"):upper(), tonumber(entry.day) or 0),
	})
	return p
end

local BELT_COLORS = { REGIONAL = Color3.fromRGB(190, 190, 200), NATIONAL = Color3.fromRGB(205, 127, 50) }
local function beltList(profile)
	local list = {}
	local reg = type(profile.regional) == "table" and profile.regional or {}
	if reg.regional then
		table.insert(list, "REGIONAL")
	end
	if reg.national then
		table.insert(list, "NATIONAL")
	end
	for _, org in ipairs(Config.Orgs) do
		if type(profile.belts) == "table" and profile.belts[org] then
			table.insert(list, org)
		end
	end
	return list
end

local function belt(f, cf, name)
	local col = BELT_COLORS[name] or C.gold
	part(f, "BeltStrap", V3(3.4, 0.7, 0.18), cf, Color3.fromRGB(20, 20, 22), M.Leather)
	cyl(f, "BeltPlate", 0.2, 1.4, cf * CF(0, 0, -0.12) * ANG(0, RAD(90), 0), col, M.Metal, { reflect = 0.3 })
	for _, x in ipairs({ -1.1, 1.1 }) do
		part(f, "BeltSidePlate", V3(0.6, 0.55, 0.08), cf * CF(x, 0, -0.12), col, M.Metal, { reflect = 0.3 })
	end
	local tagPart = part(f, "BeltTag", V3(1.6, 0.35, 0.05), cf * CF(0, -0.75, -0.1), Color3.fromRGB(20, 20, 22), M.SmoothPlastic)
	GymDecor.Sign(tagPart, Enum.NormalId.Front, name, col, nil, 60)
end

local function trophy(f, cf, h, color)
	vcyl(f, "TrophyBase", 0.5, 1.1, cf, Color3.fromRGB(40, 30, 24), M.Wood)
	vcyl(f, "TrophyStem", h * 0.45, 0.25, cf * CF(0, 0.5, 0), color, M.Metal, { reflect = 0.3 })
	blob(f, "TrophyCup", V3(0.9, h * 0.4, 0.9), cf * CF(0, 0.5 + h * 0.6, 0), color, M.Metal, { reflect = 0.3 })
end

local function homeGym(f, cf, big)
	part(f, "GymMat", V3(big and 16 or 10, 0.15, big and 12 or 8), cf * CF(0, 0.08, 0), Color3.fromRGB(32, 32, 35), M.Rubber)
	part(f, "BagChain", V3(0.15, 3, 0.15), cf * CF(-2.5, 9.5, 0), C.steelLight, M.Metal)
	vcyl(f, "HomeBag", 4.4, 2, cf * CF(-2.5, 3.6, 0), Color3.fromRGB(150, 24, 30), M.Leather, { collide = true })
	part(f, "RackFrame", V3(4.4, 2.2, 1.2), cf * CF(2.8, 1.1, 2.6), C.steel, M.Metal, { collide = true })
	for k = 0, 3 do
		cyl(f, "Dumbbell", 1.3, 0.45 + k * 0.08, cf * CF(1.3 + k * 1.0, 2.45, 2.6), Color3.fromRGB(30, 30, 32), M.Metal)
	end
	if big then
		local ring = cf * CF(3, 0, -1)
		local half = 6
		part(f, "RingFloor", V3(half * 2 + 1, 1.2, half * 2 + 1), ring * CF(8, 0.6, 0), Color3.fromRGB(30, 30, 34), M.SmoothPlastic, { collide = true })
		local canvas = part(f, "RingCanvas", V3(half * 2, 0.1, half * 2), ring * CF(8, 1.25, 0), Color3.fromRGB(226, 222, 212), M.Fabric, { collide = true })
		GymDecor.Sign(canvas, Enum.NormalId.Top, "HOME OF THE CHAMP", Color3.fromRGB(150, 20, 26), nil, 10)
		for _, c in ipairs({ { -1, -1 }, { 1, -1 }, { 1, 1 }, { -1, 1 } }) do
			part(f, "RingPost", V3(0.5, 4.4, 0.5), ring * CF(8 + c[1] * half, 3.4, c[2] * half), C.red, M.SmoothPlastic, { collide = true })
		end
		for _, y in ipairs({ 2.4, 3.4, 4.4 }) do
			for _, e in ipairs({ { 0, -half, half * 2, 0 }, { 0, half, half * 2, 0 }, { -half, 0, 0, half * 2 }, { half, 0, 0, half * 2 } }) do
				part(f, "RingRope", V3(math.max(0.2, e[3]), 0.2, math.max(0.2, e[4])), ring * CF(8 + e[1], y, e[2]), Color3.fromRGB(240, 240, 240), M.Fabric)
			end
		end
	end
end

local function recoverySuite(f, cf)
	part(f, "MassageTable", V3(2.6, 0.5, 6), cf * CF(-3, 2.4, 0), Color3.fromRGB(240, 240, 236), M.Leather, { collide = true })
	for _, z in ipairs({ -2.4, 2.4 }) do
		part(f, "TableLeg", V3(2.2, 2.2, 0.3), cf * CF(-3, 1.1, z), Color3.fromRGB(200, 200, 205), M.Metal)
	end
	vcyl(f, "ColdTub", 2.6, 4, cf * CF(2, 0, -1), Color3.fromRGB(200, 205, 212), M.Metal, { collide = true })
	vcyl(f, "ColdWater", 0.1, 3.6, cf * CF(2, 2.45, -1), Color3.fromRGB(120, 200, 240), M.Glass, { transparency = 0.2 })
	part(f, "Sauna", V3(5, 7.5, 4.5), cf * CF(2, 3.75, 4.5), Color3.fromRGB(176, 120, 70), M.WoodPlanks, { collide = true })
	part(f, "SaunaDoor", V3(1.8, 5.6, 0.1), cf * CF(2, 3.0, 2.2), Color3.fromRGB(200, 170, 120), M.Glass, { transparency = 0.4 })
end

-- TV with the boxer's career on it (static until the next visit home)
local function tvWall(f, cf, w, profile)
	part(f, "TVConsole", V3(w, 1.6, 1.8), cf * CF(0, 0.8, 0), Color3.fromRGB(40, 32, 26), M.Wood, { collide = true })
	local scr = part(f, "TVScreen", V3(w * 0.75, w * 0.42, 0.2), cf * CF(0, 2.2 + w * 0.21, 0.6), Color3.fromRGB(10, 10, 14), M.Glass)
	local sg = gui(scr, Enum.NormalId.Back, 30, 0, 120)
	frame(sg, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(14, 16, 26) })
	frame(sg, { Size = UDim2.fromScale(1, 0.18), BackgroundColor3 = Color3.fromRGB(190, 20, 30) })
	label(sg, "WCB SPORTS  -  LIVE", { TextColor3 = Color3.new(1, 1, 1), Size = UDim2.fromScale(0.9, 0.14), Position = UDim2.fromScale(0.05, 0.02) })
	local id = type(profile.identity) == "table" and profile.identity or {}
	local r = profile.tier == 1 and profile.amateurRecord or profile.record
	r = type(r) == "table" and r or { w = 0, l = 0, d = 0, ko = 0 }
	label(sg, string.format("%s \"%s\"", tostring(id.name or ""), tostring(id.nickname or "")), { TextColor3 = C.gold, Size = UDim2.fromScale(0.9, 0.18), Position = UDim2.fromScale(0.05, 0.24) })
	local tier = Config.Tiers[profile.tier]
	label(sg, string.format("%s  -  %d-%d-%d (%d KO)", tier and tier.name or "", r.w or 0, r.l or 0, r.d or 0, r.ko or 0), { TextColor3 = Color3.new(1, 1, 1), Face = "signSub", Size = UDim2.fromScale(0.9, 0.12), Position = UDim2.fromScale(0.05, 0.46) })
	local nextLine = "NEXT FIGHT: TO BE ANNOUNCED"
	local camp = profile.camp
	if type(camp) == "table" and type(camp.offer) == "table" and type(camp.offer.opp) == "table" then
		nextLine = string.format("NEXT: vs %s  -  %d DAYS", tostring(camp.offer.opp.name or "?"):upper(), tonumber(camp.daysLeft) or 0)
	end
	label(sg, nextLine, { TextColor3 = Color3.fromRGB(150, 210, 255), Face = "signSub", Size = UDim2.fromScale(0.9, 0.12), Position = UDim2.fromScale(0.05, 0.64) })
	label(sg, "FANS: " .. tostring(math.floor((profile.popularity or 0) ^ 2 * 950 + (r.w or 0) * 120)), { TextColor3 = Color3.fromRGB(200, 200, 210), Face = "signSub", Size = UDim2.fromScale(0.9, 0.1), Position = UDim2.fromScale(0.05, 0.82) })
	local glow = Instance.new("PointLight")
	glow.Color, glow.Range, glow.Brightness, glow.Shadows = Color3.fromRGB(150, 180, 255), 10, 0.6, false
	glow.Parent = scr
end

local function outsideDeck(f, base, spec, pool)
	local w, d = spec.w, spec.d
	part(f, "Deck", V3(w, 1, 12), base * CF(0, -0.5, -d / 2 - 7), Color3.fromRGB(150, 116, 84), M.WoodPlanks, { collide = true })
	if pool then
		part(f, "PoolWater", V3(w * 0.55, 0.3, 6.5), base * CF(-w * 0.12, 0.02, -d / 2 - 7.5), Color3.fromRGB(60, 170, 220), M.Glass, { transparency = 0.15, reflect = 0.2 })
		part(f, "PoolEdge", V3(w * 0.55 + 1, 0.2, 7.5), base * CF(-w * 0.12, -0.05, -d / 2 - 7.5), Color3.fromRGB(230, 230, 226), M.Limestone)
		for k = 0, 1 do
			local lc = base * CF(w * 0.28 + k * 3.4, 0, -d / 2 - 7)
			part(f, "Lounger", V3(2, 0.5, 5.5), lc * CF(0, 1, 0), Color3.fromRGB(240, 240, 236), M.Fabric)
			part(f, "LoungerBack", V3(2, 0.5, 2.2), lc * CF(0, 1.8, 2.2) * ANG(RAD(50), 0, 0), Color3.fromRGB(240, 240, 236), M.Fabric)
		end
	end
	for _, x in ipairs({ -w / 2 + 2, w / 2 - 2 }) do
		GymDecor.Plant(f, (base * CF(x, 0, -d / 2 - 3)).Position, 1.1)
	end
end

local function furnish(f, base, spec, kind, profile)
	local w, d, h = spec.w, spec.d, spec.h
	local owned = type(profile.owned) == "table" and profile.owned or {}
	local id = type(profile.identity) == "table" and profile.identity or {}
	local surname = tostring(id.last or id.name or "CHAMP")
	local hist = type(profile.history) == "table" and profile.history or {}
	local belts = beltList(profile)
	local bedCF = base * CF(w / 2 - (kind == "Mansion" and 14 or 9), 0, d / 2 - 5.6)
	local bw = kind == "Mansion" and 9 or 7
	bed(f, bedCF, bw, 10, spec.sheet)
	promptPart(f, "SleepPrompt", (bedCF * CF(-bw / 2 - 2.5, 2.6, -2)).Position, "Sleep (End Day)", "Home sweet home", { Action = "Sleep" }, Color3.fromRGB(170, 170, 255))
	local lounge = base * CF(-w * 0.12, 0, -d * 0.12)
	part(f, "Rug", V3(14, 0.06, 10), lounge * CF(0, 0.03, 0), kind == "Mansion" and Color3.fromRGB(150, 120, 80) or Color3.fromRGB(120, 60, 50), M.Fabric)
	sofa(f, lounge * CF(0, 0, 4), kind == "Apartment" and 9 or 12, spec.sofa)
	part(f, "CoffeeTable", V3(5, 1.4, 2.6), lounge * CF(0, 0.7, 0.4), Color3.fromRGB(46, 36, 28), M.Wood, { collide = true })
	tvWall(f, lounge * CF(0, 0, -4.2), kind == "Mansion" and 12 or 9, profile)
	local kLen = kind == "Apartment" and 10 or 14
	kitchen(f, base * CF(-w / 2 + kLen / 2 + 4.5, 0, d / 2 - 1.6) * ANG(0, RAD(180), 0), kLen,
		kind == "Mansion" and Color3.fromRGB(30, 30, 34) or Color3.fromRGB(236, 236, 232), kind == "Mansion" and Color3.fromRGB(240, 240, 236) or Color3.fromRGB(60, 60, 64))
	for _, p in ipairs({ { -w / 2 + 2.5, -d / 2 + 2.5 }, { w / 2 - 2.5, -d / 2 + 2.5 } }) do
		GymDecor.Plant(f, (base * CF(p[1], 0, p[2])).Position, 1)
	end
	local doorCF = base * CF(-w / 2 + 0.05, 0, d / 2 - 12) * ANG(0, RAD(90), 0)
	part(f, "FrontDoor", V3(4, 8, 0.2), doorCF * CF(0, 4, 0), Color3.fromRGB(60, 40, 28), M.Wood)
	part(f, "DoorHandle", V3(0.2, 0.2, 0.5), doorCF * CF(1.4, 3.8, 0.2), C.gold, M.Metal)
	promptPart(f, "ExitPrompt", (doorCF * CF(0, 2.6, 2.5)).Position, "Go outside", kind, { Action = "LeaveHome" }, Color3.fromRGB(255, 230, 170))
	local nPosters = kind == "Apartment" and 2 or (kind == "House" and 3 or 4)
	local posterY = kind == "Mansion" and 5 or h * 0.45
	for k = 0, nPosters - 1 do
		local e = hist[#hist - k]
		if type(e) == "table" then
			fightPoster(f, base * CF(-2 - (nPosters - 1) * 2.2 + k * 4.4, posterY, d / 2 - 0.1), e, surname)
		end
	end
	if #belts > 0 and not owned.TrophyRoom then
		local shelf = base * CF(w / 2 - 0.4, h * 0.42, -d * 0.1) * ANG(0, RAD(90), 0)
		part(f, "BeltShelf", V3(#belts * 4 + 1, 0.3, 1.4), shelf * CF(0, -0.6, -0.3), Color3.fromRGB(40, 30, 24), M.Wood)
		for i, b in ipairs(belts) do
			belt(f, shelf * CF(-(#belts - 1) * 2 + (i - 1) * 4, 0.3, -0.4), b)
		end
		spot(emitter(f, shelf * CF(0, 3, -2)), Enum.NormalId.Bottom, Color3.fromRGB(255, 230, 180), 10, 1.2, 70)
	end
	if owned.HomeGym then
		if kind == "Mansion" then
			homeGym(f, base * CF(w / 2 - 20, 0, -d / 2 + 9), true)
		else
			homeGym(f, base * CF(w / 2 - 9, 0, -d / 2 + 7), false)
		end
	end
	if owned.RecoverySuite and kind ~= "Apartment" then
		recoverySuite(f, base * CF(-w / 2 + 6, 0, -d / 2 + 6))
	end
	if owned.TrophyRoom and kind ~= "Apartment" then
		local tr = base * CF(-w * 0.32, 0, 2)
		part(f, "TrophyCabinet", V3(14, 9, 2), tr * CF(0, 4.5, 0), Color3.fromRGB(40, 30, 24), M.Wood, { collide = true })
		part(f, "CabinetGlass", V3(13, 7.6, 0.1), tr * CF(0, 4.8, -1.05), Color3.fromRGB(210, 230, 245), M.Glass, { transparency = 0.7 })
		for i, b in ipairs(belts) do
			belt(f, tr * CF(-5 + ((i - 1) % 3) * 5, 6.8 - math.floor((i - 1) / 3) * 2.6, -0.6), b)
		end
		for k = 0, math.min(4, math.max(1, tonumber(profile.titlesWon) or 0)) - 1 do
			trophy(f, tr * CF(-5 + k * 2.6, 1.2, -0.4), 2.2, C.gold)
		end
		local plaque = part(f, "LegacyPlaque", V3(6, 1.2, 0.1), tr * CF(0, 9.8, -1.05), C.gold, M.Metal)
		GymDecor.Sign(plaque, Enum.NormalId.Front, string.format("%s - %d TITLE%s", surname:upper(), tonumber(profile.titlesWon) or 0, (tonumber(profile.titlesWon) or 0) == 1 and "" or "S"), Color3.fromRGB(40, 28, 10), C.gold, 40)
		spot(emitter(f, tr * CF(0, h - 1.5, -4)), Enum.NormalId.Bottom, Color3.fromRGB(255, 228, 180), 16, 1.4, 70)
	end
	outsideDeck(f, base, spec, owned.PoolDeck == true and kind ~= "Apartment")
	if kind == "Mansion" then
		local ch = base * CF(0, h - 3.5, 0)
		ball(f, "ChandelierCore", 1.4, ch, Color3.fromRGB(255, 236, 190), M.Neon, { shadow = false })
		for k = 0, 9 do
			local a = k * math.pi / 5
			ball(f, "ChandelierCrystal", 0.6, ch * CF(math.cos(a) * 2.6, -0.6 - (k % 2) * 0.5, math.sin(a) * 2.6), Color3.fromRGB(240, 246, 255), M.Glass, { transparency = 0.2, reflect = 0.3 })
		end
		point(emitter(f, ch * CF(0, -1, 0)), Color3.fromRGB(255, 228, 190), 34, 1.2)
		for _, sx in ipairs({ -1, 1 }) do
			local stairX = sx < 0 and -(w / 2 - 12) or (w / 2 - 4)
			for k = 0, 10 do
				part(f, "Stair", V3(5, 0.8, 1.6), base * CF(stairX, 0.4 + k * 0.95, d / 2 - 26 + k * 1.6), Color3.fromRGB(236, 232, 224), M.Marble, { collide = true })
			end
		end
		part(f, "Mezzanine", V3(w, 0.8, 10), base * CF(0, 10, d / 2 - 5), Color3.fromRGB(236, 232, 224), M.Marble, { collide = true })
		part(f, "MezzanineRail", V3(w - 16, 1.6, 0.2), base * CF(0, 11.2, d / 2 - 10), Color3.fromRGB(200, 225, 240), M.Glass, { transparency = 0.5 })
		local cin = base * CF(w * 0.3, 0, d * 0.05)
		local scr = part(f, "CinemaScreen", V3(14, 7, 0.2), cin * CF(0, 7, -9), Color3.fromRGB(10, 10, 12), M.SmoothPlastic)
		local best = hist[#hist]
		GymDecor.PosterGui(scr, Enum.NormalId.Back, {
			bg = Color3.fromRGB(10, 10, 14), accent = C.gold, top = "NOW SHOWING", title = best and string.format("%s\nvs\n%s", surname:upper(), (tostring(best.opp):match("(%S+)$") or "?"):upper()) or "THE COMEBACK",
			sub = best and string.format("%s - %s", tostring(best.outcome or ""):upper(), tostring(best.method or "")) or "COMING SOON", foot = "THE " .. surname:upper() .. " STORY",
		})
		for row = 0, 1 do
			for k = -1, 1 do
				local sc = cin * CF(k * 3.4, row * 0.6, -1 + row * 4)
				part(f, "Recliner", V3(2.8, 1.6, 2.8), sc * CF(0, 0.8, 0), Color3.fromRGB(30, 30, 34), M.Leather, { collide = true })
				part(f, "ReclinerBack", V3(2.8, 2.4, 0.8), sc * CF(0, 2, 1.3), Color3.fromRGB(30, 30, 34), M.Leather)
			end
		end
	elseif kind == "House" then
		local fp = base * CF(-w / 2 + 0.9, 0, -d * 0.12) * ANG(0, RAD(-90), 0)
		part(f, "Fireplace", V3(7, 6, 1.6), fp * CF(0, 3, 0), Color3.fromRGB(150, 140, 130), M.Cobblestone, { collide = true })
		part(f, "Firebox", V3(3.6, 2.6, 0.4), fp * CF(0, 1.6, -0.7), Color3.fromRGB(20, 18, 16), M.SmoothPlastic)
		local fire = part(f, "Hearth", V3(2.4, 0.4, 0.4), fp * CF(0, 0.7, -0.9), Color3.fromRGB(255, 120, 40), M.Neon, { shadow = false })
		point(fire, Color3.fromRGB(255, 150, 70), 14, 1)
		part(f, "Mantel", V3(8, 0.4, 2), fp * CF(0, 6.2, -0.2), Color3.fromRGB(80, 56, 38), M.Wood)
		part(f, "DiningTable", V3(7, 0.3, 3.6), base * CF(-12, 3, 9), Color3.fromRGB(110, 76, 48), M.Wood, { collide = true })
		for _, x in ipairs({ -2.4, 0, 2.4 }) do
			for _, z in ipairs({ -2.4, 2.4 }) do
				part(f, "DiningChair", V3(1.6, 2.6, 1.6), base * CF(-12 + x, 1.3, 9 + z), Color3.fromRGB(80, 56, 38), M.Wood, { collide = true })
			end
		end
	end
	local first = hist[1]
	if type(first) == "table" then
		fightPoster(f, base * CF(-w / 2 + 0.1, h * 0.45, -d * 0.3) * ANG(0, RAD(-90), 0), first, surname)
	end
end

local function homeSig(profile, kind)
	local owned = type(profile.owned) == "table" and profile.owned or {}
	local hist = type(profile.history) == "table" and profile.history or {}
	local r = type(profile.record) == "table" and profile.record or {}
	local camp = type(profile.camp) == "table" and type(profile.camp.offer) == "table" and profile.camp.offer.oppId or ""
	local addons = {}
	for _, id in ipairs({ "HomeGym", "TrophyRoom", "RecoverySuite", "PoolDeck", "Garage" }) do
		table.insert(addons, owned[id] and "1" or "0")
	end
	return table.concat({ kind, table.concat(addons), table.concat(beltList(profile), ","), tostring(profile.titlesWon), tostring(#hist),
		tostring(r.w) .. "-" .. tostring(r.l), tostring(camp), tostring(profile.tier), tostring(math.floor((profile.popularity or 0) / 5)) }, "|")
end

local function releaseHome(player)
	local h = homes[player]
	homes[player] = nil
	if h then
		if h.model then
			h.model:Destroy()
		end
		homeSlots[h.slot] = nil
	end
end
CityHomes.Release = releaseHome
Players.PlayerRemoving:Connect(releaseHome)

-- builds (or reuses) the player's interior and returns the spawn CFrame inside the front door
function CityHomes.Enter(player, profile, kind)
	kind = homeKindFor(profile, kind)
	if not kind then
		return nil, "You don't own a home yet. Buy one in the Shop (Houses)."
	end
	if not homesFolder then
		return nil, "The city isn't ready."
	end
	local h = homes[player]
	local sig = homeSig(profile, kind)
	local live = h and h.model and h.model.Parent
	if live and h.sig == sig then
		return h.spawn, kind
	end
	local now = os.clock()
	local tokens = REBUILD_BURST
	if h and h.tokens then
		tokens = math.min(REBUILD_BURST, h.tokens + (now - (h.tokAt or now)) / REBUILD_GAP)
	end
	if live and tokens < 1 then
		h.tokens, h.tokAt = tokens, now
		if h.kind == kind then
			return h.spawn, kind
		end
		return nil, "Hold on - you just moved. Try again in a moment."
	end
	tokens = math.max(0, tokens - 1)
	local slot = h and h.slot
	if not slot then
		slot = 1
		while homeSlots[slot] do
			slot += 1
		end
		homeSlots[slot] = player
	end
	if h and h.model then
		h.model:Destroy()
	end
	local spec = HOME_SPEC[kind]
	local base = CF(-3000 - (slot - 1) * 400, 40, -3000)
	local m = Instance.new("Model")
	m.Name = "Home_" .. tostring(player.UserId)
	m:SetAttribute("Owner", player.UserId)
	m:SetAttribute("Kind", kind)
	homeShell(m, base, spec)
	local ok, err = pcall(furnish, m, base, spec, kind, profile)
	if not ok then
		warn("[CityHomes] furnishing failed: " .. tostring(err))
	end
	m.Parent = homesFolder
	local spawnCF = CFrame.lookAt((base * CF(-spec.w / 2 + 4, 3.2, spec.d / 2 - 12)).Position, (base * CF(0, 3.2, 0)).Position)
	homes[player] = { model = m, kind = kind, sig = sig, spawn = spawnCF, slot = slot, tokens = tokens, tokAt = now }
	return spawnCF, kind
end

-- the kind of the home the player is in (nil when not at home)
function CityHomes.Current(player)
	local h = homes[player]
	return h and h.kind or nil
end

return CityHomes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="92">
        <Properties>
          <string name="Name">CityKit</string>
          <string name="Source"><![CDATA[-- CityKit: the pieces the town is built from, at real-world scale for the R15 rig (Config.City:
-- 1 stud = 0.28 m). Roads with kerbs, gutters, markings and sidewalks; street lights (8-9 m) and
-- traffic signals (5 m) with mast arms; cars, vans, pickups and a bus at 4.5 x 1.6 x 1.5 m; trees
-- of six kinds (8-15 m); street furniture (benches, bins, hydrants, planters, bollards, bus
-- shelters, bike racks, vendor carts); fences and walls; parking lots with 2.7 x 5 m bays;
-- generic buildings (storefront, storeys, cornice, roof units) and skyline towers; billboards;
-- the invisible anchors (sites, prompts, light zones) the client and the travel code find by name.
-- Every builder takes its parent first and returns the model or the main part.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GymDecor = require(script.Parent:WaitForChild("GymDecor"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Signage = require(Shared:WaitForChild("Signage"))

local K = {}

local V3 = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local RAD = math.rad
local M = Enum.Material

local part = GymDecor.Part
local cyl = GymDecor.Cyl
local vcyl = GymDecor.VCyl
local ball = GymDecor.Ball
local blob = GymDecor.Blob
local label = GymDecor.Label
local frame = GymDecor.Frame
local spot = GymDecor.Spot
local point = GymDecor.Point
local emitter = GymDecor.Emitter
local tag = GymDecor.Tag
local C = GymDecor.Colors

K.part, K.cyl, K.vcyl, K.ball, K.blob, K.label, K.frame, K.spot, K.point, K.emitter, K.tag = part, cyl, vcyl, ball, blob, label, frame, spot, point, emitter, tag
K.rod = GymDecor.Rod
K.sign = GymDecor.Sign
K.C = C
K.V3, K.CF, K.ANG, K.RAD, K.M = V3, CF, ANG, RAD, M

local CITY = Config.City
K.CITY = CITY
K.ROAD_Y = CITY.RoadY -- 0.3
K.SW_H = CITY.SidewalkY -- 0.8
K.MARK_Y = CITY.RoadY + 0.012 -- road paint

K.ASPHALT = Color3.fromRGB(56, 56, 60)
K.ASPHALT_OLD = Color3.fromRGB(74, 74, 78)
K.SIDEWALK = Color3.fromRGB(178, 176, 168)
K.PAVING = Color3.fromRGB(196, 186, 170)
K.KERB = Color3.fromRGB(200, 198, 190)
K.GUTTER = Color3.fromRGB(44, 44, 48)
K.LINE_YELLOW = Color3.fromRGB(240, 204, 74)
K.LINE_WHITE = Color3.fromRGB(236, 236, 230)
K.POLE = Color3.fromRGB(46, 48, 54)
K.LENS_DAY = Color3.fromRGB(200, 200, 196)
K.GRASS = Color3.fromRGB(94, 140, 72)
K.GRASS_DRY = Color3.fromRGB(118, 146, 74)
K.GRASS_DARK = Color3.fromRGB(78, 124, 64)
K.SOIL = Color3.fromRGB(78, 58, 40)
K.WATER = Color3.fromRGB(52, 120, 168)

local ASPHALT, SIDEWALK, KERB, LINE_YELLOW, LINE_WHITE, POLE, LENS_DAY = K.ASPHALT, K.SIDEWALK, K.KERB, K.LINE_YELLOW, K.LINE_WHITE, K.POLE, K.LENS_DAY
local ROAD_Y, SW_H, MARK_Y = K.ROAD_Y, K.SW_H, K.MARK_Y

function K.folder(parent, name)
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

function K.model(parent, name)
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end
local folder, model = K.folder, K.model

function K.gui(p, face, ppu, light, maxDist)
	local sg = Instance.new("SurfaceGui")
	sg.Face = face
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = ppu or 20
	sg.LightInfluence = light or 0
	sg.MaxDistance = maxDist or 600
	sg.Parent = p
	return sg
end
local gui = K.gui

------------------------------------------------------------------------
-- anchors: sites (client builds and travel targets), prompts, light zones, lights
------------------------------------------------------------------------
local sitesFolder
K.Sites = {} -- name -> CFrame
function K.Init(sites)
	sitesFolder = sites
end

-- City/Sites/Site_<name> with attribute Site = name (CityVisuals.siteCF, CityMap.TravelCFrame)
function K.site(name, cf, attrs)
	local p = part(sitesFolder, "Site_" .. name, V3(1, 1, 1), cf, Color3.new(), M.SmoothPlastic, { transparency = 1, shadow = false })
	p:SetAttribute("Site", name)
	for k, v in pairs(attrs or {}) do
		p:SetAttribute(k, v)
	end
	K.Sites[name] = cf
	return p
end

-- a prompt on an invisible part with a floating label (MapBuilder.buildAction's contract: attribute
-- Action on the ProximityPrompt, dispatched by the client)
function K.promptPart(parent, name, pos, actionText, objectText, attrs, labelColor)
	local p = part(parent, name, V3(1, 1, 1), CF(pos), Color3.new(), M.SmoothPlastic, { transparency = 1, shadow = false })
	local pp = Instance.new("ProximityPrompt")
	pp.ActionText = actionText
	pp.ObjectText = objectText or ""
	pp.HoldDuration = 0
	pp.MaxActivationDistance = 10
	pp.RequiresLineOfSight = false
	for k, v in pairs(attrs or {}) do
		pp:SetAttribute(k, v)
	end
	pp.Parent = p
	local bb = Instance.new("BillboardGui")
	bb.Name = "PromptLabel"
	bb.Size = UDim2.fromOffset(220, 40)
	bb.StudsOffset = V3(0, 2.6, 0)
	bb.MaxDistance = 50
	bb.Adornee = p
	label(bb, actionText, { TextColor3 = labelColor or Color3.fromRGB(120, 220, 255), TextStrokeTransparency = 0.3 })
	bb.Parent = p
	return p, pp
end

-- invisible boxes tagged LightZone: the client grades the picture for the zone the camera is in
function K.lightZone(parent, name, size, cf, profile)
	local p = part(parent, name, size, cf, Color3.new(), M.SmoothPlastic, { transparency = 1, shadow = false })
	p.CanQuery = false
	p:SetAttribute("Profile", profile)
	tag(p, "LightZone")
	return p
end

-- a light that is always on (interiors are under a roof: Future lighting leaves them dark by day)
function K.roomLight(parent, cf, color, range, brightness)
	return point(emitter(parent, cf), color or Color3.fromRGB(255, 236, 210), (range or 18) * 1.15, (brightness or 1.1) * 1.3)
end

-- a light that comes on at dusk (Ambience switches every NightLight)
function K.nightPoint(parent, cf, color, range, brightness)
	local l = point(emitter(parent, cf), color or Color3.fromRGB(255, 214, 160), range or 14, brightness or 1)
	l.Enabled = false
	tag(l, "NightLight")
	return l
end

-- glowing neon outline around a rectangle (cf faces the viewer with its -Z)
function K.neonOutline(parent, cf, w, h, color)
	local m = model(parent, "NeonOutline")
	local t = 0.22
	for _, e in ipairs({ { 0, h / 2, w + t, t }, { 0, -h / 2, w + t, t }, { -w / 2, 0, t, h }, { w / 2, 0, t, h } }) do
		part(m, "NeonTube", V3(e[3], e[4], t), cf * CF(e[1], e[2], 0), color, M.Neon, { shadow = false })
	end
	tag(m, "NeonFlicker")
	return m
end

-- window grid spec on one face (drawn by the client: CityVisuals.windowGrids / CityDetail); rows/cols
-- fill the band y0..y1 of a face faceH tall. range = the client's draw range (nil: its default)
function K.windowGrid(p, face, faceH, y0, y1, rows, cols, rng, litChance, range)
	p:SetAttribute("WinFace", face.Name)
	if range then
		p:SetAttribute("WinRange", range)
	end
	p:SetAttribute("WinTop", 1 - y1 / faceH)
	p:SetAttribute("WinSpan", (y1 - y0) / faceH)
	p:SetAttribute("WinRows", rows)
	p:SetAttribute("WinCols", cols)
	p:SetAttribute("WinLit", litChance or 0.35)
	p:SetAttribute("WinSeed", rng:NextInteger(1, 1000000))
	return p
end

------------------------------------------------------------------------
-- ground: slabs, lawns, water
------------------------------------------------------------------------
-- flat slab x1..x2, z1..z2 from y bottom (0) to top
function K.slab(parent, name, x1, x2, z1, z2, top, color, material, collide, bottom)
	bottom = bottom or 0
	return part(parent, name, V3(x2 - x1, top - bottom, z2 - z1), CF((x1 + x2) / 2, (top + bottom) / 2, (z1 + z2) / 2), color, material, { collide = collide ~= false })
end
local slab = K.slab

-- a lawn a hair above the ground, with a couple of tone patches and (opts.beds) flower beds
function K.lawn(parent, x1, x2, z1, z2, rng, opts)
	opts = opts or {}
	local top = opts.top or 0.14
	local base = slab(parent, "Lawn", x1, x2, z1, z2, top, opts.color or K.GRASS, opts.material or M.Grass, true)
	if rng then
		local w, d = x2 - x1, z2 - z1
		for k = 1, opts.patches or 2 do
			local pw, pd = rng:NextNumber(w * 0.2, w * 0.45), rng:NextNumber(d * 0.2, d * 0.45)
			local px, pz = rng:NextNumber(x1 + pw / 2, x2 - pw / 2), rng:NextNumber(z1 + pd / 2, z2 - pd / 2)
			local tone = ({ K.GRASS_DRY, K.GRASS_DARK, Color3.fromRGB(104, 150, 78) })[rng:NextInteger(1, 3)]
			-- (each patch a hair higher than the last: overlapping patches never share a face)
			part(parent, "LawnPatch", V3(pw, 0.04, pd), CF(px, top + 0.03 + k * 0.012, pz), tone, M.Grass, { shadow = false })
		end
	end
	return base
end

-- a flower bed: soil strip with a row of blooms
function K.flowerBed(parent, cf, len, w, rng)
	part(parent, "BedSoil", V3(len, 0.3, w), cf * CF(0, 0.15, 0), K.SOIL, M.Ground)
	local cols = { Color3.fromRGB(230, 70, 90), Color3.fromRGB(250, 200, 60), Color3.fromRGB(240, 120, 160), Color3.fromRGB(240, 240, 240), Color3.fromRGB(200, 80, 200) }
	local n = math.max(2, math.floor(len / 3))
	for k = 0, n - 1 do
		local x = -len / 2 + (k + 0.5) * len / n
		blob(parent, "Blooms", V3(len / n * 0.9, 1.1, w * 0.85), cf * CF(x, 0.75, 0), cols[(rng and rng:NextInteger(1, #cols)) or (k % #cols + 1)], M.Grass, { shadow = false })
	end
end

-- a hedge along local X of cf (centre at the base)
function K.hedge(parent, cf, len, h, w, color)
	return blob(parent, "Hedge", V3(len, h or 3.2, w or 2.6), cf * CF(0, (h or 3.2) / 2, 0), color or Color3.fromRGB(50, 110, 55), M.Grass)
end

-- water: Terrain water where the engine has it, a surface part where it does not (the simulator)
function K.water(parent, x1, x2, z1, z2, surfaceY, depth)
	depth = depth or 7
	slab(parent, "RiverBed", x1, x2, z1, z2, surfaceY - depth, Color3.fromRGB(40, 60, 54), M.Mud, true, surfaceY - depth - 1)
	local ok = pcall(function()
		workspace.Terrain:FillBlock(CF((x1 + x2) / 2, surfaceY - depth / 2, (z1 + z2) / 2), V3(x2 - x1, depth, z2 - z1), Enum.Material.Water)
	end)
	if not ok then
		part(parent, "WaterSurface", V3(x2 - x1, 0.4, z2 - z1), CF((x1 + x2) / 2, surfaceY - 0.2, (z1 + z2) / 2), K.WATER, M.Glass, { transparency = 0.15, reflect = 0.25, shadow = false })
	end
end

------------------------------------------------------------------------
-- roads: asphalt with kerbs and gutters, centre lines, sidewalks; markings
------------------------------------------------------------------------
-- a run of dashes along X at z (len / gap in studs)
function K.dashesX(parent, x1, x2, z, color, len, gap, w, name)
	len, gap, w = len or 10, gap or 20, w or 0.5
	local x = x1 + gap / 2
	while x + len <= x2 do
		part(parent, name or "LaneDash", V3(len, 0.03, w), CF(x + len / 2, MARK_Y, z), color or LINE_YELLOW, M.SmoothPlastic, { shadow = false })
		x += len + gap
	end
end

function K.dashesZ(parent, z1, z2, x, color, len, gap, w, name)
	len, gap, w = len or 10, gap or 20, w or 0.5
	local z = z1 + gap / 2
	while z + len <= z2 do
		part(parent, name or "LaneDash", V3(w, 0.03, len), CF(x, MARK_Y, z + len / 2), color or LINE_YELLOW, M.SmoothPlastic, { shadow = false })
		z += len + gap
	end
end

function K.lineX(parent, x1, x2, z, color, w, name)
	return part(parent, name or "LaneLine", V3(x2 - x1, 0.03, w or 0.5), CF((x1 + x2) / 2, MARK_Y, z), color or LINE_WHITE, M.SmoothPlastic, { shadow = false })
end

function K.lineZ(parent, z1, z2, x, color, w, name)
	return part(parent, name or "LaneLine", V3(w or 0.5, 0.03, z2 - z1), CF(x, MARK_Y, (z1 + z2) / 2), color or LINE_WHITE, M.SmoothPlastic, { shadow = false })
end

-- zebra crossing: 2-stud bars with 2-stud gaps, stacked across the road (bars run with the traffic)
function K.crosswalk(parent, center, alongX, roadWidth, bandWidth)
	bandWidth = bandWidth or 8
	local n = math.floor((roadWidth - 1) / 4)
	for i = 0, n - 1 do
		local o = -(n - 1) * 2 + i * 4
		if alongX then
			part(parent, "Crosswalk", V3(bandWidth, 0.03, 2.0), CF(center.X, MARK_Y + 0.004, center.Z + o), LINE_WHITE, M.SmoothPlastic, { shadow = false })
		else
			part(parent, "Crosswalk", V3(2.0, 0.03, bandWidth), CF(center.X + o, MARK_Y + 0.004, center.Z), LINE_WHITE, M.SmoothPlastic, { shadow = false })
		end
	end
end

-- a stop bar across one lane: at pos, across = the lane's width direction (unit vector)
function K.stopBar(parent, pos, across, laneW)
	local a = across * (laneW or 12) / 2
	local cf = CFrame.lookAt(pos - a, pos + a)
	return part(parent, "StopBar", V3(1.2, 0.03, (laneW or 12)), CF(pos.X, MARK_Y + 0.004, pos.Z) * (cf - cf.Position), LINE_WHITE, M.SmoothPlastic, { shadow = false })
end

-- a lane arrow at pos pointing along dir (unit vector): shaft + head
function K.laneArrow(parent, pos, dir)
	local cf = CFrame.lookAt(V3(pos.X, MARK_Y + 0.004, pos.Z), V3(pos.X, MARK_Y + 0.004, pos.Z) + dir)
	part(parent, "LaneArrow", V3(0.6, 0.03, 7), cf * CF(0, 0, 1.5), LINE_WHITE, M.SmoothPlastic, { shadow = false })
	part(parent, "LaneArrowHead", V3(2.6, 0.03, 0.8), cf * CF(0, 0, -2.2), LINE_WHITE, M.SmoothPlastic, { shadow = false })
	part(parent, "LaneArrowHead", V3(1.6, 0.03, 0.8), cf * CF(0, 0, -3.0), LINE_WHITE, M.SmoothPlastic, { shadow = false })
	part(parent, "LaneArrowHead", V3(0.8, 0.03, 0.8), cf * CF(0, 0, -3.8), LINE_WHITE, M.SmoothPlastic, { shadow = false })
end

-- splits [a, b] by the gaps { {g1, g2}, ... } into the kept intervals
local function cutRanges(a, b, gaps)
	local out = { { a, b } }
	for _, g in ipairs(gaps or {}) do
		local nxt = {}
		for _, r in ipairs(out) do
			if g[2] <= r[1] or g[1] >= r[2] then
				table.insert(nxt, r)
			else
				if g[1] > r[1] + 0.05 then
					table.insert(nxt, { r[1], g[1] })
				end
				if g[2] < r[2] - 0.05 then
					table.insert(nxt, { g[2], r[2] })
				end
			end
		end
		out = nxt
	end
	return out
end
K.cutRanges = cutRanges

-- the gaps of both lists together (either may be nil)
function K.joinGaps(a, b)
	local out = {}
	for _, g in ipairs(a or {}) do
		table.insert(out, g)
	end
	for _, g in ipairs(b or {}) do
		table.insert(out, g)
	end
	return out
end

-- a road along X: centre z, width w, from x1 to x2.
-- opts: kerbs (default true), sw = { n = width, s = width } sidewalks on the north (-Z) / south (+Z) side,
-- center = "dash" | "double" | "none" (default dash, yellow), lanes (default 2: white dashes between
-- same-direction lanes when 4), gaps = { {x, x} } where the kerbs, sidewalks and lines break (junctions),
-- swGaps (sidewalk-only breaks), y (asphalt top, default ROAD_Y), color, name, lineColor
function K.roadX(parent, name, x1, x2, zc, w, opts)
	opts = opts or {}
	local y = opts.y or ROAD_Y
	local f = parent
	slab(f, name or "Road", x1, x2, zc - w / 2, zc + w / 2, y, opts.color or ASPHALT, M.Asphalt)
	local gaps = opts.gaps or {}
	local kerbs = opts.kerbs ~= false
	for _, side in ipairs({ -1, 1 }) do
		local edge = zc + side * w / 2
		local swW = opts.sw and (side < 0 and opts.sw.n or opts.sw.s) or 0
		local sideGaps = K.joinGaps(gaps, side < 0 and opts.gapsN or opts.gapsS)
		for _, r in ipairs(cutRanges(x1, x2, sideGaps)) do
			if kerbs then
				part(f, "Kerb", V3(r[2] - r[1], SW_H - y, 0.6), CF((r[1] + r[2]) / 2, (SW_H + y) / 2, edge + side * 0.3), KERB, M.Concrete, { collide = true })
				part(f, "Gutter", V3(r[2] - r[1], 0.02, 1.4), CF((r[1] + r[2]) / 2, y + 0.01, edge - side * 0.7), K.GUTTER, M.Asphalt, { shadow = false })
			end
		end
		if swW > 0 then
			for _, r in ipairs(cutRanges(x1, x2, opts.swGaps or sideGaps)) do
				local z1, z2 = edge + side * 0.6, edge + side * (0.6 + swW)
				slab(f, "Sidewalk", r[1], r[2], math.min(z1, z2), math.max(z1, z2), SW_H, opts.swColor or SIDEWALK, M.Concrete)
			end
		end
	end
	local center = opts.center or "dash"
	local lineColor = opts.lineColor or LINE_YELLOW
	for _, r in ipairs(cutRanges(x1, x2, gaps)) do
		if center == "dash" then
			K.dashesX(f, r[1], r[2], zc, lineColor)
		elseif center == "double" then
			K.lineX(f, r[1], r[2], zc - 0.5, lineColor, 0.4, "CenterLine")
			K.lineX(f, r[1], r[2], zc + 0.5, lineColor, 0.4, "CenterLine")
		end
		if (opts.lanes or 2) >= 4 then
			local lw = w / opts.lanes
			K.dashesX(f, r[1], r[2], zc - lw, LINE_WHITE, 8, 16, 0.4)
			K.dashesX(f, r[1], r[2], zc + lw, LINE_WHITE, 8, 16, 0.4)
		end
	end
end

function K.roadZ(parent, name, z1, z2, xc, w, opts)
	opts = opts or {}
	local y = opts.y or ROAD_Y
	local f = parent
	slab(f, name or "Road", xc - w / 2, xc + w / 2, z1, z2, y, opts.color or ASPHALT, M.Asphalt)
	local gaps = opts.gaps or {}
	local kerbs = opts.kerbs ~= false
	for _, side in ipairs({ -1, 1 }) do
		local edge = xc + side * w / 2
		local swW = opts.sw and (side < 0 and opts.sw.w or opts.sw.e) or 0
		local sideGaps = K.joinGaps(gaps, side < 0 and opts.gapsW or opts.gapsE)
		for _, r in ipairs(cutRanges(z1, z2, sideGaps)) do
			if kerbs then
				part(f, "Kerb", V3(0.6, SW_H - y, r[2] - r[1]), CF(edge + side * 0.3, (SW_H + y) / 2, (r[1] + r[2]) / 2), KERB, M.Concrete, { collide = true })
				part(f, "Gutter", V3(1.4, 0.02, r[2] - r[1]), CF(edge - side * 0.7, y + 0.01, (r[1] + r[2]) / 2), K.GUTTER, M.Asphalt, { shadow = false })
			end
		end
		if swW > 0 then
			for _, r in ipairs(cutRanges(z1, z2, opts.swGaps or sideGaps)) do
				local xa, xb = edge + side * 0.6, edge + side * (0.6 + swW)
				slab(f, "Sidewalk", math.min(xa, xb), math.max(xa, xb), r[1], r[2], SW_H, opts.swColor or SIDEWALK, M.Concrete)
			end
		end
	end
	local center = opts.center or "dash"
	local lineColor = opts.lineColor or LINE_YELLOW
	for _, r in ipairs(cutRanges(z1, z2, gaps)) do
		if center == "dash" then
			K.dashesZ(f, r[1], r[2], xc, lineColor)
		elseif center == "double" then
			K.lineZ(f, r[1], r[2], xc - 0.5, lineColor, 0.4, "CenterLine")
			K.lineZ(f, r[1], r[2], xc + 0.5, lineColor, 0.4, "CenterLine")
		end
		if (opts.lanes or 2) >= 4 then
			local lw = w / opts.lanes
			K.dashesZ(f, r[1], r[2], xc - lw, LINE_WHITE, 8, 16, 0.4)
			K.dashesZ(f, r[1], r[2], xc + lw, LINE_WHITE, 8, 16, 0.4)
		end
	end
end

-- a kerb ramp (dropped kerb) is just a gap: the sidewalk and road meet flush through a short wedge
function K.kerbRamp(parent, pos, dir, w)
	local cf = CFrame.lookAt(V3(pos.X, (ROAD_Y + SW_H) / 2, pos.Z), V3(pos.X, (ROAD_Y + SW_H) / 2, pos.Z) + dir)
	return part(parent, "KerbRamp", V3(w or 6, SW_H - ROAD_Y, 2.4), cf, SIDEWALK, M.Concrete, { class = "WedgePart", collide = true })
end

------------------------------------------------------------------------
-- street lights and traffic signals
------------------------------------------------------------------------
-- street light standing at base; dir = horizontal unit vector from the pole out over the road
-- h: pole height (default Config.City.StreetLight = 30 = 8.4 m)
function K.streetLight(parent, base, dir, withLight, h)
	h = h or CITY.StreetLight
	local arm = h > 25 and 9 or 6.5
	local m = model(parent, "StreetLight")
	part(m, "LightBase", V3(1.6, 0.9, 1.6), CF(base + V3(0, 0.45, 0)), C.steel, M.Concrete, { collide = true })
	vcyl(m, "LightPole", h * 0.55, 0.8, CF(base), POLE, M.Metal, { collide = true })
	vcyl(m, "LightPoleUpper", h * 0.45 + 0.2, 0.6, CF(base + V3(0, h * 0.55 - 0.2, 0)), POLE, M.Metal)
	local a = base + V3(0, h - 0.6, 0)
	local armEnd = a + dir * arm + V3(0, 0.9, 0)
	K.rod(m, "LightArm", a, armEnd, 0.42, POLE, M.Metal)
	local head = part(m, "LightHead", V3(1.4, 0.7, 3.2), CFrame.lookAt(armEnd + dir * 0.6, armEnd + dir * 1.6), POLE, M.Metal)
	local lens = part(m, "LightLens", V3(1.1, 0.1, 2.6), head.CFrame * CF(0, -0.38, 0), LENS_DAY, M.SmoothPlastic, { shadow = false })
	tag(lens, "NightLens")
	if withLight then
		local l = spot(emitter(m, head.CFrame * CF(0, -1.0, 0)), Enum.NormalId.Bottom, Color3.fromRGB(255, 224, 180), h * 2.2, 2.4, 135)
		l.Enabled = false
		tag(l, "NightLight")
	end
	return m
end

-- a small park / garden lamp (3.5 m): pole, lantern head, a warm pool after dark
function K.parkLamp(parent, base, withLight)
	local m = model(parent, "ParkLamp")
	vcyl(m, "LampPole", 11, 0.5, CF(base), Color3.fromRGB(30, 32, 36), M.Metal, { collide = true })
	part(m, "LampHead", V3(1.6, 1.8, 1.6), CF(base + V3(0, 11.9, 0)), Color3.fromRGB(30, 32, 36), M.Metal)
	local lens = part(m, "LampLens", V3(1.2, 1.2, 1.2), CF(base + V3(0, 11.7, 0)), LENS_DAY, M.SmoothPlastic, { shadow = false })
	tag(lens, "NightLens")
	part(m, "LampCap", V3(2.0, 0.4, 2.0), CF(base + V3(0, 12.9, 0)), Color3.fromRGB(30, 32, 36), M.Metal)
	if withLight then
		K.nightPoint(m, CF(base + V3(0, 11.2, 0)), Color3.fromRGB(255, 220, 170), 30, 1.2)
	end
	return m
end

-- a traffic signal on a mast arm: pole at base, arm `reach` along dir over the road, two heads facing
-- `face` (towards the traffic they govern), a walk signal, a street-name blade, a controller cabinet
function K.trafficSignal(parent, base, dir, reach, face, streetName)
	local m = model(parent, "TrafficSignal")
	local h = CITY.Signal + 2 -- 20 studs = 5.6 m to the arm
	vcyl(m, "SignalPole", h, 0.9, CF(base), POLE, M.Metal, { collide = true })
	vcyl(m, "SignalFoot", 0.6, 1.6, CF(base), POLE, M.Metal, { collide = true })
	local armY = base.Y + h - 0.6
	local top = V3(base.X, armY, base.Z)
	local tip = top + dir * reach
	K.rod(m, "SignalArm", top, tip, 0.55, POLE, M.Metal)
	K.rod(m, "SignalBrace", V3(base.X, armY - 3.5, base.Z), top + dir * (reach * 0.45), 0.22, POLE, M.Metal)
	for _, fr in ipairs({ 0.55, 0.95 }) do
		local at = top:Lerp(tip, fr) - V3(0, 3.0, 0)
		local cf = CFrame.lookAt(at, at + face)
		part(m, "SignalHead", V3(1.5, 4.6, 1.3), cf, Color3.fromRGB(40, 40, 36), M.Metal)
		part(m, "SignalBack", V3(2.3, 5.4, 0.12), cf * CF(0, 0, 0.72), C.black, M.SmoothPlastic)
		part(m, "SignalHanger", V3(0.2, 0.8, 0.2), CF(at + V3(0, 2.65, 0)), POLE, M.Metal, { shadow = false })
		for _, l in ipairs({ { 1.45, Color3.fromRGB(110, 20, 20), M.SmoothPlastic }, { 0, Color3.fromRGB(110, 86, 20), M.SmoothPlastic }, { -1.45, Color3.fromRGB(60, 255, 120), M.Neon } }) do
			cyl(m, "SignalLens", 0.1, 1.05, cf * CF(0, l[1], -0.68) * ANG(0, RAD(90), 0), l[2], l[3], { shadow = false })
			part(m, "SignalVisor", V3(1.2, 0.12, 0.7), cf * CF(0, l[1] + 0.6, -0.95), Color3.fromRGB(40, 40, 36), M.Metal, { shadow = false })
		end
	end
	-- the walk signal facing along the crosswalk, the blade and the push button
	local ped = CFrame.lookAt(base + V3(0, 10.5, 0) - face * 0.8, base + V3(0, 10.5, 0) - face * 3)
	part(m, "WalkSignal", V3(1.4, 1.6, 0.8), ped, Color3.fromRGB(40, 40, 36), M.Metal)
	part(m, "WalkLens", V3(1.0, 1.1, 0.06), ped * CF(0, 0, -0.43), Color3.fromRGB(240, 240, 230), M.Neon, { transparency = 0.2, shadow = false })
	if streetName then
		local blade = part(m, "StreetBlade", V3(7, 1.3, 0.12), CFrame.lookAt(base + V3(0, 15.6, 0), base + V3(0, 15.6, 0) + face) * CF(2.6, 0, 0), Color3.fromRGB(30, 110, 60), M.SmoothPlastic)
		GymDecor.Sign(blade, Enum.NormalId.Front, streetName, C.white, Color3.fromRGB(30, 110, 60), 40, nil, "signSub")
		GymDecor.Sign(blade, Enum.NormalId.Back, streetName, C.white, Color3.fromRGB(30, 110, 60), 40, nil, "signSub")
	end
	part(m, "WalkButton", V3(0.5, 0.8, 0.4), CFrame.lookAt(base + V3(0, 4.2, 0), base + V3(0, 4.2, 0) - face) * CF(0, 0, -0.6), C.gold, M.Metal)
	return m
end

-- a street-name sign on its own pole (two blades when `cross` is given)
function K.streetSign(parent, pos, name, yaw, cross)
	local base = CF(pos) * ANG(0, yaw or 0, 0)
	vcyl(parent, "StreetSignPole", 11.5, 0.35, base, C.steel, M.Metal, { collide = true })
	local s = part(parent, "StreetSign", V3(7, 1.3, 0.12), base * CF(0, 10.8, 0), Color3.fromRGB(30, 110, 60), M.SmoothPlastic)
	GymDecor.Sign(s, Enum.NormalId.Front, name, C.white, Color3.fromRGB(30, 110, 60), 40, nil, "signSub")
	GymDecor.Sign(s, Enum.NormalId.Back, name, C.white, Color3.fromRGB(30, 110, 60), 40, nil, "signSub")
	if cross then
		local s2 = part(parent, "StreetSign", V3(7, 1.3, 0.12), base * CF(0, 9.4, 0) * ANG(0, RAD(90), 0), Color3.fromRGB(30, 110, 60), M.SmoothPlastic)
		GymDecor.Sign(s2, Enum.NormalId.Front, cross, C.white, Color3.fromRGB(30, 110, 60), 40, nil, "signSub")
		GymDecor.Sign(s2, Enum.NormalId.Back, cross, C.white, Color3.fromRGB(30, 110, 60), 40, nil, "signSub")
	end
	return s
end

-- a regulatory / warning sign on a pole: kind = "stop" | "speed" | "ped" | "noparking" | "oneway"
function K.roadSign(parent, pos, yaw, kind, text)
	local base = CF(pos) * ANG(0, yaw or 0, 0)
	vcyl(parent, "SignPole", 9, 0.3, base, C.steel, M.Metal, { collide = true })
	local s
	if kind == "stop" then
		s = part(parent, "StopSign", V3(3.2, 3.2, 0.1), base * CF(0, 8, 0) * ANG(0, 0, RAD(22.5)), Color3.fromRGB(190, 24, 30), M.SmoothPlastic)
		local s2 = part(parent, "StopSignFace", V3(3.2, 3.2, 0.12), base * CF(0, 8, 0), Color3.fromRGB(190, 24, 30), M.SmoothPlastic)
		GymDecor.Sign(s2, Enum.NormalId.Front, "STOP", C.white, Color3.fromRGB(190, 24, 30), 40)
	elseif kind == "speed" then
		s = part(parent, "SpeedSign", V3(2.6, 3.2, 0.1), base * CF(0, 7.8, 0), C.white, M.SmoothPlastic)
		GymDecor.Sign(s, Enum.NormalId.Front, "SPEED\nLIMIT\n" .. (text or "25"), C.black, C.white, 40, nil, "signSub")
	elseif kind == "ped" then
		s = part(parent, "PedSign", V3(3.0, 3.0, 0.1), base * CF(0, 7.9, 0) * ANG(0, 0, RAD(45)), Color3.fromRGB(250, 200, 40), M.SmoothPlastic)
		local s2 = part(parent, "PedSignFace", V3(2.0, 2.0, 0.12), base * CF(0, 7.9, 0), Color3.fromRGB(250, 200, 40), M.SmoothPlastic)
		GymDecor.Sign(s2, Enum.NormalId.Front, "XING", C.black, Color3.fromRGB(250, 200, 40), 40, nil, "signSub")
	elseif kind == "oneway" then
		s = part(parent, "OneWaySign", V3(4.2, 1.4, 0.1), base * CF(0, 8.2, 0), C.black, M.SmoothPlastic)
		GymDecor.Sign(s, Enum.NormalId.Front, "ONE WAY  >", C.white, C.black, 40, nil, "signSub")
	else
		s = part(parent, "NoParkingSign", V3(2.2, 3.0, 0.1), base * CF(0, 7.8, 0), C.white, M.SmoothPlastic)
		GymDecor.Sign(s, Enum.NormalId.Front, text or "NO\nPARKING", Color3.fromRGB(190, 24, 30), C.white, 40, nil, "signSub")
	end
	return s
end

------------------------------------------------------------------------
-- vehicles. cf = ground centre, nose towards local -Z. About 20 parts a car.
------------------------------------------------------------------------
K.CAR_COLORS = {
	Color3.fromRGB(190, 30, 36), Color3.fromRGB(235, 235, 238), Color3.fromRGB(28, 28, 32), Color3.fromRGB(40, 80, 170),
	Color3.fromRGB(150, 152, 158), Color3.fromRGB(30, 110, 70), Color3.fromRGB(230, 170, 40), Color3.fromRGB(120, 124, 132),
	Color3.fromRGB(80, 40, 30), Color3.fromRGB(200, 90, 40), Color3.fromRGB(60, 130, 170),
}
-- kind: length, width, body height, cabin height, cabin length, cabin offset (+ = back), bed (pickup)
local VEHICLES = {
	sedan = { L = 16, W = 5.7, B = 2.0, CH = 1.9, CL = 8.2, CO = 0.6 },
	hatch = { L = 14.5, W = 5.6, B = 2.0, CH = 2.0, CL = 8.6, CO = 1.2 },
	suv = { L = 17, W = 6.3, B = 2.7, CH = 2.4, CL = 9.6, CO = 0.9 },
	pickup = { L = 19, W = 6.6, B = 2.8, CH = 2.4, CL = 6.2, CO = -3.2, bed = true },
	van = { L = 18, W = 6.6, B = 3.2, CH = 3.6, CL = 13.5, CO = 1.6, box = true },
	taxi = { L = 16, W = 5.7, B = 2.0, CH = 1.9, CL = 8.2, CO = 0.6, taxi = true },
}
K.VEHICLES = VEHICLES

function K.car(parent, cf, color, kind)
	local s = VEHICLES[kind or "sedan"] or VEHICLES.sedan
	local L, W, B, CH, CL, CO = s.L, s.W, s.B, s.CH, s.CL, s.CO
	local m = model(parent, "Car")
	m:SetAttribute("Kind", kind or "sedan")
	local glass = Color3.fromRGB(40, 54, 70)
	local dark = Color3.fromRGB(22, 22, 26)
	local wheelR = 1.25
	local bodyY0 = 1.0 -- body underside
	color = color or K.CAR_COLORS[1]
	if s.taxi then
		color = Color3.fromRGB(245, 200, 30)
	end
	part(m, "CarBody", V3(W, B, L), cf * CF(0, bodyY0 + B / 2, 0), color, M.SmoothPlastic, { collide = true, reflect = 0.06 })
	-- cabin: windscreen wedge, box, rear wedge (a van is a box all the way up)
	local cabY = bodyY0 + B + CH / 2
	local cw = W * 0.9
	if s.box then
		part(m, "CarCabin", V3(cw, CH, CL), cf * CF(0, cabY, CO), color, M.SmoothPlastic, { reflect = 0.06 })
		part(m, "CarGlassSide", V3(cw + 0.04, CH * 0.5, CL * 0.45), cf * CF(0, cabY + CH * 0.1, CO - CL * 0.2), glass, M.Glass, { reflect = 0.15, shadow = false })
		part(m, "Windscreen", V3(cw * 0.96, CH * 0.7, 0.1), cf * CF(0, cabY + CH * 0.05, CO - CL / 2 - 0.02), glass, M.Glass, { reflect = 0.15, shadow = false })
	else
		part(m, "Windscreen", V3(cw, CH, CH * 1.2), cf * CF(0, cabY, CO - CL / 2 + CH * 0.6), glass, M.Glass, { class = "WedgePart", reflect = 0.15 })
		part(m, "CarCabin", V3(cw, CH, CL - CH * 2.1), cf * CF(0, cabY, CO + CH * 0.15), glass, M.Glass, { reflect = 0.15 })
		part(m, "RearGlass", V3(cw, CH, CH * 0.9), cf * CF(0, cabY, CO + CL / 2 - CH * 0.45) * ANG(0, RAD(180), 0), glass, M.Glass, { class = "WedgePart", reflect = 0.15 })
		part(m, "CarRoof", V3(cw * 0.98, 0.2, CL - CH * 2.0), cf * CF(0, cabY + CH / 2 + 0.1, CO + CH * 0.15), color, M.SmoothPlastic, { reflect = 0.06 })
		-- pillars read as dark bands: one thin frame along the roof edge each side
		for _, x in ipairs({ -1, 1 }) do
			part(m, "CarPillar", V3(0.2, CH * 0.5, CL - CH * 2.0), cf * CF(x * (cw / 2 - 0.05), cabY + CH * 0.2, CO + CH * 0.15), dark, M.SmoothPlastic, { shadow = false })
		end
	end
	if s.bed then
		part(m, "BedSide", V3(0.3, 1.6, L * 0.42), cf * CF(-W / 2 + 0.15, bodyY0 + B + 0.8, L * 0.27), color, M.SmoothPlastic)
		part(m, "BedSide", V3(0.3, 1.6, L * 0.42), cf * CF(W / 2 - 0.15, bodyY0 + B + 0.8, L * 0.27), color, M.SmoothPlastic)
		part(m, "Tailgate", V3(W, 1.6, 0.3), cf * CF(0, bodyY0 + B + 0.8, L / 2 - 0.15), color, M.SmoothPlastic)
	end
	for _, x in ipairs({ -(W / 2 - 0.5), W / 2 - 0.5 }) do
		for _, z in ipairs({ -L * 0.31, L * 0.3 }) do
			cyl(m, "Wheel", 1.0, wheelR * 2, cf * CF(x, wheelR, z), dark, M.Rubber)
		end
	end
	for _, x in ipairs({ -W * 0.32, W * 0.32 }) do
		part(m, "Headlight", V3(1.3, 0.6, 0.12), cf * CF(x, bodyY0 + B * 0.7, -L / 2 - 0.04), Color3.fromRGB(255, 250, 230), M.Neon, { shadow = false })
		part(m, "Taillight", V3(1.3, 0.55, 0.12), cf * CF(x, bodyY0 + B * 0.7, L / 2 + 0.04), Color3.fromRGB(220, 30, 30), M.Neon, { shadow = false })
	end
	part(m, "BumperF", V3(W + 0.2, 0.7, 0.5), cf * CF(0, bodyY0 + 0.4, -L / 2 - 0.1), dark, M.SmoothPlastic)
	part(m, "BumperB", V3(W + 0.2, 0.7, 0.5), cf * CF(0, bodyY0 + 0.4, L / 2 + 0.1), dark, M.SmoothPlastic)
	part(m, "Plate", V3(1.8, 0.6, 0.06), cf * CF(0, bodyY0 + 0.95, L / 2 + 0.38), C.white, M.SmoothPlastic, { shadow = false })
	if s.taxi then
		local ts = part(m, "TaxiSign", V3(3.0, 0.9, 1.0), cf * CF(0, cabY + CH / 2 + 0.65, CO), Color3.fromRGB(250, 240, 200), M.Neon, { shadow = false })
		GymDecor.Sign(ts, Enum.NormalId.Left, "TAXI", C.black, Color3.fromRGB(250, 240, 200), 40)
		GymDecor.Sign(ts, Enum.NormalId.Right, "TAXI", C.black, Color3.fromRGB(250, 240, 200), 40)
	end
	return m
end

-- a city bus (12 m): cf = ground centre, nose towards local -Z
function K.bus(parent, cf, color, line)
	local L, W, H = 42, 8.6, 11
	local m = model(parent, "Bus")
	color = color or Color3.fromRGB(235, 235, 232)
	local glass = Color3.fromRGB(40, 54, 70)
	part(m, "BusBody", V3(W, H - 2.4, L), cf * CF(0, 1.6 + (H - 2.4) / 2, 0), color, M.SmoothPlastic, { collide = true })
	part(m, "BusStripe", V3(W + 0.04, 1.4, L), cf * CF(0, 4.6, 0), Color3.fromRGB(30, 90, 190), M.SmoothPlastic, { shadow = false })
	part(m, "BusWindows", V3(W + 0.06, 3.4, L * 0.78), cf * CF(0, 7.4, 1.2), glass, M.Glass, { reflect = 0.15, shadow = false })
	part(m, "BusWindscreen", V3(W * 0.92, 4.6, 0.1), cf * CF(0, 6.9, -L / 2 - 0.02), glass, M.Glass, { reflect = 0.15, shadow = false })
	part(m, "BusRoof", V3(W * 0.98, 0.5, L * 0.98), cf * CF(0, H - 0.25 + 1.2, 0), color:Lerp(Color3.new(0, 0, 0), 0.15), M.SmoothPlastic)
	part(m, "BusDoor", V3(0.1, 7.6, 3.4), cf * CF(W / 2 + 0.03, 5.4, -L / 2 + 5), glass, M.Glass, { reflect = 0.1, shadow = false })
	part(m, "BusDoor", V3(0.1, 7.6, 3.4), cf * CF(W / 2 + 0.03, 5.4, L * 0.15), glass, M.Glass, { reflect = 0.1, shadow = false })
	for _, x in ipairs({ -(W / 2 - 0.6), W / 2 - 0.6 }) do
		for _, z in ipairs({ -L * 0.36, L * 0.3 }) do
			cyl(m, "Wheel", 1.2, 3.4, cf * CF(x, 1.7, z), Color3.fromRGB(22, 22, 26), M.Rubber)
		end
	end
	for _, x in ipairs({ -W * 0.34, W * 0.34 }) do
		part(m, "Headlight", V3(1.6, 0.8, 0.12), cf * CF(x, 3.0, -L / 2 - 0.04), Color3.fromRGB(255, 250, 230), M.Neon, { shadow = false })
		part(m, "Taillight", V3(1.4, 1.2, 0.12), cf * CF(x, 3.4, L / 2 + 0.04), Color3.fromRGB(220, 30, 30), M.Neon, { shadow = false })
	end
	local dest = part(m, "BusDestination", V3(W * 0.7, 1.3, 0.12), cf * CF(0, 10.0, -L / 2 - 0.04), Color3.fromRGB(20, 20, 24), M.SmoothPlastic)
	GymDecor.Sign(dest, Enum.NormalId.Front, line or "12  DOWNTOWN", Color3.fromRGB(255, 190, 40), Color3.fromRGB(20, 20, 24), 40, nil, "screen")
	part(m, "BumperF", V3(W, 0.8, 0.5), cf * CF(0, 1.5, -L / 2 - 0.2), Color3.fromRGB(22, 22, 26), M.SmoothPlastic)
	return m
end

------------------------------------------------------------------------
-- trees and planting
------------------------------------------------------------------------
local LEAF = {
	Color3.fromRGB(56, 118, 54), Color3.fromRGB(70, 132, 58), Color3.fromRGB(48, 106, 50), Color3.fromRGB(86, 140, 62), Color3.fromRGB(64, 124, 70),
}
local AUTUMN = { Color3.fromRGB(200, 110, 40), Color3.fromRGB(214, 140, 50), Color3.fromRGB(170, 70, 40), Color3.fromRGB(226, 170, 60) }

-- kinds: oak (round crown), maple (autumn), poplar (tall narrow), pine (tiered), palm, birch (white
-- trunk, light crown), cherry (pink). h = height in studs (a street tree ~30, a park oak 40-48)
function K.tree(parent, pos, kind, h, rng)
	kind = kind or "oak"
	local m = model(parent, "Tree")
	m:SetAttribute("Kind", kind)
	local function pick(list)
		return list[rng and rng:NextInteger(1, #list) or 1]
	end
	if kind == "pine" then
		vcyl(m, "PineTrunk", h * 0.38, h * 0.07, CF(pos), Color3.fromRGB(88, 60, 40), M.Wood, { collide = true })
		local col = pick({ Color3.fromRGB(36, 86, 50), Color3.fromRGB(42, 96, 54), Color3.fromRGB(30, 78, 46) })
		for i = 0, 3 do
			local t = i / 3
			blob(m, "PineTier", V3(h * (0.52 - t * 0.3), h * 0.3, h * (0.52 - t * 0.3)), CF(pos + V3(0, h * (0.36 + t * 0.52), 0)), col, M.Grass)
		end
		blob(m, "PineTop", V3(h * 0.14, h * 0.22, h * 0.14), CF(pos + V3(0, h * 0.98, 0)), col, M.Grass)
	elseif kind == "palm" then
		local lean = V3(rng and rng:NextNumber(-0.16, 0.16) or 0.08, 1, rng and rng:NextNumber(-0.16, 0.16) or 0)
		local p = pos
		for k = 0, 2 do
			local top = p + lean * (h / 3)
			GymDecor.Rod(m, "PalmTrunk", p, top, 1.6 - k * 0.3, Color3.fromRGB(128, 102, 70), M.Wood, { collide = k == 0 })
			p = top
		end
		for k = 0, 6 do
			local a = k * RAD(51) + (rng and rng:NextNumber(-0.2, 0.2) or 0)
			blob(m, "PalmFrond", V3(2.4, 0.6, 11), CF(p) * ANG(0, a, 0) * CF(0, -0.8, -4.6) * ANG(RAD(-24), 0, 0), Color3.fromRGB(52, 128, 56), M.Grass)
		end
		ball(m, "Coconuts", 1.6, CF(p + V3(0, -1.0, 0)), Color3.fromRGB(90, 70, 40), M.Wood)
	elseif kind == "poplar" then
		vcyl(m, "TreeTrunk", h * 0.34, h * 0.05, CF(pos), Color3.fromRGB(100, 80, 56), M.Wood, { collide = true })
		local col = pick(LEAF)
		blob(m, "Canopy", V3(h * 0.3, h * 0.78, h * 0.3), CF(pos + V3(0, h * 0.58, 0)), col, M.Grass)
		blob(m, "Canopy", V3(h * 0.22, h * 0.4, h * 0.22), CF(pos + V3(h * 0.04, h * 0.84, 0)), col:Lerp(Color3.new(1, 1, 1), 0.08), M.Grass)
	else
		local trunkCol = kind == "birch" and Color3.fromRGB(222, 220, 212) or Color3.fromRGB(96, 66, 42)
		local cols = kind == "maple" and AUTUMN or LEAF
		local col = pick(cols)
		if kind == "cherry" then
			col = pick({ Color3.fromRGB(236, 150, 180), Color3.fromRGB(246, 180, 200), Color3.fromRGB(228, 130, 160) })
		elseif kind == "birch" then
			col = pick({ Color3.fromRGB(120, 170, 80), Color3.fromRGB(140, 184, 90) })
		end
		vcyl(m, "TreeTrunk", h * 0.5, h * 0.075, CF(pos), trunkCol, M.Wood, { collide = true })
		local r = h * 0.74
		blob(m, "Canopy", V3(r, h * 0.56, r), CF(pos + V3(0, h * 0.68, 0)), col, M.Grass)
		blob(m, "Canopy", V3(r * 0.7, h * 0.44, r * 0.7), CF(pos + V3(r * 0.22, h * 0.84, r * 0.12)), col:Lerp(Color3.new(1, 1, 1), 0.1), M.Grass)
		blob(m, "Canopy", V3(r * 0.62, h * 0.4, r * 0.62), CF(pos + V3(-r * 0.2, h * 0.62, -r * 0.16)), col:Lerp(Color3.new(0, 0, 0), 0.1), M.Grass)
	end
	return m
end

-- a sidewalk tree in a pit with a grate
function K.streetTree(parent, pos, rng, h)
	part(parent, "TreePit", V3(4, 0.06, 4), CF(pos + V3(0, 0.03, 0)), K.SOIL, M.Ground, { shadow = false })
	part(parent, "TreeGrate", V3(4.2, 0.08, 4.2), CF(pos + V3(0, 0.04, 0)), Color3.fromRGB(50, 50, 54), M.DiamondPlate, { shadow = false })
	local m = K.tree(parent, pos, (rng and rng:NextNumber() < 0.25) and "cherry" or "oak", h or (rng and rng:NextNumber(24, 30) or 27), rng)
	-- a street tree is pruned up: a narrower crown than a park oak, clear of the awnings
	for _, d in ipairs(m:GetChildren()) do
		if d.Name == "Canopy" then
			d.Size = d.Size * Vector3.new(0.8, 0.9, 0.8)
		end
	end
	return m
end

-- a shrub / bush
function K.shrub(parent, pos, d, rng)
	d = d or 3
	return blob(parent, "Shrub", V3(d, d * 0.7, d * 0.9), CF(pos + V3(0, d * 0.32, 0)), LEAF[rng and rng:NextInteger(1, #LEAF) or 2], M.Grass)
end

------------------------------------------------------------------------
-- street furniture
------------------------------------------------------------------------
-- park bench along local X (yaw rotates it): slatted seat at 0.45 m, backrest, cast-iron ends
function K.bench(parent, pos, yaw, length, color)
	length = length or 6.4
	local base = CF(pos) * ANG(0, yaw or 0, 0)
	local m = model(parent, "Bench")
	part(m, "BenchSeat", V3(length, 0.3, 1.9), base * CF(0, 1.55, 0), color or C.wood, M.WoodPlanks, { collide = true })
	part(m, "BenchBack", V3(length, 1.5, 0.28), base * CF(0, 2.55, 0.9) * ANG(RAD(-10), 0, 0), color or C.wood, M.WoodPlanks)
	for _, x in ipairs({ -length / 2 + 0.6, length / 2 - 0.6 }) do
		part(m, "BenchEnd", V3(0.3, 1.5, 1.8), base * CF(x, 0.75, 0), POLE, M.Metal)
		part(m, "BenchArm", V3(0.3, 0.2, 1.6), base * CF(x, 2.3, -0.1), POLE, M.Metal, { shadow = false })
	end
	return m
end

function K.bin(parent, pos, color)
	local m = model(parent, "TrashCan")
	vcyl(m, "BinBody", 3.4, 2.2, CF(pos), color or Color3.fromRGB(36, 70, 52), M.Metal, { collide = true })
	vcyl(m, "BinBand", 0.3, 2.26, CF(pos + V3(0, 2.4, 0)), C.gold, M.Metal, { shadow = false })
	vcyl(m, "BinLid", 0.4, 2.4, CF(pos + V3(0, 3.4, 0)), Color3.fromRGB(30, 60, 44), M.Metal)
	return m
end

function K.hydrant(parent, pos)
	local m = model(parent, "Hydrant")
	vcyl(m, "HydrantBarrel", 2.6, 1.0, CF(pos), Color3.fromRGB(200, 34, 34), M.Metal, { collide = true })
	ball(m, "HydrantBonnet", 1.1, CF(pos + V3(0, 2.8, 0)), Color3.fromRGB(200, 34, 34), M.Metal)
	cyl(m, "HydrantNozzles", 1.8, 0.5, CF(pos + V3(0, 1.8, 0)), Color3.fromRGB(200, 200, 205), M.Metal)
	return m
end

-- a concrete planter with shrubs (len along local X)
function K.planter(parent, cf, len, w)
	len, w = len or 6, w or 2.4
	local m = model(parent, "Planter")
	part(m, "PlanterBox", V3(len, 1.8, w), cf * CF(0, 0.9, 0), Color3.fromRGB(150, 146, 138), M.Concrete, { collide = true })
	part(m, "PlanterSoil", V3(len - 0.4, 0.1, w - 0.4), cf * CF(0, 1.75, 0), K.SOIL, M.Ground, { shadow = false })
	local n = math.max(1, math.floor(len / 2.6))
	for k = 0, n - 1 do
		local x = -len / 2 + (k + 0.5) * len / n
		blob(m, "Shrub", V3(len / n * 0.95, 2.0, w * 0.9), cf * CF(x, 2.6, 0), LEAF[(k % #LEAF) + 1], M.Grass)
	end
	return m
end

function K.bollard(parent, pos, color)
	vcyl(parent, "Bollard", 3.2, 0.9, CF(pos), color or Color3.fromRGB(60, 62, 68), M.Metal, { collide = true })
	return vcyl(parent, "BollardBand", 0.3, 0.94, CF(pos + V3(0, 2.6, 0)), C.gold, M.SmoothPlastic, { shadow = false })
end

function K.bikeRack(parent, cf)
	local m = model(parent, "BikeRack")
	for k = 0, 2 do
		local x = -2.4 + k * 2.4
		GymDecor.Rod(m, "RackLoop", (cf * CF(x, 0, -0.8)).Position, (cf * CF(x, 2.8, -0.8)).Position, 0.18, C.steelLight, M.Metal)
		GymDecor.Rod(m, "RackLoop", (cf * CF(x, 0, 0.8)).Position, (cf * CF(x, 2.8, 0.8)).Position, 0.18, C.steelLight, M.Metal)
		GymDecor.Rod(m, "RackLoop", (cf * CF(x, 2.8, -0.8)).Position, (cf * CF(x, 2.8, 0.8)).Position, 0.18, C.steelLight, M.Metal)
	end
	return m
end

-- picnic table (top along local X)
function K.picnicTable(parent, pos, yaw)
	local base = CF(pos) * ANG(0, yaw or 0, 0)
	local m = model(parent, "PicnicTable")
	part(m, "PicnicTop", V3(7.5, 0.3, 3), base * CF(0, 2.7, 0), C.wood, M.WoodPlanks, { collide = true })
	for _, z in ipairs({ -2.5, 2.5 }) do
		part(m, "PicnicSeat", V3(7.5, 0.25, 1.2), base * CF(0, 1.6, z), C.wood, M.WoodPlanks, { collide = true })
	end
	for _, x in ipairs({ -2.8, 2.8 }) do
		part(m, "PicnicLeg", V3(0.3, 2.7, 5.6), base * CF(x, 1.35, 0), C.woodDark, M.Wood)
	end
	return m
end

-- a bus shelter facing the road at local -Z: pad, glass back and side, roof, bench, an ad panel
-- (tagged CityScreen / BusAd so CityVisuals can put the player's promo on it), a stop sign
function K.busStop(parent, cf, line)
	local m = model(parent, "BusStop")
	local w, d = 16, 6
	part(m, "BusPad", V3(w + 4, 0.06, d + 2), cf * CF(0, SW_H + 0.03, 0.4), K.PAVING, M.Pavement, { shadow = false })
	part(m, "BusRoof", V3(w, 0.4, d), cf * CF(0, SW_H + 9.6, 0.4), Color3.fromRGB(40, 44, 52), M.Metal)
	part(m, "BusBack", V3(w - 0.6, 8.2, 0.2), cf * CF(0, SW_H + 4.9, d / 2 + 0.3), Color3.fromRGB(180, 210, 230), M.Glass, { transparency = 0.5, shadow = false, collide = true })
	part(m, "BusSide", V3(0.2, 8.2, d - 0.6), cf * CF(-w / 2 + 0.2, SW_H + 4.9, 0.4), Color3.fromRGB(180, 210, 230), M.Glass, { transparency = 0.5, shadow = false, collide = true })
	for _, x in ipairs({ -w / 2 + 0.3, w / 2 - 0.3 }) do
		part(m, "BusPost", V3(0.35, 9.4, 0.35), cf * CF(x, SW_H + 4.7, d / 2 + 0.3), Color3.fromRGB(40, 44, 52), M.Metal, { collide = true })
		part(m, "BusPost", V3(0.35, 9.4, 0.35), cf * CF(x, SW_H + 4.7, -d / 2 + 0.5), Color3.fromRGB(40, 44, 52), M.Metal, { collide = true })
	end
	K.bench(m, (cf * CF(-2.2, SW_H, d / 2 - 1.3)).Position, 0, 7, C.wood)
	local ad = part(m, "BusAd", V3(4.6, 6.6, 0.25), cf * CF(w / 2 - 3.2, SW_H + 4.6, d / 2 + 0.05), C.black, M.SmoothPlastic)
	GymDecor.PosterGui(ad, Enum.NormalId.Front, GymDecor.Posters[3])
	ad:SetAttribute("Kind", "BusAd")
	tag(ad, "CityScreen")
	vcyl(m, "BusSignPole", 12, 0.35, cf * CF(w / 2 + 2.2, SW_H, -d / 2 + 0.6), C.steel, M.Metal, { collide = true })
	local bsign = part(m, "BusSign", V3(2.6, 2.0, 0.15), cf * CF(w / 2 + 2.2, SW_H + 11.2, -d / 2 + 0.6), Color3.fromRGB(30, 90, 190), M.SmoothPlastic)
	GymDecor.Sign(bsign, Enum.NormalId.Front, line or "BUS 12", C.white, Color3.fromRGB(30, 90, 190), 40)
	GymDecor.Sign(bsign, Enum.NormalId.Back, line or "BUS 12", C.white, Color3.fromRGB(30, 90, 190), 40)
	return m
end

-- a street vendor's cart (hot dogs / coffee / fruit / ice cream), facing local -Z, with its umbrella
function K.vendorCart(parent, cf, kind)
	local spec = ({
		hotdog = { name = "HOT DOGS", body = Color3.fromRGB(220, 222, 226), canopy = Color3.fromRGB(230, 60, 60), stripe = C.white },
		coffee = { name = "COFFEE", body = Color3.fromRGB(80, 56, 40), canopy = Color3.fromRGB(60, 40, 30), stripe = Color3.fromRGB(240, 220, 190) },
		fruit = { name = "FRESH FRUIT", body = Color3.fromRGB(70, 130, 70), canopy = Color3.fromRGB(250, 200, 50), stripe = Color3.fromRGB(60, 140, 70) },
		icecream = { name = "ICE CREAM", body = Color3.fromRGB(245, 240, 236), canopy = Color3.fromRGB(240, 130, 170), stripe = C.white },
		pretzel = { name = "PRETZELS", body = Color3.fromRGB(200, 60, 50), canopy = Color3.fromRGB(240, 200, 60), stripe = Color3.fromRGB(200, 60, 50) },
	})[kind or "hotdog"]
	local m = model(parent, "VendorCart")
	part(m, "CartBody", V3(6.4, 3.4, 3.2), cf * CF(0, 2.4, 0), spec.body, M.SmoothPlastic, { collide = true })
	part(m, "CartTop", V3(6.6, 0.25, 3.4), cf * CF(0, 4.2, 0), Color3.fromRGB(200, 204, 210), M.Metal)
	for _, x in ipairs({ -2.4, 2.4 }) do
		cyl(m, "CartWheel", 0.5, 2.2, cf * CF(x, 1.1, 0.4), Color3.fromRGB(26, 26, 28), M.Rubber)
	end
	local cs = part(m, "CartSign", V3(5.6, 1.1, 0.1), cf * CF(0, 3.2, -1.66), spec.canopy, M.SmoothPlastic)
	GymDecor.Sign(cs, Enum.NormalId.Front, spec.name, C.white, spec.canopy, 40)
	vcyl(m, "UmbrellaPole", 8.6, 0.25, cf * CF(1.6, 4.3, 0.2), C.steelLight, M.Metal)
	blob(m, "Umbrella", V3(9, 2.0, 9), cf * CF(1.6, 12.4, 0.2), spec.canopy, M.Fabric, { shadow = true })
	blob(m, "UmbrellaStripe", V3(6.2, 1.6, 6.2), cf * CF(1.6, 12.9, 0.2), spec.stripe, M.Fabric, { shadow = false })
	if kind == "hotdog" or kind == "pretzel" then
		part(m, "Griddle", V3(2.2, 0.15, 1.6), cf * CF(-1.4, 4.4, 0), Color3.fromRGB(40, 40, 44), M.Metal)
		blob(m, "Buns", V3(1.6, 0.6, 1.1), cf * CF(1.2, 4.6, -0.4), Color3.fromRGB(220, 170, 100), M.SmoothPlastic, { shadow = false })
	elseif kind == "fruit" then
		for k, col in ipairs({ Color3.fromRGB(230, 60, 50), Color3.fromRGB(250, 170, 40), Color3.fromRGB(120, 200, 60) }) do
			blob(m, "FruitCrate", V3(1.8, 0.9, 1.6), cf * CF(-2 + k * 1.3, 4.7, -0.3), col, M.SmoothPlastic, { shadow = false })
		end
	else
		vcyl(m, "Urn", 1.8, 1.0, cf * CF(-1.6, 4.3, 0.2), Color3.fromRGB(200, 204, 210), M.Metal)
	end
	return m
end

-- a flag on a pole (h studs), the cloth printed both sides when text is given
function K.flagPole(parent, base, h, color, text, textColor)
	h = h or 36
	vcyl(parent, "FlagPole", h, 0.5, CF(base), C.steelLight, M.Metal, { collide = true })
	ball(parent, "FlagPoleTop", 0.9, CF(base + V3(0, h + 0.2, 0)), C.gold, M.Metal)
	local fl = part(parent, "Flag", V3(0.1, h * 0.17, h * 0.27), CF(base + V3(0, h - h * 0.11, -h * 0.14)), color, M.Fabric, { shadow = false })
	if text then
		GymDecor.Sign(fl, Enum.NormalId.Right, text, textColor or C.white, nil, 30)
		GymDecor.Sign(fl, Enum.NormalId.Left, text, textColor or C.white, nil, 30)
	end
	return fl
end

------------------------------------------------------------------------
-- fences and walls (between two ground points a and b)
------------------------------------------------------------------------
local function run(a, b)
	local d = b - a
	local len = d.Magnitude
	return CFrame.lookAt((a + b) / 2, b) * ANG(0, RAD(90), 0), len
end

-- chain-link: a see-through panel with posts every 12 studs and a top rail
function K.fenceChain(parent, a, b, h)
	h = h or 7
	local cf, len = run(a, b)
	part(parent, "ChainLink", V3(len, h - 0.3, 0.1), cf * CF(0, 0.3 + (h - 0.3) / 2, 0), Color3.fromRGB(150, 155, 160), M.DiamondPlate, { transparency = 0.72, shadow = false, collide = true })
	part(parent, "FenceRail", V3(len, 0.2, 0.2), cf * CF(0, h, 0), Color3.fromRGB(120, 124, 130), M.Metal)
	local n = math.max(1, math.floor(len / 12))
	for k = 0, n do
		part(parent, "FencePost", V3(0.3, h + 0.2, 0.3), cf * CF(-len / 2 + k * len / n, (h + 0.2) / 2, 0), Color3.fromRGB(110, 114, 120), M.Metal)
	end
end

-- white picket fence (1.1 m): two rails, pickets read through a slotted panel
function K.fencePicket(parent, a, b)
	local cf, len = run(a, b)
	part(parent, "PicketPanel", V3(len, 3.6, 0.2), cf * CF(0, 1.9, 0), C.white, M.Wood, { transparency = 0.4, shadow = false, collide = true })
	for _, y in ipairs({ 1.4, 3.0 }) do
		part(parent, "FenceRail", V3(len, 0.3, 0.3), cf * CF(0, y, 0), C.white, M.Wood)
	end
	local n = math.max(1, math.floor(len / 8))
	for k = 0, n do
		part(parent, "FencePost", V3(0.45, 4.0, 0.45), cf * CF(-len / 2 + k * len / n, 2.0, 0), C.white, M.Wood)
	end
end

-- wrought-iron railing (h studs): dark panel, top rail, posts
function K.fenceIron(parent, a, b, h)
	h = h or 5
	local cf, len = run(a, b)
	part(parent, "IronPanel", V3(len, h - 0.4, 0.12), cf * CF(0, 0.2 + (h - 0.4) / 2, 0), Color3.fromRGB(26, 26, 30), M.Metal, { transparency = 0.55, shadow = false, collide = true })
	part(parent, "IronRail", V3(len, 0.25, 0.25), cf * CF(0, h, 0), Color3.fromRGB(26, 26, 30), M.Metal)
	local n = math.max(1, math.floor(len / 10))
	for k = 0, n do
		part(parent, "IronPost", V3(0.4, h + 0.3, 0.4), cf * CF(-len / 2 + k * len / n, (h + 0.3) / 2, 0), Color3.fromRGB(26, 26, 30), M.Metal)
	end
end

-- a brick / stone wall with coping
function K.wall(parent, a, b, h, color, material, copingColor)
	h = h or 5
	local cf, len = run(a, b)
	part(parent, "Wall", V3(len, h, 1.2), cf * CF(0, h / 2, 0), color or Color3.fromRGB(150, 128, 104), material or M.Brick, { collide = true })
	part(parent, "WallCoping", V3(len + 0.3, 0.35, 1.5), cf * CF(0, h + 0.17, 0), copingColor or Color3.fromRGB(214, 206, 190), M.Limestone)
end

-- a guard rail / promenade railing (1.1 m): posts and two rails
function K.railing(parent, a, b, color)
	local cf, len = run(a, b)
	color = color or Color3.fromRGB(40, 44, 52)
	part(parent, "RailTop", V3(len, 0.3, 0.3), cf * CF(0, 3.9, 0), color, M.Metal, { collide = true })
	part(parent, "RailMid", V3(len, 0.15, 0.15), cf * CF(0, 2.2, 0), color, M.Metal, { shadow = false })
	part(parent, "RailPanel", V3(len, 3.4, 0.08), cf * CF(0, 2.0, 0), color, M.Metal, { transparency = 0.7, shadow = false, collide = true })
	local n = math.max(1, math.floor(len / 8))
	for k = 0, n do
		part(parent, "RailPost", V3(0.3, 3.9, 0.3), cf * CF(-len / 2 + k * len / n, 1.95, 0), color, M.Metal)
	end
end

------------------------------------------------------------------------
-- parking lots: x1..x2, z1..z2; rows of 2.7 x 5 m bays along X (cars nose +-Z) with aisles between
-- opts: rng, fill (0..1 of bays with a car), rows ("auto"), reserved = bay index left empty
-- returns the list of bay CFrames (ground centre, nose into the bay)
------------------------------------------------------------------------
function K.parkingLot(parent, x1, x2, z1, z2, opts)
	opts = opts or {}
	local f = parent
	local rng = opts.rng or Random.new(7)
	local BAY_W, BAY_D, AISLE = 9.6, 18, 24
	slab(f, "ParkingLot", x1, x2, z1, z2, ROAD_Y - 0.02, opts.color or K.ASPHALT_OLD, M.Asphalt)
	local bays = {}
	local depth = z2 - z1
	-- rows: a bay row against each long edge, double rows in between as the depth allows
	local rows = {}
	if depth < BAY_D * 2 + AISLE then
		rows = { { z1, 1 } } -- one row at the z1 edge, cars nose -Z (towards z1)
	else
		local cursor = z1
		table.insert(rows, { cursor, -1 })
		cursor += BAY_D + AISLE
		while cursor + BAY_D * 2 + AISLE <= z2 - BAY_D do
			table.insert(rows, { cursor, 1 })
			table.insert(rows, { cursor + BAY_D, -1 })
			cursor += BAY_D * 2 + AISLE
		end
		table.insert(rows, { z2 - BAY_D, 1 })
	end
	local n = math.floor((x2 - x1 - 4) / BAY_W)
	local idx = 0
	for _, r in ipairs(rows) do
		local rz, dir = r[1], r[2]
		local lineZ = dir < 0 and rz or rz
		for k = 0, n do
			local x = x1 + 2 + k * BAY_W
			part(f, "BayLine", V3(0.35, 0.03, BAY_D), CF(x, MARK_Y, lineZ + BAY_D / 2), LINE_WHITE, M.SmoothPlastic, { shadow = false })
		end
		for k = 0, n - 1 do
			idx += 1
			local cx = x1 + 2 + (k + 0.5) * BAY_W
			local nose = dir < 0 and (rz + 1) or (rz + BAY_D - 1)
			local cf = CF(cx, ROAD_Y - 0.02, rz + BAY_D / 2) * ANG(0, dir < 0 and 0 or RAD(180), 0)
			table.insert(bays, cf)
			local _ = nose
			if opts.stops then
				part(f, "WheelStop", V3(6, 0.5, 0.7), CF(cx, ROAD_Y + 0.23, dir < 0 and rz + 2.2 or rz + BAY_D - 2.2), Color3.fromRGB(196, 192, 184), M.Concrete, { collide = true })
			end
			if idx ~= opts.reserved and rng:NextNumber() < (opts.fill or 0.5) then
				local kinds = { "sedan", "sedan", "hatch", "suv", "pickup", "van" }
				K.car(f, cf * ANG(0, RAD(rng:NextNumber(-2, 2)), 0), K.CAR_COLORS[rng:NextInteger(1, #K.CAR_COLORS)], kinds[rng:NextInteger(1, #kinds)])
			end
		end
	end
	if opts.lights ~= false then
		local step = 60
		local x = x1 + 30
		while x < x2 - 10 do
			K.streetLight(f, V3(x, ROAD_Y - 0.02, (z1 + z2) / 2), V3(0, 0, 1), true, 26)
			x += step
		end
	end
	return bays
end

------------------------------------------------------------------------
-- billboards and signs
------------------------------------------------------------------------
K.ADS = {
	{ title = "TONY'S PIZZA", sub = "SLICE OF CHAMPIONS - MAIN ST", bg = Color3.fromRGB(200, 30, 30), fg = Color3.fromRGB(255, 240, 200) },
	{ title = "IRON SUPPLEMENTS", sub = "BUILT IN THE GYM. FUELED BY IRON.", bg = Color3.fromRGB(26, 26, 28), fg = Color3.fromRGB(240, 110, 20) },
	{ title = "FIGHT NIGHT LIVE", sub = "GRAND ARENA - TICKETS ON MAIN ST", bg = Color3.fromRGB(150, 16, 24), fg = Color3.fromRGB(255, 220, 90) },
	{ title = "APEX ATHLETICS", sub = "OUTWORK EVERYONE", bg = Color3.fromRGB(20, 20, 20), fg = Color3.fromRGB(0, 170, 190) },
	{ title = "PRESTIGE MOTORS", sub = "DRIVE LIKE A CHAMPION", bg = Color3.fromRGB(16, 18, 24), fg = Color3.fromRGB(220, 220, 230) },
	{ title = "RIVERSIDE REALTY", sub = "LIVE WHERE THE CHAMPIONS LIVE", bg = Color3.fromRGB(20, 60, 110), fg = Color3.fromRGB(240, 240, 245) },
	{ title = "SUMMIT SPORTSWEAR", sub = "NEW SEASON - DOWNTOWN", bg = Color3.fromRGB(240, 236, 226), fg = Color3.fromRGB(30, 30, 34) },
	{ title = "WCB SPORTS NETWORK", sub = "EVERY FIGHT. LIVE.", bg = Color3.fromRGB(14, 14, 18), fg = Color3.fromRGB(255, 205, 83) },
}

-- Billboard on two steel legs with a catwalk and flood lights (w x h face; legs reach the ground
-- unless legH is given). Tagged CityBillboard (attribute Slot): CityVisuals swaps the ad locally.
function K.billboard(parent, cf, w, h, slot, ad, legH)
	local m = model(parent, "Billboard")
	legH = legH or (cf.Position.Y - h / 2)
	for _, x in ipairs({ -w * 0.3, w * 0.3 }) do
		if legH > 0.5 then
			part(m, "BillboardLeg", V3(1.2, legH + h / 2, 1.2), cf * CF(x, -(legH + h / 2) / 2, 1.2), POLE, M.Metal, { collide = true })
		end
		part(m, "BillboardBrace", V3(0.35, h * 0.9, 0.35), cf * CF(x, 0, 1.1), POLE, M.Metal)
	end
	part(m, "BillboardFrame", V3(w + 1.2, h + 1.2, 0.8), cf * CF(0, 0, 0.5), Color3.fromRGB(30, 32, 36), M.Metal)
	local face = part(m, "BillboardFace", V3(w, h, 0.2), cf * CF(0, 0, -0.05), Color3.fromRGB(240, 240, 240), M.SmoothPlastic)
	part(m, "Catwalk", V3(w, 0.25, 2.0), cf * CF(0, -h / 2 - 0.8, -0.8), C.steel, M.DiamondPlate)
	part(m, "CatwalkRail", V3(w, 0.15, 0.15), cf * CF(0, -h / 2 + 2.2, -1.75), C.steel, M.Metal, { shadow = false })
	for _, x in ipairs({ -w * 0.3, w * 0.3 }) do
		local arm = part(m, "FloodArm", V3(0.25, 0.25, 3.4), cf * CF(x, -h / 2 - 0.6, -2.2), POLE, M.Metal)
		local l = spot(emitter(m, arm.CFrame * CF(0, 0, -1.6)), Enum.NormalId.Top, Color3.fromRGB(255, 244, 220), h * 2.2, 1.4, 70)
		l.Enabled = false
		tag(l, "NightLight")
	end
	local sg = gui(face, Enum.NormalId.Front, 10, 0.2, 1200)
	sg.Name = "Ad"
	frame(sg, { Name = "Bg", Size = UDim2.fromScale(1, 1), BackgroundColor3 = ad.bg })
	label(sg, ad.title, { Name = "Title", TextColor3 = ad.fg, Size = UDim2.fromScale(0.9, 0.5), Position = UDim2.fromScale(0.05, 0.08) })
	label(sg, ad.sub, { Name = "Sub", TextColor3 = ad.fg, Face = "signSub", Size = UDim2.fromScale(0.9, 0.26), Position = UDim2.fromScale(0.05, 0.64) })
	face:SetAttribute("Slot", slot)
	tag(face, "CityBillboard")
	return m, face
end

-- a free-standing double-sided sign on two posts (w x h board, its bottom edge at y)
function K.postSign(parent, cf, w, h, y, text, fg, bg, lockup)
	local m = model(parent, "PostSign")
	for _, x in ipairs({ -w / 2 + 0.6, w / 2 - 0.6 }) do
		part(m, "SignPost", V3(0.5, y + h, 0.5), cf * CF(x, (y + h) / 2, 0), bg or Color3.fromRGB(60, 40, 26), M.Wood, { collide = true })
	end
	local board = part(m, "SignBoard", V3(w, h, 0.4), cf * CF(0, y + h / 2, 0), bg or Color3.fromRGB(60, 40, 26), M.Wood)
	if lockup then
		Signage.Boards(board, { Enum.NormalId.Front, Enum.NormalId.Back }, lockup, { maxDist = 500 })
	else
		GymDecor.Sign(board, Enum.NormalId.Front, text, fg or Color3.fromRGB(255, 230, 170), bg or Color3.fromRGB(60, 40, 26), 30)
		GymDecor.Sign(board, Enum.NormalId.Back, text, fg or Color3.fromRGB(255, 230, 170), bg or Color3.fromRGB(60, 40, 26), 30)
	end
	return board
end

------------------------------------------------------------------------
-- buildings
------------------------------------------------------------------------
-- a generic street building. cf = ground centre of the FRONT face, its -Z towards the street; w along
-- local X, d back along +Z. floors = storeys above the ground floor (0 = a one-storey shop).
-- st: color, mat, trim (cornice colour), roof (colour), retail (ground-floor storefront: glass, door,
-- sign band with st.sign text / st.lockup), awning (colour), signBg / signFg, cols (window columns),
-- lit, rng, range (window draw range), corner (a second storefront on the local +X side), units (roof)
function K.building(parent, cf, w, d, floors, st)
	st = st or {}
	local rng = st.rng or Random.new(w * 7 + d)
	local G, S = CITY.GroundFloor, CITY.Storey
	local H = G + floors * S
	local m = model(parent, st.name or "Building")
	local color = st.color or Color3.fromRGB(176, 160, 140)
	local mat = st.mat or M.Brick
	local body = part(m, "BuildingBody", V3(w, H, d), cf * CF(0, H / 2, d / 2), color, mat, { collide = true })
	if floors >= 1 then
		K.windowGrid(body, Enum.NormalId.Front, H, G + 2.4, H - 2.0, floors, st.cols or math.max(2, math.floor(w / 9)), rng, st.lit or 0.35, st.range)
	end
	-- cornice and parapet
	part(m, "Cornice", V3(w + 1.0, 1.1, d + 1.0), cf * CF(0, H + 0.55, d / 2), st.trim or Color3.fromRGB(70, 66, 62), M.Concrete)
	part(m, "Parapet", V3(w, 1.6, 0.8), cf * CF(0, H + 1.9, 0.4), color, mat)
	-- storefront
	if st.retail ~= false then
		local glassTop = G - 3.4
		part(m, "ShopInterior", V3(w - 3, glassTop - 0.8, 0.12), cf * CF(0, 0.8 + (glassTop - 0.8) / 2, 0.07), Color3.fromRGB(36, 40, 48), M.SmoothPlastic)
		local win = part(m, "ShopWindow", V3(w - 3, glassTop - 0.8, 0.1), cf * CF(0, 0.8 + (glassTop - 0.8) / 2, -0.2), Color3.fromRGB(170, 205, 230), M.Glass, { transparency = 0.55, reflect = 0.12, shadow = false })
		win:SetAttribute("Shop", st.sign or "")
		local n = math.max(1, math.floor((w - 3) / 8))
		for k = 0, n do
			part(m, "Mullion", V3(0.3, glassTop - 0.8, 0.3), cf * CF(-(w - 3) / 2 + k * (w - 3) / n, 0.8 + (glassTop - 0.8) / 2, -0.2), Color3.fromRGB(30, 30, 34), M.Metal)
		end
		local doorX = st.doorAt and (w * st.doorAt) or (w * 0.3)
		part(m, "ShopDoor", V3(CITY.Door.w, CITY.Door.h, 0.15), cf * CF(doorX, 0.8 + CITY.Door.h / 2, -0.32), Color3.fromRGB(28, 28, 32), M.Metal)
		part(m, "Kickplate", V3(w - 3, 0.9, 0.3), cf * CF(0, 0.8 + 0.45, -0.15), Color3.fromRGB(40, 40, 44), M.Metal)
		for _, x in ipairs({ -w / 2 + 0.75, w / 2 - 0.75 }) do
			part(m, "ShopPier", V3(1.5, G, 0.5), cf * CF(x, G / 2, -0.25), color, mat, { collide = true })
		end
		if st.awning then
			part(m, "ShopAwning", V3(w - 2, 0.35, 5.4), cf * CF(0, glassTop + 1.4, -2.6) * ANG(RAD(-14), 0, 0), st.awning, M.Fabric)
		end
		local signPart = part(m, "ShopSign", V3(w - 2.6, 3.2, 0.4), cf * CF(0, G - 1.7, -0.25), st.signBg or Color3.fromRGB(20, 20, 24), M.SmoothPlastic)
		if st.lockup then
			Signage.Board(signPart, Enum.NormalId.Front, st.lockup, { maxDist = 700 })
		elseif st.sign then
			local sg = gui(signPart, Enum.NormalId.Front, Signage.PPS(3.2, 0.8), 0, 700)
			frame(sg, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = st.signBg or Color3.fromRGB(20, 20, 24) })
			label(sg, st.sign, { TextColor3 = st.signFg or C.gold, Size = UDim2.fromScale(0.94, 0.8), Position = UDim2.fromScale(0.03, 0.1) })
		end
		local glow = point(emitter(m, cf * CF(0, 6, -1.6)), Color3.fromRGB(255, 214, 160), 18, 0.9)
		glow.Enabled = false
		tag(glow, "NightLight")
	else
		-- a lobby: tall glass with a revolving-door bay
		part(m, "LobbyGlass", V3(w * 0.7, G - 1.5, 0.15), cf * CF(0, 0.8 + (G - 1.5) / 2, -0.1), Color3.fromRGB(150, 190, 220), M.Glass, { transparency = 0.45, reflect = 0.15, shadow = false })
		part(m, "LobbyDoor", V3(CITY.Door.w * 2.2, CITY.Door.h + 0.6, 0.3), cf * CF(0, 0.8 + (CITY.Door.h + 0.6) / 2, -0.3), Color3.fromRGB(30, 30, 34), M.Metal)
		part(m, "LobbyCanopy", V3(w * 0.5, 0.6, 7), cf * CF(0, G - 2.6, -3.5), Color3.fromRGB(30, 30, 34), M.Metal)
		if st.sign then
			local nameplate = part(m, "LobbySign", V3(w * 0.5, 2.2, 0.3), cf * CF(0, G - 1.0, -0.2), st.signBg or Color3.fromRGB(20, 20, 24), M.SmoothPlastic)
			GymDecor.Sign(nameplate, Enum.NormalId.Front, st.sign, st.signFg or C.gold, st.signBg or Color3.fromRGB(20, 20, 24), 30)
		end
	end
	-- roof units
	local units = st.units or (floors >= 1 and 2 or 1)
	for _ = 1, units do
		part(m, "RoofUnit", V3(6, 3, 5), cf * CF(rng:NextNumber(-w / 3, w / 3), H + 1.5, d * rng:NextNumber(0.3, 0.7)), Color3.fromRGB(196, 198, 202), M.Metal)
	end
	if st.tank then
		local tp = cf * CF(w * 0.3, H + 1.1, d * 0.6)
		for _, o in ipairs({ { -2, -2 }, { 2, -2 }, { -2, 2 }, { 2, 2 } }) do
			part(m, "TankLeg", V3(0.35, 5, 0.35), tp * CF(o[1], 2.5, o[2]), Color3.fromRGB(40, 42, 48), M.Metal)
		end
		vcyl(m, "WaterTank", 7, 6, tp * CF(0, 5, 0), Color3.fromRGB(120, 86, 60), M.WoodPlanks)
		part(m, "TankRoof", V3(6.4, 1.8, 6.4), tp * CF(0, 12.5, 0) * ANG(0, RAD(45), 0), Color3.fromRGB(60, 50, 44), M.Slate)
	end
	return m, body, H
end

-- a skyline / downtown tower: w x d footprint, h tall, facing `look` with its window grid; a setback cap,
-- an antenna on the tall ones. tone picks the facade.
function K.tower(parent, pos, w, d, h, look, rng, opts)
	opts = opts or {}
	local cf = CFrame.lookAt(pos + V3(0, h / 2, 0), pos + V3(0, h / 2, 0) + look)
	local tone = opts.tone or rng:NextInteger(0, 4)
	local palette = {
		{ Color3.fromRGB(70, 78, 92), M.Concrete, 0 }, { Color3.fromRGB(120, 122, 130), M.Concrete, 0 }, { Color3.fromRGB(62, 84, 110), M.SmoothPlastic, 0.18 },
		{ Color3.fromRGB(156, 144, 128), M.Concrete, 0 }, { Color3.fromRGB(44, 58, 76), M.SmoothPlastic, 0.2 },
	}
	local p = palette[tone + 1]
	local m = model(parent, opts.name or "Tower")
	local body = part(m, "Tower", V3(w, h, d), cf, p[1], p[2], { reflect = p[3], collide = true })
	local rows = math.max(2, math.floor(h / CITY.Storey))
	K.windowGrid(body, Enum.NormalId.Front, h, 6, h - 4, rows, math.max(3, math.floor(w / 8)), rng, opts.lit or 0.32, opts.range or 2500)
	if opts.allFaces then
		K.windowGrid(body, Enum.NormalId.Front, h, 6, h - 4, rows, math.max(3, math.floor(w / 8)), rng, opts.lit or 0.32, opts.range or 2500)
	end
	part(m, "TowerCap", V3(w * 0.62, 5, d * 0.62), cf * CF(0, h / 2 + 2.5, 0), p[1]:Lerp(Color3.new(0, 0, 0), 0.2), M.Concrete)
	if opts.crown then
		part(m, "TowerCrown", V3(w * 0.4, 4, d * 0.4), cf * CF(0, h / 2 + 7, 0), Color3.fromRGB(230, 220, 190), M.Neon, { shadow = false })
	end
	if h > 150 then
		part(m, "Antenna", V3(0.8, 26, 0.8), cf * CF(0, h / 2 + 17, 0), C.steelLight, M.Metal)
		ball(m, "AntennaLight", 1.6, cf * CF(0, h / 2 + 30.5, 0), Color3.fromRGB(255, 40, 40), M.Neon, { shadow = false })
	end
	return m, body
end

-- a house: W x D footprint, two storeys with a gable roof, porch, garage, door, windows
K.HOUSE_COLORS = {
	Color3.fromRGB(220, 206, 180), Color3.fromRGB(176, 196, 214), Color3.fromRGB(214, 180, 170), Color3.fromRGB(200, 214, 180),
	Color3.fromRGB(238, 236, 228), Color3.fromRGB(190, 170, 200), Color3.fromRGB(150, 168, 190), Color3.fromRGB(226, 200, 150),
}

------------------------------------------------------------------------
-- industrial / construction props
------------------------------------------------------------------------
function K.container(parent, cf, color, stackLabel)
	local c = part(parent, "Container", V3(43, 8.7, 8.7), cf * CF(0, 4.35, 0), color or Color3.fromRGB(150, 50, 40), M.DiamondPlate, { collide = true })
	part(parent, "ContainerDoors", V3(0.2, 8.0, 8.0), cf * CF(21.6, 4.35, 0), (color or Color3.fromRGB(150, 50, 40)):Lerp(Color3.new(0, 0, 0), 0.25), M.Metal, { shadow = false })
	if stackLabel then
		GymDecor.Sign(c, Enum.NormalId.Front, stackLabel, C.white, nil, 20, nil, "signSub")
	end
	return c
end

function K.dumpster(parent, cf, color)
	part(parent, "Dumpster", V3(8, 5, 4.6), cf * CF(0, 2.5, 0), color or Color3.fromRGB(40, 90, 50), M.Metal, { collide = true })
	part(parent, "DumpsterLid", V3(8.1, 0.25, 4.7), cf * CF(0, 5.1, 0) * ANG(RAD(-6), 0, 0), C.black, M.Plastic)
end

-- a traffic cone
function K.cone(parent, pos)
	part(parent, "ConeBase", V3(1.6, 0.15, 1.6), CF(pos + V3(0, 0.08, 0)), Color3.fromRGB(240, 110, 20), M.SmoothPlastic, { shadow = false })
	return blob(parent, "Cone", V3(1.0, 2.6, 1.0), CF(pos + V3(0, 1.3, 0)), Color3.fromRGB(240, 110, 20), M.SmoothPlastic)
end

-- a construction hoarding panel between a and b (2.2 m plywood with a printed notice)
function K.hoarding(parent, a, b, color)
	local cf, len = run(a, b)
	local p = part(parent, "Hoarding", V3(len, 7.8, 0.3), cf * CF(0, 3.9, 0), color or Color3.fromRGB(40, 90, 170), M.Wood, { collide = true })
	local n = math.max(1, math.floor(len / 12))
	for k = 0, n do
		part(parent, "HoardingPost", V3(0.5, 8.2, 0.5), cf * CF(-len / 2 + k * len / n, 4.1, 0.3), Color3.fromRGB(60, 50, 40), M.Wood)
	end
	return p
end

return K
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="93">
        <Properties>
          <string name="Name">CityMap</string>
          <string name="Source"><![CDATA[-- CityMap: the town around the gym, at real-world scale (Config.City: 1 stud = 0.28 m). The gym
-- stays at the origin inside the roadwork loop (MapBuilder.Track builds the loop road); CityMap
-- builds everything else:
--   * the CAMPUS inside the loop: entrance plaza, member parking, Champions Plaza with the golden
--     glove monument, the outdoor yard, the training field north of the pool, the bus stop
--   * DOWNTOWN south of the loop: Champion Ave with the Walk of Fame, Main Street with its two rows
--     of shops (CityShops: walk-in interiors, the apartments, the gas station), the fire station,
--     2nd Street and the office towers behind it
--   * the RESIDENTIAL west: Oak Street's houses, Cedar Lane, the hills; Hillcrest Estates at the top
--   * the PARK and WATERFRONT east: Riverside Park (court, fountain, pond, bandstand, playground),
--     Riverside Drive, the promenade, boardwalk, pier and the river with the bridge and the far bank
--   * the ARENA district north: Arena Way, the plaza and the Grand Arena with its parking lots
--   * the GYM / INDUSTRIAL north-east: the Elite Performance Center, warehouses, a construction site
--   * billboards, the far skyline, the mountain training camp
-- Street lights and shop lights are tagged "NightLight"/"NightLens" (Ambience switches them at dusk),
-- neon signs "NeonFlicker". Player-specific pieces (homes, cars, fans, statue, sponsors) are built by
-- the client (CityVisuals) at the invisible Sites (CityKit.site); the travel code reads CityMap.Sites.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GymDecor = require(script.Parent:WaitForChild("GymDecor"))
local K = require(script.Parent:WaitForChild("CityKit"))
local CityShops = require(script.Parent:WaitForChild("CityShops"))
local CityHomes = require(script.Parent:WaitForChild("CityHomes"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Catalog = require(Shared:WaitForChild("Catalog"))
local CityProps = require(Shared:WaitForChild("CityProps"))
local Signage = require(Shared:WaitForChild("Signage"))

local CityMap = {}

local V3 = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local RAD = math.rad
local M = Enum.Material
local C = K.C
local CITY = Config.City
local SW_H, ROAD_Y = K.SW_H, K.ROAD_Y
local part, cyl, vcyl, ball, blob, rod = K.part, K.cyl, K.vcyl, K.ball, K.blob, K.rod
local label, frame, gui, spot, point, emitter, tag = K.label, K.frame, K.gui, K.spot, K.point, K.emitter, K.tag
local folder, model, slab = K.folder, K.model, K.slab
local site, promptPart, lightZone, nightPoint = K.site, K.promptPart, K.lightZone, K.nightPoint

CityMap.Sites = K.Sites -- name -> CFrame (server side travel targets)
CityMap.HomeSpec = CityHomes.HomeSpec
CityMap.HomeKind = CityHomes.HomeKind
CityMap.EnterHome = CityHomes.Enter
CityMap.ReleaseHome = CityHomes.Release

local LOOP, MAIN, AVE = CITY.Loop, CITY.MainStreet, CITY.ChampionAve
local LW = LOOP.w / 2 -- 12.5
local INNER = 8 -- the loop's inner sidewalk width
local OUTER = 10 -- its outer sidewalk width

-- a strip of street lights along X at z, every `step`, arms over the road towards dir
local function lightsX(parent, x1, x2, z, dir, step, h, every)
	local k = 0
	for x = x1, x2, step do
		k += 1
		K.streetLight(parent, V3(x, SW_H, z), dir, (every or 2) == 1 or k % (every or 2) == 1, h)
	end
end
local function lightsZ(parent, z1, z2, x, dir, step, h, every)
	local k = 0
	for z = z1, z2, step do
		k += 1
		K.streetLight(parent, V3(x, SW_H, z), dir, (every or 2) == 1 or k % (every or 2) == 1, h)
	end
end

-- a row of street trees along X at z
local function treesX(parent, x1, x2, z, step, rng, skip)
	for x = x1, x2, step do
		local ok = true
		for _, s in ipairs(skip or {}) do
			if x > s[1] and x < s[2] then
				ok = false
			end
		end
		if ok then
			K.streetTree(parent, V3(x, SW_H, z), rng)
		end
	end
end
local function treesZ(parent, z1, z2, x, step, rng, skip)
	for z = z1, z2, step do
		local ok = true
		for _, s in ipairs(skip or {}) do
			if z > s[1] and z < s[2] then
				ok = false
			end
		end
		if ok then
			K.streetTree(parent, V3(x, SW_H, z), rng)
		end
	end
end

------------------------------------------------------------------------
-- The campus inside the loop
------------------------------------------------------------------------
local function buildCampus(root)
	local f = folder(root, "Campus")
	local rng = Random.new(42)
	local inZ = LOOP.z1 - LW - INNER -- 149.5: the inner sidewalk's north edge on the south road
	-- lawns everywhere between the gym's frontage and the inner sidewalks (the roads sit on them)
	K.lawn(f, -227.5, -24, 89.5, inZ, rng, { patches = 3 })
	K.lawn(f, 24, 227.5, 89.5, inZ, rng, { patches = 3 })
	K.lawn(f, -227.5, -112, -269.5, 89.5, rng, { patches = 4 })
	K.lawn(f, 112, 227.5, -269.5, 89.5, rng, { patches = 4 })
	K.lawn(f, -112, 112, -269.5, -148, rng, { patches = 2 })

	-- entrance plaza: from the gym's sidewalk (z 89.3) to the loop's inner sidewalk, a paved forecourt
	-- with planters, bollards, benches, flags and the welcome board; kept clear on the x -5..5 axis
	slab(f, "EntrancePlaza", -30, 30, 89.5, inZ, 0.3, K.PAVING, M.Pavement)
	slab(f, "PlazaBand", -30, 30, 118, 121, 0.31, Color3.fromRGB(120, 110, 100), M.Concrete)
	slab(f, "PlazaBand", -30, 30, 138, 141, 0.31, Color3.fromRGB(120, 110, 100), M.Concrete)
	for _, x in ipairs({ -20, 20 }) do
		K.planter(f, CF(x, 0.3, 100) * ANG(0, RAD(90), 0), 10, 2.6)
		K.planter(f, CF(x, 0.3, 128) * ANG(0, RAD(90), 0), 10, 2.6)
		K.bench(f, V3(x * 0.6, 0.3, 112), x < 0 and RAD(90) or RAD(-90), 6.4, C.wood)
		K.bench(f, V3(x * 0.6, 0.3, 132), x < 0 and RAD(90) or RAD(-90), 6.4, C.wood)
		K.bin(f, V3(x * 0.6, 0.3, 122))
		K.parkLamp(f, V3(x, 0.3, 112), true)
		K.parkLamp(f, V3(x, 0.3, 140), true)
	end
	for _, x in ipairs({ -8, 0, 8 }) do
		K.bollard(f, V3(x, 0.3, 147))
	end
	local wb = part(f, "WelcomeBoard", V3(14, 4, 0.5), CF(-24, 3.4, 145), Color3.fromRGB(18, 18, 22), M.SmoothPlastic)
	for _, x in ipairs({ -30.5, -17.5 }) do
		part(f, "WelcomePost", V3(0.6, 5.6, 0.6), CF(x, 2.8, 145), C.black, M.Metal, { collide = true })
	end
	Signage.Boards(wb, { Enum.NormalId.Front, Enum.NormalId.Back }, "gym", { maxDist = 500 })
	-- the entrance path (CityDetail's keep-out x -5..5, z 84..115 stays open) is the plaza itself
	-- crosswalks across the loop's south road, in line with Champion Ave's sidewalks
	for _, x in ipairs({ -17, 17 }) do
		K.crosswalk(f, V3(x, 0, LOOP.z1), false, LOOP.w, 8)
		K.kerbRamp(f, V3(x, 0, LOOP.z1 - LW - 1.2), V3(0, 0, 1), 8)
		K.kerbRamp(f, V3(x, 0, LOOP.z1 + LW + 1.2), V3(0, 0, -1), 8)
	end
	-- stop bars and signals where Champion Ave meets the loop
	K.stopBar(f, V3(-26, 0, LOOP.z1 + LW / 2), V3(0, 0, 1), LW)
	K.stopBar(f, V3(26, 0, LOOP.z1 - LW / 2), V3(0, 0, 1), LW)
	K.trafficSignal(f, V3(-26, SW_H, LOOP.z1 + LW + 2), V3(0, 0, -1), 20, V3(-1, 0, 0), "GYM LOOP")
	K.trafficSignal(f, V3(26, SW_H, LOOP.z1 - LW - 2), V3(0, 0, 1), 20, V3(1, 0, 0), "GYM LOOP")
	K.trafficSignal(f, V3(-26, SW_H, LOOP.z1 - LW - 2), V3(1, 0, 0), 20, V3(0, 0, 1), "CHAMPION AVE")

	-- member parking east of the plaza: one row of 2.7 x 5 m bays nosing the gym, the aisle open to
	-- the loop road through a dropped kerb (x 180..200); bay 9 stays empty for the player's own car
	local bays = K.parkingLot(f, 40, 200, 100, inZ, { rng = rng, fill = 0.45, reserved = 9, lights = false, stops = true })
	K.kerbRamp(f, V3(190, 0, LOOP.z1 - LW - 1.2), V3(0, 0, 1), 18)
	slab(f, "LotEntry", 181, 199, inZ, LOOP.z1 - LW, ROAD_Y - 0.01, K.ASPHALT_OLD, M.Asphalt)
	local bay = bays[9] or CF(120, ROAD_Y, 109)
	part(f, "ReservedPost", V3(0.3, 4.2, 0.3), bay * CF(0, 2.1, -10), C.steel, M.Metal, { collide = true })
	local rs = part(f, "ReservedSign", V3(3, 1.8, 0.12), bay * CF(0, 4.6, -10), C.white, M.SmoothPlastic)
	rs:SetAttribute("Kind", "Reserved")
	tag(rs, "CityScreen")
	GymDecor.Sign(rs, Enum.NormalId.Back, "RESERVED\nMEMBER OF THE MONTH", Color3.fromRGB(30, 60, 160), C.white, 40)
	site("CarBay", bay)
	-- fans gather along the entrance plaza (count grows with popularity; CityVisuals)
	site("FanGymW", CFrame.lookAt(V3(-14, 0.3, 104), V3(0, 0.3, 104)), { Len = 16, Rows = 2 })
	site("FanGymE", CFrame.lookAt(V3(14, 0.3, 104), V3(0, 0.3, 104)), { Len = 16, Rows = 2 })
	for _, x in ipairs({ 60, 120, 180 }) do
		K.streetLight(f, V3(x, ROAD_Y, 121), V3(0, 0, -1), true, 26)
	end
	local lotSign = part(f, "LotSign", V3(7, 2.8, 0.3), CF(44, 6.2, 140), Color3.fromRGB(30, 60, 160), M.SmoothPlastic)
	part(f, "LotSignPole", V3(0.35, 4.8, 0.35), CF(44, 2.4, 140), C.steel, M.Metal)
	GymDecor.Sign(lotSign, Enum.NormalId.Back, "P  MEMBER PARKING", C.white, Color3.fromRGB(30, 60, 160), 40)
	GymDecor.Sign(lotSign, Enum.NormalId.Front, "P  MEMBER PARKING", C.white, Color3.fromRGB(30, 60, 160), 40)
	K.fenceIron(f, V3(40, 0.3, 100), V3(40, 0.3, 147), 4)
	K.fenceIron(f, V3(40, 0.3, 100), V3(200, 0.3, 100), 4)
	-- a hedge screens the lot from the plaza, trees along its back
	for x = 52, 190, 46 do
		K.tree(f, V3(x, 0.3, 94), "oak", rng:NextNumber(30, 38), rng)
	end

	-- Champions Plaza west of the entrance: paving, the golden glove monument, benches, trees, flags
	slab(f, "PlazaBorder", -200.3, -39.7, 99.7, inZ, 0.3, Color3.fromRGB(120, 110, 100), M.Concrete)
	slab(f, "PlazaPaving", -200, -40, 100, inZ - 0.3, 0.32, K.PAVING, M.Pavement)
	local mon = V3(-120, 0.32, 118)
	part(f, "MonumentBase", V3(14, 1.6, 14), CF(mon + V3(0, 0.8, 0)), Color3.fromRGB(80, 80, 86), M.Granite, { collide = true })
	part(f, "MonumentStep", V3(10, 1.2, 10), CF(mon + V3(0, 2.2, 0)), Color3.fromRGB(70, 70, 76), M.Granite, { collide = true })
	part(f, "MonumentPlinth", V3(6.5, 8, 6.5), CF(mon + V3(0, 6.8, 0)), Color3.fromRGB(60, 60, 66), M.Granite, { collide = true })
	local plaque = part(f, "MonumentPlaque", V3(4.8, 2.2, 0.1), CF(mon + V3(0, 6.4, 3.3)), C.gold, M.Metal)
	GymDecor.Sign(plaque, Enum.NormalId.Back, "CHAMPIONS WALK\nEvery champion started here", Color3.fromRGB(40, 30, 10), C.gold, 40)
	plaque:SetAttribute("Kind", "Plaque")
	tag(plaque, "CityScreen")
	site("Statue", CFrame.lookAt(V3(-92, 0.32, 118), V3(-92, 0.32, 160)))
	site("FanPlaza", CFrame.lookAt(V3(-120, 0.32, 128), V3(-120, 0.32, 118)), { Len = 18, Rows = 1 })
	local gloveCF = CF(mon + V3(0, 15.4, 0)) * ANG(RAD(-12), RAD(25), 0)
	blob(f, "GoldenGlove", V3(6.4, 8.2, 7), gloveCF, C.gold, M.Metal, { reflect = 0.2 })
	blob(f, "GoldenThumb", V3(2.3, 4, 2.4), gloveCF * CF(-2.9, 0.3, -1.4) * ANG(0, 0, RAD(-18)), C.gold, M.Metal, { reflect = 0.2 })
	cyl(f, "GloveCuff", 3.0, 5.2, gloveCF * CF(0, -4.7, 0) * ANG(0, 0, RAD(90)), C.goldDeep, M.Metal)
	for k = 0, 3 do
		part(f, "GloveLace", V3(2.4, 0.18, 0.2), gloveCF * CF(0, -3.6 + k * 0.6, -2.7) * ANG(0, 0, RAD(k % 2 == 0 and 25 or -25)), Color3.fromRGB(150, 110, 20), M.Fabric)
	end
	for _, a in ipairs({ 30, 150, 270 }) do
		local p = mon + V3(math.cos(RAD(a)) * 9.5, 0.1, math.sin(RAD(a)) * 9.5)
		local ml = spot(emitter(f, CF(p + V3(0, 0.6, 0))), Enum.NormalId.Top, Color3.fromRGB(255, 225, 170), 26, 1.6, 50)
		ml.Enabled = false
		tag(ml, "NightLight")
	end
	for _, d in ipairs({ { -176, 108 }, { -64, 108 }, { -176, 140 }, { -64, 140 }, { -150, 142 }, { -90, 142 } }) do
		K.bench(f, V3(d[1], 0.32, d[2]), d[2] > 130 and RAD(180) or 0, 6.4, C.wood)
	end
	for _, x in ipairs({ -190, -160, -80, -50 }) do
		part(f, "TreePlanter", V3(6, 1.6, 6), CF(x, 1.1, 112), Color3.fromRGB(120, 110, 100), M.Concrete, { collide = true })
		K.tree(f, V3(x, 1.9, 112), "oak", rng:NextNumber(26, 32), rng)
		K.bin(f, V3(x + 4.5, 0.32, 108))
	end
	K.flowerBed(f, CF(-120, 0.32, 136), 44, 2.4, rng)
	local flagColors = { { C.red, C.white }, { Color3.fromRGB(18, 18, 22), C.gold }, { C.blue, C.white } }
	for i, x in ipairs({ -136, -120, -104 }) do
		K.flagPole(f, V3(x, 0.32, 145), 36, flagColors[i][1], "WCB", flagColors[i][2])
	end
	for _, x in ipairs({ -196, -44 }) do
		K.parkLamp(f, V3(x, 0.32, 104), true)
		K.parkLamp(f, V3(x, 0.32, 144), true)
	end

	-- the bus stop on the loop's south road, the far side at x -70, a bus pulled up in the lane
	K.busStop(f, CF(-70, 0, LOOP.z1 + LW + 0.6 + 4), "BUS 12 - DOWNTOWN")
	K.bus(f, CF(-70, ROAD_Y, LOOP.z1 + LW / 2 + 0.6) * ANG(0, RAD(-90), 0), nil, "12  DOWNTOWN")
	K.roadSign(f, V3(-96, SW_H, LOOP.z1 + LW + 1.2), RAD(180), "noparking", "BUS\nSTOP\nONLY")

	-- outdoor training yard east of the building: rubber floor, sprint lanes, rigs, tyre, sandbags
	local y0 = V3(192, 0, -20)
	part(f, "YardFloor", V3(60, 0.3, 90), CF(y0 + V3(0, 0.15, 0)), Color3.fromRGB(44, 46, 50), M.Rubber, { collide = true })
	for k = 0, 4 do
		part(f, "SprintLane", V3(0.4, 0.03, 80), CF(y0 + V3(8 + k * 4, 0.315, 0)), C.white, M.SmoothPlastic, { shadow = false })
	end
	for _, z in ipairs({ -34, -22 }) do
		for _, x in ipairs({ -20, -10 }) do
			part(f, "RigPost", V3(0.5, 11, 0.5), CF(y0 + V3(x, 5.8, z)), C.black, M.Metal, { collide = true })
		end
	end
	for _, x in ipairs({ -20, -10 }) do
		cyl(f, "RigBar", 12.4, 0.25, CF(y0 + V3(x, 10.4, -28)) * ANG(0, RAD(90), 0), C.steelLight, M.Metal)
	end
	for _, z in ipairs({ -34, -28, -22 }) do
		cyl(f, "PullUpBar", 10.4, 0.25, CF(y0 + V3(-15, 10.6, z)), C.steelLight, M.Metal)
	end
	for _, x in ipairs({ -18.2, -16.2 }) do
		cyl(f, "ParallelBar", 7, 0.25, CF(y0 + V3(x, 4.4, -4)) * ANG(0, RAD(90), 0), C.steelLight, M.Metal)
		for _, z in ipairs({ -7, -1 }) do
			part(f, "ParallelPost", V3(0.3, 4.2, 0.3), CF(y0 + V3(x, 2.3, z)), C.black, M.Metal)
		end
	end
	vcyl(f, "Tire", 2.4, 8, CF(y0 + V3(-12, 0.3, 22)), Color3.fromRGB(26, 26, 28), M.Rubber, { collide = true })
	vcyl(f, "TireInner", 0.05, 4, CF(y0 + V3(-12, 2.66, 22)), Color3.fromRGB(10, 10, 12), M.Rubber)
	for k = 0, 2 do
		blob(f, "Sandbag", V3(3.2, 1.4, 1.8), CF(y0 + V3(-22, 1.0 + k * 1.2, 32)) * ANG(0, RAD(k * 20), 0), Color3.fromRGB(70, 74, 52), M.Fabric)
	end
	local ysign = part(f, "YardSign", V3(16, 3, 0.4), CF(y0 + V3(0, 8.5, 45.6)), Color3.fromRGB(18, 18, 22), M.SmoothPlastic)
	for _, x in ipairs({ -7.8, 7.8 }) do
		part(f, "YardSignPost", V3(0.4, 7, 0.4), CF(y0 + V3(x, 3.5, 45.6)), C.black, M.Metal)
	end
	GymDecor.Sign(ysign, Enum.NormalId.Back, "OUTDOOR TRAINING YARD", C.gold, Color3.fromRGB(18, 18, 22), 30)
	GymDecor.Sign(ysign, Enum.NormalId.Front, "OUTDOOR TRAINING YARD", C.gold, Color3.fromRGB(18, 18, 22), 30)
	K.fenceChain(f, V3(162, 0.3, -65), V3(222, 0.3, -65), 7)
	K.fenceChain(f, V3(222, 0.3, -65), V3(222, 0.3, 25), 7)
	K.fenceChain(f, V3(162, 0.3, 25), V3(222, 0.3, 25), 7)
	for _, p in ipairs({ V3(165, 0.3, -62), V3(219, 0.3, -62), V3(165, 0.3, 22), V3(219, 0.3, 22) }) do
		K.streetLight(f, p, V3(p.X < 192 and 1 or -1, 0, 0), true, 26)
	end
	-- a path from the plaza round the building to the yard and on to the field
	slab(f, "CampusPath", 112, 160, -22, -14, 0.3, K.PAVING, M.Pavement)
	slab(f, "CampusPath", 156, 164, -22, 100, 0.3, K.PAVING, M.Pavement)
	slab(f, "CampusPath", 30, 164, 92, 100, 0.3, K.PAVING, M.Pavement)
	slab(f, "CampusPath", -164, -30, 92, 100, 0.3, K.PAVING, M.Pavement)
	slab(f, "CampusPath", -164, -156, -160, 100, 0.3, K.PAVING, M.Pavement)
	slab(f, "CampusPath", -164, 164, -168, -160, 0.3, K.PAVING, M.Pavement)
	slab(f, "CampusPath", 156, 164, -168, -22, 0.3, K.PAVING, M.Pavement)
	for _, z in ipairs({ 40, -40, -120 }) do
		K.parkLamp(f, V3(-168, 0.3, z), z == -40)
		K.parkLamp(f, V3(168, 0.3, z), z == -40)
	end
	for _, z in ipairs({ 60, 0, -60, -120 }) do
		K.tree(f, V3(-186, 0.14, z + 12), rng:NextNumber() < 0.5 and "oak" or "maple", rng:NextNumber(30, 40), rng)
		K.tree(f, V3(-132, 0.14, z - 10), "birch", rng:NextNumber(26, 32), rng)
		if z ~= 0 and z ~= -60 then
			K.tree(f, V3(132, 0.14, z - 10), "oak", rng:NextNumber(28, 36), rng)
		end
	end

	-- the training field north of the pool annex: a running track round a lawn, bleachers, floods
	local fc = V3(0, 0, -212)
	part(f, "FieldLawn", V3(300, 0.26, 92), CF(fc + V3(0, 0.13, 0)), K.GRASS_DARK, M.Grass, { collide = true })
	local trackCol = Color3.fromRGB(170, 56, 48)
	part(f, "Track", V3(200, 0.3, 9), CF(fc + V3(0, 0.15, -50)), trackCol, M.Rubber, { collide = true })
	part(f, "Track", V3(200, 0.3, 9), CF(fc + V3(0, 0.15, 50)), trackCol, M.Rubber, { collide = true })
	for _, s in ipairs({ -1, 1 }) do
		for k = 0, 7 do
			local a0 = -math.pi / 2 + k * math.pi / 8
			local a1 = a0 + math.pi / 8
			local pa = fc + V3(100 * s + math.cos(a0) * 50 * s, 0.15, math.sin(a0) * 50)
			local pb = fc + V3(100 * s + math.cos(a1) * 50 * s, 0.15, math.sin(a1) * 50)
			part(f, "TrackBend", V3(9, 0.3, (pb - pa).Magnitude + 1.2), CFrame.lookAt((pa + pb) / 2, pb), trackCol, M.Rubber, { collide = true })
		end
	end
	for k = 1, 3 do
		part(f, "TrackLine", V3(200, 0.02, 0.3), CF(fc + V3(0, 0.31, -54.5 + k * 2.25)), C.white, M.SmoothPlastic, { shadow = false })
		part(f, "TrackLine", V3(200, 0.02, 0.3), CF(fc + V3(0, 0.31, 54.5 - k * 2.25)), C.white, M.SmoothPlastic, { shadow = false })
	end
	for k = 0, 2 do
		part(f, "Bleacher", V3(60, 1.6, 3.2), CF(fc + V3(0, 0.8 + k * 1.6, -66 - k * 3.2)), Color3.fromRGB(150, 152, 160), M.Metal, { collide = true })
	end
	part(f, "BleacherBack", V3(60, 6, 0.4), CF(fc + V3(0, 3, -76)), Color3.fromRGB(120, 122, 130), M.Metal, { collide = true })
	for _, p in ipairs({ V3(-120, 0, -268), V3(120, 0, -268), V3(-120, 0, -156), V3(120, 0, -156) }) do
		part(f, "FloodMast", V3(1.4, 60, 1.4), CF(p + V3(0, 30, 0)), Color3.fromRGB(70, 72, 80), M.Metal, { collide = true })
		local head = part(f, "FloodHead", V3(10, 3.2, 1.2), CFrame.lookAt(p + V3(0, 58, 0), fc + V3(0, 10, 0)), Color3.fromRGB(255, 255, 235), M.Neon, { shadow = false })
		local l = spot(emitter(f, head.CFrame * CF(0, 0, -1)), Enum.NormalId.Front, Color3.fromRGB(240, 245, 255), 160, 1.6, 60)
		l.Enabled = false
		tag(l, "NightLight")
	end
	local fsign = part(f, "FieldSign", V3(22, 3.2, 0.4), CF(fc + V3(0, 8.8, 70)), Color3.fromRGB(18, 18, 22), M.SmoothPlastic)
	for _, x in ipairs({ -10.5, 10.5 }) do
		part(f, "FieldSignPost", V3(0.5, 7.2, 0.5), CF(fc + V3(x, 3.6, 70)), C.black, M.Metal)
	end
	GymDecor.Sign(fsign, Enum.NormalId.Front, "WCB TRAINING FIELD", C.gold, Color3.fromRGB(18, 18, 22), 30)
	GymDecor.Sign(fsign, Enum.NormalId.Back, "WCB TRAINING FIELD", C.gold, Color3.fromRGB(18, 18, 22), 30)
	for _, x in ipairs({ -210, -190, 190, 210 }) do
		K.tree(f, V3(x, 0.14, -212 + (x % 40 == 0 and 20 or -20)), "poplar", rng:NextNumber(40, 50), rng)
	end

	-- street lights and trees along the loop's inner sidewalk
	local lights = folder(f, "LoopLights")
	lightsX(lights, -200, 200, LOOP.z1 - LW - 1.4, V3(0, 0, 1), 80, nil, 1)
	lightsX(lights, -200, 200, LOOP.z0 + LW + 1.4, V3(0, 0, -1), 80, nil, 1)
	lightsZ(lights, -240, 120, LOOP.x0 + LW + 1.4, V3(-1, 0, 0), 80, nil, 1)
	lightsZ(lights, -240, 120, LOOP.x1 - LW - 1.4, V3(1, 0, 0), 80, nil, 1)
	treesX(f, -160, 160, LOOP.z0 + LW + 5, 40, rng)
	treesZ(f, -200, 80, LOOP.x0 + LW + 5, 40, rng)
	treesZ(f, -200, 80, LOOP.x1 - LW - 5, 40, rng)
	K.streetSign(f, V3(-24, SW_H, LOOP.z1 - LW - 2), "GYM LOOP", 0, "CHAMPION AVE")
	lightZone(f, "CampusZone", V3(LOOP.x1 - LOOP.x0, 60, LOOP.z1 - LOOP.z0), CF(0, 30, (LOOP.z0 + LOOP.z1) / 2), "Street")
end

------------------------------------------------------------------------
-- Downtown: Champion Ave, Main Street and its rows, the fire station, 2nd Street and the towers
------------------------------------------------------------------------
local function walkOfFame(f)
	-- the all-time greats on the west sidewalk of Champion Ave; your own stars face them on the east
	-- sidewalk (CityVisuals, Site_WalkOfFame, Step studs apart)
	local k = 0
	for z = 200, 290, 7 do
		k += 1
		local lg = Config.Legends[k]
		if lg then
			CityProps.Star(f, CF(-17.5, SW_H + 0.03, z), "LEGACY " .. lg.score, lg.name)
		end
	end
	site("WalkOfFame", CF(17.5, SW_H + 0.03, 200), { Step = 7, Max = 13 })
	local post = part(f, "FameSignPost", V3(0.35, 7, 0.35), CF(-21, SW_H + 3.5, 194), C.steel, M.Metal, { collide = true })
	local fs = part(f, "FameSign", V3(6.4, 2.0, 0.12), CF(-21, SW_H + 7.6, 194), Color3.fromRGB(60, 30, 50), M.SmoothPlastic)
	GymDecor.Sign(fs, Enum.NormalId.Back, "WALK OF FAME", C.gold, Color3.fromRGB(60, 30, 50), 40)
	GymDecor.Sign(fs, Enum.NormalId.Front, "WALK OF FAME", C.gold, Color3.fromRGB(60, 30, 50), 40)
	return post
end

-- the fire station on Main Street's north side, west of Oak Street (front at z frontN, facing south)
local function fireStation(f, rng)
	local x0, x1 = -600, -480
	local cx, w = (x0 + x1) / 2, x1 - x0
	local front = MAIN.frontN
	local red = Color3.fromRGB(176, 40, 40)
	local brick = Color3.fromRGB(150, 84, 64)
	-- apparatus bay (one tall storey) with three roller doors, the office block beside it, the tower
	local bayW, bayH, depth = 76, 20, 60
	part(f, "FireBay", V3(bayW, bayH, depth), CF(x0 + bayW / 2, bayH / 2, front - depth / 2), brick, M.Brick, { collide = true })
	for k = 0, 2 do
		local dx = x0 + 12 + k * 26
		local fd = part(f, "FireDoor", V3(20, 15, 0.4), CF(dx, 7.5 + SW_H, front - 0.5), red, M.Metal, { collide = true })
		local dsg = gui(fd, Enum.NormalId.Front, 6, 1, 300)
		for r = 0, 4 do
			frame(dsg, { Size = UDim2.new(1, 0, 0, 2), Position = UDim2.fromScale(0, 0.18 + r * 0.18), BackgroundColor3 = Color3.fromRGB(110, 20, 20) })
		end
		part(f, "FireDoorFrame", V3(21, 0.8, 0.8), CF(dx, 15.9 + SW_H, front - 0.4), C.white, M.Concrete)
		part(f, "BayNumber", V3(3, 3, 0.1), CF(dx, 17.6 + SW_H, front - 0.45), C.white, M.SmoothPlastic)
	end
	local apron = part(f, "FireApron", V3(bayW + 4, ROAD_Y, MAIN.z0 - front + 0.6), CF(x0 + bayW / 2, ROAD_Y / 2, (front + MAIN.z0) / 2), Color3.fromRGB(160, 160, 158), M.Concrete, { collide = true })
	local _ = apron
	K.lineX(f, x0 - 2, x0 + bayW + 2, front + 4, K.LINE_YELLOW, 0.5, "ApronLine")
	local officeW = w - bayW - 4
	local m = K.building(f, CF(x1 - officeW / 2, 0, front), officeW, depth - 10, 1, { color = brick, mat = M.Brick, retail = false, sign = "FIRE STATION 7", signBg = Color3.fromRGB(120, 20, 20), signFg = C.white, rng = rng, units = 1, name = "FireOffice" })
	m:SetAttribute("Sign", "FIRE STATION 7")
	part(f, "HoseTower", V3(12, 46, 12), CF(x1 - 10, 23, front - depth + 8), brick, M.Brick, { collide = true })
	part(f, "HoseTowerCap", V3(13.5, 1.6, 13.5), CF(x1 - 10, 46.8, front - depth + 8), C.white, M.Concrete)
	local band = part(f, "FireBand", V3(bayW, 3.4, 0.4), CF(x0 + bayW / 2, bayH - 2.4, front - 0.4), Color3.fromRGB(120, 20, 20), M.SmoothPlastic)
	GymDecor.Sign(band, Enum.NormalId.Front, "CITY FIRE DEPARTMENT  -  STATION 7", C.white, Color3.fromRGB(120, 20, 20), 30)
	K.flagPole(f, V3(x1 - 30, SW_H, front - 3), 36, C.red, "FD", C.white)
	-- the engine on the apron
	local eng = CF(x0 + 38, ROAD_Y, front + 14) * ANG(0, RAD(180), 0)
	part(f, "FireEngine", V3(8.6, 7.4, 34), eng * CF(0, 1.6 + 3.7, 0), red, M.SmoothPlastic, { collide = true })
	part(f, "EngineCab", V3(8.4, 6, 9), eng * CF(0, 1.6 + 7.4 + 3, -11), red, M.SmoothPlastic)
	part(f, "EngineGlass", V3(8.0, 3.2, 0.2), eng * CF(0, 1.6 + 7.4 + 3.2, -15.55), Color3.fromRGB(40, 54, 70), M.Glass, { shadow = false })
	part(f, "EngineLadder", V3(2.2, 0.6, 28), eng * CF(0, 1.6 + 7.4 + 0.5, 2), Color3.fromRGB(200, 204, 210), M.Metal)
	part(f, "EngineLightBar", V3(6, 0.8, 1.6), eng * CF(0, 1.6 + 7.4 + 6.4, -11), Color3.fromRGB(255, 60, 60), M.Neon, { shadow = false })
	for _, x in ipairs({ -3.8, 3.8 }) do
		for _, z in ipairs({ -10, 6, 11 }) do
			cyl(f, "Wheel", 1.2, 3.4, eng * CF(x, 1.7, z), Color3.fromRGB(22, 22, 26), M.Rubber)
		end
	end
	K.hydrant(f, V3(x0 + 4, SW_H, front + 2))
	lightZone(f, "FireZone", V3(w, bayH, depth), CF(cx, bayH / 2, front - depth / 2), "Store")
end

local function buildDowntown(root)
	local f = folder(root, "MainStreet")
	local rng = Random.new(1987)
	-- Champion Ave: from the loop to Main Street, sidewalks with the Walk of Fame, trees and lamps
	K.roadZ(f, "ChampionAve", AVE.z0, AVE.z1, AVE.x, AVE.w, { y = ROAD_Y - 0.004, sw = { w = 10, e = 10 } })
	walkOfFame(f)
	for z = 205, 285, 20 do
		K.streetLight(f, V3(-21.5, SW_H, z), V3(1, 0, 0), true)
		K.streetLight(f, V3(21.5, SW_H, z + 10), V3(-1, 0, 0), true)
	end
	for z = 212, 282, 24 do
		K.streetTree(f, V3(-21, SW_H, z), rng, 28)
		K.streetTree(f, V3(21, SW_H, z + 6), rng, 28)
	end
	K.crosswalk(f, V3(AVE.x, 0, 298), true, AVE.w, 8)
	K.crosswalk(f, V3(AVE.x, 0, 185), true, AVE.w, 8)
	K.streetSign(f, V3(-21, SW_H, 198), "CHAMPION AVE", RAD(90))

	-- Main Street: two 12.5 lanes between parking lanes, a double yellow centre line, white edge
	-- lines at the parking lanes, crosswalks and signals at Champion Ave, Oak Street and Riverside Drive
	local gasGap = { CityShops.GAS.x0, CityShops.GAS.x1 }
	K.roadX(f, "MainStreet", MAIN.x0, MAIN.x1, (MAIN.z0 + MAIN.z1) / 2, MAIN.z1 - MAIN.z0, {
		center = "double", sw = { n = 10, s = MAIN.frontS - MAIN.z1 },
		gaps = { { CITY.RiversideDrive.x - 12.5, CITY.RiversideDrive.x + 12.5 } },
		gapsN = { { AVE.x - AVE.w / 2, AVE.x + AVE.w / 2 }, { CITY.OakStreet.x - 12.5, CITY.OakStreet.x + 12.5 } },
		gapsS = { gasGap },
	})
	for _, z in ipairs({ MAIN.z0 + 8.5, MAIN.z1 - 8.5 }) do
		for _, r in ipairs(K.cutRanges(MAIN.x0, MAIN.x1, { { -22, 22 }, { CITY.OakStreet.x - 22, CITY.OakStreet.x + 22 }, { CITY.RiversideDrive.x - 22, CITY.RiversideDrive.x + 22 }, gasGap })) do
			K.lineX(f, r[1], r[2], z, K.LINE_WHITE, 0.4, "EdgeLine")
		end
	end
	local function junction(x, name, cross, legs)
		for _, cx in ipairs({ x - 17, x + 17 }) do
			K.crosswalk(f, V3(cx, 0, (MAIN.z0 + MAIN.z1) / 2), false, MAIN.z1 - MAIN.z0, 8)
		end
		K.stopBar(f, V3(x - 24, 0, MAIN.lanes[1].z), V3(0, 0, 1), 12.5)
		K.stopBar(f, V3(x + 24, 0, MAIN.lanes[2].z), V3(0, 0, 1), 12.5)
		K.trafficSignal(f, V3(x - 24, SW_H, MAIN.z1 + 3), V3(0, 0, -1), 24, V3(-1, 0, 0), name)
		K.trafficSignal(f, V3(x + 24, SW_H, MAIN.z0 - 3), V3(0, 0, 1), 24, V3(1, 0, 0), name)
		if legs.n then
			K.crosswalk(f, V3(x, 0, MAIN.z0 - 4), true, 25, 8)
			K.trafficSignal(f, V3(x - 24, SW_H, MAIN.z0 - 3), V3(1, 0, 0), 20, V3(0, 0, 1), cross)
		end
		if legs.s then
			K.crosswalk(f, V3(x, 0, MAIN.z1 + 4), true, 25, 8)
			K.trafficSignal(f, V3(x + 24, SW_H, MAIN.z1 + 3), V3(-1, 0, 0), 20, V3(0, 0, -1), cross)
		end
		for _, dx in ipairs({ -19, 19 }) do
			K.kerbRamp(f, V3(x + dx, 0, MAIN.z0 - 1.2), V3(0, 0, 1), 8)
			K.kerbRamp(f, V3(x + dx, 0, MAIN.z1 + 1.2), V3(0, 0, -1), 8)
		end
	end
	junction(AVE.x, "MAIN ST", "CHAMPION AVE", { n = true })
	junction(CITY.OakStreet.x, "MAIN ST", "OAK ST", { n = true })
	junction(CITY.RiversideDrive.x, "MAIN ST", "RIVERSIDE DR", { n = true, s = true })
	K.streetSign(f, V3(-27, SW_H, MAIN.z1 + 3), "MAIN ST", 0, "CHAMPION AVE")
	K.roadSign(f, V3(120, SW_H, MAIN.z0 - 2), RAD(180), "speed", "25")
	K.roadSign(f, V3(-300, SW_H, MAIN.z1 + 2), 0, "speed", "25")
	-- parked cars in both parking lanes, lights and trees along both sidewalks
	local carX = { -520, -470, -360, -290, -230, -150, -100, -50, 60, 110, 180, 250, 330, 420, 470, 700 }
	for i, x in ipairs(carX) do
		local south = i % 3 ~= 0
		local z = south and MAIN.parkLanes[2] or MAIN.parkLanes[1]
		local kinds = { "sedan", "hatch", "suv", "sedan", "pickup", "taxi", "van" }
		K.car(f, CF(x, ROAD_Y, z) * ANG(0, RAD(south and -90 or 90), 0), K.CAR_COLORS[(i * 3) % #K.CAR_COLORS + 1], kinds[(i % #kinds) + 1])
	end
	lightsX(f, -590, 850, MAIN.z0 - 1.6, V3(0, 0, 1), 60, nil, 2)
	lightsX(f, -560, 820, MAIN.z1 + 1.6, V3(0, 0, -1), 60, nil, 2)
	treesX(f, -575, 835, MAIN.z0 - 5.5, 30, rng, { { -30, 30 }, { CITY.OakStreet.x - 30, CITY.OakStreet.x + 30 }, { CITY.RiversideDrive.x - 30, CITY.RiversideDrive.x + 30 }, { -610, -470 } })
	treesX(f, -545, 520, MAIN.z1 + 8, 30, rng, { { -30, 30 }, { 150, 300 } })
	-- the rows of shops: the south row facing north (towards the gym), the north row facing south
	CityShops.BuildRow(f, CF(0, 0, MAIN.frontS), 0, rng)
	local north = folder(root, "NorthRow")
	-- (row-local x runs west: Champion Ave's sidewalks, x -22.5..22.5, stay open)
	CityShops.BuildNorthRow(north, CF(0, 0, MAIN.frontN) * ANG(0, math.pi, 0), math.pi, -MAIN.northRowX[2], -MAIN.northRowX[1], rng, { { -AVE.x - AVE.w / 2 - 12, -AVE.x + AVE.w / 2 + 12 } })
	-- the service alley behind the north row and its dumpsters
	slab(north, "Alley", MAIN.northRowX[1], MAIN.northRowX[2], LOOP.z1 + LW + OUTER + 0.6, MAIN.frontN - 46, ROAD_Y - 0.02, K.ASPHALT_OLD, M.Asphalt)
	for x = MAIN.northRowX[1] + 30, MAIN.northRowX[2] - 20, 90 do
		K.dumpster(north, CF(x, ROAD_Y, MAIN.frontN - 50), (x % 180 == 0) and Color3.fromRGB(40, 60, 120) or nil)
		K.streetLight(north, V3(x + 40, ROAD_Y, MAIN.frontN - 52), V3(0, 0, -1), true, 24)
	end
	fireStation(north, rng)
	-- the park's railing along Main Street's north sidewalk east of the row, with gates
	local parkZ = MAIN.frontN
	for _, r in ipairs(K.cutRanges(CITY.Park.x0, CITY.Park.x1, { { 330, 342 }, { 540, 552 } })) do
		K.fenceIron(f, V3(r[1], SW_H, parkZ), V3(r[2], SW_H, parkZ), 5)
	end
	-- 2nd Street and the towers behind the shops' backs
	local S2 = CITY.SecondStreet
	K.roadX(f, "SecondStreet", S2.x0, S2.x1, S2.z, S2.w, { sw = { n = 10, s = 12 }, gaps = { { CITY.RiversideDrive.x - 12.5, CITY.RiversideDrive.x + 12.5 } } })
	slab(f, "BackLot", -560, 520, MAIN.frontS + 44.5, S2.z - S2.w / 2 - 10.6, ROAD_Y - 0.02, K.ASPHALT_OLD, M.Asphalt)
	for x = -520, 500, 120 do
		K.dumpster(f, CF(x, ROAD_Y, MAIN.frontS + 48))
		K.car(f, CF(x + 30, ROAD_Y, S2.z - 24) * ANG(0, RAD(180), 0), K.CAR_COLORS[(x // 120) % #K.CAR_COLORS + 1], "sedan")
		K.streetLight(f, V3(x + 60, ROAD_Y, MAIN.frontS + 60), V3(0, 0, 1), x % 240 == 0, 26)
	end
	lightsX(f, -580, 760, S2.z + S2.w / 2 + 1.6, V3(0, 0, -1), 70, nil, 2)
	local towers = {
		{ x = -520, w = 90, d = 70, h = 180, tone = 2, name = "FIRST CITY BANK TOWER" },
		{ x = -360, w = 80, d = 60, h = 140, tone = 1, name = "MERIDIAN OFFICES" },
		{ x = -200, w = 110, d = 70, h = 220, tone = 4, name = "GRAND HOTEL", crown = true },
		{ x = -40, w = 90, d = 60, h = 160, tone = 2, name = "WCB SPORTS NETWORK" },
		{ x = 110, w = 70, d = 60, h = 110, tone = 3, name = "RIVER COURT" },
		{ x = 250, w = 80, d = 70, h = 200, tone = 0, name = "APEX ATHLETICS HQ" },
		{ x = 400, w = 100, d = 70, h = 130, tone = 1, name = "CITY HALL ANNEX" },
		{ x = 560, w = 90, d = 60, h = 90, tone = 3, name = "HARBOUR HOUSE" },
	}
	local zf = S2.z + S2.w / 2 + 12 -- the towers' front line
	for i, t in ipairs(towers) do
		local m = K.tower(f, V3(t.x, 0, zf + t.d / 2), t.w, t.d, t.h, V3(0, 0, -1), rng, { tone = t.tone, crown = t.crown, range = 1600, name = "DowntownTower" })
		-- a lobby across the ground floor and a name band
		part(m, "LobbyGlass", V3(t.w * 0.8, 12, 0.3), CF(t.x, 6.8, zf - 0.1), Color3.fromRGB(150, 190, 220), M.Glass, { transparency = 0.4, reflect = 0.15, shadow = false })
		part(m, "LobbyCanopy", V3(t.w * 0.5, 0.6, 9), CF(t.x, 13.4, zf - 4.5), Color3.fromRGB(30, 30, 34), M.Metal)
		part(m, "LobbyDoor", V3(10, 8, 0.3), CF(t.x, SW_H + 4, zf - 0.35), Color3.fromRGB(30, 30, 34), M.Metal)
		local nb = part(m, "TowerName", V3(t.w * 0.6, 2.6, 0.3), CF(t.x, 16.2, zf - 0.3), Color3.fromRGB(20, 20, 24), M.SmoothPlastic)
		GymDecor.Sign(nb, Enum.NormalId.Front, t.name, C.gold, Color3.fromRGB(20, 20, 24), 30)
		slab(f, "TowerPlaza", t.x - t.w / 2 - 6, t.x + t.w / 2 + 6, zf - 12, zf, SW_H, K.PAVING, M.Pavement)
		K.planter(f, CF(t.x - t.w * 0.35, SW_H, zf - 6), 8, 2.6)
		K.planter(f, CF(t.x + t.w * 0.35, SW_H, zf - 6), 8, 2.6)
		if i % 2 == 0 then
			K.bench(f, V3(t.x - t.w * 0.2, SW_H, zf - 8), 0, 6.4, C.wood)
		else
			K.tree(f, V3(t.x + t.w * 0.2, SW_H, zf - 7), "cherry", 24, rng)
		end
	end
	-- the WCB Sports Network's rooftop screen is a billboard (slot "Network")
	K.billboard(f, CFrame.lookAt(V3(-40, 160 + 14, zf + 2), V3(-40, 174, zf - 100)), 50, 16, "Network", K.ADS[8], 8)
	-- the public lot and the market hall east of the gas station
	K.parkingLot(f, 660, 740, MAIN.frontS, MAIN.frontS + 60, { rng = rng, fill = 0.4 })
	local mk = CF(815, 0, MAIN.frontS)
	part(f, "MarketHall", V3(70, 16, 60), mk * CF(0, 8, 30), Color3.fromRGB(96, 60, 46), M.Brick, { collide = true })
	part(f, "MarketRoof", V3(74, 1, 64), mk * CF(0, 16.5, 30), Color3.fromRGB(60, 62, 70), M.Metal)
	blob(f, "MarketVault", V3(60, 14, 60), mk * CF(0, 17, 30), Color3.fromRGB(70, 72, 80), M.Metal)
	for k = 0, 2 do
		part(f, "MarketArch", V3(14, 13, 0.6), mk * CF(-20 + k * 20, 6.5 + SW_H, -0.2), Color3.fromRGB(40, 54, 70), M.Glass, { transparency = 0.3, reflect = 0.1 })
	end
	local ms = part(f, "MarketSign", V3(40, 3.6, 0.4), CF(815, 13.8, MAIN.frontS - 0.3), Color3.fromRGB(20, 40, 60), M.SmoothPlastic)
	GymDecor.Sign(ms, Enum.NormalId.Front, "DOCKSIDE MARKET  -  FISH  ·  PRODUCE  ·  FLOWERS", Color3.fromRGB(255, 230, 170), Color3.fromRGB(20, 40, 60), 30)
	for k = 0, 3 do
		K.vendorCart(f, CF(790 + k * 16, SW_H, MAIN.frontS - 6) * ANG(0, 0, 0), ({ "fruit", "coffee", "pretzel", "icecream" })[k + 1])
	end
	lightZone(f, "StreetZone", V3(MAIN.x1 - MAIN.x0, 60, 200), CF((MAIN.x0 + MAIN.x1) / 2, 30, 330), "Street")
end

------------------------------------------------------------------------
-- West: Oak Street's houses, Cedar Lane, the hills; Hillcrest Estates at the top of the street
------------------------------------------------------------------------
-- a two-storey house with a gable roof, porch, attached garage and driveway. center = the house's
-- ground centre, front = unit vector towards the street, kerbX = the street's kerb line distance
local function house(f, center, front, rng, i, kerbDist)
	local W, D, H, R = 36, 30, 21, 9
	local base = CFrame.lookAt(center, center + front) -- local -Z = front, X = along the street
	local color = K.HOUSE_COLORS[(i - 1) % #K.HOUSE_COLORS + 1]
	local trim = C.white
	local roofColor = ({ Color3.fromRGB(80, 50, 40), Color3.fromRGB(60, 62, 70), Color3.fromRGB(110, 60, 44), Color3.fromRGB(70, 80, 90) })[i % 4 + 1]
	local m = model(f, "House")
	part(m, "House", V3(W, H, D), base * CF(0, H / 2, 0), color, i % 3 == 0 and M.Brick or M.WoodPlanks, { collide = true })
	part(m, "StoreyBand", V3(W + 0.3, 0.5, D + 0.3), base * CF(0, H / 2, 0), trim, M.Wood, { shadow = false })
	local a = (base * CF(0, H + R / 2, -D / 4)).Position
	local b = (base * CF(0, H + R / 2, D / 4)).Position
	part(m, "Roof", V3(W + 1.6, R, D / 2 + 0.8), CFrame.lookAt(a, a + front), roofColor, M.Slate, { class = "WedgePart", collide = true })
	part(m, "Roof", V3(W + 1.6, R, D / 2 + 0.8), CFrame.lookAt(b, b - front), roofColor, M.Slate, { class = "WedgePart", collide = true })
	part(m, "Chimney", V3(2.4, 7, 2.4), base * CF(W * 0.3, H + R - 1, D * 0.15), Color3.fromRGB(130, 70, 56), M.Brick)
	-- door, porch on columns, windows up and down
	local doorX = -W * 0.2
	part(m, "Door", V3(CITY.Door.w, CITY.Door.h, 0.25), base * CF(doorX, 0.6 + CITY.Door.h / 2, -D / 2 - 0.12), ({ C.red, Color3.fromRGB(30, 60, 120), Color3.fromRGB(30, 90, 60), Color3.fromRGB(60, 40, 30) })[i % 4 + 1], M.Wood)
	part(m, "Porch", V3(12, 0.8, 6), base * CF(doorX, 0.4, -D / 2 - 3), Color3.fromRGB(150, 140, 130), M.Concrete, { collide = true })
	part(m, "PorchStep", V3(6, 0.4, 1.6), base * CF(doorX, 0.2, -D / 2 - 6.8), Color3.fromRGB(150, 140, 130), M.Concrete, { collide = true })
	part(m, "PorchRoof", V3(12.6, 0.5, 6.6), base * CF(doorX, 10.2, -D / 2 - 3.2), color:Lerp(Color3.new(0, 0, 0), 0.3), M.WoodPlanks)
	for _, x in ipairs({ -5.4, 5.4 }) do
		vcyl(m, "PorchColumn", 9.4, 0.8, base * CF(doorX + x, 0.8, -D / 2 - 5.4), trim, M.Wood, { collide = true })
	end
	for _, w in ipairs({ { W * 0.16, 6 }, { W * 0.36, 6 }, { -W * 0.3, 15.5 }, { -W * 0.05, 15.5 }, { W * 0.2, 15.5 }, { W * 0.4, 15.5 } }) do
		part(m, "HouseWindow", V3(4.2, 4.6, 0.15), base * CF(w[1], w[2], -D / 2 - 0.08), Color3.fromRGB(170, 205, 230), M.Glass, { transparency = 0.25, shadow = false })
		part(m, "WindowTrim", V3(4.8, 0.35, 0.35), base * CF(w[1], w[2] - 2.5, -D / 2 - 0.15), trim, M.Wood, { shadow = false })
		part(m, "WindowShutter", V3(1.0, 4.6, 0.12), base * CF(w[1] - 2.7, w[2], -D / 2 - 0.1), roofColor, M.Wood, { shadow = false })
		part(m, "WindowShutter", V3(1.0, 4.6, 0.12), base * CF(w[1] + 2.7, w[2], -D / 2 - 0.1), roofColor, M.Wood, { shadow = false })
	end
	for _, w in ipairs({ { -D * 0.25, 6 }, { D * 0.25, 6 }, { -D * 0.25, 15.5 }, { D * 0.25, 15.5 } }) do
		part(m, "HouseWindow", V3(0.15, 4.6, 4.2), base * CF(-W / 2 - 0.08, w[2], w[1]), Color3.fromRGB(170, 205, 230), M.Glass, { transparency = 0.25, shadow = false })
	end
	-- the garage wing on the right, its driveway to the kerb
	local gx = W / 2 + 9
	part(m, "Garage", V3(18, 11, 26), base * CF(gx, 5.5, 2), color, M.WoodPlanks, { collide = true })
	part(m, "GarageRoof", V3(19.6, 0.6, 27.6), base * CF(gx, 11.3, 2), roofColor, M.Slate)
	local gd = part(m, "GarageDoor", V3(14, 8.5, 0.3), base * CF(gx, 4.25 + 0.4, -11.2), Color3.fromRGB(236, 236, 232), M.SmoothPlastic, { collide = true })
	local gsg = gui(gd, Enum.NormalId.Front, 6, 1, 200)
	for r = 0, 3 do
		frame(gsg, { Size = UDim2.new(1, 0, 0, 2), Position = UDim2.fromScale(0, 0.2 + r * 0.2), BackgroundColor3 = Color3.fromRGB(190, 190, 186) })
	end
	part(m, "Driveway", V3(14, 0.2, kerbDist - 11), base * CF(gx, 0.1, -(11 + (kerbDist - 11) / 2)), Color3.fromRGB(150, 148, 144), M.Concrete, { collide = true })
	part(m, "FrontPath", V3(3.6, 0.18, kerbDist - D / 2 - 7.6), base * CF(doorX, 0.09, -(D / 2 + 7.6 + (kerbDist - D / 2 - 7.6) / 2)), Color3.fromRGB(180, 176, 168), M.Concrete, { collide = true })
	-- lawn, hedge along the front, a tree, the mailbox at the kerb
	part(m, "Lawn", V3(W + 36, 0.16, kerbDist + D / 2 + 4), base * CF(4, 0.08, (-kerbDist + D / 2 + 4) / 2), ({ K.GRASS, K.GRASS_DRY, Color3.fromRGB(104, 150, 78) })[i % 3 + 1], M.Grass, { collide = true })
	K.hedge(m, base * CF(W * 0.3, 0.16, -D / 2 - 2.2), 11, 3.2, 2.4)
	K.tree(m, (base * CF(-W / 2 - 8, 0.16, -D / 2 - 6)).Position, ({ "oak", "maple", "birch", "cherry" })[i % 4 + 1], rng:NextNumber(30, 42), rng)
	local mb = base * CF(doorX + 5, 0, -kerbDist + 2)
	part(m, "MailboxPost", V3(0.3, 4, 0.3), mb * CF(0, 2, 0), C.wood, M.Wood)
	part(m, "Mailbox", V3(1.0, 1.0, 1.8), mb * CF(0, 4.4, 0), ({ C.black, C.blue, C.red })[i % 3 + 1], M.Metal)
	if rng:NextNumber() < 0.6 then
		K.car(m, base * CF(gx, 0.2, -D / 2 - 14) * ANG(0, RAD(180), 0), K.CAR_COLORS[rng:NextInteger(1, #K.CAR_COLORS)], ({ "sedan", "suv", "pickup", "hatch" })[rng:NextInteger(1, 4)])
	end
	-- a few things that say somebody lives here
	local srng = Random.new(900 + i)
	local story = {}
	for k = 1, 6 do
		story[k] = k
	end
	for k = #story, 2, -1 do
		local j = srng:NextInteger(1, k)
		story[k], story[j] = story[j], story[k]
	end
	for n = 1, 2 do
		local kind = story[n]
		if kind == 1 then -- bins at the kerb
			for k, col in ipairs({ Color3.fromRGB(40, 90, 50), Color3.fromRGB(40, 60, 120) }) do
				part(m, "Bin", V3(2.0, 3.6, 2.0), base * CF(gx - 10 + k * 2.4, 1.8, -kerbDist + 2), col, M.SmoothPlastic, { collide = true })
			end
		elseif kind == 2 then -- porch light that comes on at dusk
			part(m, "PorchLamp", V3(0.6, 0.9, 0.4), base * CF(doorX + 2.6, 7.4, -D / 2 - 0.3), Color3.fromRGB(255, 230, 170), M.Neon, { shadow = false })
			nightPoint(m, base * CF(doorX + 2.6, 7.2, -D / 2 - 1.6), Color3.fromRGB(255, 214, 150), 16, 0.8)
		elseif kind == 3 then -- a heavy bag under a frame in the side yard
			part(m, "YardBagFrame", V3(0.4, 10, 0.4), base * CF(-W / 2 - 4, 5, D / 2 - 2), C.steel, M.Metal)
			part(m, "YardBagArm", V3(3, 0.4, 0.4), base * CF(-W / 2 - 5.4, 9.8, D / 2 - 2), C.steel, M.Metal)
			part(m, "BagChain", V3(0.15, 1.6, 0.15), base * CF(-W / 2 - 6.6, 8.9, D / 2 - 2), C.steelLight, M.Metal)
			cyl(m, "YardBag", 4.4, 1.9, base * CF(-W / 2 - 6.6, 5.9, D / 2 - 2) * ANG(0, 0, RAD(90)), Color3.fromRGB(120, 26, 30), M.Leather)
		elseif kind == 4 then -- lawn sign cheering on the local fighter (CityVisuals writes your name on it)
			part(m, "LawnSignStake", V3(0.15, 3, 0.15), base * CF(W * 0.34, 1.5, -D / 2 - 9), C.wood, M.Wood)
			local ls = part(m, "LawnSign", V3(3.2, 2.0, 0.08), base * CF(W * 0.34, 3.4, -D / 2 - 9), C.white, M.SmoothPlastic)
			GymDecor.Sign(ls, Enum.NormalId.Front, "SUPPORT\nLOCAL BOXING", C.red, C.white, 40)
			ls:SetAttribute("Kind", "LawnSign")
			tag(ls, "CityScreen")
		elseif kind == 5 then -- picket fence along the front lawn
			local fa = (base * CF(-W / 2 - 18, 0.16, -kerbDist + 3)).Position
			local fb = (base * CF(doorX - 3, 0.16, -kerbDist + 3)).Position
			K.fencePicket(m, fa, fb)
		else -- a basketball hoop over the driveway and a kid's bike
			part(m, "HoopPole", V3(0.4, 12, 0.4), base * CF(gx + 7.4, 6, -D / 2 - 8), C.steel, M.Metal)
			part(m, "HoopBoard", V3(4.4, 3, 0.2), base * CF(gx + 6.6, 11.4, -D / 2 - 8) * ANG(0, RAD(90), 0), C.white, M.SmoothPlastic)
			cyl(m, "HoopRim", 0.2, 1.8, base * CF(gx + 5.4, 10.2, -D / 2 - 8) * ANG(0, 0, RAD(90)), Color3.fromRGB(240, 110, 30), M.Metal)
		end
	end
	return m
end

-- the empty lot on Oak Street that becomes YOUR house (CityVisuals.houseBuild builds it at the site)
local function homeLot(f, center, front, kerbDist)
	local base = CFrame.lookAt(center, center + front)
	part(f, "HomeLawn", V3(66, 0.16, kerbDist + 24), base * CF(2, 0.08, (-kerbDist + 24) / 2 - 2), Color3.fromRGB(84, 134, 66), M.Grass, { collide = true })
	part(f, "Driveway", V3(14, 0.2, kerbDist - 4), base * CF(19, 0.1, -(kerbDist + 4) / 2 - 2), Color3.fromRGB(150, 148, 144), M.Concrete, { collide = true })
	part(f, "LotPath", V3(3.6, 0.18, kerbDist - 15), base * CF(-7, 0.09, -(kerbDist + 15) / 2), Color3.fromRGB(180, 176, 168), M.Concrete, { collide = true })
	for _, x in ipairs({ -32, 36 }) do
		K.hedge(f, base * CF(x, 0.16, -4) * ANG(0, RAD(90), 0), 44, 3.6, 2.4)
	end
	part(f, "SignPost", V3(0.3, 7, 0.3), base * CF(6, 3.5, -kerbDist + 6), C.white, M.Wood)
	local rs = part(f, "RealtySign", V3(5.6, 3.6, 0.12), base * CF(6, 6, -kerbDist + 6), Color3.fromRGB(180, 30, 36), M.SmoothPlastic)
	GymDecor.Sign(rs, Enum.NormalId.Front, "FOR SALE\nCITY REALTY\n$400,000", C.white, Color3.fromRGB(180, 30, 36), 40)
	rs:SetAttribute("Kind", "ForSale")
	rs:SetAttribute("Home", "House")
	tag(rs, "CityScreen")
	site("HomeHouse", base)
	promptPart(f, "HomePrompt", (base * CF(-7, 2.6, -14)).Position, "Enter house", "Oak Street", { Action = "Home", Kind = "House" }, Color3.fromRGB(255, 230, 170))
end

local function buildWest(root)
	local f = folder(root, "Residential")
	local rng = Random.new(808)
	local OAK, CEDAR = CITY.OakStreet, CITY.CedarLane
	local half = OAK.w / 2
	K.roadZ(f, "OakStreet", OAK.z0, OAK.z1, OAK.x, OAK.w, { y = ROAD_Y - 0.004, sw = { w = 8, e = 8 }, gapsE = { { CEDAR.z - 12.5, CEDAR.z + 12.5 } }, lineColor = K.LINE_YELLOW })
	K.roadX(f, "CedarLane", CEDAR.x0, CEDAR.x1, CEDAR.z, CEDAR.w, { sw = { n = 7, s = 7 } })
	K.lawn(f, OAK.x + half + 9, LOOP.x0 - LW - OUTER - 0.6, OAK.z0, CEDAR.z - 20, rng, { patches = 4 })
	K.lawn(f, OAK.x + half + 9, LOOP.x0 - LW - OUTER - 0.6, CEDAR.z + 20, MAIN.frontN - 1, rng, { patches = 4 })
	K.lawn(f, -560, OAK.x - half - 9, OAK.z0, MAIN.z0 - 11, rng, { patches = 5 })
	-- the houses: east side (facing west) at x -384, west side (facing east) at x -496, 64-stud lots
	local i = 0
	local kerbE = 44 -- house centre to the kerb
	for z = -608, 230, 64 do
		if math.abs(z - CEDAR.z) > 36 then
			i += 1
			if z == 224 then
				homeLot(f, V3(OAK.x + half + kerbE, 0, z), V3(-1, 0, 0), kerbE)
			else
				house(f, V3(OAK.x + half + kerbE, 0, z), V3(-1, 0, 0), rng, i, kerbE)
			end
			K.kerbRamp(f, V3(OAK.x + half + 1.2, 0, z - 27), V3(-1, 0, 0), 14)
		end
	end
	for z = -576, 262, 64 do
		i += 1
		house(f, V3(OAK.x - half - kerbE, 0, z), V3(1, 0, 0), rng, i, kerbE)
		K.kerbRamp(f, V3(OAK.x - half - 1.2, 0, z + 27), V3(1, 0, 0), 14)
	end
	-- residential lights (6 m) alternating sides, street trees between the drives
	local k = 0
	for z = OAK.z0 + 30, OAK.z1 - 20, 64 do
		k += 1
		local side = (k % 2 == 0) and 1 or -1
		K.streetLight(f, V3(OAK.x + side * (half + 1.6), SW_H, z), V3(-side, 0, 0), k % 3 ~= 0, CITY.ResidentialLight)
	end
	for z = OAK.z0 + 10, OAK.z1 - 30, 32 do
		if math.abs(z - CEDAR.z) > 20 then
			K.tree(f, V3(OAK.x + half + 11, 0.16, z), "oak", rng:NextNumber(30, 40), rng)
		end
		K.tree(f, V3(OAK.x - half - 11, 0.16, z + 16), ({ "oak", "maple" })[(z // 32) % 2 + 1], rng:NextNumber(30, 40), rng)
	end
	K.streetSign(f, V3(OAK.x + half + 2, SW_H, CEDAR.z - 15), "OAK ST", RAD(90), "CEDAR LN")
	K.roadSign(f, V3(OAK.x + half + 2, SW_H, CEDAR.z + 15), RAD(90), "stop")
	K.roadSign(f, V3(OAK.x - half - 2, SW_H, MAIN.z0 - 16), RAD(-90), "stop")
	K.roadSign(f, V3(OAK.x + half + 2, SW_H, -300), RAD(90), "speed", "20")
	K.crosswalk(f, V3(OAK.x, 0, CEDAR.z + 17), true, OAK.w, 8)
	K.crosswalk(f, V3(CEDAR.x0 + 16, 0, CEDAR.z), false, CEDAR.w, 8)
	K.crosswalk(f, V3(CEDAR.x1 - 10, 0, CEDAR.z), false, CEDAR.w, 8)
	lightsX(f, CEDAR.x0 + 30, CEDAR.x1 - 20, CEDAR.z - 12.5 - 1.6, V3(0, 0, 1), 70, CITY.ResidentialLight, 2)
	-- a corner store at Cedar Lane and a playground on the greenway
	K.building(f, CF(OAK.x + half + 8.6 + 20, 0, CEDAR.z - 12.5 - 7.6), 40, 30, 1, { color = Color3.fromRGB(176, 60, 44), mat = M.Brick, sign = "OAK ST GROCERY", signBg = Color3.fromRGB(30, 110, 60), signFg = C.white, awning = Color3.fromRGB(30, 110, 60), rng = rng, name = "CornerStore" })
	local pg = V3(-330, 0.16, 60)
	part(f, "PlaygroundBark", V3(50, 0.2, 36), CF(pg + V3(0, 0.1, 0)), Color3.fromRGB(120, 86, 56), M.Ground, { collide = true })
	for k2 = 0, 2 do
		part(f, "SwingPost", V3(0.5, 10, 0.5), CF(pg + V3(-16 + k2 * 10, 5, -8)), Color3.fromRGB(200, 40, 40), M.Metal, { collide = true })
	end
	part(f, "SwingBeam", V3(22, 0.5, 0.5), CF(pg + V3(-6, 10, -8)), Color3.fromRGB(200, 40, 40), M.Metal)
	for _, x in ipairs({ -12, -2 }) do
		part(f, "SwingSeat", V3(2, 0.3, 0.8), CF(pg + V3(x, 3, -8)), C.black, M.Rubber)
		for _, dx in ipairs({ -0.8, 0.8 }) do
			part(f, "SwingChain", V3(0.1, 7, 0.1), CF(pg + V3(x + dx, 6.6, -8)), C.steelLight, M.Metal, { shadow = false })
		end
	end
	part(f, "SlideTower", V3(6, 8, 6), CF(pg + V3(14, 4, 6)), Color3.fromRGB(40, 110, 200), M.SmoothPlastic, { collide = true })
	part(f, "SlideRoof", V3(7, 1, 7), CF(pg + V3(14, 9.5, 6)) * ANG(0, RAD(45), 0), Color3.fromRGB(240, 170, 60), M.SmoothPlastic)
	part(f, "Slide", V3(3, 0.4, 14), CF(pg + V3(14, 4.2, 15)) * ANG(RAD(32), 0, 0), Color3.fromRGB(240, 200, 40), M.SmoothPlastic, { collide = true })
	part(f, "SlideLadder", V3(2.4, 8, 0.4), CF(pg + V3(14, 4, 2.8)), C.steelLight, M.Metal, { collide = true })
	K.bench(f, V3(pg.X - 20, 0.3, pg.Z + 20), RAD(180), 6.4, C.wood)
	K.bench(f, V3(pg.X + 20, 0.3, pg.Z + 20), RAD(180), 6.4, C.wood)
	K.bin(f, V3(pg.X, 0.3, pg.Z + 20))
	for _, p in ipairs({ V3(-300, 0.16, -160), V3(-340, 0.16, -100), V3(-290, 0.16, 130), V3(-360, 0.16, 190), V3(-310, 0.16, -230) }) do
		K.tree(f, p, rng:NextNumber() < 0.5 and "oak" or "pine", rng:NextNumber(34, 46), rng)
	end
	-- the hills west of the houses, a water tower and a radio mast on them
	local hills = folder(f, "Hills")
	local hillCols = { Color3.fromRGB(86, 128, 70), Color3.fromRGB(96, 136, 72), Color3.fromRGB(78, 118, 66), Color3.fromRGB(104, 140, 80) }
	for k2, h in ipairs({
		{ -760, -520, 420, 90, 380 }, { -900, -160, 520, 120, 460 }, { -780, 160, 380, 70, 300 }, { -1000, -700, 560, 140, 520 },
		{ -1050, 360, 440, 90, 420 }, { -840, -1000, 600, 110, 500 }, { -1150, -300, 500, 160, 460 },
	}) do
		blob(hills, "Hill", V3(h[3], h[4], h[5]), CF(h[1], -h[4] * 0.15, h[2]), hillCols[k2 % #hillCols + 1], M.Grass, { collide = false })
	end
	for _ = 1, 26 do
		local p = V3(rng:NextNumber(-760, -600), 0.16, rng:NextNumber(-640, 280))
		K.tree(hills, p, "pine", rng:NextNumber(36, 54), rng)
	end
	local wt = V3(-700, 42, -380)
	for _, o in ipairs({ { -7, -7 }, { 7, -7 }, { -7, 7 }, { 7, 7 } }) do
		rod(hills, "TowerLeg", V3(wt.X + o[1] * 1.4, 0, wt.Z + o[2] * 1.4), wt + V3(o[1], 0, o[2]), 1.0, C.steel, M.Metal)
	end
	vcyl(hills, "WaterTower", 24, 26, CF(wt), Color3.fromRGB(220, 222, 226), M.Metal)
	blob(hills, "WaterTowerCap", V3(27, 10, 27), CF(wt + V3(0, 26, 0)), Color3.fromRGB(200, 202, 206), M.Metal)
	local wts = part(hills, "WaterTowerSign", V3(20, 6, 0.3), CF(wt + V3(0, 14, 13.2)), Color3.fromRGB(220, 222, 226), M.SmoothPlastic)
	GymDecor.Sign(wts, Enum.NormalId.Back, "OAKRIDGE", Color3.fromRGB(30, 60, 160), Color3.fromRGB(220, 222, 226), 30)
	local mast = V3(-960, 24, -80)
	part(hills, "RadioMast", V3(2.4, 150, 2.4), CF(mast + V3(0, 75, 0)), Color3.fromRGB(200, 60, 60), M.Metal)
	ball(hills, "MastLight", 2.4, CF(mast + V3(0, 151, 0)), Color3.fromRGB(255, 40, 40), M.Neon, { shadow = false })
end

------------------------------------------------------------------------
-- Hillcrest Estates: the gated plot at the top of Oak Street. Everyone sees the walls, the gate, the
-- gardens and the empty villa podium; a Mansion owner sees their villa, pool and garage on it
-- (CityVisuals) and the gate opens for them (locally).
------------------------------------------------------------------------
local ESTATE = { x0 = -620, x1 = -260, z0 = -920, z1 = -690, gateX = -440 }
CityMap.Estate = ESTATE

local function buildEstates(root)
	local f = folder(root, "Estates")
	local rng = Random.new(4242)
	local E = ESTATE
	local gx = E.gateX
	local brick = Color3.fromRGB(150, 128, 104)
	local stone = Color3.fromRGB(214, 206, 190)
	slab(f, "EstateLawn", E.x0, E.x1, E.z0, E.z1, 0.3, Color3.fromRGB(78, 132, 62), M.Grass)
	K.wall(f, V3(E.x0, 0.3, E.z1), V3(gx - 16, 0.3, E.z1), 7, brick, M.Brick, stone)
	K.wall(f, V3(gx + 16, 0.3, E.z1), V3(E.x1, 0.3, E.z1), 7, brick, M.Brick, stone)
	K.wall(f, V3(E.x0, 0.3, E.z0), V3(E.x1, 0.3, E.z0), 7, brick, M.Brick, stone)
	K.wall(f, V3(E.x0, 0.3, E.z0), V3(E.x0, 0.3, E.z1), 7, brick, M.Brick, stone)
	K.wall(f, V3(E.x1, 0.3, E.z0), V3(E.x1, 0.3, E.z1), 7, brick, M.Brick, stone)
	for x = E.x0, E.x1, 36 do
		for _, z in ipairs({ E.z0, E.z1 }) do
			if math.abs(x - gx) > 20 then
				part(f, "WallPillar", V3(2.6, 9, 2.6), CF(x, 4.8, z), stone, M.Limestone, { collide = true })
			end
		end
	end
	-- gate: two pillars with lamps, two wrought-iron leaves (one Model each so CityVisuals can swing
	-- them open for the owner; the collider is the leaf's PrimaryPart)
	for _, sx in ipairs({ -1, 1 }) do
		local px = gx + sx * 17.5
		part(f, "GatePillar", V3(3.4, 12, 3.4), CF(px, 6.3, E.z1), stone, M.Limestone, { collide = true })
		ball(f, "GateLamp", 1.6, CF(px, 13, E.z1), Color3.fromRGB(255, 236, 200), M.Neon, { shadow = false })
		nightPoint(f, CF(px, 12.4, E.z1 + 2), Color3.fromRGB(255, 220, 170), 24, 1)
		local leaf = model(f, "GateLeaf")
		local hinge = gx + sx * 15.6
		local col = part(leaf, "GateCollider", V3(15.6, 10.5, 0.5), CF(gx + sx * 7.8, 5.5, E.z1), Color3.new(), M.SmoothPlastic, { transparency = 1, collide = true })
		leaf.PrimaryPart = col
		leaf:SetAttribute("Hinge", hinge)
		leaf:SetAttribute("Side", sx)
		for _, y in ipairs({ 0.9, 9.8 }) do
			part(leaf, "GateRail", V3(15.6, 0.35, 0.35), CF(gx + sx * 7.8, y, E.z1), Color3.fromRGB(26, 26, 28), M.Metal)
		end
		for k = 0, 9 do
			part(leaf, "GateBar", V3(0.25, 9.4 + (k % 2) * 0.9, 0.25), CF(gx + sx * (0.8 + k * 1.6), 5.4 + (k % 2) * 0.45, E.z1), Color3.fromRGB(26, 26, 28), M.Metal)
		end
		ball(leaf, "GateCrest", 1.4, CF(gx + sx * 7.8, 6.4, E.z1), C.gold, M.Metal)
	end
	local plaque = part(f, "EstatePlaque", V3(9, 2.4, 0.2), CF(gx - 26, 4.6, E.z1 + 0.7), Color3.fromRGB(40, 40, 44), M.Granite)
	Signage.Board(plaque, Enum.NormalId.Back, "estate", { maxDist = 500 })
	local rs = part(f, "RealtySign", V3(6.4, 3.6, 0.12), CF(gx + 28, 5.2, E.z1 + 3), Color3.fromRGB(180, 30, 36), M.SmoothPlastic)
	part(f, "SignPost", V3(0.3, 4, 0.3), CF(gx + 28, 2, E.z1 + 3), C.white, M.Wood)
	GymDecor.Sign(rs, Enum.NormalId.Back, "HILLCREST MANSION\nFOR SALE  $5,000,000\nCITY REALTY", C.white, Color3.fromRGB(180, 30, 36), 40)
	rs:SetAttribute("Kind", "ForSale")
	rs:SetAttribute("Home", "Mansion")
	tag(rs, "CityScreen")
	-- gatehouse just inside, the drive to the forecourt, a fountain, the villa podium
	local gh = CF(gx - 28, 0.3, E.z1 - 10)
	part(f, "Gatehouse", V3(10, 11, 10), gh * CF(0, 5.5, 0), stone, M.Limestone, { collide = true })
	part(f, "GatehouseRoof", V3(12.5, 0.8, 12.5), gh * CF(0, 11.3, 0), Color3.fromRGB(50, 50, 56), M.Slate)
	part(f, "GatehouseWindow", V3(5, 3.2, 0.1), gh * CF(0, 6.2, 5.05), Color3.fromRGB(170, 205, 230), M.Glass, { transparency = 0.3 })
	part(f, "GatehouseDoor", V3(CITY.Door.w, CITY.Door.h, 0.2), gh * CF(5.05, 0.3 + CITY.Door.h / 2, 0) * ANG(0, RAD(90), 0), Color3.fromRGB(60, 40, 28), M.Wood)
	nightPoint(f, gh * CF(0, 9.6, 6), Color3.fromRGB(255, 225, 180), 16, 0.8)
	slab(f, "EstateDrive", gx - 7, gx + 7, -810, E.z1 - 0.6, 0.42, Color3.fromRGB(196, 188, 172), M.Pavement)
	slab(f, "Forecourt", gx - 42, gx + 42, -838, -810, 0.42, Color3.fromRGB(196, 188, 172), M.Pavement)
	local fo = V3(gx, 0.42, -824)
	vcyl(f, "FountainBasin", 1.8, 14, CF(fo), stone, M.Limestone, { collide = true })
	vcyl(f, "FountainWater", 0.2, 12.6, CF(fo + V3(0, 1.6, 0)), Color3.fromRGB(70, 150, 210), M.Glass, { transparency = 0.25 })
	vcyl(f, "FountainPillar", 5, 2, CF(fo), stone, M.Limestone)
	vcyl(f, "FountainBowl", 0.9, 7, CF(fo + V3(0, 5, 0)), stone, M.Limestone)
	local jet = part(f, "FountainJet", V3(0.4, 0.4, 0.4), CF(fo + V3(0, 6.2, 0)), C.white, M.SmoothPlastic, { transparency = 1, shadow = false })
	local pe = Instance.new("ParticleEmitter")
	pe.Rate = 18
	pe.Lifetime = NumberRange.new(0.9, 1.2)
	pe.Speed = NumberRange.new(9, 12)
	pe.SpreadAngle = Vector2.new(12, 12)
	pe.Acceleration = Vector3.new(0, -28, 0)
	pe.Size = NumberSequence.new(0.45, 0.2)
	pe.Transparency = NumberSequence.new(0.3, 0.85)
	pe.Color = ColorSequence.new(Color3.fromRGB(220, 240, 255))
	pe.Parent = jet
	part(f, "VillaPodium", V3(120, 1.0, 40), CF(gx, 0.5, -865), Color3.fromRGB(226, 220, 206), M.Limestone, { collide = true })
	part(f, "PodiumSteps", V3(24, 0.6, 3), CF(gx, 0.3, -843.5), Color3.fromRGB(226, 220, 206), M.Limestone, { collide = true })
	site("HomeMansion", CFrame.lookAt(V3(gx, 1.0, -865), V3(gx, 1.0, -800)))
	site("MansionPool", CFrame.lookAt(V3(gx - 50, 0.3, -851), V3(gx - 50, 0.3, -800))) -- (CityVisuals scales the villa x1.8 about Site_HomeMansion: this lands at gx - 90)
	site("MansionGarage", CFrame.lookAt(V3(gx + 56, 0.3, -868), V3(gx + 56, 0.3, -800)))
	site("EstateGate", CFrame.lookAt(V3(gx, 0.3, E.z1 + 14), V3(gx, 0.3, E.z1 - 20)))
	promptPart(f, "HomePrompt", V3(gx, 3.4, -841), "Enter mansion", "Hillcrest Estates", { Action = "Home", Kind = "Mansion" }, Color3.fromRGB(255, 220, 120))
	-- palms along the drive and round the forecourt, hedges inside the south wall, garden lamps
	for z = -710, -800, -24 do
		for _, sx in ipairs({ -1, 1 }) do
			K.tree(f, V3(gx + sx * 13, 0.3, z), "palm", rng:NextNumber(30, 40), rng)
		end
	end
	for _, x in ipairs({ -600, -540, -340, -280 }) do
		K.hedge(f, CF(x, 0.3, E.z1 - 5), 36, 4.4, 3.2, Color3.fromRGB(46, 104, 50))
	end
	for _, z in ipairs({ -730, -770 }) do
		for _, sx in ipairs({ -1, 1 }) do
			K.parkLamp(f, V3(gx + sx * 9.5, 0.3, z), true)
		end
	end
	for _ = 1, 14 do
		local p = V3(rng:NextNumber(E.x0 + 20, E.x1 - 20), 0.3, rng:NextNumber(E.z0 + 20, E.z1 - 40))
		if math.abs(p.X - gx) > 70 or p.Z < -890 then
			K.tree(f, p, ({ "oak", "pine", "cherry" })[rng:NextInteger(1, 3)], rng:NextNumber(32, 46), rng)
		end
	end
	K.flowerBed(f, CF(gx, 0.42, -845) * ANG(0, 0, 0), 60, 2.4, rng)
	lightZone(f, "EstateZone", V3(E.x1 - E.x0, 50, E.z1 - E.z0), CF((E.x0 + E.x1) / 2, 25, (E.z0 + E.z1) / 2), "Mansion")
end

------------------------------------------------------------------------
-- East: Riverside Park, Riverside Drive, the promenade, boardwalk, pier, the river and its bridge
------------------------------------------------------------------------
local function segDist(p, a, b)
	local ab = b - a
	local t = math.clamp((p - a):Dot(ab) / ab:Dot(ab), 0, 1)
	return (p - (a + ab * t)).Magnitude
end

local function buildEast(root)
	local f = folder(root, "Park")
	local rng = Random.new(2024)
	local P, RD = CITY.Park, CITY.RiversideDrive
	-- the park lawn and its railings (gates on the loop side and on Main Street)
	K.lawn(f, P.x0, P.x1, P.z0, P.z1, rng, { patches = 6 })
	K.lawn(f, P.x0, 540, -277.5 + LW + 0.6 + OUTER, P.z0, rng, { patches = 2 }) -- the north meadow
	for _, r in ipairs(K.cutRanges(P.z0, P.z1, { { -106, -94 }, { 54, 66 }, { 194, 206 } })) do
		K.fenceIron(f, V3(P.x0, SW_H, r[1]), V3(P.x0, SW_H, r[2]), 5)
	end
	for _, z in ipairs({ -100, 60, 200 }) do
		K.kerbRamp(f, V3(LOOP.x1 + LW + 1.2, 0, z), V3(-1, 0, 0), 8)
		K.crosswalk(f, V3(LOOP.x1, 0, z), true, LOOP.w, 8)
	end
	-- paths: from the three west gates and the two south gates, meeting at the fountain plaza
	local fo = V3(480, 0, 40)
	local ct = V3(340, 0, -100) -- basketball court
	local pond = V3(610, 0, -70)
	local band = V3(400, 0, 190) -- bandstand
	local play = V3(640, 0, 190) -- playground
	local paths = {
		{ V3(P.x0, 0, -100), V3(ct.X - 50, 0, -100) }, { V3(ct.X + 50, 0, -100), V3(fo.X - 20, 0, 20) },
		{ V3(P.x0, 0, 60), V3(fo.X - 30, 0, 50) }, { V3(P.x0, 0, 200), V3(band.X - 20, 0, 196) }, { V3(band.X + 20, 0, 190), V3(fo.X, 0, 70) },
		{ V3(336, 0, P.z1), V3(band.X - 10, 0, 210) }, { V3(546, 0, P.z1), V3(fo.X + 20, 0, 70) }, { V3(fo.X + 30, 0, 40), V3(pond.X - 60, 0, -40) },
		{ V3(fo.X + 30, 0, 60), V3(play.X - 30, 0, 180) }, { V3(pond.X + 40, 0, -20), V3(RD.x - 12.5 - 9, 0, 40) }, { V3(play.X + 30, 0, 190), V3(RD.x - 12.5 - 9, 0, 200) },
	}
	for _, seg in ipairs(paths) do
		local a, b = seg[1], seg[2]
		part(f, "ParkPath", V3(8, 0.2, (b - a).Magnitude + 2), CFrame.lookAt((a + b) / 2 + V3(0, 0.26, 0), b + V3(0, 0.26, 0)), Color3.fromRGB(196, 176, 140), M.Pavement, { collide = true })
	end
	-- fountain plaza: paving, the big basin, a ring of benches and beds, lamps
	part(f, "FountainPlaza", V3(70, 0.2, 70), CF(fo + V3(0, 0.26, 0)), K.PAVING, M.Pavement, { collide = true })
	vcyl(f, "FountainBasin", 2.2, 30, CF(fo + V3(0, 0.3, 0)), Color3.fromRGB(170, 168, 162), M.Granite, { collide = true })
	vcyl(f, "FountainWater", 0.3, 28, CF(fo + V3(0, 2.1, 0)), Color3.fromRGB(70, 150, 210), M.Glass, { transparency = 0.25 })
	vcyl(f, "FountainPillar", 7, 3, CF(fo + V3(0, 0.3, 0)), Color3.fromRGB(180, 178, 172), M.Granite)
	vcyl(f, "FountainBowl", 1.2, 10, CF(fo + V3(0, 7.3, 0)), Color3.fromRGB(180, 178, 172), M.Granite)
	vcyl(f, "FountainBowlWater", 0.15, 9, CF(fo + V3(0, 8.4, 0)), Color3.fromRGB(80, 160, 220), M.Glass, { transparency = 0.2 })
	local jet = part(f, "FountainJet", V3(0.5, 0.5, 0.5), CF(fo + V3(0, 8.9, 0)), C.white, M.SmoothPlastic, { transparency = 1, shadow = false })
	local pe = Instance.new("ParticleEmitter")
	pe.Rate = 40
	pe.Lifetime = NumberRange.new(1.0, 1.4)
	pe.Speed = NumberRange.new(13, 16)
	pe.SpreadAngle = Vector2.new(9, 9)
	pe.Acceleration = Vector3.new(0, -28, 0)
	pe.Size = NumberSequence.new(0.6, 0.25)
	pe.Transparency = NumberSequence.new(0.3, 0.8)
	pe.Color = ColorSequence.new(Color3.fromRGB(220, 240, 255))
	pe.LightEmission = 0.3
	pe.Parent = jet
	for k = 0, 7 do
		local a = k * RAD(45) + RAD(22.5)
		K.bench(f, fo + V3(math.cos(a) * 24, 0.46, math.sin(a) * 24), RAD(90) - a, 6.4, C.wood)
		if k % 2 == 0 then
			K.parkLamp(f, fo + V3(math.cos(a + RAD(22.5)) * 31, 0.46, math.sin(a + RAD(22.5)) * 31), true)
		else
			K.bin(f, fo + V3(math.cos(a + RAD(22.5)) * 30, 0.46, math.sin(a + RAD(22.5)) * 30))
		end
	end
	for _, a in ipairs({ 0, 90, 180, 270 }) do
		K.flowerBed(f, CF(fo + V3(math.cos(RAD(a)) * 20, 0.46, math.sin(RAD(a)) * 20)) * ANG(0, RAD(90 - a), 0), 10, 2, rng)
	end
	K.vendorCart(f, CF(fo + V3(-30, 0.46, -32)) * ANG(0, RAD(30), 0), "icecream")
	K.vendorCart(f, CF(fo + V3(34, 0.46, 30)) * ANG(0, RAD(-150), 0), "hotdog")
	-- the basketball court: full size with fence, two hoops, benches
	part(f, "CourtApron", V3(100, 0.24, 62), CF(ct + V3(0, 0.12, 0)), Color3.fromRGB(150, 150, 150), M.Concrete, { collide = true })
	part(f, "Court", V3(90, 0.3, 50), CF(ct + V3(0, 0.15, 0)), Color3.fromRGB(46, 92, 140), M.SmoothPlastic, { collide = true })
	local lines = part(f, "CourtLines", V3(90, 0.02, 50), CF(ct + V3(0, 0.31, 0)), Color3.new(), M.SmoothPlastic, { transparency = 1 })
	local lg = gui(lines, Enum.NormalId.Top, 6, 1, 300)
	local function box(xs, ys, w, h)
		local fr = frame(lg, { Size = UDim2.fromScale(w, h), Position = UDim2.fromScale(xs, ys), BackgroundTransparency = 1 })
		local st = Instance.new("UIStroke")
		st.Color = C.white
		st.Thickness = 3
		st.Parent = fr
		return fr
	end
	box(0.02, 0.03, 0.96, 0.94)
	box(0.5, 0.03, 0.0, 0.94)
	local circle = box(0.43, 0.38, 0.14, 0.24)
	Instance.new("UICorner", circle).CornerRadius = UDim.new(0.5, 0)
	box(0.02, 0.33, 0.18, 0.34)
	box(0.8, 0.33, 0.18, 0.34)
	for _, s in ipairs({ -1, 1 }) do
		local hx = ct.X + s * 48
		part(f, "HoopPole", V3(0.6, 13, 0.6), CF(hx, 6.5, ct.Z), C.steel, M.Metal, { collide = true })
		part(f, "HoopArm", V3(4, 0.5, 0.5), CF(hx - s * 2, 12.4, ct.Z), C.steel, M.Metal)
		part(f, "Backboard", V3(0.25, 4, 6.4), CF(hx - s * 4, 12.4, ct.Z), C.white, M.SmoothPlastic, { transparency = 0.15 })
		cyl(f, "Rim", 0.2, 1.8, CF(hx - s * 5.2, 11.0, ct.Z) * ANG(0, 0, RAD(90)), Color3.fromRGB(240, 110, 30), M.Metal)
	end
	K.fenceChain(f, V3(ct.X - 50, 0.24, ct.Z - 31), V3(ct.X + 50, 0.24, ct.Z - 31), 12)
	K.fenceChain(f, V3(ct.X - 50, 0.24, ct.Z + 31), V3(ct.X - 6, 0.24, ct.Z + 31), 12)
	K.fenceChain(f, V3(ct.X + 6, 0.24, ct.Z + 31), V3(ct.X + 50, 0.24, ct.Z + 31), 12)
	K.fenceChain(f, V3(ct.X - 50, 0.24, ct.Z - 31), V3(ct.X - 50, 0.24, ct.Z + 31), 12)
	K.fenceChain(f, V3(ct.X + 50, 0.24, ct.Z - 31), V3(ct.X + 50, 0.24, ct.Z + 31), 12)
	ball(f, "Basketball", 1.1, CF(ct + V3(12, 0.85, 6)), Color3.fromRGB(230, 110, 30), M.Rubber)
	K.bench(f, ct + V3(-20, 0.24, 27), RAD(180), 6.4, C.wood)
	K.bench(f, ct + V3(20, 0.24, 27), RAD(180), 6.4, C.wood)
	for _, x in ipairs({ -48, 48 }) do
		K.streetLight(f, V3(ct.X + x, 0.24, ct.Z - 28), V3(-math.sign(x), 0, 0.3).Unit, true, 26)
	end
	-- the pond with its deck and a willow-ish birch group
	vcyl(f, "PondBank", 0.36, 150, CF(pond), Color3.fromRGB(150, 140, 110), M.Sand, { collide = true })
	vcyl(f, "Pond", 0.3, 136, CF(pond), Color3.fromRGB(52, 110, 150), M.Glass, { transparency = 0.2, reflect = 0.3, collide = true })
	part(f, "PondDeck", V3(24, 0.5, 30), CF(pond + V3(-62, 0.9, 10)), Color3.fromRGB(150, 116, 84), M.WoodPlanks, { collide = true })
	K.railing(f, pond + V3(-50, 1.1, -5), pond + V3(-50, 1.1, 25))
	K.railing(f, pond + V3(-74, 1.1, 25), pond + V3(-50, 1.1, 25))
	K.railing(f, pond + V3(-74, 1.1, -5), pond + V3(-50, 1.1, -5))
	K.bench(f, pond + V3(-66, 1.15, 10), RAD(90), 6.4, C.wood)
	for k = 0, 2 do
		local a = RAD(40 + k * 50)
		blob(f, "LilyPads", V3(6, 0.15, 5), CF(pond + V3(math.cos(a) * 50, 0.34, math.sin(a) * 50)), Color3.fromRGB(70, 130, 60), M.Grass, { shadow = false })
	end
	for k = 0, 5 do
		local a = RAD(k * 60 + 15)
		K.tree(f, pond + V3(math.cos(a) * 84, 0.14, math.sin(a) * 84), k % 2 == 0 and "birch" or "oak", rng:NextNumber(30, 44), rng)
	end
	-- the bandstand: a raised round stage under a conical roof on eight posts
	vcyl(f, "BandstandBase", 1.6, 32, CF(band), Color3.fromRGB(200, 196, 186), M.Concrete, { collide = true })
	vcyl(f, "BandstandFloor", 0.3, 28, CF(band + V3(0, 1.6, 0)), Color3.fromRGB(150, 116, 84), M.WoodPlanks, { collide = true })
	for k = 0, 7 do
		local a = k * RAD(45)
		vcyl(f, "BandstandPost", 12, 0.9, CF(band + V3(math.cos(a) * 12.5, 1.9, math.sin(a) * 12.5)), C.white, M.Wood, { collide = true })
	end
	K.railing(f, band + V3(12.5, 1.9, 0), band + V3(8.8, 1.9, 8.8), C.white)
	K.railing(f, band + V3(-12.5, 1.9, 0), band + V3(-8.8, 1.9, 8.8), C.white)
	K.railing(f, band + V3(-12.5, 1.9, 0), band + V3(-8.8, 1.9, -8.8), C.white)
	K.railing(f, band + V3(12.5, 1.9, 0), band + V3(8.8, 1.9, -8.8), C.white)
	blob(f, "BandstandRoof", V3(34, 12, 34), CF(band + V3(0, 13.6, 0)), Color3.fromRGB(60, 90, 70), M.Slate)
	vcyl(f, "BandstandFinial", 3, 1.2, CF(band + V3(0, 19.2, 0)), C.gold, M.Metal)
	nightPoint(f, CF(band + V3(0, 12, 0)), Color3.fromRGB(255, 226, 180), 30, 1)
	-- the playground: bark, a climbing frame with slide, swings, a seesaw, benches
	part(f, "PlaygroundBark", V3(60, 0.24, 44), CF(play + V3(0, 0.26, 0)), Color3.fromRGB(120, 86, 56), M.Ground, { collide = true })
	part(f, "SlideTower", V3(7, 9, 7), CF(play + V3(-16, 4.9, -8)), Color3.fromRGB(40, 110, 200), M.SmoothPlastic, { collide = true })
	part(f, "SlideRoof", V3(8, 1, 8), CF(play + V3(-16, 10.4, -8)) * ANG(0, RAD(45), 0), Color3.fromRGB(240, 170, 60), M.SmoothPlastic)
	part(f, "Slide", V3(3, 0.4, 16), CF(play + V3(-16, 4.8, 2)) * ANG(RAD(32), 0, 0), Color3.fromRGB(240, 200, 40), M.SmoothPlastic, { collide = true })
	part(f, "ClimbWall", V3(0.6, 9, 7), CF(play + V3(-19.6, 4.9, -8)), Color3.fromRGB(200, 60, 60), M.SmoothPlastic, { collide = true })
	for k = 0, 3 do
		part(f, "SwingPost", V3(0.5, 10, 0.5), CF(play + V3(2 + k * 8, 5.4, 12)), Color3.fromRGB(200, 40, 40), M.Metal, { collide = true })
	end
	part(f, "SwingBeam", V3(26, 0.5, 0.5), CF(play + V3(14, 10.4, 12)), Color3.fromRGB(200, 40, 40), M.Metal)
	for _, x in ipairs({ 6, 14, 22 }) do
		part(f, "SwingSeat", V3(2, 0.3, 0.8), CF(play + V3(x, 3.4, 12)), C.black, M.Rubber)
		for _, dx in ipairs({ -0.8, 0.8 }) do
			part(f, "SwingChain", V3(0.1, 7, 0.1), CF(play + V3(x + dx, 7, 12)), C.steelLight, M.Metal, { shadow = false })
		end
	end
	part(f, "Seesaw", V3(14, 0.4, 1.4), CF(play + V3(14, 2.4, -10)) * ANG(0, 0, RAD(12)), Color3.fromRGB(60, 160, 80), M.SmoothPlastic)
	part(f, "SeesawPivot", V3(1.4, 2.4, 1.4), CF(play + V3(14, 1.3, -10)), C.steel, M.Metal, { collide = true })
	for _, p in ipairs({ { -28, 24 }, { 28, 24 } }) do
		K.bench(f, play + V3(p[1], 0.38, p[2]), RAD(180), 6.4, C.wood)
	end
	K.bin(f, play + V3(0, 0.38, 25))
	K.fencePicket(f, play + V3(-32, 0.3, -24), play + V3(32, 0.3, -24))
	-- picnic tables, lamps along the paths, bins, the park signs at the gates, trees everywhere else
	local picnic = { V3(300, 0, -20), V3(430, 0, 120), V3(560, 0, 240), V3(700, 0, 110), V3(300, 0, 250), V3(690, 0, -150) }
	for k, p in ipairs(picnic) do
		K.picnicTable(f, p + V3(0, 0.14, 0), RAD(k * 37))
	end
	for _, seg in ipairs(paths) do
		local a, b = seg[1], seg[2]
		local n = math.max(1, math.floor((b - a).Magnitude / 70))
		for k = 1, n do
			local t = (k - 0.5) / n
			local p = a:Lerp(b, t)
			local side = (b - a).Unit:Cross(Vector3.yAxis) * 6
			K.parkLamp(f, p + side + V3(0, 0.14, 0), k % 2 == 1)
			if k % 2 == 0 then
				K.bench(f, p - side + V3(0, 0.14, 0), math.atan2((b - a).X, (b - a).Z), 6.4, C.wood)
			end
		end
	end
	for _, z in ipairs({ -100, 60, 200 }) do
		K.postSign(f, CF(P.x0 + 10, 0.14, z - 10) * ANG(0, RAD(90), 0), 14, 3.6, 5, "RIVERSIDE PARK", Color3.fromRGB(255, 230, 170), Color3.fromRGB(60, 40, 26))
	end
	local function clear(p)
		if (p - fo).Magnitude < 42 or (p - pond).Magnitude < 90 or (p - band).Magnitude < 24 then
			return false
		end
		if math.abs(p.X - ct.X) < 56 and math.abs(p.Z - ct.Z) < 38 then
			return false
		end
		if math.abs(p.X - play.X) < 36 and math.abs(p.Z - play.Z) < 28 then
			return false
		end
		for _, seg in ipairs(paths) do
			if segDist(p, seg[1], seg[2]) < 12 then
				return false
			end
		end
		for _, q in ipairs(picnic) do
			if (p - q).Magnitude < 12 then
				return false
			end
		end
		return true
	end
	local n, tries = 0, 0
	local kinds = { "oak", "oak", "maple", "pine", "birch", "cherry", "poplar" }
	while n < 64 and tries < 800 do
		tries += 1
		local p = V3(rng:NextNumber(P.x0 + 12, P.x1 - 12), 0.14, rng:NextNumber(P.z0 + 12, P.z1 - 12))
		if clear(p) then
			n += 1
			K.tree(f, p, kinds[rng:NextInteger(1, #kinds)], rng:NextNumber(30, 50), rng)
		end
	end
	for _ = 1, 14 do
		K.tree(f, V3(rng:NextNumber(P.x0 + 10, 530), 0.14, rng:NextNumber(-262, P.z0 - 8)), rng:NextNumber() < 0.6 and "pine" or "oak", rng:NextNumber(34, 50), rng)
	end
	lightZone(f, "ParkZone", V3(P.x1 - P.x0, 60, P.z1 - P.z0), CF((P.x0 + P.x1) / 2, 30, (P.z0 + P.z1) / 2), "Street")

	-- Riverside Drive, the promenade lawn with its path, the boardwalk, the quay railing, the pier
	local wf = folder(root, "Waterfront")
	K.roadZ(wf, "RiversideDrive", RD.z0, RD.z1, RD.x, RD.w, { y = ROAD_Y - 0.004, sw = { w = 8, e = 10 }, gaps = { { MAIN.z0, MAIN.z1 }, { CITY.SecondStreet.z - 12.5, CITY.SecondStreet.z + 12.5 }, { -302.5, -277.5 } } })
	lightsZ(wf, RD.z0 + 20, RD.z1 - 20, RD.x + 12.5 + 1.6, V3(-1, 0, 0), 70, nil, 2)
	K.lawn(wf, RD.x + 12.5 + 10.6, CITY.Boardwalk.x0, RD.z0, RD.z1, rng, { patches = 5 })
	slab(wf, "PromenadePath", 818, 826, RD.z0, RD.z1, 0.3, Color3.fromRGB(196, 176, 140), M.Pavement)
	local BW = CITY.Boardwalk
	slab(wf, "Boardwalk", BW.x0, BW.x1, RD.z0, RD.z1, SW_H, Color3.fromRGB(140, 104, 72), M.WoodPlanks)
	slab(wf, "QuayWall", BW.x1, BW.x1 + 2, RD.z0, RD.z1, SW_H, Color3.fromRGB(110, 106, 100), M.Concrete, true, -9)
	for _, r in ipairs(K.cutRanges(RD.z0, RD.z1, { { 52, 68 }, { -300, -280 } })) do
		K.railing(wf, V3(BW.x1 + 1, SW_H, r[1]), V3(BW.x1 + 1, SW_H, r[2]))
	end
	for z = RD.z0 + 30, RD.z1 - 30, 60 do
		K.bench(wf, V3(BW.x0 + 6, SW_H, z), RAD(-90), 6.4, C.wood)
		K.parkLamp(wf, V3(BW.x0 + 2, SW_H, z + 30), true)
		if z % 120 == 30 then
			K.bin(wf, V3(BW.x0 + 3, SW_H, z + 10))
		end
	end
	for z = RD.z0 + 50, RD.z1 - 50, 90 do
		K.tree(wf, V3(800, 0.14, z), ({ "oak", "cherry", "poplar" })[(z // 90) % 3 + 1], rng:NextNumber(30, 40), rng)
	end
	-- the pier
	local pz = 60
	slab(wf, "PierDeck", BW.x1, BW.x1 + 110, pz - 8, pz + 8, SW_H + 0.1, Color3.fromRGB(130, 96, 66), M.WoodPlanks, true, SW_H - 0.6)
	for x = BW.x1 + 10, BW.x1 + 108, 14 do
		for _, dz in ipairs({ -7, 7 }) do
			vcyl(wf, "PierPile", 12, 1.6, CF(x, -10, pz + dz), Color3.fromRGB(80, 60, 44), M.Wood)
		end
	end
	K.railing(wf, V3(BW.x1 + 1, SW_H + 0.1, pz - 8), V3(BW.x1 + 110, SW_H + 0.1, pz - 8))
	K.railing(wf, V3(BW.x1 + 1, SW_H + 0.1, pz + 8), V3(BW.x1 + 110, SW_H + 0.1, pz + 8))
	K.railing(wf, V3(BW.x1 + 110, SW_H + 0.1, pz - 8), V3(BW.x1 + 110, SW_H + 0.1, pz + 8))
	for _, x in ipairs({ BW.x1 + 36, BW.x1 + 80 }) do
		K.parkLamp(wf, V3(x, SW_H + 0.1, pz - 6), true)
		K.bench(wf, V3(x, SW_H + 0.1, pz + 5), RAD(180), 6.4, C.wood)
	end
	local pav = V3(BW.x1 + 96, SW_H + 0.1, pz)
	for _, c in ipairs({ { -6, -6 }, { 6, -6 }, { 6, 6 }, { -6, 6 } }) do
		vcyl(wf, "PavilionPost", 10, 0.8, CF(pav + V3(c[1], 0, c[2])), C.white, M.Wood, { collide = true })
	end
	part(wf, "PavilionRoof", V3(15, 0.6, 15), CF(pav + V3(0, 10.3, 0)), Color3.fromRGB(40, 80, 120), M.Metal)
	blob(wf, "PavilionTop", V3(14, 6, 14), CF(pav + V3(0, 12, 0)), Color3.fromRGB(40, 80, 120), M.Metal)
	local ps = part(wf, "PierSign", V3(16, 3, 0.3), CF(BW.x1 + 4, SW_H + 9, pz) * ANG(0, RAD(90), 0), Color3.fromRGB(20, 40, 60), M.SmoothPlastic)
	for _, dz in ipairs({ -7.5, 7.5 }) do
		part(wf, "PierSignPost", V3(0.6, 7.5, 0.6), CF(BW.x1 + 4, SW_H + 3.75, pz + dz), Color3.fromRGB(20, 40, 60), M.Metal, { collide = true })
	end
	GymDecor.Sign(ps, Enum.NormalId.Front, "RIVERSIDE PIER", Color3.fromRGB(255, 230, 170), Color3.fromRGB(20, 40, 60), 30)
	GymDecor.Sign(ps, Enum.NormalId.Back, "RIVERSIDE PIER", Color3.fromRGB(255, 230, 170), Color3.fromRGB(20, 40, 60), 30)
	-- moored boats
	for k, bz in ipairs({ pz - 16, pz + 18, pz + 34 }) do
		local bc = CF(BW.x1 + 30 + k * 14, -1.2, bz) * ANG(0, RAD(90 + k * 6), 0)
		part(wf, "BoatHull", V3(6, 2.6, 18), bc * CF(0, 0.6, 0), ({ C.white, Color3.fromRGB(30, 60, 120), Color3.fromRGB(200, 40, 40) })[k], M.SmoothPlastic)
		part(wf, "BoatBow", V3(6, 2.6, 5), bc * CF(0, 0.6, -11.5), ({ C.white, Color3.fromRGB(30, 60, 120), Color3.fromRGB(200, 40, 40) })[k], M.SmoothPlastic, { class = "WedgePart" })
		part(wf, "BoatCabin", V3(4.4, 2.4, 6), bc * CF(0, 3.1, 2), Color3.fromRGB(240, 240, 236), M.SmoothPlastic)
		vcyl(wf, "BoatMast", 16, 0.3, bc * CF(0, 1.9, -3), C.steelLight, M.Metal)
	end
	-- the boathouse at the north end of the promenade
	local bh = CF(828, 0, -230)
	part(wf, "Boathouse", V3(44, 16, 30), bh * CF(0, 8, 0), Color3.fromRGB(96, 120, 140), M.WoodPlanks, { collide = true })
	local ra = (bh * CF(0, 16 + 3.5, -7.5)).Position
	local rb = (bh * CF(0, 16 + 3.5, 7.5)).Position
	part(wf, "BoathouseRoof", V3(46, 7, 15.6), CFrame.lookAt(ra, ra + V3(0, 0, -1)), Color3.fromRGB(60, 62, 70), M.Slate, { class = "WedgePart" })
	part(wf, "BoathouseRoof", V3(46, 7, 15.6), CFrame.lookAt(rb, rb + V3(0, 0, 1)), Color3.fromRGB(60, 62, 70), M.Slate, { class = "WedgePart" })
	part(wf, "BoathouseDoor", V3(0.4, 11, 14), bh * CF(22.1, 5.5, 0), Color3.fromRGB(200, 60, 60), M.Wood)
	local bs = part(wf, "BoathouseSign", V3(30, 3, 0.3), bh * CF(0, 12.5, 15.2), Color3.fromRGB(20, 40, 60), M.SmoothPlastic)
	GymDecor.Sign(bs, Enum.NormalId.Back, "RIVERSIDE BOATHOUSE  -  ROWING CLUB", Color3.fromRGB(255, 230, 170), Color3.fromRGB(20, 40, 60), 30)
	-- the river, the far bank and the bridge carrying Foundry Street across
	local R = CITY.River
	local B = CITY.Bounds
	K.water(wf, R.x0, R.x1, B.z0, B.z1, -1.6, 7)
	slab(wf, "FarBank", R.x1, R.x1 + 3, B.z0, B.z1, 0.6, Color3.fromRGB(110, 106, 100), M.Concrete, true, -9)
	local bz = CITY.FoundryStreet.z
	slab(wf, "BridgeApproach", RD.x + 12.5, 783, bz - 12.5, bz + 12.5, ROAD_Y, K.ASPHALT, M.Asphalt)
	slab(wf, "Bridge", 843, R.x1 + 2, bz - 14, bz + 14, 6, K.ASPHALT, M.Asphalt, true, 4.2)
	K.dashesX(wf, 843, R.x1, bz, K.LINE_YELLOW)
	-- (the deck sits 5.7 above the road: ramps either side)
	for _, r in ipairs({ { 813, -1 }, { 1182, 1 } }) do
		local rc = CFrame.lookAt(V3(r[1], 3.15, bz), V3(r[1] + r[2], 3.15, bz))
		part(wf, "BridgeRamp", V3(28, 5.7, 60), rc, K.ASPHALT, M.Asphalt, { class = "WedgePart", collide = true })
	end
	for _, dz in ipairs({ -14.5, 14.5 }) do
		K.railing(wf, V3(843, 6, bz + dz), V3(R.x1 + 2, 6, bz + dz), Color3.fromRGB(60, 90, 120))
		for x = 900, R.x1 - 20, 60 do
			K.streetLight(wf, V3(x, 6, bz + dz), V3(0, 0, -math.sign(dz)), (x // 60) % 2 == 0, 26)
		end
	end
	for x = 920, R.x1 - 40, 80 do
		part(wf, "BridgePier", V3(10, 16, 32), CF(x, -4, bz), Color3.fromRGB(120, 116, 110), M.Concrete)
	end
	for _, dz in ipairs({ -16, 16 }) do
		for _, x in ipairs({ 940, 1090 }) do
			part(wf, "BridgePylon", V3(4, 44, 4), CF(x, 22, bz + dz), Color3.fromRGB(60, 90, 120), M.Metal)
		end
		rod(wf, "BridgeCable", V3(940, 44, bz + dz), V3(1015, 10, bz + dz), 0.5, C.steelLight, M.Metal)
		rod(wf, "BridgeCable", V3(1090, 44, bz + dz), V3(1015, 10, bz + dz), 0.5, C.steelLight, M.Metal)
		rod(wf, "BridgeCable", V3(940, 44, bz + dz), V3(880, 8, bz + dz), 0.5, C.steelLight, M.Metal)
		rod(wf, "BridgeCable", V3(1090, 44, bz + dz), V3(1148, 8, bz + dz), 0.5, C.steelLight, M.Metal)
	end
end

------------------------------------------------------------------------
-- North: Arena Way, the plaza and the Grand Arena with its parking lots
------------------------------------------------------------------------
local function buildArena(root)
	local f = folder(root, "Arena")
	local rng = Random.new(77)
	local AW, AR = CITY.ArenaWay, CITY.Arena
	local c = V3(AR.x, 0, AR.z)
	local R, H = AR.r, 70
	-- the boulevard: two carriageways round a planted median, wide sidewalks, banners on the lamps
	local cw = (AW.w - 9) / 2
	K.roadZ(f, "ArenaWayW", AW.z0, AW.z1, AW.x - 4.5 - cw / 2, cw, { y = ROAD_Y - 0.004, sw = { w = 12 }, center = "none" })
	K.roadZ(f, "ArenaWayE", AW.z0, AW.z1, AW.x + 4.5 + cw / 2, cw, { y = ROAD_Y - 0.004, sw = { e = 12 }, center = "none" })
	slab(f, "Median", AW.x - 4.5, AW.x + 4.5, AW.z0 + 10, AW.z1 - 10, SW_H, K.PAVING, M.Pavement)
	for z = AW.z0 + 24, AW.z1 - 24, 24 do
		K.tree(f, V3(AW.x, SW_H, z), "palm", rng:NextNumber(30, 38), rng)
		K.streetLight(f, V3(AW.x - AW.w / 2 - 1.6, SW_H, z + 12), V3(1, 0, 0), true)
		K.streetLight(f, V3(AW.x + AW.w / 2 + 1.6, SW_H, z + 12), V3(-1, 0, 0), true)
	end
	K.dashesZ(f, AW.z0, AW.z1, AW.x - 4.5 - cw / 2, K.LINE_WHITE, 8, 16, 0.4)
	K.dashesZ(f, AW.z0, AW.z1, AW.x + 4.5 + cw / 2, K.LINE_WHITE, 8, 16, 0.4)
	K.crosswalk(f, V3(AW.x, 0, AW.z1 - 4), true, AW.w, 8)
	K.crosswalk(f, V3(AW.x - 26, 0, LOOP.z0), false, LOOP.w, 8)
	K.crosswalk(f, V3(AW.x + 26, 0, LOOP.z0), false, LOOP.w, 8)
	K.trafficSignal(f, V3(-30, SW_H, LOOP.z0 + LW + 2), V3(0, 0, -1), 22, V3(-1, 0, 0), "GYM LOOP")
	K.trafficSignal(f, V3(30, SW_H, LOOP.z0 - LW - 2), V3(0, 0, 1), 22, V3(1, 0, 0), "GYM LOOP")
	K.trafficSignal(f, V3(30, SW_H, LOOP.z0 + LW + 2), V3(-1, 0, 0), 20, V3(0, 0, -1), "ARENA WAY")
	K.streetSign(f, V3(-28, SW_H, LOOP.z0 - LW - 2), "ARENA WAY", 0, "GYM LOOP")
	-- the plaza in front of the arena: paving bands, flags, light towers, ticket booths, the fan site
	slab(f, "ArenaPlaza", -170, 170, -530, AW.z0, 0.3, Color3.fromRGB(176, 170, 160), M.Pavement)
	for k = 0, 6 do
		slab(f, "PlazaBand", -170, 170, -520 + k * 8, -518.5 + k * 8, 0.31, Color3.fromRGB(120, 110, 100), M.Concrete)
	end
	for i, x in ipairs({ -75, -45, -15, 15, 45, 75 }) do
		K.flagPole(f, V3(x, 0.3, AW.z0 - 10), 36, (i % 2 == 0) and C.gold or C.red, (i % 2 == 0) and "WCB" or "FIGHT\nNIGHT", (i % 2 == 0) and C.black or C.white)
	end
	for _, x in ipairs({ -150, 150 }) do
		part(f, "LightTower", V3(2.2, 100, 2.2), CF(x, 50, -500), Color3.fromRGB(70, 72, 80), M.Metal, { collide = true })
		local head = part(f, "TowerLights", V3(14, 5, 1.4), CFrame.lookAt(V3(x, 98, -500), V3(0, 10, -520)), Color3.fromRGB(255, 255, 235), M.Neon, { shadow = false })
		local l = spot(emitter(f, head.CFrame * CF(0, 0, -1)), Enum.NormalId.Front, Color3.fromRGB(255, 250, 230), 220, 1.6, 50)
		l.Enabled = false
		tag(l, "NightLight")
	end
	for _, x in ipairs({ -120, 120 }) do
		part(f, "TicketBooth", V3(14, 11, 10), CF(x, 5.8, -485), Color3.fromRGB(40, 42, 50), M.Concrete, { collide = true })
		local tb = part(f, "TicketWindow", V3(10, 5, 0.1), CF(x, 5.2, -479.9), Color3.fromRGB(170, 205, 230), M.Glass, { transparency = 0.4, shadow = false })
		local _ = tb
		local ts = part(f, "TicketSign", V3(12, 2.4, 0.3), CF(x, 9.6, -479.8), Color3.fromRGB(150, 16, 24), M.SmoothPlastic)
		GymDecor.Sign(ts, Enum.NormalId.Front, "BOX OFFICE", Color3.fromRGB(255, 220, 90), Color3.fromRGB(150, 16, 24), 30)
	end
	for _, x in ipairs({ -100, -60, 60, 100 }) do
		K.planter(f, CF(x, 0.3, -470 - 8), 10, 3)
		K.bench(f, V3(x, 0.3, -492), 0, 6.4, C.wood)
		K.bin(f, V3(x + 5, 0.3, -496))
	end
	for _, x in ipairs({ -30, 30 }) do
		K.vendorCart(f, CF(x, 0.3, -488) * ANG(0, RAD(x < 0 and -20 or 20), 0), x < 0 and "hotdog" or "pretzel")
	end
	site("FanArena", CFrame.lookAt(V3(0, 0.3, -500), V3(0, 0.3, -520)), { Len = 40, Rows = 2 })
	-- the arena: a drum of 28 bays (glass band, LED ring, ribs) under a shallow dome; the entrance
	-- block on the south with the big screen, canopy, doors and banners
	local segs = 28
	for k = 0, segs - 1 do
		local a = (k + 0.5) / segs * math.pi * 2
		local dir = V3(math.sin(a), 0, math.cos(a))
		local pos = c + dir * R + V3(0, H / 2, 0)
		local w = 2 * R * math.sin(math.pi / segs) + 1
		local cf = CFrame.lookAt(pos, pos + dir)
		part(f, "ArenaWall", V3(w, H, 4), cf, Color3.fromRGB(56, 58, 66), M.Concrete, { collide = true })
		part(f, "ArenaGlass", V3(w, 14, 0.5), cf * CF(0, -H / 2 + 12, -2.2), Color3.fromRGB(120, 170, 220), M.Glass, { transparency = 0.15, reflect = 0.2 })
		part(f, "ArenaGlass", V3(w, 10, 0.5), cf * CF(0, 10, -2.2), Color3.fromRGB(120, 170, 220), M.Glass, { transparency = 0.15, reflect = 0.2 })
		part(f, "ArenaLED", V3(w, 2.2, 0.4), cf * CF(0, H / 2 - 4, -2.25), k % 2 == 0 and Color3.fromRGB(255, 40, 50) or C.gold, M.Neon, { shadow = false })
		part(f, "ArenaRib", V3(1.4, H - 6, 1.4), cf * CF(w / 2 - 0.7, -2, -2.6), Color3.fromRGB(80, 82, 90), M.Metal)
	end
	vcyl(f, "ArenaRoof", 3, 2 * R + 6, CF(c + V3(0, H, 0)), Color3.fromRGB(70, 72, 80), M.Metal)
	blob(f, "ArenaDome", V3(2 * R - 16, 40, 2 * R - 16), CF(c + V3(0, H + 3, 0)), Color3.fromRGB(205, 210, 218), M.Metal)
	vcyl(f, "ArenaSpire", 24, 3, CF(c + V3(0, H + 22, 0)), C.steelLight, M.Metal)
	ball(f, "ArenaSpireLight", 2.6, CF(c + V3(0, H + 47, 0)), Color3.fromRGB(255, 40, 40), M.Neon, { shadow = false })
	local FZ = -530 -- the entrance block's facade
	part(f, "EntranceBlock", V3(120, 48, 30), CF(0, 24, FZ - 15), Color3.fromRGB(40, 42, 50), M.Concrete, { collide = true })
	part(f, "EntranceTrim", V3(120.6, 1.6, 30.6), CF(0, 48.8, FZ - 15), Color3.fromRGB(190, 20, 30), M.SmoothPlastic)
	local screen = part(f, "ArenaScreen", V3(70, 24, 1), CF(0, 34, FZ + 0.6), Color3.fromRGB(8, 8, 12), M.SmoothPlastic)
	local sg = gui(screen, Enum.NormalId.Back, 8, 0, 2500)
	frame(sg, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(8, 8, 12) })
	frame(sg, { Size = UDim2.fromScale(1, 0.22), BackgroundColor3 = Color3.fromRGB(190, 20, 30) })
	label(sg, "GRAND ARENA", { Name = "ScreenTop", TextColor3 = Color3.new(1, 1, 1), Size = UDim2.fromScale(0.9, 0.18), Position = UDim2.fromScale(0.05, 0.02) })
	label(sg, "FIGHT NIGHT", { Name = "ScreenHeadline", TextColor3 = C.gold, Size = UDim2.fromScale(0.9, 0.38), Position = UDim2.fromScale(0.05, 0.26) })
	label(sg, "SATURDAY  -  WORLD TITLE ON THE LINE", { Name = "ScreenSub", TextColor3 = Color3.new(1, 1, 1), Face = "signSub", Size = UDim2.fromScale(0.9, 0.16), Position = UDim2.fromScale(0.05, 0.7) })
	screen:SetAttribute("Kind", "ArenaScreen")
	tag(screen, "CityScreen")
	K.neonOutline(f, CF(0, 34, FZ + 1.3), 70.6, 24.6, Color3.fromRGB(255, 60, 70))
	local nameBand = part(f, "ArenaName", V3(80, 5, 0.6), CF(0, 19.5, FZ + 0.4), Color3.fromRGB(14, 14, 18), M.SmoothPlastic)
	Signage.Board(nameBand, Enum.NormalId.Back, "arena", { maxDist = 2000 })
	part(f, "EntranceCanopy", V3(90, 1.6, 16), CF(0, 15, FZ + 8), Color3.fromRGB(30, 30, 34), M.Metal)
	for _, x in ipairs({ -42, -14, 14, 42 }) do
		part(f, "CanopyPost", V3(1.4, 14.4, 1.4), CF(x, 7.2, FZ + 15), Color3.fromRGB(30, 30, 34), M.Metal, { collide = true })
	end
	for k = 0, 5 do
		part(f, "ArenaDoor", V3(9, 12, 0.3), CF(-32 + k * 12.8, 6.4, FZ + 0.15), Color3.fromRGB(160, 200, 230), M.Glass, { transparency = 0.3 })
	end
	part(f, "ArenaSteps", V3(110, 0.6, 10), CF(0, 0.3 + 0.3, FZ + 5), Color3.fromRGB(150, 148, 144), M.Concrete, { collide = true })
	part(f, "ArenaSteps", V3(110, 0.6, 5), CF(0, 0.9 + 0.3, FZ + 2.5), Color3.fromRGB(150, 148, 144), M.Concrete, { collide = true })
	for i, x in ipairs({ -50, 50 }) do
		local b = part(f, "ArenaBanner", V3(8, 26, 0.3), CF(x, 30, FZ + 0.1), i == 1 and Color3.fromRGB(190, 20, 30) or Color3.fromRGB(20, 40, 120), M.Fabric)
		GymDecor.Sign(b, Enum.NormalId.Back, i == 1 and "LIVE\nFIGHTS" or "WORLD\nTITLE", Color3.new(1, 1, 1), nil, 20)
	end
	for _, x in ipairs({ -30, 30 }) do
		spot(emitter(f, CF(x, 14, FZ + 8)), Enum.NormalId.Bottom, Color3.fromRGB(255, 225, 180), 34, 1.6, 110)
	end
	-- parking lots both sides, access lanes from the plaza
	for _, side in ipairs({ -1, 1 }) do
		slab(f, "ArenaLane", side > 0 and 170 or -200, side > 0 and 200 or -170, -560, AW.z0, ROAD_Y - 0.01, K.ASPHALT, M.Asphalt)
		K.parkingLot(f, side > 0 and 180 or -420, side > 0 and 420 or -180, -740, -560, { rng = rng, fill = 0.22 })
		local lotSign = part(f, "LotSign", V3(10, 3, 0.3), CF(side * 185, 8, -552), Color3.fromRGB(30, 60, 160), M.SmoothPlastic)
		GymDecor.Sign(lotSign, Enum.NormalId.Back, "P  ARENA PARKING", C.white, Color3.fromRGB(30, 60, 160), 40)
		part(f, "LotSignPole", V3(0.4, 6.5, 0.4), CF(side * 185, 3.25, -552), C.steel, M.Metal)
	end
	-- a service yard behind the arena: trucks, a loading dock
	slab(f, "ServiceYard", -80, 80, -800, -760, ROAD_Y - 0.01, K.ASPHALT_OLD, M.Asphalt)
	for i, x in ipairs({ -50, -20, 20 }) do
		K.car(f, CF(x, ROAD_Y, -782) * ANG(0, 0, 0), K.CAR_COLORS[(i * 2) % #K.CAR_COLORS + 1], "van")
	end
	K.fenceChain(f, V3(-80, 0.3, -800), V3(80, 0.3, -800), 8)
	lightZone(f, "ArenaZone", V3(400, 90, 400), CF(0, 45, -640), "Street")
end

------------------------------------------------------------------------
-- North-east: the WCB Elite Performance Center (a bigger, newer gym across town). The shell is
-- shared; its roller shutters, lights and the elite decor open up for you (CityVisuals) once your
-- facility reaches the Elite tier (Catalog.GymTier index >= 3). Then Foundry Street's warehouses and
-- the construction site east of the loop.
------------------------------------------------------------------------
local ELITE = { x0 = 320, x1 = 520, z0 = -560, z1 = -420, h = 36 }
CityMap.EliteCenter = ELITE

local function buildEliteCenter(root)
	local f = folder(root, "EliteCenter")
	local E = ELITE
	local EW = CITY.EliteWay
	local rng = Random.new(99)
	local cx, cz = (E.x0 + E.x1) / 2, (E.z0 + E.z1) / 2
	local clad = Color3.fromRGB(44, 46, 52)
	local glassC = Color3.fromRGB(150, 190, 215)
	-- access road from Foundry Street, the plaza with its sprint lane, the car park
	K.roadZ(f, "EliteWay", EW.z0, EW.z1, EW.x, EW.w, { y = ROAD_Y - 0.004, sw = { w = 8, e = 8 } })
	slab(f, "ElitePlaza", E.x0 - 20, E.x1 + 20, E.z1, EW.z0, 0.3, Color3.fromRGB(190, 190, 194), M.Pavement)
	local lane = part(f, "SprintLane", V3(120, 0.08, 10), CF(cx - 20, 0.34, -400), Color3.fromRGB(170, 50, 44), M.Rubber)
	local lg = gui(lane, Enum.NormalId.Top, 4, 1, 200)
	for k = 1, 3 do
		frame(lg, { Size = UDim2.new(1, 0, 0, 2), Position = UDim2.fromScale(0, k / 4), BackgroundColor3 = C.white })
	end
	K.parkingLot(f, E.x1 + 24, E.x1 + 120, E.z1 - 60, EW.z0, { rng = rng, fill = 0.3 })
	-- building: plinth, floor, solid back and sides, glass curtain wall on the south front
	part(f, "ElitePlinth", V3(E.x1 - E.x0 + 6, 0.8, E.z1 - E.z0 + 6), CF(cx, 0.4, cz), Color3.fromRGB(120, 120, 126), M.Concrete, { collide = true })
	part(f, "EliteFloor", V3(E.x1 - E.x0, 0.3, E.z1 - E.z0), CF(cx, 0.95, cz), Color3.fromRGB(58, 60, 66), M.Rubber, { collide = true })
	part(f, "EliteBackWall", V3(E.x1 - E.x0, E.h, 1.6), CF(cx, E.h / 2, E.z0), clad, M.Concrete, { collide = true })
	for _, x in ipairs({ E.x0, E.x1 }) do
		part(f, "EliteSideWall", V3(1.6, E.h, E.z1 - E.z0), CF(x, E.h / 2, cz), clad, M.Concrete, { collide = true })
	end
	part(f, "EliteRoof", V3(E.x1 - E.x0 + 4, 1.6, E.z1 - E.z0 + 8), CF(cx, E.h + 0.8, cz + 2), Color3.fromRGB(30, 32, 36), M.Metal, { collide = true })
	for k = 0, 8 do
		part(f, "RoofFin", V3(0.8, 3.4, E.z1 - E.z0 + 6), CF(E.x0 + 10 + k * (E.x1 - E.x0 - 20) / 8, E.h + 3.2, cz + 2), Color3.fromRGB(70, 72, 80), M.Metal)
	end
	local doorW = 20
	for _, sp in ipairs({ { E.x0, cx - doorW / 2 }, { cx + doorW / 2, E.x1 } }) do
		local w = sp[2] - sp[1]
		part(f, "EliteGlass", V3(w, E.h - 1.2, 0.4), CF((sp[1] + sp[2]) / 2, (E.h - 1.2) / 2 + 0.8, E.z1), glassC, M.Glass, { transparency = 0.35, reflect = 0.15, collide = true })
		for k = 0, math.floor(w / 8) do
			part(f, "EliteMullion", V3(0.45, E.h - 1.2, 0.6), CF(sp[1] + k * w / math.floor(w / 8), (E.h - 1.2) / 2 + 0.8, E.z1), Color3.fromRGB(26, 26, 30), M.Metal)
		end
	end
	part(f, "EliteTransom", V3(doorW + 1.5, E.h - 15, 1.0), CF(cx, 15 + (E.h - 15) / 2, E.z1), clad, M.Concrete, { collide = true })
	for _, sx in ipairs({ -1, 1 }) do
		local sh = part(f, "EliteShutter", V3(doorW / 2, 14.2, 0.5), CF(cx + sx * doorW / 4, 7.9, E.z1 + 0.25), Color3.fromRGB(150, 152, 158), M.DiamondPlate, { collide = true })
		local sg = gui(sh, Enum.NormalId.Back, 8, 0.6, 200)
		for k = 0, 11 do
			frame(sg, { Size = UDim2.new(1, 0, 0, 2), Position = UDim2.fromScale(0, k / 12), BackgroundColor3 = Color3.fromRGB(90, 92, 98) })
		end
	end
	part(f, "EliteCanopy", V3(doorW + 16, 0.8, 10), CF(cx, 15.6, E.z1 + 5), Color3.fromRGB(26, 26, 30), M.Metal)
	local band = part(f, "EliteSign", V3(70, 4.6, 0.5), CF(cx, E.h - 4, E.z1 + 0.6), Color3.fromRGB(16, 16, 20), M.SmoothPlastic)
	local bsg = Signage.Board(band, Enum.NormalId.Back, "elite", { maxDist = 1500 })
	local bwm = bsg:FindFirstChild("Wordmark", true)
	if bwm then
		bwm.Name = "SignText"
		bwm.TextColor3 = Color3.fromRGB(120, 128, 140)
	end
	-- inside: glass partitions with doorways split recovery / motion capture / sports science
	for _, px in ipairs({ E.x0 + 66, E.x1 - 66 }) do
		for _, sp in ipairs({ { E.z0 + 1, cz - 6 }, { cz + 6, E.z1 - 1 } }) do
			part(f, "ElitePartition", V3(0.4, 16, sp[2] - sp[1]), CF(px, 9, (sp[1] + sp[2]) / 2), Color3.fromRGB(200, 220, 235), M.Glass, { transparency = 0.55, collide = true })
		end
	end
	for _, x in ipairs({ E.x0 + 33, cx, E.x1 - 33 }) do
		for _, z in ipairs({ cz - 36, cz, cz + 36 }) do
			local fix = part(f, "EliteLightPanel", V3(10, 0.25, 3), CF(x, E.h - 0.25, z), Color3.fromRGB(230, 236, 246), M.SmoothPlastic, { shadow = false })
			local l = spot(fix, Enum.NormalId.Bottom, Color3.fromRGB(228, 238, 255), 44, 1.5, 120)
			l.Name = "EliteCenterLight"
			l.Enabled = false
		end
	end
	lightZone(f, "EliteZone", V3(E.x1 - E.x0, E.h, E.z1 - E.z0), CF(cx, E.h / 2, cz), "GymElite")
	site("EliteCenter", CFrame.lookAt(V3(cx, 1.1, E.z1 - 10), V3(cx, 1.1, E.z0)))
	site("EliteEntrance", CFrame.lookAt(V3(cx, 0.3, E.z1 + 10), V3(cx, 0.3, E.z1)))
	site("EliteRecovery", CFrame.lookAt(V3(E.x0 + 33, 1.1, cz), V3(E.x0 + 33, 1.1, E.z1)))
	site("EliteMocap", CFrame.lookAt(V3(cx, 1.1, cz - 4), V3(cx, 1.1, E.z1)))
	site("EliteLab", CFrame.lookAt(V3(E.x1 - 33, 1.1, cz), V3(E.x1 - 33, 1.1, E.z1)))
	promptPart(f, "ElitePrompt", V3(cx - doorW / 2 - 4, 3.2, E.z1 + 4), "Elite Performance Center", "Facility tier", { Action = "EliteCenter" }, Color3.fromRGB(150, 220, 255))
	for _, x in ipairs({ E.x0 - 10, cx, E.x1 + 10 }) do
		K.streetLight(f, V3(x, 0.3, EW.z0 + 4), V3(0, 0, -1), true)
	end
	for _, x in ipairs({ E.x0 - 14, E.x1 + 14 }) do
		K.flagPole(f, V3(x, 0.3, E.z1 + 12), 36, Color3.fromRGB(150, 220, 255), "WCB", C.black)
	end
	for _, p in ipairs({ V3(E.x0 - 30, 0.14, E.z1 + 30), V3(E.x1 + 150, 0.14, E.z1 - 20), V3(E.x0 - 40, 0.14, E.z0 + 20) }) do
		K.tree(f, p, "poplar", rng:NextNumber(40, 50), rng)
	end
end

-- Foundry Street carries the loop's north road east to the river: warehouses, the container yard,
-- the silos and stack; the construction site south of it
local function buildIndustrial(root)
	local f = folder(root, "Industrial")
	local rng = Random.new(1313)
	local FS = CITY.FoundryStreet
	local EW = CITY.EliteWay
	K.roadX(f, "FoundryStreet", FS.x0, FS.x1, FS.z, FS.w, { sw = { n = 8, s = 8 }, gapsN = { { EW.x - 12.5, EW.x + 12.5 }, { 600, 630 } }, gapsS = { { 640, 670 } } })
	lightsX(f, FS.x0 + 30, FS.x1 - 20, FS.z - 12.5 - 1.6, V3(0, 0, 1), 70, nil, 2)
	K.streetSign(f, V3(EW.x + 14, SW_H, FS.z - 14), "FOUNDRY ST", 0, "ELITE WAY")
	K.roadSign(f, V3(EW.x - 14, SW_H, FS.z - 14), 0, "stop")
	K.crosswalk(f, V3(EW.x, 0, FS.z - 15), true, EW.w, 8)
	-- the yards: asphalt with chain-link round them, gates on Foundry Street
	slab(f, "IndustrialYard", 550, 745, -600, FS.z - 12.5 - 8.6, ROAD_Y - 0.02, K.ASPHALT_OLD, M.Asphalt)
	K.fenceChain(f, V3(550, 0.3, -321), V3(598, 0.3, -321), 8)
	K.fenceChain(f, V3(632, 0.3, -321), V3(745, 0.3, -321), 8)
	K.fenceChain(f, V3(550, 0.3, -321), V3(550, 0.3, -600), 8)
	K.fenceChain(f, V3(550, 0.3, -600), V3(745, 0.3, -600), 8)
	local steel = Color3.fromRGB(150, 154, 160)
	local function warehouse(x0, x1, z0, z1, h, name, color, bays)
		local cx, cz = (x0 + x1) / 2, (z0 + z1) / 2
		local m = model(f, "Warehouse")
		part(m, "WarehouseBody", V3(x1 - x0, h, z1 - z0), CF(cx, h / 2, cz), color or steel, M.DiamondPlate, { collide = true })
		part(m, "WarehouseBase", V3(x1 - x0 + 0.4, 4, z1 - z0 + 0.4), CF(cx, 2, cz), Color3.fromRGB(90, 92, 96), M.Concrete)
		local ra = V3(cx, h + 4, z0 + (z1 - z0) / 4)
		local rb = V3(cx, h + 4, z1 - (z1 - z0) / 4)
		part(m, "WarehouseRoof", V3(x1 - x0 + 2, 8, (z1 - z0) / 2 + 1), CFrame.lookAt(ra, ra + V3(0, 0, -1)), Color3.fromRGB(80, 84, 92), M.Metal, { class = "WedgePart" })
		part(m, "WarehouseRoof", V3(x1 - x0 + 2, 8, (z1 - z0) / 2 + 1), CFrame.lookAt(rb, rb + V3(0, 0, 1)), Color3.fromRGB(80, 84, 92), M.Metal, { class = "WedgePart" })
		for k = 1, bays do
			local dx = x0 + k * (x1 - x0) / (bays + 1)
			part(m, "RollerDoor", V3(16, 14, 0.4), CF(dx, 7.6, z1 + 0.2), Color3.fromRGB(60, 80, 110), M.Metal)
			part(m, "LoadingDock", V3(18, 4, 6), CF(dx, 2, z1 + 3), Color3.fromRGB(120, 120, 124), M.Concrete, { collide = true })
			part(m, "DockBumper", V3(18, 1, 0.6), CF(dx, 3.6, z1 + 6.2), C.black, M.Rubber, { shadow = false })
		end
		local ws = part(m, "WarehouseSign", V3((x1 - x0) * 0.5, 5, 0.4), CF(cx, h - 4, z1 + 0.2), Color3.fromRGB(26, 28, 34), M.SmoothPlastic)
		GymDecor.Sign(ws, Enum.NormalId.Back, name, C.white, Color3.fromRGB(26, 28, 34), 30)
		for k = 0, 3 do
			part(m, "WarehouseVent", V3(4, 2.4, 4), CF(x0 + 20 + k * (x1 - x0 - 40) / 3, h + 7, cz), steel, M.Metal)
		end
		return m
	end
	warehouse(560, 680, -440, -350, 24, "IRONWORKS SUPPLY CO.", Color3.fromRGB(150, 154, 160), 3)
	warehouse(600, 740, -590, -470, 28, "RIVERSIDE COLD STORAGE", Color3.fromRGB(96, 110, 130), 3)
	-- the container yard west of the cold store, a forklift's worth of pallets, trucks
	local cols = { Color3.fromRGB(150, 50, 40), Color3.fromRGB(40, 80, 150), Color3.fromRGB(60, 120, 70), Color3.fromRGB(200, 120, 30), Color3.fromRGB(120, 124, 132) }
	for k = 0, 2 do
		K.container(f, CF(572, ROAD_Y, -480 - k * 11) * ANG(0, RAD(90), 0), cols[k + 1], "WCB LINES")
	end
	K.container(f, CF(572, ROAD_Y + 8.7, -485.5) * ANG(0, RAD(90), 0), cols[4], "WCB LINES")
	K.container(f, CF(572, ROAD_Y, -560) * ANG(0, RAD(90), 0), cols[5])
	for i, x in ipairs({ 600, 640, 680 }) do
		K.car(f, CF(x, ROAD_Y, -336) * ANG(0, RAD(180), 0), K.CAR_COLORS[i + 2], i == 2 and "pickup" or "van")
	end
	for _, x in ipairs({ 590, 700 }) do
		K.streetLight(f, V3(x, ROAD_Y, -455), V3(0, 0, 1), true, 30)
	end
	-- silos and the stack at the west end of the yard
	for i, x in ipairs({ 470, 500 }) do
		vcyl(f, "Silo", 60, 20, CF(x, 0.3, -600), Color3.fromRGB(200, 202, 206), M.Metal, { collide = true })
		blob(f, "SiloCap", V3(21, 10, 21), CF(x, 62, -600), Color3.fromRGB(170, 172, 178), M.Metal)
		if i == 1 then
			local ss = part(f, "SiloSign", V3(14, 14, 0.3), CF(x, 36, -589.7), Color3.fromRGB(200, 202, 206), M.SmoothPlastic)
			GymDecor.Sign(ss, Enum.NormalId.Back, "IRON\nWORKS", Color3.fromRGB(150, 50, 40), Color3.fromRGB(200, 202, 206), 30)
		end
	end
	vcyl(f, "Smokestack", 110, 9, CF(530, 0.3, -640), Color3.fromRGB(120, 70, 60), M.Brick, { collide = true })
	for k = 0, 2 do
		vcyl(f, "StackBand", 2, 9.4, CF(530, 70 + k * 16, -640), C.white, M.SmoothPlastic, { shadow = false })
	end
	ball(f, "StackLight", 2, CF(530, 111.5, -640), Color3.fromRGB(255, 40, 40), M.Neon, { shadow = false })
	part(f, "BoilerHouse", V3(60, 26, 40), CF(500, 13, -650), Color3.fromRGB(120, 70, 60), M.Brick, { collide = true })
	K.fenceChain(f, V3(440, 0.3, -560), V3(560, 0.3, -560), 8)
	K.fenceChain(f, V3(440, 0.3, -560), V3(440, 0.3, -700), 8)
	K.fenceChain(f, V3(440, 0.3, -700), V3(560, 0.3, -700), 8)

	-- the construction site east of the loop: hoarding, dirt, a concrete frame going up, a tower
	-- crane, scaffolding, site cabins, materials, cones, the developer's board
	local cs = folder(root, "Construction")
	local sx0, sx1, sz0, sz1 = 580, 720, -265, -190
	part(cs, "SiteDirt", V3(sx1 - sx0, 0.3, sz1 - sz0), CF((sx0 + sx1) / 2, 0.15, (sz0 + sz1) / 2), Color3.fromRGB(120, 92, 62), M.Ground, { collide = true })
	for _, r in ipairs(K.cutRanges(sx0, sx1, { { 640, 670 } })) do
		K.hoarding(cs, V3(r[1], 0.3, sz0), V3(r[2], 0.3, sz0), Color3.fromRGB(40, 90, 170))
	end
	K.hoarding(cs, V3(sx0, 0.3, sz1), V3(sx1, 0.3, sz1), Color3.fromRGB(40, 90, 170))
	K.hoarding(cs, V3(sx0, 0.3, sz0), V3(sx0, 0.3, sz1), Color3.fromRGB(40, 90, 170))
	K.hoarding(cs, V3(sx1, 0.3, sz0), V3(sx1, 0.3, sz1), Color3.fromRGB(40, 90, 170))
	local gate = part(cs, "SiteGate", V3(30, 7.8, 0.3), CF(655, 4.2, sz0), Color3.fromRGB(150, 154, 160), M.DiamondPlate, { transparency = 0.5, collide = true })
	local _ = gate
	local board = part(cs, "SiteBoard", V3(28, 10, 0.4), CF(610, 12, sz0 - 1), C.white, M.SmoothPlastic)
	for _, x in ipairs({ 598, 622 }) do
		part(cs, "SiteBoardPost", V3(0.6, 17, 0.6), CF(x, 8.5, sz0 - 1), Color3.fromRGB(60, 50, 40), M.Wood, { collide = true })
	end
	local bsg = gui(board, Enum.NormalId.Front, 20, 0.2, 500)
	frame(bsg, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.white })
	frame(bsg, { Size = UDim2.fromScale(1, 0.26), BackgroundColor3 = Color3.fromRGB(40, 90, 170) })
	label(bsg, "APEX BUILDERS", { TextColor3 = C.white, Size = UDim2.fromScale(0.9, 0.2), Position = UDim2.fromScale(0.05, 0.03) })
	label(bsg, "COMING 2027\nWCB TRAINING TOWER\n12 STOREYS  -  ROOFTOP RING", { TextColor3 = Color3.fromRGB(30, 30, 34), Face = "signSub", Size = UDim2.fromScale(0.9, 0.6), Position = UDim2.fromScale(0.05, 0.32) })
	-- the frame: three floors of slabs on columns, the core, rebar on top
	local fx, fz = 650, -225
	for lvl = 0, 3 do
		part(cs, "FrameSlab", V3(60, 1.2, 40), CF(fx, 0.6 + lvl * 12, fz), Color3.fromRGB(170, 170, 166), M.Concrete, { collide = true })
		if lvl < 3 then
			for _, dx in ipairs({ -27, -9, 9, 27 }) do
				for _, dz in ipairs({ -17, 0, 17 }) do
					part(cs, "FrameColumn", V3(2, 10.8, 2), CF(fx + dx, 1.2 + 5.4 + lvl * 12, fz + dz), Color3.fromRGB(170, 170, 166), M.Concrete, { collide = true })
				end
			end
		end
	end
	part(cs, "FrameCore", V3(12, 48, 12), CF(fx + 18, 24, fz + 8), Color3.fromRGB(150, 150, 146), M.Concrete, { collide = true })
	for k = 0, 5 do
		part(cs, "Rebar", V3(0.2, 6, 0.2), CF(fx - 26 + k * 10, 40, fz - 16), Color3.fromRGB(120, 70, 50), M.Metal, { shadow = false })
	end
	-- scaffolding along the west face
	for lvl = 0, 3 do
		part(cs, "ScaffoldDeck", V3(4, 0.3, 42), CF(fx - 33, 11.5 + lvl * 12, fz), Color3.fromRGB(190, 150, 90), M.WoodPlanks)
		part(cs, "ScaffoldRail", V3(0.2, 0.2, 42), CF(fx - 35, 13.4 + lvl * 12, fz), steel, M.Metal, { shadow = false })
	end
	for _, dz in ipairs({ -20, -10, 0, 10, 20 }) do
		for _, dx in ipairs({ -35, -31 }) do
			part(cs, "ScaffoldPost", V3(0.3, 48, 0.3), CF(fx + dx, 24, fz + dz), steel, M.Metal)
		end
	end
	part(cs, "ScaffoldNet", V3(0.1, 46, 42), CF(fx - 36, 24, fz), Color3.fromRGB(60, 160, 90), M.Fabric, { transparency = 0.5, shadow = false })
	-- the tower crane
	local cb = V3(fx + 40, 0.3, fz - 10)
	part(cs, "CraneBase", V3(10, 2, 10), CF(cb + V3(0, 1, 0)), Color3.fromRGB(120, 120, 124), M.Concrete, { collide = true })
	part(cs, "CraneMast", V3(5, 95, 5), CF(cb + V3(0, 49.5, 0)), Color3.fromRGB(240, 200, 40), M.Metal, { transparency = 0.25, collide = true })
	part(cs, "CraneCab", V3(5, 5, 6), CF(cb + V3(0, 99, -3)), Color3.fromRGB(240, 200, 40), M.Metal)
	part(cs, "CraneJib", V3(4, 3.5, 90), CF(cb + V3(0, 101.5, -45)), Color3.fromRGB(240, 200, 40), M.Metal, { transparency = 0.25 })
	part(cs, "CraneCounterJib", V3(4, 3.5, 28), CF(cb + V3(0, 101.5, 14)), Color3.fromRGB(240, 200, 40), M.Metal, { transparency = 0.25 })
	part(cs, "CraneCounterweight", V3(6, 5, 8), CF(cb + V3(0, 100, 24)), Color3.fromRGB(120, 120, 124), M.Concrete)
	part(cs, "CraneApex", V3(2.5, 18, 2.5), CF(cb + V3(0, 112, 0)), Color3.fromRGB(240, 200, 40), M.Metal)
	rod(cs, "CraneTie", cb + V3(0, 121, 0), cb + V3(0, 103, -88), 0.4, C.steelLight, M.Metal)
	rod(cs, "CraneTie", cb + V3(0, 121, 0), cb + V3(0, 103, 26), 0.4, C.steelLight, M.Metal)
	part(cs, "CraneTrolley", V3(5, 2, 4), CF(cb + V3(0, 99, -60)), Color3.fromRGB(60, 60, 66), M.Metal)
	part(cs, "CraneCable", V3(0.2, 50, 0.2), CF(cb + V3(0, 73, -60)), C.steelLight, M.Metal, { shadow = false })
	part(cs, "CraneHook", V3(1.4, 2.6, 1.4), CF(cb + V3(0, 46.5, -60)), Color3.fromRGB(60, 60, 66), M.Metal)
	part(cs, "SlungBeam", V3(1.2, 1.2, 14), CF(cb + V3(0, 44, -60)), Color3.fromRGB(120, 70, 50), M.Metal)
	ball(cs, "CraneLight", 1.4, CF(cb + V3(0, 121.5, 0)), Color3.fromRGB(255, 40, 40), M.Neon, { shadow = false })
	-- cabins, materials, a mixer, cones, a dumpster, a portaloo
	for k = 0, 1 do
		part(cs, "SiteCabin", V3(24, 9, 10), CF(sx0 + 16, 4.9, sz1 - 12 - k * 13), Color3.fromRGB(230, 232, 236), M.SmoothPlastic, { collide = true })
		part(cs, "CabinWindow", V3(8, 3, 0.1), CF(sx0 + 16, 5.6, sz1 - 12 - k * 13 - 5.05), Color3.fromRGB(170, 205, 230), M.Glass, { shadow = false })
	end
	part(cs, "Portaloo", V3(4.4, 8, 4.4), CF(sx0 + 36, 4.3, sz1 - 8), Color3.fromRGB(40, 110, 200), M.SmoothPlastic, { collide = true })
	for k = 0, 2 do
		part(cs, "PalletStack", V3(8, 4 + k, 8), CF(sx1 - 14 - k * 10, 2.3 + k / 2, sz1 - 14), Color3.fromRGB(190, 160, 110), M.Wood, { collide = true })
	end
	blob(cs, "SandPile", V3(20, 6, 16), CF(sx1 - 30, 2.5, sz0 + 22), Color3.fromRGB(200, 180, 130), M.Sand)
	blob(cs, "GravelPile", V3(16, 5, 14), CF(sx1 - 52, 2.2, sz0 + 20), Color3.fromRGB(130, 128, 124), M.Slate)
	local mixer = CF(sx0 + 44, 0.3, sz0 + 30)
	part(cs, "MixerBody", V3(8, 6, 18), mixer * CF(0, 4, 0), Color3.fromRGB(240, 200, 40), M.Metal, { collide = true })
	cyl(cs, "MixerDrum", 10, 7, mixer * CF(0, 8.5, 3) * ANG(0, RAD(90), RAD(12)), Color3.fromRGB(230, 232, 236), M.Metal)
	for _, z in ipairs({ -6, 5 }) do
		for _, x in ipairs({ -4, 4 }) do
			cyl(cs, "Wheel", 1.4, 3.2, mixer * CF(x, 1.6, z), C.black, M.Rubber)
		end
	end
	for k = 0, 5 do
		K.cone(cs, V3(644 + k * 4, 0.3, sz0 - 4))
	end
	K.dumpster(cs, CF(sx0 + 60, 0.3, sz1 - 8), Color3.fromRGB(200, 90, 30))
	K.streetLight(cs, V3(sx0 + 6, 0.3, sz0 + 6), V3(1, 0, 0.5).Unit, true, 26)
	K.streetLight(cs, V3(sx1 - 6, 0.3, sz1 - 6), V3(-1, 0, -0.5).Unit, false, 26)
end

------------------------------------------------------------------------
-- Billboards around town: generic ads for everyone, your sponsors / fight promos for you
------------------------------------------------------------------------
local function buildBillboards(root)
	local f = folder(root, "Billboards")
	local ADS = K.ADS
	local list = {
		{ "Champion", CFrame.lookAt(V3(-34, 20, 240), V3(0, 20, 240)), 36, 12, ADS[3] },
		{ "Cafe", CFrame.lookAt(V3(-222, 60, MAIN.frontS + 40), V3(-222, 60, 200)), 44, 14, ADS[1], 10 },
		{ "Apartments", CFrame.lookAt(V3(189, 72, MAIN.frontS + 36), V3(189, 72, 200)), 44, 14, ADS[2], 10 },
		{ "Loop", CFrame.lookAt(V3(262, 20, -230), V3(0, 20, -230)), 36, 12, ADS[4] },
		{ "ArenaW", CFrame.lookAt(V3(-40, 24, -395), V3(-40, 24, -300)), 40, 13, ADS[3] },
		{ "ArenaE", CFrame.lookAt(V3(40, 24, -395), V3(40, 24, -300)), 40, 13, ADS[5] },
		{ "Oak", CFrame.lookAt(V3(-470, 20, 262), V3(-440, 20, 300)), 32, 11, ADS[6] },
		{ "River", CFrame.lookAt(V3(790, 22, 440), V3(760, 22, 400)), 36, 12, ADS[7] },
		{ "Foundry", CFrame.lookAt(V3(300, 24, -324), V3(300, 24, -290)), 40, 13, ADS[2] },
	}
	for _, b in ipairs(list) do
		K.billboard(f, b[2], b[3], b[4], b[1], b[5], b[6])
	end
end

------------------------------------------------------------------------
-- Far away: the mountain training camp (Mountain / Elite Camp owners can travel here during a
-- camp; CityVisuals tints the local atmosphere while you are inside the pod)
------------------------------------------------------------------------
local CAMP = V3(-3000, 0, 3000)
CityMap.CampCenter = CAMP

local function buildCamp(root)
	local f = folder(root, "TrainingCamp")
	local rng = Random.new(1985)
	local snow = Color3.fromRGB(236, 240, 246)
	part(f, "CampGround", V3(480, 2, 480), CF(CAMP + V3(0, -1, 0)), snow, M.Snow, { collide = true })
	blob(f, "CampHill", V3(220, 70, 140), CF(CAMP + V3(0, -8, -180)), snow, M.Snow)
	blob(f, "CampHill", V3(180, 60, 120), CF(CAMP + V3(-160, -10, -120)), snow, M.Snow)
	-- log cabin with porch, chimney smoke and a warm window
	local cab = CF(CAMP + V3(0, 0, -30))
	part(f, "Cabin", V3(36, 14, 22), cab * CF(0, 7, 0), Color3.fromRGB(110, 74, 46), M.WoodPlanks, { collide = true })
	local a = (cab * CF(0, 16.5, -5.5)).Position
	local b = (cab * CF(0, 16.5, 5.5)).Position
	part(f, "CabinRoof", V3(39, 5, 12), CFrame.lookAt(a, a + V3(0, 0, -1)), Color3.fromRGB(240, 244, 250), M.Snow, { class = "WedgePart", collide = true })
	part(f, "CabinRoof", V3(39, 5, 12), CFrame.lookAt(b, b + V3(0, 0, 1)), Color3.fromRGB(240, 244, 250), M.Snow, { class = "WedgePart", collide = true })
	local chim = part(f, "Chimney", V3(3, 8, 3), cab * CF(11, 17, 4), Color3.fromRGB(110, 106, 100), M.Cobblestone)
	local smoke = Instance.new("ParticleEmitter")
	smoke.Rate = 5
	smoke.Lifetime = NumberRange.new(4, 6)
	smoke.Speed = NumberRange.new(2, 3)
	smoke.Size = NumberSequence.new(1.5, 5)
	smoke.Transparency = NumberSequence.new(0.5, 1)
	smoke.Color = ColorSequence.new(Color3.fromRGB(200, 200, 205))
	smoke.Parent = chim
	part(f, "CabinPorch", V3(20, 0.8, 7), cab * CF(0, 0.4, -14.5), Color3.fromRGB(90, 60, 38), M.WoodPlanks, { collide = true })
	part(f, "CabinDoor", V3(CITY.Door.w, CITY.Door.h, 0.25), cab * CF(0, 0.8 + CITY.Door.h / 2, -11.1), Color3.fromRGB(70, 46, 30), M.Wood)
	local win = part(f, "CabinWindow", V3(5, 4, 0.15), cab * CF(-9, 7, -11.08), Color3.fromRGB(255, 200, 120), M.Neon, { transparency = 0.2, shadow = false })
	point(win, Color3.fromRGB(255, 190, 120), 18, 0.9)
	for _, x in ipairs({ -9, 9 }) do
		vcyl(f, "PorchPost", 9, 0.9, cab * CF(x, 0.8, -17), Color3.fromRGB(90, 60, 38), M.Wood, { collide = true })
	end
	part(f, "PorchRoof", V3(22, 0.6, 8), cab * CF(0, 10.2, -15), Color3.fromRGB(240, 244, 250), M.Snow)
	-- the Rocky corner: log pile, chopping block and axe, a heavy bag on a frame, campfire
	for k = 0, 5 do
		cyl(f, "Log", 8, 1.6, cab * CF(-22, 0.8 + math.floor(k / 3) * 1.4, -2 + (k % 3) * 1.7), Color3.fromRGB(120, 84, 52), M.Wood)
	end
	vcyl(f, "ChopBlock", 2.6, 3, cab * CF(-21, 0, -11), Color3.fromRGB(130, 92, 58), M.Wood, { collide = true })
	part(f, "AxeHandle", V3(0.3, 4, 0.3), cab * CF(-21, 3.8, -11) * ANG(0, 0, RAD(25)), Color3.fromRGB(150, 110, 70), M.Wood)
	part(f, "AxeHead", V3(1.2, 0.7, 0.2), cab * CF(-20.3, 3.0, -11) * ANG(0, 0, RAD(25)), C.steelLight, M.Metal)
	local bagCF = cab * CF(20, 0, -20)
	for _, x in ipairs({ -3.5, 3.5 }) do
		part(f, "BagFramePost", V3(0.8, 11, 0.8), bagCF * CF(x, 5.5, 0), Color3.fromRGB(100, 70, 44), M.Wood, { collide = true })
	end
	part(f, "BagFrameBeam", V3(8, 0.8, 0.8), bagCF * CF(0, 11, 0), Color3.fromRGB(100, 70, 44), M.Wood)
	part(f, "BagChain", V3(0.15, 3.0, 0.15), bagCF * CF(0, 9.1, 0), C.steelLight, M.Metal)
	vcyl(f, "CampBag", 5.2, 2.2, bagCF * CF(0, 2.4, 0), Color3.fromRGB(110, 70, 40), M.Leather, { collide = true })
	local fire = CF(CAMP + V3(0, 0, -2))
	for k = 0, 2 do
		cyl(f, "FireLog", 4, 0.7, fire * ANG(0, RAD(k * 60), 0) * CF(0, 0.4, 0), Color3.fromRGB(70, 48, 30), M.Wood)
	end
	for k = 0, 7 do
		local ang = k * RAD(45)
		ball(f, "FireStone", 1.3, fire * CF(math.cos(ang) * 3.2, 0.5, math.sin(ang) * 3.2), Color3.fromRGB(110, 106, 100), M.Slate)
	end
	local flame = part(f, "Campfire", V3(0.6, 0.6, 0.6), fire * CF(0, 1.0, 0), Color3.fromRGB(255, 140, 40), M.Neon, { transparency = 1, shadow = false })
	local fe = Instance.new("ParticleEmitter")
	fe.Rate = 16
	fe.Lifetime = NumberRange.new(0.5, 0.9)
	fe.Speed = NumberRange.new(2, 4)
	fe.Size = NumberSequence.new(1.2, 0.1)
	fe.Color = ColorSequence.new(Color3.fromRGB(255, 200, 80), Color3.fromRGB(255, 70, 20))
	fe.LightEmission = 0.8
	fe.Parent = flame
	point(flame, Color3.fromRGB(255, 150, 70), 22, 1.4)
	for k = 0, 2 do
		local ang = k * RAD(120) + RAD(60)
		cyl(f, "SeatLog", 6, 1.6, fire * ANG(0, ang, 0) * CF(0, 0.8, 7) * ANG(0, RAD(90), 0), Color3.fromRGB(100, 70, 44), M.Wood, { collide = true })
	end
	-- pines all round, a frozen pond, the camp sign, prompts
	local n = 0
	while n < 26 do
		local p = CAMP + V3(rng:NextNumber(-220, 220), 0, rng:NextNumber(-170, 220))
		if (p - CAMP).Magnitude > 55 then
			n += 1
			K.tree(f, p, "pine", rng:NextNumber(36, 56), rng)
		end
	end
	vcyl(f, "FrozenPond", 0.3, 60, CF(CAMP + V3(120, 0, 80)), Color3.fromRGB(200, 226, 240), M.Ice, { collide = true })
	K.postSign(f, CF(CAMP + V3(0, 0, 44)), 18, 3.6, 5, nil, nil, Color3.fromRGB(70, 46, 30), "camp")
	site("Camp", CFrame.lookAt(CAMP + V3(0, 0, 24), CAMP + V3(0, 0, -30)))
	promptPart(f, "SleepPrompt", (cab * CF(4, 2.6, -15)).Position, "Sleep in the cabin", "Training camp", { Action = "Sleep" }, Color3.fromRGB(170, 170, 255))
	promptPart(f, "LeavePrompt", CAMP + V3(0, 2.6, 36), "Back to the city", "Training camp", { Action = "LeaveCamp" }, Color3.fromRGB(255, 220, 120))
end

------------------------------------------------------------------------
-- The far skyline: the city beyond the river, the south, the north behind the arena
------------------------------------------------------------------------
local function buildSkyline(root)
	local f = folder(root, "Skyline")
	local rng = Random.new(31337)
	local B = CITY.Bounds
	-- across the river: a dense downtown seen from the boardwalk, facing west
	for z = B.z0 + 80, B.z1 - 80, 80 do
		local w = rng:NextInteger(50, 90)
		K.tower(f, V3(CITY.River.x1 + 60 + rng:NextNumber(0, 50), 0, z + rng:NextNumber(-12, 12)), w, rng:NextInteger(50, 80), rng:NextInteger(110, 300), V3(-1, 0, 0), rng, { crown = rng:NextNumber() < 0.3 })
		if rng:NextNumber() < 0.5 then
			K.tower(f, V3(CITY.River.x1 + 180 + rng:NextNumber(0, 40), 0, z + 40), rng:NextInteger(50, 80), 60, rng:NextInteger(140, 340), V3(-1, 0, 0), rng, {})
		end
	end
	-- south of downtown, behind the 2nd Street towers
	for x = -880, 880, 110 do
		K.tower(f, V3(x + rng:NextNumber(-15, 15), 0, 840 + rng:NextNumber(0, 60)), rng:NextInteger(60, 100), 70, rng:NextInteger(150, 320), V3(0, 0, -1), rng, { crown = rng:NextNumber() < 0.25 })
	end
	for x = -800, 800, 160 do
		K.tower(f, V3(x + rng:NextNumber(-20, 20), 0, 980), rng:NextInteger(70, 110), 70, rng:NextInteger(200, 360), V3(0, 0, -1), rng, {})
	end
	-- north behind the arena: a lower, older skyline and chimneys
	for x = -900, 900, 130 do
		if math.abs(x) > 60 then
			K.tower(f, V3(x + rng:NextNumber(-15, 15), 0, -1000 - rng:NextNumber(0, 60)), rng:NextInteger(50, 90), 60, rng:NextInteger(100, 240), V3(0, 0, 1), rng, { tone = rng:NextInteger(0, 1) })
		end
	end
	for _, x in ipairs({ -420, -380, 460 }) do
		vcyl(f, "Chimney", 120 + (x % 80), 10, CF(x, 0, -940), Color3.fromRGB(120, 70, 60), M.Brick)
		ball(f, "ChimneyLight", 2.2, CF(x, 121.5 + (x % 80), -940), Color3.fromRGB(255, 40, 40), M.Neon, { shadow = false })
	end
	-- the west: low blocks between the houses and the hills, south-west of Oak Street
	for z = 360, 760, 110 do
		K.tower(f, V3(-760 + rng:NextNumber(-20, 20), 0, z), rng:NextInteger(50, 80), 60, rng:NextInteger(40, 90), V3(1, 0, 0), rng, { tone = 3 })
	end
end

------------------------------------------------------------------------
-- Travel
------------------------------------------------------------------------
-- where to stand outside a home (in front of its door / gate)
function CityMap.HomeExit(profile, kind)
	kind = CityHomes.HomeKind(profile, kind) or kind
	local sitesCF = kind and K.Sites["Home" .. kind]
	if not sitesCF then
		return nil
	end
	if kind == "Mansion" then
		return sitesCF * CF(0, 3.2, -28)
	elseif kind == "House" then
		return sitesCF * CF(-7, 3.2, -18)
	end
	return sitesCF * CF(0, 3.2, -1.5)
end

-- server travel targets (Main's travel handlers): where = home | outside | elite | city | estate | camp
-- -> CFrame or nil, error text
function CityMap.TravelCFrame(player, profile, where, kind)
	if where == "home" then
		return CityHomes.Enter(player, profile, kind)
	elseif where == "outside" then
		local cf = CityMap.HomeExit(profile, kind or CityHomes.Current(player))
		if not cf then
			return nil, "You don't own a home yet."
		end
		return cf
	elseif where == "elite" then
		local ok, idx = pcall(Catalog.GymTier, profile.gym and profile.gym.levels, profile.owned, profile.tier)
		if not ok or (tonumber(idx) or 1) < 3 then
			return nil, "The Elite Performance Center opens when your gym reaches the Elite tier (Gym tab)."
		end
		local s = K.Sites.EliteCenter
		return s and s * CF(0, 3.2, 0) or nil, s and "elite" or "Not built"
	elseif where == "city" then
		-- the corner of Champion Ave and Main Street, facing the shops
		return CF(-17, SW_H + 3.2, MAIN.z0 - 5) * ANG(0, RAD(180), 0)
	elseif where == "estate" then
		local s = K.Sites.EstateGate
		return s and s * CF(0, 3.2, 0) or nil
	elseif where == "camp" then
		local owned = type(profile.owned) == "table" and profile.owned or {}
		if not profile.camp then
			return nil, "You can only go to camp during a fight camp."
		end
		if not (owned.MountainCamp or owned.EliteCamp) then
			return nil, "Buy the Mountain or Elite Training Camp in the Shop first."
		end
		local s = K.Sites.Camp
		return s and s * CF(0, 3.2, 0) or nil
	end
	return nil, "Unknown place"
end

------------------------------------------------------------------------
-- Entry point
------------------------------------------------------------------------
function CityMap.Build(gym)
	local root = Instance.new("Folder")
	root.Name = "City"
	root.Parent = gym
	K.Init(folder(root, "Sites"))
	CityHomes.Init(folder(root, "Homes"))
	-- the layout the client reads (CityDetail / CityVisuals also read Config.City)
	root:SetAttribute("Scale", "v10")
	local sections = {
		{ "campus", buildCampus }, { "downtown", buildDowntown }, { "west", buildWest }, { "east", buildEast },
		{ "arena", buildArena }, { "estates", buildEstates }, { "elite", buildEliteCenter }, { "industrial", buildIndustrial },
		{ "billboards", buildBillboards }, { "camp", buildCamp }, { "skyline", buildSkyline },
	}
	for _, s in ipairs(sections) do
		local ok, err = pcall(s[2], root)
		if not ok then
			warn("[CityMap] " .. s[1] .. " failed: " .. tostring(err))
		end
	end
	return root
end

return CityMap
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="94">
        <Properties>
          <string name="Name">CityShops</string>
          <string name="Source"><![CDATA[-- CityShops: the Main Street shop fronts and their walk-in interiors (barbershop, diner, supplements,
-- pro shop, museum, car dealer), the apartments, the gas station - built in a ROW FRAME: x along the
-- street, y up, z back into the block from the front face (z 0 = the shop fronts, the sidewalk is at
-- z < 0). CityShops.BuildRow places a row with any CFrame, so the same builders make the south row
-- (facing north, towards the gym) and the north row (facing south). Scale: ground floor 14 studs
-- (3.9 m), storeys 11.4, doors 2.1 m, counters 0.9 m (Config.City).
-- Prompts: attribute Action on the ProximityPrompt (client CityVisuals / ClientMain dispatch);
-- sites: Window_<shop> (sponsor standees), ApartmentRoof / ApartmentBanner / HomeApartment /
-- ApartmentKerb, MuseumExhibit / MuseumBanner, Window_FUELGO.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GymDecor = require(script.Parent:WaitForChild("GymDecor"))
local K = require(script.Parent:WaitForChild("CityKit"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Catalog = require(Shared:WaitForChild("Catalog"))
local CityProps = require(Shared:WaitForChild("CityProps"))
local Signage = require(Shared:WaitForChild("Signage"))

local CityShops = {}

local V3 = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local RAD = math.rad
local M = Enum.Material
local C = K.C
local CITY = K.CITY
local SW_H = K.SW_H
local G, S = CITY.GroundFloor, CITY.Storey
local label, frame, gui = K.label, K.frame, K.gui
local tag = K.tag

------------------------------------------------------------------------
-- the row frame
------------------------------------------------------------------------
local ROW = CF()
local ROW_YAW = 0
local function part(parent, name, size, cf, color, material, opts)
	return K.part(parent, name, size, ROW * cf, color, material, opts)
end
local function cyl(parent, name, len, dia, cf, color, material, opts)
	return K.cyl(parent, name, len, dia, ROW * cf, color, material, opts)
end
local function vcyl(parent, name, h, dia, base, color, material, opts)
	return K.vcyl(parent, name, h, dia, ROW * base, color, material, opts)
end
local function ball(parent, name, d, cf, color, material, opts)
	return K.ball(parent, name, d, ROW * cf, color, material, opts)
end
local function blob(parent, name, size, cf, color, material, opts)
	return K.blob(parent, name, size, ROW * cf, color, material, opts)
end
local function site(name, cf, attrs)
	return K.site(name, ROW * cf, attrs)
end
local function promptPart(parent, name, pos, actionText, objectText, attrs, labelColor)
	return K.promptPart(parent, name, (ROW * CF(pos)).Position, actionText, objectText, attrs, labelColor)
end
local function lightZone(parent, name, size, cf, profile)
	return K.lightZone(parent, name, size, ROW * cf, profile)
end
local function roomLight(parent, cf, color, range, brightness)
	return K.roomLight(parent, ROW * cf, color, range, brightness)
end
local function nightPoint(parent, cf, color, range, brightness)
	return K.nightPoint(parent, ROW * cf, color, range, brightness)
end
local function neonOutline(parent, cf, w, h, color)
	return K.neonOutline(parent, ROW * cf, w, h, color)
end
local function spotAt(parent, cf, face, color, range, brightness, angle)
	return K.spot(K.emitter(parent, ROW * cf), face, color, range, brightness, angle)
end
local function pointAt(parent, cf, color, range, brightness)
	return K.point(K.emitter(parent, ROW * cf), color, range, brightness)
end
local function bench(parent, pos, yaw, len, color)
	return K.bench(parent, (ROW * CF(pos)).Position, (yaw or 0) + ROW_YAW, len, color)
end
local function plant(parent, pos, scale)
	return GymDecor.Plant(parent, (ROW * CF(pos)).Position, scale)
end

------------------------------------------------------------------------
-- the shops (x0 / x1 along the row; h the parapet height; floors the storeys above the ground floor)
-- action = ProximityPrompt Action at the counter; interior = walk-in shop built by shopInterior;
-- zone = LightZone profile inside; doorAt = door position along the front (fraction of the width)
------------------------------------------------------------------------
local H1, H2, H3, H4 = G + S + 1.2, G + 2 * S + 1.2, G + 3 * S + 1.2, G + 4 * S + 1.2
CityShops.SHOPS = {
	{ x0 = -552, x1 = -500, h = H1, floors = 1, color = Color3.fromRGB(60, 44, 60), mat = M.Brick, sign = "VINYL CITY RECORDS", signBg = Color3.fromRGB(20, 12, 24), signFg = Color3.fromRGB(255, 120, 60), awning = Color3.fromRGB(90, 30, 60), neon = true },
	{ x0 = -492, x1 = -456, h = H1, floors = 1, color = Color3.fromRGB(40, 40, 46), mat = M.Brick, sign = "FRESH FADES BARBERSHOP", signBg = Color3.fromRGB(14, 30, 70), signFg = Color3.fromRGB(240, 240, 245), awning = Color3.fromRGB(180, 30, 36), neon = true,
		interior = "barber", action = "Barber", actionText = "Get a cut", zone = "Barbershop", doorAt = -0.2 },
	{ x0 = -450, x1 = -393, h = 16, floors = 0, color = Color3.fromRGB(236, 234, 228), sign = "CHAMP'S DINER", signBg = Color3.fromRGB(190, 20, 30), signFg = Color3.new(1, 1, 1), awning = Color3.fromRGB(200, 30, 36), neon = true,
		interior = "diner", action = "Diner", actionText = "Order food", zone = "Store" },
	{ x0 = -384, x1 = -333, h = H1, floors = 1, color = Color3.fromRGB(70, 72, 78), sign = "IRON SUPPLEMENTS", signBg = Color3.fromRGB(16, 18, 20), signFg = Color3.fromRGB(80, 220, 110), awning = Color3.fromRGB(30, 110, 60),
		interior = "supplements", action = "Supplements", actionText = "Buy supplements", zone = "Store" },
	{ x0 = -324, x1 = -264, h = H2, floors = 2, color = Color3.fromRGB(32, 32, 36), sign = "WCB PRO SHOP - GLOVES & GEAR", shop = "WCB PRO SHOP", signBg = Color3.fromRGB(14, 14, 16), signFg = C.gold, awning = Color3.fromRGB(20, 20, 24),
		interior = "proshop", action = "ProShop", actionText = "Browse gear", zone = "Store" },
	{ x0 = -255, x1 = -189, h = H3, floors = 3, color = Color3.fromRGB(134, 72, 56), mat = M.Brick, sign = "CORNER CAFE", signBg = Color3.fromRGB(60, 40, 30), signFg = Color3.fromRGB(255, 230, 190), awning = Color3.fromRGB(90, 60, 40), fireEscape = true },
	{ x0 = -180, x1 = -135, h = H1, floors = 1, color = Color3.fromRGB(200, 222, 240), sign = "SPIN CITY LAUNDROMAT", signBg = Color3.fromRGB(40, 110, 200), signFg = Color3.new(1, 1, 1), awning = Color3.fromRGB(40, 110, 200) },
	{ x0 = -126, x1 = -84, h = H1, floors = 1, color = Color3.fromRGB(40, 32, 52), sign = "INK & IRON TATTOO", signBg = Color3.fromRGB(20, 14, 26), signFg = Color3.fromRGB(220, 90, 255), awning = Color3.fromRGB(70, 30, 90), neon = true },
	{ x0 = -75, x1 = -27, h = H1, floors = 1, color = Color3.fromRGB(244, 222, 180), sign = "SUNRISE BAKERY", signBg = Color3.fromRGB(250, 240, 220), signFg = Color3.fromRGB(170, 90, 40), awning = Color3.fromRGB(240, 170, 60) },
	{ x0 = -18, x1 = 18, h = H2, floors = 2, color = Color3.fromRGB(26, 26, 30), sign = "WCB ARENA TICKETS", signBg = Color3.fromRGB(150, 16, 24), signFg = Color3.fromRGB(255, 220, 90), awning = Color3.fromRGB(150, 16, 24), marquee = true,
		action = "CareerHub", actionText = "Fight offers" },
	{ x0 = 27, x1 = 84, h = H1, floors = 1, color = Color3.fromRGB(220, 220, 214), sign = "CORNER STORE 24/7", signBg = Color3.fromRGB(30, 120, 60), signFg = Color3.new(1, 1, 1), awning = Color3.fromRGB(30, 120, 60) },
	{ x0 = 93, x1 = 144, h = H1, floors = 1, color = Color3.fromRGB(176, 60, 44), mat = M.Brick, sign = "TONY'S PIZZA", signBg = Color3.fromRGB(20, 110, 50), signFg = Color3.new(1, 1, 1), awning = Color3.fromRGB(200, 40, 40), neon = true,
		action = "Diner", actionText = "Grab a slice" },
	{ x0 = 153, x1 = 225, h = H4, floors = 4, color = Color3.fromRGB(150, 150, 156), mat = M.Concrete, sign = "RIVERSIDE APARTMENTS", signBg = Color3.fromRGB(30, 34, 40), signFg = Color3.new(1, 1, 1), awning = Color3.fromRGB(30, 34, 40), apartments = true },
	{ x0 = 234, x1 = 294, h = 30, floors = 0, color = Color3.fromRGB(220, 210, 190), mat = M.Limestone, sign = "BOXING HALL OF FAME MUSEUM", signBg = Color3.fromRGB(20, 20, 24), signFg = C.gold, awning = Color3.fromRGB(20, 20, 24), columns = true,
		interior = "museum", action = "Museum", actionText = "Your legacy", zone = "Store", doorAt = 0, roomDepth = 30, roomH = 16 },
	{ x0 = 303, x1 = 372, h = H2, floors = 2, color = Color3.fromRGB(206, 198, 180), mat = M.Limestone, sign = "FIRST CITY BANK", signBg = Color3.fromRGB(20, 40, 80), signFg = Color3.fromRGB(240, 230, 200), awning = Color3.fromRGB(20, 40, 80) },
	{ x0 = 384, x1 = 450, h = H1, floors = 1, color = Color3.fromRGB(220, 200, 150), sign = "STARLIGHT MOTEL", signBg = Color3.fromRGB(16, 20, 40), signFg = Color3.fromRGB(255, 120, 180), awning = Color3.fromRGB(40, 60, 120), neon = true, poleSign = "MOTEL" },
	{ x0 = 456, x1 = 510, h = H1, floors = 1, color = Color3.fromRGB(26, 28, 34), mat = M.Metal, sign = "PRESTIGE MOTORS", signBg = Color3.fromRGB(12, 12, 16), signFg = Color3.fromRGB(220, 220, 230), awning = Color3.fromRGB(12, 12, 16),
		interior = "motors", action = "Motors", actionText = "Browse cars", zone = "Store", doorAt = 0.25, roomH = 16, roomDepth = 30 },
}
-- the gas station's apron (row-local x) and the dealer-to-river stretch
CityShops.GAS = { x0 = 526, x1 = 646 }

local DEPTH = 44 -- a block's depth from the front face

------------------------------------------------------------------------
-- Walk-in shop interiors. The front room of the block is hollow (floor, side walls, a ceiling made
-- by the upper storeys, the solid back block as the back wall); the street front has glass panes
-- either side of an open door. ctx: x0/x1 inner side walls, z0 just inside the glass, z1 back
-- wall, y floor top, h room height, cx centre, doorX. Each builder returns the counter position
-- for the shop's prompt. Budgets: about 30-60 parts per shop.
------------------------------------------------------------------------
local INTERIOR = {}

-- a strip of products drawn on one part (a shelf of tubs, boxes or bottles in one SurfaceGui)
local function productRow(parent, cf, w, h, colors, labels, face)
	local p = part(parent, "ProductRow", V3(w, h, 0.8), cf, Color3.fromRGB(40, 40, 44), M.SmoothPlastic)
	local sg = gui(p, face or Enum.NormalId.Front, 30, 0.6, 120)
	frame(sg, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(34, 34, 38) })
	local n = math.max(1, math.floor(w / 1.3))
	for k = 0, n - 1 do
		local col = colors[k % #colors + 1]
		local box = frame(sg, { Size = UDim2.fromScale(0.8 / n, 0.86), Position = UDim2.fromScale((k + 0.1) / n, 0.1), BackgroundColor3 = col })
		Instance.new("UICorner", box).CornerRadius = UDim.new(0.15, 0)
		local txt = labels and labels[k % #labels + 1]
		if txt then
			label(box, txt, { TextColor3 = Color3.new(1, 1, 1), Size = UDim2.fromScale(0.9, 0.3), Position = UDim2.fromScale(0.05, 0.35), Face = "signSub" })
		end
	end
	return p
end

-- chequered floor drawn on the floor's top face (cheap: one SurfaceGui)
local function checkerFloor(floorPart, a, b, cols, rows)
	local sg = gui(floorPart, Enum.NormalId.Top, 6, 1, 160)
	frame(sg, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = a })
	for r = 0, rows - 1 do
		for c = 0, cols - 1 do
			if (r + c) % 2 == 0 then
				frame(sg, { Size = UDim2.fromScale(1 / cols, 1 / rows), Position = UDim2.fromScale(c / cols, r / rows), BackgroundColor3 = b })
			end
		end
	end
end

local function counter(f, cf, len, topColor, bodyColor)
	part(f, "Counter", V3(len, 3.2, 2), cf * CF(0, 1.6, 0), bodyColor, M.WoodPlanks, { collide = true })
	part(f, "CounterTop", V3(len + 0.3, 0.2, 2.3), cf * CF(0, 3.3, 0), topColor, M.Marble)
	part(f, "Register", V3(1.2, 0.9, 1), cf * CF(len / 2 - 1, 3.85, 0.1) * ANG(RAD(-15), 0, 0), Color3.fromRGB(30, 30, 34), M.SmoothPlastic)
end

INTERIOR.supplements = function(f, d, c)
	local y = c.y
	local zBack = c.z1
	part(f, "ShelfBack", V3(c.x1 - c.x0 - 4, c.h - 1.5, 0.3), CF(c.cx, y + (c.h - 1.5) / 2, zBack - 0.2), Color3.fromRGB(26, 26, 28), M.SmoothPlastic)
	local tubColors = { Color3.fromRGB(30, 30, 30), Color3.fromRGB(240, 110, 20), Color3.fromRGB(30, 150, 70), Color3.fromRGB(200, 30, 40), Color3.fromRGB(230, 230, 230), Color3.fromRGB(40, 90, 200) }
	local names = { "WHEY", "BCAA", "CREATINE", "PRE", "MASS", "ISO", "OMEGA", "CASEIN" }
	for k, sy in ipairs({ 1.4, 3.6, 5.8, 8.0 }) do
		part(f, "Shelf", V3(c.x1 - c.x0 - 4, 0.2, 1.6), CF(c.cx, y + sy - 0.15, zBack - 1.1), Color3.fromRGB(190, 190, 196), M.Metal)
		productRow(f, CF(c.cx, y + sy + 0.75, zBack - 1.1), c.x1 - c.x0 - 4.4, 1.5, tubColors, k == 2 and names or nil)
	end
	local fx = c.x0 + 1.4
	part(f, "Fridge", V3(2.6, 7, 4), CF(fx, y + 3.5, zBack - 4), Color3.fromRGB(220, 222, 226), M.Metal, { collide = true })
	local fg = part(f, "FridgeGlass", V3(0.1, 6, 3.4), CF(fx + 1.35, y + 3.6, zBack - 4), Color3.fromRGB(200, 230, 255), M.Glass, { transparency = 0.3 })
	local fsg = gui(fg, Enum.NormalId.Right, 20, 0.5, 80)
	for r = 0, 3 do
		for k = 0, 5 do
			local col = ({ Color3.fromRGB(60, 200, 255), Color3.fromRGB(255, 220, 40), Color3.fromRGB(240, 80, 60), Color3.fromRGB(120, 240, 120) })[(r + k) % 4 + 1]
			frame(fsg, { Size = UDim2.fromScale(0.1, 0.17), Position = UDim2.fromScale(0.06 + k * 0.155, 0.05 + r * 0.24), BackgroundColor3 = col })
		end
	end
	local fl = Instance.new("PointLight")
	fl.Color, fl.Range, fl.Brightness, fl.Shadows = Color3.fromRGB(200, 230, 255), 6, 0.8, false
	fl.Parent = fg
	local poster = part(f, "BrandPoster", V3(0.15, 5, 7), CF(c.x0 + 0.1, y + 5.2, c.z0 + 6), Color3.fromRGB(20, 20, 22), M.SmoothPlastic)
	GymDecor.Sign(poster, Enum.NormalId.Right, "BUILT IN THE GYM.\nFUELED BY IRON.", Color3.fromRGB(240, 110, 20), Color3.fromRGB(20, 20, 22), 30)
	local ccf = CF(c.x1 - 5, y, c.z0 + 8) * ANG(0, RAD(90), 0)
	counter(f, ccf, 8, Color3.fromRGB(30, 30, 32), Color3.fromRGB(46, 120, 70))
	vcyl(f, "Blender", 1.4, 0.7, ccf * CF(-1.5, 3.4, 0), Color3.fromRGB(220, 230, 240), M.Glass, { transparency = 0.2 })
	for k, off in ipairs({ { -1.2, 0 }, { 0, 0 }, { 1.2, 0 }, { -0.6, 1.2 }, { 0.6, 1.2 }, { 0, 2.4 } }) do
		vcyl(f, "TubDisplay", 1.2, 0.95, CF(c.cx - 4 + off[1], y + off[2], c.z0 + 2.5), tubColors[k % #tubColors + 1], M.SmoothPlastic)
	end
	part(f, "Scale", V3(1.8, 0.3, 1.8), CF(c.x0 + 3, y + 0.15, c.z0 + 12), Color3.fromRGB(40, 40, 44), M.Metal)
	part(f, "ScaleMirror", V3(0.15, 6, 3), CF(c.x0 + 0.1, y + 3.6, c.z0 + 13.5), Color3.fromRGB(220, 235, 245), M.Glass, { reflect = 0.4 })
	-- a second island of boxes in the middle of the deeper room
	part(f, "Island", V3(6, 2.6, 2.4), CF(c.cx + 2, y + 1.3, c.z0 + 14), Color3.fromRGB(26, 26, 28), M.SmoothPlastic, { collide = true })
	productRow(f, CF(c.cx + 2, y + 3.3, c.z0 + 14), 5.6, 1.3, tubColors, { "BARS", "SHAKES" })
	return (ccf * CF(0, 0, -2.4)).Position + V3(0, 0.5, 0)
end

INTERIOR.proshop = function(f, d, c)
	local y = c.y
	local zBack = c.z1
	local peg = part(f, "Pegboard", V3(c.x1 - c.x0 - 6, 6, 0.2), CF(c.cx, y + 4.2, zBack - 0.15), Color3.fromRGB(196, 170, 130), M.Wood)
	local psg = gui(peg, Enum.NormalId.Front, 10, 1, 80)
	for r = 0, 3 do
		for k = 0, 7 do
			frame(psg, { Size = UDim2.fromScale(0.014, 0.035), Position = UDim2.fromScale(0.04 + k * 0.125 + (r % 2) * 0.06, 0.1 + r * 0.24), BackgroundColor3 = Color3.fromRGB(90, 70, 50) })
		end
	end
	local brands = {}
	for _, id in ipairs(Catalog.BrandOrder) do
		table.insert(brands, Catalog.Brand(id))
	end
	local span = c.x1 - c.x0 - 9
	for i, b in ipairs(brands) do
		local col = CityProps.RGB(b.palette and b.palette.primary, C.red)
		local row = (i - 1) % 2
		local gx = c.x0 + 4.5 + ((i - 1) / math.max(1, #brands - 1)) * span
		local gcf = CF(gx, y + 3.2 + row * 2.4, zBack - 0.8)
		blob(f, "DisplayGlove", V3(1.0, 1.25, 1.1), gcf * CF(-0.55, 0, 0) * ANG(0, 0, RAD(8)), col, M.Leather)
		blob(f, "DisplayGlove", V3(1.0, 1.25, 1.1), gcf * CF(0.55, 0, 0) * ANG(0, 0, RAD(-8)), col, M.Leather)
		local word = b.wordmark ~= "" and b.wordmark or "GYM ISSUE"
		local ban = part(f, "BrandBanner", V3(3.2, 1.6, 0.08), CF(gx, y + c.h - 1.6, c.z0 + 4 + (i % 2) * 6), col, M.Fabric, { shadow = false })
		local fontOk, font = pcall(function()
			return Enum.Font[b.font]
		end)
		GymDecor.Sign(ban, Enum.NormalId.Front, word, CityProps.RGB(b.wordColor), col, 30, 0.4, fontOk and font or "sign")
		GymDecor.Sign(ban, Enum.NormalId.Back, word, CityProps.RGB(b.wordColor), col, 30, 0.4, fontOk and font or "sign")
	end
	productRow(f, CF(c.x0 + 0.5, y + 2.2, c.z0 + 10) * ANG(0, RAD(90), 0), 10, 1.2, { Color3.fromRGB(20, 20, 24), Color3.fromRGB(240, 240, 240), Color3.fromRGB(200, 30, 36), Color3.fromRGB(230, 180, 40) }, { "BOOT", "PRO", "ELITE" }, Enum.NormalId.Back)
	productRow(f, CF(c.x0 + 0.5, y + 4.2, c.z0 + 10) * ANG(0, RAD(90), 0), 10, 1.2, { Color3.fromRGB(30, 60, 190), Color3.fromRGB(120, 20, 30), Color3.fromRGB(245, 240, 230) }, { "WRAPS", "GEL" }, Enum.NormalId.Back)
	local mq = CF(c.x0 + 5, y, c.z0 + 3.5)
	vcyl(f, "MannequinStand", 0.2, 2, mq, Color3.fromRGB(30, 30, 30), M.Metal)
	blob(f, "Robe", V3(2.6, 4.6, 1.6), mq * CF(0, 3.4, 0), Color3.fromRGB(200, 30, 36), M.Fabric)
	blob(f, "RobeTrim", V3(2.7, 0.5, 1.7), mq * CF(0, 1.3, 0), C.gold, M.Fabric)
	ball(f, "MannequinHead", 1.0, mq * CF(0, 6.2, 0), Color3.fromRGB(230, 230, 232), M.SmoothPlastic)
	local bagCF = CF(c.cx - 2, y, c.z0 + 11)
	part(f, "BagChain", V3(0.15, c.h - 6.6, 0.15), bagCF * CF(0, 6.6 + (c.h - 6.6) / 2, 0), C.steelLight, M.Metal)
	vcyl(f, "TestBag", 4.4, 2.0, bagCF * CF(0, 2.2, 0), Color3.fromRGB(150, 24, 30), M.Leather, { collide = true })
	local case = CF(c.cx + 5, y, c.z0 + 4)
	part(f, "CaseBase", V3(4, 3, 2.4), case * CF(0, 1.5, 0), Color3.fromRGB(30, 30, 34), M.Wood, { collide = true })
	part(f, "CaseGlass", V3(4, 1.8, 2.4), case * CF(0, 3.9, 0), Color3.fromRGB(210, 230, 245), M.Glass, { transparency = 0.6 })
	part(f, "ReplicaStrap", V3(3.2, 0.5, 0.9), case * CF(0, 3.3, 0), Color3.fromRGB(20, 20, 22), M.Leather)
	cyl(f, "ReplicaPlate", 0.2, 1.1, case * CF(0, 3.45, 0) * ANG(0, 0, RAD(90)), C.gold, M.Metal, { reflect = 0.25 })
	local ccf = CF(c.x1 - 4.5, y, c.z0 + 9) * ANG(0, RAD(90), 0)
	counter(f, ccf, 8, Color3.fromRGB(20, 20, 22), Color3.fromRGB(32, 32, 36))
	return (ccf * CF(0, 0, -2.4)).Position + V3(0, 0.5, 0)
end

INTERIOR.diner = function(f, d, c)
	local y = c.y
	local ccf = CF(c.cx - 2, y, c.z1 - 4.5)
	part(f, "DinerCounter", V3(22, 3.4, 2.2), ccf * CF(0, 1.7, 0), Color3.fromRGB(200, 30, 36), M.SmoothPlastic, { collide = true })
	part(f, "DinerCounterTop", V3(22.4, 0.25, 2.6), ccf * CF(0, 3.5, 0), Color3.fromRGB(230, 230, 232), M.Marble)
	part(f, "DinerTrim", V3(22.4, 0.25, 0.1), ccf * CF(0, 2.6, -1.15), Color3.fromRGB(220, 220, 225), M.Metal, { reflect = 0.3 })
	for k = 0, 6 do
		local sx = -9 + k * 3
		vcyl(f, "StoolPost", 2.2, 0.3, ccf * CF(sx, 0, -2.6), C.steelLight, M.Metal)
		vcyl(f, "StoolSeat", 0.45, 1.5, ccf * CF(sx, 2.2, -2.6), Color3.fromRGB(200, 30, 36), M.Leather, { collide = true })
	end
	part(f, "PieCase", V3(3, 1.6, 1.6), ccf * CF(8.5, 4.4, 0), Color3.fromRGB(220, 235, 245), M.Glass, { transparency = 0.4 })
	part(f, "CoffeeMachine", V3(1.8, 2.2, 1.4), ccf * CF(-8.5, 4.7, 0.2), Color3.fromRGB(40, 40, 44), M.Metal)
	local menu = part(f, "MenuBoard", V3(16, 4, 0.2), CF(c.cx - 2, y + c.h - 2.8, c.z1 - 0.15), Color3.fromRGB(20, 20, 22), M.SmoothPlastic)
	local msg = gui(menu, Enum.NormalId.Front, 20, 0.2, 120)
	frame(msg, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(22, 22, 24) })
	label(msg, "CHAMP'S MENU", { TextColor3 = C.gold, Size = UDim2.fromScale(0.9, 0.22), Position = UDim2.fromScale(0.05, 0.03) })
	local lines = {}
	for _, meal in ipairs(Config.Meals) do
		if meal.price > 0 and not meal.requires then
			table.insert(lines, string.format("%s  %s", meal.name:upper(), Config.Money(meal.price)))
		end
	end
	label(msg, table.concat(lines, "\n"), { TextColor3 = Color3.fromRGB(240, 240, 235), Face = "signSub", Size = UDim2.fromScale(0.9, 0.7), Position = UDim2.fromScale(0.05, 0.27) })
	for k = 0, 3 do
		local bz = c.z0 + 2.4 + k * 4.4
		local bx = c.x1 - 3.4
		part(f, "BoothTable", V3(3.4, 0.25, 1.8), CF(bx, y + 2.6, bz), Color3.fromRGB(230, 230, 232), M.Marble)
		part(f, "BoothLeg", V3(0.3, 2.5, 0.3), CF(bx, y + 1.25, bz), C.steelLight, M.Metal)
		for _, s in ipairs({ -1, 1 }) do
			part(f, "BoothSeat", V3(3.4, 1.6, 1.0), CF(bx, y + 0.8, bz + s * 1.45), Color3.fromRGB(200, 30, 36), M.Leather, { collide = true })
			part(f, "BoothBack", V3(3.4, 2.4, 0.4), CF(bx, y + 2.4, bz + s * 1.85), Color3.fromRGB(170, 24, 30), M.Leather)
		end
	end
	local jb = CF(c.x0 + 1.5, y, c.z1 - 1.5)
	part(f, "Jukebox", V3(2.4, 4.2, 1.6), jb * CF(0, 2.1, 0), Color3.fromRGB(120, 60, 30), M.Wood, { collide = true })
	local arch = part(f, "JukeboxGlow", V3(2.0, 1.4, 0.1), jb * CF(0, 3.4, -0.82), Color3.fromRGB(255, 160, 60), M.Neon, { shadow = false })
	local jl = Instance.new("PointLight")
	jl.Color, jl.Range, jl.Brightness, jl.Shadows = Color3.fromRGB(255, 140, 60), 8, 1, false
	jl.Parent = arch
	for k = 1, 3 do
		local ph = part(f, "DinerPhoto", V3(0.12, 3.2, 2.4), CF(c.x0 + 0.1, y + 5, c.z0 + 2 + k * 3.6), C.black, M.SmoothPlastic)
		GymDecor.PosterGui(ph, Enum.NormalId.Right, GymDecor.Posters[(k % #GymDecor.Posters) + 1])
	end
	return (ccf * CF(5, 0, -2.8)).Position + V3(0, 0.5, 0)
end

INTERIOR.barber = function(f, d, c)
	local y = c.y
	for k = 0, 1 do
		local sx = c.cx - 4 + k * 8
		part(f, "StationMirror", V3(4, 4.5, 0.15), CF(sx, y + 5, c.z1 - 0.2), Color3.fromRGB(215, 232, 245), M.Glass, { reflect = 0.45 })
		part(f, "StationShelf", V3(4.4, 0.3, 1.2), CF(sx, y + 2.6, c.z1 - 0.7), Color3.fromRGB(30, 30, 34), M.Marble)
		blob(f, "Clippers", V3(0.4, 0.3, 0.9), CF(sx - 1, y + 2.9, c.z1 - 0.7), C.black, M.SmoothPlastic)
		vcyl(f, "Tonic", 0.9, 0.35, CF(sx + 1.2, y + 2.75, c.z1 - 0.7), Color3.fromRGB(60, 160, 200), M.Glass, { transparency = 0.2 })
		local ch = CF(sx, y, c.z1 - 4.5)
		vcyl(f, "ChairBase", 0.4, 2.2, ch, Color3.fromRGB(200, 200, 205), M.Metal)
		vcyl(f, "ChairPost", 1.4, 0.6, ch * CF(0, 0.4, 0), Color3.fromRGB(200, 200, 205), M.Metal)
		part(f, "ChairSeat", V3(2.2, 0.6, 2.2), ch * CF(0, 2.1, 0), Color3.fromRGB(150, 20, 26), M.Leather, { collide = true })
		part(f, "ChairBack", V3(2.2, 2.8, 0.5), ch * CF(0, 3.6, 1.0) * ANG(RAD(-10), 0, 0), Color3.fromRGB(150, 20, 26), M.Leather)
		for _, s in ipairs({ -1, 1 }) do
			part(f, "ChairArm", V3(0.3, 0.3, 1.8), ch * CF(s * 1.15, 3.0, 0.1), Color3.fromRGB(200, 200, 205), M.Metal)
		end
		part(f, "FootRest", V3(1.6, 0.2, 0.8), ch * CF(0, 0.9, -1.6), Color3.fromRGB(200, 200, 205), M.Metal)
	end
	bench(f, V3(c.x0 + 1.5, y, c.z0 + 7), RAD(90), 6.4, C.woodDark)
	productRow(f, CF(c.x0 + 0.5, y + 4.6, c.z0 + 7) * ANG(0, RAD(90), 0), 6, 1.1, { Color3.fromRGB(30, 30, 34), Color3.fromRGB(200, 170, 80), Color3.fromRGB(40, 110, 160) }, { "POMADE", "BEARD OIL" }, Enum.NormalId.Back)
	local styles = part(f, "StyleChart", V3(0.12, 4, 3), CF(c.x1 - 0.1, y + 5, c.z0 + 4), C.white, M.SmoothPlastic)
	GymDecor.Sign(styles, Enum.NormalId.Left, "FADES\nTAPERS\nCORNROWS\nLOCS\nLINE-UPS", C.black, C.white, 30)
	-- the classic spinning pole beside the door (Ambience spins every SpinFan model)
	local pm = K.model(f, "BarberPole")
	local px, pz = c.doorX - 3.6, -0.7
	local hub = cyl(pm, "Hub", 4.4, 0.9, CF(px, 6.2, pz) * ANG(0, 0, RAD(90)), C.white, M.SmoothPlastic)
	for i = 0, 2 do
		part(pm, "Blade", V3(0.25, 0.95, 0.95), CF(px, 4.7 + i * 1.5, pz) * ANG(0, 0, RAD(60)), i % 2 == 0 and C.red or C.blue, M.SmoothPlastic)
	end
	part(pm, "PoleCap", V3(1.2, 0.4, 1.2), CF(px, 8.6, pz), Color3.fromRGB(210, 210, 215), M.Metal)
	part(pm, "PoleCap", V3(1.2, 0.4, 1.2), CF(px, 3.8, pz), Color3.fromRGB(210, 210, 215), M.Metal)
	pm.PrimaryPart = hub
	pm:SetAttribute("Speed", 2.2)
	tag(pm, "SpinFan")
	return V3(c.cx, y + 3.2, c.z1 - 8)
end

INTERIOR.museum = function(f, d, c)
	local y = c.y
	local hof = part(f, "HallSign", V3(18, 3.4, 0.2), CF(c.cx, y + c.h - 2.8, c.z1 - 0.15), Color3.fromRGB(20, 20, 24), M.SmoothPlastic)
	GymDecor.Sign(hof, Enum.NormalId.Front, "HALL OF FAME", C.gold, Color3.fromRGB(20, 20, 24), 30, 0, "serif")
	for k, era in ipairs({ "THE BARE-KNUCKLE ERA", "THE GOLDEN AGE", "THE TELEVISION ERA", "THE MODERN GREATS" }) do
		local bx = c.cx + ({ -22, -15, 15, 22 })[k]
		local ban = part(f, "EraBanner", V3(4.6, 8, 0.1), CF(bx, y + c.h - 6, c.z1 - 0.3), Color3.fromRGB(110, 20, 26), M.Fabric)
		GymDecor.Sign(ban, Enum.NormalId.Front, era, C.gold, Color3.fromRGB(110, 20, 26), 30)
	end
	local bronze = Color3.fromRGB(150, 104, 54)
	for i = 1, math.min(8, #Config.Legends) do
		local lg = Config.Legends[i]
		local side = i % 2 == 1 and -1 or 1
		local row = math.floor((i - 1) / 2)
		local bx = side < 0 and c.x0 + 2.5 or c.x1 - 2.5
		local bz = c.z0 + 5 + row * 6
		local base = CF(bx, y, bz)
		part(f, "BustPlinth", V3(2.2, 3.6, 2.2), base * CF(0, 1.8, 0), Color3.fromRGB(230, 226, 216), M.Marble, { collide = true })
		blob(f, "BustShoulders", V3(2.0, 1.0, 1.1), base * CF(0, 4.0, 0), bronze, M.Metal, { reflect = 0.12 })
		blob(f, "BustHead", V3(0.95, 1.15, 1.05), base * CF(0, 4.9, 0), bronze, M.Metal, { reflect = 0.12 })
		local pl = part(f, "BustPlaque", V3(0.1, 1.2, 2.0), base * CF(-side * 1.15, 2.6, 0), C.gold, M.Metal)
		GymDecor.Sign(pl, side < 0 and Enum.NormalId.Right or Enum.NormalId.Left, string.format("%s\nLEGACY %d", lg.name, lg.score), Color3.fromRGB(40, 28, 10), C.gold, 40)
	end
	local cc = CF(c.cx, y, c.z0 + 10)
	part(f, "CaseBase", V3(5, 3, 3), cc * CF(0, 1.5, 0), Color3.fromRGB(30, 26, 22), M.Wood, { collide = true })
	part(f, "CaseGlass", V3(5, 2.2, 3), cc * CF(0, 4.1, 0), Color3.fromRGB(210, 230, 245), M.Glass, { transparency = 0.65 })
	blob(f, "VintageGlove", V3(1.0, 1.2, 1.1), cc * CF(-1.2, 3.6, 0), Color3.fromRGB(110, 60, 30), M.Leather)
	blob(f, "VintageGlove", V3(1.0, 1.2, 1.1), cc * CF(-0.1, 3.6, 0.2), Color3.fromRGB(110, 60, 30), M.Leather)
	part(f, "VintageBelt", V3(1.8, 0.4, 0.8), cc * CF(1.4, 3.3, 0), Color3.fromRGB(20, 20, 22), M.Leather)
	cyl(f, "VintagePlate", 0.15, 0.8, cc * CF(1.4, 3.42, 0) * ANG(0, 0, RAD(90)), C.gold, M.Metal, { reflect = 0.25 })
	for k, off in ipairs({ { -3.5, -2.5 }, { 3.5, -2.5 }, { 3.5, 2.5 }, { -3.5, 2.5 } }) do
		vcyl(f, "Stanchion", 3, 0.3, cc * CF(off[1], 0, off[2]), C.goldDeep, M.Metal)
		local nxt = ({ { 3.5, -2.5 }, { 3.5, 2.5 }, { -3.5, 2.5 }, { -3.5, -2.5 } })[k]
		local a = (cc * CF(off[1], 2.6, off[2])).Position
		local b = (cc * CF(nxt[1], 2.6, nxt[2])).Position
		part(f, "VelvetRope", V3(0.18, 0.18, (b - a).Magnitude), CFrame.lookAt((a + b) / 2, b), Color3.fromRGB(140, 16, 30), M.Fabric)
	end
	for _, x in ipairs({ c.x0 + 2.5, c.x1 - 2.5 }) do
		spotAt(f, CF(x, y + c.h - 0.6, c.z0 + 12), Enum.NormalId.Bottom, Color3.fromRGB(255, 230, 190), 22, 1.2, 70)
	end
	site("MuseumExhibit", CFrame.lookAt(V3(c.cx, y, c.z1 - 6), V3(c.cx, y, c.z0)))
	site("MuseumBanner", CFrame.lookAt(V3(c.cx, 21, -4.6), V3(c.cx, 21, -12)))
	return V3(c.cx + 4, y + 3.2, c.z0 + 4)
end

INTERIOR.motors = function(f, d, c)
	local y = c.y
	local stands = { { c.x0 + 9, c.z0 + 10, 60, "Supercar" }, { c.x1 - 9, c.z0 + 18, 125, "SportsCar" } }
	for _, st in ipairs(stands) do
		local tcf = CF(st[1], y, st[2]) * ANG(0, RAD(st[3]), 0)
		vcyl(f, "Turntable", 0.3, 15, tcf, Color3.fromRGB(40, 40, 46), M.Metal, { reflect = 0.2, collide = true })
		local carM = CityProps.SportsCar(f, ROW * tcf * CF(0, 0.3, 0), st[4], nil, "PRESTIGE")
		pcall(function()
			carM:ScaleTo(1.4)
		end)
		spotAt(f, CF(st[1], y + c.h - 0.6, st[2]), Enum.NormalId.Bottom, Color3.fromRGB(240, 245, 255), 20, 1.6, 60)
	end
	local wall = part(f, "BrandWall", V3(c.x1 - c.x0 - 2, 3, 0.2), CF(c.cx, y + c.h - 2.6, c.z1 - 0.15), Color3.fromRGB(14, 14, 18), M.SmoothPlastic)
	GymDecor.Sign(wall, Enum.NormalId.Front, "PRESTIGE MOTORS", Color3.fromRGB(220, 220, 230), Color3.fromRGB(14, 14, 18), 30, 0, "tech")
	local desk = CF(c.x0 + 5, y, c.z1 - 3)
	part(f, "SalesDesk", V3(5, 2.8, 2), desk * CF(0, 1.4, 0), Color3.fromRGB(230, 230, 232), M.Marble, { collide = true })
	part(f, "DeskScreen", V3(1.6, 1.1, 0.1), desk * CF(0.8, 3.4, 0.3), Color3.fromRGB(20, 30, 50), M.Glass)
	return (desk * CF(2, 0, -2.4)).Position + V3(0, 0.5, 0)
end

-- the hollow front room of an interior shop (see INTERIOR above)
local function shopInterior(f, d, w, cx, doorX)
	local RD, RH = d.roomDepth or 22, d.roomH or 11.5
	local floorTop = d.columns and SW_H + 0.6 or SW_H
	local mat = d.mat or M.SmoothPlastic
	for _, s in ipairs({ -1, 1 }) do
		part(f, "ShopSideWall", V3(1, RH, RD - 0.6), CF(cx + s * (w / 2 - 0.5), RH / 2, 0.6 + (RD - 0.6) / 2), d.color, mat, { collide = true })
	end
	local floorMat = ({ diner = M.SmoothPlastic, barber = M.SmoothPlastic, museum = M.Marble, motors = M.Marble, supplements = M.Rubber })[d.interior] or M.WoodPlanks
	local floorCol = ({ museum = Color3.fromRGB(226, 222, 214), motors = Color3.fromRGB(40, 40, 46), supplements = Color3.fromRGB(34, 34, 38) })[d.interior] or Color3.fromRGB(150, 110, 72)
	local fl = part(f, "ShopFloor", V3(w - 2, floorTop, RD), CF(cx, floorTop / 2, RD / 2), floorCol, floorMat, { collide = true })
	if d.interior == "diner" then
		checkerFloor(fl, Color3.fromRGB(24, 24, 26), Color3.fromRGB(236, 236, 230), 14, 6)
	elseif d.interior == "barber" then
		checkerFloor(fl, Color3.fromRGB(30, 30, 34), Color3.fromRGB(230, 230, 226), 9, 6)
	end
	-- facade: piers at both ends, a header above the glass, panes either side of the open door (the
	-- opening clears the tallest boxer the Creator allows, 7.6 studs, with room for a hop)
	local glassTop = math.min(10, RH - 1.2)
	for _, s in ipairs({ -1, 1 }) do
		part(f, "ShopPier", V3(2, RH, 0.6), CF(cx + s * (w / 2 - 1), RH / 2, 0.3), d.color, mat, { collide = true })
	end
	part(f, "ShopHeader", V3(w, RH - glassTop, 0.6), CF(cx, glassTop + (RH - glassTop) / 2, 0.3), d.color, mat, { collide = true })
	local spans = { { cx - w / 2 + 2, doorX - 2.3 }, { doorX + 2.3, cx + w / 2 - 2 } }
	for _, sp in ipairs(spans) do
		local pw = sp[2] - sp[1]
		if pw > 0.6 then
			local pc = (sp[1] + sp[2]) / 2
			local pane = part(f, "ShopWindow", V3(pw, glassTop - 1, 0.12), CF(pc, 1 + (glassTop - 1) / 2, 0.1), Color3.fromRGB(170, 205, 230), M.Glass, { transparency = 0.6, reflect = 0.12, shadow = false, collide = true })
			pane:SetAttribute("Shop", d.sign)
			part(f, "Kickplate", V3(pw, 1.0, 0.3), CF(pc, 0.8, 0.1), Color3.fromRGB(40, 40, 44), M.Metal, { collide = true })
			local n = math.max(1, math.floor(pw / 7))
			for k = 0, n do
				part(f, "Mullion", V3(0.3, glassTop - 1, 0.3), CF(sp[1] + k * pw / n, 1 + (glassTop - 1) / 2, 0.1), Color3.fromRGB(30, 30, 34), M.Metal)
			end
		end
	end
	-- the door stands open inwards (glass leaf hinged at the right jamb)
	part(f, "ShopDoor", V3(0.15, glassTop - 0.3, 4.2), CF(doorX + 2.2, floorTop + (glassTop - 0.3) / 2, 2.4), Color3.fromRGB(180, 210, 230), M.Glass, { transparency = 0.45, shadow = false })
	part(f, "DoorFrame", V3(4.8, 0.3, 0.6), CF(doorX, glassTop + 0.15, 0.3), Color3.fromRGB(30, 30, 34), M.Metal)
	roomLight(f, CF(cx, RH - 0.8, RD * 0.55), Color3.fromRGB(255, 236, 214), math.max(24, w * 0.7), 1.1)
	for _, s in ipairs({ -0.25, 0.25 }) do
		part(f, "CeilingPanel", V3(5, 0.12, 2.4), CF(cx + s * w, RH - 0.06, RD * 0.55), Color3.fromRGB(250, 248, 240), M.Neon, { shadow = false })
	end
	lightZone(f, "ShopZone", V3(w - 2, RH, RD), CF(cx, RH / 2, RD / 2), d.zone or "Store")
	local build = INTERIOR[d.interior]
	local ctx = { x0 = cx - w / 2 + 1, x1 = cx + w / 2 - 1, z0 = 0.6, z1 = RD, y = floorTop, h = RH, cx = cx, doorX = doorX }
	local ok, at = pcall(build, f, d, ctx)
	if not ok then
		warn("[CityShops] interior " .. tostring(d.interior) .. " failed: " .. tostring(at))
		at = nil
	end
	return RD, RH, at
end

-- one shop front (row frame). Returns the body part.
local function shop(f, d, rng)
	local w = d.x1 - d.x0
	local cx = (d.x0 + d.x1) / 2
	local depth = d.depth or DEPTH
	local h = d.h
	local sfW = w - 4
	local doorX = cx + w * (d.doorAt or 0.22)
	local body, gridPart, gridBase
	local counterAt
	if d.interior then
		local RD, RH, at = shopInterior(f, d, w, cx, doorX)
		counterAt = at
		body = part(f, "Building", V3(w, h, depth - RD), CF(cx, h / 2, RD + (depth - RD) / 2), d.color, d.mat or M.SmoothPlastic, { collide = true })
		gridPart = part(f, "BuildingUpper", V3(w, h - RH, RD), CF(cx, RH + (h - RH) / 2, RD / 2), d.color, d.mat or M.SmoothPlastic, { collide = true })
		gridBase = RH
	else
		body = part(f, "Building", V3(w, h, depth), CF(cx, h / 2, depth / 2), d.color, d.mat or M.SmoothPlastic, { collide = true })
		gridPart, gridBase = body, 0
		-- storefront: dark interior, glass, mullions, door and kickplate (the glass 0.8..9.8)
		part(f, "ShopInterior", V3(sfW, 9, 0.12), CF(cx, 5.3, -0.07), Color3.fromRGB(36, 40, 48), M.SmoothPlastic)
		local win = part(f, "ShopWindow", V3(sfW, 9, 0.1), CF(cx, 5.3, -0.2), Color3.fromRGB(170, 205, 230), M.Glass, { transparency = 0.55, reflect = 0.12, shadow = false })
		win:SetAttribute("Shop", d.sign)
		local n = math.max(1, math.floor(sfW / 7))
		for k = 0, n do
			part(f, "Mullion", V3(0.3, 9, 0.3), CF(d.x0 + 2 + k * sfW / n, 5.3, -0.2), Color3.fromRGB(30, 30, 34), M.Metal)
		end
		part(f, "ShopDoor", V3(CITY.Door.w, CITY.Door.h + 0.1, 0.15), CF(doorX, SW_H + (CITY.Door.h + 0.1) / 2, -0.32), Color3.fromRGB(28, 28, 32), M.Metal)
		part(f, "Kickplate", V3(sfW, 1.0, 0.3), CF(cx, 0.8, -0.15), Color3.fromRGB(40, 40, 44), M.Metal)
	end
	part(f, "Cornice", V3(w + 0.8, 1.1, depth + 0.8), CF(cx, h + 0.55, depth / 2), Color3.fromRGB(60, 58, 56), M.Concrete)
	-- where a sponsor's poster goes in this shop's window (CityVisuals, when you carry their brand)
	local wz = d.interior and 1.4 or -1.8
	site("Window_" .. d.sign:gsub("[^%w]", ""), CFrame.lookAt(V3(d.x0 + 5, SW_H, wz), V3(d.x0 + 5, SW_H, wz - 6)), { Shop = d.shop or d.sign })
	if d.action then
		local at = counterAt or V3(doorX, SW_H + 2.4, -1.8)
		local _, pp = promptPart(f, "ShopPrompt", at, d.actionText or "Enter", d.sign, { Action = d.action, Store = d.sign }, d.signFg)
		if counterAt then
			pp.MaxActivationDistance = 14
		end
	end
	local glow = pointAt(f, CF(cx, 6, -1.4), Color3.fromRGB(255, 214, 160), 18, 0.9)
	glow.Enabled = false
	tag(glow, "NightLight")
	-- awning and sign band (between the ground floor glass and the first upper storey)
	part(f, "ShopAwning", V3(w - 1.5, 0.35, 5.4), CF(cx, 10.6, -2.6) * ANG(RAD(-14), 0, 0), d.awning, M.Fabric)
	local signPart = part(f, "ShopSign", V3(w - 3, 3.2, 0.4), CF(cx, 12.8, -0.25), d.signBg, M.SmoothPlastic)
	signPart:SetAttribute("Store", d.sign)
	local loc = Signage.ByShop[d.sign]
	if loc then
		Signage.Board(signPart, Enum.NormalId.Front, loc, { maxDist = 700 })
	else
		local sg = gui(signPart, Enum.NormalId.Front, Signage.PPS(3.2, 0.8), 0, 700)
		frame(sg, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = d.signBg })
		label(sg, d.sign, { TextColor3 = d.signFg, Size = UDim2.fromScale(0.94, 0.8), Position = UDim2.fromScale(0.03, 0.1) })
	end
	if d.neon then
		neonOutline(f, CF(cx, 12.8, -0.56), w - 2.6, 3.5, d.signFg)
	end
	-- upper floors
	local wy0 = d.marquee and 19.5 or (d.columns and 25 or G + 2.4)
	local rows = d.floors or 0
	if rows >= 1 then
		K.windowGrid(gridPart, Enum.NormalId.Front, h - gridBase, wy0 - gridBase, h - 1.8 - gridBase, rows, math.max(2, math.floor(w / 9)), rng, 0.4)
	end
	if d.marquee then
		local mq = part(f, "Marquee", V3(w + 2, 3.6, 4), CF(cx, 16.4, -2.1), Color3.fromRGB(20, 20, 24), M.Metal)
		local msg = gui(mq, Enum.NormalId.Front, 20, 0, 700)
		frame(msg, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(250, 246, 230) })
		label(msg, "SAT: VEGA vs KOVAC  -  WORLD TITLE", { Name = "MarqueeText", TextColor3 = Color3.fromRGB(20, 20, 24), Size = UDim2.fromScale(0.94, 0.7), Position = UDim2.fromScale(0.03, 0.15) })
		mq:SetAttribute("Kind", "Marquee")
		tag(mq, "CityScreen")
		for k = 0, 9 do
			ball(f, "MarqueeBulb", 0.4, CF(cx - w / 2 - 0.7 + k * (w + 1.4) / 9, 18.4, -4.0), Color3.fromRGB(255, 230, 150), M.Neon, { shadow = false })
		end
	end
	if d.columns then
		part(f, "MuseumSteps", V3(w - 8, 0.3, 2.6), CF(cx, SW_H + 0.15, -1.3), Color3.fromRGB(200, 196, 186), M.Limestone, { collide = true })
		part(f, "MuseumSteps", V3(w - 8, 0.3, 1.3), CF(cx, SW_H + 0.45, -0.65), Color3.fromRGB(200, 196, 186), M.Limestone, { collide = true })
		for k = 0, 4 do
			vcyl(f, "MuseumColumn", 22, 2.0, CF(d.x0 + 7 + k * (w - 14) / 4, SW_H + 0.6, -1.8), Color3.fromRGB(235, 228, 210), M.Limestone, { collide = true })
		end
		part(f, "Pediment", V3(w - 4, 2.2, 5.2), CF(cx, 24.5, -2.4), Color3.fromRGB(235, 228, 210), M.Limestone)
		part(f, "PedimentGable", V3(w - 8, 3.6, 1.6), CF(cx, 27.3, -1.2), Color3.fromRGB(235, 228, 210), M.Limestone, { class = "WedgePart" })
	end
	if d.poleSign then
		local px = d.x0 + 4
		part(f, "PoleSignPost", V3(0.8, 34 - SW_H, 0.8), CF(px, SW_H + (34 - SW_H) / 2, -2.2), K.POLE, M.Metal, { collide = true })
		local ps = part(f, "PoleSign", V3(1.2, 12, 4.6), CF(px, 28, -3.4), Color3.fromRGB(16, 20, 40), M.SmoothPlastic)
		local txt = table.concat(string.split(d.poleSign, ""), "\n")
		GymDecor.Sign(ps, Enum.NormalId.Left, txt, d.signFg, Color3.fromRGB(16, 20, 40), 20)
		GymDecor.Sign(ps, Enum.NormalId.Right, txt, d.signFg, Color3.fromRGB(16, 20, 40), 20)
		for _, s in ipairs({ -1, 1 }) do
			neonOutline(f, CF(px + s * 0.72, 28, -3.4) * ANG(0, RAD(90 * s), 0), 4.5, 11.9, d.signFg)
		end
		local vac = part(f, "VacancySign", V3(1.2, 2.2, 4.6), CF(px, 20.6, -3.4), Color3.fromRGB(16, 20, 40), M.SmoothPlastic)
		GymDecor.Sign(vac, Enum.NormalId.Left, "VACANCY", Color3.fromRGB(255, 80, 80), Color3.fromRGB(16, 20, 40), 30, nil, "signSub")
		GymDecor.Sign(vac, Enum.NormalId.Right, "VACANCY", Color3.fromRGB(255, 80, 80), Color3.fromRGB(16, 20, 40), 30, nil, "signSub")
	end
	if d.fireEscape then
		local x0 = cx + w * 0.14
		for fl = 1, d.floors or 1 do
			local y = G + 3.2 + (fl - 1) * S
			part(f, "FireLanding", V3(11, 0.25, 3.2), CF(x0, y, -1.7), Color3.fromRGB(34, 34, 38), M.DiamondPlate)
			part(f, "FireRail", V3(11, 0.15, 0.15), CF(x0, y + 3.4, -3.25), Color3.fromRGB(34, 34, 38), M.Metal)
			part(f, "FireRailPanel", V3(11, 3.2, 0.08), CF(x0, y + 1.7, -3.25), Color3.fromRGB(34, 34, 38), M.Metal, { transparency = 0.6, shadow = false })
			if fl > 1 then
				local a = V3(x0 - 4.5, y - S, -1.9)
				local b = V3(x0 + 3.5, y, -1.9)
				part(f, "FireStair", V3(2.4, 0.25, (b - a).Magnitude), CFrame.lookAt((a + b) / 2, b), Color3.fromRGB(34, 34, 38), M.DiamondPlate)
			end
		end
	end
	if rng:NextNumber() < 0.7 then
		part(f, "RoofUnit", V3(6, 3, 5), CF(cx + rng:NextNumber(-w / 4, w / 4), h + 2.1, depth * 0.6), Color3.fromRGB(196, 198, 202), M.Metal)
	end
	if d.floors and d.floors >= 1 and rng:NextNumber() < 0.5 then
		-- a rooftop water tank on the older blocks
		local tp = CF(cx - w * 0.25, h + 1.1, depth * 0.55)
		for _, o in ipairs({ { -2, -2 }, { 2, -2 }, { -2, 2 }, { 2, 2 } }) do
			part(f, "TankLeg", V3(0.35, 5, 0.35), tp * CF(o[1], 2.5, o[2]), Color3.fromRGB(40, 42, 48), M.Metal)
		end
		vcyl(f, "WaterTank", 7, 6, tp * CF(0, 5, 0), Color3.fromRGB(120, 86, 60), M.WoodPlanks)
		part(f, "TankRoof", V3(6.4, 1.8, 6.4), tp * CF(0, 12.5, 0) * ANG(0, RAD(45), 0), Color3.fromRGB(60, 50, 44), M.Slate)
	end
	return body
end

-- Riverside Apartments: lobby canopy, balconies, fire escape, AC units, rooftop tank and the
-- penthouse terrace (the player's apartment when they buy one; CityVisuals dresses it)
local function apartmentExtras(f, d, rng)
	local w = d.x1 - d.x0
	local cx = (d.x0 + d.x1) / 2
	local h = d.h
	local doorX = cx + w * (d.doorAt or 0.22)
	local concrete = Color3.fromRGB(120, 120, 126)
	local rail = Color3.fromRGB(40, 42, 48)
	part(f, "LobbyCanopy", V3(9, 0.5, 6), CF(doorX, 10.2, -3.0), Color3.fromRGB(26, 28, 32), M.Metal)
	for _, s in ipairs({ -1, 1 }) do
		part(f, "CanopyPost", V3(0.35, 9.6, 0.35), CF(doorX + s * 4.0, SW_H + 4.8, -5.7), Color3.fromRGB(26, 28, 32), M.Metal, { collide = true })
	end
	local plate = part(f, "AddressPlate", V3(4, 0.8, 0.08), CF(doorX, 10.9, -6.0), Color3.fromRGB(230, 200, 120), M.Metal)
	GymDecor.Sign(plate, Enum.NormalId.Front, "1 RIVERSIDE", Color3.fromRGB(40, 30, 10), Color3.fromRGB(230, 200, 120), 40)
	nightPoint(f, CF(doorX, 9.4, -3.2), Color3.fromRGB(255, 220, 170), 14, 0.9)
	local floors = d.floors or 4
	local cols = math.max(2, math.floor(w / 9))
	local wy0 = G + 2.4
	local rowH = (h - 1.8 - wy0) / floors
	for fl = 1, floors - 1 do
		local y = wy0 + fl * rowH
		for c = 1, cols - 2 do
			local x = d.x0 + (c + 0.5) / cols * w
			part(f, "Balcony", V3(w / cols * 0.75, 0.4, 3.2), CF(x, y, -1.6), concrete, M.Concrete)
			part(f, "BalconyRail", V3(w / cols * 0.75, 3.6, 0.12), CF(x, y + 2.0, -3.15), rail, M.Metal, { transparency = 0.2 })
		end
	end
	local fx = d.x0 - 1.8
	for fl = 1, floors - 1 do
		local y = wy0 + fl * rowH
		part(f, "FireLanding", V3(3.4, 0.25, 9), CF(fx, y, 16), rail, M.DiamondPlate)
		part(f, "FireRail", V3(0.12, 3.4, 9), CF(fx - 1.65, y + 1.8, 16), rail, M.Metal, { transparency = 0.5 })
		local a = V3(fx, y - rowH + 0.2, 12)
		local b = V3(fx, y, 20)
		if fl > 1 then
			part(f, "FireStair", V3(2.6, 0.25, (b - a).Magnitude), CFrame.lookAt((a + b) / 2, b), rail, M.DiamondPlate)
		end
	end
	for _ = 1, 6 do
		local c = rng:NextInteger(0, cols - 1)
		local fl = rng:NextInteger(0, floors - 1)
		part(f, "ACUnit", V3(2.2, 1.4, 1.5), CF(d.x0 + (c + 0.5) / cols * w + 1.8, wy0 + fl * rowH + 1.6, -0.75), Color3.fromRGB(210, 210, 206), M.Metal)
	end
	local tank = V3(d.x1 - 10, h + 1.1, 28)
	for _, o in ipairs({ { -2, -2 }, { 2, -2 }, { -2, 2 }, { 2, 2 } }) do
		part(f, "TankLeg", V3(0.35, 5, 0.35), CF(tank + V3(o[1], 2.5, o[2])), rail, M.Metal)
	end
	vcyl(f, "WaterTank", 7, 6.4, CF(tank + V3(0, 5, 0)), Color3.fromRGB(120, 86, 60), M.WoodPlanks)
	part(f, "TankRoof", V3(6.8, 1.8, 6.8), CF(tank + V3(0, 12.6, 0)) * ANG(0, RAD(45), 0), Color3.fromRGB(60, 50, 44), M.Slate)
	part(f, "StairHut", V3(8, 7, 8), CF(d.x0 + 8, h + 4.5, 30), concrete, M.Concrete, { collide = true })
	part(f, "TerraceRail", V3(w - 4, 3.4, 0.12), CF(cx, h + 2.8, 1.0), Color3.fromRGB(190, 220, 240), M.Glass, { transparency = 0.5 })
	site("ApartmentRoof", CFrame.lookAt(V3(cx, h + 1.1, 10), V3(cx, h + 1.1, -10)))
	site("ApartmentBanner", CFrame.lookAt(V3(d.x0 + 2.5 / cols * w, wy0 + 2.5 * rowH, -0.15), V3(d.x0 + 2.5 / cols * w, wy0 + 2.5 * rowH, -10)))
	site("HomeApartment", CFrame.lookAt(V3(doorX, SW_H, -3.4), V3(doorX, SW_H, -10)))
	-- the kerbside spot in front of the lobby where your car parks (CityVisuals): the near parking lane
	local kerbZ = CITY.MainStreet.frontS - CITY.MainStreet.parkLanes[2]
	site("ApartmentKerb", CF(doorX + 14, K.ROAD_Y, -kerbZ) * ANG(0, RAD(-90), 0))
	promptPart(f, "HomePrompt", V3(doorX, SW_H + 2.4, -1.8), "Enter apartment", "Riverside Apartments", { Action = "Home", Kind = "Apartment" }, Color3.fromRGB(255, 230, 170))
	part(f, "RealtyPost", V3(0.25, 5.4, 0.25), CF(doorX - 7, SW_H + 2.7, -4.6), C.white, M.Wood)
	local rs = part(f, "RealtySign", V3(3.6, 2.2, 0.1), CF(doorX - 7, SW_H + 4.8, -4.6), Color3.fromRGB(180, 30, 36), M.SmoothPlastic)
	GymDecor.Sign(rs, Enum.NormalId.Front, "PENTHOUSE\nAVAILABLE\nCITY REALTY", C.white, Color3.fromRGB(180, 30, 36), 40)
	rs:SetAttribute("Kind", "ForSale")
	rs:SetAttribute("Home", "Apartment")
	tag(rs, "CityScreen")
end

-- the gas station: canopy over three pump islands, the shop behind, the price pylon by the street
-- (row frame; the apron runs from the kerb to the shop at road level)
local function gasStation(f)
	local gx0, gx1 = CityShops.GAS.x0, CityShops.GAS.x1
	local cx = (gx0 + gx1) / 2
	local cz = 14
	local sw = CITY.MainStreet.frontS - CITY.MainStreet.z1 -- the sidewalk depth
	part(f, "GasApron", V3(gx1 - gx0, K.ROAD_Y, 40 + sw), CF(cx, K.ROAD_Y / 2, (40 - sw) / 2), Color3.fromRGB(150, 150, 152), M.Concrete, { collide = true })
	part(f, "GasCanopy", V3(60, 2.0, 34), CF(cx, 18.6, cz), C.white, M.SmoothPlastic)
	for _, s in ipairs({ -1, 1 }) do
		part(f, "GasFascia", V3(60.3, 1.2, 0.2), CF(cx, 18.6, cz + s * 17.05), Color3.fromRGB(200, 30, 36), M.SmoothPlastic)
		part(f, "GasFascia", V3(0.2, 1.2, 34.3), CF(cx + s * 30.05, 18.6, cz), Color3.fromRGB(200, 30, 36), M.SmoothPlastic)
	end
	for _, x in ipairs({ -18, 0, 18 }) do
		part(f, "CanopyPanel", V3(9, 0.1, 4), CF(cx + x, 17.55, cz), Color3.fromRGB(245, 248, 255), M.Neon, { shadow = false })
	end
	for _, x in ipairs({ -22, 22 }) do
		for _, z in ipairs({ -10, 10 }) do
			part(f, "GasPillar", V3(1.6, 17.6, 1.6), CF(cx + x, 8.8 + K.ROAD_Y, cz + z), C.white, M.SmoothPlastic, { collide = true })
		end
	end
	for _, x in ipairs({ -16, 0, 16 }) do
		part(f, "PumpIsland", V3(4, 0.6, 14), CF(cx + x, K.ROAD_Y + 0.3, cz), Color3.fromRGB(190, 186, 180), M.Concrete, { collide = true })
		for _, z in ipairs({ -3.4, 3.4 }) do
			local pump = part(f, "Pump", V3(2.2, 6.4, 1.6), CF(cx + x, K.ROAD_Y + 3.8, cz + z), Color3.fromRGB(200, 30, 36), M.SmoothPlastic, { collide = true })
			GymDecor.Sign(pump, Enum.NormalId.Front, "3.49", C.gold, C.black, 40)
			GymDecor.Sign(pump, Enum.NormalId.Back, "3.49", C.gold, C.black, 40)
		end
	end
	for _, x in ipairs({ -12, 12 }) do
		spotAt(f, CF(cx + x, 17.4, cz), Enum.NormalId.Bottom, Color3.fromRGB(240, 245, 255), 34, 1.6, 120)
	end
	-- the shop behind the pumps and the price pylon by the street
	local shopZ = 46
	part(f, "GasShop", V3(44, 14, 22), CF(cx, 7, shopZ), Color3.fromRGB(230, 230, 226), M.SmoothPlastic, { collide = true })
	part(f, "GasShopFascia", V3(44.4, 1.2, 22.4), CF(cx, 14.4, shopZ), Color3.fromRGB(200, 30, 36), M.SmoothPlastic)
	local gs = part(f, "GasShopSign", V3(26, 3.2, 0.3), CF(cx, 11.6, shopZ - 11.15), Color3.fromRGB(200, 30, 36), M.SmoothPlastic)
	Signage.Board(gs, Enum.NormalId.Front, "gas", { maxDist = 700 })
	local gw = part(f, "GasShopWindow", V3(30, 7, 0.1), CF(cx, 4.4, shopZ - 11.1), Color3.fromRGB(170, 205, 230), M.Glass, { transparency = 0.45, shadow = false })
	gw:SetAttribute("Shop", "FUEL & GO")
	part(f, "GasShopDoor", V3(CITY.Door.w, CITY.Door.h, 0.15), CF(cx + 10, K.ROAD_Y + CITY.Door.h / 2, shopZ - 11.2), Color3.fromRGB(30, 30, 34), M.Metal)
	site("Window_FUELGO", CFrame.lookAt(V3(cx - 8, K.ROAD_Y, shopZ - 12.6), V3(cx - 8, K.ROAD_Y, shopZ - 20)), { Shop = "FUEL & GO" })
	-- air / vacuum and an ice chest by the shop, a vacuum sign
	local ice = part(f, "IceChest", V3(5, 5, 3), CF(cx - 18, K.ROAD_Y + 2.5, shopZ - 12.8), Color3.fromRGB(230, 232, 236), M.SmoothPlastic, { collide = true })
	GymDecor.Sign(ice, Enum.NormalId.Front, "ICE", Color3.fromRGB(30, 90, 190), Color3.fromRGB(230, 232, 236), 40)
	vcyl(f, "AirPump", 4.6, 1.4, CF(cx + 19, K.ROAD_Y, shopZ - 13.5), Color3.fromRGB(40, 40, 44), M.Metal, { collide = true })
	local py = V3(gx0 + 8, K.ROAD_Y, -sw + 4)
	part(f, "PylonPole", V3(1.2, 24, 1.2), CF(py + V3(0, 12, 0)), C.steel, M.Metal, { collide = true })
	local pylon = part(f, "Pylon", V3(8, 8, 1.2), CF(py + V3(0, 28, 0)), Color3.fromRGB(200, 30, 36), M.SmoothPlastic)
	for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
		local psg = gui(pylon, face, 20, 0, 900)
		frame(psg, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(200, 30, 36) })
		label(psg, "FUEL & GO", { TextColor3 = Color3.new(1, 1, 1), Size = UDim2.fromScale(0.8, 0.36), Position = UDim2.fromScale(0.1, 0.05) })
		label(psg, "3.49", { TextColor3 = C.gold, Face = "screen", Size = UDim2.fromScale(0.8, 0.45), Position = UDim2.fromScale(0.1, 0.48) })
	end
	-- a couple of cars at the pumps
	K.car(f, ROW * CF(cx - 8, K.ROAD_Y, cz) * ANG(0, RAD(90), 0), K.CAR_COLORS[4], "suv")
	K.car(f, ROW * CF(cx + 8, K.ROAD_Y, cz + 0.5) * ANG(0, RAD(-90), 0), K.CAR_COLORS[2], "sedan")
end

------------------------------------------------------------------------
-- rows
------------------------------------------------------------------------
-- the south row: every shop of CityShops.SHOPS, the apartments' extras, the gas station
function CityShops.BuildRow(parent, rowCF, rowYaw, rng)
	ROW, ROW_YAW = rowCF, rowYaw or 0
	parent:SetAttribute("RowX", rowCF.Position.X)
	parent:SetAttribute("RowZ", rowCF.Position.Z)
	parent:SetAttribute("RowYaw", rowYaw or 0)
	for _, d in ipairs(CityShops.SHOPS) do
		local ok, err = pcall(shop, parent, d, rng)
		if not ok then
			warn("[CityShops] " .. tostring(d.sign) .. " failed: " .. tostring(err))
		end
		if d.apartments then
			pcall(apartmentExtras, parent, d, rng)
		end
	end
	local ok, err = pcall(gasStation, parent)
	if not ok then
		warn("[CityShops] gas station failed: " .. tostring(err))
	end
	ROW, ROW_YAW = CF(), 0
end

-- a row of simple mixed-use buildings (facade shops below flats / offices) between x0 and x1 of a
-- row frame: no interiors, no prompts, but every storefront carries a sign (own text / lockup)
local NORTH_SHOPS = {
	{ w = 44, floors = 2, sign = "RIVERSIDE REALTY", bg = Color3.fromRGB(20, 60, 110), fg = Color3.fromRGB(240, 240, 245), color = Color3.fromRGB(196, 176, 150), mat = M.Brick, awning = Color3.fromRGB(20, 60, 110) },
	{ w = 36, floors = 1, sign = "LUCKY DRAGON NOODLES", bg = Color3.fromRGB(170, 24, 30), fg = Color3.fromRGB(255, 220, 90), color = Color3.fromRGB(226, 220, 206), awning = Color3.fromRGB(170, 24, 30), neon = true },
	{ w = 40, floors = 3, sign = "MAIN ST PHARMACY", bg = Color3.fromRGB(30, 110, 60), fg = C.white, color = Color3.fromRGB(150, 146, 140), mat = M.Concrete, awning = Color3.fromRGB(30, 110, 60) },
	{ w = 30, floors = 1, sign = "GOLDEN GLOVE PAWN", bg = Color3.fromRGB(20, 20, 24), fg = C.gold, color = Color3.fromRGB(120, 60, 50), mat = M.Brick, awning = Color3.fromRGB(20, 20, 24), neon = true },
	{ w = 48, floors = 2, sign = "WCB SPORTS BAR", bg = Color3.fromRGB(14, 14, 18), fg = Color3.fromRGB(255, 205, 83), color = Color3.fromRGB(60, 56, 60), mat = M.Brick, awning = Color3.fromRGB(14, 14, 18), neon = true },
	{ w = 34, floors = 1, sign = "SUMMIT SPORTSWEAR", bg = Color3.fromRGB(240, 236, 226), fg = Color3.fromRGB(30, 30, 34), color = Color3.fromRGB(236, 232, 224), awning = Color3.fromRGB(30, 30, 34) },
	{ w = 42, floors = 3, sign = "CITY HARDWARE", bg = Color3.fromRGB(200, 90, 30), fg = C.white, color = Color3.fromRGB(176, 120, 90), mat = M.Brick, awning = Color3.fromRGB(200, 90, 30) },
	{ w = 38, floors = 2, sign = "BELLA'S FLOWERS", bg = Color3.fromRGB(240, 150, 180), fg = Color3.fromRGB(60, 30, 50), color = Color3.fromRGB(214, 200, 190), awning = Color3.fromRGB(240, 150, 180) },
	{ w = 46, floors = 2, sign = "DOWNTOWN DENTAL  ·  OPTICIANS", bg = Color3.fromRGB(240, 244, 248), fg = Color3.fromRGB(30, 90, 160), color = Color3.fromRGB(190, 196, 206), mat = M.Concrete, awning = Color3.fromRGB(30, 90, 160) },
	{ w = 36, floors = 1, sign = "RING ROAD BIKES", bg = Color3.fromRGB(30, 30, 34), fg = Color3.fromRGB(80, 220, 110), color = Color3.fromRGB(96, 96, 100), mat = M.Metal, awning = Color3.fromRGB(80, 220, 110) },
	{ w = 44, floors = 3, sign = "THE CORNER BOOKSHOP", bg = Color3.fromRGB(60, 40, 30), fg = Color3.fromRGB(255, 230, 190), color = Color3.fromRGB(150, 90, 70), mat = M.Brick, awning = Color3.fromRGB(60, 40, 30) },
	{ w = 40, floors = 2, sign = "CHAMPION CLEANERS", bg = Color3.fromRGB(40, 110, 200), fg = C.white, color = Color3.fromRGB(220, 226, 232), awning = Color3.fromRGB(40, 110, 200) },
	{ w = 50, floors = 3, sign = "HOTEL MAJESTIC", bg = Color3.fromRGB(26, 22, 30), fg = Color3.fromRGB(230, 200, 120), color = Color3.fromRGB(206, 190, 170), mat = M.Limestone, awning = Color3.fromRGB(26, 22, 30), neon = true, lobby = true },
}
CityShops.NORTH_SHOPS = NORTH_SHOPS

-- gaps = { { a, b } } row-local x ranges no building may cover (the streets crossing the row)
function CityShops.BuildNorthRow(parent, rowCF, rowYaw, x0, x1, rng, gaps)
	ROW, ROW_YAW = rowCF, rowYaw or 0
	parent:SetAttribute("RowX", rowCF.Position.X)
	parent:SetAttribute("RowZ", rowCF.Position.Z)
	parent:SetAttribute("RowYaw", rowYaw or 0)
	local x = x0
	local i = 0
	while true do
		i += 1
		local d = NORTH_SHOPS[(i - 1) % #NORTH_SHOPS + 1]
		for _, g in ipairs(gaps or {}) do
			if x < g[2] and x + d.w > g[1] then
				x = g[2] + 1.2
			end
		end
		if x + d.w > x1 then
			break
		end
		local gap = (i % 3 == 0) and 6 or 0
		local m = K.building(parent, ROW * CF(x + d.w / 2, 0, 0), d.w, 40 + (i % 2) * 6, d.floors, {
			color = d.color, mat = d.mat, sign = d.sign, signBg = d.bg, signFg = d.fg, awning = d.awning, rng = rng, lit = 0.4, retail = not d.lobby,
			name = "RowBuilding", tank = (i % 4 == 1), units = 1,
		})
		m:SetAttribute("Sign", d.sign)
		if d.neon then
			neonOutline(parent, CF(x + d.w / 2, G - 1.7, -0.56), d.w - 2.6 - 0.4, 3.5, d.fg)
		end
		x += d.w + 1.2 + gap
	end
	ROW, ROW_YAW = CF(), 0
end

CityShops.Interiors = INTERIOR
return CityShops
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="95">
        <Properties>
          <string name="Name">Crowd</string>
          <string name="Source"><![CDATA[-- Crowd: the fight venues' spectators and stands. Venues.buildTemplate calls Crowd.Build on every venue template
-- (sold out), Venues.New calls Crowd.Apply on each fight's clone (the house Venues.CrowdFill draws, the supporters,
-- the signs). Everything that moves (sitting / standing / jumping, arms, phones, signs, the printed rows and the
-- upper bowl, the reaction waves) is the client's src/client/modules/CrowdFX.lua.
--
-- Three kinds of fan, by how close the fight cameras get (CONTRACTS 11: no per-fan scripts, no Builder NPCs):
--   full   ringside row 0, the VIP boxes, the press box, the standers: Fan (torso, the root) + Head (a classic head
--          mesh wearing one of the drawn Boxer faces as its front Decal) + ArmL / ArmR + Lap (seated; CrowdFX turns it
--          into legs when he stands) or Legs + an optional Hat (cap, beanie, bucket) + an optional Phone. 5-7 parts.
--   lite   the next physical row(s): Fan + Head + ArmL + ArmR (+ Hat). 4-5 parts.
--   print  every row behind, the standing room and the upper bowl: one slab per seating block (attributes
--          CrowdCols / Seed / RowFrac / Standing / CrowdRows); CrowdFX draws its fans on the slab's ring-facing
--          surface (a flat body, a round face wearing a drawn face, arms, hats) and animates them. Zero parts a fan.
-- No two fans the same: build (shoulders, height, women), skin tone, face, headwear (BaldMode: caps, beanies and
-- bucket hats or bald), clothing style (jersey with a number, hoodie, jacket, tee, suit at ringside / in the boxes)
-- and colour, what they hold.
--
-- Stands: tiered rows with the venue's rake (tread tops at row * rowRise + 0.5, the geometry VenueDetail's aisle
-- nosings and rails expect), seat rows per block, a mid aisle on the walkway-free sides and the walkway aisles on
-- the others, stair lights on every aisle step, glass-railed VIP boxes with leather seats and a drinks table, a
-- MEDIA box with monitors, sponsor boards on the fascias, LED ribbons, broadcast camera platforms (a camera and its
-- operator on a railed riser), a photographers' pit at the apron and a standing-room rail at the top.
--
-- Attributes CrowdFX reads: on the arena CrowdShare (0..1) and CrowdReact ("event|who|seq", Crowd.React); on a Fan
-- Row, Side, Rig (full / lite), VIP, Standing, Supporter, Fav (1 the player's fan, -1 the opponent's, 0 neutral),
-- Style, Energy, Phone; on a print slab CrowdCols, Seed, RowFrac, Standing, CrowdRows (bowl tiers), Side.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Looks = require(Shared:WaitForChild("Looks"))
local Typography = require(Shared:WaitForChild("Typography"))
local BodyTiers
do
	local ok, m = pcall(function()
		return require(Shared:WaitForChild("BodyTiers"))
	end)
	BodyTiers = ok and m or nil
end

local Crowd = {}

local V3 = Vector3.new
local CF = CFrame.new
local M = Enum.Material
local FACE = Enum.NormalId

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end
local function c3(t)
	return Color3.fromRGB(t[1], t[2], t[3])
end

local BLACK = rgb(14, 14, 18)
local WHITE = rgb(238, 238, 238)
local GOLD = rgb(255, 200, 40)
local RED = rgb(200, 25, 30)

-- the seat pitch (studs between neighbours) and the rows of real rigs per venue tier (row 0 is always full rigs)
Crowd.SEAT = 3.0
-- the real rigs sit a little wider (fewer parts a row; the printed rows behind keep the tighter pitch)
Crowd.RIG_SEAT = 3.4
Crowd.PHYSICAL_ROWS = { [1] = 2, [2] = 2, [3] = 2, [4] = 2 }
-- fans per box, boxes per block side
Crowd.VIP_SEATS = 4

------------------------------------------------------------------------
-- part helpers (the same conventions as Venues': anchored, no touches; dressing never collides or queries)
------------------------------------------------------------------------
local function part(parent, props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanTouch = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		p[k] = v
	end
	p.Parent = parent
	return p
end

local function deco(parent, name, size, cf, color, material, extra)
	local props = { Name = name, Size = size, CFrame = cf, Color = color, Material = material or M.SmoothPlastic }
	for k, v in pairs(extra or {}) do
		props[k] = v
	end
	return part(parent, props)
end

local function prop(parent, name, size, cf, color, material, extra)
	local p = deco(parent, name, size, cf, color, material, extra)
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	return p
end

-- a fan's part: never collides, queries, touches or casts (hundreds of them)
local FANP = { CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false }
local function fanPart(parent, name, size, cf, color, material)
	return prop(parent, name, size, cf, color, material or M.Fabric, FANP)
end

local function blob(parent, name, size, cf, color, material, extra)
	local p = prop(parent, name, size, cf, color, material, extra)
	local m = Instance.new("SpecialMesh")
	m.MeshType = Enum.MeshType.Sphere
	m.Parent = p
	return p
end

local function gui(p, face, pps, light, bright)
	local sg = Instance.new("SurfaceGui")
	sg.Face = face
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = pps or 14
	sg.LightInfluence = light or 0
	sg.Brightness = bright or 1
	sg.MaxDistance = 420
	sg.ClipsDescendants = true
	sg.Parent = p
	return sg
end

local function frame(parent, props)
	local f = Instance.new("Frame")
	f.BorderSizePixel = 0
	for k, v in pairs(props) do
		f[k] = v
	end
	f.Parent = parent
	return f
end

local function label(parent, props)
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.BorderSizePixel = 0
	Typography.Apply(t, "sign")
	t.TextScaled = true
	t.TextColor3 = WHITE
	t.Text = ""
	for k, v in pairs(props) do
		if k == "Face" then
			Typography.Apply(t, v)
		else
			t[k] = v
		end
	end
	t.Parent = parent
	return t
end

local function round(f, scale)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(scale or 0.5, 0)
	c.Parent = f
	return c
end

local function sign(p, face, text, bg, fg, pps, font, light)
	local sg = gui(p, face, pps or 14, light or 0, 1)
	label(sg, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = bg or BLACK, BackgroundTransparency = bg and 0 or 1, TextColor3 = fg or GOLD, Face = font or "sign", Text = text })
	return sg
end

local function rod(parent, name, p0, p1, thick, color, material)
	local len = (p1 - p0).Magnitude
	local d = p1 - p0
	local cf
	if len < 1e-4 then
		cf = CF(p0)
	elseif math.abs(d.Unit.Y) > 0.98 then
		cf = CFrame.lookAt((p0 + p1) / 2, p1, Vector3.xAxis)
	else
		cf = CFrame.lookAt((p0 + p1) / 2, p1)
	end
	return prop(parent, name, V3(thick, thick, len), cf, color, material or M.Metal, { CastShadow = false })
end

------------------------------------------------------------------------
-- Looks: who the fans are
------------------------------------------------------------------------
-- clothing by style: the colours a style comes in (a fan's shirt = one of them, his sleeves the same or the jacket's)
local JERSEY = { { 200, 30, 30 }, { 30, 60, 200 }, { 240, 240, 240 }, { 20, 20, 24 }, { 240, 190, 40 }, { 40, 150, 70 }, { 130, 40, 170 }, { 240, 120, 30 }, { 0, 170, 190 }, { 240, 120, 170 } }
local HOODIE = { { 60, 60, 66 }, { 30, 36, 60 }, { 24, 24, 28 }, { 110, 30, 40 }, { 90, 90, 96 }, { 40, 80, 60 }, { 150, 150, 158 }, { 70, 40, 90 } }
local JACKET = { { 26, 26, 30 }, { 70, 50, 36 }, { 60, 70, 50 }, { 40, 60, 110 }, { 120, 40, 40 }, { 150, 150, 158 } }
local TEE = { { 240, 240, 240 }, { 200, 200, 205 }, { 20, 20, 24 }, { 230, 90, 60 }, { 90, 160, 220 }, { 240, 220, 120 }, { 130, 200, 150 }, { 240, 170, 200 }, { 170, 120, 70 }, { 60, 60, 66 } }
local SUIT = { { 26, 30, 44 }, { 30, 30, 34 }, { 50, 50, 56 }, { 40, 30, 30 }, { 20, 22, 30 } }
local HATS = { { 200, 30, 30 }, { 30, 60, 200 }, { 20, 20, 24 }, { 240, 240, 240 }, { 60, 60, 66 }, { 40, 110, 60 }, { 240, 190, 40 }, { 120, 80, 50 } }
local STYLES = { "jersey", "hoodie", "jacket", "tee", "tee", "jersey" }
-- the resting drawn faces fans wear, weighted (Looks.NPC_FACES when the Looks module exports it)
local FACES = Looks.NPC_FACES or {
	{ "wcb_neutral", 0.3 }, { "wcb_grin", 0.14 }, { "wcb_smirk", 0.1 }, { "wcb_focused", 0.1 }, { "wcb_confident", 0.08 },
	{ "wcb_cool", 0.08 }, { "wcb_toothy", 0.06 }, { "wcb_determined", 0.05 }, { "wcb_stern", 0.04 }, { "wcb_wink", 0.03 }, { "wcb_grit", 0.02 },
}
-- fans smile more than boxers: the friendly faces weigh in again
local FAN_FACES = {}
do
	local boost = { wcb_grin = 4, wcb_toothy = 4, wcb_smirk = 2, wcb_cool = 2, wcb_wink = 2, wcb_confident = 1.5 }
	for _, f in ipairs(FACES) do
		table.insert(FAN_FACES, { f[1], f[2] * (boost[f[1]] or 1) })
	end
end

local faceIds = nil
local function faceId(key)
	if not faceIds then
		faceIds = {}
		if BodyTiers and BodyTiers.Face then
			for _, f in ipairs(FAN_FACES) do
				local ok, e = pcall(BodyTiers.Face, f[1])
				if ok and type(e) == "table" and e.id then
					faceIds[f[1]] = e.id
				end
			end
		end
	end
	return faceIds[key]
end

local function pick(rng, list)
	return list[rng:NextInteger(1, #list)]
end

local function faceKey(rng)
	local total = 0
	for _, f in ipairs(FAN_FACES) do
		total += f[2]
	end
	local r = rng:NextNumber() * total
	for _, f in ipairs(FAN_FACES) do
		if r < f[2] then
			return f[1]
		end
		r -= f[2]
	end
	return FAN_FACES[1][1]
end

-- one fan's look. o.dress: "ringside" (suits and jackets likely), "vip" (suits), "press", or nil (anyone)
function Crowd.Look(rng, o)
	o = o or {}
	local L = {}
	local skin = Looks.SkinTones[rng:NextInteger(1, #Looks.SkinTones)]
	L.skin = c3(skin)
	L.female = rng:NextNumber() < 0.38
	-- build: shoulders and height; women narrower
	L.w = (L.female and 1.35 or 1.6) * (0.88 + rng:NextNumber() * 0.26)
	L.h = (L.female and 1.85 or 2.0) * (0.9 + rng:NextNumber() * 0.2)
	L.face = faceKey(rng)
	-- headwear (BaldMode: no hair): caps and beanies, or bald
	local hr = rng:NextNumber()
	if o.dress == "vip" or o.dress == "press" then
		L.hat = hr < 0.12 and "cap" or nil
	else
		L.hat = hr < 0.38 and "cap" or (hr < 0.52 and "beanie" or (hr < 0.58 and "bucket" or nil))
	end
	L.hatColor = c3(pick(rng, HATS))
	-- clothing
	local style
	if o.dress == "vip" then
		style = rng:NextNumber() < 0.75 and "suit" or "jacket"
	elseif o.dress == "press" then
		style = rng:NextNumber() < 0.5 and "jacket" or "tee"
	elseif o.dress == "ringside" then
		local r = rng:NextNumber()
		style = r < 0.35 and "suit" or (r < 0.6 and "jacket" or pick(rng, STYLES))
	else
		style = pick(rng, STYLES)
	end
	L.style = style
	if style == "jersey" then
		L.shirt = c3(pick(rng, JERSEY))
		L.number = rng:NextInteger(1, 99)
	elseif style == "hoodie" then
		L.shirt = c3(pick(rng, HOODIE))
	elseif style == "jacket" then
		L.shirt = c3(pick(rng, JACKET))
		L.inner = c3(pick(rng, TEE))
	elseif style == "suit" then
		L.shirt = c3(pick(rng, SUIT))
		L.tie = rng:NextNumber() < 0.7 and c3(pick(rng, { { 140, 20, 30 }, { 20, 36, 110 }, { 20, 20, 24 }, { 200, 160, 40 }, { 60, 60, 66 } })) or nil
	else
		L.shirt = c3(pick(rng, TEE))
	end
	L.pants = rng:NextNumber() < 0.55 and rgb(28, 28, 34) or (rng:NextNumber() < 0.5 and rgb(40, 50, 90) or rgb(70, 60, 50))
	if style == "suit" then
		L.pants = L.shirt
	end
	-- what he holds: a phone up (recording), nothing
	L.phone = rng:NextNumber() < (o.dress == "vip" and 0.25 or 0.3)
	-- how lively: the jumpers, the clappers, the calm ones
	local er = rng:NextNumber()
	L.energy = er < 0.25 and 0.6 or (er < 0.8 and 1 or 1.4)
	return L
end

------------------------------------------------------------------------
-- rigs
------------------------------------------------------------------------
local function shirtPrint(torso, L)
	if L.style == "tee" or (L.style == "hoodie" and not L.printHood) then
		return
	end
	local sg = gui(torso, FACE.Front, 24, 1, 1)
	sg.Name = "Print"
	if L.style == "jersey" then
		label(sg, { Size = UDim2.fromScale(0.6, 0.5), Position = UDim2.fromScale(0.2, 0.2), Text = tostring(L.number), TextColor3 = L.shirt:Lerp(L.shirt.R + L.shirt.G + L.shirt.B > 1.5 and BLACK or WHITE, 0.85), Face = "number" })
	elseif L.style == "jacket" then
		-- the open jacket shows the shirt under it
		frame(sg, { Size = UDim2.fromScale(0.26, 0.62), Position = UDim2.fromScale(0.37, 0), BackgroundColor3 = L.inner })
	elseif L.style == "suit" then
		frame(sg, { Size = UDim2.fromScale(0.24, 0.46), Position = UDim2.fromScale(0.38, 0), BackgroundColor3 = rgb(236, 236, 240) })
		if L.tie then
			frame(sg, { Size = UDim2.fromScale(0.1, 0.56), Position = UDim2.fromScale(0.45, 0.04), BackgroundColor3 = L.tie, ZIndex = 2 })
		end
	elseif L.style == "hoodie" then
		frame(sg, { Size = UDim2.fromScale(0.5, 0.2), Position = UDim2.fromScale(0.25, 0.62), BackgroundColor3 = L.shirt:Lerp(BLACK, 0.3) })
	end
end

local function headOf(m, L, cf, size)
	local head = fanPart(m, "Head", V3(size, size * 1.06, size), cf, L.skin, M.SmoothPlastic)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Head
	mesh.Scale = V3(1.2, 1.2, 1.2)
	mesh.Parent = head
	local id = faceId(L.face)
	if id then
		local d = Instance.new("Decal")
		d.Name = "face"
		d.Face = FACE.Front
		d.Texture = "rbxassetid://" .. tostring(id)
		d.Color3 = Color3.new(1, 1, 1)
		d.Parent = head
	end
	return head
end

local function hatOf(m, L, headCF, size)
	if not L.hat then
		return
	end
	if L.hat == "cap" then
		-- the peak: the cap sits a little forward of the crown
		local cap = blob(m, "Hat", V3(size * 1.14, size * 0.46, size * 1.4), headCF * CF(0, size * 0.36, -size * 0.12), L.hatColor, M.Fabric, FANP)
		cap:SetAttribute("Kind", "cap")
	elseif L.hat == "beanie" then
		local b = blob(m, "Hat", V3(size * 1.1, size * 0.72, size * 1.1), headCF * CF(0, size * 0.3, 0), L.hatColor, M.Fabric, FANP)
		b:SetAttribute("Kind", "beanie")
	else
		local b = blob(m, "Hat", V3(size * 1.35, size * 0.42, size * 1.35), headCF * CF(0, size * 0.4, 0), L.hatColor:Lerp(BLACK, 0.2), M.Fabric, FANP)
		b:SetAttribute("Kind", "bucket")
	end
end

-- arm about the shoulder: CrowdFX recomputes this with its own pitch / roll
local function armCF(torsoCF, side, w, h, pitch, roll)
	return torsoCF * CF(side * (w / 2 + 0.22), h / 2 - 0.25, 0) * CFrame.Angles(pitch or 0, 0, (roll or 0) * side) * CF(0, -0.8, 0)
end

-- a fan: cf = the seat (or the floor under a stander), LookVector toward the ring. o.rig = "full" | "lite",
-- o.pose = "sit" | "stand", o.dress
local function fan(parent, cf, rng, o)
	local L = Crowd.Look(rng, o)
	local full = o.rig == "full"
	local seated = o.pose ~= "stand"
	local w, h = L.w, L.h
	local hip = seated and 0.0 or 2.55
	local torsoY = hip + h / 2 + (seated and 0.05 or 0)
	local torsoCF = cf * CF(0, torsoY, 0)
	local torso = fanPart(parent, "Fan", V3(w, h, 0.85), torsoCF, L.shirt, M.Fabric)
	torso:SetAttribute("Rig", o.rig)
	torso:SetAttribute("Style", L.style)
	torso:SetAttribute("Energy", L.energy)
	torso:SetAttribute("Pose", seated and "sit" or "stand")
	local headSize = 1.0 + (w - 1.4) * 0.25
	local headCF = cf * CF(0, torsoY + h / 2 + headSize * 0.52, 0)
	headOf(torso, L, headCF, headSize)
	local armPitch = seated and (full and 0.55 or 0.4) or 0.12
	for _, side in ipairs({ -1, 1 }) do
		local arm = fanPart(torso, side < 0 and "ArmL" or "ArmR", V3(0.42, 1.65, 0.45), armCF(torsoCF, side, w, h, armPitch, 0.1), L.style == "tee" and L.skin:Lerp(L.shirt, 0.5) or L.shirt, M.Fabric)
		arm:SetAttribute("Side", side)
	end
	if full then
		if seated then
			fanPart(torso, "Lap", V3(w * 0.92, 0.55, 1.35), cf * CF(0, 0.28, -0.6), L.pants, M.Fabric)
		else
			fanPart(torso, "Legs", V3(w * 0.8, 2.55, 0.7), cf * CF(0, 1.28, 0), L.pants, M.Fabric)
		end
		hatOf(torso, L, headCF, headSize)
		shirtPrint(torso, L)
		if L.phone then
			-- held up in the right hand (CrowdFX keeps it at the hand); the screen glows toward the ring
			local ph = fanPart(torso, "Phone", V3(0.34, 0.6, 0.07), armCF(torsoCF, 1, w, h, armPitch, 0.1) * CF(0, -0.95, -0.2), rgb(20, 20, 24), M.SmoothPlastic)
			local sg = gui(ph, FACE.Front, 60, 0, 1.6)
			frame(sg, { Size = UDim2.fromScale(0.86, 0.9), Position = UDim2.fromScale(0.07, 0.05), BackgroundColor3 = rgb(190, 215, 255) })
			torso:SetAttribute("Phone", true)
		end
	elseif L.hat and rng:NextNumber() < 0.7 then
		-- lite rigs: the cap alone (no brim)
		local kind = L.hat
		local b = blob(torso, "Hat", V3(headSize * 1.1, headSize * (kind == "beanie" and 0.7 or 0.5), headSize * 1.1), headCF * CF(0, headSize * 0.33, 0), L.hatColor, M.Fabric, FANP)
		b:SetAttribute("Kind", kind)
	end
	return torso, L
end

------------------------------------------------------------------------
-- stands
------------------------------------------------------------------------
-- the seating blocks of one row on one side: sides 0 / 2 (the walkway sides) leave the 10-stud walkway aisle in the
-- middle and own the corners; sides 1 / 3 have a 3-stud mid aisle. {x0, x1} in the side's frame (+X to the left as
-- seen from the ring)
local function blocksOf(side, d0, d1)
	if side == 0 or side == 2 then
		return { { 5, d1 }, { -d1, -5 } }
	end
	return { { 1.5, d0 }, { -d0, -1.5 } }
end

local function rowTop(spec, row)
	local h = row * spec.rowRise
	return h > 0 and h + 0.5 or 0
end

-- the chairs / seat rows of a block. kind: "ringside" (individual luxury chairs), "seats" (a cushion slab and a seat
-- back with printed dividers), "folding" (the hall's chairs, one part each)
local function seating(st, spec, rot, b, row, kind, seatsX)
	local d0 = spec.rowStart + row * spec.rowGap
	local y = rowTop(spec, row)
	local zc = d0 + spec.rowGap / 2
	local w = b[2] - b[1]
	local xc = (b[1] + b[2]) / 2
	local col = spec.seats or rgb(40, 40, 48)
	if kind == "ringside" then
		local leather = spec.tier >= 3
		local scol = leather and rgb(22, 22, 26) or (spec.tier == 2 and rgb(110, 20, 26) or rgb(70, 70, 80))
		for _, x in ipairs(seatsX) do
			local base = rot * CF(x, y, zc)
			prop(st, "ChairSeat", V3(2.2, 0.5, 2.0), base * CF(0, 0.7, 0.1), scol, leather and M.Leather or M.Fabric, { CastShadow = false })
			local back = prop(st, "ChairBack", V3(2.2, 2.3, 0.35), base * CF(0, 1.95, 1.0), scol, leather and M.Leather or M.Fabric, { CastShadow = false })
			if leather then
				-- gold piping on the big shows' ringside chairs
				local sg = gui(back, FACE.Front, 16, 1, 1)
				local f = frame(sg, { Size = UDim2.fromScale(0.86, 0.84), Position = UDim2.fromScale(0.07, 0.08), BackgroundTransparency = 1 })
				local s = Instance.new("UIStroke")
				s.Thickness = 2
				s.Color = rgb(200, 160, 40)
				s.Parent = f
			end
		end
		return
	elseif kind == "folding" then
		for _, x in ipairs(seatsX) do
			deco(st, "Chair", V3(1.8, 1.6, 1.8), rot * CF(x, y + 0.8, zc + 0.3), rgb(70, 70, 80), M.Metal, { CanCollide = false, CastShadow = false })
		end
		return
	end
	-- a block's row of fixed seats: the backs as one slab with the dividers printed on it; the cushions as a slab
	-- only on the rows with real rigs (the printed rows draw their own)
	if kind == "seats" and #seatsX > 0 then
		prop(st, "SeatRow", V3(w, 0.5, 1.5), rot * CF(xc, y + 0.7, zc + 0.2), col, M.Fabric, { CastShadow = false })
	end
	local back = prop(st, "SeatBack", V3(w, 1.6, 0.3), rot * CF(xc, y + 1.6, zc + 1.05), col, M.Fabric, { CastShadow = false })
	local sg = gui(back, FACE.Front, 8, 1, 1)
	local n = math.max(1, math.floor(w / Crowd.SEAT))
	local text = {}
	for _ = 1, n do
		table.insert(text, "▏")
	end
	local l = label(sg, { Size = UDim2.fromScale(1, 1), Text = table.concat(text, "      "), TextColor3 = col:Lerp(BLACK, 0.55), Face = "glyph", TextScaled = true })
	l.TextTransparency = 0.2
end

-- a print slab the client fills with fans: at the seats of a block
local function printRow(bowl, spec, rot, b, row, side, seed, standing)
	local d0 = spec.rowStart + row * spec.rowGap
	local y = rowTop(spec, row)
	local zc = d0 + spec.rowGap / 2 + (standing and 0.8 or 0.55)
	local w = b[2] - b[1]
	local xc = (b[1] + b[2]) / 2
	local col = (spec.seats or rgb(30, 30, 36)):Lerp(BLACK, 0.5)
	local hgt = standing and 5.2 or 3.6
	local slab = prop(bowl, "RowPrint", V3(w, hgt, 0.5), rot * CF(xc, y + (standing and 0 or 0.4) + hgt / 2, zc), col, M.Fabric, { CastShadow = false, Transparency = 1 })
	local sg = gui(slab, FACE.Front, 6, 1, 1)
	sg.Name = "CrowdPrint"
	slab:SetAttribute("CrowdCols", math.max(2, math.floor(w / Crowd.SEAT)))
	slab:SetAttribute("Seed", seed)
	slab:SetAttribute("Side", side)
	slab:SetAttribute("Row", row)
	slab:SetAttribute("RowFrac", math.clamp(row / math.max(1, spec.rows - 1), 0, 1))
	slab:SetAttribute("Standing", standing == true)
	slab:SetAttribute("Fill", 1)
	return slab
end

-- stair lights down an aisle edge: one per row step
local function stairLights(st, spec, rot, x, row)
	if spec.rowRise <= 0 or row == 0 or (spec.tier >= 4 and row % 2 == 0) then
		return
	end
	local d0 = spec.rowStart + row * spec.rowGap
	local y = rowTop(spec, row)
	prop(st, "StairLight", V3(0.5, 0.1, 0.12), rot * CF(x, y - 0.22, d0 - 0.06), rgb(90, 170, 255), M.Neon, { CastShadow = false })
end

-- a VIP box: a railed glass front, leather chairs, a drinks table, carpet and a VIP sign; fans in suits
local function vipBox(st, crowd, spec, rot, xc, row, side, rng, idx)
	local d0 = spec.rowStart + row * spec.rowGap
	local y = rowTop(spec, row)
	local zc = d0 + spec.rowGap / 2
	local bw = Crowd.VIP_SEATS * 2.4 + 1.2
	local m = Instance.new("Model")
	m.Name = "VIPBox"
	m:SetAttribute("Side", side)
	m:SetAttribute("Idx", idx)
	-- carpet and the low wall with its glass rail toward the ring
	prop(m, "VIPCarpet", V3(bw, 0.08, spec.rowGap - 0.4), rot * CF(xc, y + 0.04, zc), rgb(70, 16, 24), M.Fabric, { CastShadow = false })
	prop(m, "VIPWall", V3(bw, 1.0, 0.3), rot * CF(xc, y + 0.5, d0 + 0.3), rgb(24, 24, 28), M.Metal)
	prop(m, "VIPGlass", V3(bw, 1.6, 0.12), rot * CF(xc, y + 1.8, d0 + 0.3), rgb(160, 200, 230), M.Glass, { Transparency = 0.55, CastShadow = false })
	prop(m, "VIPRail", V3(bw + 0.2, 0.12, 0.12), rot * CF(xc, y + 2.62, d0 + 0.3), rgb(200, 160, 40), M.Metal, { CastShadow = false })
	for _, sx in ipairs({ -1, 1 }) do
		prop(m, "VIPPost", V3(0.14, 2.6, 0.14), rot * CF(xc + sx * (bw / 2 - 0.1), y + 1.3, d0 + 0.3), rgb(200, 160, 40), M.Metal, { CastShadow = false })
		-- side partitions
		prop(m, "VIPSide", V3(0.12, 2.4, spec.rowGap - 0.6), rot * CF(xc + sx * bw / 2, y + 1.2, zc), rgb(160, 200, 230), M.Glass, { Transparency = 0.6, CastShadow = false })
	end
	local wall = m:FindFirstChild("VIPWall")
	if wall then
		local sg = gui(wall, FACE.Front, 20, 0, 1.4)
		label(sg, { Size = UDim2.fromScale(0.6, 0.8), Position = UDim2.fromScale(0.2, 0.1), Text = "VIP", TextColor3 = GOLD })
	end
	-- the drinks table at the rail
	prop(m, "VIPTable", V3(1.6, 0.08, 0.8), rot * CF(xc, y + 1.1, d0 + 1.1), rgb(30, 26, 24), M.Wood, { CastShadow = false })
	prop(m, "VIPTableLeg", V3(0.12, 1.0, 0.12), rot * CF(xc, y + 0.55, d0 + 1.1), rgb(60, 60, 66), M.Metal, { CastShadow = false })
	for k = 1, 2 do
		local g = prop(m, "VIPGlassware", V3(0.22, 0.4, 0.22), rot * CF(xc + (k - 1.5) * 0.5, y + 1.34, d0 + 1.1), rgb(230, 200, 120), M.Glass, { Transparency = 0.3, CastShadow = false })
		g.Shape = Enum.PartType.Cylinder
		g.CFrame = g.CFrame * CFrame.Angles(0, 0, math.pi / 2)
	end
	-- leather chairs and their fans
	for i = 1, Crowd.VIP_SEATS do
		local x = xc + (i - (Crowd.VIP_SEATS + 1) / 2) * 2.4
		local base = rot * CF(x, y, zc + 0.6)
		prop(m, "VIPSeat", V3(2.0, 0.55, 2.0), base * CF(0, 0.75, 0), rgb(22, 22, 26), M.Leather, { CastShadow = false })
		prop(m, "VIPSeatBack", V3(2.0, 2.2, 0.4), base * CF(0, 1.9, 1.0), rgb(22, 22, 26), M.Leather, { CastShadow = false })
		if i == 1 or i == Crowd.VIP_SEATS then
			prop(m, "VIPArm", V3(0.25, 0.5, 1.6), base * CF(i == 1 and -1.1 or 1.1, 1.25, 0.2), rgb(30, 30, 34), M.Leather, { CastShadow = false })
		end
		local f = fan(crowd, base * CF(0, 1.0, 0), rng, { rig = "full", pose = "sit", dress = "vip" })
		f:SetAttribute("Row", row)
		f:SetAttribute("Side", side)
		f:SetAttribute("VIP", true)
	end
	m.Parent = st
	return bw
end

-- the MEDIA box: a glass-fronted desk row with monitors and laptops, press in it
local function mediaBox(st, crowd, spec, rot, xc, row, side, rng)
	local d0 = spec.rowStart + row * spec.rowGap
	local y = rowTop(spec, row)
	local zc = d0 + spec.rowGap / 2
	local n = spec.tier >= 4 and 5 or 4
	local bw = n * 2.4 + 1.0
	local m = Instance.new("Model")
	m.Name = "MediaBox"
	m:SetAttribute("Side", side)
	prop(m, "MediaDesk", V3(bw, 0.18, 1.6), rot * CF(xc, y + 2.2, d0 + 1.2), rgb(36, 36, 40), M.Metal)
	prop(m, "MediaDeskFront", V3(bw, 2.2, 0.15), rot * CF(xc, y + 1.1, d0 + 0.45), rgb(16, 16, 20), M.SmoothPlastic)
	local front = m:FindFirstChild("MediaDeskFront")
	if front then
		local sg = gui(front, FACE.Front, 14, 0, 1.4)
		frame(sg, { Size = UDim2.fromScale(1, 0.26), Position = UDim2.fromScale(0, 0.37), BackgroundColor3 = rgb(150, 16, 24) })
		label(sg, { Size = UDim2.fromScale(0.9, 0.24), Position = UDim2.fromScale(0.05, 0.38), Text = "MEDIA  -  WCB SPORTS  -  MEDIA", TextColor3 = WHITE })
	end
	prop(m, "MediaGlass", V3(bw, 1.2, 0.1), rot * CF(xc, y + 2.9, d0 + 0.45), rgb(160, 200, 230), M.Glass, { Transparency = 0.55, CastShadow = false })
	for i = 1, n do
		local x = xc + (i - (n + 1) / 2) * 2.4
		local base = rot * CF(x, y, zc + 0.9)
		prop(m, "MediaChair", V3(1.7, 0.4, 1.6), base * CF(0, 0.7, 0), rgb(30, 30, 34), M.Fabric, { CastShadow = false })
		prop(m, "MediaChairBack", V3(1.7, 1.8, 0.25), base * CF(0, 1.7, 0.75), rgb(30, 30, 34), M.Fabric, { CastShadow = false })
		-- a laptop (lid glow) at every seat, a monitor on a stand every other
		prop(m, "LaptopBase", V3(1.2, 0.06, 0.85), rot * CF(x, y + 2.32, d0 + 1.3), rgb(40, 40, 44), M.Metal, { CastShadow = false })
		local lid = prop(m, "Laptop", V3(1.2, 0.8, 0.05), rot * CF(x, y + 2.7, d0 + 0.9) * CFrame.Angles(math.rad(15), 0, 0), rgb(40, 40, 44), M.Metal, { CastShadow = false })
		local sg = gui(lid, FACE.Back, 40, 0, 1.2)
		frame(sg, { Size = UDim2.fromScale(0.92, 0.88), Position = UDim2.fromScale(0.04, 0.06), BackgroundColor3 = rgb(150, 190, 255) })
		if i % 2 == 1 then
			local mon = prop(m, "Monitor", V3(1.5, 0.95, 0.1), rot * CF(x + 1.2, y + 3.4, d0 + 0.75), rgb(20, 20, 22), M.Metal, { CastShadow = false })
			local ms = gui(mon, FACE.Back, 30, 0, 1.2)
			frame(ms, { Size = UDim2.fromScale(0.94, 0.9), Position = UDim2.fromScale(0.03, 0.05), BackgroundColor3 = rgb(40, 90, 60) })
			prop(m, "MonitorStand", V3(0.2, 0.5, 0.2), rot * CF(x + 1.2, y + 2.55, d0 + 0.8), rgb(40, 40, 44), M.Metal, { CastShadow = false })
		end
		local f = fan(crowd, base * CF(0, 0.9, 0), rng, { rig = "lite", pose = "sit", dress = "press" })
		f:SetAttribute("Row", row)
		f:SetAttribute("Side", side)
		f:SetAttribute("Press", true)
	end
	m.Parent = st
	return bw
end

-- a broadcast camera on a railed riser at the stands (a kit camera when Venues passes one)
local function cameraPlatform(st, spec, rot, x, row, kit, rng, idx)
	local d0 = spec.rowStart + row * spec.rowGap
	local y = rowTop(spec, row)
	local zc = d0 + spec.rowGap / 2
	local m = Instance.new("Model")
	m.Name = "CamPlatform"
	local ph = 1.6
	prop(m, "CamRiser", V3(4.2, ph, 4.2), rot * CF(x, y + ph / 2, zc), rgb(30, 30, 34), M.DiamondPlate)
	for _, sx in ipairs({ -1, 1 }) do
		prop(m, "CamRailPost", V3(0.12, 2.6, 0.12), rot * CF(x + sx * 2.0, y + ph + 1.3, zc - 2.0), rgb(150, 150, 156), M.Metal, { CastShadow = false })
		prop(m, "CamRailPost", V3(0.12, 2.6, 0.12), rot * CF(x + sx * 2.0, y + ph + 1.3, zc + 2.0), rgb(150, 150, 156), M.Metal, { CastShadow = false })
		prop(m, "CamRail", V3(0.12, 0.12, 4.1), rot * CF(x + sx * 2.0, y + ph + 2.55, zc), rgb(150, 150, 156), M.Metal, { CastShadow = false })
	end
	prop(m, "CamRail", V3(4.1, 0.12, 0.12), rot * CF(x, y + ph + 2.55, zc + 2.0), rgb(150, 150, 156), M.Metal, { CastShadow = false })
	prop(m, "CamRail", V3(4.1, 0.12, 0.12), rot * CF(x, y + ph + 1.3, zc - 2.0), rgb(150, 150, 156), M.Metal, { CastShadow = false })
	local sgp = m:FindFirstChild("CamRiser")
	if sgp then
		local sg = gui(sgp, FACE.Front, 12, 1, 1)
		label(sg, { Size = UDim2.fromScale(0.9, 0.6), Position = UDim2.fromScale(0.05, 0.2), Text = "CAM " .. tostring(idx), TextColor3 = WHITE, Face = "signSub" })
	end
	local pos = (rot * CF(x, y + ph, zc)).Position
	if kit and kit.tvCamera then
		kit.tvCamera(m, pos, V3(0, spec.ringH + 3, 0), rng, 10 + idx)
	else
		prop(m, "TVCamera", V3(1.4, 1.4, 3), CFrame.lookAt(pos + V3(0, 5.6, 0), V3(0, spec.ringH + 3, 0)), rgb(25, 25, 28), M.Metal)
	end
	m.Parent = st
end

-- the photographers' pit at the apron: kneeling figures with cameras, flashes come from VenueFX
local function photographers(st, crowd, spec, rng, kit)
	local half = spec.half
	local E = half + 3.2
	local n = spec.tier >= 3 and 4 or (spec.tier == 2 and 3 or 1)
	for _, z in ipairs({ -1, 1 }) do
		for i = 1, n do
			-- beside the walkway rail (x < -4.5), short of the stool corner (x > -(half + 2.8))
			local x = -(5.0 + (i - 1) * 2.5)
			if x > -(half + 2.6) then
				local pos = V3(x, 0, z * (E + 1.4))
				local cf = CFrame.lookAt(pos, V3(x, 0, 0))
				-- a kneeling photographer: a low full rig (seated pose on the floor), a camera at the eye
				local f = fan(crowd, cf * CF(0, 0.5, 0), rng, { rig = "full", pose = "sit", dress = "press" })
				f:SetAttribute("Row", -1)
				f:SetAttribute("Side", z < 0 and 0 or 2)
				f:SetAttribute("Press", true)
				f:SetAttribute("Photographer", true)
				local head = f:FindFirstChild("Head")
				if head then
					local cam = fanPart(f, "Camera", V3(0.5, 0.35, 0.45), head.CFrame * CF(0.1, -0.1, -0.55), rgb(20, 20, 22), M.Metal)
					local lens = fanPart(f, "CameraLens", V3(0.7, 0.3, 0.3), cam.CFrame * CF(0, 0, -0.5) * CFrame.Angles(0, math.pi / 2, 0), rgb(15, 15, 18), M.Metal)
					lens.Shape = Enum.PartType.Cylinder
				end
			end
		end
		-- the PRESS tape along the pit
		if n > 1 then
			local len = (n - 1) * 2.5 + 3
			local tape = prop(st, "PressTape", V3(len, 0.25, 0.04), CF(-(5.0 + (n - 1) * 1.25), 2.0, z * (E + 3.0)), rgb(240, 200, 40), M.Fabric, { CastShadow = false })
			local sg = gui(tape, z < 0 and FACE.Back or FACE.Front, 24, 1, 1)
			label(sg, { Size = UDim2.fromScale(1, 1), Text = "PRESS  -  PRESS  -  PRESS", TextColor3 = BLACK, Face = "signSub" })
			for _, sx in ipairs({ -1, 1 }) do
				prop(st, "PressTapePost", V3(0.12, 2.1, 0.12), CF(-(5.0 + (n - 1) * 1.25) + sx * len / 2, 1.05, z * (E + 3.0)), rgb(60, 60, 66), M.Metal, { CastShadow = false })
			end
		end
	end
	local _ = kit
end

-- sponsor boards on a fascia: the venue's ads, alternating colours
local function sponsorBoard(st, spec, rot, b, row, k)
	local d0 = spec.rowStart + row * spec.rowGap
	local y = rowTop(spec, row)
	local w = b[2] - b[1]
	local xc = (b[1] + b[2]) / 2
	local ads = spec.ads or { "WCB SPORTS" }
	local text = ads[(k - 1) % #ads + 1]
	local dark = k % 2 == 0
	local board = prop(st, "SponsorBoard", V3(w, 0.9, 0.12), rot * CF(xc, y - 0.7, d0 - 0.1), dark and BLACK or rgb(150, 16, 24), M.SmoothPlastic, { CastShadow = false })
	local sg = gui(board, FACE.Front, 12, spec.tier >= 3 and 0.2 or 1, 1.2)
	label(sg, { Size = UDim2.fromScale(0.96, 0.8), Position = UDim2.fromScale(0.02, 0.1), Text = text .. "   -   " .. text .. "   -   " .. text, TextColor3 = dark and GOLD or WHITE })
end

------------------------------------------------------------------------
-- the upper bowl (Arena / Stadium): one slab per side, rows of RichText fans drawn by CrowdFX
------------------------------------------------------------------------
local function buildBowl(arena, spec, bowl)
	local S = spec.size
	local R0 = spec.rowStart + spec.rows * spec.rowGap + 1
	local y0 = (spec.rows - 1) * spec.rowRise + 3.5
	local R1 = S / 2 - 3
	local y1 = math.min(spec.height - 10, y0 + (R1 - R0) * 0.72)
	spec.bowlTop = y1
	local dR, dy = R1 - R0, y1 - y0
	local slopeLen = math.sqrt(dR * dR + dy * dy)
	local width = R0 + R1
	local nRows = math.clamp(math.floor(slopeLen / 2.6), 10, 26)
	for side = 0, 3 do
		local a = side * math.pi / 2
		local o = V3(math.sin(a), 0, math.cos(a))
		local mid = o * ((R0 + R1) / 2) + V3(0, (y0 + y1) / 2, 0)
		local s = (o * dR + V3(0, dy, 0)).Unit
		local n = (-o * dy + V3(0, dR, 0)).Unit
		local zAxis = -n
		local xAxis = s:Cross(zAxis)
		local slab = prop(bowl, "BowlTier", V3(width, slopeLen, 1.2), CFrame.fromMatrix(mid, xAxis, s, zAxis), spec.seats or rgb(30, 30, 36), M.Fabric, { CastShadow = false })
		local sg = gui(slab, FACE.Front, 4, 1, 1)
		sg.Name = "CrowdPrint"
		frame(sg, { Name = "Seats", Size = UDim2.fromScale(1, 1), BackgroundColor3 = (spec.seats or rgb(30, 30, 36)):Lerp(Color3.new(), 0.35) })
		slab:SetAttribute("CrowdRows", nRows)
		slab:SetAttribute("Fill", 1)
		slab:SetAttribute("Side", side)
		slab:SetAttribute("Seed", 100 + side)
		for i = 1, nRows - 1, 2 do
			frame(sg, { Name = "SeatLine", Size = UDim2.fromScale(1, 0.18 / nRows), Position = UDim2.fromScale(0, i / nRows), BackgroundColor3 = rgb(10, 10, 12), BackgroundTransparency = 0.5 })
		end
		for _, ax in ipairs({ 0.2, 0.4, 0.6, 0.8 }) do
			frame(sg, { Name = "Aisle", Size = UDim2.fromScale(0.012, 1), Position = UDim2.fromScale(ax, 0), BackgroundColor3 = rgb(70, 70, 76) })
		end
		-- the bowl's front fascia carries a ring of LED (VenueFX drives it) over a sponsor line
		local fascia = prop(bowl, "LEDRibbon", V3(width * (R0 / ((R0 + R1) / 2)) * 0.98, 1.6, 0.3), CFrame.lookAt(o * (R0 - 0.4) + V3(0, y0 - 0.3, 0), V3(0, y0 - 0.3, 0)), BLACK, M.SmoothPlastic, { CastShadow = false })
		fascia:SetAttribute("Upper", true)
	end
	local _ = arena
end

------------------------------------------------------------------------
-- Build
------------------------------------------------------------------------
-- kit (optional): { tvCamera = fn(parent, pos, target, rng, idx) } from Venues
function Crowd.Build(arena, spec, kit)
	if (spec.rows or 0) <= 0 then
		return nil
	end
	local rng = Random.new(spec.size * 7 + spec.tier * 131)
	local crowd = Instance.new("Folder")
	crowd.Name = "Crowd"
	crowd.Parent = arena
	local stands = Instance.new("Folder")
	stands.Name = "Stands"
	stands.Parent = arena
	local bowl = Instance.new("Folder")
	bowl.Name = "Bowl"
	bowl.Parent = arena
	local physRows = Crowd.PHYSICAL_ROWS[spec.tier] or 2
	local vipRow = spec.tier >= 2 and math.min(spec.rows - 1, 2) or nil
	local stepColor = spec.chairs and rgb(60, 60, 70) or rgb(35, 35, 42)
	local seed = 0
	local camIdx = 0
	for side = 0, 3 do
		local rot = CFrame.Angles(0, side * math.pi / 2, 0)
		for row = 0, spec.rows - 1 do
			local d0 = spec.rowStart + row * spec.rowGap
			local d1 = d0 + spec.rowGap
			local h = row * spec.rowRise
			local y = rowTop(spec, row)
			local blocks = blocksOf(side, d0, d1)
			for bi, b in ipairs(blocks) do
				local w = b[2] - b[1]
				local xc = (b[1] + b[2]) / 2
				-- the stand: a block whose top is the tread (a riser face toward the ring)
				if h > 0 then
					deco(stands, "Stand", V3(w, h + 0.5, spec.rowGap), rot * CF(xc, (h + 0.5) / 2, d0 + spec.rowGap / 2), stepColor, M.Concrete)
				elseif spec.tier >= 2 then
					-- the ringside row stands on a low riser so its chairs read over the barrier
					deco(stands, "Stand", V3(w, 0.5, spec.rowGap), rot * CF(xc, 0.25, d0 + spec.rowGap / 2), stepColor, M.Concrete)
				end
				-- stair lights on the block's aisle edges
				local aisleX = (side == 0 or side == 2) and (bi == 1 and b[1] + 0.35 or b[2] - 0.35) or (bi == 1 and b[1] + 0.35 or b[2] - 0.35)
				stairLights(stands, spec, rot, aisleX, row)
				-- seats
				local seatsX = {}
				local n = math.floor(w / (row < physRows and Crowd.RIG_SEAT or Crowd.SEAT))
				for i = 1, n do
					table.insert(seatsX, b[1] + (i - 0.5) * (w / n))
				end
				local reserved = {} -- x ranges of this block's row taken by a box / platform
				if row == vipRow and (side == 1 or side == 3) then
					local nBoxes = spec.tier >= 4 and 2 or 1
					for k = 1, nBoxes do
						local bx = nBoxes == 1 and xc or (b[1] + w * (k - 0.5) / nBoxes)
						local bw = vipBox(stands, crowd, spec, rot, bx, row, side, rng, (side * 10 + bi * 2 + k))
						table.insert(reserved, { bx - bw / 2, bx + bw / 2 })
					end
				end
				if spec.tier >= 2 and row == vipRow and (side == 0 or side == 2) and bi == 1 and spec.tier >= 3 then
					local bw = mediaBox(stands, crowd, spec, rot, b[1] + 8, row, side, rng)
					table.insert(reserved, { b[1] + 8 - bw / 2, b[1] + 8 + bw / 2 })
				end
				if spec.tier >= 2 and row == vipRow and (side == 1 or side == 3) and bi == 2 and (spec.tier >= 3 or side == 1) then
					camIdx += 1
					cameraPlatform(stands, spec, rot, b[1] + 2.6, row, kit, rng, camIdx)
					table.insert(reserved, { b[1], b[1] + 5 })
				end
				if spec.tier >= 2 and row == vipRow and (side == 0 or side == 2) and bi == 2 and spec.tier >= 3 then
					camIdx += 1
					cameraPlatform(stands, spec, rot, b[2] - 2.6, row, kit, rng, camIdx)
					table.insert(reserved, { b[2] - 5, b[2] })
				end
				local free = {}
				for _, x in ipairs(seatsX) do
					local taken = false
					for _, r in ipairs(reserved) do
						if x > r[1] - 0.8 and x < r[2] + 0.8 then
							taken = true
						end
					end
					if not taken then
						table.insert(free, x)
					end
				end
				if row < physRows then
					-- real rigs
					local kind = row == 0 and (spec.chairs and "folding" or "ringside") or (spec.chairs and "folding" or "seats")
					seating(stands, spec, rot, b, row, kind, free)
					local seatTop = y + (kind == "ringside" and 0.95 or (kind == "folding" and 1.6 or 0.95))
					for _, x in ipairs(free) do
						local base = rot * CF(x, seatTop, d0 + spec.rowGap / 2 + 0.3)
						local f = fan(crowd, base, rng, { rig = row == 0 and "full" or "lite", pose = "sit", dress = row == 0 and spec.tier >= 2 and "ringside" or nil })
						f:SetAttribute("Row", row)
						f:SetAttribute("Side", side)
						f:SetAttribute("Seat", x)
					end
				else
					-- a printed row at the seats (the slab is the row; its fans are drawn client-side)
					if #free >= 2 then
						seed += 1
						if #reserved == 0 then
							printRow(bowl, spec, rot, b, row, side, seed, false)
							seating(stands, spec, rot, b, row, spec.chairs and "folding" or "seats", spec.chairs and free or {})
						else
							-- around the boxes: a print slab per free span
							local spans = {}
							local x0 = b[1]
							table.sort(reserved, function(p, q)
								return p[1] < q[1]
							end)
							for _, r in ipairs(reserved) do
								if r[1] - x0 >= Crowd.SEAT * 2 then
									table.insert(spans, { x0, r[1] })
								end
								x0 = math.max(x0, r[2])
							end
							if b[2] - x0 >= Crowd.SEAT * 2 then
								table.insert(spans, { x0, b[2] })
							end
							for _, sp in ipairs(spans) do
								seed += 1
								printRow(bowl, spec, rot, sp, row, side, seed, false)
								seating(stands, spec, rot, sp, row, "seats", {})
							end
						end
					end
					if row == physRows and spec.tier >= 2 then
						sponsorBoard(stands, spec, rot, b, row, side * 2 + bi)
					end
				end
			end
		end
		-- the standing-room rail at the top of the stands (packed houses only: Crowd.Apply / CrowdFX)
		if spec.tier >= 2 then
			local row = spec.rows
			local d0 = spec.rowStart + row * spec.rowGap
			local y = rowTop(spec, row - 1) + (spec.rowRise > 0 and spec.rowRise or 0)
			local blocks = blocksOf(side, d0, d0 + 2.5)
			for bi, b in ipairs(blocks) do
				local w = b[2] - b[1]
				local xc = (b[1] + b[2]) / 2
				deco(stands, "StandTop", V3(w, y + 0.5, 3.0), rot * CF(xc, (y + 0.5) / 2, d0 + 1.5), stepColor, M.Concrete)
				prop(stands, "StandRail", V3(w, 0.12, 0.12), rot * CF(xc, y + 3.3, d0 + 0.2), rgb(150, 150, 156), M.Metal, { CastShadow = false })
				seed += 1
				local slab = printRow(bowl, spec, rot, { b[1], b[2] }, row, side, seed, true)
				slab:SetAttribute("Standing", true)
				local _ = bi
			end
		end
		-- the aisle standers (packed houses): on the mid aisle steps of the walkway-free sides
		if spec.tier >= 2 and (side == 1 or side == 3) then
			for k = 1, math.min(3, spec.rows - physRows) do
				local row = physRows + k - 1
				local d0 = spec.rowStart + row * spec.rowGap
				local y = rowTop(spec, row)
				local base = rot * CF((k % 2 == 0 and 0.7 or -0.7), y, d0 + spec.rowGap * 0.5)
				local f = fan(crowd, base, rng, { rig = "full", pose = "stand" })
				f:SetAttribute("Row", row)
				f:SetAttribute("Side", side)
				f:SetAttribute("Standing", true)
			end
		end
	end
	-- the hall: standers along the back wall by the door, a bleacher print at the back of each side
	if spec.tier == 1 then
		local S = spec.size
		for k = 1, 6 do
			local x = -S / 2 + 10 + k * 5
			local f = fan(crowd, CFrame.lookAt(V3(x, 0, S / 2 - 6), V3(x, 0, 0)), rng, { rig = "full", pose = "stand" })
			f:SetAttribute("Row", spec.rows)
			f:SetAttribute("Side", 0)
			f:SetAttribute("Standing", true)
		end
	end
	if spec.bowl then
		buildBowl(arena, spec, bowl)
	end
	photographers(stands, crowd, spec, rng, kit)
	-- the fascia LED ribbon at the back of the physical rows (big shows)
	if spec.tier >= 3 then
		for side = 0, 3 do
			local rot = CFrame.Angles(0, side * math.pi / 2, 0)
			local row = physRows
			local d0 = spec.rowStart + row * spec.rowGap
			local y = rowTop(spec, row)
			for _, b in ipairs(blocksOf(side, d0, d0 + spec.rowGap)) do
				local w = b[2] - b[1]
				local xc = (b[1] + b[2]) / 2
				local led = prop(stands, "LEDRibbon", V3(w - 0.4, 0.5, 0.14), rot * CF(xc, y - 0.1, d0 - 0.2), BLACK, M.SmoothPlastic, { CastShadow = false })
				led:SetAttribute("Upper", false)
			end
		end
	end
	return crowd
end

------------------------------------------------------------------------
-- Apply: the night's house
------------------------------------------------------------------------
-- how much of a row fills at a given share of the house: the best seats sell first (the front rows fill before the
-- back ones; a 0.5 house seats 0.7 of row 0 and 0.3 of the back row). The standing room only opens when it is packed
function Crowd.RowFill(share, rowFrac, standing)
	share = math.clamp(tonumber(share) or 1, 0, 1)
	if standing then
		return math.clamp((share - 0.88) / 0.12, 0, 1)
	end
	if share >= 1 then
		return 1
	end
	return math.clamp(share ^ (0.5 + math.clamp(rowFrac or 0, 0, 1) * 1.3), 0, 1)
end

local SIGN_TEXTS = { "GO %s!", "%s #1", "%s TIME", "WE LOVE %s", "%s!!!", "TEAM %s", "%s KO" }
local SIGN_COLORS = { { 250, 250, 245 }, { 255, 220, 60 }, { 250, 250, 245 }, { 240, 110, 110 } }

local function fanSign(f, text, k)
	local s = prop(f, "FanSign", V3(2.4, 1.4, 0.08), f.CFrame * CF(0, 2.2, -0.35), c3(SIGN_COLORS[(k - 1) % #SIGN_COLORS + 1]), M.SmoothPlastic, { CastShadow = false, CanCollide = false, CanQuery = false, CanTouch = false })
	for _, face in ipairs({ FACE.Front, FACE.Back }) do
		local sg = gui(s, face, 30, 1, 1)
		label(sg, { Size = UDim2.fromScale(0.92, 0.8), Position = UDim2.fromScale(0.04, 0.1), Text = text, TextColor3 = rgb(190, 20, 26), Face = "marker" })
	end
	return s
end

function Crowd.Apply(arena, spec, share, supporters, nick, seed)
	local crowd = arena:FindFirstChild("Crowd")
	if not crowd then
		return
	end
	local rng = Random.new(seed or 1)
	local keep = math.clamp(tonumber(share) or 1, 0, 1)
	local rows = math.max(1, (spec.rows or 1) - 1)
	local fans = {}
	for _, f in ipairs(crowd:GetChildren()) do
		if f.Name == "Fan" and f:IsA("BasePart") then
			local row = tonumber(f:GetAttribute("Row")) or 0
			local p
			if f:GetAttribute("Press") or f:GetAttribute("Photographer") then
				p = 1
			elseif f:GetAttribute("VIP") then
				p = keep >= 0.9 and 1 or 0.55 + keep * 0.4
			elseif f:GetAttribute("Standing") then
				p = Crowd.RowFill(keep, 0, true)
			else
				p = Crowd.RowFill(keep, row / rows, false)
			end
			if rng:NextNumber() < p then
				table.insert(fans, f)
			else
				f:Destroy()
			end
		end
	end
	arena:SetAttribute("CrowdShare", math.floor(keep * 100) / 100)
	local sup = math.clamp(tonumber(supporters) or 0, 0, 1)
	-- who they are for: the player's supporters bunch up on the red side (z < 0, the red tunnel's side); among the
	-- rest a few are the opponent's (they boo when he is hurt) and most cheer whoever lands
	local reds = { rgb(200, 25, 30), rgb(170, 20, 26), rgb(230, 50, 50), rgb(240, 240, 240) }
	local supporterList = {}
	for _, f in ipairs(fans) do
		if f:GetAttribute("Press") or f:GetAttribute("Photographer") then
			f:SetAttribute("Fav", 0)
		else
			local z = f.Position.Z
			local p = sup * (z < 0 and 0.85 or 0.25)
			if rng:NextNumber() < p then
				f.Color = reds[rng:NextInteger(1, #reds)]
				for _, arm in ipairs(f:GetChildren()) do
					if (arm.Name == "ArmL" or arm.Name == "ArmR") and f:GetAttribute("Style") ~= "tee" then
						arm.Color = f.Color
					end
				end
				local pr = f:FindFirstChild("Print")
				if pr then
					pr:Destroy()
				end
				f:SetAttribute("Supporter", true)
				f:SetAttribute("Fav", 1)
				table.insert(supporterList, f)
			else
				f:SetAttribute("Fav", rng:NextNumber() < 0.22 and -1 or 0)
			end
		end
	end
	if #supporterList == 0 then
		return
	end
	-- signs in the camera rows: the front rows first
	table.sort(supporterList, function(a, b)
		return (tonumber(a:GetAttribute("Row")) or 0) < (tonumber(b:GetAttribute("Row")) or 0)
	end)
	local who = (type(nick) == "string" and nick ~= "") and string.upper(nick) or "RED CORNER"
	local signs = math.min(#supporterList, math.floor(2 + sup * 12))
	for i = 1, signs do
		local idx = math.min(#supporterList, 1 + rng:NextInteger(0, math.min(#supporterList - 1, 6)))
		local f = table.remove(supporterList, idx)
		fanSign(f, string.format(SIGN_TEXTS[(i - 1) % #SIGN_TEXTS + 1], who), i)
		f:SetAttribute("Sign", true)
	end
	-- a banner on the barrier (or the first row's riser) on the red side when the fans came in numbers
	if sup >= 0.3 and spec.rows > 0 then
		local rb = spec.rowStart - 0.6
		local len = math.min(18, rb - 8)
		for k, sx in ipairs({ -1, 1 }) do
			if k == 1 or sup >= 0.6 then
				local x = sx * (6 + len / 2)
				local pos = V3(x, 2.2 + (spec.tier >= 3 and 0.6 or 0), -(rb + 0.45))
				local b = prop(arena, "FanBanner", V3(len, 2.0, 0.08), CFrame.lookAt(pos, V3(x, pos.Y, 0)), k == 1 and rgb(250, 250, 245) or rgb(200, 25, 30), M.Fabric, { CastShadow = false })
				local sg = gui(b, FACE.Front, 16, 1, 1)
				label(sg, { Size = UDim2.fromScale(0.94, 0.8), Position = UDim2.fromScale(0.03, 0.1), Text = (k == 1 and "%s ARMY" or "GO %s GO"):format(who), TextColor3 = k == 1 and rgb(190, 20, 26) or WHITE, Face = "marker" })
			end
		end
	end
end

------------------------------------------------------------------------
-- React: the server's hook for crowd reactions (FightEngine may call it; the fighting client's VenueFX already
-- forwards its own phases to CrowdFX, so this reaches every other client watching the venue)
------------------------------------------------------------------------
-- event: "bigpunch" | "knockdown" | "count" | "getup" | "roundstart" | "roundend" | "bell" | "ko" | "winner" |
--        "entrance" | "boo" | "cheer";  data = { who = "you" | "opp", n = count, result = "win" | "loss" | "draw" }
local seq = 0
function Crowd.React(arena, event, data)
	if arena == nil or type(event) ~= "string" then
		return
	end
	data = type(data) == "table" and data or {}
	seq += 1
	arena:SetAttribute("CrowdReact", string.format("%s|%s|%s|%d", event, tostring(data.who or ""), tostring(data.result or data.n or ""), seq))
end

-- counts for tests and the report: fans by rig, print slabs, parts in Crowd + Stands + Bowl
function Crowd.Counts(arena)
	local out = { full = 0, lite = 0, fans = 0, vip = 0, standing = 0, press = 0, signs = 0, prints = 0, bowlTiers = 0, parts = 0, instances = 0 }
	for _, fn in ipairs({ "Crowd", "Stands", "Bowl" }) do
		local f = arena:FindFirstChild(fn)
		if f then
			for _, d in ipairs(f:GetDescendants()) do
				out.instances += 1
				if d:IsA("BasePart") then
					out.parts += 1
					if d.Name == "Fan" then
						out.fans += 1
						out[d:GetAttribute("Rig") == "full" and "full" or "lite"] += 1
						if d:GetAttribute("VIP") then
							out.vip += 1
						end
						if d:GetAttribute("Standing") then
							out.standing += 1
						end
						if d:GetAttribute("Press") then
							out.press += 1
						end
					elseif d.Name == "FanSign" then
						out.signs += 1
					elseif d.Name == "RowPrint" then
						out.prints += 1
					elseif d.Name == "BowlTier" then
						out.bowlTiers += 1
					end
				end
			end
		end
	end
	return out
end

return Crowd
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="96">
        <Properties>
          <string name="Name">DataManager</string>
          <string name="Source"><![CDATA[-- DataManager: loads/saves each player's career with DataStoreService.
-- If Studio API access is off, the game still runs (progress lasts for the session only).
-- Old-version saves start a fresh career but keep the list of past careers.
-- Saves of the current version are brought up to date in place by Training.Migrate
-- (new fields are added, never removed): Config.DataVersion must not be bumped for additions.
--
-- Save safety: a career is only ever WRITTEN after it was READ successfully (or found empty). When the
-- store fails at join, the player has no profile (the client stays on its loading screen), the read is
-- retried in the background, and after about two minutes of failures the player is kicked with a clear
-- message. A blank placeholder can therefore never overwrite a real career. Every write carries a save
-- counter (saveSeq): a server whose copy is older than the stored one (another server saved since)
-- refuses to write instead of rolling the career back. The counter this server holds only moves after a
-- write is confirmed, and each write is stamped with this session's id (saveSession) so overlapping saves
-- of one session never refuse each other. Failed writes are retried with backoff.
--
-- Session lock: the stored value also carries `lock = { job, at }`, the server playing the career and the
-- time of its last save. The load is an UpdateAsync that takes the lock in the same step it reads, and it
-- leaves the value untouched while another server's lock is fresh: a player who hops servers while the
-- previous server is still retrying their leave save waits on the loading screen (polling) until that save
-- lands (the leave save clears the lock) instead of playing a copy that would later be refused. A lock that
-- never clears (the previous server died) is taken over after LOCK_WAIT, and one older than LOCK_TTL is dead
-- and ignored outright. Every save refreshes the lock, and a lock-only heartbeat keeps it fresh while a player
-- goes minutes without a save (Main's autosave skips busy players: a pro fight runs up to ~13 minutes); the
-- leave save and the shutdown saves clear it, and so does a server whose player left before playing the
-- career it read (gave up on the loading screen), so the next server never waits for a lock nobody uses.
-- The leave save is the session's last write: once it is under way no other save of the player is sent (a
-- write retry, the 15 s retry of a failed save, a late Save from Main; the leave save stores the same
-- profile). A save sent before it but served during or after it never takes the lock back: it leaves the lock
-- as it is while the leave is under way, clears it once the session here is over, and stores nothing once the
-- next server has taken the career (a save counter moved under that server would get its first save refused).
-- Should a newer save still land after this server read the career (the previous server's write stuck for
-- longer than the wait), the refused save re-reads the stored copy and the player plays on from it (only
-- what was done here since the join is lost) rather than being kicked; the kick stays as the last resort. A
-- save of the dropped copy that was still retrying never writes it over the newer one.
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Config = require(ReplicatedStorage.Shared.Config)
local Training = require(script.Parent:WaitForChild("Training"))
-- (the AI world's heights: an older save's boxers get theirs, World.MigrateHeights)
local World = require(script.Parent:WaitForChild("World"))
-- the first-time tutorial's flag rules (optional: an older Shared folder still loads careers)
local Tutorial
do
	local m = ReplicatedStorage.Shared:FindFirstChild("Tutorial")
	local ok, mod = false, nil
	if m then
		ok, mod = pcall(require, m)
	end
	Tutorial = (ok and type(mod) == "table") and mod or nil
end

local DataManager = {}
DataManager.Profiles = {}
DataManager.StoreAvailable = true
-- set by Main: called (in its own thread) when a load that failed at join finally succeeds
DataManager.OnLoaded = nil
-- optional, set by Main: called instead of OnLoaded when a refused save replaced the profile with the
-- newer stored copy (push the new state and tell the player); falls back to OnLoaded
DataManager.OnRefreshed = nil
local lastSave = {}
local pending = {}
local canSave = {} -- player -> true once the stored career was read (or found empty)
local loadFailed = {} -- player -> true while the read keeps failing (no profile, retrying)
local seqOf = {} -- player -> save counter of the copy this server holds (only raised after a write lands)
local session = {} -- player -> id stamped on this server's writes (overlapping saves of one session never conflict)
local dirty = {} -- player -> true after a failed write (the next autosave must not be skipped)
local releasing = {} -- userId -> true while the leave save is in flight (a quick rejoin waits for it)
local joinedAt = {} -- player -> os.clock() of the join (how long a load may wait for another server's lock)
local lockAt = {} -- player -> os.clock() of this server's last stored lock for the career (load, save, heartbeat)
local beating = {} -- player -> true while a heartbeat write is in flight
local closing = false -- true once the server is shutting down (the shutdown saves hand the careers over)

local LOAD_TRIES = 3 -- quick attempts during the join
local RETRY_DELAYS = { 5, 10, 15, 20, 30, 40 } -- background re-reads before giving up (2 minutes)
local SAVE_BACKOFF = { 1, 2, 4 } -- waits between write attempts (4 attempts)
local RELEASE_BUDGET = 20 -- seconds a leave save keeps retrying
local LOCK_TTL = 180 -- s: a lock last refreshed longer ago belongs to a dead server (see LOCK_BEAT)
-- s without a lock write before the heartbeat refreshes it: just over Main's 2-minute autosave, so a player
-- who is saved regularly costs no extra write; a live lock is then at most ~135 s old, and a failed beat is
-- retried every BEAT_RETRY s (twice before the lock would pass LOCK_TTL)
local LOCK_BEAT = 130
local BEAT_CHECK = 5 -- s between the heartbeat's looks at the players
local BEAT_RETRY = 15
local LOCK_WAIT = RELEASE_BUDGET + 10 -- s a join waits for another server's fresh lock (its leave save, retries included)
local LOCK_POLL = 3 -- s between the polls of a held lock
local SIZE_WARN = 3 * 1024 * 1024 -- bytes: a career this big is heading for the 4 MB DataStore limit
local LOAD_FAIL_KICK = "We couldn't load your saved career (Roblox's data servers are not responding). Nothing was lost - please rejoin in a minute."
local CONFLICT_KICK = "Your career was saved from another server. Please rejoin to continue with the latest save."

-- this server's name in the locks (Studio and the test runner have no JobId)
local SERVER_ID = type(game.JobId) == "string" and game.JobId ~= "" and game.JobId or HttpService:GenerateGUID(false)

local store
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		DataManager.StoreAvailable = false
		warn("[Boxer] DataStore unavailable (enable Studio API access to save):", result)
	end
end

local function keyOf(player)
	return "u_" .. player.UserId
end

local function seqField(data)
	return type(data) == "table" and tonumber(data.saveSeq) or 0
end

-- is this lock another live server's? (our own lock is simply re-taken: a quick rejoin here, or a leave save
-- that never landed)
local function heldElsewhere(lock, now)
	return type(lock) == "table" and lock.job ~= SERVER_ID and now - (tonumber(lock.at) or 0) < LOCK_TTL
end

function DataManager.Blank(pastCareers)
	return { v = Config.DataVersion, created = false, pastCareers = pastCareers or {} }
end

-- stored value -> playable profile (blank, old version, migration)
local function prepare(data)
	local stored = data
	if type(data) ~= "table" then
		data = DataManager.Blank()
	elseif data.v ~= Config.DataVersion then
		-- a save from an older version of the game: keep the hall of past careers
		data = DataManager.Blank(type(data.pastCareers) == "table" and data.pastCareers or {})
	end
	if type(data.pastCareers) ~= "table" then
		data.pastCareers = {}
	end
	if data.created then
		-- additive backfill (sub-muscles, soreness, face damage, medicine ball station, v2 looks...);
		-- a bug here must never cost a player the career, so it is guarded and the save kept as is
		local ok, err = pcall(Training.Migrate, data)
		if not ok then
			warn("[Boxer] Save migration failed, career loaded unchanged:", err)
		end
		-- the world's boxers from before the varied heights (every one within a few inches of 5'10"): their
		-- deterministic heights and a really tall one's nickname, once (World.HEIGHT_V marks them)
		local okH, errH = pcall(World.MigrateHeights, data.world)
		if not okH then
			warn("[Boxer] World heights migration failed, kept as saved:", errH)
		end
	end
	-- the first-time tutorial fight: anyone who already played (a career, an older save) counts as done
	if Tutorial then
		pcall(Tutorial.Backfill, stored, data, Config.DataVersion)
	end
	return data
end

-- an error that says this place may not use DataStores at all (Studio with "Enable Studio Access to API Services"
-- off, an unpublished place): retrying is pointless
function DataManager.ApiDisabled(err)
	local s = string.lower(tostring(err or ""))
	return string.find(s, "403", 1, true) ~= nil or string.find(s, "not allowed", 1, true) ~= nil
		or string.find(s, "studioaccesstoapis", 1, true) ~= nil or string.find(s, "publish", 1, true) ~= nil
		or string.find(s, "api services", 1, true) ~= nil
end

-- one read that takes the session lock in the same UpdateAsync: returns ok, stored value, locked.
-- Another server's fresh lock leaves the value untouched (locked = true) unless `steal` is set; nothing
-- stored yet is left as nothing (the first save creates the record, lock included).
local function read(player, tries, steal)
	local key = keyOf(player)
	local ok, err
	for attempt = 1, tries do
		local raw, held = nil, false
		ok, err = pcall(function()
			store:UpdateAsync(key, function(old)
				-- the transform may run more than once: it only reads `old` and sets the locals
				raw, held = old, false
				if type(old) ~= "table" then
					return nil
				end
				local now = os.time()
				if not steal and heldElsewhere(old.lock, now) then
					held = true
					return nil
				end
				old.lock = { job = SERVER_ID, at = now }
				return old
			end)
		end)
		if ok then
			return true, raw, held
		end
		-- Studio: a failed read is API access being off (403 "Studio access to APIs is not allowed"), and no retry
		-- will change that - the caller plays session-only at once instead of waiting through the retries
		if RunService:IsStudio() or DataManager.ApiDisabled(err) then
			break
		end
		if attempt < tries then
			task.wait(attempt)
		end
	end
	return false, err, false
end

-- rough size of the stored value (the DataStore limit is 4 MB): checked at the two quiet moments of a
-- session so a career that keeps growing is noticed long before its saves start failing
local function checkSize(player, data)
	local ok, encoded = pcall(HttpService.JSONEncode, HttpService, data)
	if ok and #encoded > SIZE_WARN then
		warn(string.format("[Boxer] Career of %s is %.1f MB (DataStore limit 4 MB)", player.Name, #encoded / 1048576))
	end
end

local function install(player, raw)
	local data = prepare(raw)
	seqOf[player] = seqField(raw)
	session[player] = HttpService:GenerateGUID(false)
	canSave[player] = true
	loadFailed[player] = nil
	-- the load wrote the lock: the next plain save keeps the DataStore's 6 s per-key write spacing
	lastSave[player] = type(raw) == "table" and os.clock() or nil
	lockAt[player] = lastSave[player]
	DataManager.Profiles[player] = data
	checkSize(player, data)
	return data
end

-- how long this player has been waiting for the career since the join
local function waited(player)
	return os.clock() - (joinedAt[player] or os.clock())
end

-- the player left before playing the career a read of ours just locked (gave up on the loading screen, or
-- left during a re-read): hand the lock back, or the player's next server would wait LOCK_WAIT for it.
-- Only this server's own lock is cleared; the career and its save counter are never touched.
local function unlock(player)
	local ok, err = pcall(function()
		store:UpdateAsync(keyOf(player), function(old)
			if type(old) == "table" and type(old.lock) == "table" and old.lock.job == SERVER_ID then
				old.lock = nil
				return old
			end
			return nil
		end)
	end)
	if not ok then
		warn("[Boxer] Lock hand-back failed (the next server waits for it):", err)
	end
end

-- the join-time read failed: keep the player profile-less and try again until it works or we give up
local function retryLoad(player)
	for _, delay in ipairs(RETRY_DELAYS) do
		task.wait(delay)
		if not (player.Parent and loadFailed[player]) then
			return
		end
		local ok, result, locked = read(player, 1, waited(player) >= LOCK_WAIT)
		if not player.Parent then
			if ok and not locked and type(result) == "table" then
				unlock(player)
			end
			return
		end
		if ok and not locked then
			install(player, result)
			print("[Boxer] Career loaded after a retry for", player.Name)
			if DataManager.OnLoaded then
				task.spawn(DataManager.OnLoaded, player)
			end
			return
		end
		warn("[Boxer] Load retry failed:", locked and "another server still holds the career" or result)
	end
	if player.Parent and loadFailed[player] then
		player:Kick(LOAD_FAIL_KICK)
	end
end

-- read with the lock, waiting while another server still holds the career (polling until its leave save
-- clears the lock, then taking the lock over LOCK_WAIT after `since`); returns ok, stored value, and whether
-- the read stored this server's lock. A player who leaves while it waits stops the polling: a poll after the
-- leave would take the lock for nobody.
local function acquire(player, since)
	local ok, result, locked = read(player, LOAD_TRIES)
	while ok and locked do
		task.wait(LOCK_POLL)
		if not player.Parent then
			return false, "player left", false
		end
		ok, result, locked = read(player, 1, os.clock() - since >= LOCK_WAIT)
	end
	return ok, result, ok and type(result) == "table"
end

function DataManager.Load(player)
	joinedAt[player] = os.clock()
	-- a quick rejoin on this server: let the leave save land first so the newest career is read
	local t0 = os.clock()
	while releasing[player.UserId] and os.clock() - t0 < RELEASE_BUDGET + 10 do
		task.wait(0.25)
	end
	if not store then
		-- no DataStore at all (Studio without API access): a session-only career, never written
		local data = prepare(nil)
		if player.Parent then
			DataManager.Profiles[player] = data
		end
		return data
	end
	local ok, result, took = acquire(player, joinedAt[player])
	if not player.Parent then
		if took then
			unlock(player)
		end
		return nil
	end
	if ok then
		return install(player, result)
	end
	if RunService:IsStudio() then
		-- Studio with API access off fails every read: play session-only at once (no retries), nothing is written for
		-- this player; with API access off the next players of this session skip the store entirely
		warn("[Boxer] DataStore unavailable in Studio (" .. tostring(result) .. "): a fresh session-only profile, nothing is saved. "
			.. "Turn on Game Settings > Security > Enable Studio Access to API Services to test saves.")
		if DataManager.ApiDisabled(result) then
			DataManager.StoreAvailable = false
			store = nil
		end
		local data = prepare(nil)
		DataManager.Profiles[player] = data
		return data
	end
	warn("[Boxer] Load failed:", result)
	-- never hand out a blank placeholder: a later save of it would wipe the real career
	loadFailed[player] = true
	task.spawn(retryLoad, player)
	return nil
end

-- true while the player's save could not be read yet (Main reports "loading" to the client)
function DataManager.LoadPending(player)
	return loadFailed[player] == true
end

-- can this player's progress be written? (Hub shows "saving is off" when not)
function DataManager.CanSave(player)
	return store ~= nil and canSave[player] == true
end

function DataManager.Get(player)
	return DataManager.Profiles[player]
end

function DataManager.Set(player, profile)
	DataManager.Profiles[player] = profile
end

-- a save was refused because the stored career moved on after this server read it (the previous server's
-- leave save landed late): play on from the newer copy, which must not be rolled back; only what was done
-- here since the join is lost. The kick remains for when the re-read fails too. A server that still holds
-- the career gets the same LOCK_WAIT as at a join (counted from now, not from the join).
local function refresh(player)
	local ok, result, took = acquire(player, os.clock())
	if not player.Parent then
		if took then
			unlock(player)
		end
		return
	end
	if canSave[player] then
		-- another refused save's re-read already installed the newer copy
		return
	end
	if ok then
		install(player, result)
		warn("[Boxer] Career refreshed from a newer save for", player.Name)
		local hook = DataManager.OnRefreshed or DataManager.OnLoaded
		if hook then
			task.spawn(hook, player)
		end
	elseif not RunService:IsStudio() then
		player:Kick(CONFLICT_KICK)
	end
end

-- one UpdateAsync with retries; returns true when the career is safely stored. `leaving` marks the leave
-- save: the only write that hands the lock over (with the shutdown saves) and the only one still retried
-- once the leave is under way.
local function write(player, data, leaving)
	local key = keyOf(player)
	local userId = player.UserId
	local conflict = false
	for attempt = 1, #SAVE_BACKOFF + 1 do
		-- seqOf only moves after a write is confirmed: a transform that ran but was not committed (the call
		-- errored, or Roblox re-ran it because another server wrote in between) must not claim the next number
		local base = seqOf[player] or 0
		local mine = session[player]
		local stamped = nil
		local moved = false
		local ok, err = pcall(function()
			store:UpdateAsync(key, function(old)
				local stored = seqField(old)
				local ours = mine ~= nil and type(old) == "table" and old.saveSession == mine
				moved = false
				if stored > base and not ours then
					-- another server wrote a newer copy after ours was read: never roll it back
					conflict = true
					stamped = nil
					return nil
				end
				conflict = false
				-- a save of a session that is ending here (the leave save is under way, or over) other than
				-- the leave save itself: the leave save stores this same profile and hands the lock over
				local ending = not leaving and (releasing[userId] or not canSave[player])
				if ending and type(old) == "table" and heldElsewhere(old.lock, os.time()) then
					-- the next server already took the career over: a save counter moved under it now would
					-- get its first save refused
					moved = true
					stamped = nil
					return nil
				end
				stamped = stored + 1
				data.saveSeq = stamped
				data.saveSession = mine
				-- the lock travels with every save (a fresh stamp says this server is still playing the
				-- career); the leave save and the shutdown saves hand it over to the next server, and a write
				-- that lands once the session here is over (forget cleared canSave) never takes it back. One
				-- served while the leave is under way leaves the lock as it is: the leave save clears it
				-- (if that already landed the lock stays clear, if not the next server keeps waiting for it).
				if leaving or closing or not canSave[player] then
					data.lock = nil
				elseif releasing[userId] then
					data.lock = type(old) == "table" and old.lock or nil
				else
					data.lock = { job = SERVER_ID, at = os.time() }
				end
				return data
			end)
		end)
		if moved then
			return false
		end
		if ok then
			if not conflict and stamped then
				seqOf[player] = math.max(seqOf[player] or 0, stamped)
				if canSave[player] and not (releasing[userId] or closing) then
					lockAt[player] = os.clock()
				end
			end
			if conflict then
				if DataManager.Profiles[player] ~= data then
					-- a copy this server already dropped (a refresh installed the newer one meanwhile): the
					-- profile played now is not affected, so it keeps saving and nothing is re-read
					return false
				end
				warn("[Boxer] Save refused: a newer save exists for", player.Name)
				canSave[player] = nil
				if player.Parent and not releasing[userId] and not closing then
					task.spawn(refresh, player)
				end
				return false
			end
			return true
		end
		warn("[Boxer] Save failed (attempt " .. attempt .. "):", err)
		local wait = SAVE_BACKOFF[attempt]
		if not wait or DataManager.Profiles[player] ~= data then
			break
		end
		task.wait(wait)
		-- the copy may have been dropped during the wait (another save was refused and the refresh installed
		-- the newer stored copy with its own counter): a retry would store the discarded table over it as the
		-- next save. Save() marks the player dirty, and its retry saves the profile played now. Once the
		-- leave is under way only the leave save retries (it stores this same profile, and a retry sent
		-- after it would land after it).
		if DataManager.Profiles[player] ~= data or not canSave[player] or (releasing[userId] and not leaving) then
			break
		end
	end
	return false
end

local function save(player, force, leaving)
	local data = DataManager.Profiles[player]
	if not data or not store or not canSave[player] then
		return false
	end
	if releasing[player.UserId] and not leaving then
		-- the leave save is under way and stores this same profile; a write sent now would land after it
		return false
	end
	local now = os.clock()
	if not force and not dirty[player] and lastSave[player] and now - lastSave[player] < 7 then
		-- DataStore write budget: at most one save every few seconds per player; save again shortly
		if not pending[player] then
			pending[player] = true
			task.delay(7 - (now - lastSave[player]) + 0.1, function()
				pending[player] = nil
				if DataManager.Profiles[player] then
					DataManager.Save(player)
				end
			end)
		end
		return false
	end
	lastSave[player] = now
	local ok = write(player, data, leaving)
	if ok then
		dirty[player] = nil
	elseif canSave[player] then
		-- still failing after the retries: keep trying in the background until a write lands
		dirty[player] = true
		if not pending[player] then
			pending[player] = true
			task.delay(15, function()
				pending[player] = nil
				if DataManager.Profiles[player] and dirty[player] then
					DataManager.Save(player, true)
				end
			end)
		end
	end
	return ok
end

function DataManager.Save(player, force)
	return save(player, force, false)
end

local function forget(player)
	DataManager.Profiles[player] = nil
	lastSave[player] = nil
	canSave[player] = nil
	loadFailed[player] = nil
	seqOf[player] = nil
	session[player] = nil
	dirty[player] = nil
	joinedAt[player] = nil
	lockAt[player] = nil
end

function DataManager.Release(player)
	local userId = player.UserId
	if not (store and canSave[player] and DataManager.Profiles[player]) then
		-- never played here (or a refused save's re-read is still out): no leave save, but a lock a read of
		-- ours stored must not outlive the player (a read still in flight hands its own back when it lands)
		local readOk = store and DataManager.StoreAvailable and not loadFailed[player]
		forget(player)
		if readOk then
			unlock(player)
		end
		return
	end
	releasing[userId] = true
	checkSize(player, DataManager.Profiles[player])
	-- the last save of the session: keep retrying (a transient error must not lose the session)
	local t0 = os.clock()
	while not save(player, true, true) and canSave[player] and os.clock() - t0 < RELEASE_BUDGET do
		task.wait(2)
	end
	forget(player)
	releasing[userId] = nil
end

-- server shutdown: wait for the leave saves in flight (PlayerRemoving runs Release for everyone)
function DataManager.WaitForReleases(timeout)
	local t0 = os.clock()
	while next(releasing) and os.clock() - t0 < (timeout or 25) do
		task.wait(0.25)
	end
end

-- keep this server's lock fresh for a player who goes minutes without a save (Main's autosave skips busy
-- players, and a pro fight saves only at the result): a lock-only write that refreshes our own lock, or puts
-- it back if a hand-back cleared it, as long as the stored copy is still the one this server holds. It never
-- touches the career or its save counter, never takes a lock another server holds fresh, and stops for the
-- leave save and at shutdown (those clear the lock for the next server).
local function beat(player)
	local userId = player.UserId
	local base = seqOf[player] or 0
	beating[player] = true
	local wrote = false
	local ok, err = pcall(function()
		store:UpdateAsync(keyOf(player), function(old)
			wrote = false
			if type(old) ~= "table" or seqField(old) ~= base or releasing[userId] or closing or not canSave[player] then
				return nil
			end
			local now = os.time()
			if heldElsewhere(old.lock, now) then
				return nil
			end
			old.lock = { job = SERVER_ID, at = now }
			wrote = true
			return old
		end)
	end)
	beating[player] = nil
	if not lockAt[player] then
		return -- the player left meanwhile
	end
	if ok then
		lockAt[player] = os.clock()
		if wrote then
			lastSave[player] = os.clock() -- the DataStore's per-key write spacing, as after a save
		end
	else
		lockAt[player] = os.clock() - LOCK_BEAT + BEAT_RETRY
		warn("[Boxer] Lock heartbeat failed:", err)
	end
end

if store then
	task.spawn(function()
		while true do
			task.wait(BEAT_CHECK)
			if not closing then
				local now = os.clock()
				local due = {}
				for player, at in pairs(lockAt) do
					if now - at >= LOCK_BEAT and canSave[player] and not beating[player] and not releasing[player.UserId] then
						table.insert(due, player)
					end
				end
				for _, player in ipairs(due) do
					task.spawn(beat, player)
				end
			end
		end
	end)
end

-- the shutdown saves (Main's BindToClose saves everyone before the leave saves) already hand the careers
-- over: every write from now on clears the lock, so a player who lands on the next server never waits
pcall(function()
	game:BindToClose(function()
		closing = true
	end)
end)

return DataManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="97">
        <Properties>
          <string name="Name">FightAI</string>
          <string name="Source"><![CDATA[-- FightAI: the opponent's brain. One per AI fighter (FightEngine.Run makes the blue corner's; the balance sims in
-- tools/sim give the red corner one too). It only ever acts through the engine's own moves (Punch, Feint, Slip,
-- Dodge, SetBlock, Clinch, MoveAI...), so it plays by the same rules as the player.
--
-- * FAIR PLAY. It never reacts to a punch it could not have seen: a punch starts, the AI notices it after its
--   perception delay (Config.FightAI.perceive, by skill; slower when concussed or dazed) and its move takes a
--   motor delay (by Reflexes) - if that is longer than the punch's wind-up it is simply too late. What lets a good
--   AI defend fast punches is PREDICTION: its read of the player (Shared.FightRead) says what usually comes next,
--   and a confident read lets it start early - but then it defends against the punch it EXPECTED, so a player who
--   changes his patterns makes it guess wrong. A feint looks exactly like a jab to it; only its read of how often
--   the player feints teaches it to stop biting.
-- * READING THE OPPONENT. The rolling read (FightRead: decays over ~30 s) of his favourite punches and follow-ups,
--   his head / body mix, which way he slips, when he blocks, how he manages his gas, the distance he likes, his
--   feints and what he does after his combinations. It slips the punch he throws most, expects his usual
--   follow-up, throws its hooks to the side he slips to, attacks when he is tired, punishes the end of his
--   combinations (unless he usually fires again), goes to the body when he shells up.
-- * RING GENERALSHIP. Distance by style (out-boxers keep range and back off, swarmers close in, sluggers stalk
--   and cut off the ring: FightEngine:MoveAI's cut), using the ropes (a man with his back to them is cut off; its
--   own back near them makes it circle out or pivot off), angles after its combinations.
-- * GAME PLANS by style and IQ: a base plan (outbox / swarm / stalk / bait / plan), feints and draws, pacing over
--   the rounds (a pace line for its stamina), a change of plan when the round or the cards go against it, a
--   gamble when it is losing late, the finish when he is hurt, survival (clinch, hold, cover, move) when it is.
-- * DEFENCE in layers: the guard, head movement, footwork off the line, the clinch; and REALISTIC MISTAKES scaled
--   by skill (Config.FightAI): a raw boxer picks the wrong defence now and then, drops its hands after its own
--   combinations, repeats its favourite combination and paces itself badly - an elite one rarely does.
-- * RING TRAITS (Shared.Traits): a Counter Specialist reads flurries, a Ring General slides off the ropes, a Slick
--   man slips more, a Weaver weaves more, a Pressure-proof man doesn't back off under pressure.
-- * reads the head-HP tiers and concussion (F.tier / F.conc): goes for the finish when the other man is dazed,
--   holds / covers / freezes when it is dazed itself, and reacts slower when concussed.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
-- fight spacing (FightMotion.Spacing, R-anim; the round-1 numbers if that module is missing)
local SPACING = { pivot = 3.2, clinch = 4.2, cover = 5 }
do
	local fm = ReplicatedStorage.Shared:FindFirstChild("FightMotion")
	local ok, mod = false, nil
	if fm then
		ok, mod = pcall(require, fm)
	end
	if ok and type(mod) == "table" and mod.Spacing then
		SPACING = { pivot = mod.Spacing.pivot, clinch = mod.Spacing.clinch - 0.2, cover = mod.Spacing.cover }
	end
end

-- special moves (Moves.lua), nil-safe if the module is missing
local Moves
do
	local mm = ReplicatedStorage.Shared:FindFirstChild("Moves")
	local ok, mod = false, nil
	if mm then
		ok, mod = pcall(require, mm)
	end
	Moves = (ok and type(mod) == "table") and mod or nil
end

-- combinations (the AI's plans by style and skill, the chain it reads), the dodges (by style), the read of the
-- player, the ring traits
local Combos = require(ReplicatedStorage.Shared:WaitForChild("Combos"))
local Evasion = require(ReplicatedStorage.Shared:WaitForChild("Evasion"))
local FightRead = require(ReplicatedStorage.Shared:WaitForChild("FightRead"))
local Traits = require(ReplicatedStorage.Shared:WaitForChild("Traits"))
-- [FrameTraits] the body frame it fights to (Shared.FrameTraits .ai): a heavyweight presses and ties up, a Lean boxes at range
local FrameTraits = require(ReplicatedStorage.Shared:WaitForChild("FrameTraits"))

local AIC = Config.FightAI

local FightAI = {}
FightAI.__index = FightAI

local DEFAULT_ARCH = { aggr = 0, block = 0.3, slip = 0.25, roll = 0.2, parry = 0.1, pivot = 0.1, body = 0.1, overhand = 0.05, adapt = 1 }
-- the base game plan by style (UpdateMode): out-boxers box from range, swarmers swarm, sluggers stalk and cut
-- off the ring, counter-punchers bait a lead and counter it, boxer-punchers mix it
local BASE_PLAN = { OutBoxer = "outbox", Swarmer = "swarm", Slugger = "stalk", CounterPuncher = "bait", BoxerPuncher = "plan" }
-- the alternative plan a thinking boxer switches to when its base plan is losing
-- (an out-boxer who is losing mixes it up - it does not turn into a swarmer and walk onto the other man's game)
local ALT_PLAN = { outbox = "plan", swarm = "outbox", stalk = "plan", bait = "swarm", plan = "outbox" }
-- mode -> aggression shift, range (a share of the jab range; nil = the style's), how hard it cuts off the ring,
-- work = its punch rate (an out-boxer lives on the volume of his jab)
local MODES = {
	plan = { aggr = 0 },
	outbox = { aggr = 0.1, range = 0.97, cut = 0, work = 1.5 },
	swarm = { aggr = 0.12, range = 0.7, cut = 0.5 },
	stalk = { aggr = 0.02, range = 0.8, cut = 0.8 },
	bait = { aggr = -0.15, range = 0.97, cut = 0 },
	pressure = { aggr = 0.3, range = 0.74, cut = 0.6 },
	finish = { aggr = 0.45, range = 0.7, cut = 0.7 },
	gamble = { aggr = 0.35, range = 0.75, cut = 0.6 },
	cruise = { aggr = -0.2, range = 0.98, cut = 0 },
	reset = { aggr = -0.25, range = 1.3, cut = 0 },
	survive = { aggr = -0.45, range = 1.9, cut = 0 },
}
FightAI.MODES = MODES

-- a wrong defence a raw boxer picks (by the kind of punch coming; a list entry twice is twice as likely): ducking
-- a straight, weaving into an uppercut, reaching to parry a hook or slipping into it ("slipinto" = a slip toward
-- the hand it comes from)
local MISTAKES = { straight = { "duck", "weave" }, hook = { "parry", "parry", "slipinto" }, overhand = { "parry", "slipinto" }, uppercut = { "duck", "weave" } }

-- the style's fight brain (multipliers on the shared logic): counter = how often it fires back out of its own
-- defence; punish = how often it fires into his misses and the end of his combinations; press = its work rate
-- while it walks him down (his back to the ropes, him retreating); volume = the work rate at range; inside =
-- the work rate up close (a swarmer lives there, an out-boxer leaves); smother = how readily it ties up a man
-- who rushes it; body = its extra share to the body; check = how readily it jabs a man as he steps into range
local TACTICS = {
	OutBoxer = { counter = 1.1, punish = 1.15, press = 0.85, volume = 1.25, inside = 0.8, smother = 1.2, body = 0, check = 1.7 },
	Swarmer = { counter = 0.85, punish = 1.05, press = 1.35, volume = 1.1, inside = 1.35, smother = 0.5, body = 0.06, check = 0.4 },
	Slugger = { counter = 0.9, punish = 1.2, press = 1.2, volume = 0.9, inside = 1.15, smother = 0.8, body = 0.05, check = 0.7 },
	CounterPuncher = { counter = 1.5, punish = 1.45, press = 0.85, volume = 0.95, inside = 0.95, smother = 1, body = 0, check = 1.3 },
	BoxerPuncher = { counter = 1.2, punish = 1.2, press = 1.05, volume = 1.05, inside = 1.05, smother = 0.9, body = 0.04, check = 1 },
}
FightAI.TACTICS = TACTICS
local DEFAULT_TACTICS = TACTICS.BoxerPuncher

local function lerp(a, b, t)
	return a + (b - a) * math.clamp(t, 0, 1)
end

function FightAI.new(F, O, engine)
	local style = Config.FindById(Config.Styles, F.data.style) or Config.Styles[4]
	local arch = Config.FindById(Config.Archetypes, F.data.archetype)
	local self = setmetatable({}, FightAI)
	self.F, self.O, self.engine = F, O, engine
	self.rng = Random.new()
	self.style = style
	self.arch = arch and arch.ai or DEFAULT_ARCH
	-- [FrameTraits] its own frame and the one in front of it (the engine's F.frame; the headless sims' too)
	self.frame = F.frame or FrameTraits.For(F.data)
	self.oFrame = O.frame or FrameTraits.For(O.data)
	self.baseRange = style.ai.range + self.frame.ai.range
	self.baseAggr = style.ai.aggression + ((F.data.mental.Aggression or 50) - 50) / 200 + self.arch.aggr + self.frame.ai.aggr
	self.jabRate = style.ai.jabRate
	self.comboMax = style.fight.combo >= 1.2 and 4 or 3
	self.queue = {}
	self.nextThink = 0
	self.nextMove = 0
	self.circleDir = self.rng:NextNumber() < 0.5 and -1 or 1
	self.mode = "plan"
	self.basePlan = BASE_PLAN[style.id] or "plan"
	self.plan = self.basePlan
	self.nextMode = 0
	self.freezeUntil = 0
	self.bodyBias = 0.2
	self.blockUntil = 0
	local learned = F.data.learned or {}
	local total = 0
	for _, v in pairs(learned) do
		total += v
	end
	self.anticipate = {}
	for k, v in pairs(learned) do
		self.anticipate[k] = total > 0 and v / total or 0
	end
	self.obs = { blockTime = 0, time = 0, punches = {}, body = 0, slips = 0 }
	-- the player's sequences it has seen ("1 2>3": a lead hook after a 1-2), for the defence that adapts
	self.seq = {}
	-- the rolling read of the man in front of it (Shared.FightRead) and what it expects him to throw next
	self.read = FightRead.new()
	self.expect = nil
	-- how good a boxer it is: its ring IQ and focus (0..1); its hands (Reflexes, 0..1) for the motor delay
	self.skill = math.clamp(((F.data.stats.RingIQ or 50) + (F.data.mental.Focus or 50)) / 200, 0, 1)
	self.hands = math.clamp((F.data.stats.Reflexes or 50) / 100, 0, 1)
	self.dodgeMul = Evasion.StyleDodge[style.id] or 1
	self.favourite = Evasion.StyleFavourite[style.id]
	self.planSwitches = 0
	self.punishAt = nil
	self.afterAt = nil
	self.drawUntil = 0
	self.nextFeint = 0
	self.lastCombo = 0
	-- the difficulty at its level (Config.FightAI.Tier: the reaction, the read, the work rate, the punch-rate floor)
	self.level = Config.Overall(F.data.stats)
	self.tier = AIC.Tier and AIC.Tier(self.level) or { react = 1, read = 1, work = 1, floor = 20, mistake = 1, name = "?" }
	-- the work rate: the last punch it threw, since when he has been within a step of its reach without one, the
	-- step in it is taking to punch (closeUntil), the opening it saw (openAt .. openUntil: his miss)
	self.lastThrowAt = -10
	self.reachableSince = nil
	self.closeUntil = 0
	self.openAt, self.openUntil, self.openWhy = 0, 0, nil
	-- its read of his feet (which way he keeps circling: a running mean of the side) and of his rhythm
	self.oCircle = 0
	self.oPrev = nil
	self.nextRhythm = 0
	-- its read of how he gives ground (a running mean of how fast he backs away, studs/s: a man who keeps
	-- retreating is walked down and cut off)
	self.oBack = 0
	self.oDistPrev = nil
	-- the style's fight brain (TACTICS)
	self.tactics = TACTICS[style.id] or DEFAULT_TACTICS
	-- the decision log: the last few reasons it did or did not punch (/wcbdiag's FIGHT block, Diag.FightLines)
	self.log = {}
	return self
end

-- the decision log: one entry per reason, a run of the same reason counted up
function FightAI:Note(now, why)
	local L = self.log
	local last = L[#L]
	if last and last.why == why then
		last.n += 1
		last.t = now
		return
	end
	table.insert(L, { t = now, why = why, n = 1 })
	if #L > 8 then
		table.remove(L, 1)
	end
end

------------------------------------------------------------------------
-- What it sees
------------------------------------------------------------------------
function FightAI:Observe(dt)
	self.obs.time += dt
	local O = self.O
	if O.blocking then
		self.obs.blockTime += dt
	end
	-- which way he keeps moving round it (the side of his step across the line between them, a running mean):
	-- a man who always circles one way is cut off, not chased (Move)
	if dt > 0 and O.root and self.F.root then
		local p = O.root.Position
		local q = self.oPrev
		if q then
			local toO = p - self.F.root.Position
			local dx, dz = p.X - q.X, p.Z - q.Z
			if dx * dx + dz * dz > 1e-4 then
				local side = toO.X * dz - toO.Z * dx
				self.oCircle = self.oCircle * (1 - 2 * dt) + (side > 0 and 1 or -1) * 2 * dt
			else
				self.oCircle *= 1 - 0.5 * dt
			end
		end
		self.oPrev = p
		-- how fast he opens the distance while it is not the one backing off (his retreat), a running mean
		local d = self.engine:Distance(self.F, O)
		local dp = self.oDistPrev
		if dp then
			local away = (d - dp) / dt
			local mine = self.F.hum and self.F.hum.MoveDirection and self.F.hum.MoveDirection.Magnitude or 0
			if not (self.mode == "survive" or self.mode == "reset" or self.mode == "outbox") or mine < 0.1 then
				local k = math.min(1, 0.8 * dt)
				self.oBack = self.oBack * (1 - k) + math.clamp(away, -6, 6) * k
			end
		end
		self.oDistPrev = d
	end
	self.read:Tick(dt, O.blocking == true, O.stamina < O.maxStam * 0.3)
	-- what he did after his last combination (FightRead.After), a beat after it ended
	local now = self.engine:Now()
	if self.afterAt and now >= self.afterAt then
		local A = self.afterAt
		self.afterAt = nil
		if O.lastPunch > A - 0.45 then
			self.read:After("punch")
		elseif O.blocking then
			self.read:After("block")
		elseif self.engine:Distance(self.F, O) > (self.afterDist or 0) + 0.6 then
			self.read:After("move")
		else
			self.read:After("idle")
		end
	end
end

function FightAI:Intel()
	local o = self.obs
	local fav = self.read:Favourite()
	return { blockRatio = math.max(o.time > 0 and o.blockTime / o.time or 0, self.read:BlockShare()), favorite = fav, slips = o.slips }
end

-- the engine: his combination of n punches just ended. A long one leaves him in his recovery: punish it (unless
-- the read says he usually fires again right after - then it is ready to defend instead)
function FightAI:OnOppComboEnd(n)
	self.read:ComboEnd(n)
	local engine, O = self.engine, self.O
	local now = engine:Now()
	self.afterAt = now + 0.45
	self.afterDist = engine:Distance(self.F, O)
	-- (a skilled boxer sees it more often: a raw one rarely times it at all)
	if n >= 3 and self.rng:NextNumber() < math.clamp((self.skill - 0.3) * 1.4 * self.tier.read, 0, 0.85) then
		local again, share = self.read:AfterCombo()
		if again == "punch" and share > 0.5 then
			self.punishAt = nil
			self.blockUntil = math.max(self.blockUntil, now + 0.6)
		else
			-- it sees the combination end a perception delay later
			self.punishAt = math.max(O.busyUntil, now) + self:Perception() * 0.6
		end
	end
end

-- seconds from a punch starting to the AI noticing it
function FightAI:Perception()
	local F = self.F
	local C = Config.Concussion
	return lerp(AIC.perceive[1], AIC.perceive[2], self.skill) * self.tier.react + C.aiReact * (F.conc or 0) + 0.04 * (F.tier or 0)
end
function FightAI:Motor()
	return lerp(AIC.motor[1], AIC.motor[2], self.hands) * self.tier.react
end

-- the engine: his punch just missed (short, evaded, or the roll): the opening a boxer who reads him fires into,
-- seen a perception delay later; a whiffed power shot leaves him open longest
function FightAI:OnOppMiss(ptype, why)
	local F, engine = self.F, self.engine
	if F.state == "down" or F.state == "clinch" or engine.finished then
		return
	end
	-- (a punch that fell short was thrown from out of reach: he is not open to anything from there)
	if why == "short" or why == "high" or why == "low" then
		return
	end
	local kind = Config.Punches[ptype] and Config.Punches[ptype].kind or "straight"
	-- (a skilled boxer makes him pay for most of his misses; the style's punish: a counter-puncher lives on them)
	local chance = (0.12 + 0.3 * self.skill) * math.min(1.15, self.tier.read) * self.tactics.punish * (kind == "straight" and 0.75 or 1) * math.min(1, engine.aiWork or 1)
	if self.rng:NextNumber() > chance then
		return
	end
	local now = engine:Now()
	self.openAt = now + self:Perception() * 0.6
	self.openUntil = self.openAt + (kind == "straight" and 0.35 or 0.55)
	self.openWhy = "his " .. tostring(ptype) .. " missed"
	self.nextThink = math.min(self.nextThink, self.openAt)
end

-- the rhythm of his punches: a man who throws on a beat (the last few intervals alike) has his next one due at
-- the beat; a skilled boxer times a straight to it (true when it is due now and the AI takes the chance)
function FightAI:RhythmDue(now)
	local O = self.O
	local t = O.throwTimes
	if not t or #t < 5 or now < self.nextRhythm or O.state == "punching" or self.skill < 0.35 then
		return false
	end
	local n = #t
	local sum, sq, k = 0, 0, 0
	for i = n - 3, n do
		local d = t[i] - t[i - 1]
		if d > 2 then
			return false
		end
		sum += d
		sq += d * d
		k += 1
	end
	local mean = sum / k
	local var = math.max(0, sq / k - mean * mean)
	if mean < 0.4 or mean > 1.6 or math.sqrt(var) > 0.25 * mean then
		return false
	end
	local due = t[n] + mean
	if math.abs(now - due) > 0.12 then
		return false
	end
	self.nextRhythm = now + 2
	return self.rng:NextNumber() < 0.55 * self.tier.read * self.tactics.counter
end

-- the opening he gives it right now (nil when none): his hands down in range, his back on the ropes, his gas
-- gone, him hurt
function FightAI:Opening(now, dist, jab)
	local O, engine = self.O, self.engine
	if engine:IsHurt(O) or (O.tier or 0) >= 1 then
		return "hurt"
	end
	if now < (O.guardDropUntil or 0) then
		return "hands down"
	end
	if O.onRopes then
		return "ropes"
	end
	if O.stamina < O.maxStam * 0.3 then
		return "tired"
	end
	-- shelled up in front of it: the body is open (and the uppercut through the middle)
	if O.blocking and dist <= jab + 0.2 then
		return "covering"
	end
	-- a man who seldom keeps his guard up (the read: his guard time) is open upstairs whenever he is not punching
	if self.skill >= 0.3 and self.read:BlockShare() < 0.12 and self.obs.time > 20 and O.state ~= "punching" and dist <= jab then
		return "low guard"
	end
	if dist <= jab and O.state ~= "punching" and not O.blocking and now - (O.lastPunch or -10) > 1.0 and (O.dodgeKind == nil) then
		return "idle in range"
	end
	-- he keeps backing off: step in behind the jab
	if self.oBack > 1.0 and dist <= jab + AIC.stepIn then
		return "retreating"
	end
	return nil
end

-- the combination that exploits the opening (nil = the usual BuildCombo): the finish upstairs on a hurt man, the
-- head when his hands are low, the body when he shells up (and the uppercut up the middle), the body and volume
-- on a tired man, the ropes for a long combination, the jab to step in on a man who retreats. Every punch fits
-- from here (the later ones a step closer, as PickPlan); none longer than the gas allows
local EXPLOIT = {
	hurt = { { { "cross" }, { "leadhook" }, { "cross" } }, { { "jab" }, { "cross" }, { "leadhook" }, { "rearhook" } }, { { "leadhook" }, { "uppercut" }, { "leadhook" } }, { { "overhand" }, { "leadhook" } } },
	["hands down"] = { { { "cross" }, { "leadhook" } }, { { "jab" }, { "cross" } }, { { "overhand" } }, { { "rearhook" }, { "leadhook" } } },
	["low guard"] = { { { "jab" }, { "cross" } }, { { "cross" }, { "leadhook" } }, { { "jab" }, { "overhand" } } },
	covering = { { { "leadhook", true }, { "rearhook", true } }, { { "uppercut" }, { "leadhook" } }, { { "leadhook", true }, { "leadhook" } }, { { "jab", true }, { "uppercut" }, { "cross" } } },
	ropes = { { { "jab" }, { "cross" }, { "leadhook", true }, { "leadhook" } }, { { "leadhook", true }, { "uppercut" }, { "cross" } }, { { "cross" }, { "leadhook" }, { "rearhook", true } } },
	tired = { { { "jab", true }, { "cross", true }, { "leadhook" } }, { { "leadhook", true }, { "rearhook", true } }, { { "jab" }, { "jab" }, { "cross" } } },
	retreating = { { { "jab" }, { "jab" }, { "cross" } }, { { "jab" }, { "cross" } } },
}
FightAI.EXPLOIT = EXPLOIT
function FightAI:ExploitCombo(open, dist)
	local list = EXPLOIT[open]
	if not list or self.rng:NextNumber() > 0.35 + 0.6 * self.skill then
		return nil
	end
	local F, engine = self.F, self.engine
	local pool = {}
	for _, c in ipairs(list) do
		local ok = F.stamina >= #c * 6
		for i, step in ipairs(c) do
			if not ok then
				break
			end
			ok = self:Fits(step[1], dist - (i == 1 and 0 or 0.5))
		end
		if ok then
			table.insert(pool, c)
		end
	end
	if #pool == 0 then
		return nil
	end
	local c = pool[self.rng:NextInteger(1, #pool)]
	local out = {}
	for _, step in ipairs(c) do
		table.insert(out, { p = step[1], body = step[2] == true and step[1] ~= "overhand" })
	end
	return out
end

-- called by the engine when the opponent starts a punch at us (info = { hand, chainPos, feint }: what the eye can
-- see - which hand moves; whether it is a feint it cannot know)
function FightAI:OnOppPunch(ptype, body, windup, info)
	info = type(info) == "table" and info or {}
	local F, O, engine = self.F, self.O, self.engine
	local now = engine:Now()
	self.obs.punches[ptype] = (self.obs.punches[ptype] or 0) + 1
	if body then
		self.obs.body += 1
	end
	-- what it expected (the read made at his last punch) and what it expects next
	local expect = self.expect
	if expect and now - expect.at > 1.2 then
		expect = nil
	end
	local np, nconf = self.read:Predict(ptype)
	self.expect = np and { p = np, conf = nconf, at = now } or nil
	-- (read and learn the player's combination even while busy: the sequence counts either way)
	local readBonus = self:ReadChain()
	if F.state == "down" or F.state == "clinch" or now < F.busyUntil then
		return
	end
	if now < (F.guardDropUntil or 0) then
		return -- (a raw boxer's hands are down after its own combination)
	end
	local s = F.data.stats
	-- (the tier's read: a world-class boxer defends more of what he sees, a debut's less)
	local chance = (s.Reflexes * 0.5 + s.RingIQ * 0.3 + s.HeadMovement * 0.2) / 100 * 0.9 * (0.85 + 0.25 * self.tier.read)
	chance += (self.anticipate[ptype] or 0) * 0.3
	-- (what it sees on its own is capped before the read adds on top: a sharp defender's eye never hides what tonight's
	-- read of him taught it)
	chance = math.min(chance, 0.7)
	-- slip the punch he throws most (the read of tonight); a body puncher's shots are expected low
	chance += self.read:Share(ptype) * 0.25 * self.arch.adapt
	if body then
		chance += self.read:BodyShare() * 0.2 * self.arch.adapt
	end
	chance += readBonus
	-- a Counter Specialist reads a flurry
	local cs = engine.Trait and engine:Trait(F, "CounterSpecialist") or 0
	if cs > 0 and ((O.chain and not O.chain.closed and O.chain.punches >= 3) or (engine.RecentThrows and engine:RecentThrows(O, 4) >= 7)) then
		chance += Traits.Effect("CounterSpecialist", "read", cs)
	end
	if F.stamina < F.maxStam * 0.25 then
		chance *= 0.6
	end
	if engine:IsHurt(F) then
		chance += 0.12
	end
	-- dazed / concussed: sees it late and cannot always do anything about it
	local tier, conc = F.tier or 0, F.conc or 0
	local C = Config.Concussion
	chance *= (1 - C.aiDefense * conc) * (1 - C.tierDefense * tier)
	if engine:IsStumbling(F) or now < self.freezeUntil then
		return
	end
	-- (engine.aiDefense: the tutorial's opponent reacts far less, so the lesson's punches land)
	chance = math.clamp(chance, 0.05, 0.9) * (engine.aiDefense or 1)
	-- a feint: it bites as on any jab, less once it has seen him feint a lot (and the smarter it is) - after the cap,
	-- so a sharp defender's high reaction rate never hides what the read taught it
	if info.feint then
		chance *= 1 - 0.85 * self.read:FeintShare() * self.skill
	end
	if self.rng:NextNumber() > chance then
		return
	end
	-- the timing: perception + the move. A confident read (or a draw it set up) lets it start early, but it
	-- then defends against what it EXPECTED
	local perceive, motor = self:Perception(), self:Motor()
	local kind = Config.Punches[ptype].kind
	local hand = info.hand or Config.Punches[ptype].hand
	local guessBody = body
	local early = 0
	if now < self.drawUntil then
		early = 0.5 -- (it drew the lead: it was waiting for exactly this)
	elseif expect and expect.conf >= AIC.predictFrom / math.max(0.5, self.tier.read) and engine.tutorial == nil then
		early = math.min(0.85, AIC.predictCut * expect.conf * (0.4 + 0.6 * self.skill) * math.min(1.3, self.tier.read))
		local P = Config.Punches[expect.p]
		if P and self.rng:NextNumber() < expect.conf then
			-- it commits to the punch it expected (right or wrong)
			kind, hand = P.kind, P.hand
		end
	end
	local react = perceive * (1 - early) + motor
	-- too late: a dodge counts only when it visibly started before the contact (Evasion.VISIBLE)
	if react >= windup - (Evasion.VISIBLE or 0) then
		return
	end
	local move = self:PickDefence(kind, guessBody, hand)
	local dir = self.rng:NextNumber() < 0.5 and -1 or 1
	-- slips go away from the hand a hook comes from (a left hook lands on its right: slip left); a slip INTO it
	-- is the raw boxer's mistake
	local landSide = hand == "L" and 1 or -1
	if move == "slipinto" then
		move, dir = "slip", landSide
	elseif move == "slip" and (kind == "hook" or kind == "overhand") then
		dir = -landSide
	end
	task.delay(react, function()
		if F.state == "down" or engine.finished then
			return
		end
		if move == "slip" then
			engine:Slip(F, dir)
		elseif move == "roll" then
			engine:Roll(F)
		elseif move == "parry" then
			engine:Parry(F)
		elseif move == "pivot" then
			engine:Pivot(F, dir)
		elseif move == "clinch" and engine.CanClinch and engine:CanClinch(F) then
			engine:Clinch(F)
		elseif Evasion.Moves[move] and engine.Dodge then
			engine:Dodge(F, move, dir)
		else
			engine:SetBlock(F, true)
			self.blockUntil = engine:Now() + 0.55
		end
	end)
end

-- the layered defence for a punch of this kind: the guard, the head movement that beats it, the footwork off the
-- line when it is under fire or on the ropes, the clinch when it is hurt up close; a raw boxer's wrong pick now
-- and then (MISTAKES)
function FightAI:PickDefence(kind, body, hand)
	local F, O, engine = self.F, self.O, self.engine
	if self.rng:NextNumber() < AIC.mistake * (1 - self.skill) ^ 1.5 * self.tier.mistake and MISTAKES[kind] and not body then
		local list = MISTAKES[kind]
		return list[self.rng:NextInteger(1, #list)]
	end
	local a = self.arch
	local options = {}
	local function add(move, w)
		if w > 0 then
			table.insert(options, { move, w })
		end
	end
	-- the read of his punches picks the defence a boxer has drilled for this man: against a jabber the slip and
	-- the parry (and the counter they open), against a hooker the roll, against a body puncher the elbows; the
	-- tier's read and the archetype's adaptability say how far it leans on it
	local lean = math.clamp(self.tier.read * self.arch.adapt * (0.4 + 0.6 * self.skill), 0, 1.6)
	local straightK = 1 + self.read:KindShare("straight") * lean
	local hookK = 1 + (self.read:KindShare("hook") + self.read:KindShare("overhand")) * lean
	-- layer 1: the guard (elbows in for the body, more so against a man who lives down there)
	add("block", a.block + (body and (0.3 + self.read:BodyShare() * 0.5 * self.arch.adapt) or 0))
	-- layer 2: the head movement that beats this punch
	local slick = engine.Trait and engine:Trait(F, "Slick") or 0
	local weaver = engine.Trait and engine:Trait(F, "Weaver") or 0
	if not body then
		if kind == "straight" then
			add("slip", a.slip * (1 + slick) * straightK)
			add("parry", a.parry * straightK)
			add("pivot", a.pivot * 0.6)
		elseif kind == "hook" or kind == "overhand" then
			add("roll", a.roll * (1 + weaver) * hookK)
			add("slip", a.slip * 0.3)
		end
	end
	-- the dodges (Evasion): the ones that beat this punch, by style (counter-punchers and out-boxers move their
	-- heads most) and its habits; a side-step is dear on the gas, so a tired man keeps it for later
	local head = (a.slip + a.roll) * 0.5
	for d, w in pairs(Evasion.AIWeights[kind] or {}) do
		if not body or (Evasion.Moves[d] and Evasion.Moves[d].body) then
			local fav = d == self.favourite and 1.5 or 1
			local cost = Evasion.Moves[d] and Evasion.Moves[d].stam or 5
			local trait = (d == "weave" and (1 + weaver)) or ((d == "slip" or d == "pull") and (1 + slick * 0.5)) or 1
			if F.stamina >= cost * 2.5 then
				-- layer 3: footwork off the line when he is in a flurry or it is on the ropes
				-- (and off the line of a man who lives on the body: the side-step is the one dodge that beats it)
				local under = (O.chain and not O.chain.closed and O.chain.punches >= 3) or F.onRopes or (body and self.read:BodyShare() > 0.4)
				local foot = (d == "sidestep" and under) and 2.2 or 1
				add(d, w * head * self.dodgeMul * fav * trait * foot * 0.55)
			end
		end
	end
	-- layer 4: hurt and up close in his flurry - hold on
	if (F.tier or 0) >= 1 and O.chain and not O.chain.closed and O.chain.punches >= 2 and engine.CanClinch and engine:CanClinch(F) then
		add("clinch", 0.5)
	end
	local totalW = 0
	for _, o in ipairs(options) do
		totalW += o[2]
	end
	local pick = self.rng:NextNumber() * totalW
	for _, o in ipairs(options) do
		pick -= o[2]
		if pick <= 0 then
			return o[1]
		end
	end
	return "block"
end

------------------------------------------------------------------------
-- The game plan
------------------------------------------------------------------------
-- the engine also calls this whenever either fighter's head tier changes
function FightAI:UpdateMode()
	local engine, F, O = self.engine, self.F, self.O
	local lead = engine:EstimateLead(F)
	local r, total = engine.round or 1, engine.rounds or 3
	local myTier, oTier = F.tier or 0, O.tier or 0
	local now = engine:Now()
	self.nextMode = now + 1.0
	local mom = engine.Mom and engine:Mom(F) or 0
	-- a thinking boxer changes its plan when it is losing the round it is in (or the cards) with it
	if self.skill >= 0.45 and engine.RoundPoints and (engine.round or 0) > 0 and now >= (self.planCheck or 0) then
		self.planCheck = now + 12
		local d = engine:RoundPoints(F, O) - engine:RoundPoints(O, F)
		if (d < -4 or (lead < 0 and r > total / 2)) and self.planSwitches < 3 then
			self.plan = ALT_PLAN[self.plan] or "plan"
			self.planSwitches += 1
		end
	end
	-- survival is for being hurt (the stun, a dazed head): low on health alone a boxer keeps fighting - a short
	-- reset now and then, never a whole fight spent running (health hardly comes back: a "health < 30" survive
	-- once kept the AI backing off for the rest of the bout - the Studio report's "it doesn't fight you")
	local low = F.health < 30 and now >= (self.lowResetAt or 0)
	-- (dazed - his head HP under the first tier - it survives: holds, covers, moves, and still throws its jab and its
	-- counters at the survival floor; the head comes back in the clinch and between the rounds)
	if engine:IsHurt(F) or myTier >= 1 then
		self.mode = "survive"
	elseif self.mode == "reset" and now < (self.resetUntil or 0) and oTier < 1 and not engine:IsHurt(O) then
		self.mode = "reset" -- (a reset runs its few seconds)
	elseif low and oTier < 1 and not engine:IsHurt(O) then
		self.mode = "reset"
		self.lowResetAt = now + 14
		self.resetUntil = now + 3
	elseif oTier >= 1 or (O.conc or 0) > 0.4 or engine:IsHurt(O) or engine:IsStumbling(O) then
		-- killer instinct: the other man is dazed, hurt or off his feet, go and end it
		self.mode = "finish"
	elseif r >= total * 0.66 and lead <= -2 and r > 1 then
		-- losing late on the cards: go for broke
		self.mode = "gamble"
	elseif (r > total / 2 and lead < 0) or O.health < 35 or O.stamina < O.maxStam * 0.3 or (O.onRopes and self.skill >= 0.3)
		or (self.oBack > 1.2 and self.skill >= 0.35 and self.tactics.press >= 1) then
		-- behind, or he is worn down / gassed / on the ropes / running: press (a burst when he is tired, the trap on
		-- the ropes, the ring cut off on a man who keeps backing away)
		self.mode = "pressure"
	elseif r >= total - 1 and lead >= 2 then
		self.mode = "cruise"
	elseif mom < -0.45 and self.skill >= 0.4 and now >= (self.resetUntil or 0) - 4 then
		-- the momentum is all his: reset (move, jab, hold) for a few seconds
		self.mode = "reset"
		self.resetUntil = now + 4
	else
		self.mode = self.plan
	end
	local intel = self:Intel()
	self.bodyBias = 0.12 + self.arch.body + self.tactics.body + intel.blockRatio * 0.35 * self.arch.adapt
	-- he blocks the moment it throws: go round it (the body) - and his Iron Chin wants the body too. The more of
	-- its head shots meet his gloves, the more it digs downstairs (a thinking boxer more than a raw one)
	self.bodyBias += math.max(0, self.read:ReactBlock() - 0.55) * (0.3 + 0.5 * self.skill) * self.arch.adapt
	if self.mode == "finish" then
		self.bodyBias *= 0.3 -- head hunting
	end
	-- [FrameTraits] a boxer who knows his trade goes to a Lean man's body (and not a heavyweight's)
	self.bodyBias += (1 - (self.oFrame.bodyAbsorb or 1)) * 0.6 * self.skill
	self.bodyBias = math.clamp(self.bodyBias, 0, 0.55)
	self.exploitGassed = O.stamina < O.maxStam * 0.3
end

-- the stamina it wants to have left at this point of the fight (the pace line; 0 = spend it all)
function FightAI:PaceLine()
	local engine = self.engine
	local rounds = engine.rounds or 3
	local r = engine.round or 1
	if r >= rounds then
		return 0
	end
	local len = engine.roundSeconds or 60
	local left = math.clamp((engine.roundEnd or 0) - engine:Now(), 0, len)
	local progress = math.clamp(((r - 1) + (len - left) / len) / rounds, 0, 1)
	return 0.25 + 0.35 * (1 - progress)
end

function FightAI:Aggression()
	local a = self.baseAggr
	local M = MODES[self.mode] or MODES.plan
	a += M.aggr
	if self.exploitGassed then
		a += 0.3
	end
	local F, engine = self.F, self.engine
	local stam = F.stamina / F.maxStam
	if stam < 0.3 then
		a -= 0.25
	end
	-- the pace line: a thinking boxer slows down before it runs dry (a raw one pays less heed)
	local pace = self:PaceLine()
	if stam < pace - AIC.paceSlack then
		a -= 0.25 * (0.3 + 0.7 * self.skill)
	end
	-- walked down: it wilts and backs off a little (unless it is Pressure-proof)
	if F.pressured and not (engine.Trait and engine:Trait(F, "PressureProof") > 0) then
		a -= 0.1
	end
	a += (self.F.data.mental.Confidence - 50) / 250
	return math.clamp(a, 0.05, 0.95)
end

-- preferred distance, as a share of this fighter's jab range
function FightAI:Range()
	local jab = self.engine:PunchRange(self.F, "jab")
	local M = MODES[self.mode]
	local share = (M and M.range) or self.baseRange
	if self.mode == "pressure" then
		share = math.min(self.baseRange, 0.74)
	elseif self.mode == "cruise" then
		share = math.max(self.baseRange, 0.94)
	elseif self.mode == "plan" then
		share = self.baseRange
	end
	-- an out-boxer facing a man who wants it close keeps a little further off
	if self.mode == "outbox" and self.read:Distance() and self.read:Distance() < jab * 0.85 then
		share += 0.06
	end
	-- the sizes: the longer man boxes a touch further out (his jab lands where the other's does not), the shorter
	-- one wants it closer (his shots only reach up from inside); the jab range above already carries his own reach
	if self.geoPrefs == nil and self.engine.GeoPrefs then
		self.geoPrefs = self.engine:GeoPrefs(self.F) or false
	end
	local gp = self.geoPrefs
	if gp then
		local long = (gp.jab - 1) - (gp.uppercut - 1)
		share += math.clamp(long, -0.5, 0.5) * 0.12
	end
	-- a step in to punch (Think: it wants to throw and he is a step outside its reach)
	if self.engine:Now() < (self.closeUntil or 0) then
		share = math.min(share, 0.68)
	end
	return jab * share * (self.engine.aiRange or 1)
end

-- is this punch worth throwing from dist? A straight goes out to its reach (and a quarter stud over: the step it
-- takes); a hook or an uppercut is thrown where it lands solid, inside the last INSIDE share of its reach (a hook
-- that just reaches from range is a glancing shot: FightEngine's stretch), never at the edge
-- and a boxer throws them from where they are THOSE punches, not off a lunge: the animation carries a hook out past
-- the jab on a long lunge (HitGeometry measures where the glove visibly lands, and a punch the player saw land
-- registers), but the AI chooses its hooks and uppercuts inside, a share of its own jab's reach (INSIDE_JAB)
local INSIDE = { hook = 0.9, uppercut = 0.9, overhand = 0.95 }
local INSIDE_JAB = { hook = 0.72, uppercut = 0.68, overhand = 0.88 }
function FightAI:Fits(ptype, dist)
	-- (a punch that cannot land from here on the head or the body - a short man's overhand at a giant's chin from as
	-- close as they get, inside the floor PunchRange keeps - is not thrown)
	if self.engine.CanLand and self.O and not self.engine:CanLand(self.F, self.O, ptype, dist) then
		return false
	end
	local range = self.engine:PunchRange(self.F, ptype)
	local kind = Config.Punches[ptype] and Config.Punches[ptype].kind or "straight"
	local k = INSIDE[kind]
	if k then
		-- (the discipline grows with the boxer: a raw one still swings his hooks from out at the jab's range)
		local raw = (1 - self.skill) ^ 2
		local ij = INSIDE_JAB[kind] + (0.95 - INSIDE_JAB[kind]) * raw
		return dist <= math.min(range * k, self.engine:PunchRange(self.F, "jab") * ij)
	end
	return dist <= range + 0.25
end

------------------------------------------------------------------------
-- Offence
------------------------------------------------------------------------
-- the hand that lands on his blind side (a closing eye) and the hook that finds the side he slips to: weights for
-- the punch pool (1 = no preference)
function FightAI:PunchPrefs()
	local engine, O = self.engine, self.O
	local pref = { jab = 1, cross = 1, leadhook = 1, rearhook = 1, uppercut = 1, overhand = 1 }
	if engine.Blind and engine.tutorial == nil then
		-- its left hand lands on his right side (side 1)
		local bR, bL = engine:Blind(O, 1), engine:Blind(O, -1)
		pref.jab *= 1 + bR
		pref.leadhook *= 1 + bR * 1.5
		pref.cross *= 1 + bL
		pref.rearhook *= 1 + bL * 1.5
		pref.overhand *= 1 + bL
	end
	local side, strength = self.read:SlipSide()
	if strength > 0.3 then
		-- his head goes to side `side`: the hook that lands there (lead hook -> his right, side 1)
		local k = 1 + strength * self.arch.adapt
		if side == 1 then
			pref.leadhook *= k
		else
			pref.rearhook *= k
		end
	end
	-- a Weaver's dip meets the uppercut; a Slick man's head is off the line of straights (an AI knows its own
	-- kind: the other side's traits only matter in the AI-vs-AI sims)
	local weaver = engine.Trait and engine:Trait(O, "Weaver") or 0
	local slick = engine.Trait and engine:Trait(O, "Slick") or 0
	pref.uppercut *= 1 + weaver * self.skill
	pref.cross *= 1 - slick * 0.4 * self.skill
	pref.jab *= 1 - slick * 0.3 * self.skill
	-- the sizes (HitGeometry.PunchPrefs off the two rigs): the longer man works his jab and cross, the shorter one
	-- hooks and uppercuts inside; a boxer who knows his trade leans on it more
	local HG = self.geoPrefs
	if HG == nil then
		HG = engine.GeoPrefs and engine:GeoPrefs(self.F) or false
		self.geoPrefs = HG
	end
	if HG then
		local lean = 0.5 + 0.5 * self.skill
		for p, m in pairs(HG) do
			if pref[p] then
				pref[p] *= 1 + (m - 1) * lean
			end
		end
	end
	-- [FrameTraits] the frame's game: a power frame hooks and uppercuts inside, a Lean one works the straights
	local inside = self.frame.ai.inside or 1
	if inside ~= 1 then
		pref.leadhook *= inside
		pref.rearhook *= inside
		pref.uppercut *= inside
		local straight = math.clamp(2 - inside, 0.6, 1.4)
		pref.jab *= straight
		pref.cross *= straight
	end
	return pref
end

-- the combination to throw. A plan (Combos.Plans: a named or a signature combo its style likes, every punch in
-- range) Combos.PlanShare(skill) of the time; otherwise the old few random punches (a raw boxer's wilder flurry,
-- which the combo rules punish)
function FightAI:BuildCombo()
	local n = 1
	local aggr = self:Aggression()
	local wantCombo = self.rng:NextNumber() < aggr * 0.8
	local dist = self.engine:Distance(self.F, self.O)
	if wantCombo and self.rng:NextNumber() < Combos.PlanShare(self.skill) then
		local plan = self:PickPlan(dist)
		if plan then
			return plan
		end
	end
	if wantCombo then
		local extra = (self.engine:IsHurt(self.O) or self.mode == "finish") and 1 or 0
		n = self.rng:NextInteger(2, self.comboMax + extra)
	end
	local finish = (self.mode == "finish" or self.mode == "gamble") and 0.2 or 0
	n = math.max(1, math.min(n, math.floor(self.F.stamina / 6)))
	local pref = self:PunchPrefs()
	local list = {}
	for i = 1, n do
		local p = "jab"
		local roll = self.rng:NextNumber()
		if not (i == 1 and roll < self.jabRate + ((self.mode == "cruise" or self.mode == "outbox" or self.mode == "reset") and 0.25 or 0)) then
			local pool, total = {}, 0
			for _, opt in ipairs({
				{ "cross", 0.4 }, { "leadhook", 0.25 + finish }, { "rearhook", 0.18 + finish }, { "uppercut", 0.15 + finish },
				{ "overhand", 0.03 + self.arch.overhand + finish }, { "jab", (0.4 + 0.5 * self.skill) * (1 - 2 * finish) },
			}) do
				if self:Fits(opt[1], dist) then
					local w = opt[2] * (pref[opt[1]] or 1)
					table.insert(pool, { opt[1], w })
					total += w
				end
			end
			local pick = self.rng:NextNumber() * total
			for _, opt in ipairs(pool) do
				pick -= opt[2]
				if pick <= 0 then
					p = opt[1]
					break
				end
			end
		end
		-- (a man shelled up in front of it is open downstairs: the hooks go round the guard to the body)
		local bb = self.bodyBias
		if self.O.blocking and self.skill >= 0.4 and (p == "leadhook" or p == "rearhook") then
			bb = math.min(0.7, bb + 0.2 * (0.5 + 0.5 * self.skill))
		end
		local body = p ~= "overhand" and self.rng:NextNumber() < bb
		table.insert(list, { p = p, body = body })
	end
	return list
end

-- a plan its style likes (and its signature combos), every punch in reach from here, no longer than its skill
-- allows and affordable on its gas; nil when none fits. A raw boxer repeats its last plan more often than it
-- should (a pattern the player can learn)
function FightAI:PickPlan(dist)
	local F = self.F
	local likes = Combos.StylePlans[self.style.id] or Combos.StylePlans.BoxerPuncher
	local maxLen = Combos.PlanMax(self.skill)
	local pool, total = {}, 0
	local function fits(id)
		local plan = Combos.Plans[id]
		if not plan or #plan > maxLen + (Combos.ById[id] and Combos.ById[id].signature and 1 or 0) or F.stamina < #plan * 6 then
			return false
		end
		for i, step in ipairs(plan) do
			-- (the later punches are thrown a step closer: only the first must reach from here, the rest nearly)
			if not self:Fits(step[1], dist - (i == 1 and 0 or 0.5)) then
				return false
			end
		end
		return true
	end
	local function consider(id, w)
		if w <= 0 or not fits(id) then
			return
		end
		table.insert(pool, { id, w })
		total += w
	end
	local chosen = nil
	if self.lastPlan and self.rng:NextNumber() < (1 - self.skill) * 0.5 and fits(self.lastPlan) then
		chosen = self.lastPlan
	else
		for id, w in pairs(likes) do
			local bodyHeavy = id == "jabbodyhook" or id == "bodyhead"
			consider(id, w * (bodyHeavy and (0.6 + self.bodyBias * 2) or 1) * ((self.mode == "finish" or self.mode == "gamble") and #Combos.Plans[id] >= 3 and 1.4 or 1))
		end
		for id in pairs(F.sigs or {}) do
			if Combos.Plans[id] then
				consider(id, Combos.SIG_PLAN_WEIGHT)
			end
		end
		if total <= 0 then
			return nil
		end
		table.sort(pool, function(x, y)
			return x[1] < y[1]
		end)
		local pick = self.rng:NextNumber() * total
		for _, o in ipairs(pool) do
			pick -= o[2]
			if pick <= 0 then
				chosen = o[1]
				break
			end
		end
	end
	if not chosen then
		return nil
	end
	local out = {}
	for _, step in ipairs(Combos.Plans[chosen]) do
		table.insert(out, { p = step[1], body = self:BodyFlip(step[1], step[2] == true) })
	end
	self.lastPlan = chosen
	return out
end

-- a planned head shot dropped to the body: a man who lives behind his guard (bodyBias over its base, his gloves
-- up right now) gets the hooks and the jab downstairs; a thinking boxer does it more. Body shots stay body shots
function FightAI:BodyFlip(p, body)
	if body or p == "overhand" or p == "cross" or p == "uppercut" then
		return body
	end
	local k = math.max(0, self.bodyBias - 0.2) * (0.4 + 0.4 * self.skill) + (self.O.blocking and 0.15 * self.skill or 0)
	return self.rng:NextNumber() < k
end

-- the defence that adapts to the player's combinations: a long flurry is read from its READ_FROM-th punch, and
-- a follow-up it has seen him throw after the same punches LEARN_SEEN times is expected. Returns the extra
-- defend chance (and learns the sequence)
function FightAI:ReadChain()
	local chain = self.O.chain
	if not chain or chain.closed or #chain.items == 0 then
		return 0
	end
	local bonus = 0
	local n = chain.punches
	if n >= Combos.READ_FROM then
		bonus += math.min(Combos.READ_MAX, (n - Combos.READ_FROM + 1) * Combos.READ_STEP)
	end
	local items = chain.items
	local cur = items[#items]
	if #items >= 2 and not cur.dodge then
		local prev = {}
		for i = math.max(1, #items - 2), #items - 1 do
			table.insert(prev, items[i].tok)
		end
		local key = table.concat(prev, " ") .. ">" .. tostring(cur.tok)
		local seen = self.seq[key] or 0
		if seen >= Combos.LEARN_SEEN then
			bonus += Combos.LEARN_BONUS * math.min(1.5, self.arch.adapt or 1)
		end
		self.seq[key] = seen + 1
	end
	return bonus
end

-- a punch it throws (the queue's or a counter): the engine's Punch, its read of whether he blocks on the spot
function FightAI:Throw(p, body)
	local engine, O = self.engine, self.O
	engine:Punch(self.F, p, body)
	if self.F.state == "punching" then
		self.read:Reacted(O.blocking == true)
		self.lastThrowAt = engine:Now()
	end
end

-- a counter: the hand that lands on his blind side or the hook to the side he slips to, else the style's; from out at
-- range the quick jab as often as not (the straight right is the counter of a man who is close enough to sit on it)
function FightAI:CounterPunch(dist)
	local p = "jab"
	local pref = self:PunchPrefs()
	if dist > self.engine:PunchRange(self.F, "jab") * 0.8 and self.rng:NextNumber() < 0.6 then
		return p
	end
	if self:Fits("leadhook", dist) and self.rng:NextNumber() < 0.5 then
		p = (self.rng:NextNumber() * (pref.leadhook + pref.rearhook) < pref.leadhook) and "leadhook" or "rearhook"
	elseif self:Fits("cross", dist) then
		p = (self.arch.overhand > 0.2 and self.rng:NextNumber() < 0.3) and "overhand" or "cross"
	end
	return p
end

function FightAI:Think(now)
	local F, O, engine = self.F, self.O, self.engine
	if now < self.nextThink then
		return
	end
	self.nextThink = now + lerp(AIC.think[1], AIC.think[2], self.skill)
	if F.state == "down" or O.state == "down" then
		self.queue = {}
		self:Note(now, "down")
		return
	end
	if F.state == "clinch" then
		self.queue = {}
		self:Note(now, "clinch")
		self:ClinchThink(now)
		return
	end
	if now >= self.nextMode then
		self:UpdateMode()
	end
	local tier = F.tier or 0
	-- a dazed fighter sometimes just freezes for a moment (and gets hit): ~15% per second per tier
	if now < self.freezeUntil or engine:IsStumbling(F) then
		self:Note(now, now < self.freezeUntil and "frozen" or "stumbling")
		return
	end
	if tier >= 1 and self.rng:NextNumber() < 0.15 * tier * 0.32 then
		self.freezeUntil = now + 0.4
		self.queue = {}
		self:Note(now, "frozen (dazed)")
		return
	end
	local dist = engine:Distance(F, O)
	local jab = engine:PunchRange(F, "jab")
	-- the work-rate clock: since when he has been within a step of its reach (the floor counts from there)
	if dist <= jab + AIC.stepIn then
		self.reachableSince = self.reachableSince or now
	else
		self.reachableSince = nil
	end
	if now >= self.nextMove then
		self.nextMove = now + 0.35
		self:Move(now, dist)
	end
	if F.blocking and now >= self.blockUntil then
		engine:SetBlock(F, false)
	end
	if now < F.busyUntil then
		self:Note(now, "busy")
		return
	end
	-- (the engine's spacing is scaled to the pair's rigs: engine.rigK)
	local rk = engine.rigK or 1
	-- off the ropes / out of the corner: a pivot (more for a pivoting archetype, a skilled boxer and a Ring General)
	local rg = engine.Trait and engine:Trait(F, "RingGeneral") or 0
	local escape = self.arch.pivot * 0.08 + (F.onRopes and (0.05 + 0.1 * self.skill + Traits.Effect("RingGeneral", "escape", rg) * 0.4) or 0)
	-- a mover being walked down takes the angle out instead of backing straight up (ring generalship)
	local mover = (self.mode == "outbox" or self.mode == "bait" or self.mode == "cruise" or (self.style.id == "OutBoxer" and self.mode ~= "finish"))
		and (F.pressured or dist < self:Range() * 0.75)
	if mover then
		escape += 0.08 + 0.14 * self.skill
	end
	if (self.arch.pivot > 0.15 or F.onRopes or mover) and dist < SPACING.pivot * rk * 1.15 and self.rng:NextNumber() < escape then
		if F.onRopes and rg > 0 then
			engine:TraitFired(F, "RingGeneral")
		end
		engine:Pivot(F, self.circleDir)
		self:Note(now, "pivot out")
		return
	end
	local clinchRange = engine.ClinchRange and engine:ClinchRange(F) or SPACING.clinch * rk
	-- hurt and eating a flurry: a boxer who knows his trade does not stand there (the referee stops a man who takes
	-- it without answering - FightEngine.CheckStoppage): he grabs, he shells up, or he lets one go back
	if self.mode == "survive" and engine.Now then
		local n = 0
		for _, t in ipairs(F.recentHits or {}) do
			if now - t <= 3 then
				n += 1
			end
		end
		if n >= 3 then
			local k = 0.35 + 0.5 * self.skill
			local r = self.rng:NextNumber()
			if dist < clinchRange and engine:CanClinch(F) and r < k * 0.6 then
				engine:Clinch(F)
				self:Note(now, "under fire: holds")
				return
			elseif r < k and self:Fits("jab", dist) and F.stamina >= 6 then
				self:Throw(self.rng:NextNumber() < 0.6 and "jab" or (self:Fits("leadhook", dist) and "leadhook" or "cross"), false)
				self:Note(now, "under fire: fires back")
				return
			elseif r < k + 0.3 then
				engine:SetBlock(F, true)
				self.blockUntil = now + 1.0
				self:Note(now, "under fire: shells up")
				return
			end
		end
	end
	if self.mode == "survive" or self.mode == "reset" then
		local hold = (self.mode == "survive" and (tier >= 1 and 0.6 or 0.35) or 0.12) * (0.7 + 0.3 * self.tactics.smother)
		-- (and a boxer who knows his trade ties up to kill his momentum when it is all his)
		if engine.Mom and engine:Mom(F) < -0.5 and self.skill >= 0.4 then
			hold += 0.2
		end
		if dist < clinchRange and self.rng:NextNumber() < hold and engine:CanClinch(F) then
			engine:Clinch(F)
			self:Note(now, "clinch (" .. self.mode .. ")")
			return
		end
		if dist < SPACING.cover * rk and self.rng:NextNumber() < (self.mode == "survive" and 0.5 or 0.25) then
			engine:SetBlock(F, true)
			self.blockUntil = now + 0.7
			self:Note(now, "cover (" .. self.mode .. ")")
			return
		end
	end
	-- [FrameTraits] a heavy frame ties up to wear the other man down: more when he is tiring, when it is gassed itself,
	-- or when it is being outboxed at range (never while finishing him)
	local fc = self.frame.ai.clinch or 0
	if fc > 0 and self.mode ~= "finish" and self.mode ~= "gamble" and dist < (engine.ClinchRange and engine:ClinchRange(F) or SPACING.clinch * rk) then
		local want = fc * (1 + (O.stamina < O.maxStam * 0.5 and 0.6 or 0) + (F.stamina < F.maxStam * 0.4 and 0.6 or 0) + (F.pressured and 0.4 or 0))
		if self.rng:NextNumber() < want and engine:CanClinch(F) then
			engine:Clinch(F)
			return
		end
	end
	-- he walks onto its jab: a man stepping into range (closing at a stride, not punching) meets the jab on the way in
	-- (or the 1-2) - the out-boxer's trade, a swarmer's least
	if self.oBack < -1.2 and O.state ~= "punching" and self:Fits("jab", dist) and dist > jab * 0.7 and self.mode ~= "survive"
		and self.rng:NextNumber() < 0.3 * self.tactics.check * (0.4 + 0.6 * self.skill) then
		self.queue = self:Fits("cross", dist) and self.rng:NextNumber() < 0.4 and { { p = "cross", body = false } } or {}
		self:Throw("jab", false)
		self:ChainNext()
		self:Note(now, "jabs him on the way in")
		return
	end
	-- the opening it saw him give (OnOppMiss: his punch missed, a perception delay ago): fire into it
	if now >= self.openAt and now < self.openUntil and self:Fits("cross", dist) then
		self.openUntil = 0
		self:Throw(self:CounterPunch(dist), self.rng:NextNumber() < self.bodyBias)
		self:Note(now, "punish: " .. tostring(self.openWhy))
		return
	end
	-- he bit on its feint: fire now (it saw him react)
	if now < (F.feintOpenUntil or 0) and self:Fits("cross", dist) then
		self:Throw(self:CounterPunch(dist), self.rng:NextNumber() < self.bodyBias)
		self:Note(now, "feint: he bit")
		return
	end
	if self:TrySpecial(now, dist) then
		self:Note(now, "special")
		return
	end
	-- its own defence worked (a slip, a parry, a roll: the engine's counter window): fire back - the timed counter a
	-- boxer drills, more from a counter-puncher and a high tier
	local counterK = math.clamp((0.12 + 0.3 * self.skill) * self.tactics.counter * math.min(1.15, self.tier.read), 0.1, 0.7)
	-- (out of the guard - the window a blocked shot opens - the counter is the exception, not the rule: a boxer firing
	-- back off every shot that hits his gloves turned every exchange into a knockdown)
	if F.blocking then
		-- (but walked down, the block-and-fire-back is the answer to a man who keeps coming: the guard takes his shots
		-- and the counter goes in behind them)
		counterK *= self:Pressed(dist, jab) and 0.8 or 0.4
	end
	-- a Counter Specialist lives on the man in the middle of his flurry: it fires back into it far more often
	local csT = engine.Trait and engine:Trait(F, "CounterSpecialist") or 0
	if csT > 0 and O.chain and not O.chain.closed and O.chain.punches >= 2 then
		counterK = math.min(0.9, counterK * (1 + 1.5 * csT))
	end
	if now < F.counterUntil and self:Fits("jab", dist) and self.rng:NextNumber() < counterK then
		self:Throw(self:CounterPunch(dist), false)
		self:Note(now, "counter")
		return
	end
	-- walked down: the answers to a pressure fighter (AnswerPressure)
	if self:AnswerPressure(now, dist, jab, clinchRange) then
		return
	end
	-- walked onto: a man rushing in with his hands going is met - an inside fighter fires back with the short
	-- hooks and uppercuts (meeting him punching), the rest tie him up when he is right on top of them
	local rushing = O.state == "punching" and dist < jab * 0.85 and engine.RecentThrows and engine:RecentThrows(O, 3) >= 4
	if rushing and self.mode ~= "survive" and self.skill >= 0.3 then
		local inside = self.tactics.inside * (self.frame.ai.inside or 1)
		if self.rng:NextNumber() < 0.22 * inside * (0.5 + 0.5 * self.skill) and self:Fits("leadhook", dist) then
			local p = self.rng:NextNumber() < 0.55 and "leadhook" or (self:Fits("uppercut", dist) and "uppercut" or "rearhook")
			self:Throw(p, self.rng:NextNumber() < self.bodyBias + 0.15)
			self:Note(now, "meets the rush: " .. p)
			return
		end
		if dist < clinchRange and self.rng:NextNumber() < 0.12 * self.tactics.smother * self.skill and engine:CanClinch(F) then
			engine:Clinch(F)
			self:Note(now, "ties up the rush")
			return
		end
	end
	-- the end of his combination: he is in his recovery (it saw it end)
	if self.punishAt and now >= self.punishAt then
		local at = self.punishAt
		self.punishAt = nil
		if now - at < 0.4 and self:Fits("jab", dist) and self.mode ~= "survive" then
			self:Throw(self:CounterPunch(dist), self.rng:NextNumber() < self.bodyBias * 0.6)
			self:Note(now, "punish: his combination ended")
			return
		end
	end
	-- his rhythm: his next punch is due on the beat he keeps - a straight meets it
	if self:RhythmDue(now) and self:Fits("jab", dist) then
		self:Throw(self.rng:NextNumber() < 0.6 and "jab" or "cross", false)
		self:Note(now, "timing counter")
		return
	end
	if #self.queue > 0 then
		local nxt = table.remove(self.queue, 1)
		if dist <= engine:PunchRange(F, nxt.p) + 0.4 then
			self:Throw(nxt.p, nxt.body)
			self:ChainNext()
			self:Note(now, "combination")
			if #self.queue == 0 then
				self:ComboDone(now)
			end
		else
			self.queue = {}
			self:Note(now, string.format("combination broken off: %.1f > %.1f", dist, engine:PunchRange(F, nxt.p)))
		end
		return
	end
	local aggr = self:Aggression()
	local fits = self:Fits("jab", dist)
	if fits or (self:Fits("jab", dist - 0.6) and (self.mode == "bait" or self.mode == "outbox")) then
		-- a feint / a draw: show him a jab and see what he does (counter-punchers and out-boxers, the smart ones)
		if self:TryFeint(now, dist) then
			self:Note(now, "feint")
			return
		end
	end
	-- the work: its chance to attack this think (engine.aiWork: a gym partner or the tutorial's opponent is told
	-- how hard; the tier's work; a raw boxer looks for its openings less often), up when he is open to it; and
	-- the floor under it (Config.FightAI.tiers[].floor punches a minute while he is within a step of its reach: a
	-- step in and a punch when it has gone too long without one - a debut opponent is easier, never passive)
	local M = MODES[self.mode]
	local work = (aggr * 0.16 + self.jabRate * 0.07) * AIC.work * self.tier.work * (engine.aiWork or 1) * (0.45 + 0.35 * self.skill) * ((M and M.work) or 1)
	-- the style's work: an out-boxer's volume at range, a swarmer's inside, everyone's when it walks him down
	local T = self.tactics
	local pressing = self.mode == "pressure" or self.mode == "finish" or self.mode == "gamble" or self.mode == "stalk" or self.mode == "swarm" or O.onRopes or self.oBack > 1
	work *= pressing and T.press or (dist < jab * 0.8 and T.inside or T.volume)
	if self.mode == "finish" then
		work *= 1.1 -- (he is hurt: go and end it)
	end
	-- outworked: a man throwing more than it over the last ten seconds is matched (a boxer losing the work rate picks
	-- his own up; two men at an even pace leave each other be)
	if engine.RecentThrows then
		local his, mine = engine:RecentThrows(O, 10), engine:RecentThrows(F, 10)
		if his > mine * 1.2 + 1 then
			work *= math.min(1.4, 1 + (his - mine) / math.max(4, mine) * 0.5)
		end
	end
	local open = self:Opening(now, dist, jab)
	if open then
		work *= AIC.openWork
	end
	local floorPPM = math.max(AIC.floorMin, self.tier.floor * (engine.aiWork or 1) * ((self.mode == "survive" or self.mode == "reset") and 0.4 or 1))
	local gap = 60 / floorPPM
	-- (the engine's lastPunch: every punch it threw counts, a special's and a buffered one too)
	-- (the floor's punch is timed like any other: never into his flurry - it waits for his combination to end - and
	-- it is the jab or the 1-2, not a long combination thrown because a clock ran out)
	local inHisFlurry = O.state == "punching" or (O.chain and not O.chain.closed and now < (O.chain.closeAt or 0))
	local overdue = self.reachableSince ~= nil and now - self.reachableSince > gap and now - math.max(self.lastThrowAt, F.lastPunch or -10) > gap and F.stamina >= 6 and not inHisFlurry
	if fits then
		if overdue or self.rng:NextNumber() < work then
			-- the combination that exploits the opening he gives it (ExploitCombo), else its usual one; the floor's
			-- punch is the jab (and the cross behind it now and then)
			if overdue and not open then
				self.queue = { { p = "jab", body = self:BodyFlip("jab", false) } }
				if self:Fits("cross", dist) and self.rng:NextNumber() < 0.5 then
					table.insert(self.queue, { p = "cross", body = false })
				end
			else
				self.queue = (open and self:ExploitCombo(open, dist)) or self:BuildCombo()
			end
			local first = table.remove(self.queue, 1)
			self:Throw(first.p, first.body)
			self:ChainNext()
			self:Note(now, overdue and "attack (work floor)" or (open and ("attack: " .. open) or "attack"))
			if #self.queue == 0 then
				self:ComboDone(now)
			end
			return
		end
		-- between its punches, in his reach, a boxer keeps his hands up: the guard costs it no punch (its next one drops
		-- it) and turns his head shots into chips - the defence quality that keeps a harder AI's fights going the
		-- rounds rather than a slugfest over in a minute; a raw boxer's hands hang more often
		if self:HandsUp(now, dist) then
			self:Note(now, "guard")
			return
		end
		self:Note(now, "waiting (in range)")
	elseif (dist <= jab + AIC.stepIn and (overdue or self.rng:NextNumber() < work * 0.8))
		or (self.mode ~= "survive" and now - math.max(self.lastThrowAt, F.lastPunch or -10) > 2 * gap and F.stamina >= 12) then
		-- (and a man who keeps out of its reach is walked down: long enough without a punch, it goes and gets him)
		-- a step in to punch: Range() draws it closer for a moment, the next think throws when it gets there
		self.closeUntil = now + 0.7
		self.nextMove = 0
		self.nextThink = math.min(self.nextThink, now + 0.15)
		self:HandsUp(now, dist) -- (walking in behind the guard)
		self:Note(now, string.format("step in %.1f > %.1f", dist, jab))
	else
		self:HandsUp(now, dist)
		self:Note(now, string.format("out of range %.1f > %.1f", dist, jab))
	end
end

-- is it being walked down? He is on top of it with his hands going (the engine's pressure: his punches from
-- inside in the last few seconds), or he crowds it at close range throwing
function FightAI:Pressed(dist, jab)
	local F, O, engine = self.F, self.O, self.engine
	if F.pressured then
		return true
	end
	return dist < jab * 0.85 and engine.RecentThrows ~= nil and engine:RecentThrows(O, 4) >= 4
end

-- the answers to pressure (a skilled boxer more often, a raw one hardly): off the ropes on a pivot, the step back
-- that makes him miss and the counter behind it, a short combination fired into the gap between his, the uppercut
-- as he walks in, the clinch that smothers him when it is tired or hurt. A pressure fighter who walks in throwing
-- pays for it; one who walks a raw boxer down still finds him there
function FightAI:AnswerPressure(now, dist, jab, clinchRange)
	local F, O, engine = self.F, self.O, self.engine
	if self.mode == "finish" or self.mode == "gamble" or engine.tutorial ~= nil or not self:Pressed(dist, jab) then
		return false
	end
	local k = (0.12 + 0.75 * self.skill) * math.min(1.35, self.tier.read)
	local r = self.rng:NextNumber()
	-- pinned on the ropes: turn him (the pivot) before anything else
	local myRope = engine.RopeDist and engine:RopeDist(F) or 99
	if myRope < 2.6 and now >= (F.nextPivot or 0) and r < k * 0.6 then
		engine:Pivot(F, self.circleDir)
		self:Note(now, "pressure: pivots off the ropes")
		return true
	end
	-- tired or hurt with him on top of it: tie him up
	local worn = F.stamina < F.maxStam * 0.35 or (F.tier or 0) >= 1 or (engine.Mom and engine:Mom(F) < -0.35)
	if worn and dist < clinchRange and engine:CanClinch(F) and self.rng:NextNumber() < k * 0.45 * self.tactics.smother then
		engine:Clinch(F)
		self:Note(now, "pressure: smothers him")
		return true
	end
	-- he is throwing in its face: the step back (he falls short; its counter window opens on the miss)
	if O.state == "punching" and F.stamina > F.maxStam * 0.3 and self.rng:NextNumber() < k * 0.3 then
		engine:Dodge(F, "pull", self.circleDir)
		self.nextThink = math.min(self.nextThink, F.busyUntil + 0.02)
		self:Note(now, "pressure: steps back")
		return true
	end
	if F.stamina < 10 then
		return false
	end
	-- he walks in: the uppercut (or the short hook) meets him on the way
	if O.state ~= "punching" and self.oBack < -0.6 and self:Fits("uppercut", dist) and self.rng:NextNumber() < k * 0.5 then
		local p = self.rng:NextNumber() < 0.6 and "uppercut" or "leadhook"
		self.queue = self:Fits("cross", dist) and self.rng:NextNumber() < 0.5 and { { p = "cross", body = false } } or {}
		self:Throw(p, false)
		self:ChainNext()
		self:Note(now, "pressure: meets him coming in")
		return true
	end
	-- the gap between his punches: a short combination first (inside, the hooks and uppercuts; the body to slow him)
	if O.state ~= "punching" and self:Fits("leadhook", dist) and self.rng:NextNumber() < k * 0.45 then
		local combos = { { "leadhook", "uppercut" }, { "uppercut", "leadhook" }, { "leadhook", "cross" }, { "rearhook", "leadhook" } }
		local c = combos[self.rng:NextInteger(1, #combos)]
		local bodyFirst = self.rng:NextNumber() < self.bodyBias + 0.15
		self.queue = { { p = c[2], body = false } }
		self:Throw(c[1], bodyFirst and c[1] ~= "uppercut")
		self:ChainNext()
		self:Note(now, "pressure: fires in his gap")
		return true
	end
	return false
end

-- the guard between its punches: inside his reach (his jab and a step) a boxer keeps his hands up whenever he
-- is not throwing - it costs no punch (its next one drops it), turns his head shots into chips and softens the
-- body shots: the defence quality that keeps a harder, busier AI's fights going the rounds instead of a slugfest
-- over in a minute. A raw boxer's hands hang more often; a blocking archetype and a high tier keep them up more
function FightAI:HandsUp(now, dist)
	local F, O, engine = self.F, self.O, self.engine
	if dist > engine:PunchRange(O, "jab") + 0.3 or F.state == "punching" then
		return false
	end
	-- (the guard slows the feet: a mover who wants out of range - an out-boxer's plan, a reset, a cruise - uses his
	-- footwork for his defence and keeps his hands free to move)
	local mover = self.mode == "outbox" or self.mode == "bait" or self.mode == "cruise" or self.mode == "reset"
	-- (but with his body going - the liver, the empty tank - even a mover keeps his elbows in)
	if F.body >= 50 and ((mover and dist < self:Range() * 0.95) or (self.style.id == "OutBoxer" and not F.onRopes)) then
		return false
	end
	-- (light: the guard slows the feet and the breath - the engine's - so a boxer keeps it up between his punches
	-- now and then, a raw one hardly at all; a man shelled up for every think lost the work rate and the fight)
	local k = (0.1 + 0.3 * self.skill) * (0.75 + self.arch.block) * (0.85 + 0.15 * self.tier.read) * (engine.aiDefense or 1)
	-- walked down, the hands stay up (the engine's guard costs little until it is a held shell: Config.FightDepth.shell)
	if self:Pressed(dist, engine:PunchRange(F, "jab")) then
		k = math.max(k * 1.8, (0.2 + 0.7 * self.skill) * math.min(1.3, self.tier.read) * (engine.aiDefense or 1))
	end
	if self.rng:NextNumber() < k then
		engine:SetBlock(F, true)
		self.blockUntil = math.max(self.blockUntil, now + 0.45 + 0.25 * self.skill)
		return true
	end
	return false
end

-- its own combination is out: a skilled boxer turns off at an angle now and then, a raw one drops its hands
function FightAI:ComboDone(now)
	local F, engine = self.F, self.engine
	self.lastCombo = now
	local after = F.busyUntil
	if self.rng:NextNumber() < AIC.drop * (1 - self.skill) * 1.6 then
		F.guardDropUntil = after + AIC.drop * (1 - self.skill)
	elseif self.skill > 0.5 and self.rng:NextNumber() < (self.skill - 0.5) * 0.6 and engine.tutorial == nil then
		local fightId = engine.id
		task.delay(math.max(0, after - now) + 0.02, function()
			if engine.id == fightId and not engine.finished and engine:CanAct(F) and F.state ~= "punching" then
				if F.stamina > 25 and self.rng:NextNumber() < 0.4 then
					engine:Dodge(F, "sidestep", self.circleDir)
				else
					engine:Pivot(F, self.circleDir)
				end
			end
		end)
	end
end

-- a feint (and the draw that comes with it: for a moment after, it is ready for his lead)
function FightAI:TryFeint(now, dist)
	local F, engine = self.F, self.engine
	if engine.tutorial or engine.spar or not engine.Feint or now < self.nextFeint then
		return false
	end
	local styleK = (self.style.id == "CounterPuncher" and 1.6) or (self.style.id == "OutBoxer" and 1.3) or (self.style.id == "BoxerPuncher" and 1.1) or 0.7
	-- (a chance a think, ~4 a second: about one feint a minute from a raw boxer, four or five from an elite one)
	local rate = (0.002 + 0.022 * self.skill) * styleK * (self.mode == "bait" and 1.5 or 1) * (0.7 + 0.3 * self.tier.read)
	-- he blocks the moment it throws: feints work on him
	rate *= 0.7 + self.read:ReactBlock()
	-- and a man who keeps making its punches miss (a slick counter-puncher) is drawn with the feint, not the punch: it
	-- shows him the jab, his defence goes, his counter is gone and its real one goes in
	local thrown = F.totals and F.totals.thrown or 0
	rate *= 1 + 2.5 * math.min(0.4, (self.obs.slips or 0) / math.max(15, thrown)) * (0.5 + 0.5 * self.skill)
	if F.stamina < F.maxStam * 0.3 or self.rng:NextNumber() > rate then
		return false
	end
	self.nextFeint = now + 1.2 + self.rng:NextNumber() * 1.5
	if engine:Feint(F) then
		self.drawUntil = now + 0.6
		-- (look again the moment it is set: if he bit, the punch goes in)
		self.nextThink = math.min(self.nextThink, F.busyUntil + 0.02)
		return true
	end
	return false
end

-- footwork: the distance by the plan, the ring cut off when he is near the ropes, out of the corner itself
function FightAI:Move(now, dist)
	local F, O, engine = self.F, self.O, self.engine
	local tier = F.tier or 0
	if self.rng:NextNumber() < 0.08 then
		self.circleDir = -self.circleDir
	end
	local M = MODES[self.mode] or MODES.plan
	local circle = self.circleDir * (self.style.id == "OutBoxer" and 0.45 or 0.22)
	if self.mode == "outbox" or self.mode == "bait" then
		-- (a pressure fighter coming in: circle more, don't back straight up)
		circle = self.circleDir * ((self.mode == "outbox" and 0.5 or 0.35) + (F.pressured and 0.15 or 0))
	elseif self.mode == "stalk" then
		circle = self.circleDir * 0.1
	end
	local cut = M.cut or 0
	-- [FrameTraits] a pressing frame cuts the ring (when it is coming forward at all)
	if cut > 0 or self.mode == "stalk" or self.mode == "swarm" or self.mode == "plan" then
		cut += self.frame.ai.press or 0
	end
	local oRope = engine.RopeDist and engine:RopeDist(O) or 99
	if cut > 0 then
		-- cut the ring off for real only when he is near the ropes; a skilled boxer does it better
		cut = cut * (oRope < 4 and (0.5 + 0.5 * self.skill) or (0.15 + 0.2 * self.skill))
		circle *= 0.5
	end
	-- a man who keeps circling one way (Observe's running mean of his side-steps) is cut off, not chased: a
	-- pressing boxer stands in his way (the ring-centre side) rather than circling himself
	local presses = cut > 0 or self.mode == "stalk" or self.mode == "swarm" or self.mode == "pressure" or self.mode == "finish" or self.mode == "gamble"
	if presses and math.abs(self.oCircle) > 0.35 and self.skill >= 0.3 then
		cut = math.max(cut, 0.4 + 0.4 * self.skill)
		circle *= 0.3
	end
	-- a man who keeps backing away (Observe's oBack) is followed and cut off, not let go
	if self.oBack > 1 and self.skill >= 0.3 and self.mode ~= "survive" and self.mode ~= "reset" then
		cut = math.max(cut, 0.3 + 0.4 * self.skill)
		circle *= 0.5
	end
	-- head movement on the way in: a boxer who knows his trade does not walk in with his head on the line
	if dist > self:Range() + 0.5 and dist < self:Range() + 3 and self.skill >= 0.35 and now >= F.busyUntil and F.stamina > F.maxStam * 0.4 and (O.state == "punching" or self.rng:NextNumber() < 0.08 + 0.1 * self.skill) then
		if self.rng:NextNumber() < 0.5 + 0.3 * self.skill then
			engine:Slip(F, self.rng:NextNumber() < 0.5 and -1 or 1)
		end
	end
	local myRope = engine.RopeDist and engine:RopeDist(F) or 99
	local backOff = self.mode == "outbox" or self.mode == "bait" or self.mode == "survive" or self.mode == "reset" or self.mode == "cruise"
	if self.mode == "survive" or (backOff and myRope < 2.5) then
		-- hurt, or a mover near the ropes: circle away hard toward open space (the ring centre), never along them
		local c = engine.anchors and engine.anchors.RingCenter
		if c and F.root and O.root then
			local toC = c.Position - F.root.Position
			local fromO = F.root.Position - O.root.Position
			local cross = fromO.X * toC.Z - fromO.Z * toC.X
			self.circleDir = cross >= 0 and -1 or 1
		end
		circle = self.circleDir * 0.6
		cut = 0
	end
	engine:MoveAI(F, self:Range(), circle, cut)
end

-- in the clinch: the man who tied up holds (and recovers); the other works the body inside when it is fresh and
-- he is tiring, or shoves off the break to come out at an angle when it wants to press
function FightAI:ClinchThink(now)
	local F, O, engine = self.F, self.O, self.engine
	if now < (self.nextClinchThink or 0) then
		return
	end
	self.nextClinchThink = now + 0.4 + (1 - self.skill) * 0.2
	local holding = engine.clinchBy == F
	if holding and (self.mode == "survive" or (F.tier or 0) >= 1) then
		return -- hold on
	end
	local inside = self.style.fight.inside or 1
	if F.stamina > F.maxStam * 0.3 and (O.stamina < O.maxStam * 0.5 or inside > 1.05 or self.mode == "pressure") and self.rng:NextNumber() < 0.4 then
		local p = self.rng:NextNumber() < 0.5 and "leadhook" or "uppercut"
		engine:Punch(F, p, true)
		return
	end
	if (self.mode == "pressure" or self.mode == "finish" or self.mode == "swarm" or self.mode == "gamble") and engine.BreakClinch and self.rng:NextNumber() < 0.35 then
		engine:BreakClinch(F)
	end
end

-- with more of the combination queued, think again the moment the punch's recovery ends: the next one lands
-- inside the chain window (Combos) instead of whenever the next think comes round
function FightAI:ChainNext()
	if #self.queue > 0 then
		self.nextThink = math.min(self.nextThink, self.F.busyUntil + 0.02 + self.rng:NextNumber() * 0.08 * (1.2 - self.skill))
	end
end

-- Special moves (the engine's Fight:Special, the fighter's unlocked set F.moves): each has a situation it
-- is for. Counters (shell, pull, step back) answer a punch that is on its way or the counter window; the
-- check hook meets a man walking in; the liver shot goes under a high guard or at a worn body; the gazelle
-- closes from long range; the rush is pressure; the overhand goes over a shell; the lead uppercut opens a
-- tight guard. The fight moves: the double jab works the outside, the feint-cross beats a high guard, the
-- body-head hook brings it down and goes over it, the jab-cross-hook presses and finishes, the shovel hook
-- is for a hurt man up close. At most one every few seconds, more from an aggressive or finishing fighter.
-- the range the move needs (else its own first punch's): the 1-2-3 is started at cross range so its hook reaches
local SPECIAL_RANGE = { gazelle = "cross", stepback = "jab", peekaboo = "cross", onetwothree = "cross" }
-- a gym partner keeps his tricks for the harder sessions: none in a Light spar, fewer and further apart in
-- a Medium or Hard one (fight night = 1); the punch pacing of the spar (SPAR.work) never adds to these
local SPAR_SPECIALS = { Light = 0, Medium = 0.4, Hard = 0.7 }
function FightAI:TrySpecial(now, dist)
	local F, O, engine = self.F, self.O, self.engine
	local sparMul = engine.spar and (SPAR_SPECIALS[engine.spar] or 1) or 1
	if not Moves or sparMul <= 0 or now < (self.nextSpecial or 0) or F.stamina < F.maxStam * 0.3 then
		return false
	end
	local pool, total = {}, 0
	local function add(id, w)
		local M = F.moves and F.moves[id] and Moves.Data[id]
		if not M or w <= 0 or now < F.nextSpecial or F.stamina < M.stam * 1.3 then
			return
		end
		local range = engine:PunchRange(F, SPECIAL_RANGE[id] or M.punch[1], M.range)
		if dist > range + 0.3 then
			return
		end
		table.insert(pool, { id, w })
		total += w
	end
	local coming = O.state == "punching" and now < O.busyUntil
	local counterWin = now < F.counterUntil
	local blocking = O.blocking or self:Intel().blockRatio > 0.4
	local finishing = self.mode == "finish" or self.mode == "pressure" or self.mode == "gamble"
	add("phillyshell", (coming and 0.6 or 0) + (counterWin and 0.4 or 0))
	add("pullcounter", (coming and 0.6 or 0) + (counterWin and 0.4 or 0))
	add("stepback", (coming and 0.5 or 0) + (self.mode == "survive" and 0.4 or 0))
	add("checkhook", (coming and 0.5 or 0) + (engine:IsHurt(O) and 0.2 or 0))
	-- (the liver shot folds a man well before his body is gone: kept for the moment - his guard high, his body
	-- going - not thrown at every shell, which turned a guard held up into a string of liver knockdowns)
	add("livershot", (blocking and 0.1 or 0.04) + (O.body < 50 and 0.1 or 0))
	add("gazelle", (dist > engine:PunchRange(F, "jab") and 0.5 or 0.05) + (finishing and 0.2 or 0))
	add("peekaboo", (finishing and 0.6 or 0.15))
	add("overhand", (blocking and 0.55 or 0.1) + (finishing and 0.25 or 0))
	add("leaduppercut", (blocking and 0.35 or 0.1) + (now < O.rollUntil and 0.6 or 0))
	local hurt = engine:IsHurt(O)
	add("doublejab", (dist > engine:PunchRange(F, "leadhook") and 0.45 or 0.1) + (self.mode == "survive" and 0.2 or 0))
	add("feintcross", (blocking and 0.55 or 0.15))
	add("bodyhead", (blocking and 0.3 or 0.15) + (O.body < 60 and 0.15 or 0))
	add("onetwothree", (finishing and 0.4 or 0.2) + (hurt and 0.2 or 0))
	add("shovelhook", (hurt and 0.6 or 0.1) + (finishing and 0.3 or 0))
	if total <= 0 then
		return false
	end
	-- a tentative fighter keeps its specials for the right moment; an aggressive one throws them freely
	local eager = (0.09 + self:Aggression() * 0.14 + (coming and 0.2 or 0)) * sparMul
	if self.rng:NextNumber() > eager then
		self.nextSpecial = now + 0.6
		return false
	end
	local pick = self.rng:NextNumber() * total
	for _, o in ipairs(pool) do
		pick -= o[2]
		if pick <= 0 then
			self.nextSpecial = now + (2.5 + self.rng:NextNumber() * 2.5) / sparMul
			self.queue = {}
			engine:Special(F, o[1])
			return true
		end
	end
	return false
end

-- corner advice for the PLAYER about this opponent (elite corner sees deeper)
function FightAI:Weakness()
	local s = self.F.data.stats
	local lowest, lowV = nil, 999
	for _, k in ipairs({ "Blocking", "HeadMovement", "Chin", "Stamina", "Footwork", "Reflexes" }) do
		if s[k] < lowV then
			lowest, lowV = k, s[k]
		end
	end
	local tips = {
		Blocking = "Their guard is leaky - straight punches are getting through. Double up the jab and cross!",
		HeadMovement = "Their head stays on the centre line. Throw power shots up top!",
		Chin = "That chin is suspect. Land one clean hook and they're going down!",
		Stamina = "Their gas tank is weak. Go to the body and make them carry it late!",
		Footwork = "They're flat-footed. Pivot off the ropes and make them reset!",
		Reflexes = "They're slow to react. Feint, then fire the overhand!",
	}
	-- a hidden trait the elite corner has spotted on the tapes
	local seen = self.F.traitSeen or {}
	for _, t in ipairs(self.F.traits or {}) do
		if not seen[t.id] then
			return "Watch it - he's " .. Traits.Data[t.id].name:lower() .. ". " .. Traits.Data[t.id].counter
		end
	end
	return tips[lowest]
end

return FightAI
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="98">
        <Properties>
          <string name="Name">FightEngine</string>
          <string name="Source"><![CDATA[-- FightEngine: server-authoritative real-time boxing.
-- Punches: jab, cross, lead hook, rear hook, uppercut, overhand (+ body shots).
-- Defense: block, parry, slip, roll, pivot, clinch. Counters, combos, stamina,
-- knockdowns + 10 count, KO/TKO, referee & doctor stoppages, visible face damage,
-- sweat, robes & mouthguards, venues, live commentary, three-judge scoring.
-- Also runs gym sparring sessions (Light / Medium / Hard).
-- Health model (CONTRACTS section 8): F.health IS head HP (tiers via Config.HeadTier: conscious /
-- dazed / severe danger / out on his feet), F.body is body HP, F.stamina with a cap that body damage
-- and the rounds erode. Knockdown odds per landed head shot come from Config.KOChance (chin,
-- conditioning, stamina, power, clean accuracy, previous damage); flash / normal / heavy / out-cold
-- knockdowns, stumbles and balance loss, concussion that slows, blurs and recovers, a mandatory
-- eight count with a referee check, and a referee NPC who moves, counts and waves it off.
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Builder = require(Shared:WaitForChild("Builder"))
local Officials = require(Shared:WaitForChild("Officials"))
-- the tournaments' belts and the celebration cutscene's beats (Shared.Tournaments / Shared.BeltModel): optional
local Tournaments, BeltModel
do
	local okT, modT = pcall(function()
		return require(Shared:WaitForChild("Tournaments", 5))
	end)
	Tournaments = okT and type(modT) == "table" and modT or nil
	local okB, modB = pcall(function()
		return require(Shared:WaitForChild("BeltModel", 5))
	end)
	BeltModel = okB and type(modB) == "table" and modB or nil
end
-- R-anim: how fighters go down (DownPose / DownDir / DownDist / KOKind), nil-safe if missing
local FightMotion
do
	local fm = Shared:FindFirstChild("FightMotion")
	if fm then
		local ok, mod = pcall(require, fm)
		FightMotion = ok and mod or nil
	end
end
-- special moves (Moves.lua: data + unlocks), nil-safe if the module is missing
local Moves
do
	local mm = Shared:FindFirstChild("Moves")
	if mm then
		local ok, mod = pcall(require, mm)
		Moves = ok and mod or nil
	end
end
-- the first-time tutorial fight's steps and rules (Tutorial.lua), nil-safe if missing
local Tutorial
do
	local tm = Shared:FindFirstChild("Tutorial")
	if tm then
		local ok, mod = pcall(require, tm)
		Tutorial = ok and type(mod) == "table" and mod or nil
	end
end
-- combinations (the chain window, named combos, their rules) and the dodges (evade windows by punch type)
local Combos = require(Shared:WaitForChild("Combos"))
local Evasion = require(Shared:WaitForChild("Evasion"))
-- the AI boxers' ring traits (resistances, scouting) and the player's fighting type
local Traits = require(Shared:WaitForChild("Traits"))
-- [FrameTraits] the body frame's permanent ring traits (Shared.FrameTraits): multiplied in at the places marked so
local FrameTraits = require(Shared:WaitForChild("FrameTraits"))
-- reach and hit volumes from the live rigs (Shared.HitGeometry: the client's prediction runs the same code);
-- optional: without it the ranges fall back to the old tape-based numbers
local HitGeometry
do
	local hg = Shared:FindFirstChild("HitGeometry")
	if hg then
		local ok, mod = pcall(require, hg)
		HitGeometry = ok and type(mod) == "table" and mod or nil
	end
end
local FightAI = require(script.Parent.FightAI)
local Career = require(script.Parent.Career)
-- the physics under a knockdown (server Ragdoll: hold the root, release the limbs after an out-cold KO):
-- optional, and loaded here with the module rather than at the knockdown (a require inside the fight's task
-- threads suspends the knockdown under the simulator's host)
local RagdollS
do
	local node = script.Parent:FindFirstChild("Ragdoll")
	if node then
		local okR, modR = pcall(require, node)
		RagdollS = okR and type(modR) == "table" and modR or nil
	end
end
-- [Entrance] the ring-walk cinematic's beats (RingWalk + Shared.Entrance): optional, the old walkout runs without it
local RingWalk
do
	local okR, modR = pcall(require, script.Parent:FindFirstChild("RingWalk"))
	RingWalk = okR and type(modR) == "table" and modR or nil
end
-- fight spacing (FightMotion.Spacing; the round-1 numbers if that module is missing)
local SPACING = FightMotion and FightMotion.Spacing
	or { base = 3.5, min = 2.85, minSep = 2.6, inside = 3, clinch = 4.4, pivot = 3.2, cover = 5 }

local FightEngine = {}
FightEngine.Active = {} -- player -> fight
local Fight = {}
Fight.__index = Fight

-- how hard punches land overall (Config.Damage: lower = longer fights). The head scale was 0.48 while the AI
-- threw ~30 punches a minute; a busy AI (40-50 a minute, more of them landing at the visible reach) needs less
-- per punch, or equal men stop each other in a round. Read at the punch (the balance sims sweep it)
local DAMAGE = Config.Damage
local HEAD_SCALE = DAMAGE.head
FightEngine.HEAD_SCALE = HEAD_SCALE

-- Head HP model: part of every head shot is "stun" that clears when the fighter gets a breather (a few
-- seconds without eating a head shot, a clinch, the corner); the rest is damage that stays all fight.
-- Recovery buys a bigger recoverable share. (The old flat regen gave back almost everything, so the
-- head tiers were never reached.)
local STUN_SHARE, STUN_PER_RECOVERY = 0.15, 0.002 -- share of head damage that is recoverable stun
local STUN_CLEAR, STUN_CLEAR_PER_RECOVERY = 0.5, 0.01 -- stun cleared per second once quiet
local STUN_QUIET = 2.5 -- seconds without a landed head shot before it starts to clear

local KO = Config.KO
local CONC = Config.Concussion
local FACE = Config.FaceDamage
local DEPTH = Config.FightDepth

-- work = how busy the gym partner is (FightAI multiplies its punch rate; a fight-night opponent is 1)
-- and range = how close he stays (a share of his normal distance). A sparring partner's job is to give
-- you rounds: at the old fight-night pace he threw ~5 punches in a Light round and never won a spar.
local SPAR = {
	Light = { rounds = 1, damage = 0.3, allowKD = false, work = 2.0, range = 0.86 },
	Medium = { rounds = 2, damage = 0.55, allowKD = false, work = 2.4, range = 0.84 },
	Hard = { rounds = 3, damage = 0.85, allowKD = true, work = 2.2, range = 0.82 },
	-- PvP sparring between two players: headgear, lighter shots, no knockdowns (the coach calls time)
	PvP = { rounds = 2, damage = 0.5, allowKD = false },
}
FightEngine.SparSettings = SPAR

-- every numeric field of the face damage table (CONTRACTS section 8); nose is a bool, cutSide/cutSide2 are -1|1
local DMG_FIELDS = { "leftEye", "rightEye", "cut", "cut2", "noseBleed", "bruise", "lip", "cheekL", "cheekR", "forehead", "earL", "earR", "redness", "ribsL", "ribsR" }
local DMG_CAP = { cut = 1.2, cut2 = 1.2 }

local function flat(v)
	return Vector3.new(v.X, 0, v.Z)
end

local function unitOr(v, fallback)
	if v.Magnitude > 0.05 then
		return v.Unit
	end
	return fallback
end

-- how high a character's root stands above the floor: its own rig's hip height + half the root (the
-- classic rig's 2 + 1, but the athletic rigs stand 3.2-4.7). Placing at a fixed 3.2 put tall boxers' feet
-- inside the canvas and the Humanoid sprang them up (a pop, and a jump the Animator read as root motion)
local function standHeight(hum, root)
	-- (an R6 rig reports HipHeight 0: its legs hold it at the classic 3)
	if hum and root and hum.HipHeight > 0.5 then
		return hum.HipHeight + root.Size.Y / 2 + 0.05
	end
	return 3.2
end
FightEngine.StandHeight = standHeight

-- the rig's size against the classic R15 the fight spacing was fitted on (FightMotion.RigFactor) and its
-- standing height (studs, sole to crown; the server sees the rig in its rest pose)
local function rigSize(model, hum, root)
	local ut = model and model:FindFirstChild("UpperTorso")
	local k = 1
	if ut and ut:IsA("BasePart") and FightMotion and FightMotion.RigFactor then
		local depth = nil
		local nv = hum and hum:FindFirstChild("BodyDepthScale")
		if nv and nv:IsA("NumberValue") then
			depth = nv.Value
		elseif hum then
			local ok, desc = pcall(function()
				return hum:GetAppliedDescription()
			end)
			depth = ok and desc and desc.DepthScale or nil
		end
		k = FightMotion.RigFactor(ut.Size.Z, depth)
	end
	local head = model and model:FindFirstChild("Head")
	local height = nil
	if head and head:IsA("BasePart") and root then
		height = standHeight(hum, root) + (head.Position.Y + head.Size.Y / 2 - root.Position.Y)
	end
	return k, height
end

-- a fighter's body as the hit detection sees it (HitGeometry frame): off the rig's parts when it has them, else
-- from Builder.Scales of his app and the tale of the tape (the headless sims' stub rigs, an old record)
local function geoFrame(F)
	if not HitGeometry then
		return nil
	end
	local data = F.data or {}
	local app = type(data.app) == "table" and table.clone(data.app) or { gender = 1 }
	app.height = tonumber(data.height) or app.height or 70
	local ok, sc = pcall(Builder.Scales, app, data.build, nil)
	local fallback = HitGeometry.FrameFromScales(ok and sc or nil, { height = app.height, reach = tonumber(data.reach), female = app.gender == 2 })
	local root = F.root
	local soleY = root and root.Position and (root.Position.Y - standHeight(F.hum, root)) or nil
	local okF, frame = pcall(HitGeometry.Frame, F.model, soleY, fallback)
	-- the fallback is explicit: why the rig was not used (HitGeometry.Frame's reason, an error, a frame with a hole
	-- in it), kept on the fighter for the diagnostic and warned once per fighter - never a frame with reach 0 / NaN
	local why = nil
	if not okF then
		why, frame = "Frame errored: " .. tostring(frame), fallback
	elseif type(frame) ~= "table" then
		why, frame = "no frame", fallback
	elseif frame.fallback then
		why = tostring(frame.fallback)
	end
	if HitGeometry.Invalid and HitGeometry.Invalid(frame) then
		why = (why and (why .. "; ") or "") .. "fallback invalid (" .. tostring(HitGeometry.Invalid(frame)) .. "): the unit frame"
		frame = HitGeometry.Unit()
	end
	F.geoFallback = why
	if why and not F.geoWarned then
		F.geoWarned = true
		-- (the headless sims' stub rigs are a root alone: not worth a line)
		if not why:find("a root alone", 1, true) then
			warn(string.format("[Boxer] hit geometry: fallback for %s: %s (%s)", tostring(data.name or (F.model and F.model.Name) or "?"), why,
				HitGeometry.Describe and HitGeometry.Describe(frame) or "frame"))
		end
	end
	-- [FrameTraits] a long-armed frame reaches further at the same height (the client gets this frame in `start`)
	local reachBonus = (F.frame or FrameTraits.For(data)).reachBonus or 1
	if type(frame) == "table" and type(frame.arm) == "number" and reachBonus ~= 1 then
		frame = table.clone(frame)
		frame.arm *= reachBonus
	end
	return frame
end

-- server attributes are change-only (CONTRACTS ground rules)
local function setAttr(inst, k, v)
	if inst and inst:GetAttribute(k) ~= v then
		inst:SetAttribute(k, v)
	end
end

local function his(F)
	return (type(F.data.app) == "table" and F.data.app.gender == 2) and "her" or "his"
end

local function quant(v, step)
	return math.floor(v / step + 0.5) * step
end

-- slides a fighter by `delta` studs: the root's CFrame carries the whole welded rig (one assembly move),
-- where Model:PivotTo walks the ~270-part model and moves every part (60% of a spar's server Lua)
local function shift(F, delta)
	F.root.CFrame += delta
end

local function newDamage(seed, mul)
	local d = { cutSide = 1, cutSide2 = -1, nose = false, age = 0 }
	for _, k in ipairs(DMG_FIELDS) do
		d[k] = 0
	end
	if type(seed) == "table" then
		-- a fight starts from the residual of earlier fights: swelling and half-healed cuts open up quicker
		for _, k in ipairs(DMG_FIELDS) do
			local v = tonumber(seed[k])
			if v then
				d[k] = math.clamp(v * mul, 0, DMG_CAP[k] or 1)
			end
		end
		d.nose = seed.nose == true
		if seed.cutSide == -1 or seed.cutSide == 1 then
			d.cutSide = seed.cutSide
		end
		if seed.cutSide2 == -1 or seed.cutSide2 == 1 then
			d.cutSide2 = seed.cutSide2
		end
	end
	return d
end

local function cloneDamage(d)
	local c = table.clone(d)
	c.age = 0
	return c
end

------------------------------------------------------------------------
-- Fighter setup
------------------------------------------------------------------------
local MENTAL_DEFAULTS = { "Confidence", "Discipline", "Aggression", "Focus", "Composure" }

-- an AI boxer's signature combos (Combos.ForAI): its tier as Moves.ForAI reads it (an overall of 55 is a Local
-- Pro, 65 Regional, 75 Top 10, 85 a champion) and its record
local function aiSignatures(data)
	local tier = tonumber(data.tier)
	if not tier then
		local ov = Config.Overall(data.stats)
		tier = ov >= 85 and 8 or (ov >= 75 and 6 or (ov >= 65 and 4 or (ov >= 55 and 2 or 1)))
	end
	return Combos.ForAI(tier, type(data.record) == "table" and data.record or nil)
end

local function makeFighter(data, model, player)
	data.stats = type(data.stats) == "table" and data.stats or {}
	data.mental = type(data.mental) == "table" and data.mental or {}
	local s = data.stats
	for _, k in ipairs(Config.StatKeys) do
		if type(s[k]) ~= "number" then
			s[k] = 50
		end
	end
	for _, k in ipairs(MENTAL_DEFAULTS) do
		if type(data.mental[k]) ~= "number" then
			data.mental[k] = 50
		end
	end
	data.class = tonumber(data.class) or 5
	local style = Config.FindById(Config.Styles, data.style) or Config.Styles[4]
	local mods = data.mods or {}
	-- AI boxers carry the raw Training.FightModifiersFromBuild output: fold the neck's chin bonus in
	-- here (once). The player's Training.FightModifiers already added it through mods.stats.Chin, which
	-- Career.FighterFromProfile applied to the stats.
	-- (the level the ring traits scale with: the overall the world and the offer card show, before the chin fold)
	local overall = Config.Overall(s)
	if data.isPlayer ~= true and type(mods.chinAdd) == "number" and not data.chinApplied then
		data.chinApplied = true
		s.Chin = math.clamp(s.Chin + mods.chinAdd, 10, Config.StatCap)
	end
	local frameTraits = FrameTraits.For(data) -- [FrameTraits] (F.frame below)
	local maxStam = (100 + (s.Stamina - 50) * 0.8) * (mods.staminaMul or 1) * frameTraits.tank -- [FrameTraits] the tank
	local fatigueFactor = 1 - math.max(0, (data.fatigue or 0) - 50) / 150
	-- career head trauma and an unhealed concussion mean the fighter walks in already "shaky"
	local conc = (tonumber(data.trauma) or 0) * CONC.startFromTrauma + (data.concussed and CONC.activeInjury or 0)
	conc = math.clamp(conc, 0, 0.6)
	local F = {
		data = data, model = model, player = player, isPlayer = player ~= nil,
		hum = model:FindFirstChildOfClass("Humanoid"), root = model:FindFirstChild("HumanoidRootPart"),
		style = style, classScale = 0.85 + (data.class - 1) * 0.045,
		-- [FrameTraits] the body frame's permanent traits (data.app.body.frame; Athletic without one)
		frame = frameTraits,
		powerMul = mods.powerMul or 1, speedMul = mods.speedMul or 1, moveMul = mods.moveMul or 1,
		maxStam = maxStam, stamCap = maxStam, stamina = maxStam * fatigueFactor, stamErosion = 0,
		health = 100, healthCap = 100, body = 100, bodyCap = 100,
		tier = 0, stun = 0, conc = conc, concPeak = conc, balance = 100, strain = 0, downSeverity = nil,
		state = "idle", blocking = false, busyUntil = 0,
		slipUntil = 0, rollUntil = 0, parryUntil = 0, pivotEvadeUntil = 0, angleUntil = 0, nextPivot = 0,
		counterUntil = 0, hurtUntil = 0, clinchUntil = 0, nextClinch = 0, lastPunch = 0, combo = 0, hand = "R",
		stumbleUntil = 0, stumbleVel = nil, stumbleSpeed = 0, stumbles = 0, lastHitAt = -10, lastBodyHitAt = -10, headTaken = 0,
		kdRound = 0, kdTotal = 0, mash = 0, actId = 0, recentHits = {}, damageDealt = 0, damageTaken = 0,
		dmg = newDamage(data.face, FACE.seedFromResidual),
		tally = { landed = 0, power = 0, body = 0, thrown = 0, kd = 0, clinches = 0 },
		totals = { landed = 0, thrown = 0, power = 0, body = 0 },
		punchesUsed = { jab = 0, cross = 0, leadhook = 0, rearhook = 0, uppercut = 0, overhand = 0 },
		-- special moves: the unlocked set (Main computes the player's from the profile; an AI boxer gets its
		-- style's), the running move, its set-up's evade window and its cooldown
		moves = type(data.moves) == "table" and data.moves or (Moves and player == nil and Moves.ForAI(data)) or {},
		special = nil, specialToken = 0, nextSpecial = 0, shellUntil = 0, shellKind = nil, shellHit = false, specialsUsed = 0,
		lungeUntil = 0, lungeVel = nil,
		-- combinations (Combos): the running chain, the buffered press, the signature combos owned (Main computes the
		-- player's from the profile, an AI boxer's come from its tier and record), the fight's combo stats
		chain = nil, buffered = false, comboStats = Combos.NewStats(),
		sigs = type(data.sigs) == "table" and data.sigs or (player == nil and aiSignatures(data)) or {},
		-- the dodges (Evasion): the one running, its evade window and its end (after the window and before the end a
		-- punch CATCHES him), and the last defence's start / cost (a new dodge may cancel it: the pad's chords)
		dodgeKind = nil, dodgeUntil = 0, dodgeEnd = 0, defAt = -10, defCost = 0, defCancelled = false, dodges = 0, evades = 0,
		-- console aim assist level from the saved settings (0 off, 1 low, 2 high); the device the server holds
		-- the fighter on ("kbd" until a rate-limited device message says pad), when it switched, how often it
		-- switched lately, when the last input of each device arrived and when the server last saw the
		-- analog stick in Humanoid.MoveDirection (Fight:AssistBonus)
		assist = math.clamp(math.floor(tonumber(data.assist) or 0), 0, 2), padAt = -10, kbdAt = -10, assistNext = 0,
		device = "kbd", deviceAt = -10, deviceSwitches = 0, deviceWindow = -100, assistLockUntil = 0, analogAt = -100, moveSeen = false,
		-- the deeper fight (Config.FightDepth): the feint (when, the bite's opening, the recent ones), the second
		-- wind (left, running until, time spent gassed), the punches of the last seconds (pressure), being walked
		-- down / on the ropes, a raw AI's dropped hands, the slip's side, the clinch's inside work, the stats of
		-- the fighting type (Traits.FightingType)
		feintAt = -10, feintOpenUntil = 0, feintTimes = {}, feints = 0, feintBites = 0,
		windLeft = ((s.Stamina >= 75 or (data.mental.Discipline or 50) >= 80) and 2 or 1), windUntil = 0, gassedFor = 0, winds = 0,
		throwTimes = {}, pressured = false, onRopes = false, guardDropUntil = 0, slipDir = 0,
		clinchHits = 0, clinchNext = 0, clinchAt = 0,
		typeStats = { thrown = 0, body = 0, heavy = 0, counters = 0, landed = 0, pressT = 0, liveT = 0 },
		-- the ring traits (Shared.Traits): every AI boxer's from his seed, style and level (traitsAll); the fight
		-- switches them on (traits) only for a career bout; traitSeen = the ones revealed / hinted so far
		traitsAll = (player == nil and data.isPlayer ~= true) and Traits.ForBoxer({ id = data.id, style = data.style, archetype = data.archetype, overall = overall }) or {},
		traits = {}, traitSeen = {}, traitHints = {},
	}
	-- what the fighter walked in with, so the result reports only what happened in THIS fight
	-- (an old, healing broken nose or half-closed cut must not be "news" that restarts the healing clock)
	F.noseAtStart = F.dmg.nose == true
	F.cutAtStart = math.max(F.dmg.cut, F.dmg.cut2)
	F.dmgStart = table.clone(F.dmg)
	-- a tournament's later rounds (Career: data.carry = Tourney.Carry): he walks in with what the earlier rounds took
	-- out of him, as lower head / body health caps (never under 60%)
	if type(data.carry) == "table" then
		F.healthCap = 100 * math.clamp(tonumber(data.carry.head) or 1, 0.6, 1)
		F.bodyCap = 100 * math.clamp(tonumber(data.carry.body) or 1, 0.6, 1)
		F.health, F.body = F.healthCap, F.bodyCap
	end
	return F
end

-- the fight's damage table minus what the fighter walked in with: a zone that did not get worse
-- tonight reports 0. The seed is the healing residual, and Career heals that over the suspension
-- before it merges res.face, so reporting it again would bring old marks back fresh (age 0) and
-- flag an old cut as new (a second scar for it). A zone that did get worse keeps its full value.
local function tonightDamage(F)
	local d = cloneDamage(F.dmg)
	local start = F.dmgStart or {}
	for _, k in ipairs(DMG_FIELDS) do
		if d[k] <= (tonumber(start[k]) or 0) + 0.01 then
			d[k] = 0
		end
	end
	return d
end
FightEngine.TonightDamage = tonightDamage

function Fight:Now()
	return os.clock()
end

-- a pause in the flow that ends early when the fight is over (a PvP forfeit during the rest minute)
function Fight:Wait(t)
	local t0 = os.clock()
	while os.clock() - t0 < t and not self.finished and not self.aborted do
		task.wait(math.min(0.25, t))
	end
end

function Fight:Distance(A, B)
	if not (A.root and B.root) then
		return 99
	end
	return flat(A.root.Position - B.root.Position).Magnitude
end

-- Ranges fit the rigs: with these shoulders and arms a jab lands with the arm nearly straight at about
-- 4.4 studs root to root, and two guards have about a stud of air between them at the AI's usual 3.4-4.4
-- (FightMotion.Spacing; the client fits each punch to the actual distance)
-- mul (optional) = a special move's range multiplier (Moves.Data.range): applied BEFORE the floor, so a short
-- move (liver shot 0.95, lead uppercut 0.9) still reaches a man standing as close as the bodies allow
-- the fight's close floor, root to root: inside it every punch reaches and only the height decides
-- (HitGeometry.Test; the client's prediction is handed the same number in `start`). The pair's scaled spacing,
-- and never under the bodies' separation plus FLOOR_AIR: so wherever the engine lets the two men stand
-- (Fight:MinSep, Fight:Separate) a jab reaches - the invariant MinSep + 0.3 < PunchRange(jab), tested in
-- tools/sim/test_hitdetect against frames off the real part sizes
local FLOOR_AIR = 0.3
FightEngine.FLOOR_AIR = FLOOR_AIR
function Fight:Floor()
	local floor = (self.sp or SPACING).min
	if self.P and self.O then
		floor = math.max(floor, self:MinSep() + FLOOR_AIR)
	end
	return floor
end

function Fight:PunchRange(F, ptype, mul)
	local floor = self:Floor()
	local G, OG = self:Geo(F), self:Geo(self:Other(F))
	if G and OG then
		-- the live rigs (HitGeometry.Reach): how far out this man's punch LANDS on the other - on the head at a
		-- level stance, or on the body where a head shot falls there (a short man's jab at a tall head is thrown
		-- from where it lands low: Resolve's HitTest redirects it, it does not refuse it); the frames never change
		-- in a fight, so each punch is worked out once
		local key = ptype .. "|" .. tostring(mul or 1)
		F.rangeCache = F.rangeCache or {}
		local r = F.rangeCache[key]
		if not r then
			r = HitGeometry.Reach(G, OG, ptype, { mul = mul, floor = floor })
			F.rangeCache[key] = r
		end
		-- never shorter than the closest the bodies get, so every punch can land up close (the height still
		-- decides there: Fight:HitTest)
		return math.max(floor, r)
	end
	-- (no HitGeometry: the tape's reach and height, as before)
	local base = SPACING.base + ((F.data.reach or 70) - 70) * 0.05 + ((F.data.height or 70) - 70) * 0.02
	return math.max(floor, base * (Config.Punches[ptype] and Config.Punches[ptype].range or 1) * (mul or 1))
end

-- a fighter's HitGeometry frame (built once, from his rig or his tape: geoFrame); nil without the module
function Fight:Geo(F)
	if not HitGeometry or not F then
		return nil
	end
	if not F.geo then
		F.geo = geoFrame(F)
	end
	return F.geo
end

-- what the two sizes favour in F's hands (HitGeometry.PunchPrefs: ptype -> weight), nil without the module
function Fight:GeoPrefs(F)
	local G, OG = self:Geo(F), self:Geo(self:Other(F))
	if not (G and OG) then
		return nil
	end
	return (HitGeometry.PunchPrefs(G, OG))
end

-- how bent over the man is right now, 0..1 (HitGeometry lowers his head and chest by it): a roll or a weave takes
-- him right down, a duck and a body-shot crouch most of the way, a slip and a hurt man's hunch a little
function Fight:Bend(O)
	local now = self:Now()
	local bend = 0
	if now < (O.rollUntil or 0) then
		bend = 1
	elseif O.dodgeKind == "weave" and now < (O.dodgeEnd or 0) then
		bend = 0.9
	elseif O.dodgeKind == "duck" and now < (O.dodgeEnd or 0) then
		bend = 0.8
	end
	if O.state == "punching" and O.punchBody then
		bend = math.max(bend, 0.5)
	end
	if now < (O.slipUntil or 0) then
		bend = math.max(bend, 0.3)
	end
	if self:IsHurt(O) or (O.tier or 0) >= 1 then
		bend = math.max(bend, 0.25)
	end
	if O.blocking then
		bend = math.max(bend, 0.1)
	end
	return bend
end

-- does F's punch reach O from dist (root to root)? The geometry of the two rigs (HitGeometry.Test): his glove's
-- path against O's head or body, O's bend, the fight's close floor. Returns the test's verdict table (ok, zone,
-- why = "short" | "high" | "low", redirected = a head shot that lands on the body); without the module, the old
-- range check as a verdict
-- pose (optional) = { fp, op, look }: the two flat positions and F's flat facing to test from (Resolve's lag
-- compensation: the press as his client saw it); else where they stand now. The facing is the punch's cone
-- (HitGeometry.FACING): a man turned off the line throws his straight past the head ("wide")
function Fight:HitTest(F, O, ptype, body, dist, mul, pose)
	local G, OG = self:Geo(F), self:Geo(O)
	if not (G and OG) then
		local ok = dist <= self:PunchRange(F, ptype, mul)
		return { ok = ok, zone = body and "body" or "head", why = (not ok) and "short" or nil }
	end
	return HitGeometry.Test(G, OG, ptype, body, dist, { mul = mul, floor = self:Floor(), bend = self:Bend(O), noRedirect = ptype == "overhand",
		facing = self:OffLine(F, O, pose) })
end

-- can F's punch land on O at all from dist, on the head or (where the head is out of its reach - a much taller man's)
-- on the body, as Fight:Punch would throw it? The geometry alone (his bend, not his facing: the AI squares up as it
-- throws). FightAI's "in range": PunchRange is floored at the close spacing, where a short man's overhand at a giant's
-- head still cannot get up there. True without the module
function Fight:CanLand(F, O, ptype, dist)
	local G, OG = self:Geo(F), self:Geo(O)
	if not (G and OG and HitGeometry) then
		return true
	end
	local o = { bend = self:Bend(O), noRedirect = true }
	if HitGeometry.Test(G, OG, ptype, false, dist, o).ok then
		return true
	end
	return ptype ~= "overhand" and HitGeometry.Test(G, OG, ptype, true, dist, o).ok
end

-- degrees between F's facing and the line from him to O (flat); nil when either root is missing. pose = { fp, op,
-- look } tests a recorded moment instead of the live one
function Fight:OffLine(F, O, pose)
	local fp, op, look
	if pose then
		fp, op, look = pose.fp, pose.op, pose.look
	elseif F.root and O.root then
		fp, op = F.root.Position, O.root.Position
		local ok, lv = pcall(function()
			return F.root.CFrame.LookVector
		end)
		look = ok and lv or nil
	end
	if not (fp and op and look) then
		return nil
	end
	local to = flat(op - fp)
	local lf = flat(look)
	if to.Magnitude < 0.05 or lf.Magnitude < 0.05 then
		return nil
	end
	return math.deg(math.acos(math.clamp(to.Unit:Dot(lf.Unit), -1, 1)))
end

------------------------------------------------------------------------
-- Lag compensation for the player's punches. The client predicts a punch at the press (FightClient's PredAct) against
-- the opponent where it sees him; the server resolves it a network delay and the wind-up later, when he may have
-- moved. Every fighter's flat position is recorded each frame (RecordPose, POSE_KEEP seconds), the client stamps
-- its press with workspace:GetServerTimeNow() (`at`), and Resolve also tests the punch against the opponent's
-- position at the press as the client saw it (the press time less the replication's interpolation): when the live
-- test fails only by movement (its margin within LAG_TOL) the press-time verdict stands. An AI punch (no `at`) is
-- never compensated: it reasons in server time.
------------------------------------------------------------------------
-- POSE_KEEP = the history kept (s: the longest rewind is the wind-up plus both legs of the lag and the interpolation);
-- POSE_INTERP = the replication's interpolation buffer the client renders the other man behind by; LAG_MAX = the
-- most one-way delay credited; LAG_TOL = how far (studs) a live miss may be and still stand as the client's hit
-- when the press-time test lands (the disagreement only movement); VIEW_MAX = the most a player's screen is taken
-- to run behind the server when it decides whether he SAW a dodge start (Fight:Evaded)
local POSE_KEEP, POSE_INTERP, LAG_MAX, LAG_TOL, VIEW_MAX = 1.5, 0.1, 0.3, 0.35, 0.25
-- the end of the reach (Fight:Resolve): the last STRETCH share of a punch's reach is a glancing shot, its hit
-- chance down to STRETCH_HIT[1] of itself and its damage to STRETCH_DMG[1] at the very edge
local STRETCH, STRETCH_HIT, STRETCH_DMG = 0.35, { 0.4 }, { 0.45 }
FightEngine.STRETCH = { share = STRETCH, hit = STRETCH_HIT[1], dmg = STRETCH_DMG[1] }
FightEngine.LAG_TOL = LAG_TOL
local function serverTime()
	local ok, t = pcall(function()
		return workspace:GetServerTimeNow()
	end)
	return ok and tonumber(t) or nil
end
FightEngine.ServerTime = serverTime
function Fight:RecordPose(F, now)
	if not F.root then
		return
	end
	local h = F.poseHist
	if not h then
		h = {}
		F.poseHist = h
	end
	local p = F.root.Position
	local okL, lv = pcall(function()
		return F.root.CFrame.LookVector
	end)
	lv = okL and lv or nil
	table.insert(h, { t = now, x = p.X, z = p.Z, bend = self:Bend(F), lx = lv and lv.X or 0, lz = lv and lv.Z or -1 })
	while #h > 2 and now - h[1].t > POSE_KEEP do
		table.remove(h, 1)
	end
end
-- F's flat position at time t (interpolated; nil without a history reaching back that far) and his flat facing then
function Fight:PoseAt(F, t)
	local h = F.poseHist
	if not h or #h == 0 or t < h[1].t - 0.05 then
		return nil
	end
	local prev = h[1]
	for i = 2, #h do
		local cur = h[i]
		if cur.t >= t then
			local span = cur.t - prev.t
			local k = span > 1e-6 and math.clamp((t - prev.t) / span, 0, 1) or 1
			return Vector3.new(prev.x + (cur.x - prev.x) * k, 0, prev.z + (cur.z - prev.z) * k),
				Vector3.new((prev.lx or 0) + ((cur.lx or 0) - (prev.lx or 0)) * k, 0, (prev.lz or -1) + ((cur.lz or -1) - (prev.lz or -1)) * k)
		end
		prev = cur
	end
	return Vector3.new(prev.x, 0, prev.z), Vector3.new(prev.lx or 0, 0, prev.lz or -1)
end
-- the press as the attacker's client saw it, for a punch resolving now after `windup` (the server's wind-up from
-- when the press arrived) and `lag` (its one-way delay): his own character where it was when the press arrived
-- (his client moves it and it replicates with that delay: the server's copy at the arrival is his screen at the
-- press), the defender where his screen showed him at the press - the server's state another leg of the lag and
-- the interpolation buffer before it. Returns { fp, op, look, dist } or nil without the history
function Fight:PressPose(F, O, lag, windup)
	if not (F.root and O.root) then
		return nil
	end
	local now = self:Now()
	local arrive = now - (windup or 0)
	local fp, look = self:PoseAt(F, arrive)
	local op = self:PoseAt(O, arrive - 2 * (lag or 0) - POSE_INTERP)
	if not (fp and op) then
		return nil
	end
	return { fp = fp, op = op, look = look, dist = flat(fp - op).Magnitude }
end
-- (the old reader: the press-time distance alone)
function Fight:CompDistance(F, O, lag)
	local pp = self:PressPose(F, O, lag, 0)
	return pp and pp.dist or nil
end

-- the closest the two bodies get, centre to centre (the pair's scaled spacing, and no less than their real torsos
-- and gloves need: HitGeometry.MinSep), and no less than two BLADED torsos need: a boxer stands turned
-- ~BLADE rad off square, so the chest he presents across the line between the roots is torsoHalfD x cos +
-- torsoHalfW x sin (a Heavyweight frame's 1.17-wide chest is what meets the other man, not its depth alone),
-- plus both pairs of gloves (SEP_GLOVE x the glove radii, as HitGeometry.MinSep) and SEP_AIR of air. The unit
-- (Athletic) pair gives the balanced 3.25 either way; a Heavyweight pair 3.57 by depth, 3.70 bladed.
local BLADE, SEP_GLOVE, SEP_AIR = math.rad(35), 1.6, 0.5194
local function bladedHalf(G)
	return G.torsoHalfD * math.cos(BLADE) + G.torsoHalfW * math.sin(BLADE)
end
function Fight:MinSep()
	local base = (self.sp or SPACING).minSep
	if not self.minSepGeo then
		local G, OG = self:Geo(self.P), self:Geo(self.O)
		if G and OG then
			local bladed = bladedHalf(G) + bladedHalf(OG) + SEP_GLOVE * (G.glove + OG.glove) + SEP_AIR * (G.hScale + OG.hScale) / 2
			self.minSepGeo = math.max(HitGeometry.MinSep(G, OG), bladed)
		else
			self.minSepGeo = 0
		end
	end
	return math.max(base, self.minSepGeo)
end

-- a body's share of a separation push: the lighter man gives more ground (his torso's volume from the frame,
-- x the height: a Heavyweight at 1.17 x 1.16 x 1 against a Lean man at 0.92 x 0.94 gives ~60 / 40)
function Fight:BodyMass(F)
	local G = self:Geo(F)
	if not G then
		return 1
	end
	return math.max(0.2, G.torsoHalfW * G.torsoHalfD * G.hScale / (0.795 * 0.485))
end

-- the spacing the pair keeps right now, centre to centre: the clinch distance while they hold, else MinSep
function Fight:SepRadius()
	if self.P.state == "clinch" or self.O.state == "clinch" then
		return self:ClinchSep()
	end
	return self:MinSep()
end

-- pos (a goal, a glide step, a lunge) pushed back out of the other man's body: a spot nearer than radius
-- (SepRadius) to O's root, read where O will be in a moment (his MoveDirection x WalkSpeed x LOOKAHEAD, so two
-- men closing on each other stop short together instead of each walking into where the other was), comes out
-- along the line from O to it (a spot right on him comes out toward F). Nothing is clamped against a man on
-- the canvas, or for one (the fall rooms and the corner walks are theirs).
local LOOKAHEAD = 0.08
function Fight:KeepOut(F, pos, radius)
	local O = self:Other(F)
	if not (O and O.root and F.root) or O.state == "down" or F.state == "down" then
		return pos
	end
	radius = radius or self:SepRadius()
	local op = O.root.Position
	local hum = O.hum
	if hum and hum.WalkSpeed and hum.WalkSpeed > 0 and hum.MoveDirection then
		local mv = flat(hum.MoveDirection)
		if mv.Magnitude > 0.1 then
			op += mv * (hum.WalkSpeed * LOOKAHEAD)
		end
	end
	local d = flat(pos - op)
	local m = d.Magnitude
	if m >= radius then
		return pos
	end
	local dir = m > 0.05 and d.Unit or unitOr(flat(F.root.Position - op), flat(F.root.CFrame.LookVector) * -1)
	local out = op + dir * radius
	return Vector3.new(out.X, pos.Y, out.Z)
end

-- the walk from F's root to goal routed round the bodies in the way: when the straight line passes within
-- radius (SepRadius + ROUTE_AIR) of the other man's root, F heads for the tangent point on that circle on the
-- goal's side of him instead (a man circling or cutting off the ring walks round the other, never through him:
-- KeepOut alone clamps the end of the walk, not the way there), and likewise round the referee (refR, his own
-- keep-out) when he stands in the line. Re-planned every Heartbeat (Separate) and every Glide step, so the
-- tangent point slides round as he goes; returns goal when the line is clear. Nothing is routed round a man on
-- the canvas, or for one.
local ROUTE_AIR, DOWN_ROOM = 0.15, 0.5
-- do the flat segments a-b and c-d cross (strictly)?
local function segCross(a, b, c, d)
	local function cr(o, p, q)
		return (p.X - o.X) * (q.Z - o.Z) - (p.Z - o.Z) * (q.X - o.X)
	end
	return cr(c, d, a) * cr(c, d, b) < 0 and cr(a, b, c) * cr(a, b, d) < 0
end
-- avoid (optional): a waypoint it returns true for is not taken (the other way round is tried; nil when neither)
local function tangentWay(fp, goal, op, r, avoid)
	local seg = flat(goal - fp)
	local L = seg.Magnitude
	if L < 0.05 then
		return nil
	end
	local a = flat(fp - op)
	local d = a.Magnitude
	local t = math.clamp(-a:Dot(seg) / (L * L), 0, 1)
	if t <= 0 or flat(fp + seg * t - op).Magnitude >= r then
		return nil -- (the line clears him, or leads away from him)
	end
	if t >= 1 then
		return nil -- (the nearest point is the goal itself: KeepOut has put that outside him)
	end
	local au = d > 0.05 and a / d or unitOr(Vector3.new(-seg.Z, 0, seg.X), Vector3.new(1, 0, 0))
	-- from outside the circle the tangent point; from on it a step round it on a circle wide enough that the
	-- chord stays outside r (0.6 rad of arc: cos 0.3 = 0.955)
	local ang, rr
	if d > r * 1.02 then
		ang, rr = math.acos(math.clamp(r / d, -1, 1)), r
	else
		ang, rr = 0.6, r / math.cos(0.3)
	end
	local best, bestD
	for _, sgn in ipairs({ 1, -1 }) do
		local w = op + CFrame.Angles(0, sgn * ang, 0):VectorToWorldSpace(au) * rr
		local gd = flat(goal - w).Magnitude
		if (not best or gd < bestD) and not (avoid and avoid(w)) then
			best, bestD = w, gd
		end
	end
	if not best then
		return false -- (both ways round ruled out)
	end
	return Vector3.new(best.X, goal.Y, best.Z)
end
function Fight:RouteAround(F, goal, radius, refR)
	local O = self:Other(F)
	if not (F.root and O and O.root) or F.state == "down" then
		return goal
	end
	if O.state == "down" then
		-- (a man on the canvas is walked round, never over: his body lies along his height from the root)
		return tangentWay(F.root.Position, goal, O.root.Position, self:MinSep() + DOWN_ROOM) or goal
	end
	local fp = F.root.Position
	local r = (radius or self:SepRadius()) + ROUTE_AIR
	local way = tangentWay(fp, goal, O.root.Position, r) or goal
	-- (then the referee, on the leg actually walked: a detour round the other man may lead through him)
	local R = self.ref
	if refR and R and R.root and R.mode ~= "count" and R.mode ~= "catch" then
		local w2 = tangentWay(fp, way, R.root.Position, refR)
		if w2 then
			way = self:KeepOut(F, w2, r)
		end
	end
	return way
end

-- how far out F can tie the other man up: his arms' reach (HitGeometry.ClinchRange), never inside the bodies
-- and never inside the distance the clinch itself is held at (ClinchSep: the tie-up slides the pair out to it)
function Fight:ClinchRange(F)
	local G, OG = self:Geo(F), self:Geo(self:Other(F))
	if not (G and OG) then
		return math.max((self.sp or SPACING).clinch, self:ClinchSep() + 0.3)
	end
	F.clinchRange = F.clinchRange or math.max(HitGeometry.ClinchRange(G, OG), self:MinSep() + 0.4, self:ClinchSep() + 0.3)
	return F.clinchRange
end

-- the player ends a sparring session early (the spar HUD's Leave Sparring): the coach's cards so far decide it,
-- the session pays out its share (res.partial: the rounds boxed over the rounds booked) and the round loop ends
-- as it does on any stoppage (Cleanup restores the player, Main's runSpar puts him back in the gym)
function Fight:LeaveSpar(F)
	if not self.spar or self.pvp or not F.isPlayer or self.finished or self.aborted then
		return false
	end
	local now = self:Now()
	local boxed = math.max(0, (self.round or 0) - 1)
	if self.live and self.roundSeconds > 0 then
		boxed += math.clamp((self.roundSeconds - math.max(0, (self.roundEnd or now) - now)) / self.roundSeconds, 0, 1)
	end
	local d = Career.DecideCards(self.cards)
	self.sparExit = {
		outcome = d.outcome, method = "Ended", reason = "Session ended early", round = math.max(1, self.round or 1),
		partial = math.clamp(boxed / math.max(1, self.rounds or 1), 0.1, 1),
	}
	self.finished = true
	self.live = false
	self.winner = d.outcome == "win" and self.P or (d.outcome == "loss" and self.O or nil)
	self.method, self.reason, self.endRound = "Ended", "Session ended early", self.round
	self:Send({ t = "announce", text = "COACH: \"That's time. Good work today.\"" })
	return true
end

function Fight:IsHurt(F)
	return self:Now() < F.hurtUntil
end

function Fight:IsStumbling(F)
	return self:Now() < F.stumbleUntil
end

function Fight:Other(F)
	return F == self.P and self.O or self.P
end

function Fight:HeadDamage(F, hd)
	F.headTaken += hd
	F.health = math.max(0, F.health - hd)
	F.stun = math.min(60, F.stun + hd * (STUN_SHARE + F.data.stats.Recovery * STUN_PER_RECOVERY))
end

-- give back up to `amount` of the recoverable stun
function Fight:ClearStun(F, amount)
	local give = math.min(F.stun, amount)
	if give > 0 then
		F.stun -= give
		F.health = math.min(F.healthCap, F.health + give)
	end
end

-- how much a dazed / concussed fighter's defensive windows shrink (slip, roll, parry, pivot)
function Fight:DefenseMul(F)
	-- [FrameTraits] the frame's dodge windows (a Lean man slips longer, a heavyweight shorter)
	return math.max(0.35, (1 - CONC.tierDefense * F.tier) * (1 - CONC.defense * F.conc)) * F.frame.dodgeWindow
end

------------------------------------------------------------------------
-- The deeper fight: ring traits, momentum, ring position, vision (Config.FightDepth, Shared.Traits)
------------------------------------------------------------------------
-- the strength of one of F's ring traits tonight (0 = he doesn't have it, or this bout has none)
function Fight:Trait(F, id)
	return Traits.Strength(F.traits, id)
end

-- trait id of D's just made a difference against A: the first time it is revealed (if it was hidden) and A's
-- corner calls it, after that a hint now and then (at most 4 a fight, 9 s apart); the AI never needs telling
function Fight:TraitFired(D, id)
	local A = self:Other(D)
	local now = self:Now()
	local h = D.traitHints[id]
	if not h then
		h = { n = 0, at = -100 }
		D.traitHints[id] = h
	end
	h.fired = (h.fired or 0) + 1
	local reveal = not D.traitSeen[id]
	if not reveal and (h.n >= 4 or now - h.at < 9) then
		return
	end
	D.traitSeen[id] = true
	h.n += 1
	h.at = now
	local T = Traits.Data[id]
	if A.player then
		self:SendTo(A, { t = "trait", id = id, name = T.name, hint = T.hint, counter = T.counter, reveal = reveal or nil })
	end
end

-- momentum: -1..1, positive = the red corner (P). Mom(F) = from F's side; Swing(F, x) moves it toward F
function Fight:Mom(F)
	local m = self.mom or 0
	return F == self.P and m or -m
end
function Fight:Swing(F, x)
	if self.tutorial then
		return
	end
	local m = (self.mom or 0) + (F == self.P and x or -x)
	self.mom = math.clamp(m, -1, 1)
end

-- how far F stands from the ropes (studs; the ring's usable square, ClampToRing) and whether he is on them with
-- the other man inside him (between him and the ring centre)
function Fight:RopeDist(F)
	if not (F.root and self.anchors) then
		return 99
	end
	local off = flat(F.root.Position - self.anchors.RingCenter.Position)
	local half = self.ringHalf - 1.5
	return half - math.max(math.abs(off.X), math.abs(off.Z))
end
function Fight:OnRopes(F)
	local O = self:Other(F)
	if not (F.root and O.root and self.anchors) or self:RopeDist(F) > DEPTH.ropeDist then
		return false
	end
	local c = self.anchors.RingCenter.Position
	local toC = flat(c - F.root.Position)
	local toO = flat(O.root.Position - F.root.Position)
	return toC.Magnitude < 0.5 or (toO.Magnitude > 0.05 and toC.Unit:Dot(toO.Unit) > 0.2)
end
-- the share of the ropes' penalty that applies to F (a Ring General slides off them; the body work slows his legs)
function Fight:RopeMul(F)
	local s = self:Trait(F, "RingGeneral")
	if s <= 0 then
		return 1
	end
	return 1 - Traits.Effect("RingGeneral", "corner", s) * math.clamp(F.body / 100 + 0.2, 0.3, 1)
end

-- how blind F is on one side (side 1 = his right, -1 = his left): the swollen eye, a cut bleeding into it
function Fight:Blind(F, side)
	local d = F.dmg
	local eye = side == 1 and d.rightEye or d.leftEye
	local cut = 0
	if d.cut > 0.4 and d.cutSide == side then
		cut = d.cut * 0.35
	end
	if d.cut2 > 0.4 and d.cutSide2 == side then
		cut = math.max(cut, d.cut2 * 0.35)
	end
	return math.clamp(math.max(0, eye - 0.25) / 0.75 + cut, 0, 1)
end

-- the punches F threw in the last `win` seconds (the ring buffer is trimmed as it is read)
function Fight:RecentThrows(F, win)
	local now = self:Now()
	local t = F.throwTimes
	local n = 0
	for i = #t, 1, -1 do
		if now - t[i] <= win then
			n += 1
		elseif now - t[i] > 8 then
			table.remove(t, i)
		end
	end
	return n
end

-- F's fighting type tonight (Traits.FightingType over what he has done)
function Fight:FightingType(F)
	local st = F.typeStats
	return Traits.FightingType({
		style = F.style.id, thrown = st.thrown, minutes = math.max(0.25, st.liveT / 60), body = st.body, heavy = st.heavy,
		counters = st.counters, landed = st.landed, pressing = st.liveT > 0 and st.pressT / st.liveT or 0,
	})
end

-- a defence F just started (a dodge, a slip, a block going up...): if the other man feinted a moment ago, F
-- bit on it (the feinter's next punch is open); the AI's read learns the player's defences
function Fight:NoteDefense(F, kind, dir)
	local O = self:Other(F)
	local now = self:Now()
	if now - O.feintAt <= DEPTH.feint.bite and now > O.feintOpenUntil then
		O.feintOpenUntil = now + DEPTH.feint.open
		O.feintBites += 1
		-- (the counter he was saving is gone: he spent it on air)
		F.counterUntil = math.min(F.counterUntil, now)
		self:Swing(O, 0.03)
		if O.player then
			self:SendTo(O, { t = "intel", hint = "He bit on the feint! Fire now!", tone = "good" })
		end
	end
	if O.ai and O.ai.read and kind ~= "block" then
		O.ai.read:Dodge(kind, dir)
	end
end

------------------------------------------------------------------------
-- Messaging & visuals
------------------------------------------------------------------------
-- Every message is written from the red corner's (P's) point of view: who = "you" means P. A PvP bout
-- has a second player in the blue corner (O); his copy gets "you" / "opp" swapped, so each client sees
-- the fight from its own side. Messages whose content differs per side (state, start, rest, final, the
-- cut call) are built per viewer with SendEach / SendTo.
local FLIP = { you = "opp", opp = "you" }

-- the fighters that have a client watching (P always in a career fight / spar, O too in PvP)
function Fight:Viewers()
	local out = {}
	for _, F in ipairs({ self.P, self.O }) do
		if F and F.player and not F.gone then
			table.insert(out, F)
		end
	end
	return out
end

function Fight:SendTo(V, msg)
	local plr = V and V.player
	if plr and plr.Parent and not V.gone then
		self.remote:FireClient(plr, msg)
	end
end

function Fight:Send(msg)
	for _, V in ipairs(self:Viewers()) do
		local m = msg
		if V ~= self.P and type(msg.who) == "string" and FLIP[msg.who] then
			m = table.clone(msg)
			m.who = FLIP[msg.who]
		end
		self:SendTo(V, m)
	end
end

-- fn(V) -> the message for viewer V (or nil to send nothing)
function Fight:SendEach(fn)
	for _, V in ipairs(self:Viewers()) do
		local m = fn(V)
		if m then
			self:SendTo(V, m)
		end
	end
end

function Fight:Who(F)
	return F == self.P and "you" or "opp"
end

function Fight:Comment(text, priority)
	local now = self:Now()
	if not priority and now - (self.lastComment or 0) < 2.5 then
		return
	end
	self.lastComment = now
	self:Send({ t = "comment", text = text })
end

-- chain = the punch's place in its combination (the model attribute Chain, set BEFORE Act / ActId so the
-- Animator reads it with the act: Combos header); every other act sets it to 0
function Fight:SetAct(F, act, chain)
	setAttr(F.model, "Chain", chain or 0)
	F.actId += 1
	F.model:SetAttribute("Act", act)
	F.model:SetAttribute("ActId", F.actId)
end

function Fight:UpdateGuard(F)
	local g = "stance"
	if F.guardOverride then
		g = F.guardOverride -- walkout / rest / win / lose
	elseif F.state == "down" then
		g = "down"
	elseif F.blocking then
		g = "block"
	elseif F.state == "clinch" then
		g = "clinch"
	elseif self:IsHurt(F) or self:IsStumbling(F) then
		g = "hurt"
	elseif F.tier >= 1 then
		g = "dazed"
	end
	setAttr(F.model, "Guard", g)
end

-- face expression for the Animator's face rig (Config.Expressions)
function Fight:ExprFor(F)
	if F.exprOverride then
		return F.exprOverride
	end
	local now = self:Now()
	if F.state == "down" then
		return F.downSeverity == "out" and "ko" or "dazed"
	end
	if F.tier >= 2 or (F.tier >= 1 and F.conc > 0.35) then
		return "dazed"
	end
	if now < F.hurtUntil or now < F.stumbleUntil or now - F.lastHitAt < 0.5 or now - F.lastBodyHitAt < 0.5 then
		return "pain"
	end
	if F.state == "clinch" or (F.state == "punching" and F.combo >= 3) then
		return "effort"
	end
	if F.stamina < F.maxStam * 0.22 then
		return "fatigue"
	end
	if F.tier == 1 then
		return "fear"
	end
	local O = self:Other(F)
	if O.tier >= 1 or O.state == "down" then
		return "anger" -- smells blood
	end
	if self:EstimateLead(F) >= 1 or (F.data.mental.Confidence > 70 and F.health > 70) then
		return "confident"
	end
	return "determined"
end

-- quantized, change-only model attributes the Animator / face rig / client read (CONTRACTS section 7)
function Fight:SyncAttrs(F)
	local m = F.model
	if not m then
		return
	end
	setAttr(m, "HeadHP", quant(math.clamp(F.health / 100, 0, 1), 0.02))
	setAttr(m, "BodyHP", quant(math.clamp(F.body / 100, 0, 1), 0.02))
	setAttr(m, "Stam", quant(math.clamp(F.stamina / F.maxStam, 0, 1), 0.02))
	setAttr(m, "Daze", F.tier)
	setAttr(m, "Conc", quant(F.conc, 0.05))
	setAttr(m, "Strain", quant(math.clamp(F.strain, 0, 1), 0.1))
	setAttr(m, "Expr", self:ExprFor(F))
end

-- face damage rebuilds are throttled: a flurry marks the face dirty and Update redraws it at most
-- twice a second, so the server never rebuilds the Damage folder on every punch
function Fight:RefreshDamage(F, force)
	local d = F.dmg
	local bits = {}
	for i, k in ipairs(DMG_FIELDS) do
		bits[i] = string.format("%.1f", d[k])
	end
	local key = table.concat(bits, ",") .. tostring(d.nose) .. d.cutSide .. d.cutSide2
	if key == F.dmgKey then
		F.dmgDirty = false
		return
	end
	local now = self:Now()
	if not force and now < (F.dmgNext or 0) then
		F.dmgDirty = true
		return
	end
	F.dmgKey = key
	F.dmgDirty = false
	F.dmgNext = now + 0.5
	local ok, err = pcall(Builder.SetDamage, F.model, F.data.app, d)
	if not ok then
		warn("[Boxer] SetDamage failed:", err)
	end
end

-- head tier changes drive the HUD chip, the dazed body language and the AI's game plan
function Fight:CheckTier(F)
	local t = Config.HeadTier(F.health)
	if t == F.tier then
		return
	end
	local rising = t > F.tier
	F.tier = t
	setAttr(F.model, "Daze", t)
	self:Send({ t = "tier", who = self:Who(F), tier = t })
	if rising and F.state ~= "down" then
		local name = F.data.name
		if t == 1 then
			self:Comment(name .. " is HURT! Those legs just did a little dance!", true)
		elseif t == 2 then
			self:Comment(name .. " is in serious trouble! One more clean shot could end it!", true)
		else
			self:Comment(name .. " is OUT ON " .. his(F):upper() .. " FEET! " .. self:Official(true) .. " is watching closely!", true)
		end
	end
	for _, X in ipairs({ self.P, self.O }) do
		if X.ai then
			X.ai:UpdateMode()
		end
	end
end

------------------------------------------------------------------------
-- Actions (used by both the player's input and the AI)
------------------------------------------------------------------------
function Fight:CanAct(F)
	return not self.finished and self.live and not self.paused and F.state ~= "down" and F.state ~= "clinch"
end

-- the wind-up multiplier of this fighter right now: hand speed, class, fatigue, and a dazed or concussed
-- fighter is a beat slow on everything
local function punchSpeed(F, stamPct)
	local s = F.data.stats
	local speedMul = (1.25 - s.PunchSpeed / 200) * (stamPct < 0.3 and 1.25 or 1)
	speedMul /= (1.08 - (F.data.class - 1) * 0.02) * F.speedMul
	speedMul /= F.frame.handSpeed -- [FrameTraits] hand speed (FightClient.predWindup mirrors it)
	return speedMul * (1 + CONC.tierWindup * F.tier) * (1 + CONC.windup * F.conc)
end

-- Console aim assist: a small hit-chance forgiveness (Low 2 / High 4 points) for punches thrown from a
-- gamepad. The level comes from the SAVED settings (never from a message). The device is the one the
-- SERVER holds the fighter on: it starts as the keyboard, a `device` message moves it, switches are
-- rate-limited (ASSIST.switches in ASSIST.switchWindow seconds; more lock the help for the rest of the
-- window) and a switch to the pad arms the help only ASSIST.arm seconds later. On top of that every input
-- is tagged with its device: any keyboard / mouse / touch input in the last ASSIST.kbdOff seconds switches
-- the help off, and the punch itself has to be a pad one. Last, the one thing the server can SEE: the
-- character's Humanoid.MoveDirection replicates from the client, and a thumbstick gives fractional
-- magnitudes where a keyboard gives exactly 0 or 1 (Fight:SampleDevice). Once the server has seen this
-- fighter move at all in the fight, the help needs an analog magnitude within ASSIST.analog seconds, so a
-- keyboard client claiming the pad gets nothing. The bonus is capped (never lifts a punch past
-- ASSIST.cap) and counts for at most ASSIST.perRound punches a round.
local ASSIST_BONUS = { 0, 0.02, 0.04 }
local ASSIST = { arm = 2, kbdOff = 5, padFresh = 1.5, analog = 10, switches = 3, switchWindow = 30, cap = 0.85, perRound = 25 }
function Fight:AssistBonus(F)
	if not F.isPlayer or F.assist <= 0 or F.device ~= "pad" then
		return 0
	end
	local now = self:Now()
	if now < F.assistLockUntil or now - F.deviceAt < ASSIST.arm then
		return 0
	end
	if now - F.kbdAt < ASSIST.kbdOff or now - F.padAt > ASSIST.padFresh then
		return 0
	end
	if F.moveSeen and now - F.analogAt > ASSIST.analog then
		return 0
	end
	if (F.assistCount or 0) >= ASSIST.perRound then
		return 0
	end
	F.assistCount = (F.assistCount or 0) + 1
	return ASSIST_BONUS[F.assist + 1] or 0
end
FightEngine.ASSIST = ASSIST

-- the client's device changed (FightEngine.Input `device`): rate-limited, and it only ever LOWERS the help
-- at once (a switch to the keyboard is immediate, a switch to the pad arms later)
function Fight:SetDevice(F, pad)
	local dev = pad and "pad" or "kbd"
	if dev == F.device then
		return
	end
	local now = self:Now()
	if now - F.deviceWindow > ASSIST.switchWindow then
		F.deviceWindow = now
		F.deviceSwitches = 0
	end
	F.deviceSwitches += 1
	if F.deviceSwitches > ASSIST.switches then
		-- flapping between devices: no help until the window is over
		F.assistLockUntil = F.deviceWindow + ASSIST.switchWindow
	end
	F.device = dev
	F.deviceAt = now
	if dev == "kbd" then
		F.kbdAt = now
	end
end

-- once a frame: what the replicated MoveDirection says about the device (a stick gives in-between magnitudes)
function Fight:SampleDevice(F, now)
	local hum = F.hum
	if not (F.isPlayer and hum) then
		return
	end
	local m = hum.MoveDirection.Magnitude
	if m > 0.02 then
		F.moveSeen = true
		if m < 0.96 then
			F.analogAt = now
		end
	end
end

-- The Moves & Controls menu stops a SOLO fight (career, sparring; never a PvP bout): the client asks
-- (`pause`) while the window is open. The round stops at the next quiet moment (nobody mid-punch or
-- down, no count running), and then everything waits: the clock, the AI, stamina and every recovery
-- (Update's rdt), and the timers still running are carried over the pause. It resumes when the window
-- closes, or after MENU_PAUSE.cap seconds with it still open; a new pause needs MENU_PAUSE.gap seconds
-- of boxing after the last one.
local MENU_PAUSE = { cap = 60, gap = 3 }
FightEngine.MENU_PAUSE = MENU_PAUSE
local CARRY = { "hurtUntil", "stumbleUntil", "clinchUntil", "counterUntil", "angleUntil", "nextClinch", "nextSpecial", "nextPivot", "slipUntil",
	"rollUntil", "parryUntil", "pivotEvadeUntil", "shellUntil", "lungeUntil", "busyUntil", "dodgeUntil", "dodgeEnd",
	"feintOpenUntil", "windUntil", "guardDropUntil", "clinchNext" }
function Fight:MenuPause(F, on)
	if self.pvp or not F.isPlayer or self.finished then
		return
	end
	if on then
		F.menuAt = F.menuAt or self:Now()
	else
		F.menuAt = nil
	end
end

-- once a frame in a live round: start / end the menu's hold (the knockdown count has its own, kdHold)
function Fight:UpdateMenuHold(now)
	local P = self.P
	local want = P.menuAt ~= nil and now - P.menuAt < MENU_PAUSE.cap
	local pending = false
	if want and not self.menuHold then
		local quiet = not self.kdHold and P.state ~= "punching" and P.state ~= "down" and self.O.state ~= "punching" and self.O.state ~= "down"
		if now - (self.menuEndAt or -100) < MENU_PAUSE.gap then
			want = false
		elseif not quiet then
			-- the AI starts nothing new meanwhile, so the quiet moment comes
			want, pending = false, true
		end
	end
	self.menuPending = pending
	if want == (self.menuHold == true) then
		return
	end
	self.menuHold = want
	self.paused = self.kdHold == true or want
	if want then
		self.menuStartAt = now
	else
		local dur = now - (self.menuStartAt or now)
		for _, F in ipairs({ self.P, self.O }) do
			for _, k in ipairs(CARRY) do
				if type(F[k]) == "number" and F[k] > (self.menuStartAt or now) then
					F[k] += dur
				end
			end
			F.lastHitAt += dur
			F.lastBodyHitAt += dur
			if F.chain and not F.chain.closed then
				F.chain.closeAt += dur -- (a combination's window waits over the pause too)
			end
		end
		self.menuEndAt = now
		self.resumedAt = now
	end
	self:SendTo(P, { t = "pause", on = want, why = (not want and P.menuAt ~= nil) and "cap" or nil, cap = MENU_PAUSE.cap })
end

-- Shift in the ring (FightEngine.Input `sprint`, held): quicker feet to cut him off or get off the ropes.
-- Not while punching or behind the guard, it drains stamina while he moves and stops when he is gassed.
local SPRINT = { mul = 1.3, drain = 7, floor = 0.15 }
function Fight:SetSprint(F, on)
	F.sprintOn = on == true and F.isPlayer
end
function Fight:Sprinting(F)
	return F.sprintOn == true and F.hum ~= nil and F.state ~= "punching" and not F.blocking and F.stamina > F.maxStam * SPRINT.floor
end

-- counter = a counter jab / cross (Q + click, E + right click): the punch comes straight out of the slip
-- (the slip's recovery does not hold it) and counts as a counter when it catches the other man punching.
-- Combinations (Shared.Combos): a punch thrown inside the last one's chain window continues its chain; a press
-- up to Combos.BUFFER before the recovery ends is held and thrown on the frame it ends (fromBuffer); an earlier
-- one is refused and counted against the chain as a mash
function Fight:Punch(F, ptype, body, counter, fromBuffer, pressAt)
	local P = Config.Punches[ptype]
	if P and F.state == "clinch" and not self.finished and self.live and not self.paused then
		-- in the clinch a punch is inside work: a short shot to the body (Fight:ClinchWork)
		return self:ClinchWork(F, ptype)
	end
	if not P or not self:CanAct(F) then
		return
	end
	local now = self:Now()
	-- only the straight counters (jab / cross, all the keymap sends) skip the slip's recovery, once per slip
	local outOfSlip = counter == true and (ptype == "jab" or ptype == "cross") and now - (F.slipAt or -10) < 0.6 and F.state ~= "punching"
	if now < F.busyUntil and not outOfSlip and not (fromBuffer and now >= F.busyUntil - 0.03) then
		if F.state == "punching" and not F.special and not fromBuffer then
			if F.busyUntil - now <= Combos.BUFFER and not F.buffered then
				F.buffered = true
				local fightId = self.id
				task.delay(F.busyUntil - now, function()
					if self.id == fightId and not self.finished then
						F.buffered = false
						self:Punch(F, ptype, body, counter, true, pressAt)
					end
				end)
			elseif F.chain and not F.chain.closed then
				F.chain.mash += 1 -- (a wild press: the chain's accuracy pays for it)
			end
		end
		return
	end
	if outOfSlip then
		F.slipAt = -10
	end
	local O = self:Other(F)
	if O.state == "down" then
		return
	end
	if ptype == "overhand" then
		body = false
	elseif not body and HitGeometry then
		-- a head shot the geometry says lands on the body from here (a much taller man out at range) is thrown
		-- at the body: the act (and the client's prediction, which runs the same test) aims where it will land
		local pre = self:HitTest(F, O, ptype, false, self:Distance(F, O))
		if pre.redirected then
			body = true
		end
	end
	F.punchBody = body == true
	local s = F.data.stats
	local stamPct = F.stamina / F.maxStam
	local windup = P.windup * punchSpeed(F, stamPct)
	-- (Granite: almost impossible to drop, but slow)
	windup *= 1 + Traits.Effect("Granite", "windup", self:Trait(F, "Granite"))
	-- the chain: inside the window it goes on, else a new one starts (the old one is scored)
	local chained = Combos.Continues(F.chain, now)
	if not chained then
		self:CloseChain(F)
		F.chain = Combos.NewChain(now)
	end
	local chain = F.chain
	F.combo = chain.punches + 1
	if chained and chain.punches > 0 then
		windup *= Combos.CHAIN_WINDUP
	end
	F.lastPunch = now
	local cost = P.stam * (body and 1.1 or 1) * (1.2 - s.Endurance / 250) * Combos.StamMul(F.combo)
	cost *= F.frame.staminaDrain * (ptype ~= "jab" and F.frame.powerDrain or 1) -- [FrameTraits] the frame's economy
	F.stamina = math.max(0, F.stamina - cost)
	F.blocking = false
	F.state = "punching"
	F.special = nil -- a plain punch replaces whatever special was still being thrown
	F.dodgeKind = nil
	F.busyUntil = now + windup * Combos.RECOVERY_MUL
	chain.closeAt = F.busyUntil + Combos.Window(windup)
	F.assistNext = self:AssistBonus(F)
	local hand = P.hand
	if ptype == "uppercut" then
		hand = (F.hand == "R" and F.combo > 1) and "L" or "R"
	end
	F.hand = hand
	local item = Combos.AddPunch(chain, { tok = Combos.Token(ptype, body, hand), p = ptype, body = body == true, cost = cost, at = now, windup = windup }, F.sigs)
	-- (with the act flag the Animator reads, Combos header: the punch's place in the combination)
	-- (a chained punch also carries its place as the act's sixth field, the Animator's format: "jab|L|head|0.16||2")
	local act = string.format("%s|%s|%s|%.2f", ptype, hand, body and "body" or "head", windup)
	if F.combo >= 2 then
		act ..= "||" .. F.combo
	end
	self:SetAct(F, act, F.combo)
	F.tally.thrown += 1
	F.totals.thrown += 1
	F.punchesUsed[ptype] = (F.punchesUsed[ptype] or 0) + 1
	self:NoteThrow(F, ptype, body)
	if O.ai then
		O.ai:OnOppPunch(ptype, body, windup, { hand = hand, chainPos = F.combo })
	end
	if self.tutorial and F == self.P then
		self:TutorialNote({ k = "punch", p = ptype, body = body == true })
		if item.named then
			self:TutorialNote({ k = "combo", id = item.named.id, counter = item.named.counter == true })
		end
	end
	local fightId = self.id
	local opts = { counterPunch = outOfSlip or nil, chain = item, chainRef = chain, windup = windup }
	-- the player's press time (the client's workspace:GetServerTimeNow()): the network delay it arrived with, for
	-- Resolve's lag compensation; nothing for an AI punch or a stamp that makes no sense
	if F.isPlayer and type(pressAt) == "number" and pressAt == pressAt then
		local st = serverTime()
		if st then
			local lag = st - pressAt
			if lag >= -0.05 and lag <= 1 then
				opts.lag = math.clamp(lag, 0, LAG_MAX)
			end
		end
	end
	task.delay(windup, function()
		if self.id == fightId and not self.finished then
			self:Resolve(F, O, ptype, body, stamPct, opts)
		end
	end)
end

-- a punch thrown (plain or a special's): the pressure clock, the fighting type's stats, the AI's read of him
function Fight:NoteThrow(F, ptype, body)
	local now = self:Now()
	table.insert(F.throwTimes, now)
	if #F.throwTimes > 24 then
		table.remove(F.throwTimes, 1)
	end
	local st = F.typeStats
	st.thrown += 1
	if body then
		st.body += 1
	end
	local kind = Config.Punches[ptype] and Config.Punches[ptype].kind
	if kind ~= "straight" then
		st.heavy += 1
	end
	local O = self:Other(F)
	if O.ai and O.ai.read then
		O.ai.read:Punch(ptype, body == true, F.combo, self:Distance(F, O), F.stamina < F.maxStam * 0.3)
	end
end

-- The feint (the `feint` input; Config.FightDepth.feint): a fake jab - the shoulder and the lead hand jump, no
-- punch comes. Cheap, quick, and if the other man reacts to it (a block, a slip, a dodge within `bite` s) he
-- bit: the next punch is open (Fight:NoteDefense). The AI sees it as it would see a jab (it cannot know); a feint
-- spammed costs more stamina and the AI's read learns to stop biting. A flick-then-button on a pad may turn the
-- flick's parry into the feint (Evasion.CANCEL), as the dodges do.
function Fight:Feint(F)
	local FT = DEPTH.feint
	if not self:CanAct(F) or self:Other(F).state == "down" then
		return false
	end
	local now = self:Now()
	if now < F.busyUntil then
		if not (F.state ~= "punching" and not F.defCancelled and now - F.defAt < Evasion.CANCEL) then
			return false
		end
		-- (the flick's parry / slip turns into the feint: half its stamina back, its window off)
		F.stamina += F.defCost * 0.5
		F.slipUntil, F.rollUntil, F.parryUntil, F.pivotEvadeUntil, F.dodgeUntil = 0, 0, 0, 0, 0
		F.dodgeKind = nil
		F.defCancelled = true
	end
	local recent = 0
	for i = #F.feintTimes, 1, -1 do
		if now - F.feintTimes[i] <= FT.spamWin then
			recent += 1
		else
			table.remove(F.feintTimes, i)
		end
	end
	local cost = FT.stam + math.max(0, recent - FT.spamFree) * FT.spamStam
	if F.stamina < cost then
		return false
	end
	F.stamina -= cost
	table.insert(F.feintTimes, now)
	F.feints += 1
	F.feintAt = now
	F.blocking = false
	F.state = "idle"
	F.busyUntil = now + FT.busy
	F.hand = "L"
	-- (the Animator plays it as a short, light jab: the act's power field keeps it a pump, not a punch)
	self:SetAct(F, string.format("jab|L|head|%.2f|0.20", FT.windup))
	local O = self:Other(F)
	if O.ai then
		O.ai:OnOppPunch("jab", false, Config.Punches.jab.windup * punchSpeed(F, F.stamina / F.maxStam), { feint = true, hand = "L", chainPos = 1 })
		if O.ai.read then
			O.ai.read:Feint()
		end
	end
	return true
end

-- the end of a fighter's chain: scored into his combo stats, and the HUD's counter told it is over
function Fight:CloseChain(F)
	local chain = F.chain
	if not chain or chain.closed then
		return
	end
	local sum = Combos.Close(chain)
	Combos.Record(F.comboStats, sum)
	local O = self:Other(F)
	if O and O.ai and O.ai.OnOppComboEnd then
		O.ai:OnOppComboEnd(sum.punches or 0)
	end
	if sum.punches >= 2 then
		self:Send({ t = "comboEnd", who = self:Who(F), hits = sum.landed, n = sum.punches, name = sum.named and sum.named.name or nil })
	end
end

-- a punch of a chain has its result (res = "landed" | "blocked" | "miss"): the combo rules (Combos.Result) and
-- the HUD's counter / call-outs
function Fight:ChainResult(F, O, sp, res)
	local it, chain = sp and sp.chain, sp and sp.chainRef
	if not (it and chain) or it.res then
		return
	end
	local ev = Combos.Result(chain, it, res)
	if res == "miss" and chain.punches >= Combos.WHIFF_FROM then
		F.stamina = math.max(0, F.stamina - Combos.WHIFF) -- a wild flurry's misses cost more
	end
	if ev.refund and ev.refund > 0 then
		F.stamina = math.min(F.stamCap or F.maxStam, F.stamina + ev.refund)
	end
	local who = self:Who(F)
	if ev.named then
		self:Swing(F, 0.03 + 0.01 * (it.namedLen or 2))
		self:Send({ t = "combo", who = who, hits = chain.landed, n = chain.punches, name = ev.named.name, id = ev.named.id, sig = ev.named.signature or nil })
		if ev.named.signature or it.namedLen >= 3 then
			self:Comment(string.format("%s lands the %s!", F.data.name, ev.named.signature and ev.named.name:lower() or ev.named.name), ev.named.signature)
		end
	elseif chain.punches >= 2 then
		self:Send({ t = "combo", who = who, hits = chain.landed, n = chain.punches })
	end
	if ev.broken and F.chain == chain then
		-- the second punch into the guard: the combination is smothered and the other man's counter is on
		local now = self:Now()
		O.counterUntil = math.max(O.counterUntil, now + Combos.BREAK_COUNTER)
		F.busyUntil = math.max(F.busyUntil, now) + Combos.BREAK_STALL
		self:Swing(O, 0.04)
		self:CloseChain(F)
		self:Send({ t = "comboBroken", who = who })
	end
end

-- a dodge that made the punch miss opens a chain for the man who dodged: the counter thrown in its window
-- continues it (SLIP-COUNTER, WEAVE-COUNTER...)
function Fight:DodgeChain(F, kind, window)
	self:CloseChain(F)
	F.chain = Combos.NewChain(self:Now())
	Combos.AddDodge(F.chain, kind, self:Now(), window)
	F.evades += 1
end

-- the root travel of a special's set-up (a leap in, two steps back): the NPC glides on the server, the
-- player's client drives its own character from the 'lunge' message (as it does a stumble)
function Fight:Lunge(F, dist, dur)
	local O = self:Other(F)
	if not (F.root and O.root) then
		return
	end
	local toward = flat(O.root.Position - F.root.Position)
	local dir = unitOr(toward, flat(F.root.CFrame.LookVector))
	if dist < 0 then
		dir, dist = -dir, -dist
	else
		-- never into the other man: stop at the pair's separation (frame-aware: Fight:SepRadius)
		dist = math.max(0, math.min(dist, toward.Magnitude - self:SepRadius()))
	end
	if dist < 0.1 then
		return
	end
	local now = self:Now()
	F.lungeUntil = now + dur
	F.lungeVel = dir * (dist / dur)
	self:Send({ t = "lunge", who = self:Who(F), dir = { x = dir.X, z = dir.Z }, dur = dur, speed = dist / dur })
end

-- A special move (Moves.Data): a set-up (FightMotion.Specials[id].pre: shoulder roll, pull, step back, leap,
-- bob and weave) and one or two ordinary punches landed on the FightMotion.SpecialHits schedule through
-- Resolve, with the move's multipliers. The set-up of a counter move is an evade window (shell); a leap
-- or a step moves the root. A medium-or-worse hit taken cancels the punches not yet thrown.
function Fight:Special(F, id)
	local sid = Moves and Moves.Id(id)
	local M = sid and Moves.Data[sid]
	if not M or not self:CanAct(F) then
		return
	end
	local now = self:Now()
	-- a player is told why a special did not go (the HUD says so and the local prediction is called off)
	local why = (not F.moves[sid] and "locked") or (now < F.nextSpecial and "cooldown") or (F.stamina < M.stam and "stamina")
		or (now < F.busyUntil and "busy") or (self:Other(F).state == "down" and "down") or nil
	if why then
		if F.isPlayer then
			self:SendTo(F, { t = "refused", what = "special", id = sid, why = why, wait = math.max(0, math.max(F.nextSpecial, F.busyUntil) - now) })
		end
		return
	end
	local O = self:Other(F)
	local first = Config.Punches[M.punch[1]]
	local stamPct = F.stamina / F.maxStam
	local windup = first.windup * punchSpeed(F, stamPct)
	local hits = FightMotion and FightMotion.SpecialHits and FightMotion.SpecialHits(sid, windup) or {}
	local pre = 0.25
	if FightMotion and FightMotion.Specials and FightMotion.Specials[sid] then
		pre = FightMotion.Specials[sid].pre
	end
	if #hits == 0 then
		hits = { pre + windup } -- no FightMotion: a plain punch after the set-up
	end
	local last = hits[#hits]
	F.stamina = math.max(0, F.stamina - M.stam * (1.2 - F.data.stats.Endurance / 250))
	F.blocking = false
	F.state = "punching"
	self:CloseChain(F) -- (a special is a combination of its own: it ends the chain)
	F.chain = nil
	F.combo = 1
	F.dodgeKind = nil
	F.lastPunch = now
	-- the recovery of the last punch (the check hook's long pivot-out animates on its own; the next act
	-- simply replaces it)
	F.busyUntil = now + last + windup * 0.9
	F.nextSpecial = now + M.cooldown
	F.assistNext = self:AssistBonus(F)
	F.hand = M.hand
	F.specialToken += 1
	local token = F.specialToken
	F.special = { id = sid, token = token }
	F.specialsUsed += 1
	if M.shell then
		F.shellUntil = now + pre + 0.12
		F.shellKind = M.shell
		F.shellText = M.shellText
		F.shellHit = false
	end
	if M.lunge and M.lunge ~= 0 then
		self:Lunge(F, M.lunge, math.max(0.2, pre))
	end
	self:SetAct(F, string.format("special|%s|%s|%.2f|%.2f", sid, M.hand, windup, M.power or 1))
	F.tally.thrown += #hits
	F.totals.thrown += #hits
	self:Send({ t = "special", who = self:Who(F), id = sid, name = M.name })
	if self.tutorial and F == self.P then
		self:TutorialNote({ k = "special", id = sid })
	end
	-- each punch's body flag: Moves.Data bodies[i] (the body-head hook goes low, then high), else the move's
	local function bodyOf(i)
		local b = M.bodies and M.bodies[i]
		if b == nil then
			return M.body == true
		end
		return b == true
	end
	if O.ai then
		for i, at in ipairs(hits) do
			O.ai:OnOppPunch(M.punch[i] or M.punch[1], bodyOf(i), at)
		end
	end
	local fightId = self.id
	for i, at in ipairs(hits) do
		local kind = M.punch[i] or M.punch[1]
		task.delay(at, function()
			if self.id == fightId and not self.finished and F.special and F.special.token == token then
				-- the second punch of a rush is the other hand (a double jab's / body-head hook's hands are
				-- listed: Moves.Data hands)
				F.hand = (M.hands and M.hands[i]) or ((i % 2 == 0) and (M.hand == "L" and "R" or "L") or M.hand)
				F.punchesUsed[kind] = (F.punchesUsed[kind] or 0) + 1
				self:NoteThrow(F, kind, bodyOf(i))
				self:Resolve(F, O, kind, bodyOf(i), stamPct, M)
				if i == #hits and F.special and F.special.token == token then
					F.special = nil
				end
			end
		end)
	end
end

function Fight:Evaded(F, O, ptype, body, now, contactAt)
	local kind = Config.Punches[ptype].kind
	-- a dodge that began after the visible contact (contactAt: the player's press-delay before now) beat nothing
	if contactAt and type(O.defAt) == "number" and O.defAt > contactAt then
		return false
	end
	-- a punch from the side of a closing eye (or a cut bleeding into it) is one he never saw: a dodge beats it
	-- only part of the time (Config.FightDepth.blindDodge). F's left hand lands on O's right side.
	local landSide = F.hand == "L" and 1 or -1
	local blind = self:Blind(O, landSide)
	if blind > 0 and self.rng:NextNumber() < blind * DEPTH.blindDodge then
		return false
	end
	-- a special's set-up: the shoulder roll and the weave take head shots (not uppercuts), the pull takes
	-- straights, the step back takes everything; what it makes miss turns the move's punch into a counter
	if now < O.shellUntil then
		local k = O.shellKind
		if k == "all" or (not body and ((k == "straight" and kind == "straight") or (k == "head" and kind ~= "uppercut"))) then
			O.shellUntil = 0
			O.shellHit = true
			O.counterUntil = now + 0.9
			self:Send({ t = "defense", who = self:Who(O), move = O.shellText or "SLIPPED" })
			self:Comment(O.data.name .. " makes him miss and the counter is coming!")
			return true
		end
	end
	if now < O.parryUntil and kind == "straight" and not body then
		O.parryUntil = 0
		O.counterUntil = now + 0.7
		F.stamina = math.max(0, F.stamina - 4)
		self:SetAct(O, "parryhit")
		self:Send({ t = "defense", who = self:Who(O), move = "PARRIED" })
		self:Comment(O.data.name .. " parries it away and fires back!")
		return true
	end
	if now < O.pivotEvadeUntil and kind == "straight" then
		O.counterUntil = now + 0.6
		self:Send({ t = "defense", who = self:Who(O), move = "PIVOT" })
		self:DodgeChain(O, "sidestep", 0.6)
		return true
	end
	if now < O.slipUntil and not body then
		-- a hook against a slip: slipping AWAY from the hand it comes from (to his left away from a left hook,
		-- which lands on his right) makes it miss; slipping into it walks onto it (Resolve: a little harder).
		-- No side recorded (an old caller): the coin, as before
		local hookAway
		if kind == "hook" then
			if O.slipDir == -1 or O.slipDir == 1 then
				hookAway = O.slipDir == -landSide
			else
				hookAway = self.rng:NextNumber() < 0.5
			end
		end
		if kind == "straight" or hookAway then
			O.counterUntil = now + 0.85
			self:Send({ t = "defense", who = self:Who(O), move = "SLIPPED", dodge = "slip" })
			self:Comment(O.data.name .. " slips it beautifully!")
			self:DodgeChain(O, "slip", 0.85)
			return true
		end
	end
	if now < O.rollUntil and not body then
		if kind == "hook" or kind == "overhand" or (kind == "straight" and self.rng:NextNumber() < 0.5) then
			O.counterUntil = now + 0.8
			self:Send({ t = "defense", who = self:Who(O), move = "ROLLED UNDER", dodge = "roll" })
			self:Comment(O.data.name .. " rolls under it!")
			self:DodgeChain(O, "roll", 0.8)
			return true
		end
	end
	-- the dodges of Shared.Evasion (weave, duck, pull, side-step): inside the window, when it beats the punch
	local dk = O.dodgeKind
	local E = dk and dk ~= "slip" and dk ~= "roll" and Evasion.Moves[dk]
	if E and now < O.dodgeUntil and Evasion.Beats(dk, kind, body, self.rng:NextNumber()) then
		O.dodgeUntil = 0
		O.counterUntil = now + E.counter
		self:Send({ t = "defense", who = self:Who(O), move = E.text, dodge = dk })
		if self.rng:NextNumber() < 0.5 then
			self:Comment(string.format("%s %s!", O.data.name, dk == "weave" and "weaves under it" or (dk == "duck" and "ducks it" or (dk == "pull" and "pulls back from it" or "steps off the line"))))
		end
		self:DodgeChain(O, dk, E.counter)
		return true
	end
	return false
end

-- which face zones a clean head shot marks (Config.Punches[p].face). A left hand lands on the
-- opponent's RIGHT side (Side +1) and vice versa.
function Fight:FaceHit(O, F, ptype, hd, hdRef)
	local P = Config.Punches[ptype]
	local d = O.dmg
	local left = F.hand == "L"
	local side = left and 1 or -1
	local eyeKey = left and "rightEye" or "leftEye"
	local cheekKey = left and "cheekR" or "cheekL"
	local earKey = left and "earR" or "earL"
	local kind = P.kind
	local function add(k, v)
		d[k] = math.min(DMG_CAP[k] or 1, d[k] + v)
	end
	add("redness", hd / 50)
	local noseZone = false
	for _, zone in ipairs(P.face or {}) do
		if zone == "eye" then
			add(eyeKey, hd / (kind == "straight" and 110 or (kind == "overhand" and 55 or 40)))
		elseif zone == "nose" then
			noseZone = true
			add("noseBleed", hd / (kind == "straight" and 45 or 70))
		elseif zone == "lip" then
			add("lip", hd / (kind == "uppercut" and 40 or 90))
		elseif zone == "cheek" then
			add(cheekKey, hd / 45)
		elseif zone == "ear" then
			add(earKey, hd / 70)
		elseif zone == "forehead" then
			add("forehead", hd / 45)
		elseif zone == "bruise" then
			add("bruise", hd / (kind == "uppercut" and 90 or 70))
		end
	end
	if noseZone and kind == "straight" and not d.nose and hd > 1.5 * hdRef and self.rng:NextNumber() < 0.06 then
		d.nose = true
		self:Comment("That nose is BROKEN!", true)
	end
	-- cuts: the punch's cutChance scaled by how hard it landed (and an old cut that reopens)
	if self.rng:NextNumber() < P.cutChance * (hd / 3.1) * (self.cutRisk[O] or 1) then
		local gash = self.rng:NextNumber(0.15, 0.32)
		if d.cut > 0.25 and side ~= d.cutSide then
			d.cut2 = math.min(1.2, d.cut2 + gash)
			d.cutSide2 = side
		else
			d.cut = math.min(1.2, d.cut + gash)
			d.cutSide = side
		end
		self:SendEach(function(V)
			return { t = "announce", text = (O == V and "You're" or O.data.name .. " is") .. " CUT!" }
		end)
		self:Comment("There's blood! " .. O.data.name .. " is cut over the eye!", true)
	end
	self:RefreshDamage(O)
end

-- knockdown severity once a knockdown is decided: flash (tier-0 counter) | normal | heavy | out
function Fight:Severity(O, rel)
	local sv = KO.severity
	if (O.health <= 0 or O.tier >= 3) and rel >= sv.outHd and self.rng:NextNumber() < 0.5 then
		return "out"
	end
	if O.health <= 0 or O.tier >= sv.heavyTier or rel >= sv.heavyHd then
		return "heavy"
	end
	return "normal"
end

-- DownPose: how the fighter falls (Config.KO.falls)
local function fallFor(ptype, body, severity)
	if severity == "flash" then
		return "sit"
	elseif severity == "out" then
		return "face"
	elseif body then
		return "knee"
	end
	local kind = Config.Punches[ptype].kind
	if kind == "hook" then
		return "side"
	elseif kind == "overhand" then
		return "face"
	end
	return "back"
end

-- sp (optional) = the special move this punch belongs to (Moves.Data: range / hit / dmg / kd multipliers,
-- its counter and liver rules) or { counterPunch = true } for a counter jab / cross out of a slip
function Fight:Resolve(F, O, ptype, body, stamPct, sp)
	if F.state == "down" or O.state == "down" or F.state == "clinch" or O.state == "clinch" or not self.live or self.menuHold then
		return
	end
	local P = Config.Punches[ptype]
	local s, os_ = F.data.stats, O.data.stats
	local now = self:Now()
	local dist = self:Distance(F, O)
	sp = sp or {}
	-- the reach (HitGeometry through Fight:HitTest): his glove's path from his real shoulder against the other
	-- man's real head or body at this distance, his bend, the fight's close floor. A head shot that cannot get up
	-- to a much taller chin lands on the body when it reaches that far
	local hit = self:HitTest(F, O, ptype, body, dist, sp.range)
	-- the player's punch against the opponent where his client saw him at the press (lag compensation): a live
	-- miss by movement alone, within LAG_TOL of landing, stands as the client predicted it
	-- (only a miss by movement - short of him, or past him to the side - and by no more than LAG_TOL studs: a punch
	-- the client could not have landed, too high, too low or a stud short, is a miss on both screens)
	local lag = sp.lag
	if not hit.ok and lag and F.isPlayer and (hit.why == "short" or hit.why == "wide") and (tonumber(hit.margin) or -math.huge) >= -LAG_TOL then
		local pp = self:PressPose(F, O, lag, sp.windup or 0)
		if pp then
			local hitC = self:HitTest(F, O, ptype, body, pp.dist, sp.range, pp)
			if hitC.ok then
				hitC.lagComp = true
				hitC.liveWhy, hitC.liveMargin = hit.why, hit.margin
				hit = hitC
				dist = pp.dist
			end
		end
	end
	-- (the verdict, for /wcbdiag's FIGHT block)
	F.lastHit = { t = now, p = ptype, ok = hit.ok, why = hit.why, zone = hit.zone, margin = hit.margin, dist = dist, lag = lag, lagComp = hit.lagComp,
		liveWhy = hit.liveWhy, redirected = hit.redirected, facing = hit.facing }
	if hit.lagComp then
		F.lagComps = (F.lagComps or 0) + 1
	end
	if not hit.ok then
		self:ChainResult(F, O, sp, "miss")
		self:Miss(F, O, ptype, (hit.why == "high" or hit.why == "low" or hit.why == "wide") and hit.why or "short")
		return
	end
	if hit.redirected and not body then
		body = true
		self:Send({ t = "redirect", who = self:Who(F), punch = ptype })
	end
	-- (a dodge counts only when it VISIBLY began before the contact: Evasion.VISIBLE of its act on the attacker's
	-- screen before the glove arrived. A player's screen shows the contact at the resolve less his press's delay and
	-- shows the dodge another leg of the lag and the interpolation late; an AI attacker sees it as it happens)
	local seen = lag and (lag + math.min(VIEW_MAX, lag + POSE_INTERP)) or 0
	if self:Evaded(F, O, ptype, body, now, now - seen - Evasion.VISIBLE) then
		if F.ai and F.ai.obs then
			F.ai.obs.slips += 1
		end
		-- the dodge WON: it is over (a punch that follows is not one that "caught him mid-dodge": no catch bonus,
		-- no Punish multiplier, no announce for the rest of its recovery)
		O.dodgeKind = nil
		O.dodgeEnd = math.min(O.dodgeEnd, now)
		self:Swing(O, 0.025)
		self:ChainResult(F, O, sp, "miss")
		self:Miss(F, O, ptype, "evaded")
		return
	end
	local slipping = now < O.slipUntil
	local rolling = now < O.rollUntil
	-- hit chance
	local vision = math.max(F.dmg.leftEye, F.dmg.rightEye) > 0.8 and 0.88 or 1
	local chance = P.hit * (0.7 + (F.data.mental.Focus + s.RingIQ) / 500) - os_.HeadMovement / 350
	-- a punch landing at the end of its reach (the last STRETCH of the glove's travel: HitGeometry's margin over its
	-- reach) is a glancing shot: it registers - the player saw it reach - but finds the target less often and lands
	-- lighter. The ranges are calibrated to where the animation's glove visibly arrives (HitGeometry.TARGET), a
	-- stud or more past the spacing the damage was balanced on; a hook that just reaches from range is not the
	-- hook thrown inside
	local stretchK = 1
	if type(hit.margin) == "number" and type(hit.reach) == "number" and hit.reach > 0 then
		stretchK = math.clamp(hit.margin / (STRETCH * hit.reach), 0, 1)
	end
	hit.stretch = 1 - stretchK
	chance *= STRETCH_HIT[1] + (1 - STRETCH_HIT[1]) * stretchK
	if body then
		chance += 0.1
	end
	if O.state == "punching" then
		chance += 0.12
	end
	if self:IsHurt(O) then
		chance += 0.12
	end
	-- a dazed or stumbling target cannot get out of the way
	chance += 0.04 * O.tier
	if self:IsStumbling(O) then
		chance += 0.15
	end
	local angled = now < F.angleUntil
	if angled then
		chance += 0.15
		F.angleUntil = 0
	end
	-- the check hook pivots out after the hook: an angle for the next punch and a moment off his line
	if sp.pivotOut then
		F.angleUntil = now + 1.2
		F.pivotEvadeUntil = now + 0.3 * self:DefenseMul(F)
	end
	chance += (sp.hit or 0)
	-- the combination (Combos: a named combo's last punch, a level change, a long or predictable flurry, mashing)
	local item = sp.chain
	if item then
		chance += item.hit or 0
	end
	-- a punch out of a dodge's counter window finds him off balance (Evasion.COUNTER_HIT); one that catches him
	-- after his dodge's window but before he is set again lands easier and harder (Evasion: the timing)
	if now < F.counterUntil then
		chance += Evasion.COUNTER_HIT
	end
	local caught = O.dodgeKind ~= nil and now >= O.dodgeUntil and now < O.dodgeEnd
	if caught then
		chance += Evasion.CAUGHT_HIT
	end
	-- the deeper fight (Config.FightDepth): the side of a closing eye, the momentum, being walked down (a
	-- Pressure-proof man doesn't wilt), the ropes (a Ring General slides off them), a feint he bit on, a raw
	-- boxer's hands hanging after his combination
	chance += DEPTH.blindHit * self:Blind(O, F.hand == "L" and 1 or -1)
	chance += DEPTH.momHit * self:Mom(F)
	local proofF = self:Trait(F, "PressureProof")
	if F.pressured and proofF <= 0 then
		chance -= DEPTH.pressHit
	end
	if O.onRopes then
		chance += DEPTH.ropeHit * self:RopeMul(O)
	end
	local opened = now < F.feintOpenUntil
	if opened then
		chance += DEPTH.feint.hit
		F.feintOpenUntil = 0
	end
	if now < O.guardDropUntil then
		chance += Config.FightAI.dropHit
	end
	-- the ring traits on the punches they read (Shared.Traits): a Slick man's straights, a Weaver's hooks (his
	-- dip meets the uppercut); none of it right after he bit on a feint. A Pressure-proof man counters a swarmer.
	local traitCut, traitId = 0, nil
	if not body and not opened then
		if P.kind == "straight" then
			traitCut, traitId = Traits.Effect("Slick", "hit", self:Trait(O, "Slick")), "Slick"
		elseif P.kind == "hook" or P.kind == "overhand" then
			traitCut, traitId = Traits.Effect("Weaver", "hit", self:Trait(O, "Weaver")), "Weaver"
		elseif P.kind == "uppercut" then
			chance += Traits.Effect("Weaver", "upper", self:Trait(O, "Weaver"))
		end
		chance -= traitCut
	end
	if proofF > 0 and F.pressured and (now < F.counterUntil or O.state == "punching") then
		chance += Traits.Effect("PressureProof", "hit", proofF)
	end
	if (F.assistNext or 0) > 0 then
		-- the console forgiveness never lifts a punch past the cap (and never lowers one that is already above it)
		chance = math.max(chance, math.min(chance + F.assistNext, ASSIST.cap))
	end
	F.assistNext = 0
	-- concussion and daze cost accuracy; so do a tired body and a damaged head, and the eyes he still has
	chance *= (1 - CONC.hitChance * F.conc) * (1 - CONC.tierHitChance * F.tier)
	chance *= 1 - DEPTH.fatigueHit * math.max(0, DEPTH.fatigueAt - stamPct) / DEPTH.fatigueAt
	chance *= 1 - DEPTH.damageHit * math.max(0, DEPTH.damageAt - F.health) / DEPTH.damageAt
	vision = math.min(vision, 1 - DEPTH.visionHit * math.max(F.dmg.leftEye, F.dmg.rightEye))
	chance *= O.frame.target -- [FrameTraits] the bigger man is the bigger target
	-- the AI's tier (Config.FightAI.tiers[].aim): a debut opponent's punches are wilder
	local aiTier = F.ai and F.ai.tier
	if type(aiTier) == "table" and type(aiTier.aim) == "number" then
		chance *= aiTier.aim
	end
	chance = math.clamp(chance * vision, 0.15, 0.95)
	-- clean = how cleanly it landed (feeds the knockdown odds); 0.5 when it comes through a guard
	local clean = 0.5
	if not O.blocking then
		local roll = self.rng:NextNumber()
		if roll > chance then
			if traitId and traitCut > 0 and roll <= chance + traitCut then
				self:TraitFired(O, traitId) -- (the trait made it miss)
			end
			self:ChainResult(F, O, sp, "miss")
			self:Miss(F, O, ptype, "miss")
			return
		end
		clean = (chance - roll) / chance
	end

	-- damage
	local dmg = P.dmg * (0.55 + s.Power / 110) * F.style.fight.power * F.classScale * F.powerMul
	dmg *= STRETCH_DMG[1] + (1 - STRETCH_DMG[1]) * stretchK -- (the end of the reach: see stretchK above)
	dmg *= F.frame.power -- [FrameTraits] the frame's power
	if ptype == "jab" then
		dmg *= F.style.fight.jab
	end
	dmg *= math.clamp(0.55 + stamPct * 0.6, 0.55, 1.05)
	dmg *= 0.9 + F.data.mental.Confidence / 500
	dmg *= 0.95 + (F.data.mental.Aggression or 50) / 1000
	dmg *= self.rng:NextNumber(0.85, 1.15)
	dmg *= self.damageScale
	if self.tutorial and Tutorial then
		-- the tutorial is forgiving: the player's shots land harder, the opponent's barely hurt
		dmg *= Tutorial.DamageMul(self.tutorial, O.isPlayer)
	end
	if angled then
		dmg *= 1.1
	end
	if dist < (self.sp or SPACING).inside then
		if P.kind == "hook" or P.kind == "uppercut" then
			dmg *= F.style.fight.inside * F.frame.insideBonus -- [FrameTraits] the inside fighter's frame
		else
			dmg *= 0.85
		end
	end
	if F.combo >= 2 then
		dmg *= 1 + (F.style.fight.combo - 1) * 0.5
	end
	if item and sp.chainRef then
		-- the landed-chain ramp and the named / signature combo's own bonus
		dmg *= Combos.Ramp(sp.chainRef, item, F.style.fight.combo) * (item.dmg or 1)
	end
	if O.dodgeKind ~= nil and now < O.dodgeEnd then
		-- caught in a dodge that does not beat this punch (an uppercut into a weave), or after its window
		dmg *= Evasion.Punish(O.dodgeKind, P.kind) * (caught and Evasion.CAUGHT_DMG or 1)
	end
	dmg *= sp.dmg or 1
	-- the momentum: the man it favours lands a little heavier (Config.FightDepth.momDmg)
	dmg *= 1 + DEPTH.momDmg * self:Mom(F)
	-- slipping INTO a hook (toward the hand it comes from) walks onto it
	if slipping and P.kind == "hook" and O.slipDir == (F.hand == "L" and 1 or -1) then
		dmg *= 1.15
	end
	local counter = false
	if now < F.counterUntil then
		counter = true
		dmg *= 1.2 * F.style.fight.counter * (0.85 + s.Countering / 300)
		F.counterUntil = 0
	elseif O.state == "punching" and (sp.counter or sp.counterPunch or sp.pivotOut) then
		-- a counter move (shell, pull, step back, check hook, a jab or cross out of a slip) that catches him
		-- punching is a counter in its own right
		counter = true
		dmg *= 1.15 * (0.85 + s.Countering / 300)
	elseif O.state == "punching" then
		dmg *= 1.1
	end
	if slipping and (P.kind == "uppercut" or P.kind == "overhand") then
		dmg *= 1.3
		counter = true
	elseif rolling and P.kind == "uppercut" then
		dmg *= 1.4
		counter = true
	end
	-- a Counter Specialist's counter into a flurry (the 3rd+ punch of a combination, or a busy spell)
	local cs = self:Trait(F, "CounterSpecialist")
	if counter and cs > 0 and ((O.chain and not O.chain.closed and O.chain.punches >= 3) or self:RecentThrows(O, 4) >= 7) then
		dmg *= 1 + Traits.Effect("CounterSpecialist", "counter", cs)
		self:TraitFired(F, "CounterSpecialist")
	end
	-- reference head damage for "how big was that": a solid cross at full strength is about 1
	local hdRef = 6 * DAMAGE.head * self.damageScale
	-- (the body's reference: a solid body shot - the thresholds of the body knockdown, the liver, a heavy one)
	local bdRef = 5 * DAMAGE.body * self.damageScale

	-- block (the overhand comes over the top of the guard)
	if O.blocking and not body then
		local through = sp.overGuard or P.overGuard or 0
		local arms = 1.3 - 0.3 * math.clamp(O.stamina / O.maxStam, 0, 1)
		-- tired arms and a dazed, loose guard let more through
		local chip = dmg * math.clamp(0.28 - os_.Blocking / 400, 0.04, 0.25) * arms * (1 + 0.35 * O.tier) * DAMAGE.chip
		local hd = chip + dmg * through * DAMAGE.head * 0.6 * (P.head or 1)
		self:HeadDamage(O, hd)
		O.stamina = math.max(0, O.stamina - (1.5 + dmg * 0.25))
		O.counterUntil = now + 0.55 * (os_.Countering / 70)
		O.balance -= (P.stun or 10) * 0.25
		self:Send({ t = "blocked", who = self:Who(O), punch = ptype })
		if self.tutorial and O == self.P then
			self:TutorialNote({ k = "blocked" })
		end
		self:SetAct(O, "blockhit")
		self:CheckTier(O)
		self:ChainResult(F, O, sp, "blocked")
		return
	elseif O.blocking and body then
		-- elbows in: a good guard takes more off a body shot (the sims had body punchers walking through every
		-- AI at every level: 0.75 flat let through too much)
		dmg *= math.clamp(0.8 - os_.Blocking / 250, 0.45, 0.75)
	end

	-- landed
	F.tally.landed += 1
	F.totals.landed += 1
	F.typeStats.landed += 1
	if counter then
		F.typeStats.counters += 1
	end
	if ptype ~= "jab" then
		F.tally.power += 1
		F.totals.power += 1
	end
	table.insert(O.recentHits, now)
	local kd, severity, fall, cause = false, nil, nil, nil
	-- what the knockdown animation needs to know about this punch (FightMotion.ChooseFall)
	local kdInfo = { ptype = ptype, body = body, hand = F.hand, counter = false, tier = O.tier }
	local rel, liver
	if body then
		F.tally.body += 1
		F.totals.body += 1
		local armor = (type(O.data.mods) == "table" and tonumber(O.data.mods.bodyArmor)) or 1
		-- Body Armor (the ring trait): body shots barely bother him, and drain less of his gas
		local ba = self:Trait(O, "BodyArmor")
		local baCut = Traits.Effect("BodyArmor", "dmg", ba)
		local bd = dmg * 0.8 * (1.2 - os_.Endurance / 200) * (P.body or 1) * armor * (1 - baCut) * DAMAGE.body
		bd /= O.frame.bodyAbsorb -- [FrameTraits] what his frame soaks up (a Lean body feels it more)
		if ba > 0 then
			self:TraitFired(O, "BodyArmor")
		end
		O.body = math.max(0, O.body - bd)
		O.stamina = math.max(0, O.stamina - dmg * 0.6 * DAMAGE.bodyDrain * (P.body or 1) * (1 - Traits.Effect("BodyArmor", "drain", ba)) / O.frame.bodyAbsorb) -- [FrameTraits]
		O.health = math.max(0, O.health - dmg * 0.15 * DAMAGE.body)
		O.lastBodyHitAt = now
		-- rib bruising on the side that was hit (a left hand lands on the right flank)
		local rib = F.hand == "L" and "ribsR" or "ribsL"
		O.dmg[rib] = math.min(1, O.dmg[rib] + bd / 55)
		O.dmgDirty = true
		F.damageDealt += bd * 0.5
		O.damageTaken += bd * 0.5
		rel = bd / hdRef * 0.5
		O.balance -= (P.stun or 10) * 0.35 * math.clamp(rel, 0.3, 2)
		dmg = bd
		self:CheckTier(O)
		if O.body <= 0 or (O.body < 25 and bd >= bdRef and self.rng:NextNumber() < 0.22 * DAMAGE.bodyKd) then
			kd, severity = true, "normal"
		elseif ptype == "leadhook" and F.hand == "L" and O.body < (sp.liver and 85 or 60) and self.allowKD
			and self.rng:NextNumber() < (sp.liver and 0.4 or 0.12) * (1.2 - os_.Endurance / 100) * math.clamp(bd / bdRef, 0.5, 1.5) * (1 - baCut) * DAMAGE.bodyKd then
			-- the liver sits under the right ribs: a left hook there drops people a beat AFTER it lands (the
			-- liver-shot special is aimed at it and folds a man who is nowhere near done)
			liver = true
		end
		fall = "knee"
	else
		local chinMul = 1.35 - os_.Chin / 100 * 0.7
		-- (and the damage he has taken builds: a concussed head takes every shot worse - the late rounds' danger)
		local hd = dmg * DAMAGE.head * chinMul * (P.head or 1) * (O.dmg.cut > 0.5 and 1.08 or 1) * (1 + KO.tierDamage * O.tier) * (1 + CONC.damage * O.conc)
		hd /= O.frame.chin -- [FrameTraits] the frame's chin
		-- Iron Chin (the ring trait): power shots to the head do less, and drop him less; it cracks as his body
		-- and his gas go (the counter is the body work)
		local ic = ptype ~= "jab" and self:Trait(O, "IronChin") or 0
		local icK = 0
		if ic > 0 then
			icK = math.clamp(O.body / 100 + 0.2, 0.3, 1) * (O.stamina < O.maxStam * 0.3 and 0.7 or 1)
			hd *= 1 - Traits.Effect("IronChin", "dmg", ic) * icK
			if hd >= hdRef * 0.8 then
				self:TraitFired(O, "IronChin")
			end
		end
		self:HeadDamage(O, hd)
		O.lastHitAt = now
		F.damageDealt += hd
		O.damageTaken += hd
		dmg = hd
		rel = hd / hdRef
		self:FaceHit(O, F, ptype, hd, hdRef)
		local tierBefore = O.tier
		self:CheckTier(O)
		-- knockdown odds (Config.KOChance): uses the state BEFORE this punch's concussion is added
		if O.health <= 0 then
			kd = true
		else
			-- a fresh fighter only goes down to a true flash: a very clean power counter that catches
			-- him walking onto it (while punching, or as he slips / rolls into it)
			local flashy = counter and ptype ~= "jab" and clean >= 0.7 and (O.state == "punching" or slipping or rolling)
			-- ... or the clean power shot at the end of a combination that is landing (the third or later punch of a
			-- chain whose earlier punches landed): the shot he never saw coming (KO.comboFlash of a counter's odds)
			local comboFlash = not flashy and item ~= nil and sp.chainRef ~= nil and ptype ~= "jab" and clean >= KO.comboClean
				and (sp.chainRef.landed or 0) >= 2
			local p, flash = Config.KOChance({
				tier = O.tier, punch = ptype, hd = hd, hdRef = hdRef, counter = (O.tier > 0 and counter) or flashy or comboFlash,
				health = O.health,
				chin = os_.Chin, endurance = os_.Endurance, stamina = os_.Stamina, stamPct = O.stamina / O.maxStam,
				power = s.Power, clean = clean, kdTotal = O.kdTotal, conc = O.conc, healthCap = O.healthCap,
				trauma = O.data.trauma, composure = O.data.mental.Composure,
			})
			if comboFlash and O.tier == 0 then
				p *= KO.comboFlash
			end
			p *= sp.kd or 1
			p *= F.frame.kdPower / O.frame.kdResist -- [FrameTraits] his one-punch power against the other man's frame
			if self.tutorial and Tutorial and not O.isPlayer then
				p *= Tutorial.KoMul(self.tutorial)
			end
			-- the ring traits on the knockdown odds (capped together: Traits.CAP.kd)
			local full = p
			local gr = self:Trait(O, "Granite")
			local kdCut = math.min(Traits.CAP.kd, Traits.Effect("IronChin", "kd", ic) * icK + Traits.Effect("Granite", "kd", gr))
			p *= 1 - kdCut
			local kdRoll = self.rng:NextNumber()
			if kdRoll < p then
				kd = true
				severity = (flash and tierBefore == 0) and "flash" or nil
			elseif kdRoll < full then
				-- he should have gone down
				self:TraitFired(O, gr > 0 and "Granite" or "IronChin")
			end
		end
		O.conc = math.min(1, O.conc + hd * CONC.perHeadDamage * (P.ko or 1) * (1.3 - os_.Chin / 150))
		O.concPeak = math.max(O.concPeak, O.conc)
		-- balance: hooks and uppercuts take the legs, footwork keeps them
		local loss = (P.stun or 10) * math.clamp(rel, 0.2, 2.5) * (1.3 - os_.Footwork / 200) * (1 + 0.25 * O.tier) * (counter and 1.3 or 1)
		loss *= 1 - Traits.Effect("Granite", "balance", self:Trait(O, "Granite"))
		O.balance -= loss
		if kd then
			severity = severity or self:Severity(O, rel)
			fall = fallFor(ptype, false, severity)
		end
	end
	-- (a heavy shot hurts him: KO.hurt / hurtCounter of the reference shot - was 2 / 1.75, when every clean hook and
	-- uppercut inside was "heavy" and a busy fight kept both men hurt, covering and wide open)
	local heavy = (body and dmg >= bdRef * 1.4) or (not body and (rel >= KO.hurt or (counter and rel >= KO.hurtCounter)))
	if heavy then
		O.hurtUntil = now + 1.4 + rel * 0.6
	end
	-- the momentum swings with the work: a clean shot, more for a big one and for a counter
	self:Swing(F, 0.02 + 0.015 * math.min(rel, 2) + (counter and 0.04 or 0) + (heavy and 0.04 or 0))
	local sev = math.clamp(rel * 0.6 * (counter and 1.15 or 1), 0, 1.5)
	if body then
		self:SetAct(O, string.format("hitbody|%s|%s|%.2f", ptype, F.hand == "L" and "R" or "L", sev))
	else
		self:SetAct(O, string.format("hit|%s|%s|%.2f|%s", ptype, heavy and "heavy" or (counter and "counter" or "head"), sev, F.hand or "R"))
	end
	-- a medium-or-worse shot cancels the special the other man was still throwing (the Animator drops it too)
	if O.special and sev >= 0.35 then
		O.special = nil
		O.shellUntil = 0
		O.busyUntil = math.min(O.busyUntil, now + 0.3)
	end
	self:Send({
		t = "hit", who = self:Who(F), punch = ptype, body = body, dmg = math.floor(dmg * 10) / 10, counter = counter, heavy = heavy,
		hand = F.hand, sev = math.floor(sev * 100) / 100, bleed = (O.dmg.cut > 0.35 or O.dmg.cut2 > 0.35 or O.dmg.noseBleed > 0.4),
		special = sp.id, kind = P.kind, caught = caught or nil, chain = item and item.n or nil,
	})
	self:ChainResult(F, O, sp, "landed")
	if caught and O.isPlayer then
		self:SendTo(O, { t = "announce", text = "CAUGHT MID-DODGE!" })
	end
	if heavy then
		local name = Config.PunchNames[ptype]
		self:Comment(string.format("%s lands a %s%s%s!", F.data.name, counter and "counter " or "", body and "body " or "", name:lower()), counter)
	end

	-- legs: a fighter whose balance runs out stumbles; at severe danger the legs simply go
	if not kd and O.balance < 30 and O.state ~= "down" then
		if O.balance < 0 and O.tier >= 2 then
			kd, severity, fall, cause = true, "normal", "knee", "legs"
		else
			local away = unitOr(flat(O.root and F.root and (O.root.Position - F.root.Position) or Vector3.zero), Vector3.new(0, 0, 1))
			if P.kind == "hook" and F.root then
				-- a hook spins the target toward the side it came from
				local lateral = flat(F.root.CFrame.RightVector) * (F.hand == "L" and 1 or -1)
				away = unitOr(away * 0.7 + lateral * 0.6, away)
			end
			self:Stumble(O, away, math.clamp(0.4 + rel * 0.35 + O.tier * 0.15, 0.3, 1.5))
			self:Swing(F, 0.06)
		end
	end

	-- the tutorial: the player never goes down, the opponent only once the last step is up
	if self.tutorial and Tutorial and (kd or liver) and self:Protected(O) then
		kd, liver = false, nil
		O.health = math.max(O.health, 25)
		O.body = math.max(O.body, 25)
		O.balance = math.max(O.balance, 60)
		self:CheckTier(O)
	end
	if liver and not kd then
		local fightId = self.id
		task.delay(0.6, function()
			if self.id == fightId and not self.finished and self.live and not self.paused and O.state ~= "down" then
				self:Comment("Delayed reaction... that's the LIVER! " .. O.data.name .. " folds up!", true)
				O.kdInfo = { ptype = ptype, body = true, hand = F.hand, tier = O.tier }
				self:Knockdown(O, F, "normal", "knee", "liver")
			end
		end)
	end
	if kd then
		if self.allowKD then
			kdInfo.counter = counter
			O.kdInfo = kdInfo
			self:Knockdown(O, F, severity or "normal", fall or "back", cause)
		else
			-- sparring: the coach steps in instead of a knockdown
			O.health = math.max(O.health, 18)
			O.body = math.max(O.body, 20)
			O.balance = 100
			self:CheckTier(O)
			self:Send({ t = "announce", text = "COACH: \"Time! Take a breather.\"" })
			if self.spar == "Medium" or self.spar == "PvP" then
				self:End(F, "Stopped", "Coach stops the sparring session")
			else
				O.hurtUntil = now + 2
			end
		end
	end
end

function Fight:Miss(F, O, ptype, why)
	-- a whiffed power shot (not one merely short) costs Config.Damage.whiff of its stamina on top: the wild hooks of a
	-- man walking in throwing are what empty his tank
	local P = Config.Punches[ptype]
	local whiff = (why ~= "short" and P and P.kind ~= "straight") and P.stam * (DAMAGE.whiff or 0) or 0
	F.stamina = math.max(0, F.stamina - 1 - whiff)
	if why == "miss" and O.data.stats.Countering > 55 then
		O.counterUntil = self:Now() + 0.45
	end
	-- (the AI in front of him saw him miss: FightAI.OnOppMiss, its opening)
	if O.ai and O.ai.OnOppMiss then
		O.ai:OnOppMiss(ptype, why)
	end
	-- whiffing a big shot pulls the fighter off balance (worse when gassed or dazed)
	if why ~= "short" and Config.Punches[ptype].kind ~= "straight" then
		local gassed = F.stamina < F.maxStam * 0.25
		F.balance -= (gassed and 15 or 10) * (1 + 0.25 * F.tier)
		if F.balance < 30 and F.root then
			self:Stumble(F, flat(F.root.CFrame.LookVector), gassed and 0.6 or 0.4)
		end
	end
	self:Send({ t = "miss", who = self:Who(F), why = why })
end

-- balance loss: a short involuntary stagger. NPCs glide on the server; the player's character is
-- client-owned, so the client drives it (Humanoid:Move) from the 'stumble' message.
function Fight:Stumble(F, dir, sev)
	if F.state == "down" or F.state == "clinch" or self.finished or not F.root then
		return
	end
	local now = self:Now()
	if now < F.stumbleUntil then
		return
	end
	sev = math.clamp(sev or 0.5, 0.2, 1.5)
	dir = unitOr(flat(dir), flat(-F.root.CFrame.LookVector))
	local dur = 0.45 + 0.35 * sev
	F.stumbleUntil = now + dur
	F.busyUntil = math.max(F.busyUntil, now + dur * 0.8)
	F.blocking = false
	if F.state ~= "punching" then
		F.state = "idle"
	end
	F.balance = math.max(F.balance, 55)
	F.stumbles += 1
	F.strain = math.max(F.strain, 0.5)
	local look, right = flat(F.root.CFrame.LookVector), flat(F.root.CFrame.RightVector)
	local fwd, lat = dir:Dot(look), dir:Dot(right)
	local letter = "B"
	if math.abs(lat) > math.abs(fwd) or fwd > 0 then
		letter = lat >= 0 and "R" or "L"
	end
	self:SetAct(F, string.format("stumble|%s|%.2f|%.2f", letter, sev, dur))
	F.stumbleSpeed = 6 + 5 * sev
	if not F.isPlayer then
		F.stumbleVel = dir * F.stumbleSpeed
	end
	self:Send({ t = "stumble", who = self:Who(F), dir = { x = dir.X, z = dir.Z }, dur = dur, sev = sev })
	if sev >= 0.8 then
		self:Comment(F.data.name .. " is stumbling! The legs are not there!")
	end
end

function Fight:SetBlock(F, on)
	if not self:CanAct(F) then
		return
	end
	if on and self:Now() < F.busyUntil and F.state == "punching" then
		return
	end
	if on and self:IsStumbling(F) then
		return
	end
	local was = F.blocking
	F.blocking = on and true or false
	if F.blocking and not was then
		F.blockAt = self:Now() -- (a guard held past DEPTH.shellAfter is a shell: Fight:GuardMul)
	end
	if F.state ~= "punching" then
		F.state = on and "blocking" or "idle"
	end
	if F.blocking and not was then
		self:NoteDefense(F, "block", 0)
	end
end

-- what the guard costs (regen or move): the hands up between punches cost a little; a shell - held past
-- DEPTH.shellAfter seconds, or the shell special - costs the full price (it was the full price for any guard, and a
-- boxer keeping his hands up while walked down lost his legs and his breath with them)
function Fight:GuardMul(F, now, what)
	local D = DEPTH.shell
	local shell = now < (F.shellUntil or 0) or now - (F.blockAt or now) > D.after
	if what == "move" then
		return shell and D.move or D.guardMove
	end
	return shell and D.regen or D.guardRegen
end

-- a dodge window's share for F right now: pinned on the ropes he has less room (a Ring General slides off them)
function Fight:EvadeMul(F)
	if F.onRopes then
		return 1 - 0.15 * self:RopeMul(F)
	end
	return 1
end

-- cancel = a new dodge may replace a defence started less than Evasion.CANCEL ago (the pad's flick-then-button
-- chords: the flick's slip, roll or parry turns into the weave, the duck, the pull or the side-step), with half
-- the first one's stamina back; a punch's recovery is never cancelled
local function defenseReady(self, F, cost, cancel)
	if not self:CanAct(F) then
		return false
	end
	local now = self:Now()
	local cancelling = false
	if now < F.busyUntil then
		if not (cancel and F.state ~= "punching" and not F.defCancelled and now - F.defAt < Evasion.CANCEL) then
			return false
		end
		cancelling = true
	end
	if F.stamina + (cancelling and F.defCost * 0.5 or 0) < cost then
		return false
	end
	if cancelling then
		F.stamina += F.defCost * 0.5
		F.slipUntil, F.rollUntil, F.parryUntil, F.pivotEvadeUntil, F.dodgeUntil = 0, 0, 0, 0, 0
	end
	F.stamina -= cost
	F.blocking = false
	F.state = "idle"
	F.defAt, F.defCost, F.defCancelled = now, cost, cancelling
	F.dodges += 1
	return true
end

function Fight:Slip(F, dir)
	if not defenseReady(self, F, Evasion.Moves.slip.stam) then
		return
	end
	local now = self:Now()
	F.slipUntil = now + Evasion.Window("slip", F.data.stats, self:DefenseMul(F)) * self:EvadeMul(F)
	F.busyUntil = now + Evasion.Moves.slip.recover
	F.dodgeKind, F.dodgeUntil, F.dodgeEnd = "slip", F.slipUntil, F.busyUntil
	F.slipAt = now -- a counter jab / cross may come straight out of this slip (Punch)
	F.slipDir = dir == -1 and -1 or 1
	self:NoteDefense(F, "slip", F.slipDir)
	self:SetAct(F, "slip|" .. (dir == -1 and "L" or "R"))
	if self.tutorial and F == self.P then
		self:TutorialNote({ k = "slip" })
	end
end

-- quick = the quick dodge (Shift + Space): a shorter window, a quicker recovery, cheaper
function Fight:Roll(F, quick)
	if not defenseReady(self, F, quick and 3 or Evasion.Moves.roll.stam) then
		return
	end
	local now = self:Now()
	F.rollUntil = now + (quick and (Evasion.Window("roll", F.data.stats, self:DefenseMul(F)) - 0.1) or Evasion.Window("roll", F.data.stats, self:DefenseMul(F))) * self:EvadeMul(F)
	F.busyUntil = now + (quick and 0.36 or Evasion.Moves.roll.recover)
	F.dodgeKind, F.dodgeUntil, F.dodgeEnd = "roll", F.rollUntil, F.busyUntil
	self:NoteDefense(F, "roll", 0)
	self:SetAct(F, "roll")
	if self.tutorial and F == self.P then
		self:TutorialNote({ k = "roll" })
	end
end

-- the dodges of Shared.Evasion beyond the slip and the roll: weave (dir), duck, pull, side-step (dir). The act
-- (Evasion.Act: weave|L, duck, pull, sidestep|R) is the Animator's; the evade window, the recovery (a punch that
-- lands after the window but inside it CATCHES him) and the stamina are Evasion's; a side-step also moves him off
-- the line (as the pivot does, sideways) and leaves him at an angle
function Fight:Dodge(F, kind, dir)
	if kind == "slip" then
		return self:Slip(F, dir)
	elseif kind == "roll" then
		return self:Roll(F, false)
	end
	local E = Evasion.Moves[kind]
	if not E or not defenseReady(self, F, E.stam, true) then
		return
	end
	local now = self:Now()
	dir = dir == -1 and -1 or 1
	F.dodgeKind = kind
	F.dodgeUntil = now + Evasion.Window(kind, F.data.stats, self:DefenseMul(F)) * self:EvadeMul(F)
	F.busyUntil = now + E.recover
	F.dodgeEnd = F.busyUntil
	self:NoteDefense(F, kind, dir)
	if kind ~= "sidestep" then
		F.slipAt = now -- (a counter jab / cross may come straight out of the head movement, as out of a slip)
	else
		F.angleUntil = now + E.angle
		local O = self:Other(F)
		if F.root and O.root then
			local toward = unitOr(flat(O.root.Position - F.root.Position), flat(F.root.CFrame.LookVector))
			local side = Vector3.new(-toward.Z, 0, toward.X) * dir
			local goal = self:ClampToRing(F.root.Position + side * E.step)
			local d = flat(goal - F.root.Position)
			if d.Magnitude > 0.1 then
				local dur = 0.22
				F.lungeUntil = now + dur
				F.lungeVel = d.Unit * (d.Magnitude / dur)
				self:Send({ t = "lunge", who = self:Who(F), dir = { x = d.Unit.X, z = d.Unit.Z }, dur = dur, speed = d.Magnitude / dur })
			end
		end
	end
	self:SetAct(F, Evasion.Act(kind, dir, E.recover))
	if self.tutorial and F == self.P then
		self:TutorialNote({ k = "dodge", kind = kind })
	end
end

function Fight:Parry(F)
	if not defenseReady(self, F, 2) then
		return
	end
	local now = self:Now()
	F.parryUntil = now + (0.18 + F.data.stats.Reflexes * 0.002) * self:DefenseMul(F) * self:EvadeMul(F)
	F.busyUntil = now + 0.32
	self:NoteDefense(F, "parry", 0)
	self:SetAct(F, "parry|" .. (F.hand == "L" and "R" or "L"))
end

function Fight:Pivot(F, dir)
	local now = self:Now()
	if now < F.nextPivot or not defenseReady(self, F, 5) then
		return
	end
	F.nextPivot = now + 1.2
	F.busyUntil = now + 0.35
	F.pivotEvadeUntil = now + 0.25 * self:DefenseMul(F)
	self:NoteDefense(F, "pivot", dir == -1 and -1 or 1)
	F.angleUntil = now + 1.1
	local O = self:Other(F)
	if F.root and O.root then
		local offset = flat(F.root.Position - O.root.Position)
		if offset.Magnitude > 0.1 then
			-- (the spot round him at the same distance; one the ropes pull in onto him is turned less, or he stays put:
			-- a pivot never sets him down inside the other man)
			local sep = math.max(self:SepRadius(), math.min(offset.Magnitude, self:SepRadius() + 0.3))
			local target
			for _, deg in ipairs({ 38, 26, 14 }) do
				local rotated = CFrame.Angles(0, math.rad(deg) * (dir == -1 and -1 or 1), 0):VectorToWorldSpace(offset)
				local t = self:ClampToRing(O.root.Position + rotated)
				if flat(t - O.root.Position).Magnitude >= sep - 0.05 then
					target = t
					break
				end
			end
			if target then
				local y = F.root.Position.Y
				F.model:PivotTo(CFrame.lookAt(Vector3.new(target.X, y, target.Z), Vector3.new(O.root.Position.X, y, O.root.Position.Z)))
			end
		end
	end
	self:SetAct(F, "pivot|" .. (dir == -1 and "L" or "R"))
end

function Fight:CanClinch(F)
	local O = self:Other(F)
	return self:CanAct(F) and O.state ~= "down" and self:Now() >= F.nextClinch and F.stamina >= 4 and self:Distance(F, O) < self:ClinchRange(F)
end

function Fight:Clinch(F)
	if F.state == "clinch" then
		-- the clinch key in a clinch: break it with a shove (Fight:BreakClinch)
		return self:BreakClinch(F)
	end
	if not self:CanClinch(F) then
		return
	end
	local O = self:Other(F)
	local now = self:Now()
	F.stamina -= 4
	F.nextClinch = now + 6
	F.tally.clinches += 1
	-- [FrameTraits] a heavy frame's hold keeps the other man tied up longer (a light one's is shrugged off sooner)
	local hold = 1.8 + (F.frame.clinch - 1) * 1.5
	for _, X in ipairs({ F, O }) do
		X.state = "clinch"
		X.blocking = false
		X.clinchUntil = now + hold
		X.busyUntil = now + hold + 0.1
		X.stumbleUntil = 0
		X.stumbleVel = nil
		X.strain = math.max(X.strain, 0.8)
		X.clinchHits, X.clinchNext, X.clinchAt = 0, now + 0.3, now
	end
	-- holding buys a hurt fighter time: a little head HP, the legs come back
	self.clinchBy = F
	self:ClearStun(F, 6 + 3 * F.tier)
	F.balance = math.min(100, F.balance + 25)
	F.hurtUntil = math.min(F.hurtUntil, now + 0.6)
	self:CheckTier(F)
	self:TieUp()
	self:Send({ t = "announce", text = self.spar and "COACH: \"Break! Let go, work your way out.\"" or "CLINCH! The referee steps in..." })
	self:Comment(F.data.name .. " ties up. Smart veteran move.")
end

-- the tie-up: a clinch starts from anywhere inside the clinch range (out to 4.8 x the rig factor, with
-- arms that only wrap at close quarters) or, pinned on the ropes or between two players, from inside the
-- chests. The pair closes to (or opens out to) the clinch distance over a short slide: the AI side moves,
-- two players meet halfway (neither can walk while they hold), and a player pinned against an AI on the
-- ropes gives back what the ropes do not let the AI take.
function Fight:TieUp()
	local P, O = self.P, self.O
	if not (P.root and O.root) then
		return
	end
	local want = self:ClinchSep()
	local d = flat(O.root.Position - P.root.Position)
	local m = d.Magnitude
	if math.abs(m - want) < 0.1 then
		return
	end
	-- (Separate leaves the opening out to the slide meanwhile: its clinch floor would jump a deep-chested
	-- pair apart in one frame, up to 0.57 studs, and the feet would skate)
	self.tieUntil = self:Now() + 0.5
	local dir = m > 0.05 and d.Unit or flat(P.root.CFrame.LookVector).Unit
	if P.isPlayer and O.isPlayer then
		-- each takes half: P along -dir when opening out (m < want), along +dir when closing in
		local half = (m - want) / 2
		self:Glide(P, self:ClampToRing(P.root.Position + dir * half), 10)
		self:Glide(O, self:ClampToRing(O.root.Position - dir * half), 10)
		return
	end
	local mover, still = O, P
	if not P.isPlayer and O.isPlayer then
		mover, still = P, O
	end
	local away = mover == O and dir or -dir -- from the still man to the mover
	local goal = self:ClampToRing(still.root.Position + away * want)
	self:Glide(mover, goal, 10)
	-- the ropes stop the mover short of the distance: the still man gives back the rest
	local short = want - flat(goal - still.root.Position).Magnitude
	if short > 0.1 then
		self:Glide(still, self:ClampToRing(still.root.Position - away * short), 10)
	end
end

-- Inside the clinch (Config.FightDepth): a punch is a short shot to the body - a fraction of a punch, one every
-- clinchGap seconds, at most clinchMax a clinch (then the referee breaks them). The man who tied up is holding:
-- his arms smother clinchSmother of what comes at him. It wears the body and the gas, and the judges see a
-- little of it (tally.inside).
function Fight:ClinchWork(F, ptype)
	local O = self:Other(F)
	local now = self:Now()
	if O.state ~= "clinch" or now < F.clinchNext or F.stamina < 2 or F.clinchHits >= DEPTH.clinchMax or now >= F.clinchUntil then
		return
	end
	F.clinchNext = now + DEPTH.clinchGap
	F.clinchHits += 1
	F.stamina -= 1.5
	local P = Config.Punches[ptype] or Config.Punches.leadhook
	local s, os_ = F.data.stats, O.data.stats
	local dmg = P.dmg * DEPTH.clinchDmg * (0.55 + s.Power / 110) * F.style.fight.inside * F.classScale * self.damageScale
	dmg *= F.frame.clinch * F.frame.power / O.frame.bodyAbsorb -- [FrameTraits] clinch strength, his power, the other man's body
	if self.clinchBy == O then
		dmg *= 1 - DEPTH.clinchSmother
	end
	dmg *= 1 - Traits.Effect("BodyArmor", "dmg", self:Trait(O, "BodyArmor"))
	if self.tutorial and Tutorial then
		dmg *= Tutorial.DamageMul(self.tutorial, O.isPlayer)
	end
	local bd = dmg * (1.2 - os_.Endurance / 200) * DAMAGE.body
	O.body = math.max(1, O.body - bd)
	O.stamina = math.max(0, O.stamina - dmg * 0.5)
	O.lastBodyHitAt = now
	F.tally.inside = (F.tally.inside or 0) + 1
	F.damageDealt += bd * 0.5
	O.damageTaken += bd * 0.5
	F.hand = F.hand == "L" and "R" or "L"
	self:SetAct(F, string.format("uppercut|%s|body|0.18|0.35", F.hand))
	self:SetAct(O, string.format("hitbody|%s|%s|%.2f", ptype, F.hand == "L" and "R" or "L", 0.15))
	self:Send({ t = "inside", who = self:Who(F), dmg = math.floor(bd * 10) / 10 })
	self:Swing(F, 0.01)
	if F.clinchHits >= DEPTH.clinchMax then
		-- holding and hitting: the referee breaks them
		self:Send({ t = "announce", text = self.spar and "COACH: \"Break!\"" or "BREAK! The referee pulls them apart." })
		for _, X in ipairs({ F, O }) do
			X.clinchUntil = math.min(X.clinchUntil, now)
			X.busyUntil = math.min(X.busyUntil, now + 0.2)
		end
	end
end

-- The clinch key in a clinch: a shove off the break (after clinchMinHold seconds of it). The pair let go, the
-- other man is pushed back a step and off balance for a moment, the breaker comes off at an angle
function Fight:BreakClinch(F)
	local O = self:Other(F)
	local now = self:Now()
	if F.state ~= "clinch" or now - F.clinchAt < DEPTH.clinchMinHold or F.stamina < 3 or self.finished then
		return false
	end
	F.stamina -= 3
	for _, X in ipairs({ F, O }) do
		X.state = "idle"
		X.clinchUntil = now
		X.busyUntil = math.min(X.busyUntil, now + 0.1)
	end
	O.busyUntil = now + DEPTH.breakBusy
	O.balance = math.max(20, O.balance - DEPTH.breakBalance)
	F.angleUntil = now + DEPTH.breakAngle
	F.nextClinch = math.max(F.nextClinch, now + 2)
	if O.root and F.root and not O.isPlayer then
		local away = unitOr(flat(O.root.Position - F.root.Position), flat(F.root.CFrame.LookVector))
		self:Glide(O, self:ClampToRing(O.root.Position + away * 1.2), 9)
	end
	self:SetAct(F, "pivot|" .. (self.rng:NextNumber() < 0.5 and "L" or "R"))
	self:Send({ t = "announce", text = "OFF THE BREAK!" })
	self:Comment(F.data.name .. " shoves off and comes out at an angle!")
	return true
end

------------------------------------------------------------------------
-- Referee (a real Builder NPC in the ring: moves with the action, counts, waves it off)
------------------------------------------------------------------------
-- who runs the ring: a fight-night referee, or in a gym spar the coach (older, gym polo + towel)
function Fight:Official(capital)
	if self.spar then
		return capital and "The coach" or "the coach"
	end
	return capital and "The referee" or "the referee"
end

-- Collision groups: the referee walks through both fighters (he never shoves the NPC or jitters
-- against the player in a clinch) and still stands on the canvas like any NPC. The Humanoid turns
-- CanCollide back on for his head / torso every step, so a group is the only lasting way; it costs
-- nothing per frame. Fighters join "Boxers" for the fight (they still collide with each other and the
-- world) and get their old group back in Cleanup. nil = not tried yet, false = unavailable (the
-- per-step CanCollide fallback runs then).
local REF_GROUP, BOXER_GROUP = "Referee", "Boxers"
local groupsReady
local function ensureGroups()
	if groupsReady == nil then
		local ok, err = pcall(function()
			for _, g in ipairs({ REF_GROUP, BOXER_GROUP }) do
				if not PhysicsService:IsCollisionGroupRegistered(g) then
					PhysicsService:RegisterCollisionGroup(g)
				end
			end
			PhysicsService:CollisionGroupSetCollidable(REF_GROUP, BOXER_GROUP, false)
			-- (said out loud: the two boxers' bodies DO collide with each other and with the world)
			PhysicsService:CollisionGroupSetCollidable(BOXER_GROUP, BOXER_GROUP, true)
			PhysicsService:CollisionGroupSetCollidable(BOXER_GROUP, "Default", true)
		end)
		groupsReady = ok
		if not ok then
			warn("[Boxer] referee collision group unavailable, using the per-step fallback:", err)
		end
	end
	return groupsReady
end

-- puts a fighter's colliding parts in "Boxers", remembering the group each had. A body part swapped in later
-- (Humanoid:ReplaceBodyPartR15: BuilderTiers' tier MeshParts, BuilderHead's classic head, the engine's own
-- ApplyDescription) arrives in the Default group with the template's CanCollide: DescendantAdded puts every new
-- part directly under the model (the R15 body parts) in the group as it lands, so the two bodies keep colliding
-- with each other and passing through the referee for the whole fight
-- (a part's first group is the one it gets back: a swapped-in part's is Default)
local function joinPart(F, d)
	local was = F.groupWas
	if was and d.Parent and d:IsA("BasePart") and (d.Parent == F.model or d.CanCollide) and d.CollisionGroup ~= BOXER_GROUP then
		if was[d] == nil then
			was[d] = d.CollisionGroup
		end
		d.CollisionGroup = BOXER_GROUP
	end
end
local function joinBoxers(F)
	if not F.model then
		return
	end
	if not F.groupWas then
		F.groupWas = {}
		F.groupConn = F.model.DescendantAdded:Connect(function(d)
			if F.groupWas then
				-- now and once more after the swap has set its properties (ReplaceBodyPartR15 parents the part first)
				joinPart(F, d)
				task.defer(joinPart, F, d)
			end
		end)
	end
	for _, d in ipairs(F.model:GetDescendants()) do
		joinPart(F, d)
	end
end
-- the body parts re-asserted in "Boxers" (Update, every GROUP_EVERY s): a swap whose part came back in Default
-- after the DescendantAdded pass (an engine re-scale, ApplyDescription) collides with the referee otherwise
local GROUP_EVERY = 0.5
local function regroupBoxers(F)
	if F.groupWas and F.model and F.model.Parent then
		for _, d in ipairs(F.model:GetChildren()) do
			joinPart(F, d)
		end
	end
end

local function leaveBoxers(F)
	local was = F.groupWas
	F.groupWas = nil
	if F.groupConn then
		F.groupConn:Disconnect()
		F.groupConn = nil
	end
	if was then
		for part, g in pairs(was) do
			if part.Parent then
				part.CollisionGroup = g
			end
		end
	end
end

function Fight:SpawnReferee()
	local ok, model = pcall(function()
		-- (Officials: the look, the drawn face, the venue's / a title fight's shirt; the mesh outfit is BuilderBody's)
		local kind = self.spar and "cornerman" or "referee"
		local app, build, gear, opts = Officials.Look(self.rng:NextInteger(1, 2 ^ 30), kind, { venue = self.venue, kind = self.offerKind })
		return Builder.CreateNPC(app, build, gear, "Referee", opts)
	end)
	if not ok or not model then
		warn("[Boxer] referee could not be built:", model)
		return
	end
	model.Name = "Referee"
	-- never part of the fight physics: fighters walk straight through him
	local solid = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CanCollide = false
			d.CanTouch = false
			if d.Parent == model then
				table.insert(solid, d)
			end
		end
	end
	local center = self.anchors.RingCenter.Position
	local spot = self.arena:FindFirstChild("RefereeSpot", true)
	local pos = spot and spot:IsA("BasePart") and spot.Position or (center + Vector3.new(4.5, 0, 0))
	local root = model:FindFirstChild("HumanoidRootPart")
	local hum = model:FindFirstChildOfClass("Humanoid")
	local y = center.Y + standHeight(hum, root)
	model:PivotTo(CFrame.lookAt(Vector3.new(pos.X, y, pos.Z), Vector3.new(center.X, y, center.Z)))
	model.Parent = self.arena
	-- the cap / headgear re-fitted once the engine's post-parent passes have run (Builder.OnPlaced)
	Builder.OnPlaced(model)
	if root then
		pcall(function()
			root:SetNetworkOwner(nil)
		end)
	end
	local R = { model = model, root = root, hum = hum, actId = 0, nextMove = 0 }
	if ensureGroups() then
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("BasePart") then
				d.CollisionGroup = REF_GROUP
			end
		end
		pcall(joinBoxers, self.P)
		pcall(joinBoxers, self.O)
	else
		-- fallback: the Humanoid turns CanCollide back on for the head / torso parts in its own step;
		-- re-clear the rig parts before every physics step
		R.noclip = RunService.Stepped:Connect(function()
			if not model.Parent then
				if R.noclip then
					R.noclip:Disconnect()
				end
				return
			end
			for _, part in ipairs(solid) do
				part.CanCollide = false
			end
		end)
	end
	if hum and root then
		hum.WalkSpeed = 10 -- (REF.walk: a walk; the knockdown's jog is set in UpdateReferee)
		hum.AutoRotate = false
		local att = Instance.new("Attachment")
		att.Name = "RefFacingAtt"
		att.Parent = root
		local ao = Instance.new("AlignOrientation")
		ao.Name = "RefFacing"
		ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
		ao.Attachment0 = att
		ao.MaxTorque = math.huge
		ao.Responsiveness = 18
		ao.Parent = root
		R.align = ao
	end
	model:SetAttribute("Loop", "referee")
	CollectionService:AddTag(model, "Referee")
	self.ref = R
end

function Fight:RefAct(act)
	local R = self.ref
	if R and R.model.Parent then
		R.actId += 1
		R.model:SetAttribute("Act", act)
		R.model:SetAttribute("ActId", R.actId)
	end
end

-- The referee's beat (UpdateReferee, every REF.tick of a live round). He is OUT of the action: on the orbit,
-- REF.orbit studs from the midpoint of the two men on the perpendicular to their line, on the side away from
-- the hard camera (Fight:HardSide: the side PostFight faces) unless that side is up against the ropes, and he
-- never crosses between the men to change sides (he goes round an end: past the nearer man, REF.round beyond
-- him; every other spot he walks to is mirrored onto the side he is on). He comes in for a reason, on its
-- timing, and goes back out to the orbit after:
--   * a clinch that has HELD REF.clinchHold seconds (not the instant they touch): to the near side of the pair,
--     outside both bodies (never nearer than MinSep to either root), to break them
--   * a knockdown: he holds his ground while the fall plays (REF.fallLand), then jogs in as it lands and stands
--     REF.count studs from the fallen man for the count, toward the standing man and off to the far side from
--     the hard camera (the one place he comes inside MinSep of anybody), waving the other man to the neutral
--     corner (RefAct "neutral"); the knockout on the feet (RefCatch) likewise
--   * a foul (Fight:RefWarn): in to MinSep + REF.warnGap of the offender for REF.warnFor seconds
--   * the bell: in the last REF.bellIn seconds of the round he steps in to the near side of the pair, as for a
--     break (Rest sends them to the corners; HoldCorners sends him back to the orbit for the countdown)
--   * a man coming at him (the fighters pass through the referee: the Referee collision group; their walks are
--     routed round him, Fight:RouteAround with RefRoom): straight back out to the orbit zone (REF.clearOf from
--     both), as soon as one is inside MinSep + REF.evadeAt
-- A walk (REF.walk) everywhere but the knockdown (REF.jog: the count, the catch); the Humanoid's MoveTo paces
-- the steps. The end of the fight is PostFight's (the referee to the centre between the men).
local REF = { orbit = 7.0, orbitMin = 6.0, orbitMax = 8.0, round = 1.6, walk = 10, jog = 16, clinchHold = 1.5, breakGap = 0.4, count = 3,
	fallLand = 0.6, bellIn = 0.6, sideHold = 1.0, evadeAt = 1.6, evade = 1.6, warnGap = 1.0, warnFor = 2.5, tick = 0.1 }
FightEngine.REF = REF

-- the distance the fighters' walks keep from the referee's root (RouteAround, Separate's goal clamp), and his own
-- from theirs: the pair's MinSep (his torso is a man's, the same separation keeps the bodies clear) and REF.keepAir
-- (he stops up to 0.8 short of a spot: never inside MinSep for it)
REF.keepAir = 0.3
function Fight:RefKeep()
	return self:MinSep() + REF.keepAir
end
-- the berth the fighters' walks give him (RouteAround, Separate's goal clamp): a stud wider than his own keep, so
-- a man passing goes by outside the distance that sends the referee stepping out of his way (REF.evadeAt)
REF.room = 1.0
function Fight:RefRoom()
	return self:MinSep() + REF.room
end

-- a foul (a low blow, holding and hitting, a push: whoever calls it): the referee walks in to the offender, says
-- his piece for REF.warnFor seconds (secs to override) and backs off to the orbit
function Fight:RefWarn(F, secs)
	local R = self.ref
	if not (R and F and F.root) then
		return
	end
	R.warn = { F = F, untilT = self:Now() + (secs or REF.warnFor) }
	R.nextMove = 0
end

-- the hard camera's side: the way the post-fight scene faces (between the red corner and the next post)
function Fight:HardSide()
	if not self.hardFace then
		local c = self.anchors.RingCenter.Position
		local toRed = self.anchors.RedCorner and flat(self.anchors.RedCorner.Position - c) or Vector3.new(0, 0, -1)
		toRed = toRed.Magnitude > 0.1 and toRed.Unit or Vector3.new(0, 0, -1)
		self.hardFace = CFrame.Angles(0, math.rad(45), 0):VectorToWorldSpace(toRed)
	end
	return self.hardFace
end

-- pos kept at least r from both fighters' roots (out of the nearer man along the line from him); only = one
-- fighter alone (the count: kept off the standing man, not the one he counts over)
function Fight:RefKeepOut(pos, r, only)
	if r <= 0 then
		return pos
	end
	local list = only and { only } or { self.P, self.O }
	for _ = 1, 2 do
		for _, F in ipairs(list) do
			if F.root then
				local fp = F.root.Position
				local d = flat(pos - fp)
				if d.Magnitude < r then
					local dir = unitOr(d, Vector3.new(1, 0, 0))
					pos = Vector3.new(fp.X + dir.X * r, pos.Y, fp.Z + dir.Z * r)
				end
			end
		end
	end
	return pos
end

-- the referee's orbit spot for a pair standing at pP / pO (pure in the positions and his own: the sim's test reads
-- it). Not a fixed point on the perpendicular (two men circling at 1.75 studs from their midpoint swing it round
-- four times faster than they move, and he walks): a ZONE he stands still in while it holds -
--   * REF.orbitMin..REF.orbitMax from the midpoint (further when the men stand far apart, see the next rule)
--   * at least REF.clearOf from both men's roots (inside 4.5 studs only for a reason)
--   * on the far side from the hard camera (the midpoint-to-him direction against HardSide <= -REF.camDot)
--   * at least REF.offLine off the men's line, either end (never behind one man's back, never in a punch's line)
--   * inside the ropes (the ring clamp moving it by under half a stud)
-- and when it fails, the nearest bearing that passes (searched out from his own both ways round, so the walk there
-- is a short one round the outside: it never goes between the men). side (optional, +-1: the evasion's) keeps the
-- spot on that side of the men's line, so a man coming at him is stepped away from without crossing it. Returns
-- target, mid.
REF.clearOf, REF.clearMargin, REF.camDot, REF.offLine = 5.5, 0.6, 0.15, math.rad(35)
function Fight:RefOrbit(R, pP, pO, side)
	local mid = (pP + pO) / 2
	local line = unitOr(flat(pO - pP), Vector3.new(1, 0, 0))
	local perp = Vector3.new(-line.Z, 0, line.X)
	local half = flat(pO - pP).Magnitude / 2
	local H = self:HardSide()
	local cosOff = math.cos(REF.offLine)
	local rmin = math.max(REF.orbitMin, half + REF.clearOf * 0.8)
	local rmax = math.max(REF.orbitMax, rmin)
	local function ok(pos, strict, margin)
		margin = margin or 0
		local rel = flat(pos - mid)
		local r = rel.Magnitude
		if r < rmin - 0.05 or r > rmax + 0.05 then
			return false
		end
		local u = rel / math.max(r, 1e-3)
		if math.abs(u:Dot(line)) > cosOff then
			return false
		end
		if side and rel:Dot(perp) * side < 0.5 then
			return false
		end
		if strict and u:Dot(H) > -REF.camDot then
			return false
		end
		if flat(pos - pP).Magnitude < REF.clearOf + margin or flat(pos - pO).Magnitude < REF.clearOf + margin then
			return false
		end
		return flat(self:ClampToRing(pos) - pos).Magnitude < 0.5
	end
	local rp = R.root and R.root.Position or (mid - H * REF.orbit)
	-- (and the walk there never between the men: the straight line from him to the spot crossing theirs, out to a
	-- body's width past either man, rules a spot out)
	local ext = line * (self:MinSep() * 0.5)
	local eA, eB = pP - ext, pO + ext
	local function cr(o, p, q)
		return (p.X - o.X) * (q.Z - o.Z) - (p.Z - o.Z) * (q.X - o.X)
	end
	local function crosses(pos)
		local d1, d2, d3, d4 = cr(eA, eB, rp), cr(eA, eB, pos), cr(rp, pos, eA), cr(rp, pos, eB)
		return (d1 * d2 < 0) and (d3 * d4 < 0)
	end
	if ok(rp, true) then
		return Vector3.new(rp.X, mid.Y, rp.Z), mid -- (in the zone: he stays put)
	end
	local rel = flat(rp - mid)
	local base = rel.Magnitude > 0.3 and rel.Unit or -flat(H)
	local r0 = math.clamp(rel.Magnitude, rmin, rmax)
	-- the bearing nearest his own that passes - a new spot with REF.clearMargin more room than staying put needs (he
	-- does not stop on the zone's edge, to step off it again at the next shuffle); the margin, then the camera rule,
	-- waived only when no bearing anywhere passes with them
	for _, pass in ipairs({ { true, REF.clearMargin }, { true, 0 }, { false, 0 } }) do
		for step = 0, 36 do
			for _, sgn in ipairs(step == 0 and { 1 } or { 1, -1 }) do
				local dir = CFrame.Angles(0, sgn * step * math.rad(5), 0):VectorToWorldSpace(base)
				for _, r in ipairs({ r0, REF.orbit, rmin, rmax }) do
					local pos = mid + dir * r
					if ok(pos, pass[1], pass[2]) and not crosses(pos) then
						return pos, mid
					end
				end
			end
		end
	end
	return self:ClampToRing(mid - flat(H) * rmax), mid
end

function Fight:UpdateReferee(now)
	local R = self.ref
	if not (R and R.root and R.hum and R.model.Parent) or now < R.nextMove then
		return
	end
	R.nextMove = now + REF.tick
	local P, O = self.P, self.O
	if not (P.root and O.root) then
		return
	end
	local target, look
	local speed, keep = REF.walk, self:RefKeep()
	local rp = R.root.Position
	local nearF = flat(rp - P.root.Position).Magnitude <= flat(rp - O.root.Position).Magnitude and P or O
	local nearD = flat(rp - nearF.root.Position).Magnitude
	local down = (P.state == "down" and P) or (O.state == "down" and O) or nil
	local catching = R.catching
	if catching and now > catching.untilT then
		R.catching = nil
		catching = nil
	end
	local warn = R.warn
	if warn and (now > warn.untilT or not warn.F.root or warn.F.state == "down") then
		R.warn = nil
		warn = nil
	end
	if down then
		if R.downFor ~= down then
			R.downFor, R.downSince, R.waved = down, now, false
		end
	else
		R.downFor = nil
	end
	local pP, pO = P.root.Position, O.root.Position
	local mid = (pP + pO) / 2
	local line = unitOr(flat(pO - pP), Vector3.new(1, 0, 0))
	local perp = Vector3.new(-line.Z, 0, line.X)
	local half = flat(pO - pP).Magnitude / 2
	-- the side of the men's line he is on (the side every spot but the orbit's is put on: he never walks across)
	local onSide = flat(rp - mid):Dot(perp)
	local mySide = math.abs(onSide) > 0.3 and (onSide > 0 and 1 or -1) or (R.side or 1)
	local clinchHeld = (P.state == "clinch" or O.state == "clinch") and (now - math.max(P.clinchAt or 0, O.clinchAt or 0)) or nil
	local bell = self.live and self.roundEnd and (self.roundEnd - now) <= REF.bellIn and not self.paused
	local mode = "orbit"
	local keepFrom = nil -- (the count: off the standing man only)
	-- the spot on his side of the pair just outside both bodies (the break, the bell)
	local function nearSide()
		local d = math.max(2.2, math.sqrt(math.max(0, keep * keep - half * half)) + REF.breakGap)
		return mid + perp * (mySide * d)
	end
	if catching then
		-- holding up a fighter knocked out on his feet
		target, look = catching.at, catching.look
		R.nextMove = now + 0.1
		speed, keep = REF.jog, 0
		mode = "catch"
	elseif down and now - (R.downSince or now) >= REF.fallLand then
		-- the fall has landed: in at a jog, REF.count from the fallen man, toward the other one (on his way to the
		-- neutral corner) and off to the far side from the hard camera, so the count is not hidden behind him
		local other = self:Other(down)
		local toOther = unitOr(flat(other.root.Position - down.root.Position), Vector3.new(1, 0, 0))
		local far = -self:HardSide()
		far = flat(far - toOther * far:Dot(toOther))
		local dir = unitOr(toOther * 0.55 + unitOr(far, Vector3.new(-toOther.Z, 0, toOther.X)) * 0.85, toOther)
		-- (the spot turned round the fallen man, nearest first, until it is inside the ropes and off the standing man)
		local dp = down.root.Position
		-- (how far a spot is from good: pulled in by the ropes, short of the standing man's room)
		local function badness(spot)
			return flat(self:ClampToRing(spot) - spot).Magnitude * 2 + math.max(0, keep - flat(spot - other.root.Position).Magnitude)
		end
		-- the bearing chosen for this count is kept while it stays good (he does not chase a spot round the man)
		local kept = R.countFor == down and R.countDir or nil
		if kept and badness(dp + kept * REF.count) < 0.5 then
			target = dp + kept * REF.count
		else
			target = dp + dir * REF.count
			local bestBad, bestDir = math.huge, dir
			for _, a in ipairs({ 0, 30, -30, 60, -60, 90, -90, 120, -120, 150, -150, 180 }) do
				local d2 = CFrame.Angles(0, math.rad(a), 0):VectorToWorldSpace(dir)
				local bad = badness(dp + d2 * REF.count) + math.abs(a) * 1e-4
				if bad < bestBad then
					bestBad, bestDir = bad, d2
				end
				if bad < 0.2 then
					break
				end
			end
			target = dp + bestDir * REF.count
			R.countFor, R.countDir = down, bestDir
		end
		look = down.root.Position
		speed = REF.jog
		keepFrom = other
		mode = "count"
		if not R.waved then
			-- the standing man waved off to the neutral corner (the client's referee act; Knockdown walks him there)
			R.waved = true
			self:RefAct("neutral")
		end
	elseif down then
		-- the fall is still playing: he holds his ground (out of it) until it lands
		target, look = rp, down.root.Position
		mode = "kdwait"
	elseif warn and nearD >= keep then
		-- (the call goes on; a man on top of him first sends him out of the way: the evasion below)
		-- at the offender's side, square to the men's line (his footwork in and out never walks into the referee)
		local fp = warn.F.root.Position
		local away = unitOr(perp * mySide * 0.85 + unitOr(flat(rp - fp), perp * mySide) * 0.15, perp * mySide)
		target = fp + away * (keep + REF.warnGap)
		look = fp
		mode = "foul"
	elseif clinchHeld and clinchHeld >= REF.clinchHold then
		-- the break: the near side of the clinch, outside both bodies
		target, look = nearSide(), mid
		mode = "break"
	elseif nearD < keep + REF.evadeAt and nearF.state ~= "down" then
		-- a man on top of him: out of his way - straight to the nearest spot of the orbit zone (RefOrbit: clear of
		-- both men by REF.clearOf, off their line), at a walk
		target, look = self:RefOrbit(R, pP, pO, mySide)
		mode = "evade"
	elseif bell then
		-- the bell: stepping in to the near side of them as it goes
		target, look = nearSide(), mid
		mode = "bell"
	else
		target, look = self:RefOrbit(R, pP, pO)
	end
	if mode ~= R.mode then
		R.mode, R.modeAt = mode, now
	end
	target = self:ClampToRing(target)
	if mode ~= "count" and mode ~= "catch" and mode ~= "orbit" and mode ~= "kdwait" then
		-- (never across the men's line: a spot on the far side of it, between the two ends, is mirrored back onto
		-- his side - the same distance from both men, who stand on the line)
		local rel = flat(target - mid)
		local across = rel:Dot(perp)
		if across * mySide < 0 and math.abs(rel:Dot(line)) < half + REF.round then
			target -= perp * (2 * across)
		end
	end
	target = self:RefKeepOut(target, keep, keepFrom)
	R.target = target
	-- the walk there round the men, never through one (the nearer first; the count's walk only round the
	-- standing man)
	if mode ~= "catch" then
		local list = keepFrom and { keepFrom } or (nearF == P and { P, O } or { O, P })
		-- (round the outside of him: a way round that would take the referee across between the men - their line
		-- out to half a body past either end - is not taken; with both ways ruled out he holds his spot this beat)
		local ext = line * (self:MinSep() * 0.5)
		local eA, eB = pP - ext, pO + ext
		local avoid = mode ~= "count" and function(w)
			return segCross(rp, w, eA, eB)
		end or nil
		for _, F in ipairs(list) do
			local way = nil
			if F.state ~= "down" then
				way = tangentWay(rp, target, F.root.Position, self:MinSep() + 0.3, avoid)
			end
			if way == false then
				target = rp
				break
			elseif way then
				target = way
				break
			end
		end
	end
	local p = R.root.Position
	if R.hum.WalkSpeed ~= speed then
		R.hum.WalkSpeed = speed
	end
	if flat(target - p).Magnitude > ((catching or mode == "count") and 0.3 or 0.8) then
		R.hum:MoveTo(Vector3.new(target.X, p.Y, target.Z))
	elseif mode == "kdwait" then
		R.hum:MoveTo(p)
	end
	if R.align then
		local dir = flat(look - p)
		if dir.Magnitude > 0.1 then
			R.align.CFrame = CFrame.lookAt(Vector3.zero, dir.Unit)
		end
	end
end

-- the countdown: the referee walks back out to his orbit of the two corners' midpoint (the ring centre)
function Fight:RefToOrbit()
	local R = self.ref
	if not (R and R.root and R.hum and R.model.Parent and self.P.root and self.O.root) then
		return
	end
	local target = self:RefKeepOut(self:ClampToRing((self:RefOrbit(R, self.P.root.Position, self.O.root.Position))), self:MinSep())
	R.target = target
	R.mode = "orbit"
	if R.hum.WalkSpeed ~= REF.walk then
		R.hum.WalkSpeed = REF.walk
	end
	local p = R.root.Position
	if flat(target - p).Magnitude > 0.8 then
		R.hum:MoveTo(Vector3.new(target.X, p.Y, target.Z))
	end
end

------------------------------------------------------------------------
-- Knockdowns & stoppages
------------------------------------------------------------------------
-- out-cold knockouts ragdoll the NPC on the server (the player's own rig is ragdolled by FightClient,
-- because the client owns its physics). The NPC is destroyed with the arena, so nothing is restored.
function Fight:Ragdoll(F)
	if F.isPlayer or not F.model then
		return
	end
	local ok, err = pcall(function()
		if F.hum then
			-- the Neck motor is disabled below: with RequiresNeck on the Humanoid would die, and BreakJointsOnDeath
			-- would then snap the cosmetic face / hair Motor6Ds under BoxerLook while the KO is on camera
			F.hum.RequiresNeck = false
			F.hum.BreakJointsOnDeath = false
		end
		for _, m in ipairs(F.model:GetDescendants()) do
			-- only the R15 rig joints (cosmetic FaceJoint / HairJoint motors live deeper, under BoxerLook)
			if m:IsA("Motor6D") and m.Part0 and m.Part1 and m.Parent and m.Parent.Parent == F.model and m.Name ~= "Root" then
				local a0 = Instance.new("Attachment")
				a0.Name = "RagA0"
				a0.CFrame = m.C0
				a0.Parent = m.Part0
				local a1 = Instance.new("Attachment")
				a1.Name = "RagA1"
				a1.CFrame = m.C1
				a1.Parent = m.Part1
				local bs = Instance.new("BallSocketConstraint")
				bs.Name = "Ragdoll"
				bs.LimitsEnabled = true
				bs.UpperAngle = m.Name == "Neck" and 35 or 65
				bs.TwistLimitsEnabled = true
				bs.TwistLowerAngle = -25
				bs.TwistUpperAngle = 25
				bs.Attachment0 = a0
				bs.Attachment1 = a1
				bs.Parent = m.Parent
				m.Enabled = false
				m.Part1.CanCollide = true
			end
		end
		if F.hum then
			F.hum.PlatformStand = true
			F.hum:ChangeState(Enum.HumanoidStateType.Physics)
		end
		if F.align then
			F.align.Enabled = false
		end
	end)
	if not ok then
		warn("[Boxer] ragdoll failed:", err)
	end
end

-- room (studs, centre to centre) a fall that folds forward needs in front of the man going down: the
-- attacker backs off to it. A face-first timber fall goes diagonally past him (FightMotion), the
-- others fold onto the hands / knees / into the referee's arms just in front of the feet
-- (FightMotion.FALL_ROOM, scaled by the fallen man's height: F.bodyK)
local FALL_ROOM = FightMotion and FightMotion.FALL_ROOM or { face = 5.0, forward = 4.2, standing = 5.0, knee = 3.8, flash = 3.8 }

-- walks a fighter's root over the canvas at a walking pace (never a teleport): the Animator senses the
-- motion and gives him real steps. The speed ramps up and brakes into the spot; a newer glide or a
-- Place cancels it. onArrive runs when he gets there.
function Fight:Glide(F, goal, speed, onArrive)
	if not (F.root and F.model) then
		return
	end
	F.glideId = (F.glideId or 0) + 1
	local id, fightId = F.glideId, self.id
	task.spawn(function()
		local v, acc = 0, speed * 4
		local model = F.model
		local lastG
		-- (a glide the other man keeps standing in the way of gives up: never a walk that runs on for ever)
		local giveUp = self:Now() + flat(goal - F.root.Position).Magnitude / math.max(speed, 1) * 3 + 1.5
		while F.glideId == id and self.id == fightId and not self.aborted and F.root and F.root.Parent and self:Now() < giveUp do
			local dt = RunService.Heartbeat:Wait()
			-- (the spot itself never inside the other man's body: a goal set a moment ago may be where he now stands;
			-- the way there round him, never through him: RouteAround)
			local kept = self:KeepOut(F, goal)
			local way = self:RouteAround(F, kept)
			local d = flat(way - F.root.Position)
			local m = d.Magnitude
			local togo = way == kept and m or m + flat(kept - way).Magnitude
			-- brake into the spot (v^2 = 2 a s), never slower than a shuffle until there
			v = math.min(speed, v + acc * dt, math.sqrt(2 * acc * togo))
			local step = math.max(v, 0.8) * dt
			if m <= step and way == kept then
				shift(F, d)
				if onArrive then
					onArrive()
				end
				break
			end
			-- each step itself kept out of the other man (the root distance never drops under the pair's spacing)
			local p = F.root.Position
			local np = self:KeepOut(F, p + d * (math.min(step, m) / math.max(m, 1e-3)))
			shift(F, np - p)
			-- [Studio] Gait: the glide's intended velocity for the clients' Animator (quantised: a change-only attribute)
			if model and model.Parent and m > 1e-3 then
				local q = d / m * (math.floor(v * 2 + 0.5) * 0.5)
				if not lastG or (q - lastG).Magnitude > 0.4 then
					lastG = q
					model:SetAttribute("Gait", q)
				end
			end
		end
		if model and model.Parent and F.glideId == id then
			model:SetAttribute("Gait", nil)
		end
	end)
end

-- the fall for this knockdown (FightMotion when present, else the round-1 pose)
function Fight:ChooseFall(F, by, severity, cause, fall)
	local info = F.kdInfo or {}
	F.kdInfo = nil
	local legacy = { pose = fall or "back", dir = (fall == "face" or fall == "knee") and 0 or math.pi, dist = 20, ko = nil }
	if not (FightMotion and FightMotion.ChooseFall) then
		return legacy
	end
	local P = info.ptype and Config.Punches[info.ptype]
	local vr, ar = F.root, by and by.root
	local c = self.anchors and self.anchors.RingCenter
	local yaw
	if vr then
		local look = vr.CFrame.LookVector
		yaw = math.atan2(-look.X, -look.Z)
	end
	local ok, res = pcall(FightMotion.ChooseFall, {
		ptype = info.ptype, kind = P and P.kind or nil, body = info.body, hand = info.hand, severity = severity,
		cause = cause, tier = info.tier, counter = info.counter,
		victimX = vr and vr.Position.X, victimZ = vr and vr.Position.Z, victimYaw = yaw,
		attackerX = ar and ar.Position.X, attackerZ = ar and ar.Position.Z,
		ringX = c and c.Position.X, ringZ = c and c.Position.Z, ringHalf = self.ringHalf,
		roll = self.rng:NextNumber(), roll2 = self.rng:NextNumber(),
	})
	if ok and type(res) == "table" and FightMotion.ValidFall[res.pose] then
		return res
	end
	return legacy
end

-- a knockout on the feet: the referee rushes in, gets his arms round the fighter and holds him up. He
-- stands chest to chest at arm's length (2.4 studs, centre to centre: two torsos plus the arms between
-- them); the fighter sags forward into him
local CATCH_DIST = FightMotion and FightMotion.CATCH_DIST or 2.4
function Fight:RefCatch(F)
	local R = self.ref
	if not (R and R.root and R.model.Parent and F.root) then
		return
	end
	local other = self:Other(F)
	local toward = other.root and flat(other.root.Position - F.root.Position) or flat(F.root.CFrame.LookVector)
	local d = unitOr(toward, Vector3.new(1, 0, 0))
	R.catching = { at = self:ClampToRing(F.root.Position + d * CATCH_DIST * (F.bodyK or 1)), look = F.root.Position, untilT = self:Now() + 6 }
	R.nextMove = 0
	self:RefAct(string.format("catch|%.1f", (FightMotion and FightMotion.CATCH_TIME or 2) + 1.4))
end

function Fight:Knockdown(F, by, severity, fall, cause)
	if F.state == "down" or self.finished then
		return
	end
	if self.tutorial and Tutorial then
		if self:Protected(F) then
			return -- (the tutorial: see Resolve; a stray caller is refused here too)
		end
		if not F.isPlayer then
			self:TutorialNote({ k = "kd" })
		end
	end
	severity = severity or "normal"
	fall = fall or "back"
	F.state = "down"
	F.blocking = false
	F.kdRound += 1
	F.kdTotal += 1
	F.mash = 0
	F.downSeverity = severity
	F.stumbleUntil = 0
	F.stumbleVel = nil
	F.exprOverride = nil
	local add = severity == "flash" and CONC.perFlashKnockdown or CONC.perKnockdown
	if severity == "heavy" then
		add += 0.08
	elseif severity == "out" then
		add += 0.2
	end
	F.conc = math.min(1, F.conc + add)
	F.concPeak = math.max(F.concPeak, F.conc)
	by.tally.kd += 1
	self:Swing(by, severity == "flash" and 0.25 or 0.4)
	-- how he goes down (R-anim FightMotion: the punch, the severity, where he stands in the ring)
	local choice = self:ChooseFall(F, by, severity, cause, fall)
	fall = choice.pose
	F.koKind = choice.ko
	table.insert(self.knockdowns, { who = self:Who(F), severity = severity, fall = fall, round = self.round, cause = cause })
	self.kdHold = true
	self.paused = true
	-- the physics under the fall (server Ragdoll): the root stops dead where he stands and holds its height -
	-- velocity zeroed, anchored, the Humanoid platform-standing, no auto-rotate - until Guard leaves "down" (the
	-- get-up, the end of the fight, Cleanup), so the body the Animator lays on the canvas never slides or floats.
	-- The walk into the ropes / the corner below still moves it (CFrame shifts). Optional: the round-1 physics
	-- when the module is missing
	if RagdollS then
		pcall(RagdollS.Hold, F.model, F.hum, F.root)
	end
	-- DownPose (+ DownDir / DownDist / KOKind) before Guard = "down" so the Animator picks the right
	-- fall on the first frame
	setAttr(F.model, "DownPose", fall)
	setAttr(F.model, "DownDir", choice.dir)
	setAttr(F.model, "DownDist", choice.dist)
	setAttr(F.model, "KOKind", severity == "out" and choice.ko or nil)
	setAttr(F.model, "Count", 0)
	self:UpdateGuard(F)
	self:SyncAttrs(F)
	if severity == "out" and F.isPlayer and F.hum then
		-- belt and braces for FightClient's ragdoll (it disables the Neck motor): a neckless death would
		-- fire Main's Died -> Abort before End records the KO. Replicates ahead of the kd message.
		F.hum.RequiresNeck = false
		F.neckOff = true
	end
	-- anim = true: the knockout is animated on every client (FightClient skips its physics ragdoll)
	local animKO = severity == "out" and FightMotion ~= nil and FightMotion.ANIMATED_KO == true
	self:Send({ t = "kd", who = self:Who(F), severity = severity, fall = fall, ko = choice.ko, anim = animKO or nil })
	local NAME = F.data.name:upper()
	if severity == "flash" then
		self:Comment("Flash knockdown! " .. F.data.name .. " is down - more surprised than hurt!", true)
	elseif severity == "out" then
		self:Comment(NAME .. " IS OUT COLD! THE REFEREE DOESN'T EVEN COUNT!", true)
	elseif severity == "heavy" then
		self:Comment("DOWN GOES " .. NAME .. "! WHAT A SHOT!", true)
	elseif cause ~= "liver" then
		self:Comment("DOWN GOES " .. NAME .. "!", true)
	end
	-- a man folding forward goes past the one who dropped him, not through him: the attacker backs off a
	-- step to give the fall its room (a walk the Animator turns into real steps, never a teleport)
	-- (a knocked-out man does not stop on his hands: a forward knockout goes all the way to the face)
	local room = FALL_ROOM[(severity == "out" and fall == "forward") and "face" or fall]
	room = room and room * (F.bodyK or 1)
	if room and F.root and by.root then
		local d = flat(F.root.Position - by.root.Position)
		if d.Magnitude > 0.05 and d.Magnitude < room then
			self:Glide(by, self:ClampToRing(by.root.Position - d.Unit * (room - d.Magnitude)), 6)
		end
	end
	-- driven into the ropes / the corner: his root really staggers there (the body never drifts away from
	-- it, so the get-up does not slide), and the ropes take the impact
	if choice.moveX and choice.moveZ and F.root then
		local fightId = self.id
		local goal = self:ClampToRing(F.root.Position + Vector3.new(choice.moveX, 0, choice.moveZ))
		self:Glide(F, goal, math.clamp((choice.dist or 1) / 0.45, 3, 9), function()
			if self.id == fightId and not self.finished then
				self:Send({ t = "ropes", who = self:Who(F) })
			end
		end)
	end
	if severity == "out" then
		if not animKO then
			self:Ragdoll(F)
		end
		if choice.ko == "standing" then
			-- out on his feet: the referee rushes in and catches him before he waves it off
			self:RefCatch(F)
			task.wait(FightMotion and FightMotion.CATCH_TIME or 2)
		else
			-- the fall plays out (the slow-motion beat included) before anybody reacts to it
			task.wait(FightMotion and FightMotion.KOFallWall and FightMotion.KOFallWall(choice.ko, fall) or 1.6)
			-- landed on every client: the limbs go to physics for the settle (server Ragdoll: ball sockets within
			-- human limits, collision boxes, the punch's last push on the head and the gloves; the pelvis stays on
			-- the held root where the fall laid it). The server owns an NPC's limbs, the player his own
			if animKO and RagdollS and self.id and not self.finished then
				local push = (F.root and by.root) and flat(F.root.Position - by.root.Position) or nil
				local dir = push and unitOr(push, flat(F.root.CFrame.LookVector) * -1) or nil
				pcall(RagdollS.Release, F.model, { dir = dir, power = 0.8 + 0.2 * self.rng:NextNumber(), owner = F.player })
			end
		end
		-- no neutral corner after a knockout: it is over, the winner celebrates where he stands
		by.guardOverride = "win"
		self:UpdateGuard(by)
		self:RefAct("waveoff")
		task.wait(1.2)
		self:End(by, "KO", "Knocked out cold")
		return
	end
	-- to the neutral corner once the fall has landed in front of him: an NPC walks there (backing off, eyes
	-- on the man he dropped), the player's character is walked there by the server
	local corner = (by == self.P) and self.anchors.RedNeutral or self.anchors.BlueNeutral
	do
		local fightId = self.id
		task.delay(0.6, function()
			if self.id ~= fightId or self.finished or F.state ~= "down" then
				return
			end
			if by.isPlayer or not by.hum then
				self:Glide(by, corner.Position, 8)
			else
				by.glideId = (by.glideId or 0) + 1
				by.cornerWalk = corner.Position
				by.cornerWalkSent = false
			end
		end)
	end
	if F.kdRound >= 3 then
		task.wait(1.5)
		self:RefAct("waveoff")
		self:End(by, "TKO", "Three knockdowns in the round")
		return
	end
	task.spawn(function()
		self:Count(F)
	end)
end

-- seconds between two green-zone presses that count triple (the client mirrors it for its bar)
local GOOD_GAP = 0.25

function Fight:GetUpAbility(F)
	local s, m = F.data.stats, F.data.mental
	local a = (s.Chin * 0.4 + m.Composure * 0.3 + s.Recovery * 0.3) / 100
	a -= (F.kdTotal - 1) * 0.12
	a += F.health / 300
	a -= F.conc * 0.25
	if F.downSeverity == "flash" then
		a += 0.25
	elseif F.downSeverity == "heavy" then
		a -= 0.1
	end
	return math.clamp(a, 0.05, 0.95)
end

function Fight:Count(F)
	local id = self.id
	local sev = F.downSeverity or "normal"
	local ability = self:GetUpAbility(F)
	local aiUpAt = nil
	if not F.isPlayer then
		-- (most men beat the first count; the second and the third are harder - GetUpAbility counts them - and a
		-- concussed head stays down: KO.count.aiUp was 0.15, when a heavy first knockdown ended most fights)
		local p = ability + KO.count.aiUp
		if F.kdTotal == 1 and sev ~= "heavy" then
			p = math.max(p, KO.count.firstUp) -- (even a raw boxer with a glass chin usually beats his first count)
		end
		if sev == "flash" then
			p = 1
		elseif sev == "heavy" then
			p -= 0.15
		end
		if self.rng:NextNumber() < p then
			if sev == "flash" then
				aiUpAt = self.rng:NextInteger(2, 4)
			else
				aiUpAt = math.clamp(math.floor(9 - ability * 6 + self.rng:NextInteger(-1, 1) + (sev == "heavy" and 1 or 0) + (F.frame.getUpTime - 1) * 6), 3, 9) -- [FrameTraits]
			end
		end
	end
	-- presses needed (a green-zone press counts 3): a first knockdown takes a few seconds of honest work, a
	-- third one when he's badly hurt still needs good timing on top of the mashing
	local target = 8 + F.kdTotal * 4 + (1 - ability) * 12 + F.conc * 8
	target *= F.frame.getUpTime -- [FrameTraits] more work to get a heavy frame up
	if sev == "flash" then
		target *= 0.35
	elseif sev == "heavy" then
		target *= 1.15
	end
	target = math.max(4, math.floor(target))
	if F.isPlayer then
		-- only the man on the canvas gets the get-up panel (in PvP the other client just sees the count)
		self:SendTo(F, { t = "getupStart", target = target, ability = ability, severity = sev })
	end
	for n = 1, 10 do
		task.wait(0.85)
		if self.id ~= id or self.finished then
			return
		end
		setAttr(F.model, "Count", n)
		self:RefAct("refcount|" .. n)
		self:Send({ t = "count", n = n, who = self:Who(F), mash = F.mash, target = target })
		local up
		if F.isPlayer then
			up = n >= 2 and n <= 9 and F.mash >= target
		else
			up = aiUpAt ~= nil and n >= aiUpAt
		end
		if up then
			self:GetUp(F, n)
			return
		end
	end
	self:RefAct("waveoff")
	self:Comment("It's OVER! " .. F.data.name .. " can't beat the count!", true)
	self:End(self:Other(F), "KO", "Counted out")
end

-- beats the count: mandatory eight count on the feet, then the referee looks into the eyes
function Fight:GetUp(F, n)
	local id = self.id
	local s = F.data.stats
	local now = self:Now()
	local sev = F.downSeverity or "normal"
	if sev == "flash" then
		F.health = math.max(F.health, math.min(F.healthCap, 34))
	else
		-- back up, but still on wobbly legs (dazed tier) until the head clears
		F.health = math.max(F.health, math.min(F.healthCap, 18 + s.Recovery * 0.2 - F.kdTotal * 3))
		F.stun = 6 -- a few seconds without getting hit clears the worst of it
		F.healthCap = math.max(35, F.healthCap - 8)
	end
	F.body = math.max(F.body, 20)
	F.state = "idle"
	-- every fall has its own get-up (off the back: roll, hands and knees, a knee, up)
	local fall = F.model:GetAttribute("DownPose") or "back"
	local upT = FightMotion and FightMotion.GetUpTime and FightMotion.GetUpTime(fall) or 0.9
	upT *= F.frame.getUpTime -- [FrameTraits] a heavy frame is slower up (the act carries it to the Animator)
	F.hurtUntil = now + upT + (sev == "flash" and 1.2 or 2.5)
	F.busyUntil = now + upT
	F.stamina = math.max(F.stamina, F.maxStam * 0.3)
	F.balance = 70
	F.strain = 1
	self:SetAct(F, string.format("getup|%s|0|%.2f", fall, upT))
	self:CheckTier(F)
	self:UpdateGuard(F)
	self:Send({ t = "getup", who = self:Who(F) })
	self:Comment(F.data.name .. " beats the count! What heart!", true)
	-- the mandatory eight count continues while the fighter stands
	for k = n + 1, 8 do
		task.wait(0.45)
		if self.id ~= id or self.finished then
			return
		end
		setAttr(F.model, "Count", k)
		self:RefAct("refcount|" .. k)
		self:Send({ t = "count", n = k, who = self:Who(F), standing = true })
	end
	task.wait(0.55)
	-- the referee looks into his eyes once he is all the way up
	local upLeft = now + upT + 0.15 - self:Now()
	if upLeft > 0 then
		task.wait(upLeft)
	end
	if self.id ~= id or self.finished then
		return
	end
	-- referee check: glassy eyes, unsteady legs, no answer -> it's over
	-- (KO.count: the referee waves off a man who is not there; the second knockdown of a round and the third of a
	-- fight weigh on it; was conc x 0.6 + tier x 0.12, too quick once the concussion carries over the rounds)
	local C = KO.count
	local risk = F.conc * C.refConc + F.tier * C.refTier - (F.data.mental.Composure or 50) / 400 + (sev == "heavy" and C.refHeavy or 0)
		+ (F.kdRound >= 2 and C.refSecond or 0) + (F.kdTotal >= 3 and C.refThird or 0)
	if sev == "flash" then
		risk -= 0.2
	end
	local ok = self.rng:NextNumber() >= risk
	setAttr(F.model, "Count", 0)
	setAttr(F.model, "DownPose", nil)
	setAttr(F.model, "DownDir", nil)
	setAttr(F.model, "DownDist", nil)
	setAttr(F.model, "KOKind", nil)
	self:Send({ t = "refcheck", who = self:Who(F), ok = ok })
	if not ok then
		self:RefAct("waveoff")
		self:Comment(self:Official(true) .. " looks into " .. his(F) .. " eyes... and waves it off!", true)
		if self.spar then
			self:End(self:Other(F), "Stopped", "Coach stops the sparring session after the count")
		else
			self:End(self:Other(F), "TKO", "Referee waves it off after the count")
		end
		return
	end
	self:Comment(self:Official(true) .. " asks " .. F.data.name .. " to walk forward... OK to continue!", true)
	task.wait(0.6)
	if self.id == id and not self.finished then
		self:Send({ t = "announce", text = "BOX!" })
		self.kdHold = false
		self.paused = self.menuHold == true -- (the Moves & Controls menu may still hold the round)
		self.resumedAt = self:Now()
	end
end

function Fight:CheckStoppage(F)
	if F.state == "down" or self.finished then
		return
	end
	local now = self:Now()
	local n = 0
	for i = #F.recentHits, 1, -1 do
		if now - F.recentHits[i] <= 3 then
			n += 1
		else
			table.remove(F.recentHits, i)
		end
	end
	if n >= 4 then
		self:Comment(self:Other(F).data.name .. " is unloading a flurry!")
	end
	if self.tutorial and Tutorial and self:Protected(F) then
		return -- the tutorial: nobody is waved off before the last step (the debut's player: before the final round)
	end
	-- time since the fighter last threw, not counting a pause he could not punch through
	local idle = now - math.max(F.lastPunch, self.resumedAt or 0)
	local stop = (F.health < 16 and n >= 5 and idle > 2)
		-- out on the feet and not fighting back: the referee saves the fighter
		or (F.tier >= 3 and n >= 3 and idle > 1.5 and not F.blocking)
		or (F.tier >= 2 and F.conc > 0.75 and n >= 4 and idle > 1.5)
		-- hurt and taking a beating without answering back
		or (F.tier >= 1 and n >= 6 and idle > 2 and not F.blocking)
	if stop then
		self:RefAct("waveoff")
		if self.spar then
			-- in the gym the man in the ring is the coach: he stops a spar, there is no TKO on a record
			self:Send({ t = "announce", text = "COACH: \"That's enough! Stop!\"" })
			self:End(self:Other(F), "Stopped", "Coach stops the sparring session")
		else
			self:Comment("The referee waves it off!", true)
			self:End(self:Other(F), "TKO", "Referee stops the fight")
		end
	end
end

------------------------------------------------------------------------
-- Positioning / movement
------------------------------------------------------------------------

-- the end of the fight until the post-fight scene places them (FightEngine.Run, after "final"): the round loop
-- (and with it Separate) has stopped, but an NPC's last MoveTo, a glide, a player's own stick would still walk the
-- two bodies into each other - every walk is cancelled, the NPCs' feet stop, and Separate keeps the pair apart
-- each Heartbeat for secs (a man on the canvas stays where he fell: Separate leaves a downed pair alone)
function Fight:Settle(secs)
	for _, F in ipairs({ self.P, self.O }) do
		F.glideId = (F.glideId or 0) + 1
		F.lungeUntil = 0
		F.aiTarget = nil
		if F.hum and F.root and not F.isPlayer and F.state ~= "down" then
			pcall(function()
				F.hum.WalkSpeed = 0
				F.hum:MoveTo(F.root.Position)
			end)
		end
	end
	local t0 = self:Now()
	while self:Now() - t0 < secs and not self.aborted do
		local dt = RunService.Heartbeat:Wait()
		local ok = pcall(self.Separate, self, dt)
		if not ok then
			task.wait(secs - (self:Now() - t0))
			break
		end
	end
end

function Fight:Place(F, pos, lookAt)
	if not F.root then
		return
	end
	F.glideId = (F.glideId or 0) + 1 -- a placement wins over any walk in progress
	local target = lookAt or self.anchors.RingCenter.Position
	local p = Vector3.new(pos.X, pos.Y + standHeight(F.hum, F.root), pos.Z)
	F.model:PivotTo(CFrame.lookAt(p, Vector3.new(target.X, p.Y, target.Z)))
	F.root.AssemblyLinearVelocity = Vector3.zero
end

function Fight:ClampToRing(pos)
	local c = self.anchors.RingCenter.Position
	local off = flat(pos - c)
	local half = self.ringHalf - 1.5
	return Vector3.new(c.X + math.clamp(off.X, -half, half), pos.Y, c.Z + math.clamp(off.Z, -half, half))
end

-- centre-to-centre spacing the bodies need so gloves and torsos never sink into each other
-- (self.sp.minSep: FightMotion.Spacing scaled to the pair's rigs). In a clinch AnimFight's tie-up steps
-- each man 0.38 in and leans him onto the other, so the roots stay this far apart for the two chests to
-- meet without sinking in: CLINCH_SEP x the pair's rig factor, and more for deep chests (a heavyweight's
-- pecs and belly stand well proud of the classic torso the rig factor measures): CLINCH_CHEST +
-- CLINCH_DEPTH x the two UpperTorsos' depths. Lab clinch sweep, torso into torso: 1.9 x (the old value)
-- 11-18 cm; 3.0 x clears the lean, female and power bodies against a balanced partner, 3.25 x the
-- heavyweight; heavy against heavy needs 4.15 studs (3.7 x), power against heavy 3.85.
local CLINCH_SEP, CLINCH_CHEST, CLINCH_DEPTH = 3.25, 1.55, 1.03

-- Without the parts (the headless sims' stub rigs) the frames' torso depths (HitGeometry: the same ut.Size.Z /
-- 2 when there is a rig) stand in; and never under MinSep + CLINCH_OVER: a Heavyweight pair's bodies need 3.57
-- apart, the old 3.25 clinch floor let their chests sink into each other for the whole hold.
local CLINCH_OVER = 0.1
function Fight:ClinchSep()
	local sep = CLINCH_SEP * (self.rigK or 1)
	local a = self.P.model and self.P.model:FindFirstChild("UpperTorso")
	local b = self.O.model and self.O.model:FindFirstChild("UpperTorso")
	if a and b and a:IsA("BasePart") and b:IsA("BasePart") then
		sep = math.max(sep, CLINCH_CHEST + CLINCH_DEPTH * (a.Size.Z + b.Size.Z))
	else
		local G, OG = self:Geo(self.P), self:Geo(self.O)
		if G and OG then
			sep = math.max(sep, CLINCH_CHEST + 2 * CLINCH_DEPTH * (G.torsoHalfD + OG.torsoHalfD))
		end
	end
	return math.max(sep, self:MinSep() + CLINCH_OVER)
end

-- cut (optional, 0..1): ring generalship - stand on the ring-centre side of him rather than wherever he leads,
-- so his back stays to the ropes (cutting off the ring); 0 = follow him round
function Fight:MoveAI(F, range, circle, cut)
	if not F.hum or F.state == "down" or F.state == "clinch" or self:IsStumbling(F) then
		return
	end
	local O = self:Other(F)
	local away = flat(F.root.Position - O.root.Position)
	if away.Magnitude < 0.1 then
		away = Vector3.new(1, 0, 0)
	end
	away = away.Unit
	if cut and cut > 0 and self.anchors then
		local toC = flat(self.anchors.RingCenter.Position - O.root.Position)
		if toC.Magnitude > 1 then
			away = unitOr(away * (1 - cut) + toC.Unit * cut, away)
		end
	end
	local MIN_SEP = self:MinSep()
	range = math.max(range, MIN_SEP)
	local rot = CFrame.Angles(0, circle, 0):VectorToWorldSpace(away)
	local target = self:ClampToRing(O.root.Position + rot * range)
	-- a cornered opponent pulls the clamped spot in close: slide it round the ring instead
	if flat(target - O.root.Position).Magnitude < MIN_SEP then
		for _, a in ipairs({ 0.6, -0.6, 1.2, -1.2, 1.8, -1.8 }) do
			local alt = self:ClampToRing(O.root.Position + CFrame.Angles(0, a, 0):VectorToWorldSpace(rot) * range)
			if flat(alt - O.root.Position).Magnitude >= MIN_SEP then
				target = alt
				break
			end
		end
	end
	target = self:KeepOut(F, target)
	-- pace: cover the way in about the AI's decision interval (never slower than a shuffle)
	local togo = flat(target - F.root.Position).Magnitude
	F.aiStepSpeed = math.clamp(togo / 0.42, 4, 30)
	-- a new spot within a few inches of the current one is not worth a restart of the walk, as long as that
	-- walk is still live (UpdateMovement forgets it whenever it cancels the walk) and younger than Roblox's
	-- 8 s MoveTo timeout
	local now = self:Now()
	-- (aiGoal: the spot; aiTarget: the walk actually issued - the spot, or a tangent point round the other man /
	-- the referee on the way to it: RouteAround. nil aiTarget = no live walk)
	local last = F.aiTarget and (F.aiGoal or F.aiTarget)
	if last and flat(last - target).Magnitude < 0.35 and togo > 0.35 and now - (F.aiTargetT or 0) < 4 then
		return
	end
	F.aiGoal = target
	F.aiTarget = self:RouteAround(F, target, nil, self:RefRoom())
	F.aiTargetT = now
	F.hum:MoveTo(F.aiTarget)
end

-- keep the two bodies apart, every Heartbeat (Update calls it once per step):
--   * an NPC's live walk goal (MoveAI's spot, issued against where the other man stood up to 0.4 s ago) is
--     re-clamped out of where he now stands and is heading (KeepOut) and re-issued when that moved it
--   * an overlap (a walk that got there first, a lunge, a stumble, the player's own movement) is resolved by a
--     push along the line between the roots: both men move, the lighter one more (BodyMass), at SEP_RATE of the
--     overlap per second (a soft shove: ~70 % of it per frame at 60 Hz, all of it past SEP_SNAP, where someone
--     was set down inside the other man); a player's own root is client-owned and never shifted by the server
--     (his client's collision does it), so the NPC gives all of the ground against him
local SEP_RATE, SEP_SNAP = 40, 0.4
function Fight:Separate(dt)
	local P, O = self.P, self.O
	if not (P.root and O.root) or P.state == "down" or O.state == "down" then
		return
	end
	dt = dt or 1 / 60
	local minSep = self:MinSep()
	local d = flat(O.root.Position - P.root.Position)
	local m = d.Magnitude
	local clinch = P.state == "clinch" or O.state == "clinch"
	if clinch then
		-- the clinch distance; while the tie-up slides the pair there, no closer than they are (or the minimum)
		local cs = self:ClinchSep()
		if self.tieUntil and self:Now() < self.tieUntil then
			cs = math.min(cs, math.max(m, minSep))
		end
		minSep = cs
	end
	-- the NPCs' walk goals, kept out of the other man as he moves (and off the referee, who is walked through
	-- otherwise: his own collision group lets the fighters pass; he steps out of the way too)
	if not clinch then
		local R = self.ref
		local refP = R and R.root and R.mode ~= "count" and R.mode ~= "catch" and R.root.Position or nil
		local refR = self:RefRoom()
		for _, F in ipairs(self.pair or { P, O }) do
			local goal = F.aiTarget and (F.aiGoal or F.aiTarget)
			if goal and F.hum and not F.isPlayer and F.state ~= "clinch" then
				local kept = self:KeepOut(F, goal, minSep)
				if refP then
					local d = flat(kept - refP)
					if d.Magnitude < refR then
						local out = refP + unitOr(d, unitOr(flat(F.root.Position - refP), Vector3.new(1, 0, 0))) * refR
						kept = self:ClampToRing(Vector3.new(out.X, kept.Y, out.Z))
						-- (pushed out against the ropes and clamped back onto him: his near side instead, where F is)
						if flat(kept - refP).Magnitude < refR - 0.05 then
							out = refP + unitOr(flat(F.root.Position - refP), unitOr(d, Vector3.new(1, 0, 0))) * refR
							kept = self:KeepOut(F, self:ClampToRing(Vector3.new(out.X, kept.Y, out.Z)), minSep)
						end
					end
				end
				F.aiGoal = kept
				-- the way there round the other man and the referee (a goal behind him is walked round to)
				local way = self:RouteAround(F, kept, minSep, refP and refR or nil)
				if flat(way - F.aiTarget).Magnitude > 0.1 then
					F.aiTarget = way
					F.hum:MoveTo(way)
				end
			end
		end
	end
	if m >= minSep then
		return
	end
	local dir = m > 0.05 and d.Unit or flat(P.root.CFrame.LookVector).Unit -- stacked: put them back in front
	local overlap = minSep - m
	local k = overlap > SEP_SNAP and 1 or math.min(1, SEP_RATE * dt)
	local wP, wO = self:BodyMass(O), self:BodyMass(P) -- (each moves by the OTHER man's share of the mass)
	if P.isPlayer then
		wP = 0
	end
	if O.isPlayer then
		wO = 0
	end
	local total = wP + wO
	if total <= 0 then
		return -- (two players: their own clients' collision keeps them apart)
	end
	-- (a man on the ropes cannot give his share: the clamp's shortfall goes to the other man)
	local want = overlap * k
	local order = wO >= wP and { { O, dir, wO }, { P, -dir, wP } } or { { P, -dir, wP }, { O, dir, wO } }
	local carry = 0
	for i, mv in ipairs(order) do
		local X, v, w = mv[1], mv[2], mv[3]
		if w > 0 then
			local share = want * w / total + carry
			local p = X.root.Position
			local goal = self:ClampToRing(p + v * share)
			shift(X, goal - p)
			local moved = flat(goal - p):Dot(v)
			if i == 1 then
				carry = math.max(0, share - moved)
			end
		elseif i == 1 then
			carry = 0
		end
	end
end

function Fight:SetupFacing(F)
	local att = Instance.new("Attachment")
	att.Name = "FightFacingAtt"
	att.Parent = F.root
	local ao = Instance.new("AlignOrientation")
	ao.Name = "FightFacing"
	ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
	ao.Attachment0 = att
	ao.MaxTorque = math.huge
	ao.Responsiveness = 60
	ao.Parent = F.root
	F.align = ao
	F.alignAtt = att
	if F.hum then
		F.hum.AutoRotate = false
		F.hum.UseJumpPower = false
		F.hum.JumpHeight = 0
	end
end

function Fight:UpdateMovement(F, dt)
	local O = self:Other(F)
	local now = self:Now()
	if F.align and F.root and O.root then
		local dir = flat(O.root.Position - F.root.Position)
		if dir.Magnitude > 0.05 then
			-- a new facing only once it turns by more than about a degree: the goal replicates to every
			-- client on each change, and physics jitter alone changed it nearly every frame
			dir = dir.Unit
			local last = F.alignDir
			if not last or last:Dot(dir) < 0.99985 then
				F.alignDir = dir
				F.align.CFrame = CFrame.lookAt(Vector3.zero, dir)
			end
		end
		F.align.Enabled = F.state ~= "down"
	end
	local stumbling = now < F.stumbleUntil
	if F.hum then
		local s = F.data.stats
		local speed = (8 + s.Footwork * 0.08) * F.style.fight.move * F.moveMul
		speed *= F.frame.footSpeed -- [FrameTraits] the frame's feet
		local cw = F.cornerWalk
		if cw and (not F.root or F.isPlayer or F.state == "down" or not self.paused or flat(cw - F.root.Position).Magnitude < 1.2) then
			F.cornerWalk = nil
			cw = nil
		end
		if cw then
			-- after a knockdown: backs off to the neutral corner at a walk (AnimLoco gives him real steps)
			speed = 8
		elseif F.state == "down" or F.state == "clinch" or self.paused or not self.live then
			speed = 0
		elseif stumbling then
			-- the player's client pushes the stagger with Humanoid:Move; NPCs glide below
			speed = F.isPlayer and F.stumbleSpeed or 0
		else
			if F.state == "punching" then
				speed *= 0.45
			elseif F.blocking then
				speed *= self:GuardMul(F, now, "move")
			end
			if self:IsHurt(F) then
				speed *= 0.6
			end
			if F.stamina < F.maxStam * 0.25 then
				speed *= 0.8
			end
			if self:Sprinting(F) then
				speed *= SPRINT.mul
			end
			-- dazed legs and a concussion slow every step (and Granite is slow on his feet)
			speed *= (1 - CONC.tierSpeed * F.tier) * (1 - CONC.speed * F.conc)
			speed *= 1 - Traits.Effect("Granite", "slow", self:Trait(F, "Granite"))
			-- an NPC paces itself to arrive about when the AI next decides: continuous footwork instead
			-- of dash-and-stop (its full speed is still there for a long way to go)
			if not F.isPlayer and F.aiStepSpeed then
				speed = math.min(speed, F.aiStepSpeed)
			end
		end
		-- quantised: no replication churn from tiny changes
		speed = quant(speed, 0.5)
		if F.hum.WalkSpeed ~= speed then
			F.hum.WalkSpeed = speed
		end
		if cw then
			-- (round the man he dropped, never over him: re-issued as the way round slides)
			local way = self:RouteAround(F, cw)
			if not F.cornerWalkSent or not F.cornerWay or flat(way - F.cornerWay).Magnitude > 0.3 then
				F.cornerWalkSent = true
				F.cornerWay = way
				F.aiTarget = nil
				F.hum:MoveTo(Vector3.new(way.X, F.root.Position.Y, way.Z))
			end
		elseif speed == 0 and not F.isPlayer then
			-- the walk is cancelled: MoveAI must re-issue its next spot even if that spot has not moved
			F.aiTarget = nil
			F.hum:MoveTo(F.root.Position)
		end
	end
	if F.root then
		-- a special's leap / step back (NPCs; the player's client drives its own)
		if now < F.lungeUntil and F.lungeVel and not F.isPlayer and F.state ~= "down" then
			local p = F.root.Position
			shift(F, self:KeepOut(F, self:ClampToRing(p + F.lungeVel * dt)) - p)
		end
		if stumbling and F.stumbleVel and not F.isPlayer and F.state ~= "down" then
			local p = F.root.Position
			local want = p + F.stumbleVel * dt
			local goal = self:KeepOut(F, self:ClampToRing(want))
			if flat(goal - want).Magnitude > 0.05 then
				-- into the ropes: they catch and push back a little
				F.stumbleVel = -F.stumbleVel * 0.25
				self:Send({ t = "ropes", who = self:Who(F) })
			else
				F.stumbleVel *= math.max(0, 1 - dt * 3.5)
			end
			shift(F, goal - p)
		end
		local p = F.root.Position
		local clamped = self:ClampToRing(p)
		if (clamped - p).Magnitude > 0.5 then
			shift(F, clamped - p)
		end
	end
end

------------------------------------------------------------------------
-- The 10 Hz state message, packed: 42 bytes in a buffer where the keyed table cost about 370 on the wire
-- (every key name, every number a double). FightClient (handlers.state) unpacks it into the same time /
-- me / opp fields; the two must keep this layout. Bars are 0.01 HP / stamina steps, concussion 0.001:
-- finer than any bar or readout shows.
--   0 time u16 | me: 2 hp, 4 cap, 6 body, 8 bodyCap, 10 stam, 12 max, 14 stamCap (x100 u16), 16 conc (x1000),
--   18 bal (x100), 20 tier u8, 21 flags u8 (1 hurt, 2 angle), 22 eyeL, 23 eyeR (x100 u8)
--   opp: 24 hp, 26 cap, 28 body, 30 bodyCap, 32 stam, 34 max, 36 stamCap (x100), 38 conc (x1000), 40 tier, 41 flags (1 hurt)
------------------------------------------------------------------------
local STATE_BYTES = 42
local function put16(b, o, v, scale)
	v = tonumber(v) or 0
	buffer.writeu16(b, o, math.clamp(math.floor(v * scale + 0.5), 0, 65535))
end
function Fight:PackState(P, O, time, now)
	local b = buffer.create(STATE_BYTES)
	buffer.writeu16(b, 0, math.clamp(time, 0, 65535))
	for side, X in ipairs({ P, O }) do
		local o = side == 1 and 2 or 24
		local vals = { X.health, X.healthCap, X.body, X.bodyCap, X.stamina, X.maxStam, X.stamCap }
		for i = 1, 7 do
			put16(b, o + (i - 1) * 2, vals[i], 100)
		end
		put16(b, o + 14, X.conc, 1000)
		local flags = self:IsHurt(X) and 1 or 0
		if side == 1 then
			put16(b, 18, X.balance, 100)
			buffer.writeu8(b, 20, math.clamp(X.tier or 0, 0, 255))
			if now < X.angleUntil then
				flags += 2
			end
			buffer.writeu8(b, 21, flags)
			-- swollen eyes: FightClient darkens that side of the screen (CONTRACTS 8: P.dmg 0..1)
			buffer.writeu8(b, 22, math.clamp(math.floor(quant(X.dmg.leftEye, 0.05) * 100 + 0.5), 0, 100))
			buffer.writeu8(b, 23, math.clamp(math.floor(quant(X.dmg.rightEye, 0.05) * 100 + 0.5), 0, 100))
		else
			buffer.writeu8(b, 40, math.clamp(X.tier or 0, 0, 255))
			buffer.writeu8(b, 41, flags)
		end
	end
	return b
end
------------------------------------------------------------------------
-- Per-frame update
------------------------------------------------------------------------
-- once a frame per fighter in a live round: being walked down / on the ropes, the second wind, a breather at
-- range, the momentum's share; returns his stamina regen multiplier (Config.FightDepth)
function Fight:DepthRegen(F, now, rdt)
	local O = self:Other(F)
	local live = self.live and not self.paused and F.state ~= "down"
	local mul = 1
	if not live then
		F.pressured, F.onRopes = false, false
		return mul
	end
	local dist = self:Distance(F, O)
	local jab = self:PunchRange(O, "jab")
	F.pressured = O.state ~= "down" and dist <= jab * DEPTH.pressRange and self:RecentThrows(O, DEPTH.pressWin) >= DEPTH.pressPunches
	F.onRopes = self:OnRopes(F)
	local st = O.typeStats
	st.liveT += rdt
	if F.pressured or (F.onRopes and dist <= jab * 1.1) then
		st.pressT += rdt
	end
	if F.pressured then
		local proof = self:Trait(F, "PressureProof")
		if proof > 0 then
			-- (doesn't wilt; his corner never needs telling, the other man's does now and then)
			if self.rng:NextNumber() < rdt * 0.2 then
				self:TraitFired(F, "PressureProof")
			end
		else
			mul *= DEPTH.pressRegen
		end
	end
	if F.onRopes then
		local rm = self:RopeMul(F)
		mul *= 1 - (1 - DEPTH.ropeRegen) * rm
		if rm < 0.999 and self.rng:NextNumber() < rdt * 0.25 then
			self:TraitFired(F, "RingGeneral")
		end
	end
	-- a breather: no punch for a moment and out at range
	if now - F.lastPunch > DEPTH.breatheAfter and dist > jab and not F.blocking then
		mul *= DEPTH.breatheRegen
	end
	-- the second wind: gassed for a while and not punching -> a surge, once a fight (twice for the fittest)
	if F.stamina < F.maxStam * DEPTH.windAt and F.state ~= "punching" and not self.tutorial then
		F.gassedFor += rdt
		if F.gassedFor >= DEPTH.windAfter and F.windLeft > 0 and now >= F.windUntil then
			F.windLeft -= 1
			F.winds += 1
			F.windUntil = now + DEPTH.windTime
			F.gassedFor = 0
			F.stamina = math.min(F.stamCap, F.stamina + F.maxStam * DEPTH.windGive)
			self:SendEach(function(V)
				return { t = "intel", hint = V == F and "SECOND WIND! Breathe and go again." or (F.data.name .. " has found a second wind!"), tone = V == F and "good" or "warn", wind = V == F or nil }
			end)
			self:Comment(F.data.name .. " has found a second wind!")
		end
	elseif F.stamina > F.maxStam * (DEPTH.windAt + 0.1) then
		F.gassedFor = 0
	end
	if now < F.windUntil then
		mul *= DEPTH.windRegen
	end
	mul *= 1 + DEPTH.momRegen * self:Mom(F)
	return mul
end

-- every few frames of a live round: the momentum drifts back to even and the clients get it (and the live score)
function Fight:UpdateIntel(dt, now)
	if not self.live or self.paused then
		return
	end
	local m = self.mom or 0
	local k = DEPTH.momDecay * dt
	self.mom = m > 0 and math.max(0, m - k) or math.min(0, m + k)
	self.momSum = (self.momSum or 0) + (self.mom or 0) * dt
	self.intelAcc = (self.intelAcc or 0) + dt
	if self.intelAcc < 0.5 then
		return
	end
	self.intelAcc = 0
	local q = math.floor((self.mom or 0) * 20 + 0.5) / 20
	local live = self.tutorial == nil and not self.spar
	local card = nil
	if live and now >= (self.judgesAt or 0) then
		self.judgesAt = now + 2
		card = self:LiveCard()
	end
	if q == self.momSent and not card then
		return
	end
	self.momSent = q
	self:SendEach(function(V)
		local red = V == self.P
		local msg = { t = "mom", m = red and q or -q }
		if card then
			msg.d = red and card.d or -card.d
			msg.cards = {}
			for j, c in ipairs(card.cards) do
				msg.cards[j] = red and { c[1], c[2] } or { c[2], c[1] }
			end
			msg.round = self.round
		end
		return msg
	end)
end

-- the live score (the judge-scoring visibility option): this round's work so far (the red corner's lead in the
-- judges' points) and the three cards through the last round
function Fight:LiveCard()
	local d = self:RoundPoints(self.P, self.O) - self:RoundPoints(self.O, self.P)
	local cards = {}
	for j = 1, 3 do
		cards[j] = { self.cards[j][1], self.cards[j][2] }
	end
	return { d = math.floor(d * 10 + 0.5) / 10, cards = cards }
end

function Fight:Update(dt)
	local now = self:Now()
	-- while the Moves & Controls menu holds the round nobody recovers: no stamina, no clearing head, no legs
	-- coming back (the menu is for reading, not a free breather)
	local rdt = self.menuHold and 0 or dt
	for _, F in ipairs(self.pair or { self.P, self.O }) do
		self:SampleDevice(F, now)
		self:RecordPose(F, now)
		if F.state == "punching" and now >= F.busyUntil then
			F.state = F.blocking and "blocking" or "idle"
		end
		if F.state == "clinch" and now >= F.clinchUntil then
			F.state = "idle"
		end
		-- a combination whose window has run out (and whose last punch has its result) is over
		if F.chain and not F.chain.closed and now > F.chain.closeAt and now >= F.busyUntil then
			self:CloseChain(F)
			F.chain = nil
		end
		if F.dodgeKind and now >= F.dodgeEnd then
			F.dodgeKind = nil
		end
		local s = F.data.stats
		-- stamina ceiling: body damage and the rounds wear the gas tank down
		F.stamCap = math.clamp(F.maxStam * (0.72 + 0.28 * F.body / 100) - F.stamErosion, F.maxStam * 0.35, F.maxStam)
		local regen = (5 + s.Endurance * 0.06) * F.frame.staminaRegen -- [FrameTraits] the frame's recovery
		if F.state == "punching" then
			regen *= 0.2
		elseif F.blocking then
			regen *= self:GuardMul(F, now, "regen")
		elseif F.state == "clinch" then
			regen *= 1.6
		end
		if F.body < 50 then
			regen *= 0.6
		end
		if F.dmg.nose then
			regen *= 0.85
		end
		regen *= self:DepthRegen(F, now, rdt)
		-- Shift in the ring: quicker feet cost stamina while he moves (none comes back meanwhile)
		if self:Sprinting(F) and F.hum.MoveDirection.Magnitude > 0.1 then
			F.stamina = math.max(0, F.stamina - SPRINT.drain * rdt)
		elseif F.stamina < F.stamCap then
			F.stamina = math.min(F.stamCap, F.stamina + regen * rdt)
		end
		if F.state ~= "down" then
			if now - F.lastHitAt > STUN_QUIET and F.stun > 0 then
				-- a badly hurt fighter clears his head more slowly
				self:ClearStun(F, (STUN_CLEAR + s.Recovery * STUN_CLEAR_PER_RECOVERY) * (1 - 0.4 * F.tier) * rdt)
			end
			if now - F.lastBodyHitAt > 3 then
				F.body = math.min(F.bodyCap, F.body + 0.12 * rdt)
			end
			-- the legs come back with footwork; slower while dazed
			F.balance = math.min(100, F.balance + (18 + s.Footwork * 0.15) * (1 - 0.25 * F.tier) * rdt)
		end
		-- concussion clears slowly (Recovery helps); the peak is what follows the fighter home
		F.conc = math.max(0, F.conc - (CONC.decay + s.Recovery * CONC.decayPerRecovery) * rdt)
		local strainFloor = (F.state == "clinch" and 0.8) or ((self:IsHurt(F) or F.tier >= 2) and 0.5) or 0
		F.strain = math.max(strainFloor, F.strain - rdt * 0.5)
		if F.tier ~= Config.HeadTier(F.health) then
			self:CheckTier(F)
		end
		if F.dmgDirty and now >= (F.dmgNext or 0) then
			self:RefreshDamage(F)
		end
		self:UpdateMovement(F, dt)
		if F == self.O then
			self:Separate(dt)
		end
		self:UpdateGuard(F)
		-- nobody can punch during a count / eight count / referee check, so "not answering back" means nothing
		-- then (the standing man would otherwise be stopped in favour of the one on the canvas)
		if not self.paused then
			self:CheckStoppage(F)
		end
		if F.stamina < F.maxStam * 0.15 and not F.gassedNoted then
			F.gassedNoted = true
			self:Comment(F.data.name .. " is running on fumes!")
		elseif F.stamina > F.maxStam * 0.5 then
			F.gassedNoted = false
		end
	end
	-- (the AI: the blue corner's; the balance sims give the red corner one too)
	for _, F in ipairs(self.pair or { self.P, self.O }) do
		if F.ai then
			F.ai:Observe(self.menuHold and 0 or dt)
			if self.live and not self.paused and not self.menuPending then
				F.ai:Think(now)
			end
		end
	end
	self:UpdateIntel(self.menuHold and 0 or dt, now)
	for _, F in ipairs(self.pair or { self.P, self.O }) do
		if F.blocking then
			F.blockTime = (F.blockTime or 0) + dt
		end
	end
	if self.tutorial then
		self:TutorialStep(dt, now)
	end
	self:UpdateReferee(now)
	self.groupAcc = (self.groupAcc or 0) + dt
	if self.groupAcc >= GROUP_EVERY then
		self.groupAcc = 0
		regroupBoxers(self.P)
		regroupBoxers(self.O)
	end
	-- model attributes at 5 Hz (quantized, change-only)
	self.attrAcc = (self.attrAcc or 0) + dt
	if self.attrAcc >= 0.2 then
		self.attrAcc = 0
		self:SyncAttrs(self.P)
		self:SyncAttrs(self.O)
	end
	self.sendAcc = (self.sendAcc or 0) + dt
	if self.sendAcc >= 0.1 then
		self.sendAcc = 0
		local time = math.max(0, math.ceil(self.roundEnd - now))
		self:SendEach(function(P)
			local b = self:PackState(P, self:Other(P), time, now)
			-- (a packet the same as this viewer's last is skipped: bars full, clock held; one a second all the same)
			local key = buffer.tostring(b)
			if key == P.stateSent and now - (P.stateSentAt or -math.huge) < 1 then
				return nil
			end
			P.stateSent, P.stateSentAt = key, now
			return { t = "state", b = b }
		end)
	end
end

------------------------------------------------------------------------
-- The first-time tutorial (Tutorial.lua): what the player does moves the guided steps on; the client's
-- prompt card follows the "tutorial" messages
------------------------------------------------------------------------
-- the guided bout's protection: may F not be knocked down / stopped right now? (the practice round: the player
-- never, the opponent until the last step is up; the debut: the player until the final round)
function Fight:Protected(F)
	local tr = self.tutorial
	if not (tr and Tutorial) then
		return false
	end
	if F.isPlayer then
		return not Tutorial.PlayerCanDrop(tr, self.round)
	end
	-- (the debut's final round is a real fight both ways: once the player can be dropped, so can he, even if
	-- the guide's hold ran out before its last step)
	if self.debut and (self.round or 0) >= (self.rounds or math.huge) then
		return false
	end
	return not Tutorial.CanDrop(tr)
end

-- the debut's step card: SKIP GUIDE (the Fight remote's tutorialSkip) ends the guidance, the bout goes on as a
-- normal fight (the forgiving damage stays for this one night)
function Fight:EndGuide()
	local tr = self.tutorial
	if not (tr and self.debut) or tr.done then
		return
	end
	tr.done = true
	tr.skipped = true
	self.aiWork = Tutorial.AiWork(tr)
	self.aiDefense = Tutorial.AiDefense(tr)
	self:SendTo(self.P, Tutorial.View(tr))
end
FightEngine.EndGuide = function(player)
	local fight = FightEngine.Active[player]
	if fight then
		fight:EndGuide()
	end
end

function Fight:TutorialNote(ev)
	local tr = self.tutorial
	if not (tr and Tutorial) or tr.done then
		return
	end
	ev.now = self:Now()
	if Tutorial.Feed(tr, ev) then
		self.aiWork = Tutorial.AiWork(tr)
		self.aiDefense = Tutorial.AiDefense(tr)
		self:SendTo(self.P, Tutorial.View(tr))
		if tr.done and not self.tutorialEndAt and not self.debut then
			-- (a knockdown: the count plays out first; Update ends the bout once both men are up, or the
			-- count ends it as a KO)
			self.tutorialEndAt = ev.now + 1.5
		end
	end
end

-- every frame of a live round: footwork, the guard held, the stamina tank, the step timeouts, the end
function Fight:TutorialStep(dt, now)
	local P = self.P
	if self.live and not self.paused and not self.menuHold and P.state ~= "down" then
		local root = P.root
		if root then
			local pos = root.Position
			local last = self.tutorialPos
			self.tutorialPos = pos
			if last then
				local d = flat(pos - last).Magnitude
				if d > 0.01 and d < 3 then -- (a teleport back to the corner is not footwork)
					self:TutorialNote({ k = "move", dist = d })
				end
			end
		end
		if P.blocking then
			self:TutorialNote({ k = "block", dt = dt })
		end
		self:TutorialNote({ k = "stamina", pct = P.stamina / math.max(1, P.maxStam) })
		self:TutorialNote({ k = "tick" })
	else
		self.tutorialPos = nil
	end
	if self.tutorialEndAt and not self.debut and now >= self.tutorialEndAt and not self.finished and P.state ~= "down" and self.O.state ~= "down" then
		self:End(P, "Tutorial", "Tutorial complete")
	end
end

------------------------------------------------------------------------
-- Scoring & corner
------------------------------------------------------------------------
-- [Judging] the three ringside judges (BoxerModules.Judging: pure, tools/sim/test_judging.luau pins it) and the
-- post-fight scene (BoxerModules.PostFight: the men to the centre, the announcer, the referee raises the hand).
-- Both optional: without them the flat card below stands in and the fight ends as it did.
local Judging, PostFight
do
	local okJ, modJ = pcall(require, script.Parent:FindFirstChild("Judging"))
	Judging = okJ and type(modJ) == "table" and modJ or nil
	local okP, modP = pcall(require, script.Parent:FindFirstChild("PostFight"))
	PostFight = okP and type(modP) == "table" and modP or nil
end
-- One judge's 10-point must card for a round. diff = the judge's punch differential (positive: the
-- first fighter did the better work), kdA / kdB = knockdowns each fighter SCORED. As real judges do:
-- the round winner gets 10 and the loser 9; a knockdown wins the round for whoever scored it (equal
-- knockdowns cancel and the work decides), and every net knockdown costs the man who went down one
-- more point (one knockdown 10-8, two 10-7) - unless he dominated the rest of the round, which earns
-- that point back (10-9). 10-10 only for a truly even round with no knockdowns; never 9-9.
-- (Judging.MustScore is the same rule plus the fouls' point deductions; this stays as the fallback.)
local EVEN_ROUND = 0.25 -- |diff| under this is an even round (rare: judges are told to pick a winner)
local DOMINANT_ROUND = 3 -- a punch differential this big outweighs one knockdown point
function FightEngine.MustScore(diff, kdA, kdB, foulsA, foulsB)
	if Judging then
		return Judging.MustScore(diff, kdA, kdB, foulsA, foulsB)
	end
	kdA, kdB = tonumber(kdA) or 0, tonumber(kdB) or 0
	diff = tonumber(diff) or 0
	local net = kdA - kdB
	local aWins
	if net ~= 0 then
		aWins = net > 0
	elseif kdA == 0 and math.abs(diff) < EVEN_ROUND then
		return 10, 10
	else
		aWins = diff >= 0
	end
	local down = math.abs(net)
	if down > 0 and (aWins and -diff or diff) >= DOMINANT_ROUND then
		down -= 1 -- the knocked-down man won the rest of the round clearly
	end
	local loser = math.max(6, 9 - down)
	if aWins then
		return 10, loser
	end
	return loser, 10
end

-- a fighter's work in the round as the judges see it: clean punches, power, body work, activity, inside work in
-- the clinch, minus the holding, plus the other man's misses, plus a little of the round's momentum (effective
-- aggression and ring generalship: Config.FightDepth.momScore at a round spent all his way)
function Fight:RoundPoints(F, other)
	local t = F.tally
	local mom = (self.momSum or 0) / math.max(1, self.roundSeconds or 60)
	if F ~= self.P then
		mom = -mom
	end
	return t.landed * 1 + t.power * 0.8 + t.body * 0.5 + t.thrown * 0.04 - t.clinches * 0.3 + (other.tally.thrown - other.tally.landed) * 0.03
		+ (t.inside or 0) * 0.3 + DEPTH.momScore * math.clamp(mom, -1, 1)
end

-- [Judging] the judges' observer. The tallies keep the landed / thrown / power / body / knockdown counts; what the
-- judges also want (punches landed BY TYPE, blocks, slips, rolls, parries, the other man's misses, the time in the
-- centre of the ring) is read off the engine's own traffic - Fight:Send's "hit" / "blocked" / "defense" / "miss"
-- (red-corner perspective: who = "you" is P) and the 5 Hz attribute sync (the ring position while the round is
-- live) - so the hit path carries no judging code. A sim that replaces Send per fight (tools/sim/fightsim) leaves
-- these at zero and the tallies carry the card.
local function judgeSide(F)
	if not F.judge then
		F.judge = Judging and Judging.NewSide() or { byType = {}, thrownByType = {} }
	end
	return F.judge
end
local baseSend = Fight.Send
function Fight:Send(msg)
	if Judging and type(msg) == "table" and self.P and self.O then
		if self.live and self.roundEnd then
			-- (the round clock at the last live event: a stoppage's "at 1:32 of round 3" for the announcer)
			self.judgeRoundLeft = self.roundEnd - self:Now()
		end
		local who = msg.who == "you" and self.P or (msg.who == "opp" and self.O or nil)
		if who then
			local t = msg.t
			if t == "hit" then
				local S = judgeSide(who)
				local k = msg.punch
				if type(k) == "string" then
					S.byType[k] = (S.byType[k] or 0) + 1
				end
				if msg.heavy then
					S.heavy += 1
				end
				S.damage += tonumber(msg.dmg) or 0
			elseif t == "blocked" then
				judgeSide(who).blocked += 1 -- (who = the man whose guard took it)
			elseif t == "defense" then
				local S = judgeSide(who) -- (who = the man who made it miss)
				if msg.move == "PARRIED" then
					S.parried += 1
				else
					S.evaded += 1
				end
			elseif t == "miss" then
				judgeSide(self:Other(who)).missed += 1 -- (who = the man who threw it)
			end
		end
	end
	return baseSend(self, msg)
end
local baseSyncAttrs = Fight.SyncAttrs
function Fight:SyncAttrs(F)
	if Judging and self.live and F and F.root and self.anchors and self.anchors.RingCenter then
		local now = self:Now()
		local dt = now - (F.judgeAt or now)
		F.judgeAt = now
		if dt > 0 and dt < 1 then
			local S = judgeSide(F)
			S.liveT += dt
			local off = flat(F.root.Position - self.anchors.RingCenter.Position)
			if math.max(math.abs(off.X), math.abs(off.Z)) <= (self.ringHalf or 11) * 0.42 then
				S.centreT += dt
			end
		end
	end
	return baseSyncAttrs(self, F)
end

-- the observer's slate for the next round: the running fight counters are snapshotted so the round's share is
-- their difference at the bell
function Fight:JudgeReset(F)
	F.judge = nil
	F.judgeAt = nil
	F.judgeSnap = { counters = F.typeStats.counters, pressT = F.typeStats.pressT, liveT = F.typeStats.liveT, evades = F.evades, used = table.clone(F.punchesUsed) }
end

local function plainSide(S)
	local o = {}
	for k, v in pairs(S) do
		if type(v) == "number" then
			o[k] = math.floor(v * 100) / 100
		elseif type(v) == "table" then
			o[k] = table.clone(v)
		end
	end
	return o
end

-- the round's stats for the judges (Judging.Score's input): both corners, red first
function Fight:RoundStats()
	local function side(F)
		local S = judgeSide(F)
		local t = F.tally
		local snap = F.judgeSnap or {}
		S.landed, S.thrown, S.power, S.body = t.landed, t.thrown, t.power, t.body
		S.jabs = math.max(0, t.landed - t.power)
		S.kd, S.clinches, S.inside = t.kd, t.clinches, t.inside or 0
		S.counters = math.max(0, F.typeStats.counters - (snap.counters or 0))
		S.pressT = math.max(0, F.typeStats.pressT - (snap.pressT or 0))
		if S.liveT <= 0 then
			S.liveT = math.max(0, F.typeStats.liveT - (snap.liveT or 0))
		end
		for k, n in pairs(F.punchesUsed) do
			S.thrownByType[k] = math.max(0, n - ((snap.used or {})[k] or 0))
		end
		-- punches a dodge made miss (the engine's own count) when the observer saw fewer
		S.evaded = math.max(S.evaded, F.evades - (snap.evades or 0))
		local mom = (self.momSum or 0) / math.max(1, self.roundSeconds or 60)
		S.mom = math.clamp(F == self.P and mom or -mom, -1, 1)
		-- (the engine hands out no fouls yet: a referee's point deduction lands here)
		S.fouls = tonumber(F.fouls) or 0
		return S
	end
	return { red = side(self.P), blue = side(self.O), seconds = self.roundSeconds or Config.RoundSeconds }
end

-- the round's scorecard for viewer V (the client's Scorecards opens it with the rest message): the three judges'
-- round cards and reasons, the round's and the fight's punch stats of both men, the running totals
function Fight:ScorecardFor(V, detail, n)
	local red = V == self.P
	local function flip2(c)
		return red and { c[1], c[2] } or { c[2], c[1] }
	end
	local msg = { t = "scorecard", n = n, rounds = self.rounds, cards = {}, round = {}, judges = {}, kd = flip2(detail.kd) }
	for j = 1, 3 do
		msg.cards[j] = flip2(self.cards[j])
		msg.round[j] = flip2(detail.cards[j])
		local jd = detail.judges[j]
		msg.judges[j] = { id = jd.id, reason = jd.reason, diff = red and jd.diff or -jd.diff }
	end
	local st, tot = detail.stats, self.judgeTotals
	msg.stats = { you = red and st.red or st.blue, opp = red and st.blue or st.red }
	msg.totals = { you = plainSide(red and tot.red or tot.blue), opp = plainSide(red and tot.blue or tot.red) }
	return msg
end

function Fight:ScoreRound()
	local P, O = self.P, self.O
	local round, detail
	if Judging then
		local stats = self:RoundStats()
		detail = Judging.Score(stats, self.rng)
		detail.stats = { red = plainSide(stats.red), blue = plainSide(stats.blue) }
		round = detail.cards
		self.judgeRounds = self.judgeRounds or {}
		table.insert(self.judgeRounds, detail)
		self.judgeTotals = self.judgeTotals or { red = Judging.NewSide(), blue = Judging.NewSide() }
		Judging.AddSide(self.judgeTotals.red, stats.red)
		Judging.AddSide(self.judgeTotals.blue, stats.blue)
	else
		local pP, pO = self:RoundPoints(P, O), self:RoundPoints(O, P)
		round = {}
		for j = 1, 3 do
			local diff = pP - pO + self.rng:NextNumber(-1.6, 1.6) * (j == 3 and 1.4 or 1)
			local a, b = FightEngine.MustScore(diff, P.tally.kd, O.tally.kd)
			round[j] = { a, b }
		end
	end
	for j = 1, 3 do
		self.cards[j][1] += round[j][1]
		self.cards[j][2] += round[j][2]
	end
	table.insert(self.roundCards, round)
	self:JudgeReset(P)
	self:JudgeReset(O)
	if detail then
		local n = #self.roundCards
		self:SendEach(function(V)
			return self:ScorecardFor(V, detail, n)
		end)
	end
	return round
end

function Fight:EstimateLead(F)
	local lead = 0
	for _, r in ipairs(self.roundCards) do
		local a, b = r[1][1], r[1][2]
		if F == self.O then
			a, b = b, a
		end
		if a > b then
			lead += 1
		elseif b > a then
			lead -= 1
		end
	end
	return lead
end

function Fight:CornerAdvice(P)
	P = P or self.P
	local O = self:Other(P)
	local tips = {}
	if self.spar then
		table.insert(tips, "Good work. Keep your hands up and work on your timing.")
	end
	if P.healthCap < 60 or P.conc > 0.4 or P.tier >= 1 then
		table.insert(tips, "You're hurt. Hold (G), tie him up, keep that guard high and SURVIVE this round.")
	end
	if P.stamina < P.maxStam * 0.4 then
		table.insert(tips, "Breathe! You're punching yourself out - pick your shots.")
	end
	if O.tally.body >= 3 or P.body < 55 then
		table.insert(tips, "Elbows tight! They're investing in the body.")
	end
	if O.tier >= 1 or O.conc > 0.4 then
		table.insert(tips, "Those legs are GONE! Hooks and uppercuts - go finish it, but stay behind the jab.")
	elseif O.ai and O.ai.mode == "survive" then
		table.insert(tips, "They're HURT! Go get them, but don't get careless.")
	elseif O.ai and O.ai.mode == "pressure" then
		table.insert(tips, "They're coming forward now - pivot (Z/X) and make them pay with counters.")
	end
	-- the ring traits we know about against what we're doing tonight (Shared.Traits), then his eyes, then his read
	local myType = self:FightingType(P)
	for _, t in ipairs(O.traits or {}) do
		if O.traitSeen[t.id] and Traits.Resists(t.id, myType) then
			local D = Traits.Data[t.id]
			table.insert(tips, string.format("%s, and you're fighting like a %s. %s", D.name, Traits.Types[myType].name:lower(), D.counter))
			break
		end
	end
	for _, side in ipairs({ 1, -1 }) do
		if self:Blind(O, side) > 0.45 then
			table.insert(tips, string.format("His %s eye is closing - work the %s hand, he can't see it coming.", side == 1 and "right" or "left", side == 1 and "left" or "right"))
			break
		end
	end
	if O.ai and O.ai.read then
		local fav, share = O.ai.read:Favourite()
		if fav and share > 0.42 and O.ai.read.total > 8 then
			table.insert(tips, string.format("He's reading your %s. Mix it up, feint it, then throw something else.", (Config.PunchNames[fav] or fav):lower()))
		end
	end
	local lead = self:EstimateLead(P)
	if lead < 0 then
		table.insert(tips, "We're behind on the cards. You need to win this round!")
	elseif lead >= 2 then
		table.insert(tips, "You're up on the cards. Stay smart, don't get caught.")
	end
	if P.dmg.cut > 0.4 or P.dmg.cut2 > 0.4 then
		table.insert(tips, "Cutman's working on that cut - keep your guard high.")
	end
	if math.max(P.dmg.leftEye, P.dmg.rightEye) > 0.5 then
		table.insert(tips, "The enswell is on that eye. Turn away from the hand that's closing it.")
	end
	if P.data.eliteCorner and O.ai then
		table.insert(tips, "ELITE COACH: " .. (O.ai:Weakness() or "Stay focused."))
	elseif #tips == 0 then
		table.insert(tips, "Good round. Jab, move, parry (R) their straight shots and counter.")
	end
	if O.isPlayer and P.isPlayer and #tips < 2 then
		table.insert(tips, "He's a real fighter, not a script: watch what he does after he throws, and make him pay.")
	end
	if P.blockTime and P.blockTime > 15 then
		table.insert(tips, "Don't just shell up - slip (Q/E) or roll (C) and counter!")
	end
	return tips
end

-- what the corner sees on its own fighter between rounds (shown under the advice)
function Fight:ConditionReport(F)
	local d = F.dmg
	local out = {}
	local function sideName(side)
		return side == 1 and "right" or "left"
	end
	if d.cut > 0.2 then
		table.insert(out, string.format("Cut over the %s eye (%s)", sideName(d.cutSide), d.cut > 0.7 and "deep" or "bleeding"))
	end
	if d.cut2 > 0.2 then
		table.insert(out, string.format("Second cut, %s side", sideName(d.cutSide2)))
	end
	local eye = math.max(d.leftEye, d.rightEye)
	if eye > 0.3 then
		table.insert(out, string.format("%s eye %s", d.leftEye > d.rightEye and "Left" or "Right", eye > 0.75 and "nearly shut" or "swelling"))
	end
	if d.nose then
		table.insert(out, "Broken nose")
	end
	if math.max(d.ribsL, d.ribsR) > 0.4 then
		table.insert(out, "Ribs are sore")
	end
	if F.conc > 0.5 then
		table.insert(out, "Still seeing double")
	elseif F.conc > 0.25 then
		table.insert(out, "Head's a little foggy")
	end
	return {
		head = math.floor(F.health), cap = math.floor(F.healthCap), body = math.floor(F.body), bodyCap = math.floor(F.bodyCap),
		conc = math.floor(F.conc * 100) / 100, face = (Config.FaceDamageStage(d)), notes = out,
	}
end

------------------------------------------------------------------------
-- Flow
------------------------------------------------------------------------
function Fight:End(winner, method, reason)
	if self.finished then
		return
	end
	self.finished = true
	self.live = false
	self.winner = winner
	self.method = method
	self.reason = reason
	self.endRound = self.round
end

function Fight:SetSweat(level)
	for _, F in ipairs({ self.P, self.O }) do
		if F.model then
			local ok, err = pcall(Builder.SetSweat, F.model, F.data.app, level)
			if not ok then
				warn("[Boxer] SetSweat failed:", err)
			end
		end
	end
end

function Fight:Rest()
	local P, O = self.P, self.O
	self.live = false
	self:Place(P, self.anchors.RedCorner.Position)
	self:Place(O, self.anchors.BlueCorner.Position)
	for _, F in ipairs({ P, O }) do
		local s = F.data.stats
		local nut = F.data.nutrition and 1.15 or 1
		local elite = F.data.eliteCorner
		-- every round leaves a little less in the tank; Endurance slows that
		F.stamErosion += F.maxStam * 0.03 * math.max(0, 1 - s.Endurance / 150)
		F.bodyCap = math.max(40, F.bodyCap - (F.bodyCap - F.body) * 0.25)
		F.body = math.min(F.bodyCap, F.body + 8 * nut)
		F.stamCap = math.clamp(F.maxStam * (0.72 + 0.28 * F.body / 100) - F.stamErosion, F.maxStam * 0.35, F.maxStam)
		F.stamina = math.min(F.stamCap, F.stamina + F.maxStam * (0.25 + s.Recovery * 0.004) * nut * F.frame.staminaRegen) -- [FrameTraits]
		F.healthCap = math.max(30, F.healthCap - (100 - F.health) * 0.12)
		-- the minute's rest clears the stun and the corner gets a little more back
		F.health = math.min(F.healthCap, F.health + F.stun + (2 + s.Recovery * 0.05) * nut)
		F.stun = 0
		F.conc = math.max(0, F.conc - (elite and CONC.restHealElite or CONC.restHeal))
		-- the cutman and the enswell
		local d = F.dmg
		d.cut = math.max(0, d.cut - (elite and 0.25 or 0.15))
		d.cut2 = math.max(0, d.cut2 - (elite and 0.25 or 0.15))
		d.noseBleed = math.max(0, d.noseBleed - 0.3)
		d.leftEye = math.max(0, d.leftEye - (elite and 0.12 or 0.08))
		d.rightEye = math.max(0, d.rightEye - (elite and 0.12 or 0.08))
		d.redness = math.max(0, d.redness - 0.2)
		F.hurtUntil = 0
		F.stumbleUntil = 0
		F.stumbleVel = nil
		F.balance = 100
		F.kdRound = 0
		F.blocking = false
		F.state = "idle"
		F.strain = 0
		F.guardOverride = "rest"
		F.exprOverride = (F.stamina < F.maxStam * 0.5 or F.tier >= 1) and "fatigue" or nil
		self:CheckTier(F)
		self:RefreshDamage(F, true)
		self:UpdateGuard(F)
		self:SyncAttrs(F)
	end
end

-- the guided debut's last rest: the held rounds can leave the player at ~30 head HP after long lessons, so the
-- corner gets him back to his cap for the final round (the one where he can be stopped)
function Fight:DebutFinalRest()
	local P = self.P
	if not P.isPlayer then
		return
	end
	P.health = math.max(P.health, P.healthCap)
	P.stun = 0
	P.stamina = math.max(P.stamina, P.stamCap)
	P.conc = math.min(P.conc, 0.2)
	self:CheckTier(P)
end

function Fight:DoctorCheck()
	for _, F in ipairs({ self.P, self.O }) do
		local d = F.dmg
		local why
		if self:Protected(F) then
			-- (the guided bout: nobody it protects is stopped by the doctor either - the debut's player before
			-- the final round)
			d = { cut = 0, cut2 = 0, leftEye = 0, rightEye = 0 }
		end
		if d.cut >= 1 or d.cut2 >= 1 then
			why = "cut"
		elseif d.leftEye >= 1 and d.rightEye >= 1 then
			why = "eyes swollen shut"
		elseif F.conc >= 0.92 and F.kdTotal >= 2 and not self:Protected(F) then
			why = "concussion"
		end
		if why then
			self:Comment("The ringside doctor has seen enough!", true)
			self:End(self:Other(F), self.spar and "Stopped" or "TKO", "Doctor stops the fight (" .. why .. ")")
			return
		end
	end
	local O = self.O
	-- (never in the guided bout before its final round: the lesson is the player's to finish)
	local guided = self.tutorial ~= nil and (not self.debut or (self.round or 0) + 1 < (self.rounds or 0) or self:Protected(O))
	if not self.spar and not guided and not O.isPlayer and (O.healthCap < 40 or O.conc > 0.8) and self:EstimateLead(O) < -2 and self.rng:NextNumber() < 0.3 then
		self:End(self.P, "RTD", "Opponent's corner retires them")
	end
end

-- one fighter's ring walk: his own client walks a player (and plays his music / intro); everybody else
-- gets the "opp" walkout shot; an NPC is walked by the server
function Fight:WalkOut(W, steps, pyro)
	self:SendEach(function(V)
		if V == W then
			return { t = "entrance", phase = "you", music = W.data.music, target = steps, pyro = pyro,
				intro = Config.AnnouncerIntro[W.data.voice or "Calm"] or Config.AnnouncerIntro.Calm }
		end
		return { t = "entrance", phase = "opp", pyro = pyro }
	end)
	if not W.isPlayer and W.hum then
		W.hum.WalkSpeed = 8
		W.hum:MoveTo(steps)
		-- [Studio] the intended velocity for the clients' Animator (its gait on a replicated root follows this)
		if W.root and W.model then
			local d = Vector3.new(steps.X - W.root.Position.X, 0, steps.Z - W.root.Position.Z)
			W.model:SetAttribute("Gait", d.Magnitude > 0.5 and d.Unit * 8 or nil)
			local m = W.model
			task.delay(math.clamp(d.Magnitude / 8 + 1, 2, 20), function()
				if m.Parent then
					m:SetAttribute("Gait", nil)
				end
			end)
		end
	end
end

function Fight:Entrance()
	local P, O = self.P, self.O
	-- [Entrance] the cinematic ring walk: RingWalk runs the Shared.Entrance beats (and ends in the corners)
	if RingWalk then
		local okW, errW = pcall(RingWalk.Run, self)
		if okW then
			return
		end
		warn("[Boxer] RingWalk failed:", errW)
		if self.aborted then
			return
		end
	end
	local isStadium = self.venue == "Stadium"
	pcall(Builder.SetRobe, O.model, O.data.app, true, O.data.lookOpts)
	pcall(Builder.SetRobe, P.model, P.data.app, true, P.data.lookOpts)
	-- a tournament belt he won, round the waist over the robe for the walk (data.walkBelt: Tourney.WornBelt)
	self:WalkBelt(P, true)
	self:Place(O, self.anchors.BlueEntrance.Position, self.anchors.RingCenter.Position)
	self:Place(P, self.anchors.RedEntrance.Position, self.anchors.RingCenter.Position)
	for _, F in ipairs({ P, O }) do
		F.guardOverride = "walkout"
		F.exprOverride = (F.data.mental.Confidence or 50) > 60 and "confident" or "determined"
		self:UpdateGuard(F)
		self:SyncAttrs(F)
	end
	task.wait(0.5)
	self:Comment("Making the walk now... " .. O.data.name .. "!", true)
	self:WalkOut(O, self.anchors.BlueSteps.Position, isStadium)
	task.wait(isStadium and 6 or 4.5)
	if self.aborted then
		return
	end
	self:Place(O, self.anchors.BlueCorner.Position)
	self:WalkOut(P, self.anchors.RedSteps.Position, isStadium)
	task.wait(isStadium and 7 or 5.5)
	if self.aborted then
		return
	end
	self:Place(P, self.anchors.RedCorner.Position)
	pcall(Builder.SetRobe, P.model, P.data.app, false)
	pcall(Builder.SetRobe, O.model, O.data.app, false)
	self:WalkBelt(P, false)
end

-- the ring walk's belt (on = true builds it round the LowerTorso, false takes it off): BeltModel's worn loop, welded
function Fight:WalkBelt(F, on)
	if F.walkBelt then
		F.walkBelt:Destroy()
		F.walkBelt = nil
	end
	local key = F.data and F.data.walkBelt
	if not (on and key and BeltModel and Tournaments and F.model) then
		return
	end
	pcall(function()
		local lt = F.model:FindFirstChild("LowerTorso")
		local design = Tournaments.Design(key, Config.Orgs)
		if not (lt and design) then
			return
		end
		-- over the robe: a little wider than the bare waist
		local robe = F.model:FindFirstChild("BoxerLook") and F.model.BoxerLook:FindFirstChild("Robe")
		local pad = robe and 0.28 or 0.04
		local m = BeltModel.Build(design, { mode = "worn", waist = lt.Size + Vector3.new(pad, 0, pad), anchored = false, cframe = lt.CFrame * CFrame.new(0, 0.05, 0), name = "WalkBelt" })
		local w = Instance.new("WeldConstraint")
		w.Part0 = lt
		w.Part1 = m.PrimaryPart
		w.Parent = m.PrimaryPart
		m.Parent = F.model
		F.walkBelt = m
	end)
end

-- Before every round: both fighters stand in their own corners, held there (no steps, no punches - the
-- fight is not live, so the engine refuses every input), while the clients count 3 - 2 - 1 - BOX!. The
-- server owns the timing: one "countdown" message per beat, n = 0 is the bell. Movement comes back on GO.
local COUNT_BEAT = 0.8
FightEngine.COUNT_BEAT = COUNT_BEAT
function Fight:HoldCorners()
	local red, blue = self.anchors.RedCorner.Position, self.anchors.BlueCorner.Position
	self:RefToOrbit()
	for _, X in ipairs({ { self.P, red, blue }, { self.O, blue, red } }) do
		local F = X[1]
		if F.root and F.model and F.model.Parent then
			local p = F.root.Position
			local want = X[2]
			-- re-place only when he is not already there (a quiet corner stays quiet)
			if flat(p - want).Magnitude > 1.2 or not F.cornerHeld then
				self:Place(F, want, X[3])
			end
			F.cornerHeld = true
			if F.align then
				local dir = flat(X[3] - want)
				if dir.Magnitude > 0.05 then
					F.align.CFrame = CFrame.lookAt(Vector3.zero, dir.Unit)
					F.alignDir = nil -- UpdateMovement writes its next facing whatever it is
				end
			end
		end
		if F.hum and F.hum.Parent then
			F.hum.WalkSpeed = 0
			if not F.isPlayer then
				F.aiTarget = nil
				F.hum:MoveTo(F.root and F.root.Position or Vector3.zero)
			end
		end
		F.blocking = false
		if F.state ~= "down" then
			F.state = "idle"
		end
	end
end

function Fight:Countdown()
	self.live = false
	self.inCountdown = true
	for _, F in ipairs({ self.P, self.O }) do
		F.cornerHeld = false
	end
	self:HoldCorners()
	task.wait(0.6)
	for n = 3, 0, -1 do
		if self.finished or self.aborted then
			break
		end
		self:HoldCorners()
		self:Send({ t = "countdown", n = n, round = self.round })
		if n > 0 then
			-- hold the corners through the beat (a client that ignores WalkSpeed 0 is put back)
			local t0 = self:Now()
			while self:Now() - t0 < COUNT_BEAT and not self.finished and not self.aborted do
				task.wait(0.1)
				self:HoldCorners()
			end
		end
	end
	self.inCountdown = false
end

function Fight:ReleaseCorners()
	for _, F in ipairs({ self.P, self.O }) do
		F.cornerHeld = false
	end
	-- UpdateMovement sets each fighter's real speed from the next frame on
end

-- a fighter's unlocked special moves as an ordered list of ids (Moves.List order)
local function movesList(F)
	local out = {}
	if Moves then
		for _, id in ipairs(Moves.List) do
			if F.moves[id] then
				table.insert(out, id)
			end
		end
	end
	return out
end

local function femaleOf(F)
	return type(F.data.app) == "table" and F.data.app.gender == 2
end

-- a round's fresh start (Run, and the balance sims' own loop): the tallies, the round's momentum for the judges,
-- the AI's game plan
function Fight:StartRound(r)
	self.round = r
	self.momSum = 0
	for _, F in ipairs({ self.P, self.O }) do
		F.tally = { landed = 0, power = 0, body = 0, thrown = 0, kd = 0, clinches = 0, inside = 0 }
		F.guardOverride = nil
		F.exprOverride = nil
		self:UpdateGuard(F)
	end
	for _, F in ipairs({ self.P, self.O }) do
		if F.ai then
			F.ai:UpdateMode()
		end
	end
end

-- the ring traits on tonight: an AI boxer's (Shared.Traits) in a career bout only - never in a spar, the tutorial
-- or the guided debut, never for a player
function Fight:EnableTraits()
	for _, F in ipairs({ self.P, self.O }) do
		F.traits = {}
		if not F.isPlayer and not self.spar and not self.tutorial and not self.pvp then
			F.traits = F.traitsAll or {}
		end
	end
end

-- the scouting of F's traits for the tale of the tape (Traits.Scout: on the tapes, met before, an elite corner)
function Fight:ScoutTraits(F, viewer)
	if #F.traits == 0 then
		return nil
	end
	local list = Traits.Scout(F.traits, { fights = F.data.record, h2h = F.data.h2h, elite = viewer and viewer.data.eliteCorner })
	local out = {}
	for _, t in ipairs(list) do
		local D = Traits.Data[t.id]
		if t.known then
			F.traitSeen[t.id] = true
			table.insert(out, { id = t.id, name = D.name, desc = D.desc, counter = D.counter })
		else
			table.insert(out, { hidden = true })
		end
	end
	return out
end

function Fight:Run()
	local P, O = self.P, self.O
	local offer = self.offer
	self.knockdowns = {}
	self:EnableTraits()
	for _, F in ipairs({ P, O }) do
		setAttr(F.model, "Style", F.style.id)
		self:SyncAttrs(F)
	end
	self:SpawnReferee()
	-- (the two bodies collide with each other in their own group even when the referee could not be built)
	if ensureGroups() then
		pcall(joinBoxers, P)
		pcall(joinBoxers, O)
	end
	local function tapeOf(F)
		local t = { name = F.data.name, nick = F.data.nick, nat = F.data.nat, record = F.data.record, height = F.data.height, reach = F.data.reach, style = F.style.name,
			overall = Config.Overall(F.data.stats), female = femaleOf(F), frame = F.frame.name } -- [FrameTraits] the frame on the tape
		if F.isPlayer then
			-- PvP: the HUD names the Roblox account behind the boxer (and the record is the PvP one)
			t.player = self.pvp and F.player and ("@" .. F.player.Name) or nil
			t.rating = self.pvp and F.data.pvpRating or nil
		else
			t.archetype = (Config.FindById(Config.Archetypes, F.data.archetype) or {}).name
			-- the scouting report on his ring traits (the hidden ones as "?"; revealed in the fight: `trait`)
			t.traits = self:ScoutTraits(F, self:Other(F))
		end
		return t
	end
	self:SendEach(function(V)
		local X = self:Other(V)
		return {
			t = "start", rounds = self.rounds, kind = offer.kind, stakes = offer.stakes or {}, playerStakes = offer.playerStakes or {},
			arena = self.arena, oppModel = X.model, venue = self.venue, venueName = offer.venueName or "", spar = self.spar,
			weighIn = V.data.mods and V.data.mods.weighIn, notes = V.data.mods and V.data.mods.notes,
			refModel = self.ref and self.ref.model, allowKD = self.allowKD, pvp = self.pvp,
			tape = { you = tapeOf(V), opp = tapeOf(X) },
			talk = V == P and offer.talk or "", myLine = V == P and offer.myLine or "",
			-- the special moves this viewer may throw (ids) and the aim-assist level the server will honour
			moves = movesList(V), assist = V.assist,
			-- the hit detection's frames (HitGeometry): the client's prediction and range read-out run on these
			geo = { you = V.geo, opp = X.geo, floor = self:Floor() },
			-- the first-time tutorial: the client puts its step card up
			tutorial = self.tutorial and Tutorial and { total = #(self.tutorial.steps or Tutorial.STEPS), special = self.tutorial.special or (not self.debut and Tutorial.SPECIAL) or nil,
				debut = self.debut or nil } or nil,
		}
	end)
	if self.tutorial and Tutorial then
		self:SendTo(P, Tutorial.View(self.tutorial))
	end
	-- the Animator only drives tagged models: tag now so the ring walk / warm-up (Guard "walkout") is animated
	-- (E's integration request; the later AddTag calls are harmless no-ops)
	CollectionService:AddTag(P.model, "Fighter")
	CollectionService:AddTag(O.model, "Fighter")
	if self.spar or (self.tutorial and not self.debut) then
		self:Place(O, self.anchors.BlueCorner.Position)
		self:Place(P, self.anchors.RedCorner.Position)
		task.wait(1.5)
	else
		self:Entrance()
		if self.aborted then
			return nil
		end
	end
	self:SetupFacing(P)
	self:SetupFacing(O)
	CollectionService:AddTag(P.model, "Fighter")
	CollectionService:AddTag(O.model, "Fighter")
	if not self.spar and (not self.tutorial or self.debut) then
		self:Send({ t = "tape" })
		self:Wait(5)
	end

	for r = 1, self.rounds do
		if self.finished or self.aborted then
			break
		end
		self.round = r
		self:StartRound(r)
		self:SetSweat(math.min(1, (r - 1) / math.max(1, self.rounds - 1) * 1.1 + 0.1))
		-- (a Shift held over the bell is let go here and on the client's `round`: a fresh press for the new round)
		P.sprintOn, O.sprintOn = false, false
		self:Send({ t = "round", n = r, total = self.rounds })
		if r == 1 then
			self:Comment(self.spar and "Sparring session starts. Work on your craft." or (self.debut and "The debut! Follow your coach's steps on screen."
				or (self.tutorial and "Your first fight. Follow the steps on screen." or "Here we go! Round one!")), true)
		elseif r == self.rounds then
			self:Comment("Final round! Everything on the line!", true)
		end
		-- both men wait in their own corners for the bell, then 3 - 2 - 1 - BOX!
		self:Countdown()
		if self.finished or self.aborted then
			break
		end
		self.live = true
		self.paused, self.kdHold, self.menuHold = false, false, false
		self.resumedAt = self:Now()
		P.assistCount, O.assistCount = 0, 0
		self:ReleaseCorners()
		local remaining = self.roundSeconds
		self.roundEnd = self:Now() + remaining
		while remaining > 0 and not self.finished and not self.aborted do
			local dt = RunService.Heartbeat:Wait()
			self:UpdateMenuHold(self:Now())
			-- the tutorial holds the clock while a step is being learned; round 1 ends soon after its last step
			local tphase = self.tutorial and Tutorial and Tutorial.Phase(self.tutorial, r, self:Now()) or nil
			if tphase == "break" and self.tutorialBreak ~= r then
				self.tutorialBreak = r
				remaining = math.min(remaining, Tutorial.BREAK_SECONDS)
				self.roundEnd = self:Now() + remaining
			end
			if self.paused or tphase == "hold" then
				self.roundEnd += dt
			else
				remaining -= dt
			end
			self:Update(dt)
			if self.tutorial and not (self.player and self.player.Parent) then
				-- (the player left: nothing would ever move a held clock on)
				self.aborted, self.finished = true, true
			end
		end
		self.live = false
		if self.menuHold then
			-- (the fight ended under the menu's hold: a forfeit, a disconnect)
			self.menuHold, self.paused = false, false
			self:SendTo(P, { t = "pause", on = false })
		end
		if self.finished or self.aborted then
			break
		end
		local rc = self:ScoreRound()
		-- (the bell ends every running combination)
		self:CloseChain(P)
		self:CloseChain(O)
		self:Send({ t = "bell", n = r })
		if self.tutorial then
			self:TutorialNote({ k = "bell" })
			if self.tutorial.done and not self.finished and not self.debut then
				self:End(P, "Tutorial", "Tutorial complete")
				break
			end
		end
		if r < self.rounds then
			self:Rest()
			if self.debut and r + 1 >= self.rounds then
				self:DebutFinalRest()
			end
			if not self.tutorial or (self.debut and r + 1 >= self.rounds) then
				self:DoctorCheck()
			end
			if self.finished then
				break
			end
			local avgP, avgO = 0, 0
			for j = 1, 3 do
				avgP += self.cards[j][1]
				avgO += self.cards[j][2]
			end
			local uP, uO = math.floor(avgP / 3 + 0.5), math.floor(avgO / 3 + 0.5)
			self:SendEach(function(V)
				local X = self:Other(V)
				local red = V == P -- the cards are kept red corner first
				return {
					t = "rest", n = r, advice = self:CornerAdvice(V), card = red and rc[1] or { rc[1][2], rc[1][1] },
					unofficial = red and { uP, uO } or { uO, uP },
					stats = { landed = V.totals.landed, thrown = V.totals.thrown, oppLanded = X.totals.landed, oppThrown = X.totals.thrown,
						combos = V.comboStats.landed, oppCombos = X.comboStats.landed, bestCombo = V.comboStats.best, bestComboName = V.comboStats.bestName },
					seconds = Config.RestSeconds, cond = self:ConditionReport(V),
				}
			end)
			self:Wait(self.spar and 4 or (self.tutorial and Tutorial and not self.debut and Tutorial.REST_SECONDS) or Config.RestSeconds)
		end
	end
	if self.aborted then
		return nil
	end

	local res
	if self.finished then
		res = self.sparExit or { outcome = self.winner == P and "win" or "loss", method = self.method, reason = self.reason, round = self.endRound or self.round }
	else
		-- [Judging] the three judges' totals decide it (unanimous / split / majority / draw; Career's rule as the fallback)
		res = Judging and Judging.Decide(self.cards) or Career.DecideCards(self.cards)
		res.round = self.rounds
		res.reason = self.spar and "Session complete" or ((self.tutorial and not self.debut) and "Tutorial complete" or "Decision")
	end
	-- the winner celebrates, the loser slumps (the Animator reads Guard / Expr)
	for _, F in ipairs({ P, O }) do
		local won = (F == P and res.outcome == "win") or (F == O and res.outcome == "loss")
		if F.state ~= "down" then
			F.guardOverride = res.outcome == "draw" and "rest" or (won and "win" or "lose")
		end
		F.exprOverride = won and "happy" or (F.state == "down" and (F.downSeverity == "out" and "ko" or "dazed") or "fatigue")
		self:UpdateGuard(F)
		self:SyncAttrs(F)
	end
	-- the red corner's result is the one Run returns; a PvP bout also keeps the blue corner's (self.results)
	self.results = { [P] = self:ResultFor(P, res), [O] = self:ResultFor(O, res) }
	return self.results[P]
end

-- the result from fighter F's side. base is the red corner's { outcome, method, reason, round }.
function Fight:ResultFor(F, base)
	local O = self:Other(F)
	local red = F == self.P
	local res = { method = base.method, reason = base.reason, round = base.round, partial = base.partial }
	local FLIP_OUT = { win = "loss", loss = "win" }
	res.outcome = red and base.outcome or (FLIP_OUT[base.outcome] or base.outcome)
	if red then
		res.cards = self.cards
	else
		res.cards = {}
		for j, c in ipairs(self.cards) do
			res.cards[j] = { c[2], c[1] }
		end
	end
	res.kdFor = O.kdTotal
	res.kdAgainst = F.kdTotal
	res.landed, res.thrown = F.totals.landed, F.totals.thrown
	res.oppLanded, res.oppThrown = O.totals.landed, O.totals.thrown
	res.punches = F.punchesUsed
	res.damageDealt, res.damageTaken = F.damageDealt, F.damageTaken
	res.weighIn = F.data.mods and F.data.mods.weighIn
	-- a cut counts when it was opened (or ripped open further) tonight, not when an old one merely shows
	local cutNow = math.max(F.dmg.cut, F.dmg.cut2)
	res.cutTaken = cutNow > 0.3 and cutNow > (F.cutAtStart or 0) + 0.1
	-- persistence hand-off (CONTRACTS section 8): Career / Training carry these into the profile
	res.face = tonightDamage(F)
	res.oppFace = tonightDamage(O)
	res.concPeak = math.floor(F.concPeak * 100) / 100
	res.noseBroken = F.dmg.nose == true and not F.noseAtStart
	-- the profile residual already carries an old break (AddFaceDamage never clears it): only a fresh one is news
	res.face.nose = res.noseBroken
	if red then
		res.knockdowns = self.knockdowns
	else
		res.knockdowns = {}
		for i, k in ipairs(self.knockdowns) do
			local c = table.clone(k)
			c.who = FLIP[k.who] or k.who
			res.knockdowns[i] = c
		end
	end
	res.bodyTaken = math.floor(100 - F.bodyCap)
	res.headTaken = math.floor(F.headTaken * 10) / 10 -- Training.AddTrauma prefers this over damageTaken
	-- the combinations (Combos.Record: chains of 2+, named combos landed, the best chain and the best named one)
	-- and the head movement (dodges tried, punches they made miss)
	self:CloseChain(F)
	self:CloseChain(O)
	local cs = F.comboStats
	res.combos = { chains = cs.chains, landed = cs.landed, best = cs.best, bestName = cs.bestName, named = table.clone(cs.named) }
	res.oppCombos = { landed = O.comboStats.landed, best = O.comboStats.best, bestName = O.comboStats.bestName }
	res.dodges, res.evades = F.dodges, F.evades
	-- the deeper fight: his fighting type tonight (Traits.FightingType), the other man's ring traits he found out,
	-- feints that drew a bite, second winds
	res.fightType = (self:FightingType(F))
	local found = {}
	for _, t in ipairs(O.traits or {}) do
		if O.traitSeen[t.id] then
			table.insert(found, t.id)
		end
	end
	res.oppTraits = found
	res.feints, res.feintBites, res.secondWinds = F.feints, F.feintBites, F.winds
	-- [Judging] the judges' report (per-round cards and reasons, the punch stats by type) and the decision as read
	res.judging = Judging and Judging.Report(self.judgeRounds or {}, self.cards, self.judgeTotals or {}, not red) or nil
	res.scores, res.decisionText = base.scores, base.text
	return res
end

local FIGHT_ATTRS = { "Guard", "Act", "Chain", "HeadHP", "BodyHP", "Stam", "Daze", "Conc", "Strain", "DownPose", "DownDir", "DownDist", "KOKind", "Count", "Style", "Expr" }

function Fight:Cleanup()
	for _, F in ipairs({ self.P, self.O }) do
		leaveBoxers(F)
		if F.model then
			CollectionService:RemoveTag(F.model, "Fighter")
			for _, k in ipairs(FIGHT_ATTRS) do
				F.model:SetAttribute(k, nil)
			end
		end
		if F.align then
			F.align:Destroy()
		end
		if F.alignAtt then
			F.alignAtt:Destroy()
		end
	end
	for _, P in ipairs({ self.P, self.O }) do
		if P.isPlayer then
			self:RestorePlayer(P)
		end
	end
	if self.ref and self.ref.noclip then
		self.ref.noclip:Disconnect()
		self.ref.noclip = nil
	end
	if self.arena then
		self.arena:Destroy()
	end
end

-- a player's own character after the fight: movement, jump, the neck, robe / headgear / fight damage off
function Fight:RestorePlayer(P)
	if P.hum and P.neckOff then
		-- FightClient re-enables the rig 2.2 s after "final"; Cleanup runs 3 s after it, so wait a little longer
		-- before the neck is required again (a slow client would otherwise die on the spot)
		-- [Studio] RequiresNeck stays off for good: a missing Neck (a head swap under the Avatar Joint Upgrade)
		-- would otherwise kill the Humanoid and BreakJointsOnDeath strip the gear (Builder.hardenHumanoid)
		local hum = P.hum
		task.delay(4, function()
			if hum.Parent then
				hum.RequiresNeck = false
			end
		end)
	end
	if P.hum then
		P.hum.AutoRotate = true
		P.hum.WalkSpeed = Config.TownWalkSpeed
		P.hum.JumpHeight = 7.2
	end
	if P.model and P.model.Parent then
		-- put the hair back right away (Cosmetics would also reconcile it on the next applyLook)
		pcall(Builder.SetRobe, P.model, P.data.app, false)
		-- (the sparring corner's colour off: a boxer's own headgear, Config.AlwaysHeadgear, stays on in his colour)
		pcall(Builder.SetHeadgear, P.model, Color3.new(), false)
		local look = P.model:FindFirstChild("BoxerLook")
		if look then
			-- the next applyLook redraws the healing residual through opts.damage (Training.FaceView)
			local own = Builder.HasOwnHeadgear(P.model)
			for _, n in ipairs(own and { "Damage", "Robe" } or { "Damage", "Robe", "Headgear" }) do
				local f = look:FindFirstChild(n)
				if f then
					f:Destroy()
				end
			end
		end
		pcall(Builder.SetSweat, P.model, P.data.app, 0)
	end
end

------------------------------------------------------------------------
-- The celebration cutscene (FightEngine.Run opts.ceremony = Tourney.CeremonyFor's spec: belt key, kicker, title,
-- event, name), after the final bell of a won tournament final or a new title. The server owns it: it stands the
-- winner in the centre of the ring, brings the referee to his side and an official in with the belt, sets the poses
-- (Pose on a "Trainee": BoxerClient.AnimCeremony's poses, played by the Animator) on the shared beats
-- (Shared.Tournaments.Ceremony), and tells the winner's client once (t = "ceremony"). The client
-- (BoxerClient.Ceremony) runs the camera, confetti, pyro, spotlights, the banner and the belt's visuals, and may
-- cut it short (t = "ceremonySkip"); "ceremonyEnd" closes it either way. Nothing is awarded here: Career does that.
------------------------------------------------------------------------
local function setPose(model, pose)
	if model and model.Parent then
		model:SetAttribute("Pose", pose)
	end
end

-- a scene's body frame for any rig in the ring (HitGeometry.Frame off its parts; the unit frame without them):
-- the referee and the official have no fighter table for Fight:Geo
function Fight:SceneFrame(model)
	if not (HitGeometry and model) then
		return nil
	end
	local root = model:FindFirstChild("HumanoidRootPart")
	local hum = model:FindFirstChildOfClass("Humanoid")
	local soleY = root and (root.Position.Y - standHeight(hum, root)) or nil
	local ok, fr = pcall(HitGeometry.Frame, model, soleY, HitGeometry.Unit())
	return ok and fr or HitGeometry.Unit()
end

-- the celebration's spacing (studs of air between the bodies; the rest comes from the frames: shoulderHalf /
-- torsoHalfD off the live rigs, so a Heavyweight stands his own width from the referee and the official)
local CER_SIDE_GAP, CER_FRONT_GAP = 0.9, 1.15

function Fight:Ceremony(spec)
	local P, O = self.P, self.O
	local B = Tournaments and Tournaments.Ceremony
	if not (B and P.model and P.model.Parent and P.root and self.anchors.RingCenter) then
		return
	end
	local center = self.anchors.RingCenter.Position
	local toRed = flat(self.anchors.RedCorner.Position - center)
	toRed = toRed.Magnitude > 0.1 and toRed.Unit or Vector3.new(0, 0, -1)
	-- he faces a ring side (between his corner and the next post), the hard camera's side
	local face = CFrame.Angles(0, math.rad(45), 0):VectorToWorldSpace(toRed)
	local right = face:Cross(Vector3.yAxis)
	local held = {} -- roots anchored for the scene (physics and the Humanoids cannot slide them), freed at its end
	local function hold(root)
		if root and not root.Anchored then
			pcall(function()
				root.Anchored = true
			end)
			table.insert(held, root)
		end
	end
	self:Place(P, center, center + face * 10)
	hold(P.root)
	if O.model and O.model.Parent and O.root then
		-- the loser walks to his corner (a glide at a walking pace: the Animator gives him steps), never set down
		-- inside the winner
		if O.state ~= "down" then
			self:Glide(O, self:KeepOut(O, self.anchors.BlueCorner.Position, self:MinSep()), 6)
		end
	end
	if P.hum then
		P.hum.WalkSpeed = 0
		P.hum.AutoRotate = false
	end
	-- the winner's poses come from the Animator's Trainee path (a Fighter plays guards only)
	CollectionService:RemoveTag(P.model, "Fighter")
	CollectionService:AddTag(P.model, "Trainee")
	setPose(P.model, "cerProud")
	local function stand(model, pos, look)
		local root = model and model:FindFirstChild("HumanoidRootPart")
		local hum = model and model:FindFirstChildOfClass("Humanoid")
		if root then
			local y = center.Y + standHeight(hum, root)
			model:PivotTo(CFrame.lookAt(Vector3.new(pos.X, y, pos.Z), Vector3.new(look.X, y, look.Z)))
			root.AssemblyLinearVelocity = Vector3.zero
		end
	end
	local G = self:Geo(P) or (HitGeometry and HitGeometry.Unit()) or { shoulderHalf = 0.95, torsoHalfD = 0.49 }
	-- the referee at his right shoulder, facing the same way (his left hand takes the winner's right): a shoulder
	-- width each plus the air between
	local refModel = self.ref and self.ref.model
	local refG = self:SceneFrame(refModel) or G
	local refSide = G.shoulderHalf + refG.shoulderHalf + CER_SIDE_GAP
	if refModel and refModel.Parent then
		local at = center + right * refSide
		stand(refModel, at, at + face * 5)
		hold(self.ref.root)
	end
	-- the official with the belt, waiting by the ropes in front of him
	local official
	pcall(function()
		local app, build, gear, lopts = Officials.Look(self.rng:NextInteger(1, 2 ^ 30), "referee", { venue = self.venue, kind = "World Title" })
		official = Builder.CreateNPC(app, build, gear, "Official", lopts)
	end)
	if official then
		official.Name = "Official"
		for _, d in ipairs(official:GetDescendants()) do
			if d:IsA("BasePart") then
				d.CanCollide = false
				d.CanTouch = false
			end
		end
		official.Parent = self.arena
		Builder.OnPlaced(official)
		stand(official, center + face * 6.5 - right * 1.2, center)
		if HitGeometry then
			-- (the official's own frame once he stands: Officials' builds differ)
			local offG = self:SceneFrame(official)
			if offG then
				G = { shoulderHalf = G.shoulderHalf, torsoHalfD = G.torsoHalfD, front = G.torsoHalfD + offG.torsoHalfD + CER_FRONT_GAP }
			end
		end
		local oroot = official:FindFirstChild("HumanoidRootPart")
		if oroot then
			pcall(function()
				oroot:SetNetworkOwner(nil)
			end)
		end
		CollectionService:AddTag(official, "Trainee")
	end
	local ohum = official and official:FindFirstChildOfClass("Humanoid")
	if ohum then
		ohum.WalkSpeed = 7
	end
	self.ceremonySkip = false
	self:SendTo(P, { t = "ceremony", spec = spec, winner = P.model, ref = refModel, official = official, center = center, face = face, beats = B })
	-- the beats (the client's camera runs on the same clock from the message's arrival)
	local plan = {
		{ B.raise, function()
			setPose(refModel, "cerRaise")
			setPose(P.model, "cerHandUp")
		end },
		{ B.walkIn, function()
			setPose(refModel, "cerClap")
			setPose(P.model, "cerProud")
			-- (the official comes in to a torso's depth each plus the air for the belt between his hands; the
			-- referee steps back and out of his way, by his own and the winner's shoulders)
			if ohum then
				ohum:MoveTo(center + face * (G.front or 1.75))
			end
			if refModel and self.ref.root then
				pcall(function()
					self.ref.root.Anchored = false
				end)
				if self.ref.hum then
					self.ref.hum:MoveTo(center + right * (refSide + 1.0) - face * 0.9)
				end
			end
		end },
		{ B.strap, function()
			if official then
				stand(official, center + face * (G.front or 1.75), center)
			end
			setPose(official, "cerStrap")
			setPose(P.model, "cerStrapped")
		end },
		{ B.strap + 1.5, function()
			setPose(official, "cerClap")
			if ohum then
				ohum:MoveTo(center - right * 2.7 - face * 1.1)
			end
		end },
		{ B.lift, function()
			setPose(P.model, "cerLift")
		end },
		{ B.wide, function()
			setPose(P.model, "cerCelebrate")
		end },
	}
	local t0 = self:Now()
	local nextBeat = 1
	while self:Now() - t0 < B.dur and not self.ceremonySkip and not self.aborted and P.model.Parent and (not self.player or self.player.Parent) do
		local t = self:Now() - t0
		while plan[nextBeat] and t >= plan[nextBeat][1] do
			pcall(plan[nextBeat][2])
			nextBeat += 1
		end
		task.wait(0.05)
	end
	self:SendTo(P, { t = "ceremonyEnd", skipped = self.ceremonySkip == true })
	-- hand the rigs back (Cleanup takes the Fighter attributes off and restores the player)
	setPose(P.model, nil)
	setPose(refModel, nil)
	CollectionService:RemoveTag(P.model, "Trainee")
	for _, root in ipairs(held) do
		pcall(function()
			root.Anchored = false
		end)
	end
	if official then
		official:Destroy()
	end
	task.wait(0.2)
end

------------------------------------------------------------------------
-- Entry point (yields until the fight ends). Returns result or nil if aborted.
-- opts: { spar = "Light"|"Medium"|"Hard"|"PvP", oppPlayer = Player (PvP: the blue corner is that player's
-- own character, driven by his inputs), rounds = n (PvP ranked: 3 or 6) }
-- Returns the red corner's result (nil if aborted) and the results table { [fighter] = res } whose
-- fighters carry .player, so a PvP caller can pick each side's result.
------------------------------------------------------------------------
local fightCounter = 0
function FightEngine.Run(player, remote, offer, pData, oData, arena, opts)
	opts = opts or {}
	fightCounter += 1
	local self = setmetatable({}, Fight)
	self.id = fightCounter
	self.player = player
	self.remote = remote
	self.offer = offer
	self.spar = opts.spar
	local sp = opts.spar and SPAR[opts.spar]
	local oppPlayer = typeof(opts.oppPlayer) == "Instance" and opts.oppPlayer:IsA("Player") and opts.oppPlayer or nil
	self.pvp = oppPlayer ~= nil
	self.rounds = (oppPlayer and tonumber(opts.rounds)) or (sp and sp.rounds) or offer.rounds
	self.roundSeconds = sp and Config.SparRoundSeconds or Config.RoundSeconds
	self.damageScale = sp and sp.damage or 1
	self.allowKD = (not sp) or sp.allowKD
	self.aiWork = sp and sp.work or 1
	self.aiRange = sp and sp.range or 1
	-- the first-time tutorial (opts.tutorial): short rounds on a held clock, guided steps, a forgiving
	-- opponent (FightAI reads aiWork / aiDefense), knockdowns only for the opponent and only at the end
	if opts.tutorial and Tutorial and not oppPlayer and not sp then
		self.tutorial = Tutorial.NewTracker()
		self.rounds = Tutorial.ROUNDS
		self.roundSeconds = Tutorial.ROUND_SECONDS
		self.aiWork = Tutorial.AiWork(self.tutorial)
		self.aiDefense = Tutorial.AI_DEFENSE
	elseif opts.debut and Tutorial and not oppPlayer and not sp then
		-- the guided debut (Tutorial.Debut): a real career bout, its own rounds, the same step card with the steps
		-- this boxer has (his first special move, if any), forgiving only for this night
		local special = nil
		if Moves and type(pData.moves) == "table" then
			for _, id in ipairs(Moves.List) do
				if pData.moves[id] then
					special = id
					break
				end
			end
		end
		self.debut = true
		self.tutorial = Tutorial.NewTracker({ debut = true, special = special, specialName = special and Moves.Data[special].name or nil, rounds = self.rounds })
		self.aiWork = Tutorial.AiWork(self.tutorial)
		self.aiDefense = Tutorial.AiDefense(self.tutorial)
	end
	self.venue = opts.spar and "Gym" or (offer.venue or "Arena")
	self.offerKind = offer.kind -- (a title fight's referee wears white: Officials.Colors)
	self.round = 0
	self.rng = Random.new()
	self.cards = { { 0, 0 }, { 0, 0 }, { 0, 0 } }
	self.roundCards = {}
	self.knockdowns = {}
	self.arena = arena
	self.roundEnd = 0
	self.cutRisk = {}
	local anchors = {}
	for _, p in ipairs(arena:WaitForChild("Anchors"):GetChildren()) do
		anchors[p.Name] = p
	end
	self.anchors = anchors
	self.ringHalf = arena:GetAttribute("RingHalf") or 11

	-- fight-night look for the opponent (CONTRACTS section 4): full detail, taped fight gloves
	local npcOpts = table.clone(oData.lookOpts or {})
	npcOpts.hands, npcOpts.mouthguard = "gloves", true
	npcOpts.name, npcOpts.nick, npcOpts.nat, npcOpts.waistText = oData.name, oData.nick, oData.nat, oData.nick
	npcOpts.detail = "full"
	npcOpts.fightNight = not self.spar -- taped, inspector-signed, compact fight gloves (spars keep bag gloves)
	npcOpts.age = npcOpts.age or oData.age
	npcOpts.damage = type(oData.face) == "table" and oData.face or nil
	local npc
	if oppPlayer then
		-- PvP: the blue corner is the other player's own character (client-owned physics, like the red one)
		npc = oppPlayer.Character
		if not (npc and npc:FindFirstChild("HumanoidRootPart")) then
			arena:Destroy()
			return nil
		end
		local oOpts = table.clone(oData.lookOpts or {})
		oOpts.hands, oOpts.mouthguard, oOpts.fightNight, oOpts.detail = "gloves", true, not self.spar, "full"
		Builder.Cosmetics(npc, oData.app, oData.build, oData.gear, oOpts)
	else
		npc = Builder.CreateNPC(oData.app, oData.build, oData.gear, oData.name, npcOpts)
		if not npc then
			arena:Destroy()
			return nil
		end
		npc.Parent = arena
		Builder.OnPlaced(npc)
		local npcRoot = npc:FindFirstChild("HumanoidRootPart")
		if npcRoot then
			npcRoot:SetNetworkOwner(nil)
		end
	end
	-- (a frame between the opponent's build and the player's re-dress: two heavy builds in one server step stall
	-- the scene's first frames in Studio, where the server shares the client's frame)
	task.wait()
	local char = player.Character
	if not (char and char.Parent and arena.Parent) then
		if arena.Parent then
			arena:Destroy()
		end
		return nil
	end
	-- fight-night look for the player: gloves on, mouthguard in
	local lookOpts = table.clone(pData.lookOpts or {})
	lookOpts.hands = "gloves"
	lookOpts.mouthguard = true
	lookOpts.fightNight = not self.spar
	lookOpts.detail = "full"
	Builder.Cosmetics(char, pData.app, pData.build, pData.gear, lookOpts)
	if self.spar then
		-- the corners' colours over each boxer's own headgear (RestorePlayer gives the player's back)
		Builder.SetHeadgear(char, Color3.fromRGB(30, 60, 160), true)
		Builder.SetHeadgear(npc, Color3.fromRGB(170, 25, 30), true)
	end
	self.P = makeFighter(pData, char, player)
	self.O = makeFighter(oData, npc, oppPlayer)
	self.pair = { self.P, self.O } -- the per-frame loops walk this (no new table every frame)
	-- the distances fit the bodies in the ring: athletic rigs carry deeper chests and bigger gloves than the
	-- classic one the spacing was fitted on, and a taller man needs more room to fall
	local kP, hP = rigSize(char, self.P.hum, self.P.root)
	local kO, hO = rigSize(npc, self.O.hum, self.O.root)
	self.rigK = (kP + kO) / 2
	self.sp = FightMotion and FightMotion.ScaledSpacing and FightMotion.ScaledSpacing(self.rigK) or SPACING
	for _, X in ipairs({ { self.P, hP }, { self.O, hO } }) do
		X[1].bodyK = FightMotion and FightMotion.BodyScale and FightMotion.BodyScale(X[2]) or 1
	end
	-- the hit detection's frames off the rigs now, in their rest pose (Fight:Geo; the start message hands the
	-- client the same numbers)
	self:Geo(self.P)
	self:Geo(self.O)
	if pData.injuryCut then
		self.cutRisk[self.P] = 1.8
	end
	if oppPlayer and oData.injuryCut then
		self.cutRisk[self.O] = 1.8
	end
	-- the residual damage is drawn from the first punch on (Cosmetics drew opts.damage, keep it in step)
	for _, F in ipairs({ self.P, self.O }) do
		if Config.FaceDamageScore(F.dmg) > 0 or F.dmg.ribsL > 0 or F.dmg.ribsR > 0 then
			self:RefreshDamage(F, true)
		end
	end
	if not oppPlayer then
		self.O.ai = FightAI.new(self.O, self.P, self)
	end
	FightEngine.Active[player] = self
	if oppPlayer then
		FightEngine.Active[oppPlayer] = self
	end

	local ok, res = pcall(function()
		return self:Run()
	end)
	if not ok then
		warn("[Boxer] Fight error:", res)
		res = nil
	end
	if res then
		self:SendEach(function(V)
			return { t = "final", result = self.results and self.results[V] or res, oppName = self:Other(V).data.name, spar = self.spar, pvp = self.pvp }
		end)
		-- the 3 s before the scene: the feet stopped where they are and the bodies still kept apart (Settle)
		self:Settle(3)
		-- [Judging] the post-fight scene (PostFight: both men to the centre, the referee between them, the announcer
		-- reads the cards, the winner's hand goes up; the crowd's "FightResult"); not for sparring or the practice bout
		if PostFight and not self.aborted and not self.spar and not (self.tutorial and not self.debut) then
			local okP, errP = pcall(PostFight.Run, self, res, opts)
			if not okP then
				warn("[Boxer] postfight:", errP)
			end
		end
		-- the celebration cutscene (a won tournament final / a new title: Career's Tourney.CeremonyFor spec)
		if type(opts.ceremony) == "table" and res.outcome == "win" and not self.aborted and not self.spar and not self.pvp and not self.tutorial then
			local okC, errC = pcall(self.Ceremony, self, opts.ceremony)
			if not okC then
				warn("[Boxer] ceremony:", errC)
			end
		end
	end
	self:Cleanup()
	if FightEngine.Active[player] == self then
		FightEngine.Active[player] = nil
	end
	if oppPlayer and FightEngine.Active[oppPlayer] == self then
		FightEngine.Active[oppPlayer] = nil
	end
	return res, self.results
end

-- the fighter a player controls in his fight (P, or O in a PvP bout)
function Fight:FighterOf(player)
	if self.P and self.P.player == player then
		return self.P
	elseif self.O and self.O.player == player then
		return self.O
	end
	return nil
end

-- player input from the client
function FightEngine.Input(player, msg)
	local fight = FightEngine.Active[player]
	if not fight or type(msg) ~= "table" then
		return
	end
	local F = fight:FighterOf(player)
	if not F or F.gone then
		return
	end
	-- flood guard: a client may send at most 30 fight messages a second (the mash has its own 15/s cap)
	local now = fight:Now()
	if now - (F.inWindow or 0) >= 1 then
		F.inWindow = now
		F.inCount = 0
	end
	F.inCount = (F.inCount or 0) + 1
	if F.inCount > 30 then
		return
	end
	local t = msg.t
	if t == "device" then
		fight:SetDevice(F, msg.pad == true)
		return
	elseif t == "ceremonySkip" then
		-- (the celebration cutscene's SKIP: the server ends its timeline)
		fight.ceremonySkip = true
		return
	elseif t == "entranceSkip" then
		-- [Entrance] the ring walk's SKIP (RingWalk: vs the AI at once, in PvP once both asked)
		if RingWalk then
			RingWalk.Skip(fight, F)
		end
		return
	elseif t == "pause" then
		-- (not a fight input: the Moves & Controls window opened / closed)
		fight:MenuPause(F, msg.on == true)
		return
	elseif t == "leaveSpar" then
		-- the spar HUD's Leave Sparring (a spar only; a PvP spar or a fight ignores it)
		fight:LeaveSpar(F)
		return
	end
	-- which device the input came from (the client tags gamepad inputs): the aim assist reads it; a pad
	-- tag only counts while the server holds the fighter on the pad (Fight:SetDevice)
	if t ~= "mash" then
		if msg.pad == true and F.device == "pad" then
			F.padAt = now
		else
			F.kbdAt = now
		end
	end
	if t == "punch" and Config.Punches[msg.p] then
		fight:Punch(F, msg.p, msg.body == true, msg.counter == true, nil, tonumber(msg.at))
	elseif t == "special" then
		fight:Special(F, msg.id)
	elseif t == "block" then
		fight:SetBlock(F, msg.on == true)
	elseif t == "slip" then
		fight:Slip(F, msg.dir == -1 and -1 or 1)
	elseif t == "dodge" and (msg.kind == "weave" or msg.kind == "duck" or msg.kind == "pull" or msg.kind == "sidestep") then
		fight:Dodge(F, msg.kind, msg.dir == -1 and -1 or 1)
	elseif t == "roll" then
		fight:Roll(F, msg.quick == true)
	elseif t == "parry" then
		fight:Parry(F)
	elseif t == "pivot" then
		fight:Pivot(F, msg.dir == -1 and -1 or 1)
	elseif t == "clinch" then
		fight:Clinch(F)
	elseif t == "feint" then
		fight:Feint(F)
	elseif t == "sprint" then
		fight:SetSprint(F, msg.on == true)
	elseif t == "mash" then
		if F.state == "down" then
			local now = fight:Now()
			-- at most 15 presses a second count (auto-clickers gain nothing)
			if now - (F.mashWindow or 0) >= 1 then
				F.mashWindow = now
				F.mashCount = 0
			end
			F.mashCount = (F.mashCount or 0) + 1
			if F.mashCount <= 15 then
				-- a "good" press = the client's sweeping marker was in the green zone; the marker passes
				-- the zone at most about three times a second, so faster "good" claims count as plain
				local worth = 1
				if msg.good == true and now - (F.goodAt or 0) >= GOOD_GAP then
					F.goodAt = now
					worth = 3
				end
				F.mash += worth
			end
		end
	end
end

function FightEngine.Abort(player)
	local fight = FightEngine.Active[player]
	if fight then
		fight.aborted = true
		fight.finished = true
	end
end

-- PvP: a player walks out of a bout that is under way (left the game, reset, died). After the first bell
-- that is a loss ("Forfeit") and the fight ends with a result for the other corner; before it (or in a
-- spar, when ranked = false) the bout is simply called off. Returns "forfeit" | "aborted" | nil.
function FightEngine.Forfeit(player, ranked)
	local fight = FightEngine.Active[player]
	if not fight then
		return nil
	end
	local F = fight:FighterOf(player)
	if not F then
		return nil
	end
	F.gone = true
	if ranked and not fight.aborted and (fight.round or 0) >= 1 then
		if not fight.finished then
			fight:End(fight:Other(F), "Forfeit", (F.data.name or "The opponent") .. " left the ring")
		end
		return "forfeit"
	end
	fight.aborted = true
	fight.finished = true
	return "aborted"
end

-- (for tools/sim/test_combos: the fight's methods and the fighter constructor, driven on stub models)
FightEngine._Fight = Fight
FightEngine._makeFighter = makeFighter

return FightEngine
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="99">
        <Properties>
          <string name="Name">GymDecor</string>
          <string name="Source"><![CDATA[-- GymDecor: everything that turns the training complex from a box into a real boxing gym.
-- Interior structure (steel trusses, columns, ducts, pendant lamps, windows trim, wainscot),
-- zone decor (flags, fight posters, glove racks, round timers, kettlebells, tire & sledgehammer,
-- battle ropes, decorative cardio machines, towel shelves, barber/locker/nutrition details,
-- lobby reception, lounge, vending, trophies, belt display, hall of fame), the pool hall,
-- the building's exterior (facade sign, awning, doors, pilasters, cornice, wall lamps,
-- sidewalk, planters, rooftop units) and the gym's lighting rig.
-- Animated pieces (fans, round timers, TV tickers, neon flicker, barber pole) are tagged and
-- driven client-side by Ambience. Everything is anchored; small props never collide.
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Signage = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Signage"))
local Typography = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Typography"))

local GymDecor = {}

local V3 = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local RAD = math.rad
local M = Enum.Material

------------------------------------------------------------------------
-- palette
------------------------------------------------------------------------
local C = {
	steel = Color3.fromRGB(58, 60, 66),
	steelLight = Color3.fromRGB(150, 153, 160),
	galv = Color3.fromRGB(172, 175, 182),
	black = Color3.fromRGB(24, 24, 28),
	white = Color3.fromRGB(236, 236, 240),
	wood = Color3.fromRGB(140, 100, 65),
	woodDark = Color3.fromRGB(72, 50, 36),
	red = Color3.fromRGB(196, 30, 36),
	blue = Color3.fromRGB(30, 60, 170),
	gold = Color3.fromRGB(255, 196, 40),
	goldDeep = Color3.fromRGB(212, 160, 40),
	green = Color3.fromRGB(40, 140, 70),
	concrete = Color3.fromRGB(168, 166, 160),
	leather = Color3.fromRGB(48, 36, 30),
	wainscot = Color3.fromRGB(42, 44, 50),
	brick = Color3.fromRGB(122, 66, 52),
	brickDark = Color3.fromRGB(96, 52, 42),
	terracotta = Color3.fromRGB(176, 96, 62),
	leaf = Color3.fromRGB(56, 120, 60),
	rubber = Color3.fromRGB(32, 32, 35),
}

------------------------------------------------------------------------
-- helpers
------------------------------------------------------------------------
-- decor whose shadow nobody can see: under a stud on its longest side (bottles, bolts, buttons, bulbs), or a thin
-- slab lying on the ground (floor tape, finish lines, seams: its shadow falls under itself). Each sun shadow
-- caster is drawn again into the shadow map every frame it is in view (opts.shadow = true keeps one)
local function shadowless(size, cf)
	if math.max(size.X, size.Y, size.Z) < 1 then
		return true
	end
	return size.Y <= 0.12 and size.Y <= size.X and size.Y <= size.Z and cf.Y < 1.5 and math.abs(cf.UpVector.Y) > 0.98
end

local function part(parent, name, size, cf, color, material, opts)
	opts = opts or {}
	local p = Instance.new(opts.class or "Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or M.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	local collide = opts.collide == true
	p.CanCollide = collide
	p.CanQuery = collide
	p.CanTouch = false
	if opts.shape then
		p.Shape = opts.shape
	end
	if opts.transparency then
		p.Transparency = opts.transparency
	end
	if opts.reflect then
		p.Reflectance = opts.reflect
	end
	if opts.shadow == false or (opts.shadow ~= true and not collide and shadowless(size, cf)) then
		p.CastShadow = false
	end
	p.Parent = parent
	return p
end

-- cylinder along local X
local function cyl(parent, name, length, diameter, cf, color, material, opts)
	opts = opts or {}
	opts.shape = Enum.PartType.Cylinder
	return part(parent, name, V3(length, diameter, diameter), cf, color, material, opts)
end

-- vertical cylinder standing on a base CFrame
local function vcyl(parent, name, height, diameter, baseCF, color, material, opts)
	return cyl(parent, name, height, diameter, baseCF * CF(0, height / 2, 0) * ANG(0, 0, RAD(90)), color, material, opts)
end

local function ball(parent, name, d, cf, color, material, opts)
	opts = opts or {}
	opts.shape = Enum.PartType.Ball
	return part(parent, name, V3(d, d, d), cf, color, material, opts)
end

-- squashed sphere (gloves, fruit, foliage)
local function blob(parent, name, size, cf, color, material, opts)
	local p = part(parent, name, size, cf, color, material, opts)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	return p
end

-- a cylinder-ish bar between two points
local function rod(parent, name, a, b, d, color, material, opts)
	local len = (b - a).Magnitude
	return part(parent, name, V3(d, d, len), CFrame.lookAt((a + b) / 2, b), color, material, opts)
end

local function folder(parent, name)
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function model(parent, name)
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end

local function gui(p, face, ppu, light)
	local sg = Instance.new("SurfaceGui")
	sg.Face = face
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = ppu or 40
	sg.LightInfluence = light or 0
	sg.MaxDistance = 260
	sg.Parent = p
	return sg
end

local function label(parent, text, props)
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = UDim2.fromScale(1, 1)
	Typography.Apply(t, "sign")
	t.TextScaled = true
	t.TextWrapped = true
	t.TextColor3 = Color3.new(1, 1, 1)
	t.Text = text
	for k, v in pairs(props or {}) do
		if k == "Face" then
			Typography.Apply(t, v)
		else
			t[k] = v
		end
	end
	t.Parent = parent
	return t
end

local function frame(parent, props)
	local f = Instance.new("Frame")
	f.BorderSizePixel = 0
	for k, v in pairs(props or {}) do
		f[k] = v
	end
	f.Parent = parent
	return f
end

-- simple text sign on one face (the density is capped by the face's height: the engine draws text at
-- 100 px at most, so a tall face at 40 px per stud would keep its words small)
local function sign(p, face, text, fg, bg, ppu, light, font)
	local _, fh = Signage.FaceDims(p.Size, face)
	local sg = gui(p, face, math.min(ppu or 40, Signage.PPS(fh, 0.86)), light or 0)
	if bg then
		frame(sg, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = bg })
	end
	label(sg, text, { TextColor3 = fg or Color3.new(1, 1, 1), Face = font or "sign", Size = UDim2.new(0.94, 0, 0.86, 0), Position = UDim2.fromScale(0.03, 0.07) })
	return sg
end

local function spot(p, face, color, range, brightness, angle, shadows)
	local l = Instance.new("SpotLight")
	l.Face = face or Enum.NormalId.Bottom
	l.Color = color
	l.Range = range
	l.Brightness = brightness
	l.Angle = angle or 90
	l.Shadows = shadows == true
	l.Parent = p
	return l
end

local function point(p, color, range, brightness)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness
	l.Shadows = false
	l.Parent = p
	return l
end

-- an invisible emitter part (lights live in their own part so fixtures never shadow them)
local function emitter(parent, cf)
	return part(parent, "LightSource", V3(0.2, 0.2, 0.2), cf, Color3.new(1, 1, 1), M.SmoothPlastic, { transparency = 1, shadow = false })
end

local function tag(inst, name)
	CollectionService:AddTag(inst, name)
	return inst
end

------------------------------------------------------------------------
-- Wall-mounted items. Interior faces of the building shell and the zone dividers:
-- along = coordinate along the wall, depth = how far the item sticks out.
------------------------------------------------------------------------
local WALLS = {
	N = { axis = "X", plane = -79, sign = 1, out = Enum.NormalId.Back },
	S = { axis = "X", plane = 79, sign = -1, out = Enum.NormalId.Front },
	W = { axis = "Z", plane = -109, sign = 1, out = Enum.NormalId.Right },
	E = { axis = "Z", plane = 109, sign = -1, out = Enum.NormalId.Left },
	DWb = { axis = "Z", plane = -49, sign = 1, out = Enum.NormalId.Right }, -- x=-50 divider, boxing side
	DWw = { axis = "Z", plane = -51, sign = -1, out = Enum.NormalId.Left }, -- x=-50 divider, weight room side
	DEb = { axis = "Z", plane = 49, sign = -1, out = Enum.NormalId.Left }, -- x=+50 divider, boxing side
	DEc = { axis = "Z", plane = 51, sign = 1, out = Enum.NormalId.Right }, -- x=+50 divider, cardio side
	DZs = { axis = "X", plane = 21, sign = 1, out = Enum.NormalId.Back }, -- z=20 dividers, south face
	DZn = { axis = "X", plane = 19, sign = -1, out = Enum.NormalId.Front }, -- z=20 dividers, north face
	XS = { axis = "X", plane = 81, sign = 1, out = Enum.NormalId.Back }, -- exterior south facade
	XN = { axis = "X", plane = -81, sign = -1, out = Enum.NormalId.Front },
	XW = { axis = "Z", plane = -111, sign = -1, out = Enum.NormalId.Left },
	XE = { axis = "Z", plane = 111, sign = 1, out = Enum.NormalId.Right },
}

local function onWall(parent, name, wallId, along, y, width, height, depth, color, material, opts, gap)
	local w = WALLS[wallId]
	local off = w.plane + w.sign * ((gap or 0) + depth / 2)
	local size, pos
	if w.axis == "X" then
		size, pos = V3(width, height, depth), V3(along, y, off)
	else
		size, pos = V3(depth, height, width), V3(off, y, along)
	end
	return part(parent, name, size, CF(pos), color, material, opts), w.out
end

-- the outward normal of a wall as a vector, and a CFrame on the wall that looks out of it
local function wallNormal(wallId)
	local w = WALLS[wallId]
	return w.axis == "X" and V3(0, 0, w.sign) or V3(w.sign, 0, 0)
end

local function wallPoint(wallId, along, y, out)
	local w = WALLS[wallId]
	local off = w.plane + w.sign * (out or 0)
	return w.axis == "X" and V3(along, y, off) or V3(off, y, along)
end

------------------------------------------------------------------------
-- Reusable pieces
------------------------------------------------------------------------
-- fight poster: a SurfaceGui with a header band, headline, fighters and a footer
local POSTERS = {
	{ bg = Color3.fromRGB(18, 18, 22), accent = C.red, top = "FRIDAY NIGHT FIGHTS", title = "CARTER\nvs\nSANTOS", sub = "10 ROUNDS - WELTERWEIGHT", foot = "LIVE AT THE WCB ARENA" },
	{ bg = Color3.fromRGB(240, 196, 40), accent = Color3.fromRGB(20, 20, 24), top = "GOLDEN GLOVES", title = "REGIONAL\nTOURNAMENT", sub = "AMATEUR SHOWCASE", foot = "SATURDAY 7PM - DOORS 6PM", dark = true },
	{ bg = Color3.fromRGB(14, 24, 52), accent = C.gold, top = "THE RECKONING", title = "VEGA\nvs\nKOVAC", sub = "12 ROUNDS - WORLD TITLE", foot = "PAY-PER-VIEW" },
	{ bg = Color3.fromRGB(120, 16, 20), accent = C.white, top = "CHAMPIONSHIP NIGHT", title = "HEAVYWEIGHT\nUNIFICATION", sub = "4 BELTS - 1 KING", foot = "SOLD OUT" },
	{ bg = Color3.fromRGB(28, 28, 32), accent = Color3.fromRGB(60, 170, 255), top = "WCB PRESENTS", title = "BLOOD &\nGLORY", sub = "OKAFOR vs MERCER", foot = "LIVE ON WCB SPORTS" },
	{ bg = Color3.fromRGB(235, 235, 235), accent = C.red, top = "CITY CHAMPIONSHIPS", title = "RUMBLE\nON THE\nWATERFRONT", sub = "8 BOUTS - ALL WEIGHTS", foot = "TICKETS AT THE FRONT DESK", dark = true },
}

local function posterGui(p, face, d)
	local sg = gui(p, face, 40, 0.5)
	local fg = d.dark and Color3.fromRGB(20, 20, 24) or Color3.new(1, 1, 1)
	frame(sg, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = d.bg })
	frame(sg, { Size = UDim2.new(1, 0, 0.15, 0), BackgroundColor3 = d.accent })
	frame(sg, { Size = UDim2.new(1, 0, 0.02, 0), Position = UDim2.fromScale(0, 0.8), BackgroundColor3 = d.accent })
	label(sg, d.top, { TextColor3 = d.dark and C.gold or d.bg, Size = UDim2.new(0.92, 0, 0.11, 0), Position = UDim2.fromScale(0.04, 0.02) })
	label(sg, d.title, { TextColor3 = fg, Size = UDim2.new(0.9, 0, 0.44, 0), Position = UDim2.fromScale(0.05, 0.19) })
	label(sg, d.sub, { TextColor3 = d.accent, Face = "signSub", Size = UDim2.new(0.9, 0, 0.09, 0), Position = UDim2.fromScale(0.05, 0.66) })
	label(sg, d.foot, { TextColor3 = fg, Face = "signSub", Size = UDim2.new(0.9, 0, 0.08, 0), Position = UDim2.fromScale(0.05, 0.86) })
	return sg
end

local posterIndex = 0
local function wallPoster(parent, wallId, along, y, w, h)
	posterIndex += 1
	local d = POSTERS[(posterIndex - 1) % #POSTERS + 1]
	local frameP, face = onWall(parent, "PosterFrame", wallId, along, y, w + 0.3, h + 0.3, 0.1, C.black, M.SmoothPlastic)
	local p = onWall(parent, "Poster", wallId, along, y, w, h, 0.12, d.bg, M.SmoothPlastic, nil, 0.04)
	posterGui(p, face, d)
	return frameP
end

-- big painted wall text
local function wallText(parent, wallId, along, y, w, h, text, color, font)
	local p, face = onWall(parent, "WallText", wallId, along, y, w, h, 0.05, Color3.new(), M.SmoothPlastic, { transparency = 1 }, 0.01)
	local sg = gui(p, face, 30, 0.6)
	label(sg, text, { TextColor3 = color or Color3.new(1, 1, 1), Face = font or "sign", TextStrokeTransparency = 0.7 })
	return p
end

-- industrial fan facing direction f (animated by Ambience: hub spins about its local X)
local function fan(parent, center, f, size, color)
	local m = model(parent, "Fan")
	local hubCF = CFrame.lookAt(center, center + f) * ANG(0, RAD(90), 0)
	local r = size / 2
	cyl(m, "Housing", 0.5, size + 0.4, hubCF * CF(-0.45, 0, 0), C.black, M.Metal)
	cyl(m, "HousingRim", 0.7, size + 0.6, hubCF * CF(-0.3, 0, 0), color or C.steelLight, M.Metal, { transparency = 0.0 })
	local hub = cyl(m, "Hub", 0.6, size * 0.18, hubCF, C.steel, M.Metal)
	for i = 0, 2 do
		part(m, "Blade", V3(0.12, r * 0.88, size * 0.2), hubCF * ANG(i * RAD(120), 0, 0) * CF(0.05, r * 0.5, 0) * ANG(RAD(18), 0, 0), C.steelLight, M.Metal)
	end
	for i = 0, 1 do
		part(m, "Guard", V3(0.1, size, 0.12), hubCF * CF(0.45, 0, 0) * ANG(RAD(45 + i * 90), 0, 0), C.steel, M.Metal)
	end
	cyl(m, "GuardRing", 0.12, size * 0.3, hubCF * CF(0.45, 0, 0), C.steel, M.Metal)
	m.PrimaryPart = hub
	m:SetAttribute("Speed", 9)
	tag(m, "SpinFan")
	return m
end

-- potted plant
local function plant(parent, pos, scale, potColor)
	scale = scale or 1
	vcyl(parent, "PlantPot", 1.6 * scale, 1.8 * scale, CF(pos), potColor or C.terracotta, M.Slate, { collide = true })
	vcyl(parent, "PlantSoil", 0.1, 1.6 * scale, CF(pos + V3(0, 1.55 * scale, 0)), Color3.fromRGB(60, 42, 30), M.Ground)
	blob(parent, "PlantLeaves", V3(2.6, 3.0, 2.6) * scale, CF(pos + V3(0, 3.1 * scale, 0)), C.leaf, M.Grass)
	blob(parent, "PlantLeaves", V3(1.8, 2.2, 1.8) * scale, CF(pos + V3(0.6 * scale, 4.2 * scale, 0.3 * scale)), Color3.fromRGB(70, 140, 72), M.Grass)
end

-- simple chair facing direction yaw (0 = facing -Z)
local function chair(parent, pos, yaw, seatColor, frameColor)
	local base = CF(pos) * ANG(0, yaw or 0, 0)
	part(parent, "ChairSeat", V3(1.9, 0.3, 1.9), base * CF(0, 1.75, 0), seatColor or C.leather, M.Leather, { collide = true })
	part(parent, "ChairBack", V3(1.9, 2.0, 0.25), base * CF(0, 2.9, 0.85), seatColor or C.leather, M.Leather)
	for _, x in ipairs({ -0.8, 0.8 }) do
		for _, z in ipairs({ -0.8, 0.8 }) do
			part(parent, "ChairLeg", V3(0.14, 1.6, 0.14), base * CF(x, 0.8, z), frameColor or C.steel, M.Metal)
		end
	end
end

-- bench along local X (yaw rotates it)
local function bench(parent, pos, yaw, length, color)
	local base = CF(pos) * ANG(0, yaw or 0, 0)
	part(parent, "BenchSeat", V3(length, 0.35, 1.8), base * CF(0, 1.7, 0), color or C.wood, M.WoodPlanks, { collide = true })
	for _, x in ipairs({ -length / 2 + 0.6, length / 2 - 0.6 }) do
		part(parent, "BenchLeg", V3(0.3, 1.55, 1.5), base * CF(x, 0.78, 0), C.steel, M.Metal)
	end
end

-- glove pair hanging by its laces (for racks)
local GLOVE_COLORS = { C.red, Color3.fromRGB(25, 25, 28), C.blue, Color3.fromRGB(230, 180, 30), Color3.fromRGB(235, 235, 240), Color3.fromRGB(40, 150, 70), Color3.fromRGB(150, 40, 170), Color3.fromRGB(240, 120, 30) }
local function glovePair(parent, cf, color)
	for _, s in ipairs({ -0.55, 0.55 }) do
		blob(parent, "Glove", V3(0.9, 1.25, 1.0), cf * CF(s, -0.9, 0), color, M.Leather)
		cyl(parent, "GloveCuff", 0.7, 0.7, cf * CF(s, -0.15, 0) * ANG(0, 0, RAD(90)), C.white, M.Fabric)
	end
end

-- championship belt (strap along local X, plate facing local -Z)
local function belt(parent, cf, strapColor, scale)
	scale = scale or 1
	part(parent, "BeltStrap", V3(3.8, 0.9, 0.12) * scale, cf, strapColor, M.Leather)
	part(parent, "BeltPlate", V3(1.5, 1.35, 0.18) * scale, cf * CF(0, 0, -0.06 * scale), C.gold, M.Metal, { reflect = 0.15 })
	cyl(parent, "BeltJewel", 0.08, 0.5 * scale, cf * CF(0, 0.05 * scale, -0.16 * scale) * ANG(0, RAD(90), 0), C.red, M.Glass)
	for _, x in ipairs({ -1.25, 1.25 }) do
		part(parent, "BeltSidePlate", V3(0.6, 0.75, 0.16) * scale, cf * CF(x * scale, 0, -0.05 * scale), C.goldDeep, M.Metal)
	end
end

-- trophy cup standing on a base CFrame
local function trophy(parent, baseCF, h, color)
	color = color or C.gold
	part(parent, "TrophyBase", V3(0.9, 0.45, 0.9) * h, baseCF * CF(0, 0.225 * h, 0), C.black, M.Marble)
	vcyl(parent, "TrophyStem", 0.7 * h, 0.22 * h, baseCF * CF(0, 0.45 * h, 0), color, M.Metal)
	vcyl(parent, "TrophyCup", 0.85 * h, 0.9 * h, baseCF * CF(0, 1.1 * h, 0), color, M.Metal, { reflect = 0.2 })
	for _, s in ipairs({ -1, 1 }) do
		part(parent, "TrophyHandle", V3(0.12, 0.55, 0.12) * h, baseCF * CF(s * 0.52 * h, 1.55 * h, 0), color, M.Metal)
	end
end

-- simple decorative treadmill (user stands at +Z facing -Z); returns belt-top height above the floor
local function decorTreadmill(parent, pos)
	local O = CF(pos)
	part(parent, "TMDeck", V3(3, 0.55, 7), O * CF(0, 0.28, 0), C.black, M.SmoothPlastic, { collide = true })
	part(parent, "TMBelt", V3(2.3, 0.06, 6.6), O * CF(0, 0.58, 0.1), Color3.fromRGB(30, 30, 30), M.Rubber)
	part(parent, "TMHood", V3(3.1, 0.9, 1.3), O * CF(0, 0.55, -3.6), Color3.fromRGB(40, 40, 46), M.SmoothPlastic)
	for _, x in ipairs({ -1.4, 1.4 }) do
		part(parent, "TMUpright", V3(0.25, 4.3, 0.25), O * CF(x, 2.6, -3.4) * ANG(RAD(-8), 0, 0), C.steelLight, M.Metal)
		part(parent, "TMRail", V3(0.18, 0.18, 2.4), O * CF(x, 4.2, -2.2), C.steelLight, M.Metal)
	end
	local console = part(parent, "TMConsole", V3(3.2, 1.2, 0.45), O * CF(0, 4.8, -3.7) * ANG(RAD(-25), 0, 0), C.black, M.SmoothPlastic)
	sign(console, Enum.NormalId.Back, "6.8 MPH\n2.41 MI", Color3.fromRGB(90, 220, 255), Color3.fromRGB(8, 10, 14), 40)
	return 0.61
end

-- simple decorative upright bike (rider faces -Z); seat top 2.7 above the floor
local function decorBike(parent, pos)
	local O = CF(pos)
	part(parent, "BikeRail", V3(0.4, 0.3, 4.4), O * CF(0, 0.15, -0.4), C.black, M.Metal, { collide = true })
	part(parent, "BikeFootF", V3(2.4, 0.3, 0.4), O * CF(0, 0.15, -2.4), C.black, M.Metal)
	part(parent, "BikeFootB", V3(2.4, 0.3, 0.4), O * CF(0, 0.15, 1.6), C.black, M.Metal)
	part(parent, "BikeSeatPost", V3(0.3, 2.5, 0.3), O * CF(0, 1.35, 1.0) * ANG(RAD(-12), 0, 0), C.red, M.Metal)
	part(parent, "BikeSeat", V3(1.0, 0.25, 1.3), O * CF(0, 2.58, 1.0), C.black, M.Leather)
	part(parent, "BikeColumn", V3(0.3, 3.5, 0.3), O * CF(0, 1.9, -1.5) * ANG(RAD(15), 0, 0), C.red, M.Metal)
	part(parent, "BikeBar", V3(2.2, 0.2, 0.2), O * CF(0, 3.7, -1.95), C.black, M.Metal)
	cyl(parent, "BikeFlywheel", 0.35, 2.0, O * CF(0, 1.3, -2.1) * ANG(0, RAD(90), 0), C.steelLight, M.Metal)
	return 2.7
end

------------------------------------------------------------------------
-- 1. Interior structure: trusses, columns, ducts, wainscot, exit signs, extinguishers, speakers
------------------------------------------------------------------------
local function buildStructure(root)
	local f = folder(root, "Structure")
	-- steel I-beam trusses spanning the hall (north-south), purlins across them
	for _, x in ipairs({ -90, -60, -30, 0, 30, 60, 90 }) do
		part(f, "TrussBottom", V3(1.2, 0.25, 158), CF(x, 28.25, 0), C.steel, M.Metal, { shadow = false })
		part(f, "TrussWeb", V3(0.3, 1.3, 158), CF(x, 29.0, 0), C.steel, M.Metal, { shadow = false })
		part(f, "TrussTop", V3(1.2, 0.25, 158), CF(x, 29.75, 0), C.steel, M.Metal, { shadow = false })
		-- diagonal web members every 20 studs give the truss its look
		for z = -70, 70, 20 do
			part(f, "TrussBrace", V3(0.2, 0.2, 2.2), CF(x, 28.9, z) * ANG(RAD(35), 0, 0), C.steel, M.Metal, { shadow = false })
		end
	end
	for _, z in ipairs({ -60, -20, 20, 60 }) do
		part(f, "Purlin", V3(218, 0.35, 0.5), CF(0, 29.7, z), C.steel, M.Metal, { shadow = false })
	end
	-- steel columns against the long walls (kept clear of signs and windows)
	for _, x in ipairs({ -90, -60, 60, 90 }) do
		for _, z in ipairs({ -78.4, 78.4 }) do
			part(f, "ColumnFlange", V3(1.2, 27.9, 0.22), CF(x, 14.35, z - 0.45), C.steel, M.Metal)
			part(f, "ColumnFlange", V3(1.2, 27.9, 0.22), CF(x, 14.35, z + 0.45), C.steel, M.Metal)
			part(f, "ColumnWeb", V3(0.3, 27.9, 0.9), CF(x, 14.35, z), C.steel, M.Metal)
			part(f, "ColumnBase", V3(1.8, 0.4, 1.4), CF(x, 0.7, z), C.steel, M.Metal)
		end
	end
	-- round ducts with hangers, joints and vent grilles
	for _, z in ipairs({ -40, 40 }) do
		cyl(f, "Duct", 214, 2.2, CF(0, 26, z), C.galv, M.Metal, { shadow = false })
		for x = -105, 105, 15 do
			cyl(f, "DuctJoint", 0.3, 2.35, CF(x, 26, z), C.steelLight, M.Metal, { shadow = false })
		end
		for x = -90, 90, 30 do
			part(f, "DuctHanger", V3(0.12, 2.9, 0.12), CF(x + 7, 28.6, z), C.steel, M.Metal, { shadow = false })
			part(f, "DuctStrap", V3(0.15, 0.15, 2.5), CF(x + 7, 27.15, z), C.steel, M.Metal, { shadow = false })
		end
		for x = -95, 95, 30 do
			part(f, "Vent", V3(1.8, 0.35, 1.3), CF(x, 24.85, z), Color3.fromRGB(80, 82, 88), M.Metal, { shadow = false })
			for k = -1, 1 do
				part(f, "VentSlat", V3(1.6, 0.05, 0.12), CF(x, 24.66, z + k * 0.35), C.black, M.Metal, { shadow = false })
			end
		end
	end
	-- wainscot band, red stripe and baseboard on the inside of the shell (skipping doorways)
	local function band(wallId, from, to)
		local mid, len = (from + to) / 2, to - from
		onWall(f, "Wainscot", wallId, mid, 2.4, len, 4, 0.12, C.wainscot, M.SmoothPlastic, nil, 0.01)
		onWall(f, "WallStripe", wallId, mid, 4.65, len, 0.5, 0.14, C.red, M.SmoothPlastic, nil, 0.01)
		onWall(f, "Baseboard", wallId, mid, 0.7, len + 0.04, 0.6, 0.2, C.black, M.SmoothPlastic, nil, 0.01)
	end
	band("N", -109, -8)
	band("N", 8, 109)
	band("S", -109, -10)
	band("S", 10, 109)
	band("W", -79, 79)
	-- the east wall opens into the Elite Performance Wing at z 44..56 (MapBuilder.EliteWing)
	band("E", -79, 43.5)
	band("E", 56.5, 79)
	-- EXIT signs over both doorways
	for _, d in ipairs({ { "S", 0 }, { "N", 0 } }) do
		local box, face = onWall(f, "ExitSign", d[1], d[2], 15.3, 3, 1, 0.4, Color3.fromRGB(20, 20, 22), M.SmoothPlastic)
		sign(box, face, "EXIT", Color3.fromRGB(90, 255, 120), Color3.fromRGB(14, 30, 16), 40)
	end
	-- fire extinguishers with their wall signs
	for _, d in ipairs({ { "W", 0 }, { "E", -12 }, { "S", -14 }, { "N", 14 }, { "DWw", -24 }, { "DEc", -24 } }) do
		local n = wallNormal(d[1])
		local base = wallPoint(d[1], d[2], 1.6, 0.5)
		vcyl(f, "Extinguisher", 2.0, 0.7, CF(base), C.red, M.SmoothPlastic)
		vcyl(f, "ExtinguisherTop", 0.4, 0.35, CF(base + V3(0, 2.0, 0)), C.black, M.Metal)
		part(f, "ExtinguisherHose", V3(0.12, 1.2, 0.12), CF(base + V3(0, 1.4, 0) + n * 0.4), C.black, M.Rubber)
		local s, face = onWall(f, "ExtinguisherSign", d[1], d[2], 5.9, 1.0, 1.0, 0.06, C.red, M.SmoothPlastic, nil, 0.16)
		sign(s, face, "FIRE", Color3.new(1, 1, 1), C.red, 40)
	end
	-- wall speakers and security cameras
	for _, d in ipairs({ { "N", -37, 21.5 }, { "N", 37, 21.5 }, { "S", -66, 21 }, { "S", 66, 21 }, { "W", 10, 21 }, { "E", 10, 21 } }) do
		local box = onWall(f, "Speaker", d[1], d[2], d[3], 1.6, 2.4, 1.1, C.black, M.SmoothPlastic, nil, 0.05)
		local n = wallNormal(d[1])
		local front = box.Position + n * 0.56
		for k, yy in ipairs({ 0.5, -0.45 }) do
			cyl(f, "SpeakerCone", 0.06, k == 1 and 0.6 or 0.95, CFrame.lookAt(front + V3(0, yy, 0), front + V3(0, yy, 0) + n) * ANG(0, RAD(90), 0), Color3.fromRGB(60, 60, 64), M.Fabric)
		end
	end
	for _, d in ipairs({ { "N", -100 }, { "S", 100 }, { "W", -70 }, { "E", 70 } }) do
		local n = wallNormal(d[1])
		local p = wallPoint(d[1], d[2], 26, 0.6)
		part(f, "CameraMount", V3(0.3, 0.3, 0.3), CF(p), C.white, M.SmoothPlastic)
		part(f, "SecurityCamera", V3(0.6, 0.6, 1.4), CFrame.lookAt(p + n * 0.7 - V3(0, 0.3, 0), p + n * 4 - V3(0, 2.5, 0)), C.white, M.SmoothPlastic)
	end
end

------------------------------------------------------------------------
-- 2. Lighting rig (interior)
------------------------------------------------------------------------
-- warm key light from the pendants: a boxer under the grid reads at mid grey (the lamps were tuned
-- for a much darker hall; Future's falloff over the 19 studs to chest height needs ~2.5)
-- (brighter still with the lifted global Ambient of Config.Lighting: every room reads, no dark corners;
-- each zone keeps its own warmth so the hall is not one flat colour)
local LIGHT = {
	boxing = { color = Color3.fromRGB(255, 234, 204), brightness = 3.0 },
	weights = { color = Color3.fromRGB(255, 238, 216), brightness = 2.9 },
	cardio = { color = Color3.fromRGB(226, 238, 255), brightness = 2.9 },
	recovery = { color = Color3.fromRGB(255, 222, 184), brightness = 2.5 },
	services = { color = Color3.fromRGB(255, 228, 196), brightness = 2.6 },
	lobby = { color = Color3.fromRGB(255, 230, 196), brightness = 2.8 },
}
-- the accent palette (neon signs, LED strips, gel washes)
local ACCENT = {
	red = Color3.fromRGB(255, 50, 60), blue = Color3.fromRGB(60, 130, 255), gold = Color3.fromRGB(255, 200, 60),
	magenta = Color3.fromRGB(255, 80, 200), cyan = Color3.fromRGB(70, 225, 255), teal = Color3.fromRGB(80, 230, 200),
}

-- a hanging neon sign: a dark plate with bright text on both faces, a neon tube border in the sign's
-- colour and a coloured pool of light under it (6 parts, 2 guis, 1 light)
local function neonSign(parent, text, cf, w, color, font)
	local m = model(parent, "NeonSign")
	local h = w * 0.26
	local plate = part(m, "NeonPlate", V3(w, h, 0.3), cf, Color3.fromRGB(14, 14, 18), M.SmoothPlastic, { shadow = false })
	for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
		sign(plate, face, text, color, nil, 30, 0, font or "sign")
	end
	for _, e in ipairs({ { 0, h / 2 + 0.12, w + 0.5, 0.22 }, { 0, -h / 2 - 0.12, w + 0.5, 0.22 }, { -w / 2 - 0.14, 0, 0.22, h }, { w / 2 + 0.14, 0, 0.22, h } }) do
		part(m, "NeonTube", V3(e[3], e[4], 0.22), cf * CF(e[1], e[2], 0), color, M.Neon, { shadow = false })
	end
	for _, x in ipairs({ -w / 2 + 0.6, w / 2 - 0.6 }) do
		local top = (cf * CF(x, h / 2, 0)).Position
		part(m, "SignCable", V3(0.08, math.max(0.5, 28 - top.Y), 0.08), CF(top.X, (top.Y + 28) / 2, top.Z), C.black, M.Metal, { shadow = false })
	end
	point(emitter(m, cf * CF(0, -h / 2 - 0.6, 0)), color, 22, 1.1)
	return m
end

local function zoneLight(x, z)
	if math.abs(x) <= 45 then
		return z < 4 and LIGHT.boxing or LIGHT.lobby
	elseif x < 0 then
		return z < 20 and LIGHT.weights or LIGHT.services
	else
		return z < 20 and LIGHT.cardio or LIGHT.recovery
	end
end

local function pendant(parent, x, z, y, zone)
	local m = model(parent, "PendantLamp")
	part(m, "LampCable", V3(0.08, 30 - (y + 0.6), 0.08), CF(x, (30 + y + 0.6) / 2, z), C.black, M.Metal, { shadow = false })
	vcyl(m, "LampCap", 0.6, 1.1, CF(x, y + 0.3, z), Color3.fromRGB(34, 52, 44), M.Metal, { shadow = false })
	vcyl(m, "LampShade", 0.55, 2.6, CF(x, y - 0.25, z), Color3.fromRGB(34, 52, 44), M.Metal, { shadow = false })
	vcyl(m, "LampShadeRim", 0.25, 3.6, CF(x, y - 0.5, z), Color3.fromRGB(28, 44, 36), M.Metal, { shadow = false })
	-- (the reflector glows: a warm ring of light inside every shade reads from across the hall, cheap Neon)
	vcyl(m, "LampReflector", 0.05, 3.3, CF(x, y - 0.27, z), Color3.fromRGB(255, 226, 180), M.Neon, { shadow = false })
	ball(m, "LampBulb", 0.95, CF(x, y - 0.55, z), zone.color, M.Neon, { shadow = false })
	local src = emitter(m, CF(x, y - 1.2, z))
	-- a wide cone so neighbouring pools overlap (no dark bands between lamps 30 studs apart)
	spot(src, Enum.NormalId.Bottom, zone.color, 58, zone.brightness, 130, false)
	return m
end

local function buildLights(root)
	local f = folder(root, "Lighting")
	for x = -90, 90, 30 do
		for z = -60, 60, 30 do
			if not (x == 0 and z == -60) then -- the ring has its own canopy
				pendant(f, x, z, 23.8, zoneLight(x, z))
			end
		end
	end
	-- the roof wash: the pendants throw their light down, which left the ceiling, the trusses and the top
	-- of the walls near black. Six wide, soft, shadowless warm lights up under the roof lift the whole
	-- upper hall (daylight bouncing off the roof deck: no dark corners, the room reads as day)
	for _, x in ipairs({ -66, 0, 66 }) do
		for _, z in ipairs({ -45, 35 }) do
			point(emitter(f, CF(x, 27.5, z)), Color3.fromRGB(255, 232, 198), 60, 0.9)
		end
	end
	-- sparring ring canopy: a square truss with four shadow-casting cans aimed at the canvas
	local rc = V3(0, 0, -50)
	local y = 19.5
	for _, s in ipairs({ -9, 9 }) do
		part(f, "CanopyBar", V3(18.6, 0.6, 0.6), CF(rc + V3(0, y, s)), C.black, M.Metal, { shadow = false })
		part(f, "CanopyBar", V3(0.6, 0.6, 18.6), CF(rc + V3(s, y, 0)), C.black, M.Metal, { shadow = false })
	end
	for _, c in ipairs({ { -9, -9 }, { 9, -9 }, { 9, 9 }, { -9, 9 } }) do
		local corner = rc + V3(c[1], y, c[2])
		part(f, "CanopyCable", V3(0.08, 30 - y, 0.08), CF(corner + V3(0, (30 - y) / 2, 0)), C.black, M.Metal, { shadow = false })
		local canPos = corner - V3(0, 0.9, 0)
		local can = part(f, "RingCan", V3(1.2, 1.2, 1.9), CFrame.lookAt(canPos, rc + V3(0, 3, 0)), C.black, M.Metal, { shadow = false })
		part(f, "RingCanLens", V3(0.95, 0.95, 0.06), can.CFrame * CF(0, 0, -0.97), Color3.fromRGB(255, 250, 235), M.Neon, { shadow = false })
		local src = emitter(f, can.CFrame * CF(0, 0, -1.3))
		-- angled 45 degrees down from the corners: modelling key light on faces and muscles. Graphics
		-- Medium keeps the shadows of the two cans on one diagonal (ShadowKeep, client WorldLOD)
		local l = spot(src, Enum.NormalId.Front, Color3.fromRGB(255, 246, 228), 52, 3.4, 62, true)
		if c[1] == c[2] then
			l:SetAttribute("ShadowKeep", true)
		end
	end
	local banner = part(f, "CanopyBanner", V3(14, 1.6, 0.12), CF(rc + V3(0, y - 1.3, 9.35)), C.red, M.Fabric, { shadow = false })
	sign(banner, Enum.NormalId.Back, "WCB SPARRING RING", Color3.new(1, 1, 1), nil, 30)
	sign(banner, Enum.NormalId.Front, "WCB SPARRING RING", Color3.new(1, 1, 1), nil, 30)
	-- cardio: cool LED strip along the top of the divider + blue wash (the DividerCap tops at 9.4)
	part(f, "LEDStrip", V3(0.3, 0.2, 60), CF(50, 9.5, -48), Color3.fromRGB(60, 150, 255), M.Neon, { shadow = false })
	for _, z in ipairs({ -63, -33 }) do
		point(emitter(f, CF(52.5, 8.6, z)), Color3.fromRGB(80, 150, 255), 18, 0.7)
	end
	-- recovery: soft teal glow along the divider top
	part(f, "LEDStrip", V3(40, 0.2, 0.3), CF(88, 9.5, 20), Color3.fromRGB(90, 220, 200), M.Neon, { shadow = false })
	for _, x in ipairs({ 78, 98 }) do
		point(emitter(f, CF(x, 8.6, 22.5)), Color3.fromRGB(110, 230, 210), 16, 0.9)
	end
	-- colour: LED strips round the sparring ring's apron (red on the north / east faces, blue on the
	-- south / west: the corner colours), each with a small pool of its colour on the floor
	-- (root is the gym's Decor folder: the ring is MapBuilder's, a sibling of it)
	local ring = root:FindFirstChild("GymRing") or (root.Parent and root.Parent:FindFirstChild("GymRing"))
	local base = ring and ring:FindFirstChild("RingBase")
	if base then
		local bc, bs = base.Position, base.Size
		local y = bc.Y + bs.Y / 2 - 0.4
		for _, e in ipairs({ { 0, -1, "red" }, { 1, 0, "red" }, { 0, 1, "blue" }, { -1, 0, "blue" } }) do
			local col = ACCENT[e[3]]
			local along = e[1] == 0 and bs.X or bs.Z
			local pos = V3(bc.X + e[1] * (bs.X / 2 + 0.08), y, bc.Z + e[2] * (bs.Z / 2 + 0.08))
			part(f, "ApronLED", e[1] == 0 and V3(along, 0.18, 0.14) or V3(0.14, 0.18, along), CF(pos), col, M.Neon, { shadow = false })
			point(emitter(f, CF(pos + V3(e[1] * 2.5, 0.5, e[2] * 2.5))), col, 15, 0.7)
		end
	end
	-- gel washes over the ring: red from the north rail of the canopy, blue from the south (soft, no
	-- shadows: the white cans still model the boxers; these colour the canvas and the ropes)
	for _, e in ipairs({ { -1, "red" }, { 1, "blue" } }) do
		local pos = rc + V3(0, y - 0.9, e[1] * 9)
		local col = ACCENT[e[2]]
		local can = part(f, "GelCan", V3(0.9, 0.9, 1.4), CFrame.lookAt(pos, rc + V3(0, 3, -e[1] * 2)), C.black, M.Metal, { shadow = false })
		part(f, "GelLens", V3(0.7, 0.7, 0.06), can.CFrame * CF(0, 0, -0.72), col, M.Neon, { shadow = false })
		spot(emitter(f, can.CFrame * CF(0, 0, -1.0)), Enum.NormalId.Front, col, 34, 1.5, 64, false)
	end
	-- coloured spots over the members' bags (magenta) and the station row east of the ring (cyan)
	for _, e in ipairs({ { V3(-30, 21, -30), "magenta" }, { V3(30, 21, -30), "cyan" } }) do
		local col = ACCENT[e[2]]
		local src = emitter(f, CF(e[1]))
		part(f, "GelLens", V3(0.8, 0.06, 0.8), CF(e[1] + V3(0, 0.3, 0)), col, M.Neon, { shadow = false })
		spot(src, Enum.NormalId.Bottom, col, 32, 1.3, 78, false)
	end
	-- neon signs hanging from the trusses, one per zone in that zone's colour
	neonSign(f, "TRAIN HARD", CF(0, 21, -8), 12, ACCENT.red)
	neonSign(f, "NO DAYS OFF", CF(-60, 21, 15) * ANG(0, RAD(90), 0), 11, ACCENT.gold)
	neonSign(f, "CARDIO", CF(60, 21, -45) * ANG(0, RAD(90), 0), 9, ACCENT.blue)
	neonSign(f, "RECOVER", CF(90, 21, 45) * ANG(0, RAD(90), 0), 9, ACCENT.teal)
	neonSign(f, "CHAMPIONS TRAIN HERE", CF(0, 20, 30), 16, ACCENT.magenta)
end

------------------------------------------------------------------------
-- 3. Lobby: floor crest, reception, lounge, vending, trophies, belts, hall of fame
------------------------------------------------------------------------
local HALL = {
	{ "MARCUS 'THE HAMMER' COLE", "41-2  (33 KO)", "WELTERWEIGHT CHAMPION 1994-99" },
	{ "SOFIA 'LIGHTNING' REYES", "29-0  (18 KO)", "UNDEFEATED FLYWEIGHT QUEEN" },
	{ "BIG EARL JOHNSON", "52-6  (44 KO)", "HEAVYWEIGHT CHAMPION 1987" },
	{ "KENJI 'SILENT STORM' MORI", "37-3  (21 KO)", "2x LIGHTWEIGHT CHAMPION" },
	{ "DARNELL 'SMOKE' HAYES", "45-4  (30 KO)", "UNDISPUTED MIDDLEWEIGHT 2008" },
}

local function buildLobby(root)
	local f = folder(root, "Lobby")
	-- floor crest between the Fight Board and the spawn (reads from the entrance)
	local crest = part(f, "FloorCrest", V3(16, 0.04, 16), CF(0, 0.42, 46), Color3.new(), M.SmoothPlastic, { transparency = 1 })
	local sg = gui(crest, Enum.NormalId.Top, 20, 1)
	local ringOuter = frame(sg, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.gold })
	Instance.new("UICorner", ringOuter).CornerRadius = UDim.new(0.5, 0)
	local ringInner = frame(sg, { Size = UDim2.fromScale(0.9, 0.9), Position = UDim2.fromScale(0.05, 0.05), BackgroundColor3 = Color3.fromRGB(150, 20, 26) })
	Instance.new("UICorner", ringInner).CornerRadius = UDim.new(0.5, 0)
	label(sg, "WCB", { TextColor3 = C.gold, Size = UDim2.fromScale(0.6, 0.34), Position = UDim2.fromScale(0.2, 0.3) })
	label(sg, "WORLD CLASS BOXING", { TextColor3 = Color3.new(1, 1, 1), Face = "signSub", Size = UDim2.fromScale(0.66, 0.08), Position = UDim2.fromScale(0.17, 0.66) })
	label(sg, "EST. 1987", { TextColor3 = C.gold, Face = "signSub", Size = UDim2.fromScale(0.3, 0.06), Position = UDim2.fromScale(0.35, 0.2) })

	-- reception desk (L-shaped) with a monitor, keyboard, bell and sign-in sheet
	part(f, "DeskFront", V3(11.8, 3.6, 2.4), CF(27.9, 2.2, 70.2), C.woodDark, M.Wood, { collide = true })
	part(f, "DeskReturn", V3(2.4, 3.6, 8.4), CF(35.0, 2.2, 67.2), C.woodDark, M.Wood, { collide = true })
	-- (the front top ends where the return's top begins: coplanar marble would shimmer)
	part(f, "DeskTop", V3(11.85, 0.3, 2.8), CF(27.675, 4.15, 70.2), Color3.fromRGB(225, 225, 228), M.Marble)
	part(f, "DeskTopReturn", V3(2.8, 0.3, 8.8), CF(35.0, 4.15, 67.2), Color3.fromRGB(225, 225, 228), M.Marble)
	part(f, "DeskStripe", V3(11.8, 0.35, 0.08), CF(27.9, 3.2, 68.97), C.red, M.SmoothPlastic)
	local deskLogo = part(f, "DeskLogo", V3(8, 1.3, 0.06), CF(27.9, 1.9, 68.97), Color3.new(), M.SmoothPlastic, { transparency = 1 })
	Signage.Board(deskLogo, Enum.NormalId.Front, "gym", { bg = false, sub = false, maxDist = 120 })
	part(f, "MonitorBase", V3(1.0, 0.08, 0.6), CF(25.5, 4.34, 70.6), C.black, M.SmoothPlastic)
	part(f, "MonitorNeck", V3(0.2, 0.7, 0.2), CF(25.5, 4.7, 70.65), C.black, M.SmoothPlastic)
	local screen = part(f, "Monitor", V3(2.3, 1.4, 0.14), CF(25.5, 5.6, 70.55), C.black, M.SmoothPlastic)
	sign(screen, Enum.NormalId.Back, "MEMBER CHECK-IN\n214 TODAY", Color3.fromRGB(90, 200, 255), Color3.fromRGB(10, 14, 22), 50)
	part(f, "Keyboard", V3(1.8, 0.08, 0.6), CF(25.5, 4.34, 71.2), C.black, M.SmoothPlastic)
	vcyl(f, "BellBase", 0.08, 0.6, CF(30.6, 4.3, 69.6), C.black, M.Metal)
	ball(f, "DeskBell", 0.45, CF(30.6, 4.5, 69.6), C.gold, M.Metal)
	part(f, "Clipboard", V3(0.8, 0.05, 1.1), CF(23.4, 4.33, 69.6), Color3.fromRGB(150, 110, 70), M.Wood)
	part(f, "SignInSheet", V3(0.7, 0.03, 0.95), CF(23.4, 4.37, 69.6), C.white, M.SmoothPlastic)
	-- (on two lines, between the deck's west edge and the reception's return: from the spawn side
	-- the stair landing's post stands in front of the wall east of x ~33)
	local welcome = onWall(f, "WelcomeSign", "S", 26.6, 9.5, 12, 3.2, 0.25, Color3.fromRGB(18, 18, 22), M.SmoothPlastic)
	sign(welcome, Enum.NormalId.Front, "WELCOME TO\nWORLD CLASS BOXING", C.gold, Color3.fromRGB(18, 18, 22), 30)

	-- lounge: rug, two couches, coffee table and a TV
	part(f, "Rug", V3(16, 0.04, 13), CF(-36, 0.42, 51), Color3.fromRGB(120, 28, 34), M.Fabric)
	part(f, "RugBorder", V3(16.6, 0.03, 13.6), CF(-36, 0.415, 51), C.gold, M.Fabric)
	-- couch A faces -Z (towards the TV)
	part(f, "CouchSeat", V3(10, 1.2, 3.2), CF(-36, 1.0, 55.4), C.leather, M.Leather, { collide = true })
	part(f, "CouchBack", V3(10, 2.6, 0.9), CF(-36, 2.1, 57.4), C.leather, M.Leather, { collide = true })
	for _, x in ipairs({ -41.4, -30.6 }) do
		part(f, "CouchArm", V3(0.9, 1.9, 3.2), CF(x, 1.35, 55.4), C.leather, M.Leather, { collide = true })
	end
	for i = -1, 1 do
		part(f, "CouchCushion", V3(3.1, 0.35, 2.9), CF(-36 + i * 3.2, 1.75, 55.3), Color3.fromRGB(62, 46, 38), M.Leather)
	end
	-- couch B faces +X
	part(f, "CouchSeat", V3(3.2, 1.2, 8), CF(-42.4, 1.0, 48.6), C.leather, M.Leather, { collide = true })
	part(f, "CouchBack", V3(0.9, 2.6, 8), CF(-44.4, 2.1, 48.6), C.leather, M.Leather, { collide = true })
	for _, z in ipairs({ 44.15, 53.05 }) do
		part(f, "CouchArm", V3(3.2, 1.9, 0.9), CF(-42.4, 1.35, z), C.leather, M.Leather, { collide = true })
	end
	-- coffee table with magazines
	part(f, "CoffeeTable", V3(5, 0.3, 2.8), CF(-35.5, 1.45, 50.4), Color3.fromRGB(70, 50, 36), M.Wood, { collide = true })
	for _, x in ipairs({ -37.6, -33.4 }) do
		for _, z in ipairs({ 49.3, 51.5 }) do
			part(f, "TableLeg", V3(0.25, 1.05, 0.25), CF(x, 0.82, z), C.black, M.Metal)
		end
	end
	part(f, "Magazine", V3(1.0, 0.05, 1.3), CF(-36.4, 1.63, 50.2) * ANG(0, RAD(15), 0), C.red, M.SmoothPlastic)
	part(f, "Magazine", V3(1.0, 0.05, 1.3), CF(-34.6, 1.63, 50.6) * ANG(0, RAD(-10), 0), Color3.fromRGB(240, 200, 40), M.SmoothPlastic)
	-- TV on a stand facing the couch
	part(f, "TVStand", V3(6, 2, 1.6), CF(-36, 1.4, 44.6), C.woodDark, M.Wood, { collide = true })
	part(f, "TVFrame", V3(7.4, 4.3, 0.35), CF(-36, 4.8, 44.7), C.black, M.SmoothPlastic)
	local tv = part(f, "TVScreen", V3(7, 3.9, 0.1), CF(-36, 4.8, 44.92), Color3.fromRGB(10, 12, 18), M.SmoothPlastic)
	GymDecor.Ticker(tv, Enum.NormalId.Back, "WCB SPORTS")

	-- vending machines along the south wall, east of the entrance
	for i, x in ipairs({ 39.2, 43.4 }) do
		local body = i == 1 and C.red or Color3.fromRGB(20, 60, 160)
		-- body behind a shallow open front box; drinks sit between the lit back panel and the glass
		part(f, "Vending", V3(3.8, 7, 2.0), CF(x, 3.9, 76.9), body, M.SmoothPlastic, { collide = true })
		part(f, "VendingSide", V3(0.3, 7, 0.65), CF(x - 1.75, 3.9, 75.55), body, M.SmoothPlastic, { collide = true })
		part(f, "VendingSide", V3(1.2, 7, 0.65), CF(x + 1.3, 3.9, 75.55), body, M.SmoothPlastic, { collide = true })
		part(f, "VendingTop", V3(2.3, 1.2, 0.65), CF(x - 0.45, 6.8, 75.55), body, M.SmoothPlastic)
		part(f, "VendingBottom", V3(2.3, 1.6, 0.65), CF(x - 0.45, 1.2, 75.55), body, M.SmoothPlastic, { collide = true })
		part(f, "VendingGlow", V3(2.3, 4.2, 0.05), CF(x - 0.45, 4.2, 75.86), Color3.fromRGB(235, 245, 255), M.Neon, { transparency = 0.45, shadow = false })
		for row = 0, 2 do
			part(f, "VendingRack", V3(2.3, 0.08, 0.6), CF(x - 0.45, 2.1 + row * 1.4, 75.55), C.steelLight, M.Metal)
			for col = 0, 2 do
				local colr = ({ C.red, C.gold, Color3.fromRGB(40, 170, 80), C.blue, C.white })[(row * 3 + col + i) % 5 + 1]
				vcyl(f, "Drink", 0.85, 0.42, CF(x - 1.2 + col * 0.75, 2.14 + row * 1.4, 75.55), colr, M.SmoothPlastic)
			end
		end
		part(f, "VendingGlass", V3(2.3, 4.2, 0.08), CF(x - 0.45, 4.2, 75.25), Color3.fromRGB(190, 225, 255), M.Glass, { transparency = 0.55, shadow = false })
		local panel = part(f, "VendingPanel", V3(0.9, 2.2, 0.08), CF(x + 1.3, 4.8, 75.2), C.black, M.SmoothPlastic)
		sign(panel, Enum.NormalId.Front, "$2", C.gold, C.black, 40)
		local head = part(f, "VendingHeader", V3(2.2, 0.8, 0.06), CF(x - 0.45, 6.8, 75.2), Color3.new(), M.SmoothPlastic, { transparency = 1 })
		sign(head, Enum.NormalId.Front, i == 1 and "POWER UP" or "HYDRATE", Color3.new(1, 1, 1), nil, 40)
		part(f, "VendingSlot", V3(2.0, 0.6, 0.06), CF(x - 0.45, 1.1, 75.2), C.black, M.SmoothPlastic)
	end
	point(emitter(f, CF(41.3, 5, 74.6)), Color3.fromRGB(200, 225, 255), 9, 0.6)

	-- trophies and belts inside the existing trophy case (base top y=3, glass above)
	for i, x in ipairs({ -31.5, -28, -20, -16.5 }) do
		trophy(f, CF(x, 3.0, 71.3), ({ 1.6, 2.0, 2.0, 1.4 })[i], i == 2 and C.gold or (i == 3 and Color3.fromRGB(205, 210, 220) or C.goldDeep))
	end
	belt(f, CF(-24, 4.6, 72.4) * ANG(RAD(-8), 0, 0), Color3.fromRGB(20, 20, 22), 1.0)
	for i, x in ipairs({ -29.8, -18.2 }) do
		part(f, "BeltStand", V3(0.3, 2.4, 0.3), CF(x, 4.2, 73.5), C.black, M.Metal)
		belt(f, CF(x, 5.6, 73.35), ({ C.red, C.blue })[i], 0.62)
	end
	point(emitter(f, CF(-24, 7.6, 72)), Color3.fromRGB(255, 230, 170), 8, 0.7)

	-- championship belt display crowning the Fight Board (faces the spawn)
	part(f, "BeltCaseBack", V3(16, 4.4, 0.3), CF(0, 12.6, 32.25), Color3.fromRGB(16, 16, 20), M.Fabric)
	for _, s in ipairs({ -1, 1 }) do
		part(f, "BeltCaseFrame", V3(16.4, 0.3, 1.4), CF(0, 12.6 + s * 2.3, 32.7), C.gold, M.Metal)
		part(f, "BeltCaseFrame", V3(0.3, 4.9, 1.4), CF(s * 8.05, 12.6, 32.7), C.gold, M.Metal)
	end
	part(f, "BeltCaseGlass", V3(16, 4.4, 0.1), CF(0, 12.6, 33.3), Color3.fromRGB(200, 230, 255), M.Glass, { transparency = 0.8, shadow = false })
	local beltColors = { C.red, C.green, Color3.fromRGB(20, 20, 22), C.blue }
	for i, x in ipairs({ -5.6, -1.9, 1.9, 5.6 }) do
		belt(f, CF(x, 12.4, 32.55) * ANG(0, RAD(180), 0), beltColors[i], 0.85)
	end
	local title = part(f, "BeltCaseTitle", V3(10, 0.9, 0.1), CF(0, 15.4, 32.4), Color3.fromRGB(16, 16, 20), M.SmoothPlastic)
	sign(title, Enum.NormalId.Back, "THE FOUR BELTS - WBA  WBC  IBF  WBO", C.gold, Color3.fromRGB(16, 16, 20), 40)
	point(emitter(f, CF(0, 15.5, 34.5)), Color3.fromRGB(255, 225, 160), 10, 0.8)

	-- hall of fame on the south wall above the trophy case
	local hof = onWall(f, "HallTitle", "S", -30, 15.2, 18, 1.8, 0.15, Color3.fromRGB(18, 18, 22), M.SmoothPlastic)
	sign(hof, Enum.NormalId.Front, "HALL OF FAME", C.gold, Color3.fromRGB(18, 18, 22), 40)
	for i, entry in ipairs(HALL) do
		local x = -42 + (i - 1) * 6
		onWall(f, "HallFrame", "S", x, 10.6, 4.4, 5.6, 0.18, C.gold, M.Metal, nil, 0.02)
		local plate = onWall(f, "HallPlate", "S", x, 10.6, 3.9, 5.1, 0.2, Color3.fromRGB(22, 22, 28), M.SmoothPlastic, nil, 0.04)
		local sgp = gui(plate, Enum.NormalId.Front, 40, 0.4)
		frame(sgp, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(22, 22, 28) })
		-- a stylised portrait: head + shoulders + gloves
		local face = frame(sgp, { Size = UDim2.fromScale(0.3, 0.22), Position = UDim2.fromScale(0.35, 0.08), BackgroundColor3 = Color3.fromRGB(160 - i * 12, 110 - i * 8, 80 - i * 6) })
		Instance.new("UICorner", face).CornerRadius = UDim.new(0.5, 0)
		frame(sgp, { Size = UDim2.fromScale(0.6, 0.16), Position = UDim2.fromScale(0.2, 0.3), BackgroundColor3 = Color3.fromRGB(150 - i * 12, 102 - i * 8, 74 - i * 6) })
		for _, gx in ipairs({ 0.12, 0.68 }) do
			local g = frame(sgp, { Size = UDim2.fromScale(0.2, 0.14), Position = UDim2.fromScale(gx, 0.26), BackgroundColor3 = C.red })
			Instance.new("UICorner", g).CornerRadius = UDim.new(0.4, 0)
		end
		label(sgp, entry[1], { TextColor3 = C.gold, Size = UDim2.fromScale(0.92, 0.18), Position = UDim2.fromScale(0.04, 0.5) })
		label(sgp, entry[2], { TextColor3 = Color3.new(1, 1, 1), Face = "signSub", Size = UDim2.fromScale(0.9, 0.12), Position = UDim2.fromScale(0.05, 0.69) })
		label(sgp, entry[3], { TextColor3 = Color3.fromRGB(190, 190, 200), Face = "body", Size = UDim2.fromScale(0.9, 0.1), Position = UDim2.fromScale(0.05, 0.84) })
	end

	-- plants by the entrance and in the lounge
	for _, p in ipairs({ V3(-13.5, 0.4, 76.5), V3(13.5, 0.4, 76.5), V3(-43.5, 0.4, 59.5), V3(-28.5, 0.4, 59.5), V3(44, 0.4, 66) }) do
		plant(f, p, 1)
	end
	-- the lobby's round timer: on the south wall between the entrance and the lounge mezzanine,
	-- level with the welcome sign. Nothing stands in front of it, and it stands in front of nothing
	-- (under the deck's west edge it hid the welcome sign from the spawn; behind the deck the slab
	-- hid it from the lobby)
	GymDecor.RoundTimer(f, CF(wallPoint("S", 15, 9.5, 0.45)), 7, false, true)
end

------------------------------------------------------------------------
-- 4. Boxing area: flags, posters, wall text, timers, glove rack, ringside, fans
------------------------------------------------------------------------
local function flag(parent, cf, kind)
	-- cf = centre of a 5 x 3.4 flag hanging in the XY plane of cf
	local W, H, T = 5, 3.4, 0.08
	local function strip(name, w, h, x, y, color)
		part(parent, name, V3(w, h, T), cf * CF(x, y, 0), color, M.Fabric, { shadow = false })
	end
	if kind == "mexico" or kind == "ireland" or kind == "italy" then
		local cols = ({
			mexico = { Color3.fromRGB(0, 104, 71), C.white, Color3.fromRGB(206, 17, 38) },
			ireland = { Color3.fromRGB(22, 155, 98), C.white, Color3.fromRGB(255, 136, 62) },
			italy = { Color3.fromRGB(0, 140, 69), C.white, Color3.fromRGB(205, 33, 42) },
		})[kind]
		for i = 1, 3 do
			strip("Flag", W / 3, H, (i - 2) * W / 3, 0, cols[i])
		end
		if kind == "mexico" then
			part(parent, "FlagEmblem", V3(0.7, 0.7, T + 0.02), cf, Color3.fromRGB(140, 90, 40), M.Fabric, { shadow = false })
		end
	elseif kind == "germany" or kind == "ghana" or kind == "colombia" then
		local cols = ({
			germany = { C.black, Color3.fromRGB(221, 0, 0), Color3.fromRGB(255, 206, 0) },
			ghana = { Color3.fromRGB(206, 17, 38), Color3.fromRGB(252, 209, 22), Color3.fromRGB(0, 107, 63) },
			colombia = { Color3.fromRGB(252, 209, 22), Color3.fromRGB(0, 56, 147), Color3.fromRGB(206, 17, 38) },
		})[kind]
		for i = 1, 3 do
			strip("Flag", W, H / 3, 0, (2 - i) * H / 3, cols[i])
		end
		if kind == "ghana" then
			part(parent, "FlagStar", V3(0.6, 0.6, T + 0.02), cf * ANG(0, 0, RAD(45)), C.black, M.Fabric, { shadow = false })
		end
	elseif kind == "japan" then
		strip("Flag", W, H, 0, 0, C.white)
		cyl(parent, "FlagDisc", T + 0.02, 1.9, cf * ANG(0, RAD(90), 0), Color3.fromRGB(188, 0, 45), M.Fabric, { shadow = false })
	elseif kind == "usa" then
		for i = 0, 6 do
			strip("Flag", W, H / 7, 0, H / 2 - H / 14 - i * H / 7, i % 2 == 0 and Color3.fromRGB(178, 34, 52) or C.white)
		end
		part(parent, "FlagCanton", V3(W * 0.42, H * 0.54, T + 0.02), cf * CF(-W / 2 + W * 0.21, H / 2 - H * 0.27, 0), Color3.fromRGB(60, 59, 110), M.Fabric, { shadow = false })
	elseif kind == "philippines" then
		strip("Flag", W, H / 2, 0, H / 4, Color3.fromRGB(0, 56, 168))
		strip("Flag", W, H / 2, 0, -H / 4, Color3.fromRGB(206, 17, 38))
		-- white triangle at the hoist made from a rotated square clipped by the edge
		part(parent, "FlagTriangle", V3(H * 0.72, H * 0.72, T + 0.02), cf * CF(-W / 2 + 0.05, 0, 0) * ANG(0, 0, RAD(45)), C.white, M.Fabric, { shadow = false })
		ball(parent, "FlagSun", 0.55, cf * CF(-W / 2 + 0.75, 0, 0), Color3.fromRGB(252, 209, 22), M.Fabric, { shadow = false })
	end
	-- hanging rod
	part(parent, "FlagRod", V3(W + 0.4, 0.12, 0.12), cf * CF(0, H / 2 + 0.06, 0), C.goldDeep, M.Metal, { shadow = false })
end

local function buildBoxing(root)
	local f = folder(root, "Boxing")
	-- national flags hanging from a wire across the hall
	local z = -26
	part(f, "FlagWire", V3(90, 0.08, 0.08), CF(0, 25.6, z), C.black, M.Metal, { shadow = false })
	for _, x in ipairs({ -30, 0, 30 }) do
		part(f, "FlagWireDrop", V3(0.06, 2.7, 0.06), CF(x, 26.95, z), C.black, M.Metal, { shadow = false })
	end
	local kinds = { "mexico", "usa", "ireland", "japan", "philippines", "ghana", "germany", "colombia" }
	for i, kind in ipairs(kinds) do
		flag(f, CF(-38.5 + (i - 1) * 11, 23.75, z), kind)
	end
	-- fight posters on both dividers facing the boxing area
	for _, zz in ipairs({ -68, -60, -52, -44 }) do
		wallPoster(f, "DWb", zz, 5.0, 3.8, 5.4)
		wallPoster(f, "DEb", zz, 5.0, 3.8, 5.4)
	end
	-- painted wall text behind the ring
	wallText(f, "N", -30, 10, 22, 2.4, "DISCIPLINE BEATS TALENT", Color3.new(1, 1, 1))
	wallText(f, "N", 30, 10, 22, 2.4, "HANDS UP.  CHIN DOWN.", C.gold)
	wallText(f, "N", -30, 7.6, 18, 1.4, "- OLD PETE, FOUNDER", Color3.fromRGB(200, 200, 205), "signSub")
	-- round timers: one hanging over the station row, one on the wall behind the ring
	GymDecor.RoundTimer(f, CF(0, 15.5, -24), 10, true)
	GymDecor.RoundTimer(f, CF(-30, 15.2, -78.4) * ANG(0, RAD(180), 0), 8, false, true)
	-- glove wall rack on the west divider
	local rackZ = -28
	onWall(f, "GloveRackBoard", "DWb", rackZ, 5.6, 12, 3.4, 0.25, C.woodDark, M.WoodPlanks, nil, 0.02)
	local rackTitle = onWall(f, "GloveRackTitle", "DWb", rackZ, 7.8, 6, 0.7, 0.1, Color3.fromRGB(18, 18, 22), M.SmoothPlastic, nil, 0.05)
	sign(rackTitle, Enum.NormalId.Right, "LOANER GLOVES", C.gold, Color3.fromRGB(18, 18, 22), 40)
	for i = 0, 5 do
		local zz = rackZ - 5 + i * 2
		local peg = wallPoint("DWb", zz, 6.6, 0.55)
		part(f, "RackPeg", V3(0.7, 0.14, 0.14), CF(peg), C.steelLight, M.Metal)
		glovePair(f, CF(peg + V3(0.25, 0, 0)) * ANG(0, RAD(90), 0), GLOVE_COLORS[i + 1])
	end
	for i = 0, 4 do
		local zz = rackZ - 4 + i * 2
		local p = wallPoint("DWb", zz, 4.2, 0.85)
		part(f, "HandWrap", V3(0.08, 2.0, 0.35), CF(p), ({ C.red, C.white, C.black, C.blue, C.gold })[i + 1], M.Fabric)
	end
	-- medicine ball rack on the east divider
	local mz = -27
	for t = 0, 2 do
		local shelf = wallPoint("DEb", mz, 1.0 + t * 1.6, 0.85)
		part(f, "BallShelf", V3(1.7, 0.15, 7), CF(shelf), C.steel, M.Metal)
		for k = 0, 2 do
			ball(f, "MedBall", 1.2 - t * 0.1, CF(shelf + V3(0, 0.67 - t * 0.05, -2.2 + k * 2.2)), ({ C.red, C.black, C.blue, C.gold })[(t + k) % 4 + 1], M.Rubber)
		end
	end
	for _, s in ipairs({ -3.5, 3.5 }) do
		part(f, "BallRackSide", V3(1.7, 4.6, 0.2), CF(wallPoint("DEb", mz + s, 2.8, 0.85)), C.steel, M.Metal)
	end
	-- ringside: corner stools with buckets and towels, a timekeeper's table with the bell
	for _, c in ipairs({ { -15.2, -64.6, C.red }, { 15.2, -35.4, C.blue } }) do
		local p = V3(c[1], 0.5, c[2])
		vcyl(f, "StoolSeat", 0.3, 1.7, CF(p + V3(0, 2.1, 0)), c[3], M.Leather)
		for k = 0, 2 do
			local a = k * RAD(120)
			part(f, "StoolLeg", V3(0.14, 2.2, 0.14), CF(p + V3(math.cos(a) * 0.55, 1.05, math.sin(a) * 0.55)) * ANG(math.sin(a) * 0.15, 0, -math.cos(a) * 0.15), C.steel, M.Metal)
		end
		vcyl(f, "SpitBucket", 1.3, 1.1, CF(p + V3(1.6, 0, 0.4)), Color3.fromRGB(200, 200, 205), M.Metal)
		part(f, "BucketSponge", V3(0.6, 0.3, 0.4), CF(p + V3(1.6, 1.35, 0.4)), Color3.fromRGB(240, 220, 80), M.Fabric)
		part(f, "Towel", V3(1.5, 0.1, 1.0), CF(p + V3(0, 2.3, 0)) * ANG(0, RAD(25), 0), C.white, M.Fabric)
		vcyl(f, "WaterBottle", 1.0, 0.4, CF(p + V3(-1.3, 0, 0.6)), Color3.fromRGB(80, 160, 230), M.SmoothPlastic, { transparency = 0.2 })
	end
	local tp = V3(19.5, 0.5, -44)
	part(f, "TimeTable", V3(2.2, 0.25, 5), CF(tp + V3(0, 2.6, 0)), C.woodDark, M.Wood)
	part(f, "TableSkirt", V3(0.08, 1.2, 5), CF(tp + V3(-1.08, 2.0, 0)), C.red, M.Fabric)
	for _, x in ipairs({ -0.9, 0.9 }) do
		for _, zz in ipairs({ -2.2, 2.2 }) do
			part(f, "TimeTableLeg", V3(0.2, 2.5, 0.2), CF(tp + V3(x, 1.25, zz)), C.black, M.Metal)
		end
	end
	cyl(f, "RingBell", 0.3, 1.3, CF(tp + V3(-0.3, 3.45, -1.4)) * ANG(0, RAD(0), 0), C.gold, M.Metal, { reflect = 0.2 })
	part(f, "BellStand", V3(0.2, 0.7, 0.2), CF(tp + V3(0.05, 2.95, -1.4)), C.black, M.Metal)
	part(f, "BellHammer", V3(1.2, 0.12, 0.12), CF(tp + V3(0.1, 2.8, -0.3)) * ANG(0, RAD(30), 0), C.wood, M.Wood)
	part(f, "Scorecards", V3(0.9, 0.03, 1.2), CF(tp + V3(0.1, 2.75, 1.2)), C.white, M.SmoothPlastic)
	chair(f, tp + V3(2.3, 0, -1.2), RAD(90), C.black)
	chair(f, tp + V3(2.3, 0, 1.3), RAD(90), C.black)
	-- benches along the north wall east of the ring
	bench(f, V3(32, 0.5, -76.4), 0, 12, C.wood)
	vcyl(f, "WaterBottle", 1.0, 0.4, CF(29, 2.05, -76.4), Color3.fromRGB(80, 160, 230), M.SmoothPlastic, { transparency = 0.2 })
	part(f, "GymBag", V3(2.0, 1.1, 1.0), CF(35, 2.45, -76.5), C.red, M.Fabric)
	-- industrial fans on the north wall
	for _, x in ipairs({ -44, 44 }) do
		fan(f, wallPoint("N", x, 14, 1.2), V3(0, 0, 1), 5, C.steelLight)
		part(f, "FanBracket", V3(0.5, 0.5, 1.4), CF(wallPoint("N", x, 14, 0.5)), C.steel, M.Metal)
	end
	-- painted border around the boxing floor and a logo on the gym ring canvas
	for _, e in ipairs({ { 0, -69.6, 89.4, 0.35 }, { 0, 3.6, 89.4, 0.35 }, { -44.6, -33, 0.35, 73.6 }, { 44.6, -33, 0.35, 73.6 } }) do
		part(f, "FloorLine", V3(e[3], 0.02, e[4]), CF(e[1], 0.515, e[2]), C.white, M.SmoothPlastic)
	end
	local logo = part(f, "CanvasLogo", V3(8, 0.02, 8), CF(0, 2.82, -50), Color3.new(), M.SmoothPlastic, { transparency = 1 })
	Signage.Board(logo, Enum.NormalId.Top, "gym", { bg = false, text = "WCB", sub = false, light = 1, maxDist = 160, fg = Color3.fromRGB(235, 235, 240) })
end

------------------------------------------------------------------------
-- 5. Weight room
------------------------------------------------------------------------
local function kettlebell(parent, pos, size, color)
	ball(parent, "Kettlebell", size, CF(pos + V3(0, size / 2, 0)), color, M.Metal)
	local hy = size * 0.95
	part(parent, "KBHandle", V3(size * 0.75, 0.14, 0.14), CF(pos + V3(0, hy + 0.28, 0)), color, M.Metal)
	for _, s in ipairs({ -1, 1 }) do
		part(parent, "KBHandlePost", V3(0.14, 0.4, 0.14), CF(pos + V3(s * size * 0.33, hy + 0.1, 0)), color, M.Metal)
	end
end

local function buildWeights(root)
	local f = folder(root, "Weights")
	-- rubber tile seams across the weight room floor
	for z = -72, 12, 6 do
		part(f, "TileSeam", V3(58, 0.02, 0.12), CF(-79, 0.512, z), Color3.fromRGB(16, 16, 18), M.SmoothPlastic)
	end
	for x = -102, -56, 6 do
		part(f, "TileSeam", V3(0.12, 0.02, 96), CF(x, 0.512, -30), Color3.fromRGB(16, 16, 18), M.SmoothPlastic)
	end
	-- kettlebell rack along the north wall
	local rz = -77.2
	part(f, "KBRackShelf", V3(16, 0.25, 2.2), CF(-96, 1.75, rz), C.steel, M.Metal)
	part(f, "KBRackBase", V3(16, 0.25, 2.2), CF(-96, 0.65, rz), C.steel, M.Metal)
	for _, x in ipairs({ -103.8, -96, -88.2 }) do
		part(f, "KBRackLeg", V3(0.25, 1.4, 2.0), CF(x, 1.2, rz), C.steel, M.Metal)
	end
	local kbColors = { Color3.fromRGB(240, 200, 40), Color3.fromRGB(60, 140, 220), Color3.fromRGB(220, 60, 50), Color3.fromRGB(60, 170, 90), C.black }
	for i = 0, 5 do
		kettlebell(f, V3(-102.8 + i * 2.15, 1.87, rz), 0.8 + i * 0.07, kbColors[i % 5 + 1])
	end
	for i = 0, 4 do
		kettlebell(f, V3(-102.6 + i * 2.6, 0.77, rz), 1.15 + i * 0.07, C.black)
	end
	-- plyo boxes, medicine balls
	for i, b in ipairs({ { -61.5, 2.0 }, { -58, 2.6 }, { -54.3, 3.2 } }) do
		local box = part(f, "PlyoBox", V3(3.2, b[2], 3), CF(b[1], 0.5 + b[2] / 2, -74.5), Color3.fromRGB(176, 136, 88), M.WoodPlanks, { collide = true })
		sign(box, Enum.NormalId.Back, ({ "20\"", "24\"", "30\"" })[i], C.black, nil, 30)
	end
	for i = 0, 3 do
		ball(f, "MedBall", 1.25, CF(-55, 1.12, -69 + i * 1.6), ({ C.red, C.blue, C.black, C.gold })[i + 1], M.Rubber)
	end
	-- tractor tire with a sledgehammer leaning on it
	local tire = V3(-58, 0.5, -60)
	vcyl(f, "Tire", 1.8, 7, CF(tire), Color3.fromRGB(26, 26, 28), M.Rubber, { collide = true })
	vcyl(f, "TireInner", 0.06, 3.8, CF(tire + V3(0, 1.8, 0)), Color3.fromRGB(10, 10, 12), M.Rubber)
	for k = 0, 11 do
		local a = k * RAD(30)
		part(f, "TireTread", V3(0.5, 1.9, 0.9), CF(tire + V3(math.cos(a) * 3.45, 0.9, math.sin(a) * 3.45)) * ANG(0, -a, 0), Color3.fromRGB(34, 34, 36), M.Rubber)
	end
	local hammerBase = tire + V3(4.2, 0, 0.6)
	local top = tire + V3(3.3, 4.6, 0.6)
	rod(f, "SledgeHandle", hammerBase + V3(0, 0.2, 0), top, 0.28, C.wood, M.Wood)
	part(f, "SledgeHead", V3(0.9, 0.9, 1.8), CFrame.lookAt(top, top + V3(0, 0, 1)), C.steel, M.Metal)
	-- battle ropes anchored to a post by the divider
	local anchor = V3(-52.3, 0.5, -40)
	part(f, "RopeAnchor", V3(1.2, 2.2, 1.2), CF(anchor + V3(0, 1.1, 0)), C.black, M.Metal, { collide = true })
	vcyl(f, "AnchorRing", 0.2, 0.9, CF(anchor + V3(-0.7, 1.0, 0)) * ANG(0, 0, RAD(90)), C.steelLight, M.Metal)
	for _, side in ipairs({ -0.55, 0.55 }) do
		local prev = anchor + V3(-0.8, 0.95, side * 0.3)
		for k = 1, 8 do
			local nxt = anchor + V3(-0.8 - k * 1.5, 0.22 + (k == 1 and 0.4 or 0), side + math.sin(k * 1.3 + side * 3) * 0.45)
			rod(f, "BattleRope", prev, nxt, 0.36, Color3.fromRGB(30, 30, 34), M.Fabric)
			prev = nxt
		end
		rod(f, "RopeHandle", prev, prev + V3(-0.9, 0, 0), 0.42, C.black, M.Rubber)
	end
	-- cable station on the west wall
	for _, zz in ipairs({ -37, -25 }) do
		part(f, "CableTower", V3(1.6, 9, 1.6), CF(-106.4, 5, zz), C.black, M.Metal, { collide = true })
		part(f, "WeightStack", V3(1.1, 3.6, 0.9), CF(-106.4, 2.6, zz + (zz < -30 and 0.95 or -0.95)), Color3.fromRGB(70, 70, 76), M.Metal)
		for k = 0, 5 do
			part(f, "StackLine", V3(1.12, 0.06, 0.92), CF(-106.4, 1.2 + k * 0.6, zz + (zz < -30 and 0.95 or -0.95)), C.black, M.Metal)
		end
		cyl(f, "Pulley", 0.3, 0.7, CF(-105.4, 8.2, zz) * ANG(0, 0, 0), C.steelLight, M.Metal)
		part(f, "Cable", V3(0.06, 4.2, 0.06), CF(-105.1, 6.0, zz), C.black, M.Metal)
		part(f, "DHandle", V3(0.2, 0.6, 0.9), CF(-105.1, 3.7, zz), C.red, M.Rubber)
	end
	part(f, "CableTopBeam", V3(1.2, 1.2, 13.6), CF(-106.4, 9.8, -31), C.black, M.Metal)
	-- chalk stand, plate trees, mirror strip, workout board, fan, flat bench
	local chalk = V3(-82, 0.5, -36)
	vcyl(f, "ChalkPost", 2.8, 0.4, CF(chalk), C.steel, M.Metal)
	vcyl(f, "ChalkBase", 0.2, 1.6, CF(chalk), C.steel, M.Metal)
	vcyl(f, "ChalkBowl", 0.6, 1.7, CF(chalk + V3(0, 2.8, 0)), C.steelLight, M.Metal)
	vcyl(f, "Chalk", 0.12, 1.5, CF(chalk + V3(0, 3.3, 0)), C.white, M.Sand)
	for _, p in ipairs({ V3(-82, 0.5, -46), V3(-82, 0.5, -8) }) do
		part(f, "PlateTreeBase", V3(2.2, 0.2, 2.2), CF(p + V3(0, 0.1, 0)), C.black, M.Metal)
		vcyl(f, "PlateTreePost", 3.6, 0.3, CF(p), C.black, M.Metal)
		for k, h in ipairs({ 1.0, 1.9, 2.8 }) do
			for _, s in ipairs({ -1, 1 }) do
				part(f, "PlateHorn", V3(0.9, 0.18, 0.18), CF(p + V3(s * 0.5, h, 0)), C.steelLight, M.Metal)
				cyl(f, "StoredPlate", 0.28, 2.2 - k * 0.42, CF(p + V3(s * 0.75, h, 0)), k == 1 and Color3.fromRGB(190, 30, 35) or (k == 2 and Color3.fromRGB(30, 60, 160) or Color3.fromRGB(240, 200, 40)), M.Rubber)
			end
		end
	end
	onWall(f, "MirrorFrame", "W", -52, 4.6, 16.4, 6.4, 0.1, C.black, M.Metal, nil, 0.16)
	onWall(f, "Mirror", "W", -52, 4.6, 16, 6, 0.1, Color3.fromRGB(205, 225, 240), M.Glass, { reflect = 0.35 }, 0.2)
	local board, bface = onWall(f, "WODBoard", "DWw", -67, 5.6, 6, 4, 0.15, C.white, M.SmoothPlastic, nil, 0.02)
	local bsg = gui(board, bface, 40, 0.6)
	frame(bsg, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.white })
	label(bsg, "WORKOUT OF THE DAY", { TextColor3 = C.red, Size = UDim2.fromScale(0.92, 0.18), Position = UDim2.fromScale(0.04, 0.04) })
	label(bsg, "A  BACK SQUAT  5 x 5\nB  BENCH PRESS  4 x 8\nC  PULL-UPS  3 x MAX\nD  KB SWINGS  50\nFINISHER: TIRE FLIPS x 10", { TextColor3 = Color3.fromRGB(30, 50, 140), Face = "signSub", TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.fromScale(0.9, 0.72), Position = UDim2.fromScale(0.06, 0.25) })
	fan(f, wallPoint("W", 8, 13, 1.2), V3(1, 0, 0), 5, C.steelLight)
	part(f, "FlatBench", V3(1.4, 0.35, 4.2), CF(-62, 2.0, -48), C.black, M.Leather, { collide = true })
	for _, zz in ipairs({ -49.5, -46.5 }) do
		part(f, "FlatBenchLeg", V3(1.2, 1.5, 0.3), CF(-62, 1.15, zz), C.steel, M.Metal)
	end
	wallText(f, "W", -20, 13.2, 22, 3, "NO EXCUSES", C.red)
end

------------------------------------------------------------------------
-- 6. Cardio room
------------------------------------------------------------------------
local function buildCardio(root)
	local f = folder(root, "Cardio")
	-- a row of member machines along the north wall (two are in use by NPC members)
	local tmTop = 0
	for _, x in ipairs({ 58, 66 }) do
		tmTop = decorTreadmill(f, V3(x, 0.5, -71.5))
	end
	for _, x in ipairs({ 84, 92, 100 }) do
		decorBike(f, V3(x, 0.5, -71.5))
	end
	GymDecor.DecorSpots = GymDecor.DecorSpots or {}
	GymDecor.DecorSpots.treadmill = { pos = V3(58, 0, -71.4), stand = tmTop }
	GymDecor.DecorSpots.bike = { pos = V3(92, 0, -70.5), seat = 2.7 }
	-- TV with a sports ticker on the east wall
	onWall(f, "TVFrame", "E", -60, 12, 10.6, 6.4, 0.35, C.black, M.SmoothPlastic, nil, 0.05)
	local tv = onWall(f, "TVScreen", "E", -60, 12, 10, 5.8, 0.1, Color3.fromRGB(10, 12, 18), M.SmoothPlastic, nil, 0.42)
	GymDecor.Ticker(tv, Enum.NormalId.Left, "CARDIO ZONE")
	-- wall fans
	for _, zz in ipairs({ -14, 8 }) do
		fan(f, wallPoint("E", zz, 14, 1.2), V3(-1, 0, 0), 5, C.steelLight)
	end
	-- heart-rate zone chart on the divider
	local chart, cface = onWall(f, "HRChart", "DEc", -63, 5, 4, 5, 0.12, C.white, M.SmoothPlastic, nil, 0.02)
	local csg = gui(chart, cface, 40, 0.6)
	local zones = {
		{ "ZONE 5  MAX  90-100%", Color3.fromRGB(220, 40, 40) }, { "ZONE 4  HARD  80-90%", Color3.fromRGB(240, 130, 30) },
		{ "ZONE 3  TEMPO  70-80%", Color3.fromRGB(240, 210, 40) }, { "ZONE 2  BASE  60-70%", Color3.fromRGB(60, 180, 80) },
		{ "ZONE 1  EASY  50-60%", Color3.fromRGB(60, 140, 230) },
	}
	label(csg, "HEART RATE ZONES", { TextColor3 = C.black, Size = UDim2.fromScale(0.9, 0.12), Position = UDim2.fromScale(0.05, 0.02) })
	for i, z in ipairs(zones) do
		local band = frame(csg, { Size = UDim2.fromScale(0.9, 0.15), Position = UDim2.fromScale(0.05, 0.16 + (i - 1) * 0.165), BackgroundColor3 = z[2] })
		label(band, z[1], { TextColor3 = Color3.new(1, 1, 1), Face = "signSub" })
	end
	-- towel rack by the water cooler
	local tr = V3(106.2, 0.5, -4)
	for _, zz in ipairs({ -1.4, 1.4 }) do
		part(f, "TowelRackPost", V3(0.2, 4.4, 0.2), CF(tr + V3(0, 2.2, zz)), C.steelLight, M.Metal)
	end
	for k = 0, 2 do
		part(f, "TowelRackBar", V3(0.15, 0.15, 3), CF(tr + V3(0, 1.4 + k * 1.2, 0)), C.steelLight, M.Metal)
		part(f, "Towel", V3(0.15, 1.0, 2.4), CF(tr + V3(0.12, 0.95 + k * 1.2, 0)), ({ C.white, Color3.fromRGB(60, 150, 255), C.white })[k + 1], M.Fabric)
	end
	wallText(f, "E", -35, 9, 18, 3, "EARN YOUR ROUNDS", Color3.fromRGB(90, 190, 255))
end

------------------------------------------------------------------------
-- 7. Recovery area
------------------------------------------------------------------------
local function buildRecovery(root)
	local f = folder(root, "Recovery")
	for _, p in ipairs({ V3(53.5, 0.5, 24.5), V3(53.5, 0.5, 75.5), V3(106.5, 0.5, 75.5), V3(106.5, 0.5, 24.5) }) do
		plant(f, p, 1.1, Color3.fromRGB(220, 220, 214))
	end
	-- towel shelves against the south wall
	local sx, sz = 71, 77.6
	part(f, "ShelfBack", V3(10, 6, 0.2), CF(sx, 3.5, sz + 0.6), C.wood, M.WoodPlanks)
	for k = 0, 2 do
		local y = 1.4 + k * 1.9
		part(f, "Shelf", V3(10, 0.2, 1.6), CF(sx, y, sz), C.wood, M.WoodPlanks)
		for i = 0, 3 do
			cyl(f, "RolledTowel", 1.3, 0.75, CF(sx - 3.6 + i * 2.4, y + 0.48, sz - 0.1) * ANG(0, RAD(90), 0), (k + i) % 2 == 0 and C.white or Color3.fromRGB(90, 200, 190), M.Fabric)
		end
	end
	for _, x in ipairs({ -5, 5 }) do
		part(f, "ShelfSide", V3(0.2, 6, 1.6), CF(sx + x, 3.5, sz), C.wood, M.WoodPlanks)
	end
	-- relaxation bench and two warm floor lamps
	bench(f, V3(90, 0.5, 75.5), 0, 8, Color3.fromRGB(200, 170, 130))
	for _, z in ipairs({ 44, 56 }) do
		local p = V3(53.6, 0.5, z)
		vcyl(f, "FloorLampBase", 0.2, 1.2, CF(p), C.black, M.Metal)
		vcyl(f, "FloorLampPole", 5.6, 0.18, CF(p), C.black, M.Metal)
		vcyl(f, "FloorLampShade", 1.2, 1.6, CF(p + V3(0, 5.6, 0)), Color3.fromRGB(240, 225, 200), M.Fabric, { shadow = false })
		point(emitter(f, CF(p + V3(0, 5.9, 0))), Color3.fromRGB(255, 205, 150), 14, 0.65)
	end
	wallText(f, "S", 90, 10, 26, 2.6, "RECOVERY IS PART OF TRAINING", Color3.fromRGB(120, 230, 210))
	-- (moved north of the Elite wing doorway)
	wallText(f, "E", 33, 7.5, 16, 1.6, "BREATHE  -  RESET  -  REBUILD", Color3.fromRGB(220, 220, 230), "signSub")
end

------------------------------------------------------------------------
-- 8. Services: barber, lockers & showers, nutrition bar, bunk room
------------------------------------------------------------------------
local function buildServices(root)
	local f = folder(root, "Services")
	-- barber: second chair, waiting chairs, counter under the mirror, products, price board, clippings
	local c2 = V3(-87, 0.5, 38)
	vcyl(f, "BarberBase", 1.4, 1.2, CF(c2), C.steelLight, M.Metal)
	part(f, "BarberSeat", V3(3, 1.4, 3), CF(c2 + V3(0, 2.1, 0)), Color3.fromRGB(160, 20, 30), M.Leather, { collide = true })
	part(f, "BarberBack", V3(3, 3, 0.6), CF(c2 + V3(0, 4.1, 1.2)), Color3.fromRGB(160, 20, 30), M.Leather)
	part(f, "BarberHeadrest", V3(1.4, 0.9, 0.5), CF(c2 + V3(0, 6.0, 1.25)), C.black, M.Leather)
	for _, s in ipairs({ -1.6, 1.6 }) do
		part(f, "BarberArm", V3(0.4, 0.3, 2.6), CF(c2 + V3(s, 3.0, 0)), C.steelLight, M.Metal)
	end
	part(f, "BarberFootrest", V3(1.6, 0.2, 1.0), CF(c2 + V3(0, 0.9, -2.0)), C.steelLight, M.Metal)
	for i = 0, 2 do
		chair(f, V3(-106.4, 0.5, 43 + i * 2.6), RAD(-90), Color3.fromRGB(130, 20, 28))
	end
	part(f, "BarberCounter", V3(10, 3.2, 1.6), CF(-95, 2.1, 29.2), C.black, M.Marble, { collide = true })
	part(f, "BarberSink", V3(2, 0.2, 1.1), CF(-95, 3.72, 29.2), C.white, M.SmoothPlastic)
	vcyl(f, "SprayBottle", 0.9, 0.35, CF(-98.5, 3.7, 29.2), Color3.fromRGB(60, 160, 230), M.SmoothPlastic)
	part(f, "Clippers", V3(0.3, 0.2, 0.8), CF(-92, 3.8, 29.2), C.black, M.SmoothPlastic)
	part(f, "Comb", V3(0.7, 0.05, 0.15), CF(-91, 3.73, 29.4), C.black, M.SmoothPlastic)
	local shelf = onWall(f, "ProductShelf", "DZs", -102, 5.2, 6, 0.2, 1.2, C.wood, M.Wood)
	for i = 0, 5 do
		vcyl(f, "Product", 0.9 + (i % 2) * 0.3, 0.45, CF(-104.3 + i * 0.9, 5.3, shelf.Position.Z), ({ C.blue, C.gold, C.black, C.red, C.white, C.green })[i + 1], M.SmoothPlastic)
	end
	local price, pface = onWall(f, "PriceBoard", "DZs", -86, 6.8, 7, 4, 0.15, Color3.fromRGB(18, 18, 22), M.SmoothPlastic, nil, 0.02)
	local psg = gui(price, pface, 40, 0.3)
	frame(psg, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(18, 18, 22) })
	label(psg, "BIG LOU'S CUTS", { TextColor3 = C.gold, Size = UDim2.fromScale(0.9, 0.24), Position = UDim2.fromScale(0.05, 0.04) })
	label(psg, "FRESH CUT ........ $30\nBEARD / SHAVE ... $20\nCOLOR & DYE ...... $60", { TextColor3 = Color3.new(1, 1, 1), Face = "signSub", TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.fromScale(0.86, 0.62), Position = UDim2.fromScale(0.07, 0.32) })
	local rng = Random.new(77)
	for _ = 1, 9 do
		part(f, "HairClipping", V3(0.35, 0.03, 0.12), CF(-95 + rng:NextNumber(-2.5, 2.5), 0.515, 38 + rng:NextNumber(-2.5, 2.5)) * ANG(0, rng:NextNumber(0, 3), 0), Color3.fromRGB(25, 20, 18), M.SmoothPlastic)
	end

	-- locker room: bags and shoes on the bench, towel cart, shower entrance, wet floor sign
	for i, x in ipairs({ -75.5, -63.5 }) do
		part(f, "GymBag", V3(2.0, 1.0, 1.0), CF(x, 2.1, 32), i == 1 and C.blue or C.black, M.Fabric)
		part(f, "BagHandle", V3(1.2, 0.12, 0.12), CF(x, 2.7, 32), C.black, M.Fabric)
	end
	for i, x in ipairs({ -71, -66.5 }) do
		for _, s in ipairs({ -0.35, 0.35 }) do
			part(f, "Shoe", V3(0.55, 0.45, 1.2), CF(x + s, 0.73, 33.8), i == 1 and C.white or C.red, M.Leather)
		end
	end
	local cart = V3(-56, 0.5, 30)
	part(f, "TowelCart", V3(3, 2.4, 2), CF(cart + V3(0, 1.7, 0)), C.steelLight, M.Metal, { collide = true })
	for k = 0, 2 do
		cyl(f, "RolledTowel", 1.4, 0.8, CF(cart + V3(-0.9 + k * 0.9, 3.3, 0)) * ANG(0, RAD(90), 0), C.white, M.Fabric)
	end
	for _, x in ipairs({ -1.2, 1.2 }) do
		for _, z in ipairs({ -0.8, 0.8 }) do
			cyl(f, "CartWheel", 0.2, 0.5, CF(cart + V3(x, 0.25, z)), C.black, M.Rubber)
		end
	end
	-- shower entrance on the west wall
	onWall(f, "ShowerTiles", "W", 55, 5.5, 10, 10, 0.3, Color3.fromRGB(225, 232, 236), M.Glass, nil, 0.01)
	onWall(f, "ShowerOpening", "W", 55, 4.4, 6, 7.6, 0.32, Color3.fromRGB(28, 34, 40), M.SmoothPlastic, nil, 0.02)
	local sh, shf = onWall(f, "ShowerSign", "W", 55, 9.2, 5, 1, 0.1, Color3.fromRGB(18, 18, 22), M.SmoothPlastic, nil, 0.33)
	sign(sh, shf, "SHOWERS", Color3.fromRGB(150, 220, 255), Color3.fromRGB(18, 18, 22), 40)
	local wf = V3(-100, 0.5, 52.5)
	part(f, "WetFloorSign", V3(1.4, 2.2, 0.1), CF(wf + V3(0, 1.1, 0.35)) * ANG(RAD(-12), 0, 0), Color3.fromRGB(250, 210, 30), M.SmoothPlastic)
	part(f, "WetFloorSign", V3(1.4, 2.2, 0.1), CF(wf + V3(0, 1.1, -0.35)) * ANG(RAD(12), 0, 0), Color3.fromRGB(250, 210, 30), M.SmoothPlastic)

	-- nutrition bar: fridge, blender, fruit, smoothies, protein tubs
	local fr = V3(-83, 0.5, 77.2)
	part(f, "Fridge", V3(3.6, 7.6, 1.6), CF(fr + V3(0, 3.8, 0.4)), C.white, M.SmoothPlastic, { collide = true })
	for _, x in ipairs({ -1.65, 1.65 }) do
		part(f, "FridgeSide", V3(0.3, 7.6, 0.9), CF(fr + V3(x, 3.8, -0.85)), C.white, M.SmoothPlastic, { collide = true })
	end
	part(f, "FridgeTop", V3(3.0, 0.9, 0.9), CF(fr + V3(0, 7.15, -0.85)), C.white, M.SmoothPlastic)
	part(f, "FridgeBottom", V3(3.0, 0.8, 0.9), CF(fr + V3(0, 0.4, -0.85)), C.white, M.SmoothPlastic, { collide = true })
	part(f, "FridgeGlow", V3(3.0, 5.9, 0.05), CF(fr + V3(0, 3.75, -0.42)), Color3.fromRGB(235, 245, 255), M.Neon, { transparency = 0.5, shadow = false })
	for row = 0, 2 do
		part(f, "FridgeShelf", V3(3.0, 0.08, 0.85), CF(fr + V3(0, 1.0 + row * 2.0, -0.85)), C.steelLight, M.Metal)
		for col = 0, 3 do
			vcyl(f, "Bottle", 0.9, 0.38, CF(fr + V3(-1.1 + col * 0.73, 1.04 + row * 2.0, -0.85)), ({ Color3.fromRGB(255, 140, 40), Color3.fromRGB(60, 200, 90), Color3.fromRGB(80, 160, 255), Color3.fromRGB(240, 60, 90) })[(row + col) % 4 + 1], M.Glass, { transparency = 0.15 })
		end
	end
	part(f, "FridgeGlass", V3(3.0, 5.9, 0.08), CF(fr + V3(0, 3.75, -1.32)), Color3.fromRGB(200, 230, 255), M.Glass, { transparency = 0.6, shadow = false })
	part(f, "FridgeHandle", V3(0.12, 2.4, 0.15), CF(fr + V3(1.2, 4.2, -1.42)), C.steelLight, M.Metal)
	local bl = V3(-75.5, 4.4, 70)
	part(f, "BlenderBase", V3(0.8, 0.7, 0.8), CF(bl + V3(0, 0.35, 0)), C.black, M.SmoothPlastic)
	vcyl(f, "BlenderJar", 1.3, 0.7, CF(bl + V3(0, 0.7, 0)), Color3.fromRGB(255, 160, 190), M.Glass, { transparency = 0.25 })
	vcyl(f, "BlenderLid", 0.15, 0.75, CF(bl + V3(0, 2.0, 0)), C.black, M.SmoothPlastic)
	local fb = V3(-65, 4.4, 70)
	vcyl(f, "FruitBowl", 0.45, 1.8, CF(fb), C.white, M.SmoothPlastic)
	for i, d in ipairs({ { 0.3, 0.25, Color3.fromRGB(255, 150, 30) }, { -0.35, 0.2, Color3.fromRGB(200, 30, 40) }, { 0.0, -0.35, Color3.fromRGB(255, 150, 30) }, { 0.2, 0.0, Color3.fromRGB(120, 200, 60) } }) do
		ball(f, "Fruit", 0.55, CF(fb + V3(d[1], 0.6 + (i % 2) * 0.15, d[2])), d[3], M.SmoothPlastic)
	end
	part(f, "Banana", V3(0.9, 0.22, 0.3), CF(fb + V3(-0.1, 0.95, 0.1)) * ANG(0, 0, RAD(12)), Color3.fromRGB(250, 220, 60), M.SmoothPlastic)
	for i = 0, 2 do
		vcyl(f, "Smoothie", 0.8, 0.45, CF(V3(-71 + i * 1.2, 4.4, 69.3)), ({ Color3.fromRGB(240, 120, 160), Color3.fromRGB(120, 200, 90), Color3.fromRGB(250, 190, 70) })[i + 1], M.Glass, { transparency = 0.1 })
	end
	local ps = onWall(f, "ProteinShelf", "S", -61, 6, 8, 0.25, 1.2, C.wood, M.Wood)
	for i = 0, 4 do
		vcyl(f, "ProteinTub", 1.3, 0.95, CF(-64.2 + i * 1.6, 6.12, ps.Position.Z), C.black, M.SmoothPlastic)
		vcyl(f, "TubLid", 0.2, 0.98, CF(-64.2 + i * 1.6, 7.42, ps.Position.Z), ({ C.red, C.gold, C.blue, C.green, C.white })[i + 1], M.SmoothPlastic)
	end

	-- bunk room: nightstands with a lamp, footlockers, rug, poster
	part(f, "BunkRug", V3(22, 0.04, 6), CF(-93, 0.52, 57), Color3.fromRGB(34, 50, 96), M.Fabric)
	for _, x in ipairs({ -96.5, -89.5 }) do
		part(f, "Nightstand", V3(2, 2, 2), CF(x, 1.5, 69.5), C.wood, M.Wood)
		part(f, "NightstandDrawer", V3(1.6, 0.06, 0.06), CF(x, 1.9, 68.47), C.black, M.Metal)
		vcyl(f, "LampBase", 1.0, 0.3, CF(x, 2.5, 69.5), C.black, M.Metal)
		vcyl(f, "LampShade", 0.8, 1.0, CF(x, 3.4, 69.5), Color3.fromRGB(240, 225, 200), M.Fabric, { shadow = false })
	end
	point(emitter(f, CF(-93, 4, 69)), Color3.fromRGB(255, 200, 140), 12, 0.6)
	for _, x in ipairs({ -100, -93, -86 }) do
		part(f, "Footlocker", V3(3, 1.4, 1.5), CF(x, 1.2, 60.4), Color3.fromRGB(60, 80, 50), M.Metal)
		part(f, "FootlockerTrim", V3(3.05, 0.15, 1.55), CF(x, 1.6, 60.4), C.steelLight, M.Metal)
	end
	wallText(f, "W", 66, 7, 14, 2, "SLEEP = GAINS", Color3.fromRGB(170, 170, 255))
end

------------------------------------------------------------------------
-- 9. Pool hall
------------------------------------------------------------------------
local function buildPool(root)
	local f = folder(root, "Pool")
	-- lifeguard chair
	local lg = V3(-40, 0.5, -100)
	for _, x in ipairs({ -1.1, 1.1 }) do
		part(f, "LGLeg", V3(0.25, 6.2, 0.25), CF(lg + V3(x, 3.1, 0.9)) * ANG(RAD(8), 0, 0), C.white, M.SmoothPlastic)
		part(f, "LGLeg", V3(0.25, 6.2, 0.25), CF(lg + V3(x, 3.1, -0.9)) * ANG(RAD(-8), 0, 0), C.white, M.SmoothPlastic)
	end
	for k = 1, 3 do
		part(f, "LGStep", V3(2.4, 0.15, 0.5), CF(lg + V3(0, k * 1.5, 1.2 + k * 0.1)), C.white, M.SmoothPlastic)
	end
	part(f, "LGSeat", V3(2.6, 0.3, 2.2), CF(lg + V3(0, 6.3, 0)), Color3.fromRGB(220, 50, 40), M.SmoothPlastic)
	part(f, "LGBack", V3(2.6, 2.2, 0.3), CF(lg + V3(0, 7.4, -1.0)), Color3.fromRGB(220, 50, 40), M.SmoothPlastic)
	vcyl(f, "LGUmbrellaPole", 4, 0.15, CF(lg + V3(1.3, 6.4, -1.0)), C.white, M.SmoothPlastic)
	vcyl(f, "LGUmbrella", 0.3, 4, CF(lg + V3(1.3, 10.3, -1.0)), Color3.fromRGB(240, 70, 50), M.Fabric, { shadow = false })
	-- loungers on the east deck
	for i = 0, 2 do
		local p = V3(39, 0.5, -106 - i * 6)
		part(f, "Lounger", V3(6, 0.4, 2.2), CF(p + V3(0, 1.0, 0)), C.white, M.SmoothPlastic)
		part(f, "LoungerBack", V3(2.4, 0.4, 2.2), CF(p + V3(3.3, 1.9, 0)) * ANG(0, 0, RAD(35)), C.white, M.SmoothPlastic)
		part(f, "LoungerPad", V3(5.6, 0.2, 1.9), CF(p + V3(-0.2, 1.3, 0)), Color3.fromRGB(40, 120, 200), M.Fabric)
		for _, x in ipairs({ -2.6, 2.4 }) do
			part(f, "LoungerLeg", V3(0.25, 0.8, 1.9), CF(p + V3(x, 0.4, 0)), C.white, M.SmoothPlastic)
		end
		part(f, "LoungerTowel", V3(1.8, 0.1, 1.6), CF(p + V3(-1.5, 1.45, 0)) * ANG(0, RAD(10), 0), ({ C.red, C.gold, C.white })[i + 1], M.Fabric)
	end
	-- pool ladders at two corners of the basin
	for _, d in ipairs({ { 24, -101, -1 }, { -24, -123, 1 } }) do
		local x, edge, inward = d[1], d[2], d[3]
		for _, dx in ipairs({ -0.75, 0.75 }) do
			part(f, "LadderRail", V3(0.18, 5.6, 0.18), CF(x + dx, -1.5, edge + inward * 0.4), C.steelLight, M.Metal, { reflect = 0.2 })
			part(f, "LadderReturn", V3(0.18, 0.18, 1.5), CF(x + dx, 1.3, edge - inward * 0.3), C.steelLight, M.Metal, { reflect = 0.2 })
		end
		for k = 0, 2 do
			part(f, "LadderStep", V3(1.5, 0.12, 0.45), CF(x, -0.6 - k * 1.2, edge + inward * 0.62), C.steelLight, M.Metal)
		end
	end
	-- deck markings
	for _, d in ipairs({ { -20, -99.6, "4 FT" }, { 20, -99.6, "4 FT" }, { 0, -99.6, "NO DIVING" }, { 0, -124.4, "NO DIVING" } }) do
		local p = part(f, "DeckMark", V3(d[3] == "NO DIVING" and 8 or 3.2, 0.02, 1.2), CF(d[1], 0.51, d[2]), Color3.new(), M.SmoothPlastic, { transparency = 1 })
		local sg = gui(p, Enum.NormalId.Top, 30, 1)
		label(sg, d[3], { TextColor3 = Color3.fromRGB(200, 30, 35) })
	end
	-- towel cabinet near the corridor, wall clock, plants
	part(f, "TowelCabinet", V3(3.2, 3, 1.6), CF(14, 2.0, -84), C.white, M.SmoothPlastic, { collide = true })
	for k = 0, 2 do
		cyl(f, "RolledTowel", 1.4, 0.8, CF(14 - 0.9 + k * 0.9, 3.9, -84) * ANG(0, RAD(90), 0), k == 1 and Color3.fromRGB(60, 150, 255) or C.white, M.Fabric)
	end
	cyl(f, "PoolClockRim", 0.2, 3.2, CF(20, 12, -145.85) * ANG(0, RAD(90), 0), C.black, M.SmoothPlastic)
	cyl(f, "PoolClock", 0.2, 2.9, CF(20, 12, -145.78) * ANG(0, RAD(90), 0), C.white, M.SmoothPlastic)
	part(f, "ClockHand", V3(0.08, 1.15, 0.04), CF(20, 12, -145.64) * ANG(0, 0, RAD(-60)) * CF(0, 0.5, 0), C.black, M.SmoothPlastic)
	part(f, "ClockHand", V3(0.12, 0.75, 0.04), CF(20, 12, -145.62) * ANG(0, 0, RAD(30)) * CF(0, 0.33, 0), C.black, M.SmoothPlastic)
	for _, p in ipairs({ V3(-42, 0.5, -82), V3(42, 0.5, -82), V3(-42, 0.5, -143), V3(42, 0.5, -143) }) do
		plant(f, p, 1.1, Color3.fromRGB(230, 230, 228))
	end
end

------------------------------------------------------------------------
-- 10. Exterior of the building
------------------------------------------------------------------------
local function buildExterior(root)
	local f = folder(root, "Exterior")
	-- illuminated sign above the main entrance (faces the street)
	local sg = model(f, "EntranceSign")
	local back = part(sg, "SignBack", V3(62, 6.6, 0.8), CF(0, 23.4, 81.5), Color3.fromRGB(16, 16, 20), M.SmoothPlastic)
	-- the gym's lockup (Shared.Signage): the glove tile, the wordmark, the motto (the same badge the menus show)
	Signage.Board(back, Enum.NormalId.Back, "gym", { bg = Color3.fromRGB(16, 16, 20), maxDist = 900 })
	local neon = model(sg, "Neon")
	for _, e in ipairs({ { 0, 3.35, 62.4, 0.28 }, { 0, -3.35, 62.4, 0.28 }, { -31.2, 0, 0.28, 6.9 }, { 31.2, 0, 0.28, 6.9 } }) do
		part(neon, "NeonTube", V3(e[3], e[4], 0.28), CF(e[1], 23.4 + e[2], 82.0), Color3.fromRGB(255, 40, 50), M.Neon, { shadow = false })
	end
	tag(neon, "NeonFlicker")
	for _, x in ipairs({ -20, 20 }) do
		local fix = part(f, "SignUplight", V3(0.8, 0.6, 1.0), CF(V3(x, 18.6, 83.4), V3(x, 23.4, 81.9)), C.black, M.Metal)
		fix.CFrame = CFrame.lookAt(V3(x, 18.6, 83.4), V3(x * 0.5, 23.4, 81.9))
		spot(emitter(f, fix.CFrame * CF(0, 0, -0.7)), Enum.NormalId.Front, Color3.fromRGB(255, 225, 180), 14, 2.2, 70)
	end
	-- entrance awning, posts and downlights
	part(f, "Awning", V3(24, 0.5, 7.6), CF(0, 15.4, 84.6) * ANG(RAD(16), 0, 0), C.red, M.Fabric)
	local valance = part(f, "AwningValance", V3(24, 1.2, 0.2), CF(0, 13.9, 88.35), C.red, M.Fabric)
	sign(valance, Enum.NormalId.Back, "WORLD CLASS BOXING", Color3.new(1, 1, 1), nil, 30)
	part(f, "AwningStripe", V3(24.1, 0.25, 0.22), CF(0, 14.6, 88.36), C.white, M.Fabric)
	for _, x in ipairs({ -11.6, 11.6 }) do
		part(f, "AwningPost", V3(0.35, 14.6, 0.35), CF(x, 7.3, 88.1), C.black, M.Metal)
		spot(emitter(f, CF(x * 0.45, 14.2, 85.5)), Enum.NormalId.Bottom, Color3.fromRGB(255, 225, 185), 18, 1.4, 100)
	end
	-- door frame and propped-open glass doors
	for _, x in ipairs({ -10.2, 10.2 }) do
		part(f, "DoorFrame", V3(0.5, 14, 2.4), CF(x, 7, 80), C.black, M.Metal)
	end
	part(f, "DoorHeader", V3(21, 0.6, 2.4), CF(0, 14.1, 80), C.black, M.Metal)
	for _, sgn in ipairs({ -1, 1 }) do
		local x = sgn * 10.55
		part(f, "DoorLeaf", V3(0.18, 12.6, 4.8), CF(x, 6.7, 83.6), Color3.fromRGB(190, 220, 240), M.Glass, { transparency = 0.55, shadow = false })
		part(f, "DoorLeafFrame", V3(0.22, 12.8, 0.3), CF(x, 6.7, 86.05), C.black, M.Metal)
		part(f, "DoorHandle", V3(0.12, 2.4, 0.12), CF(x + sgn * 0.2, 5.5, 85.3), C.steelLight, M.Metal)
	end
	part(f, "DoorMat", V3(16, 0.06, 4), CF(0, 0.43, 76.6), C.black, M.Fabric)
	-- pilasters, cornice and parapet
	for _, x in ipairs({ -108.8, -87.5, -60, -35, 35, 60, 87.5, 108.8 }) do
		part(f, "Pilaster", V3(2.2, 30, 0.8), CF(x, 15, 81.4), C.brickDark, M.Brick)
		part(f, "PilasterN", V3(2.2, 30, 0.8), CF(x, 15, -81.4), C.brickDark, M.Brick)
	end
	for _, z in ipairs({ -35, 47 }) do
		part(f, "PilasterW", V3(0.8, 30, 2.2), CF(-111.4, 15, z), C.brickDark, M.Brick)
		-- the Elite wing annex (z 30..66) is built against the east wall where the second pilaster was
		if z ~= 47 then
			part(f, "PilasterE", V3(0.8, 30, 2.2), CF(111.4, 15, z), C.brickDark, M.Brick)
		end
	end
	part(f, "CorniceS", V3(225, 1.3, 1.2), CF(0, 29.4, 81.6), Color3.fromRGB(60, 34, 30), M.Concrete)
	part(f, "CorniceN", V3(225, 1.3, 1.2), CF(0, 29.4, -81.6), Color3.fromRGB(60, 34, 30), M.Concrete)
	part(f, "CorniceW", V3(1.2, 1.3, 165), CF(-111.6, 29.4, 0), Color3.fromRGB(60, 34, 30), M.Concrete)
	part(f, "CorniceE", V3(1.2, 1.3, 165), CF(111.6, 29.4, 0), Color3.fromRGB(60, 34, 30), M.Concrete)
	part(f, "ParapetS", V3(224, 2.2, 0.8), CF(0, 33.1, 80.7), C.brickDark, M.Brick)
	part(f, "ParapetN", V3(224, 2.2, 0.8), CF(0, 33.1, -80.7), C.brickDark, M.Brick)
	part(f, "ParapetW", V3(0.8, 2.2, 162), CF(-110.7, 33.1, 0), C.brickDark, M.Brick)
	part(f, "ParapetE", V3(0.8, 2.2, 162), CF(110.7, 33.1, 0), C.brickDark, M.Brick)
	-- wall-pack lights
	for _, p in ipairs({ { V3(-22.5, 11.6, 81.6), V3(0, 0, 1) }, { V3(22.5, 11.6, 81.6), V3(0, 0, 1) }, { V3(-104, 11.6, 81.6), V3(0, 0, 1) }, { V3(104, 11.6, 81.6), V3(0, 0, 1) }, { V3(-111.6, 11.6, 10), V3(-1, 0, 0) }, { V3(111.6, 11.6, 10), V3(1, 0, 0) } }) do
		local box = part(f, "WallPack", V3(1.4, 1.1, 1.4), CFrame.lookAt(p[1], p[1] + p[2]), C.black, M.Metal)
		part(f, "WallPackLens", V3(1.1, 0.4, 0.1), box.CFrame * CF(0, -0.25, -0.72), Color3.fromRGB(255, 230, 190), M.Neon, { shadow = false })
		spot(emitter(f, box.CFrame * CF(0, -0.8, -1.2)), Enum.NormalId.Bottom, Color3.fromRGB(255, 220, 170), 22, 1.3, 120)
	end
	-- fight posters and an OPEN sign on the facade
	for _, x in ipairs({ -26, -19, 19, 26 }) do
		wallPoster(f, "XS", x, 6.5, 4.4, 6.2)
	end
	local open = part(f, "OpenSign", V3(4.6, 1.6, 0.2), CF(-14.2, 9, 81.25), Color3.fromRGB(14, 14, 18), M.SmoothPlastic)
	sign(open, Enum.NormalId.Back, "OPEN 24/7", Color3.fromRGB(255, 70, 70), Color3.fromRGB(14, 14, 18), 40)
	local openNeon = part(f, "OpenNeon", V3(4.9, 1.9, 0.08), CF(-14.2, 9, 81.38), Color3.fromRGB(255, 60, 60), M.Neon, { transparency = 0.7, shadow = false })
	tag(openNeon, "NeonFlicker")
	-- sidewalk (split around the entrance path), curb, planters, benches, bins, hydrant, bike rack
	for _, seg in ipairs({ { -110, -5 }, { 5, 110 } }) do
		local mid, len = (seg[1] + seg[2]) / 2, seg[2] - seg[1]
		part(f, "Sidewalk", V3(len, 0.32, 8), CF(mid, 0.16, 85.1), C.concrete, M.Concrete, { collide = true })
		part(f, "Curb", V3(len, 0.45, 0.45), CF(mid, 0.22, 89.3), Color3.fromRGB(190, 188, 182), M.Concrete, { collide = true })
	end
	for _, x in ipairs({ -55, -85, 55, 85 }) do
		part(f, "Planter", V3(5, 1.5, 2.2), CF(x, 1.05, 87.4), C.brickDark, M.Brick, { collide = true })
		part(f, "PlanterSoil", V3(4.6, 0.1, 1.8), CF(x, 1.82, 87.4), Color3.fromRGB(60, 42, 30), M.Ground)
		for _, dx in ipairs({ -1.4, 0, 1.4 }) do
			blob(f, "Shrub", V3(1.8, 1.6, 1.6), CF(x + dx, 2.5, 87.4), Color3.fromRGB(50 + math.abs(dx) * 10, 115, 55), M.Grass)
		end
	end
	bench(f, V3(-40, 0.32, 87.6), 0, 6, C.wood)
	bench(f, V3(40, 0.32, 87.6), 0, 6, C.wood)
	for _, x in ipairs({ -12.8, 12.8 }) do
		vcyl(f, "TrashBin", 2.6, 1.6, CF(x, 0.32, 88.2), Color3.fromRGB(40, 70, 50), M.Metal, { collide = true })
		vcyl(f, "BinLid", 0.3, 1.8, CF(x, 2.92, 88.2), Color3.fromRGB(30, 50, 36), M.Metal)
	end
	local hy = V3(68, 0.32, 88.6)
	vcyl(f, "Hydrant", 2.1, 0.8, CF(hy), C.red, M.Metal, { collide = true })
	ball(f, "HydrantCap", 0.85, CF(hy + V3(0, 2.1, 0)), C.red, M.Metal)
	cyl(f, "HydrantNozzle", 1.4, 0.35, CF(hy + V3(0, 1.4, 0)), C.gold, M.Metal)
	local br = V3(-24, 0.32, 87.6)
	part(f, "BikeRackBase", V3(8, 0.2, 0.3), CF(br + V3(0, 0.1, 0)), C.steelLight, M.Metal)
	for k = 0, 3 do
		local x = -3 + k * 2
		for _, dz in ipairs({ -0.5, 0.5 }) do
			part(f, "BikeRackPost", V3(0.15, 2.2, 0.15), CF(br + V3(x, 1.1, dz)), C.steelLight, M.Metal)
		end
		part(f, "BikeRackTop", V3(0.15, 0.15, 1.15), CF(br + V3(x, 2.2, 0)), C.steelLight, M.Metal)
	end
	-- rooftop units, vents and a water tank
	for _, p in ipairs({ V3(-40, 32, 50), V3(40, 32, 50), V3(-70, 32, -40), V3(70, 32, -40) }) do
		part(f, "ACUnit", V3(6, 3.2, 4), CF(p + V3(0, 1.6, 0)), Color3.fromRGB(200, 202, 206), M.Metal)
		vcyl(f, "ACFan", 0.2, 3, CF(p + V3(0, 3.2, 0)), C.black, M.Metal)
		part(f, "ACDuct", V3(1.2, 1.2, 3), CF(p + V3(0, 0.6, 3.2)), C.galv, M.Metal)
	end
	for _, p in ipairs({ V3(-15, 32, -20), V3(20, 32, 10), V3(-80, 32, 20), V3(85, 32, 0) }) do
		vcyl(f, "RoofVent", 1.6, 1, CF(p), C.galv, M.Metal)
		vcyl(f, "RoofVentCap", 0.3, 1.6, CF(p + V3(0, 1.7, 0)), C.galv, M.Metal)
	end
	local wt = V3(85, 32, 55)
	for _, d in ipairs({ { -2.4, -2.4 }, { 2.4, -2.4 }, { 2.4, 2.4 }, { -2.4, 2.4 } }) do
		part(f, "TankLeg", V3(0.5, 6, 0.5), CF(wt + V3(d[1], 3, d[2])), C.steel, M.Metal)
	end
	vcyl(f, "WaterTank", 7, 8, CF(wt + V3(0, 6, 0)), Color3.fromRGB(120, 90, 66), M.WoodPlanks)
	vcyl(f, "TankRoof", 1.2, 8.4, CF(wt + V3(0, 13, 0)), Color3.fromRGB(80, 60, 46), M.Wood)
	-- fire escape ladder on the west facade and downspouts at the corners
	for _, dz in ipairs({ -0.8, 0.8 }) do
		part(f, "LadderRail", V3(0.2, 30, 0.2), CF(-111.8, 15, 40 + dz), C.black, M.Metal)
	end
	for k = 1, 19 do
		part(f, "LadderRung", V3(0.15, 0.15, 1.6), CF(-111.8, k * 1.5, 40), C.black, M.Metal)
	end
	for _, c in ipairs({ { -111.4, 81.4 }, { 111.4, 81.4 }, { -111.4, -81.4 }, { 111.4, -81.4 } }) do
		vcyl(f, "Downspout", 30, 0.5, CF(c[1], 0, c[2]), C.galv, M.Metal)
	end
	-- dumpsters behind the gym
	for i, x in ipairs({ -72, -64 }) do
		part(f, "Dumpster", V3(6, 4, 3.6), CF(x, 2.0, -85), i == 1 and Color3.fromRGB(40, 90, 50) or Color3.fromRGB(40, 60, 120), M.Metal, { collide = true })
		part(f, "DumpsterLid", V3(6.1, 0.2, 3.7), CF(x, 4.1, -85) * ANG(RAD(-6), 0, 0), C.black, M.Plastic)
	end
end

------------------------------------------------------------------------
-- Reusable animated props (also used by MapBuilder/CityMap)
------------------------------------------------------------------------
-- Round timer box: cf faces -Z with its front; both faces show the clock when doubleSided.
function GymDecor.RoundTimer(parent, cf, width, doubleSided, wallMounted)
	local m = model(parent, "RoundTimer")
	local h = width * 0.36
	local box = part(m, "TimerBox", V3(width, h, 0.9), cf, C.black, M.SmoothPlastic)
	local faces = { Enum.NormalId.Front }
	if doubleSided then
		table.insert(faces, Enum.NormalId.Back)
	end
	for _, face in ipairs(faces) do
		local sg = gui(box, face, 30, 0)
		frame(sg, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(8, 8, 10) })
		label(sg, "ROUND 1", { Name = "Phase", TextColor3 = C.gold, Face = "signSub", Size = UDim2.fromScale(0.5, 0.26), Position = UDim2.fromScale(0.25, 0.04) })
		label(sg, "3:00", { Name = "Time", TextColor3 = Color3.fromRGB(255, 60, 50), Face = "screen", Size = UDim2.fromScale(0.86, 0.66), Position = UDim2.fromScale(0.07, 0.3) })
	end
	for i, colr in ipairs({ Color3.fromRGB(40, 220, 80), Color3.fromRGB(250, 200, 40), Color3.fromRGB(240, 50, 40) }) do
		local lamp = part(m, ({ "LampGo", "LampWarn", "LampRest" })[i], V3(0.8, 0.8, 0.8), cf * CF((i - 2) * 1.1, h / 2 + 0.45, 0), colr, M.Neon, { shape = Enum.PartType.Ball, shadow = false })
		lamp.Transparency = 0.4
	end
	-- the board glows: a red LED frame round the clock and a small pool of its light
	for _, e in ipairs({ { 0, h / 2 + 0.06, width + 0.3, 0.12 }, { 0, -h / 2 - 0.06, width + 0.3, 0.12 }, { -width / 2 - 0.06, 0, 0.12, h }, { width / 2 + 0.06, 0, 0.12, h } }) do
		part(m, "TimerLED", V3(e[3], e[4], 0.5), cf * CF(e[1], e[2], 0), Color3.fromRGB(255, 60, 50), M.Neon, { shadow = false })
	end
	point(emitter(m, cf * CF(0, 0, -1.2)), Color3.fromRGB(255, 90, 70), 12, 0.6)
	if not wallMounted then
		for _, x in ipairs({ -width / 2 + 0.6, width / 2 - 0.6 }) do
			local top = (cf * CF(x, h / 2, 0)).Position
			part(m, "TimerCable", V3(0.08, math.max(0.5, 29 - top.Y), 0.08), CF(top.X, (top.Y + 29) / 2, top.Z), C.black, M.Metal, { shadow = false })
		end
	end
	m.PrimaryPart = box
	tag(m, "RoundTimer")
	return m
end

-- TV screen with a scrolling headline ticker
local HEADLINES = {
	"WCB SPORTS  -  Tonight: VEGA defends against KOVAC in a 12-round war",
	"Rankings shake-up: three new contenders crack the welterweight top 10",
	"Local amateur posts fastest knockout of the season at the Community Center",
	"Training camp report: champions average 6 sessions a day in fight week",
	"Golden Gloves regional tournament sign-ups now open at the front desk",
	"Fight Night at the WCB Arena  -  SOLD OUT",
}
function GymDecor.Ticker(screenPart, face, title)
	local sg = gui(screenPart, face, 40, 0)
	frame(sg, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(10, 14, 24) })
	frame(sg, { Size = UDim2.new(1, 0, 0.18, 0), BackgroundColor3 = Color3.fromRGB(190, 20, 30) })
	label(sg, title or "WCB SPORTS", { TextColor3 = Color3.new(1, 1, 1), Size = UDim2.new(0.6, 0, 0.14, 0), Position = UDim2.fromScale(0.03, 0.02), TextXAlignment = Enum.TextXAlignment.Left })
	label(sg, "LIVE", { TextColor3 = C.gold, Size = UDim2.new(0.2, 0, 0.12, 0), Position = UDim2.fromScale(0.77, 0.03) })
	-- a "broadcast" picture: ring and two fighters as simple shapes
	local pic = frame(sg, { Size = UDim2.fromScale(0.94, 0.56), Position = UDim2.fromScale(0.03, 0.21), BackgroundColor3 = Color3.fromRGB(24, 30, 48) })
	frame(pic, { Size = UDim2.fromScale(0.8, 0.22), Position = UDim2.fromScale(0.1, 0.7), BackgroundColor3 = Color3.fromRGB(40, 70, 170) })
	for i, x in ipairs({ 0.36, 0.56 }) do
		local body = frame(pic, { Size = UDim2.fromScale(0.08, 0.4), Position = UDim2.fromScale(x, 0.32), BackgroundColor3 = Color3.fromRGB(150 - i * 40, 100 - i * 25, 70 - i * 18) })
		local glove = frame(pic, { Size = UDim2.fromScale(0.05, 0.12), Position = UDim2.fromScale(i == 1 and 0.08 or -0.05, 0.1), BackgroundColor3 = i == 1 and C.red or C.blue })
		glove.Parent = body
		Instance.new("UICorner", glove).CornerRadius = UDim.new(0.5, 0)
	end
	local ticker = frame(sg, { Name = "Ticker", Size = UDim2.fromScale(1, 0.2), Position = UDim2.fromScale(0, 0.8), BackgroundColor3 = Color3.fromRGB(240, 240, 245), ClipsDescendants = true })
	label(ticker, table.concat(HEADLINES, "     *     "), { Name = "Text", TextScaled = false, TextSize = 26, TextWrapped = false, Face = "signSub", TextColor3 = Color3.fromRGB(16, 16, 22), TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(0, 4000, 1, 0) })
	tag(screenPart, "TVTicker")
	return sg
end

GymDecor.Part = part
GymDecor.Cyl = cyl
GymDecor.VCyl = vcyl
GymDecor.Ball = ball
GymDecor.Blob = blob
GymDecor.Rod = rod
GymDecor.Gui = gui
GymDecor.Label = label
GymDecor.Frame = frame
GymDecor.Sign = sign
GymDecor.Spot = spot
GymDecor.Point = point
GymDecor.Emitter = emitter
GymDecor.Tag = tag
GymDecor.Plant = plant
GymDecor.Bench = bench
GymDecor.Fan = fan
GymDecor.PosterGui = posterGui
GymDecor.Posters = POSTERS
GymDecor.Colors = C

------------------------------------------------------------------------
-- Entry point
------------------------------------------------------------------------
function GymDecor.Build(gym)
	local root = folder(gym, "Decor")
	local sections = {
		{ "structure", buildStructure }, { "lights", buildLights }, { "lobby", buildLobby }, { "boxing", buildBoxing },
		{ "weights", buildWeights }, { "cardio", buildCardio }, { "recovery", buildRecovery }, { "services", buildServices },
		{ "pool", buildPool }, { "exterior", buildExterior },
	}
	for _, s in ipairs(sections) do
		local ok, err = pcall(s[2], root)
		if not ok then
			warn("[GymDecor] " .. s[1] .. " failed: " .. tostring(err))
		end
	end
	return root
end

return GymDecor
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="100">
        <Properties>
          <string name="Name">Judging</string>
          <string name="Source"><![CDATA[-- Judging: the three ringside judges (pure: no engine state, no Instances; tools/sim/test_judging.luau pins it).
--
-- Every round each judge weighs the same five things a real judge is told to, with his own leanings:
--   * clean punching: punches landed, each weighted by its type (a jab is worth less than an uppercut), body shots,
--     counters and the heavy ones (the damage done)
--   * ring generalship: time holding the centre of the ring, time walking the other man down (FightEngine's
--     position tracking: typeStats.pressT / the judge observer's centre time)
--   * effective aggression: the work rate that LANDS (thrown punches count for a little; the aggression judge
--     likes volume and pressure more than the others)
--   * defence: punches blocked, slipped, rolled under, parried and made to miss
--   * knockdowns: the 10-point must system (Judging.MustScore): the round's winner gets 10 and the loser 9; a
--     knockdown wins the round for the man who scored it and costs the man who went down one more point (10-8,
--     two knockdowns 10-7) unless he clearly won the rest of the round (10-9); 10-10 only for a truly even round
--     with no knockdown (judges are told to pick a winner, so it is rare); a foul's point deduction comes off after
--     (so 9-9 and 10-8 without a knockdown are possible, as on a real card)
-- Judge 1 favours aggression, judge 2 clean punching, judge 3 defence and ring control. Their totals decide a
-- fight that goes the distance (Judging.Decide): unanimous, split or majority decision, or a draw. A stoppage
-- (KO, TKO, RTD, the doctor) never comes here.
--
-- Judging.Score(roundStats [, rng]) -> round: roundStats = { red = S, blue = S, seconds = n } with S as
-- Judging.NewSide() (every field optional, missing = 0):
--   landed, thrown, power (non-jab landed), body, jabs, counters, heavy, byType = { jab = n, cross = n, ... } (landed
--   per type), blocked / evaded / parried (HIS defence: the other man's punches he stopped), missed (the other man's
--   misses), kd (knockdowns he SCORED), clinches, inside, fouls (points to deduct from him), pressT / centreT /
--   liveT (seconds pressing forward / in the centre / live), mom (the round's momentum his way, -1..1)
-- The rng (Random or a table with NextNumber) is each judge's eye: a little noise so close rounds can split the
-- card; nil = deterministic.
local Judging = {}

Judging.JUDGES = {
	{ id = "aggression", name = "Judge 1", lean = "Effective aggression", noise = 1.0,
		w = { clean = 0.9, ring = 0.8, aggr = 2.0, def = 0.3, press = 1.8 } },
	{ id = "clean", name = "Judge 2", lean = "Clean punching", noise = 0.8,
		w = { clean = 1.35, ring = 0.6, aggr = 0.6, def = 0.7, press = 0.6 } },
	{ id = "defence", name = "Judge 3", lean = "Defence and ring control", noise = 1.2,
		w = { clean = 0.95, ring = 1.5, aggr = 0.6, def = 1.3, press = 0.8 } },
}

-- what a landed punch of each type is worth to the judges (a jab scores, but a clean uppercut scores more)
Judging.PUNCH_W = { jab = 0.6, cross = 1.0, leadhook = 1.05, rearhook = 1.1, uppercut = 1.15, overhand = 1.2 }
Judging.POWER_TYPES = { cross = true, leadhook = true, rearhook = true, uppercut = true, overhand = true }

Judging.EVEN_ROUND = 0.35 -- |diff| under this (in judge points) is an even round
Judging.DOMINANT_ROUND = 6.0 -- a differential this big (clear domination) outweighs one knockdown point

local function num(v)
	return tonumber(v) or 0
end

function Judging.NewSide()
	return {
		landed = 0, thrown = 0, power = 0, body = 0, jabs = 0, counters = 0, heavy = 0,
		byType = { jab = 0, cross = 0, leadhook = 0, rearhook = 0, uppercut = 0, overhand = 0 },
		thrownByType = { jab = 0, cross = 0, leadhook = 0, rearhook = 0, uppercut = 0, overhand = 0 },
		blocked = 0, evaded = 0, parried = 0, missed = 0, kd = 0, clinches = 0, inside = 0, fouls = 0,
		pressT = 0, centreT = 0, liveT = 0, mom = 0, damage = 0,
	}
end

-- add side B's counters into A (the fight totals from the rounds)
function Judging.AddSide(A, B)
	for k, v in pairs(B) do
		if type(v) == "number" then
			A[k] = num(A[k]) + v
		elseif type(v) == "table" then
			A[k] = type(A[k]) == "table" and A[k] or {}
			for t, n in pairs(v) do
				A[k][t] = num(A[k][t]) + num(n)
			end
		end
	end
	return A
end

------------------------------------------------------------------------
-- the 10-point must system
------------------------------------------------------------------------
-- diff = the judge's differential (positive: the first fighter did the better work), kdA / kdB = knockdowns each
-- fighter SCORED, foulsA / foulsB = point deductions against each (optional).
function Judging.MustScore(diff, kdA, kdB, foulsA, foulsB)
	kdA, kdB = num(kdA), num(kdB)
	diff = num(diff)
	local net = kdA - kdB
	local a, b
	local aWins
	if net ~= 0 then
		aWins = net > 0
	elseif kdA == 0 and math.abs(diff) < Judging.EVEN_ROUND then
		a, b = 10, 10
	else
		aWins = diff >= 0
	end
	if a == nil then
		local down = math.abs(net)
		if down > 0 and (aWins and -diff or diff) >= Judging.DOMINANT_ROUND then
			down -= 1 -- the man who went down clearly won the rest of the round
		end
		local loser = math.max(6, 9 - down)
		if aWins then
			a, b = 10, loser
		else
			a, b = loser, 10
		end
	end
	a = math.max(6, a - num(foulsA))
	b = math.max(6, b - num(foulsB))
	return a, b
end

------------------------------------------------------------------------
-- a round
------------------------------------------------------------------------
-- a side's work in the round by category (the judges' raw material). other = the opponent's side (his misses and
-- his landed punches tell how good the defence was).
function Judging.Categories(S, other, seconds)
	S = S or {}
	other = other or {}
	seconds = math.max(30, num(seconds) > 0 and num(seconds) or 180)
	local landed, thrown = num(S.landed), num(S.thrown)
	-- clean punching: per-type weights when the observer saw the punches, the flat tally otherwise
	local clean = 0
	local byType = type(S.byType) == "table" and S.byType or nil
	local typed = 0
	if byType then
		for t, n in pairs(byType) do
			typed += num(n)
			clean += num(n) * (Judging.PUNCH_W[t] or 1)
		end
	end
	if typed < landed then
		-- (punches the observer did not see by type: the flat weights)
		local rest = landed - typed
		local power = math.max(0, num(S.power) - math.max(0, typed - num(byType and byType.jab)))
		clean += rest * 0.7 + math.min(rest, power) * 0.35
	end
	clean += num(S.body) * 0.3 + num(S.counters) * 0.45 + num(S.heavy) * 0.5 + num(S.inside) * 0.3 + num(S.damage) * 0.04
	-- ring generalship: the centre and walking him down (shares of the live time, so a short round weighs the same)
	local live = math.max(num(S.liveT), num(other.liveT), 1)
	local centre = num(S.centreT) / live
	local press = num(S.pressT) / live
	-- (clean punching is the big category, as on a real card: these are worth a couple of points a round at most)
	local ring = centre * 1.5 + press * 1.0 - num(S.clinches) * 0.2
	-- effective aggression: the work rate (per three minutes) that lands, the pressure and the momentum
	local rate = thrown / seconds * 180
	local acc = thrown > 0 and landed / thrown or 0
	local aggr = rate * 0.012 * (0.5 + acc) + press * 0.8 + math.clamp(num(S.mom), -1, 1) * 0.8
	-- defence: what he kept off himself, and what the other man wasted
	local def = num(S.blocked) * 0.08 + num(S.evaded) * 0.2 + num(S.parried) * 0.2 + num(S.missed) * 0.02
	local oppThrown = num(other.thrown)
	if oppThrown > 0 then
		def += (1 - math.clamp(num(other.landed) / oppThrown, 0, 1)) * 0.8
	end
	return { clean = clean, ring = ring, aggr = aggr, def = def, press = press * 1.5 }
end

-- one judge's differential (A - B) in his points
function Judging.JudgeDiff(judge, catA, catB)
	local d = 0
	for k, w in pairs(judge.w) do
		d += w * (num(catA[k]) - num(catB[k]))
	end
	return d
end

local function noiseOf(rng, k)
	if rng == nil then
		return 0
	end
	local ok, v = pcall(function()
		return rng:NextNumber(-1, 1)
	end)
	return ok and (num(v) * 1.4 * k) or 0
end

local function fmtRound(a, b)
	return string.format("%d-%d", a, b)
end

-- why a judge saw it his way (the scorecard's one-liner)
local function reason(judge, a, b, kdA, kdB, catA, catB)
	if a == b then
		return (kdA == 0 and kdB == 0) and "An even round" or "Even after the knockdowns"
	end
	local redWon = a > b
	local kd = redWon and kdA or kdB
	if kd >= 2 then
		return "Two knockdowns"
	elseif kd == 1 then
		return "The knockdown"
	end
	local A, B = redWon and catA or catB, redWon and catB or catA
	local best, bestK = -1, "clean"
	for k, w in pairs(judge.w) do
		local gain = w * (num(A[k]) - num(B[k]))
		if gain > best then
			best, bestK = gain, k
		end
	end
	local TEXT = { clean = "The cleaner punching", ring = "Controlled the ring", aggr = "The busier man", def = "The tighter defence", press = "Walked him down" }
	return TEXT[bestK] or "The better work"
end

-- the three cards for a round. Returns { cards = {{a,b},{a,b},{a,b}} (red first), judges = { { a, b, diff, id, reason } },
-- red = categories, blue = categories, kd = {red, blue}, fouls = {red, blue} }
function Judging.Score(stats, rng)
	stats = stats or {}
	local R, B = stats.red or {}, stats.blue or {}
	local catR = Judging.Categories(R, B, stats.seconds)
	local catB = Judging.Categories(B, R, stats.seconds)
	local out = { cards = {}, judges = {}, red = catR, blue = catB, kd = { num(R.kd), num(B.kd) }, fouls = { num(R.fouls), num(B.fouls) } }
	for j, judge in ipairs(Judging.JUDGES) do
		local diff = Judging.JudgeDiff(judge, catR, catB) + noiseOf(rng, judge.noise)
		local a, b = Judging.MustScore(diff, R.kd, B.kd, R.fouls, B.fouls)
		out.cards[j] = { a, b }
		out.judges[j] = { a = a, b = b, diff = math.floor(diff * 100) / 100, id = judge.id, reason = reason(judge, a, b, num(R.kd), num(B.kd), catR, catB) }
	end
	return out
end

------------------------------------------------------------------------
-- the decision
------------------------------------------------------------------------
Judging.METHOD_TEXT = { UD = "unanimous decision", SD = "split decision", MD = "majority decision", Draw = "draw",
	KO = "knockout", TKO = "technical knockout", RTD = "retirement", DQ = "disqualification", Tutorial = "decision" }

-- cards = the three totals { {red, blue} x 3 } -> { outcome = "win" | "loss" | "draw" (the red corner's), method =
-- "UD" | "SD" | "MD" | "Draw", scores = { "116-112", ... } (the winner's total first on every card), text = "unanimous
-- decision", drawKind = "majority" | "split" | "unanimous" (a draw only) }
function Judging.Decide(cards)
	cards = type(cards) == "table" and cards or {}
	local pw, ow, even = 0, 0, 0
	for _, c in ipairs(cards) do
		local a, b = num(c[1]), num(c[2])
		if a > b then
			pw += 1
		elseif b > a then
			ow += 1
		else
			even += 1
		end
	end
	local n = #cards
	local res
	if n > 0 and pw == n then
		res = { outcome = "win", method = "UD" }
	elseif n > 0 and ow == n then
		res = { outcome = "loss", method = "UD" }
	elseif pw > n / 2 then
		res = { outcome = "win", method = ow > 0 and "SD" or "MD" }
	elseif ow > n / 2 then
		res = { outcome = "loss", method = pw > 0 and "SD" or "MD" }
	else
		res = { outcome = "draw", method = "Draw", drawKind = (even == n) and "unanimous" or (even >= 1 and "majority" or "split") }
	end
	res.text = Judging.METHOD_TEXT[res.method]
	res.scores = Judging.ScoreStrings(cards, res.outcome)
	return res
end

-- the cards as the announcer reads them: the winner's total first ("116-112"); a draw reads the red corner first
function Judging.ScoreStrings(cards, outcome)
	local list = {}
	for _, c in ipairs(cards or {}) do
		local a, b = num(c[1]), num(c[2])
		if outcome == "loss" or (outcome ~= "win" and b > a) then
			a, b = b, a
		end
		table.insert(list, fmtRound(a, b))
	end
	return list
end

------------------------------------------------------------------------
-- the ring announcer (PostFight's script; the client shows the same lines on the same beats)
------------------------------------------------------------------------
local function mmss(sec)
	sec = math.max(0, math.floor(num(sec)))
	return string.format("%d:%02d", math.floor(sec / 60), sec % 60)
end

-- res = the red corner's result ({ outcome, method, round, reason, cards, kdFor/kdAgainst }), names = { red, blue },
-- info = { rounds = n, time = seconds into the end round (a stoppage), title = ceremony spec or nil, champion =
-- "red" | "blue" | nil (the belt holder coming in), kind = the bout's kind }
-- -> { lines = { { at = seconds, text = "...", kind = "intro" | "card" | "method" | "winner" | "draw" } }, dur = seconds,
--      raiseAt = the beat the hand goes up, winner = "red" | "blue" | nil, stoppage = bool }
function Judging.Announce(res, names, info)
	res = res or {}
	names = names or {}
	info = info or {}
	local red, blue = names[1] or names.red or "the red corner", names[2] or names.blue or "the blue corner"
	local winner = res.outcome == "win" and "red" or (res.outcome == "loss" and "blue" or nil)
	local wName = winner == "red" and red or blue
	local lName = winner == "red" and blue or red
	local method = res.method or "UD"
	local stoppage = method == "KO" or method == "TKO" or method == "RTD" or method == "DQ"
	local lines = {}
	local t = 0.4
	local function say(text, kind, dt)
		table.insert(lines, { at = t, text = text, kind = kind or "intro" })
		t += dt or 3.0
	end
	local rounds = num(info.rounds)
	say("Ladies and gentlemen...", "intro", 2.0)
	if stoppage then
		local when = info.time and mmss(info.time) or nil
		local rnd = num(res.round) > 0 and num(res.round) or rounds
		if method == "KO" then
			say(string.format("The referee stops the contest at %s of round %d.", when or "the count", rnd), "method", 3.2)
			say(string.format("The winner, by KNOCKOUT... %s!", string.upper(wName)), "winner", 4.0)
		elseif method == "TKO" then
			local why = (res.reason and res.reason ~= "" and res.reason:find("octor")) and "on the advice of the ringside physician" or "to save his man"
			say(string.format("The referee stops the contest at %s of round %d, %s.", when or "the bell", rnd, why), "method", 3.6)
			say(string.format("The winner, by TECHNICAL KNOCKOUT... %s!", string.upper(wName)), "winner", 4.0)
		elseif method == "RTD" then
			say(string.format("%s retires on his stool at the end of round %d.", lName, rnd), "method", 3.2)
			say(string.format("The winner, by RETIREMENT... %s!", string.upper(wName)), "winner", 4.0)
		else
			say(string.format("The referee disqualifies %s in round %d.", lName, rnd), "method", 3.2)
			say(string.format("The winner, by DISQUALIFICATION... %s!", string.upper(wName)), "winner", 4.0)
		end
	else
		say(string.format("After %d rounds of boxing, we go to the judges' scorecards.", rounds > 0 and rounds or num(res.round)), "intro", 3.0)
		local scores = res.scores or Judging.ScoreStrings(res.cards or {}, res.outcome)
		local cards = res.cards or {}
		if res.outcome == "draw" then
			for j, s in ipairs(scores) do
				local c = cards[j] or { 0, 0 }
				local who = num(c[1]) > num(c[2]) and red or (num(c[2]) > num(c[1]) and blue or nil)
				say(string.format("Judge %d scores the bout %s%s.", j, s, who and (" for " .. who) or ", even"), "card", 2.6)
			end
			say(string.format("This bout is declared a %s DRAW.", string.upper(res.drawKind or "")), "draw", 4.0)
		else
			local pre = {}
			for j = 1, math.max(#cards, #scores) do
				local c = cards[j]
				local a, b = c and num(c[1]) or 0, c and num(c[2]) or 0
				local forWinner, even
				if c then
					forWinner = (winner == "red" and a > b) or (winner == "blue" and b > a)
					even = a == b
				else
					forWinner = true
					even = false
				end
				-- the card is read with the named man's total first (the loser's on a card he won)
				local s
				if c then
					local w1, w2 = (winner == "red") and a or b, (winner == "red") and b or a
					s = forWinner and fmtRound(w1, w2) or fmtRound(w2, w1)
				else
					s = scores[j]
				end
				pre[j] = { s = s, forWinner = forWinner, even = even }
			end
			-- the announcer reads the dissenting card first and saves the winner's name for the end
			local order = {}
			for j = 1, #pre do
				table.insert(order, j)
			end
			table.sort(order, function(x, y)
				local ax, ay = pre[x].forWinner and 1 or 0, pre[y].forWinner and 1 or 0
				if ax ~= ay then
					return ax < ay
				end
				return x < y
			end)
			local read = 0
			for _, j in ipairs(order) do
				local p = pre[j]
				read += 1
				local last = read == #order
				local text
				if p.even then
					text = string.format("Judge %d scores it %s, even.", j, p.s)
				elseif not p.forWinner then
					text = string.format("Judge %d scores the bout %s for %s.", j, p.s, lName)
				elseif last then
					text = string.format("%s %s, for the winner...", method == "UD" and "All three judges score it" or ("And judge " .. j .. " scores it"), p.s)
				else
					text = string.format("Judge %d scores it %s...", j, p.s)
				end
				say(text, "card", last and 3.0 or 2.6)
			end
			local how = method == "UD" and "UNANIMOUS DECISION" or (method == "SD" and "SPLIT DECISION" or "MAJORITY DECISION")
			local title = ""
			if info.title and info.title.title and winner then
				title = (info.champion == winner) and (" ...and STILL " .. string.upper(info.title.title) .. "...") or (" ...and NEW " .. string.upper(info.title.title) .. "...")
			end
			say(string.format("...by %s%s %s!", how, title, string.upper(wName)), "winner", 4.0)
		end
	end
	local raiseAt = t - 4.0
	for _, l in ipairs(lines) do
		if l.kind == "winner" or l.kind == "draw" then
			raiseAt = l.at
		end
	end
	return { lines = lines, dur = t + 1.0, raiseAt = raiseAt, winner = winner, stoppage = stoppage }
end

------------------------------------------------------------------------
-- the fight's report (the results screen): the per-round cards and the stats
------------------------------------------------------------------------
-- rounds = { Judging.Score results in order }, totals = { red = side, blue = side } -> a plain table safe to send
function Judging.Report(rounds, cards, totals, flip)
	local rep = { rounds = {}, cards = {}, totals = {} }
	for r, round in ipairs(rounds or {}) do
		local entry = { cards = {}, judges = {}, kd = { num(round.kd and round.kd[1]), num(round.kd and round.kd[2]) } }
		for j, c in ipairs(round.cards or {}) do
			entry.cards[j] = flip and { c[2], c[1] } or { c[1], c[2] }
			local jd = round.judges and round.judges[j]
			entry.judges[j] = jd and { id = jd.id, reason = jd.reason, diff = flip and -num(jd.diff) or num(jd.diff) } or nil
		end
		if flip then
			entry.kd = { entry.kd[2], entry.kd[1] }
		end
		rep.rounds[r] = entry
	end
	for j, c in ipairs(cards or {}) do
		rep.cards[j] = flip and { num(c[2]), num(c[1]) } or { num(c[1]), num(c[2]) }
	end
	local function plain(S)
		local o = {}
		for k, v in pairs(S or {}) do
			if type(v) == "number" then
				o[k] = math.floor(v * 100) / 100
			elseif type(v) == "table" then
				o[k] = table.clone(v)
			end
		end
		return o
	end
	rep.totals.you = plain(flip and totals.blue or totals.red)
	rep.totals.opp = plain(flip and totals.red or totals.blue)
	for j, judge in ipairs(Judging.JUDGES) do
		rep.judgeNames = rep.judgeNames or {}
		rep.judgeNames[j] = { name = judge.name, lean = judge.lean }
	end
	return rep
end

return Judging
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="101">
        <Properties>
          <string name="Name">MapBuilder</string>
          <string name="Source"><![CDATA[-- MapBuilder: builds the training complex entirely from parts.
-- Gym zones: Boxing Area, Weight Room, Cardio Room, Recovery Area, Barber Shop,
-- Locker Room, Nutrition Bar, Bunk Room, lobby with Fight Board & trophy case.
-- Outside: roadwork loop with checkpoints, swimming pool annex (real water).
-- Equipment visuals per upgrade level are drawn client-side (GymVisuals) at each
-- station's Base; the server provides the anchors, use points and prompts.
local Lighting = game:GetService("Lighting")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Signage = require(Shared:WaitForChild("Signage"))
local Typography = require(Shared:WaitForChild("Typography"))
local GymDecor = require(script.Parent:WaitForChild("GymDecor"))
local CityKit = require(script.Parent:WaitForChild("CityKit"))
local CityMap = require(script.Parent:WaitForChild("CityMap"))

local MapBuilder = {}

local V3 = Vector3.new
local CF = CFrame.new

local function part(parent, props)
	local p = Instance.new(props.Class or "Part")
	p.Anchored = true
	-- nothing in the game listens for touches: a map part that reports none costs the physics less
	p.CanTouch = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		if k ~= "Class" then
			p[k] = v
		end
	end
	p.Parent = parent
	return p
end

local function deco(parent, name, size, cf, color, material, extra)
	local props = { Name = name, Size = size, CFrame = cf, Color = color, Material = material or Enum.Material.SmoothPlastic }
	for k, v in pairs(extra or {}) do
		props[k] = v
	end
	return part(parent, props)
end

local function label(adornee, text, color, offsetY, maxDist)
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(240, 46)
	bb.StudsOffset = V3(0, offsetY or 4, 0)
	bb.MaxDistance = maxDist or 70
	bb.Adornee = adornee
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Text = text
	Typography.Apply(t, "sign")
	t.TextScaled = true
	t.TextColor3 = color or Color3.new(1, 1, 1)
	t.TextStrokeTransparency = 0.3
	t.Parent = bb
	bb.Parent = adornee
	return bb
end

-- a whole-face text sign. The density follows the face's height: the engine draws text at 100 px at most,
-- so a tall board at 40 px per stud kept its words a third of its height (the 7-stud banner, the zone signs)
local function sign(p, face, text, bg, fg)
	local sg = Instance.new("SurfaceGui")
	sg.Face = face
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	local _, fh = Signage.FaceDims(p.Size, face)
	sg.PixelsPerStud = math.min(40, Signage.PPS(fh, 0.8))
	sg.LightInfluence = 0
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundColor3 = bg or Color3.fromRGB(15, 15, 18)
	t.BackgroundTransparency = bg and 0 or 1
	t.TextColor3 = fg or Color3.fromRGB(255, 200, 40)
	Typography.Apply(t, "sign")
	t.TextScaled = true
	t.Text = text
	t.Parent = sg
	sg.Parent = p
	return t
end

local function prompt(p, actionText, objectText, attrs)
	local pp = Instance.new("ProximityPrompt")
	pp.ActionText = actionText
	pp.ObjectText = objectText
	pp.HoldDuration = 0
	pp.MaxActivationDistance = 9
	pp.RequiresLineOfSight = false
	for k, v in pairs(attrs) do
		pp:SetAttribute(k, v)
	end
	pp.Parent = p
	return pp
end

