		logo = { bg = { 30, 30, 30 }, fg = { 240, 110, 20 }, text = "IRON", glyph = "SUPPS" }, shop = "IRON SUPPLEMENTS" },
	{ id = "FuelAndGo", name = "Fuel & Go", scope = "Local", minTier = 3, minPop = 10, perFight = 2500, winBonus = 1000, koBonus = 1500, fights = 5, slot = "corner",
