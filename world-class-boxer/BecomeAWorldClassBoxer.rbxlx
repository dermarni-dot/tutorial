-- the rig diagnostic (Shared.Diag; "/wcbdiag" in chat or the Settings button): the server's view of the player's
-- character and the nearest NPCs, printed to the server Output (in Studio the same window) and answered as blocks for
-- the client to print. Read-only, allowed anywhere (a fight, an activity, before the boxer is created)
local Diag = require(Shared.Diag)
local function runDiag(player, names)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local center = root and root.Position or Vector3.zero
	local models = Diag.Pick(center, char, 2)
	-- the client's picks by name when they are not the nearest to the server (it may stand somewhere else by now)
	if type(names) == "table" then
		local have = {}
		for _, m in ipairs(models) do
			have[m.Name] = true
		end
		for _, n in ipairs(names) do
			if type(n) == "string" and not have[n] then
				local m = workspace:FindFirstChild(n, true)
				if m and m:IsA("Model") and m:FindFirstChildOfClass("Humanoid") then
					table.insert(models, m)
					have[n] = true
				end
			end
		end
	end
	local BT = require(Shared.BuilderTiers)
	local BH = require(Shared.BuilderHead)
	local blocks = {}
	local head = string.format("%sv%d SERVER report for %s: %d model(s); body part swaps refused on the server: %d, classic head swaps refused: %d; swaps done %d, template loads %d (failed %d); staging=%s",
		Diag.PREFIX, Diag.VERSION, player.Name, #models, BT.SwapFailures, BH.SwapFailures, BT.Stats().swaps, BT.Stats().loads, BT.Stats().failed,
		tostring(Builder.StageFolder and Builder.StageFolder()))
	print(head)
	table.insert(blocks, head)
	for i, m in ipairs(models) do
		local ok, lines = pcall(Diag.Report, m, { label = m == char and "LOCAL" or ("NPC" .. i - (char and 1 or 0)), side = "server" })
		local block = ok and Diag.Block(lines) or (Diag.PREFIX .. "server report failed on " .. m.Name .. ": " .. tostring(lines))
		print(block)
		table.insert(blocks, block)
	end
	-- a live fight: the engine's view (Shared.Diag's FIGHT block: modes, ranges, the separation, the AI's last decisions)
	local fight = FightEngine.Active and FightEngine.Active[player]
	if fight then
		local okF, flines = pcall(Diag.FightLines, fight)
		local block = okF and Diag.Block(flines) or (Diag.PREFIX .. "FIGHT report failed: " .. tostring(flines))
		print(block)
		table.insert(blocks, block)
	end
	return blocks
end
handlers.Diag = function(player, _profile, names)
	return { ok = true, lines = runDiag(player, names) }
end

local PRE_CREATE = { GetProfile = true, Diag = true, CreateBoxer = true, NewCareer = true, PreviewLook = true, GetLegacy = true, SaveSettings = true,
	StartTutorial = true, SkipTutorial = true }
local READ_ONLY = { GetProfile = true, Diag = true, GetRankings = true, GetBoxer = true, PreviewLook = true, GetOffers = true, GetRivals = true, GetLegacy = true, GetPvP = true, GetMuscleHistory = true }
-- (PvPQueue / PvPCancel / PvPRespond may be sent mid-drill: leaving the queue, cancelling, declining)
local DURING_ACTIVITY = { FinishActivity = true, Diag = true, CancelActivity = true, Eat = true, SaveSettings = true, PvPQueue = true, PvPCancel = true, PvPRespond = true }
-- actions that change nothing the summary shows: no push afterwards (R-ui)
local NO_PUSH = { SaveSettings = true }
-- allowed in the ring too: the Settings screen opens mid-fight and its save is never retried
local IN_RING = { SaveSettings = true, Diag = true }

-- per-player rate limit on the whole remote: a token bucket (RATE.perSecond refilled, RATE.burst deep).
-- A legit client never gets near it (the Creator's previews are 4 / s, everything else is a click);
-- a looping exploit client gets { throttled = true } and costs the server nothing but this table
local RATE = { perSecond = 12, burst = 24 }
local buckets = {}
local function rateOk(player)
	local now = os.clock()
	local b = buckets[player]
	if not b then
		b = { tokens = RATE.burst, at = now }
		buckets[player] = b
	end
	b.tokens = math.min(RATE.burst, b.tokens + (now - b.at) * RATE.perSecond)
	b.at = now
	if b.tokens < 1 then
		return false
	end
	b.tokens -= 1
	return true
end

Request.OnServerInvoke = function(player, action, ...)
	if not rateOk(player) then
		return { ok = false, throttled = true, err = "Slow down." }
	end
	local profile = DataManager.Get(player)
	if not profile then
		return { ok = false, err = "Loading..." }
	end
	local h = type(action) == "string" and handlers[action]
	if not h then
		return { ok = false, err = "Unknown action" }
	end
	if not PRE_CREATE[action] and not profile.created then
		return { ok = false, err = "Create your boxer first." }
	end
	local b = busy[player]
	if (b == "fight" or b == "spar" or b == "pvp") and not READ_ONLY[action] and not IN_RING[action] then
		return { ok = false, err = "You're in the ring!" }
	end
	if b == "activity" and not READ_ONLY[action] and not DURING_ACTIVITY[action] then
		return { ok = false, err = "Finish your current exercise first." }
	end
	local ok, res = pcall(h, player, profile, ...)
	if not ok then
		warn("[Boxer] handler error", action, res)
		return { ok = false, err = "Server error" }
	end
	-- a rejected action changed nothing: no summary to build and send for it
	local rejected = type(res) == "table" and res.ok == false
	if not READ_ONLY[action] and not NO_PUSH[action] and not rejected then
		task.defer(push, player)
	end
	return res
end

FightRemote.OnServerEvent:Connect(function(player, msg)
	if type(msg) == "table" and msg.t == "tutorialSkip" then
		-- SKIP TUTORIAL during the tutorial bout: call it off (runTutorial sets the flag); ignored otherwise
		local w = tutorialWatch[player]
		if w then
			w.skipped = true
			FightEngine.Abort(player)
		elseif fightWatch[player] and fightWatch[player].debut then
			-- the debut's SKIP GUIDE: the guide stops, the fight goes on
			FightEngine.EndGuide(player)
		end
		return
	end
	FightEngine.Input(player, msg)
end)

------------------------------------------------------------------------
-- Players
------------------------------------------------------------------------
-- [Studio] the Avatar Joint Upgrade's AnimationConstraint joints back to Motor6Ds on every humanoid rig in Workspace
-- (player characters, the gym members, opponents, referees, the crowd): whenever a constraint named as an R15 joint
-- appears under a model with a Humanoid, that model is converted (deferred: the engine finishes building it first) and
-- watched for later ones (ApplyDescription and ReplaceBodyPartR15 make new ones). Shared.RigJoints says why.
local RigJoints = require(Shared:WaitForChild("RigJoints"))
local function rigModelOf(inst)
	local m = inst:FindFirstAncestorOfClass("Model")
	while m do
		if m:FindFirstChildOfClass("Humanoid") then
			return m
		end
		m = m:FindFirstAncestorOfClass("Model")
	end
	return nil
end
local jointsQueued = setmetatable({}, { __mode = "k" })
local function queueMotors(inst)
	-- (by class only: a constraint may be named after it is parented; EnsureMotors picks the R15 joints by name)
	if not inst:IsA("AnimationConstraint") then
		return
	end
	local m = rigModelOf(inst)
	if not m or jointsQueued[m] then
		return
	end
	jointsQueued[m] = true
	task.defer(function()
		jointsQueued[m] = nil
		if m.Parent then
			local okM, errM = pcall(RigJoints.WatchMotors, m)
			if not okM then
				warn("[Boxer] could not rebuild the joints of " .. m.Name .. " as Motor6Ds: " .. tostring(errM))
			end
		end
	end)
end
workspace.DescendantAdded:Connect(queueMotors)
for _, d in ipairs(workspace:GetDescendants()) do
	queueMotors(d)
end
local motorsReported = false

local function onCharacter(player, char)
	endSession(player, true)
	local hum = char:WaitForChild("Humanoid", 10)
	-- the upgrade's AnimationConstraints -> Motor6Ds before anything animates or dresses the rig (and again whenever
	-- the engine makes new ones); one Output line the first time, so the user can see it happened
	do
		local kind0 = RigJoints.Kind(char)
		local okM, errM = pcall(RigJoints.WatchMotors, char)
		if not okM then
			warn("[Boxer] could not rebuild " .. char.Name .. "'s joints as Motor6Ds: " .. tostring(errM))
		elseif kind0 == "AnimationConstraint" or kind0 == "mixed" then
			if not motorsReported then
				motorsReported = true
				local nm, na = RigJoints.Count(char)
				print(string.format("[Boxer] %s spawned with Avatar Joint Upgrade joints (AnimationConstraints): rebuilt as Motor6Ds (%d Motor6D / %d left). "
					.. "To stop this at the source set StarterPlayer > AvatarJointUpgrade = Disabled in this place's Properties.", char.Name, nm, na))
			end
		end
	end
	if hum then
		-- the town pace is a walk (StarterPlayer's CharacterWalkSpeed says so too); Shift runs (FightClient)
		hum.WalkSpeed = Config.TownWalkSpeed
		-- [Studio] the engine clones its Animate LocalScript into the character on every spawn; the client Animator
		-- disables it, but the server's view (and the diagnostic) still showed it ENABLED with no ProcAnim: disabled
		-- here too - the Disabled flag replicates - and ProcAnim set server-side, so every view agrees the joints are
		-- the Animator's. RequiresNeck off: a head swap / headgear rebuild / ragdoll that leaves the Neck joint out for a
		-- frame would otherwise kill the character (state Dead, BreakJointsOnDeath: every joint gone - seen in Studio)
		pcall(function()
			hum.RequiresNeck = false
		end)
		char:SetAttribute("ProcAnim", true)
		task.spawn(function()
			local an = char:FindFirstChild("Animate") or char:WaitForChild("Animate", 5)
			if an and an:IsA("LuaSourceContainer") and char.Parent then
				an.Disabled = true
			end
		end)
		hum.Died:Connect(function()
			if sessions[player] then
				endSession(player, true)
			end
		end)
	end
	task.wait(0.3)
	local profile = DataManager.Get(player)
	if profile and profile.created and not profile.retired then
		applyLook(player)
	elseif profile then
		applyLook(player, Looks.Defaults(1)) -- a lean starter look while the creator is open
	end
end

-- a career whose load failed at join arrived on a retry: show it and dress the character
DataManager.OnLoaded = function(player)
	if not player.Parent then
		return
	end
	push(player)
	if player.Character then
		onCharacter(player, player.Character)
	end
end

-- a refused save found a newer copy of the career saved on another server, and the player plays on from it
-- (what was done here since the join is replaced): show it, dress the character, and say why it changed
DataManager.OnRefreshed = function(player)
	DataManager.OnLoaded(player)
	if player.Parent then
		Notify:FireClient(player, { t = "toast", text = "Your career was updated from another server." })
	end
end

local function onPlayer(player)
	player.CharacterAdded:Connect(function(char)
		onCharacter(player, char)
	end)
	-- "/wcbdiag" in chat: the server's rig report (the client prints its own on the same command)
	player.Chatted:Connect(function(msg)
		if type(msg) == "string" and msg:lower():sub(1, 8) == "/wcbdiag" then
			task.spawn(function()
				local ok, err = pcall(runDiag, player, nil)
				if not ok then
					warn("[WCBDIAG] server report failed:", err)
				end
			end)
		end
	end)
	player.CharacterRemoving:Connect(function()
		endSession(player, true)
	end)
	DataManager.Load(player)
	if not player.Parent then
		return
	end
	if player.Character then
		task.spawn(onCharacter, player, player.Character)
	end
	push(player)
end

Players.PlayerAdded:Connect(onPlayer)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayer, player)
end

-- the fight venues' templates (8.6k instances in ServerStorage, about a fifth of the boot's Lua) are built
-- off the boot's critical path: the first player's profile load is already in flight when they start,
-- and the gym room's sparring athletes (spawned in their own thread) are long in place before anyone can
-- spar. A fight that came first would have built them in Venues.New already. Paced (a frame between templates and
-- their big pieces): built in one step, the 8.6k instances held up every frame of the join meanwhile
task.delay(3, function()
	if not game:GetService("ServerStorage"):FindFirstChild("Venue_Arena") then
		Venues.BuildTemplates(true)
	end
end)

Players.PlayerRemoving:Connect(function(player)
	-- leaving a career bout: record it (the real result if it was already announced, else a forfeit
	-- after the opening bell) BEFORE the leave save. A server shutdown is not the player's doing.
	local watch = fightWatch[player]
	if watch then
		local ok, err = pcall(function()
			-- (a debut left mid-bout is not fought: no forfeit, its camp dropped before the leave save)
			local res = watch.decided or (not shuttingDown and not watch.debut and quitResult(player)) or nil
			settleFight(player, watch, res)
			if watch.debut then
				if watch.settled then
					Tutorial.MarkDebut(watch.profile, "completed")
				else
					cancelDebut(watch.profile, watch)
				end
			end
		end)
		if not ok then
			warn("[Boxer] fight settle on leave:", err)
		end
	end
	-- a PvP bout goes on for the other corner (a forfeit) or is called off by pvpOnLeave itself
	local inPvP = pvpWatch[player] ~= nil
	local okPvP, errPvP = pcall(pvpOnLeave, player)
	if not okPvP then
		warn("[Boxer] PvP leave:", errPvP)
	end
	-- leaving mid-tutorial: the bout is aborted (the engine's Cleanup takes the arena, the opponent and the
	-- referee with it) and runTutorial records nothing
	local tw = tutorialWatch[player]
	if tw then
		tw.left = true
		tutorialWatch[player] = nil
	end
	if not inPvP then
		FightEngine.Abort(player)
	end
	endSession(player, true)
	busy[player] = nil
	if customizing[player] == "barber" then
		Ambient.SetLoop("Barber", "idle") -- the shared barber NPC stops cutting for an empty chair
	end
	customizing[player] = nil
	lookState[player] = nil
	AvatarLook.Forget(player.UserId)
	lastPreview[player] = nil
	lastSim[player] = nil
	buckets[player] = nil
	sweatState[player] = nil
	for id, p in pairs(occupied) do
		if p == player then
			occupied[id] = nil
		end
	end
	DataManager.Release(player)
end)

game:BindToClose(function()
	shuttingDown = true
	-- save everyone in parallel so the retries fit the shutdown budget, then wait for the leave saves
	local left = 0
	for _, player in ipairs(Players:GetPlayers()) do
		left += 1
		task.spawn(function()
			DataManager.Save(player, true)
			left -= 1
		end)
	end
	local t0 = os.clock()
	while left > 0 and os.clock() - t0 < 25 do
		task.wait(0.25)
	end
	DataManager.WaitForReleases(25 - (os.clock() - t0))
end)

task.spawn(function()
	while true do
		task.wait(120)
		for _, player in ipairs(Players:GetPlayers()) do
			if not busy[player] then
				DataManager.Save(player)
			end
		end
	end
end)

print("[Boxer] " .. Config.GameName .. " server ready")
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="114">
    <Properties>
			<token name="AvatarJointUpgrade_SerializedRollout">1</token>
      <string name="Name">StarterPlayer</string>
      <float name="CharacterWalkSpeed">6.5</float>
      <bool name="EnableMouseLockOption">false</bool>
    </Properties>
    <Item class="StarterPlayerScripts" referent="115">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="116">
        <Properties>
          <string name="Name">Animator</string>
          <string name="Source"><![CDATA[-- Animator: motion-capture-feeling procedural animation for everyone in the game, no animation
-- assets. Drives the R15 joints' Transform (classic Motor6D joints and AnimationConstraint avatar
-- joints) every frame in PreSimulation. The motion lives in modules (BoxerClient):
--  * AnimLoco  - root-motion sensing, gait cycles (walk / run / sprint, boxing step-drag, gallop,
--                stagger), planted feet that never slide, turning in place, weight and momentum
--  * AnimFight - style stances that never stand still (seeded per boxer), kinetic-chain punches
--                with variants, defence, severity-scaled directional hit reactions, daze, clinch,
--                walkout / rest (on the stool) / win / lose
--  * AnimDown  - knockdowns by DownPose (flash, forward, side, back, face, knee, sit, ropes,
--                corner), knockouts by KOKind (one-punch timber fall, delayed, standing, crumple)
--                with a slow-motion beat and a ragdoll-like settle, the count, get-ups
--  * AnimGym   - training poses, flex poses, gym members' loops, watchers, the referee's stance
--  * AnimRig / AnimKit - rig geometry, IK, springs, math
-- Who is animated: tag "Fighter" (fights), "Trainee" (Pose), "Ambient" (Loop), "Referee",
-- "Preview" (the Creator), and every player character (walking / running / jumping around the
-- world; while a player is climbing, swimming or dead the default animation shows through).
-- Other players' training punches are re-synthesized locally and published as client-local
-- AutoAct / AutoActId so the gym's bags react (CONTRACTS section 7).
-- Faces (blinks, gaze, expressions), muscles (contraction, pump, jiggle, veins) and hair (spring
-- physics) live in BoxerClient.FaceFX / HairFX; this script drives them every frame.
-- [Studio] It checks that its writes take effect (selfCheck: the limbs' real pose against the pose written) and falls back
-- to Roblox's own animation for a rig whose joints ignore them; Output says so ("[Animator] running: ...",
-- "[Animator] joint writes are not taking effect on ...").
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")

local player = Players.LocalPlayer
-- [Studio] the modules folder: a place the code was pasted into may not have it under this name - said in Output, never a
-- silent hang (the Animator would drive nothing and the bodies would walk in the bind pose)
local Modules = script.Parent:WaitForChild("BoxerClient", 10)
if not Modules then
	warn("[Animator] NOT running yet: " .. script.Parent:GetFullName() .. ".BoxerClient (the client modules folder, src/client/modules) is missing; "
		.. "waiting for it. Sync with Rojo (default.project.json) or name the folder BoxerClient")
	Modules = script.Parent:WaitForChild("BoxerClient")
end
local K = require(Modules:WaitForChild("AnimKit"))
local R = require(Modules:WaitForChild("AnimRig"))
local Loco = require(Modules:WaitForChild("AnimLoco"))
local Fight = require(Modules:WaitForChild("AnimFight"))
local Down = require(Modules:WaitForChild("AnimDown"))
local Gym = require(Modules:WaitForChild("AnimGym"))

-- the FX modules are optional: the body animation must keep running if one of them fails
local function optional(name)
	local ok, mod = pcall(function()
		return require(Modules:WaitForChild(name, 10))
	end)
	if ok and type(mod) == "table" then
		return mod
	end
	warn("[Animator] " .. name .. " unavailable: " .. tostring(mod))
	return nil
end
-- (BodyFX, the organic body's flex / pump / jiggle, is retired with the organic body: the muscle-tier parts are
-- rigid; FaceFX is the classic face's expression swap)
local FaceFX = optional("FaceFX")
local HairFX = optional("HairFX")
R.setFX({ FaceFX = FaceFX, HairFX = HairFX })
-- [Entrance] the ring walk's celebrations / climbs / ride on the crowd's shoulders (BoxerClient.AnimEntrance)
local Entrance = optional("AnimEntrance")

local A = CFrame.Angles
local CF = CFrame.new
local I = CFrame.identity
local V3 = Vector3.new
local PI = math.pi
local sin, abs, max, min, exp, sqrt, atan2, floor = math.sin, math.abs, math.max, math.min, math.exp, math.sqrt, math.atan2, math.floor
local clamp = math.clamp
local smooth = K.smooth
local num = R.num

local KEYS, LEG_KEYS = R.KEYS, R.LEG_KEYS
-- the arm joints a punch drives, and the fastest any of them may turn while it does (rad/s)
local ARM_KEYS = { LS = true, LE = true, LW = true, RS = true, RE = true, RW = true }
-- a walker's swinging arm joints and where their post-filter transform is kept
local ARM_OUT = { LS = "lsOut", LE = "leOut", RS = "rsOut", RE = "reOut", LW = "lwOut", RW = "rwOut" }
local PUNCH_JOINT_RATE = 60
-- a fighter's arms: the base filter's rate x this (the guard tracks its spots on the trunk)
local GUARD_ARM_RATE = 2.5
local TAGS = { "Fighter", "Trainee", "Ambient", "Preview", "Referee" }
-- player characters walk / run / jump with the procedural gait (false = Roblox's default Animate)
local DRIVE_PLAYERS = true
local rigs = {}
local nextSlot = 0 -- (the last rig's turn in the reduced-rate frame cycle: setup)
Gym.init(rigs)
R.rigs = rigs -- read-only handle for tools / tests (the animation lab inspects foot states)
local POSE = Gym.POSE
local PUNCHES = Gym.PUNCHES

-- LOD bands (studs from the camera) per Graphics level (BoxerClient.Perf: 1 Low, 2 Medium, 3 High). High is
-- the full look; your own character and the fighters use High's bands at every level. Past near: no gaze
-- detail and the far legs (a punch still finds its target up to mid); past mid / far: every 2nd / 3rd frame;
-- past cull: not animated. off = the frame step off screen; still = the step for a still background figure on
-- screen from stillFrom (near when not given) out, stillOff = off screen (see the main loop)
local BANDS = {
	{ near = 25, mid = 60, far = 80, cull = 140, off = 6, still = 3, stillOff = 8 },
	{ near = 30, mid = 60, far = 90, cull = 150, off = 6, still = 2, stillOff = 8, stillFrom = 15 },
	{ near = 45, mid = 110, far = 170, cull = 230, off = 4, still = 2, stillOff = 6 },
}
local HIGH = BANDS[3]
local band = HIGH
do
	local ok, Perf = pcall(function()
		return require(Modules:FindFirstChild("Perf"))
	end)
	if ok and type(Perf) == "table" and Perf.Level and Perf.Changed then
		local function pick()
			band = BANDS[math.clamp(tonumber(Perf.Level()) or 3, 1, 3)]
		end
		pick()
		Perf.Changed:Connect(pick)
	end
end

-- which exercise (Config.ExerciseTargets / Activities id) a pose works: BodyFX contraction + LivePump
local POSE_ACT = {
	bench = "Bench", curl = "Dumbbells", deadlift = "Barbell", squat = "Squat", pullup = "PullUps", medball = "MedBall",
	row = "Rower", run = "Treadmill", bike = "Bike", rope = "Rope", ladder = "Ladder", heavybag = "HeavyBag",
	speedbag = "SpeedBag", guard = "Shadow", shadow = "Shadow", spar = "Sparring",
}

------------------------------------------------------------------------
-- Rig registry: tags, cached attributes (signals, not per-frame polling), act parsing
------------------------------------------------------------------------
local function hasAnyTag(model)
	for _, tag in ipairs(TAGS) do
		if CollectionService:HasTag(model, tag) then
			return true
		end
	end
	return false
end

local function isPlayerChar(model)
	return DRIVE_PLAYERS and Players:GetPlayerFromCharacter(model) ~= nil
end

local onAct -- forward declaration (acts section)
local heartbeat, stopFallback, localMotors -- forward declarations (self-check section)
local RigJoints = R.RigJoints

local function readTags(rig)
	local m = rig.model
	rig.isFighter = CollectionService:HasTag(m, "Fighter")
	rig.isTrainee = CollectionService:HasTag(m, "Trainee")
	rig.isAmbient = CollectionService:HasTag(m, "Ambient")
	rig.isPreview = CollectionService:HasTag(m, "Preview")
	rig.isReferee = CollectionService:HasTag(m, "Referee")
	rig.isTagged = rig.isFighter or rig.isTrainee or rig.isAmbient or rig.isPreview or rig.isReferee
end

local function onAttr(rig, name)
	local model = rig.model
	local v = model:GetAttribute(name)
	local old = rig.a[name]
	rig.a[name] = v
	local now = rig.clock
	if name == "ActId" then
		if v ~= nil and v ~= rig.lastActId then
			rig.lastActId = v
			onAct(rig, model:GetAttribute("Act"), now, false)
		end
	elseif name == "PredActId" then
		if v ~= nil and v ~= rig.predId then
			rig.predId = v
			onAct(rig, model:GetAttribute("PredAct"), now, true)
		end
	elseif name == "Guard" then
		if v ~= old then
			rig.prevGuard = old
			rig.guardT = now
			if old == "down" then
				-- up again without the server's get-up act (the end of a fight, an older server): he still
				-- gets up off the canvas the way he fell instead of popping upright
				local d = rig.down
				if d and not (rig.act and rig.act.kind == "getup") then
					rig.act = Down.recoverAct(d, now)
				end
				Down.clear(rig)
			end
		end
	elseif name == "Pose" or name == "Loop" then
		if v ~= old then
			rig.poseT = now
			rig.combo = nil
			rig.nextLook = 0 -- re-target now (bag on / off, watchers)
		end
	elseif name == "Count" then
		rig.countT = now
	elseif name == "ScaleKey" or name == "BodyTiers" then
		-- the body was rescaled (ApplyDescription): re-measure the legs now (and once more when the
		-- replicated joints have surely arrived), never plant the feet at the old floor height
		rig.geoNow = true
	elseif name == "ShoutAt" then
		-- Ambience (F) just put a chat bubble over this coach: open the mouth now, and cup a hand by
		-- it when the arms are free (updateRig)
		rig.shoutReq = now
		if FaceFX then
			FaceFX.Shout(model, 1.1)
		end
	end
end

-- AnatomyClient puts the organic shoes on (or takes them off) when it builds a body: the feet's roll profile
-- and ankle height are re-measured at once (computeGeo: g.meshFeet), never up to 2.5 s of the box foot's toe
-- rolling under the longer shoe at a walk's start
local function feetChanged(rig, child)
	local n = child.Name
	if n == "AnatomyRightFoot" or n == "AnatomyLeftFoot" then
		rig.geoNow = true
	end
end

local function watchAnatomy(rig, folder)
	if rig.anatConns then
		for _, c in ipairs(rig.anatConns) do
			c:Disconnect()
		end
	end
	rig.anatConns = {
		folder.ChildAdded:Connect(function(c)
			feetChanged(rig, c)
		end),
		folder.ChildRemoved:Connect(function(c)
			feetChanged(rig, c)
		end),
	}
	rig.geoNow = true
end

------------------------------------------------------------------------
-- Roblox's own animation on player characters. The Animate script (walk / run / idle / jump tracks) is a second
-- writer on the same joints: the engine applies its tracks to Transform in the animation step just before
-- PreSimulation, this script overwrites them right after, and on any frame we miss (an error in updateRig, a far rig's
-- skipped frame, the second between a part swap and the next resolve) Roblox's walk flashes through between two of
-- our poses - a shake. Other players' tracks replicate into their Animator here and are the same second writer. So for
-- every character we drive: its playing tracks are stopped as they start (AnimationPlayed), the local character's
-- Animate script is disabled (it would only start them again), and the model carries ProcAnim = true so the other
-- client scripts (State.SetAnimate, FightClient) leave it that way. Both come back while the rig is released
-- (climbing, swimming, dead: the default animation shows) and when the rig is torn down.
------------------------------------------------------------------------
-- is this rig's body ours this frame? (released: climbing / swimming / dead; fallback: our writes do not take effect
-- on it and Roblox's own animation plays instead - selfCheck)
local function drives(rig)
	return not rig.released and not rig.fallback
end

local function stopTracks(rig)
	local an = rig.animator
	if an and an.Parent then
		local ok, tracks = pcall(an.GetPlayingAnimationTracks, an)
		if ok then
			for _, tr in ipairs(tracks) do
				pcall(tr.Stop, tr, 0)
			end
		end
	end
end

local function applyAnimate(rig)
	local drive = drives(rig)
	local s = rig.animateScript
	if rig.isPlayer and s and s.Parent and s.Disabled ~= drive then
		s.Disabled = drive
	end
	if rig.isPlayer and rig.model.Parent and (rig.model:GetAttribute("ProcAnim") == true) ~= drive then
		rig.model:SetAttribute("ProcAnim", drive or nil)
	end
	if drive then
		stopTracks(rig)
	end
end

-- [Studio] any track playing on a rig we drive - even at weight 0 - makes the engine's animation step reset every joint's
-- Transform just before PreSimulation, so a frame we skip or lose shows the bind pose or Roblox's walk between two of
-- ours: a shake. Tracks reach a rig from its own Animate script (the local character: cloned in on EVERY spawn, and the
-- Humanoid / Animator can be replaced by Builder.Apply's ApplyDescription), from other players' replicated tracks, and
-- on NPCs from anything the server might play (it plays nothing: checked). So every rig with an Animator - players and
-- NPCs - gets AnimationPlayed hooked and its tracks stopped; a late Animator (it arrives after the Humanoid) is caught by
-- the Humanoid's ChildAdded; and a track found playing anyway on a later frame is stopped and reported once per rig
local function hookAnimate(rig)
	local hum = rig.hum
	if not (hum and hum.Parent) then
		hum = rig.model:FindFirstChildOfClass("Humanoid")
		rig.hum = hum
	end
	if hum ~= rig.hookedHum then
		if rig.humChildConn then
			rig.humChildConn:Disconnect()
		end
		rig.hookedHum = hum
		rig.humChildConn = hum and hum.ChildAdded:Connect(function(c)
			if c:IsA("Animator") then
				task.defer(function()
					if rigs[rig.model] == rig then
						hookAnimate(rig)
					end
				end)
			end
		end) or nil
	end
	local an = hum and hum:FindFirstChildOfClass("Animator")
	if an ~= rig.animator then
		if rig.animConn then
			rig.animConn:Disconnect()
		end
		rig.animator = an
		rig.animConn = an and an.AnimationPlayed:Connect(function(track)
			if drives(rig) then
				pcall(track.Stop, track, 0)
			end
		end) or nil
	end
	if not rig.isPlayer then
		applyAnimate(rig)
		return
	end
	local s = rig.model:FindFirstChild("Animate")
	if not (s and s:IsA("LuaSourceContainer")) then
		s = nil
	end
	if s ~= rig.animateScript then
		if rig.animateConn then
			rig.animateConn:Disconnect()
		end
		rig.animateScript = s
		-- (re-enabled by someone else while we drive: off again, on the next step)
		rig.animateConn = s and s:GetPropertyChangedSignal("Disabled"):Connect(function()
			if drives(rig) and s.Disabled == false and rigs[rig.model] == rig then
				task.defer(applyAnimate, rig)
			end
		end) or nil
	end
	applyAnimate(rig)
end

-- [Studio] a track that slipped past AnimationPlayed (started before the hook, replicated in a burst): polled every
-- POLL_TRACKS s, stopped, and reported once per rig so a /wcbdiag sample with ANIMATE ticks has a matching Output line
local POLL_TRACKS = 0.5
local function pollTracks(rig, t)
	if not drives(rig) or t < (rig.nextTrackPoll or 0) then
		return
	end
	rig.nextTrackPoll = t + POLL_TRACKS
	local an = rig.animator
	if not (an and an.Parent) then
		return
	end
	local ok, tracks = pcall(an.GetPlayingAnimationTracks, an)
	if ok and #tracks > 0 then
		for _, tr in ipairs(tracks) do
			pcall(tr.Stop, tr, 0)
		end
		if not rig.trackWarned then
			rig.trackWarned = true
			warn(string.format("[Animator] %s: %d animation track(s) were playing on a procedurally driven rig (stopped; they reset the joints every frame)",
				rig.model.Name, #tracks))
		end
	end
end

local function dropConns(rig)
	for _, k in ipairs({ "conn", "hipConn", "childConn", "humChildConn", "animConn", "animateConn", "descConn" }) do
		if rig[k] then
			rig[k]:Disconnect()
			rig[k] = nil
		end
	end
	for _, c in ipairs(rig.anatConns or {}) do
		c:Disconnect()
	end
	rig.anatConns = nil
end

local function setup(model)
	if not model:IsA("Model") then
		return
	end
	local rig = rigs[model]
	if rig then
		readTags(rig)
		return
	end
	-- the rig's seed (its persona, its swing: AnimFight): AnimSeed / AmbientSeed when the server sets one, else a hash
	-- of the whole name - every boxer moves his own way and the same on every client (the name's length alone gave
	-- every two boxers with names of one length the same persona)
	local seed = model:GetAttribute("AnimSeed") or model:GetAttribute("AmbientSeed")
	if type(seed) ~= "number" then
		local h = 13
		for i = 1, #model.Name do
			h = (h * 31 + string.byte(model.Name, i)) % 1000003
		end
		seed = h
	end
	rig = {
		model = model, joints = {}, geo = { ok = false }, a = {}, p = {}, kp = {}, kp2 = {},
		rng = Random.new(seed), seed = seed, phase = (seed % 100) / 100 * 6.28,
		root = model:FindFirstChild("HumanoidRootPart"), head = model:FindFirstChild("Head"),
		hum = model:FindFirstChildOfClass("Humanoid"),
		lastActId = model:GetAttribute("ActId"), predId = model:GetAttribute("PredActId"),
		act = nil, autoAct = nil, pending = nil, predKind = nil, predHand = nil, predT = -10, predDur = 0,
		sx = table.create(R.NSPR, 0), sv = table.create(R.NSPR, 0),
		plant = false, stepDist = 0.45, stepTime = 1, liftK = 1,
		cxL = {}, cxR = {}, poseAct = nil, exprHint = nil, breath = 0,
		lookPos = nil, lookPart = nil, lookYaw = 0, lookPitch = 0, nextLook = 0, lookW = 0,
		guardT = 0, prevGuard = nil, poseT = 0, countT = 0,
		breathPhase = 0, nextAuto = 0, autoId = 0, sbCount = 0, combo = nil, comboI = 0,
		gesture = nil, nextGesture = 3, watch = nil, watchAct = nil,
		accDt = 0, clock = 0, timeScale = 1, nextGeo = 0, nextResolve = 0, frameSkip = 0, slot = 0, impactT = -10,
		koTilt = (seed % 7) / 7 - 0.5, partner = nil, nextPartner = 0, curlCycle = 0, lod = 3,
		guardL = nil, guardR = nil, guardSink = 0, gl = { 0, 0, 0 }, gr = { 0, 0, 0 },
	}
	rig.isLocal = model == player.Character
	Loco.init(rig)
	Fight.setup(rig)
	readTags(rig)
	for name, v in pairs(model:GetAttributes()) do
		rig.a[name] = v
	end
	rig.a.Act = nil -- an act that happened before we saw the model is not replayed
	rig.conn = model.AttributeChanged:Connect(function(name)
		onAttr(rig, name)
	end)
	-- (a rescale also moves the floor under the root: re-measure on a HipHeight change too)
	if rig.hum then
		rig.hipConn = rig.hum:GetPropertyChangedSignal("HipHeight"):Connect(function()
			rig.geoNow = true
		end)
	end
	rig.isPlayer = Players:GetPlayerFromCharacter(model) ~= nil
	-- [Studio] a body part or a joint arriving (ReplaceBodyPartR15 on a tier / frame swap, the classic head swap, a
	-- respawn's parts streaming in, the Avatar Joint Upgrade's constraints): the joints are re-resolved and the legs
	-- re-measured on the next frame, not up to a second later - between the swap and the next resolve our writes went
	-- to the dead joint and the new one showed the bind pose (a pop, legs stiff or into the body)
	rig.descConn = model.DescendantAdded:Connect(function(d)
		if R.IsJoint(d) or (d:IsA("BasePart") and d.Parent == model) then
			rig.resolveNow = true
			rig.geoNow = true
			-- (new joints: whether our writes take effect is asked again; an upgrade constraint is noted so this client
			-- rebuilds it as a Motor6D should the server not have done it - updateRig)
			rig.writesOk = nil
			if rig.check then
				rig.check.bad, rig.check.good = 0, 0
			end
			if d:IsA("AnimationConstraint") and not rig.acSeen then
				rig.acSeen = rig.clock
			end
		end
	end)
	rig.childConn = model.ChildAdded:Connect(function(c)
		if c.Name == "Anatomy" and c:IsA("Folder") then
			watchAnatomy(rig, c)
		elseif c.Name == "Animate" or c:IsA("Humanoid") then
			-- (a character's children arrive after CharacterAdded on a client: the Animate script and the Humanoid
			-- with its Animator come in later)
			if c:IsA("Humanoid") then
				rig.hum = c
			end
			task.defer(function()
				if rigs[model] == rig then
					hookAnimate(rig)
				end
			end)
		end
	end)
	local af = model:FindFirstChild("Anatomy")
	if af and af:IsA("Folder") then
		watchAnatomy(rig, af)
	end
	R.resolveJoints(rig)
	do
		local _, na = RigJoints.Count(model)
		if na > 0 then
			rig.acSeen = 0
		end
	end
	-- [Studio] a measurement that throws (a joint class with other members, a part mid-replacement) must never leave the
	-- rig unregistered - that is how every upgraded rig in Studio went undriven: the rig registers regardless, is measured
	-- again on its first frames (geo.ok false -> retried every 0.4 s) and the failure is reported once
	local okG, errG = pcall(R.computeGeo, rig)
	if not okG then
		rig.geo.ok = false
		warn("[Animator] " .. model.Name .. ": rig measurement failed (retrying): " .. tostring(errG))
	end
	hookAnimate(rig)
	-- (its turn when it is a still figure drawn at a reduced rate: a crowd that streamed in together spreads
	-- evenly over the frames instead of updating all on one - an even cost, not a spike every other frame)
	nextSlot += 1
	rig.slot = nextSlot
	rigs[model] = rig
	if rig.isLocal then
		heartbeat(model)
	end
end

local function teardown(model)
	local rig = rigs[model]
	if not rig then
		return
	end
	if model.Parent and (hasAnyTag(model) or isPlayerChar(model)) then
		readTags(rig)
		return
	end
	for _, j in pairs(rig.joints) do
		if j.motor and j.motor.Parent then
			j.motor.Transform = I
		end
	end
	-- Roblox's animation back on the character
	rig.released = true
	applyAnimate(rig)
	stopFallback(rig)
	if rig.rope then
		rig.rope.beam:Destroy()
		rig.rope.a0:Destroy()
		rig.rope.a1:Destroy()
	end
	dropConns(rig)
	rigs[model] = nil
end

------------------------------------------------------------------------
-- Acts: Act / ActId (server), PredAct (local prediction), AutoAct (re-synthesized)
------------------------------------------------------------------------
onAct = function(rig, s, now, predicted)
	local k, f2, f3, f4, f5, f6 = K.parseAct(s)
	if not k then
		return
	end
	if k == "cancel" then
		-- FightClient: the server refused the special this client predicted ("cancel|special|<id>", a
		-- predicted act): the move the key press started is called off and blends back to the guard
		local sp = rig.special
		if predicted and f2 == "special" and sp and sp.pred and (f3 == "" or f3 == sp.pred) then
			Fight.endSpecial(rig, now)
			if rig.predKind == "special" then
				rig.predKind = nil
			end
		end
		return
	end
	-- the local fighter's special already started on the key press: its server echo (same id) is dropped
	-- for as long as that move lasts, however late the echo comes (a laggy connection), so the set-up is
	-- never rewound; the move may have ended meanwhile (a hit, the bell) and must not start again
	if not predicted and k == "special" and rig.predKind == "special" and f2 == rig.predHand and now - rig.predT < rig.predDur then
		rig.predKind = nil
		return
	end
	-- the local fighter's punch already started on the key press: skip the server echo
	if not predicted and rig.predKind == k and now - rig.predT < 0.25 and (f2 == "" or f2 == rig.predHand) then
		rig.predKind = nil
		return
	end
	local act = { kind = k, start = now, f2 = f2, f3 = f3, dur = 0.4 }
	if PUNCHES[k] then
		act.hand = (f2 == "L" or f2 == "R") and f2 or Fight.PUNCH_HAND[k] or "R"
		act.zone = f3 == "body" and "body" or "head"
		act.windup = clamp(tonumber(f4) or 0.2, 0.08, 0.9)
		act.power = clamp(tonumber(f5) or 0.6, 0, 1.5)
		-- a feint (FightEngine: "jab|L|head|0.12|0.20" - a short, light jab that is never meant to land): the
		-- shoulder and the lead hand twitch with a half step, the arm never goes out (AnimFight.applyAct "feint")
		local pw = tonumber(f5)
		if k == "jab" and pw and pw <= 0.25 and act.windup <= 0.13 then
			act.kind, act.dur = "feint", 0.38
			rig.act = act
			return
		end
		act.dur = act.windup * 2.05 + 0.045
		-- (the optional sixth field: the punch's place in a chain - 2 and up flow out of the last punch)
		-- (or the model's Chain attribute, which FightEngine sets just before the act: the same number)
		local ch = rig.model:GetAttribute("Chain")
		act.chain = f6 ~= "" and f6 or ((type(ch) == "number" and ch >= 2) and ch or nil)
		if predicted then
			rig.predKind, rig.predHand, rig.predT = k, act.hand, now
		end
		Fight.startPunch(rig, act, now)
		return
	elseif k == "special" then
		-- a special move (special|<id>|<hand>|<windup>|<power>): AnimFight plays its set-up and throws its
		-- punches on the FightMotion.Specials schedule; unknown ids are ignored
		-- (a predicted special is matched to its server echo by its id, for as long as the move lasts)
		local ok = Fight.startSpecial(rig, f2, f3, f4, f5, now)
		if predicted and ok then
			rig.predKind, rig.predHand, rig.predT, rig.predDur = k, f2, now, rig.special.dur
			rig.special.pred = f2 -- (what a "cancel" names)
		end
		return
	elseif k == "hit" or k == "hitbody" or k == "blockhit" then
		act.sev = clamp(tonumber(f4) or 0.5, 0, 1.5)
		act.dur = k == "blockhit" and 0.4 or 0.5 + 0.25 * act.sev
		-- (hit|punch|flag|sev|hand: the 5th field, the punching hand, is round 2 and optional)
		Fight.react(rig, k, f2, f3, act.sev, now, f5 ~= "" and f5 or nil)
	elseif k == "parryhit" then
		act.dur = 0.25
	elseif k == "slip" then
		act.dur = 0.42
	elseif k == "roll" or k == "weave" then
		-- (roll = the bob and weave: weave|L / weave|R, the side he comes up on; f3 = its length, optional)
		act.dur = clamp(tonumber(f3) or 0.55, 0.3, 1.2)
	elseif k == "duck" then
		act.dur = clamp(tonumber(f3) or tonumber(f2) or 0.45, 0.25, 1)
	elseif k == "pull" then
		act.dur = clamp(tonumber(f3) or tonumber(f2) or 0.5, 0.25, 1.2)
	elseif k == "sidestep" then
		act.dur = clamp(tonumber(f3) or 0.5, 0.3, 1.2)
	elseif k == "shoulderroll" then
		act.dur = clamp(tonumber(f3) or 0.6, 0.3, 1.5)
	elseif k == "parry" then
		act.dur = 0.3
	elseif k == "pivot" then
		act.dur = 0.4
	elseif k == "step" then
		act.dur = 0.36
	elseif k == "jump" then
		act.dur = clamp(tonumber(f4) or 0.32, 0.15, 0.8)
	elseif k == "stumble" then
		act.sev = clamp(tonumber(f3) or 0.6, 0, 1.5)
		act.dur = clamp(tonumber(f4) or 0.7, 0.2, 2)
		R.kick(rig, 1.2 * act.sev, 0, 0, 0.8 * act.sev, 0, 0, 0, 0, 0.6 * act.sev, 0, 0.5 * act.sev, 0.5 * act.sev, 0.4, 0.4)
	elseif k == "getup" then
		act.fall = f2 ~= "" and f2 or "back"
		-- (round 2: the server sends the get-up time of the fall, FightMotion.GetUpTime)
		act.dur = clamp(tonumber(f4) or 0.9, 0.4, 3.2)
		-- the get-up starts from the fall he is lying in (side, the way it turned him)
		local d = rig.down
		if d then
			act.side, act.yaw = d.side, d.yaw
		end
	elseif k == "refcount" then
		act.n = tonumber(f2) or 1
		act.dur = 0.95
	elseif k == "waveoff" then
		act.dur = 1.8
	elseif k == "neutral" then
		-- the referee sends the standing man to the neutral corner (FightEngine RefAct("neutral"))
		act.dur = 1.4
	elseif k == "catch" then
		act.dur = clamp(tonumber(f2) or 2.5, 0.8, 6)
	else
		return -- unknown acts are ignored safely
	end
	rig.act = act
end

local function applyAct(p, rig, act, t)
	if act.kind == "getup" then
		return Down.getup(p, rig, act, t - act.start, t)
	end
	return Fight.applyAct(p, rig, act, t)
end

------------------------------------------------------------------------
-- Who looks at whom (every ~0.5 s): opponents, athletes, the local player, LookAt
------------------------------------------------------------------------
local function isFighterRig(r)
	return r.isFighter
end
local function isAthleteRig(r)
	if r.isFighter or r.isTrainee then
		return true
	end
	local loop = r.a.Loop
	return r.isAmbient and (loop == "heavybag" or loop == "spar" or loop == "shadow" or loop == "rope" or loop == "curl")
end
local function isTraineeRig(r)
	return r.isTrainee
end
local function isRefRig(r)
	return r.isReferee or r.a.Loop == "referee"
end

local function nearestRig(rig, pos, maxD, filter)
	local best, bd = nil, maxD
	for _, r in pairs(rigs) do
		if r ~= rig and r.root and r.root.Parent and filter(r) then
			local d = (r.root.Position - pos).Magnitude
			if d < bd then
				best, bd = r, d
			end
		end
	end
	return best, bd
end

-- the hanging bag in front of a bag worker: the local gym's station bag (GymVisuals builds it in
-- workspace.LocalGym.Visual_<Station>, segment "Bag" = the middle of the bag) or a members' bag
-- (MapBuilder: model tagged MemberBag, part "MemberBag"); flat distance from the root under 6 studs
local BAG_RANGE = 6
local BAG_RANGE_IN = 1.55 -- root to bag surface at the working range (studs, scaled by the torso)
-- how far the chest stays from the bag (and a glove): most of the arm - a punch reaches out at least ~0.68 of it
-- (AnimFight: a nearer target is met in front of it), and its body drive carries the shoulder in a little more
local BAG_REACH = 0.85
local function findBag(rig, pos)
	local function flat(part)
		local d = part.Position - pos
		return sqrt(d.X * d.X + d.Z * d.Z)
	end
	if rig.isTrainee then
		local st = rig.a.Station
		local lg = workspace:FindFirstChild("LocalGym")
		local vm = lg and lg:FindFirstChild("Visual_" .. (type(st) == "string" and st or "heavybag"))
		local bag = vm and vm:FindFirstChild("Bag", true)
		if bag and bag:IsA("BasePart") and flat(bag) < BAG_RANGE then
			return bag
		end
	end
	local best, bd = nil, BAG_RANGE
	for _, m in ipairs(CollectionService:GetTagged("MemberBag")) do
		local bp = m:FindFirstChild("MemberBag", true)
		if bp and bp:IsA("BasePart") then
			local d = flat(bp)
			if d < bd then
				best, bd = bp, d
			end
		end
	end
	return best
end

local WATCHERS = { coachwatch = true, ringside = true, cornerman = true, sitwatch = true, idle = true, mittidle = true, mitts = true }

local function chooseLook(rig, t)
	if t < rig.nextLook then
		return
	end
	rig.nextLook = t + 0.45 + rig.rng:NextNumber() * 0.35
	local a = rig.a
	local pos = rig.root.Position
	rig.lookPart, rig.lookA, rig.lookB, rig.watch = nil, nil, nil, nil
	if rig.bagPart then
		-- left the bag (re-found below while still on it)
		if rig.oppHead == rig.bagPart then
			rig.oppHead, rig.oppTorso = nil, nil
		end
		rig.bagPart = nil
	end
	if rig.isFighter then
		local o = nearestRig(rig, pos, 40, isFighterRig)
		rig.oppHead = o and o.model:FindFirstChild("Head") or nil
		rig.oppTorso = o and o.model:FindFirstChild("UpperTorso") or nil
		rig.oppRig = o
		rig.lookPart = rig.oppHead
		rig.watch = o and o.model or nil
		rig.refRig = nearestRig(rig, pos, 30, isRefRig)
		return
	end
	local loop = a.Loop
	if rig.isReferee or loop == "referee" then
		-- the downed man, else the middle of the two fighters
		local f1, f2
		for _, r in pairs(rigs) do
			if r.isFighter and r.root and (r.root.Position - pos).Magnitude < 30 then
				if r.a.Guard == "down" then
					rig.lookPart = r.model:FindFirstChild("Head")
					return
				end
				if not f1 then
					f1 = r
				elseif not f2 then
					f2 = r
				end
			end
		end
		rig.lookA = f1 and f1.model:FindFirstChild("Head")
		rig.lookB = f2 and f2.model:FindFirstChild("Head")
		return
	end
	if loop == "spar" and not a.Pose then
		local partner = rig.partner
		if partner and partner.model.Parent then
			rig.lookPart = partner.model:FindFirstChild("Head")
			rig.oppHead = rig.lookPart
			rig.oppTorso = partner.model:FindFirstChild("UpperTorso")
			rig.oppRig = partner
			rig.watch = partner.model
		end
		return
	end
	-- bag work: the bag is the target the punches land on, eyes on it
	if (rig.isTrainee and a.Pose == "heavybag") or (rig.isAmbient and not a.Pose and loop == "heavybag") then
		local bag = findBag(rig, pos)
		if bag then
			rig.bagPart, rig.oppHead, rig.oppTorso = bag, bag, bag
			-- how far to step in (POSE.heavybag): averaged over looks, so a swinging bag does not
			-- drag the stance around
			local lp = rig.root.CFrame:PointToObjectSpace(bag.Position)
			local r = min(bag.Size.Y, bag.Size.Z) * 0.5
			local g = rig.geo
			local sc = g.utScale
			local want = clamp(-lp.Z - r - BAG_RANGE_IN * clamp(sc and sc.Y or 1, 0.7, 1.4), 0, 1.1)
			-- never so close that the guard rests in the bag, nor that the punches - which always reach out at
			-- least a share of the arm - land inside it: between punches, from where the gloves and the chest
			-- really are, the step is trimmed (back past the station's spot if need be) until the foremost guard
			-- glove's front stays off the bag and the chest is an arm's punching reach from it
			local ut = rig.model:FindFirstChild("UpperTorso")
			local arm = g.armL
			if ut and arm and arm.ok and not (rig.pun and (rig.pun.L or rig.pun.R)) then
				local c = bag.Position
				local function gap(part, extra)
					if not part then
						return math.huge
					end
					local d = part.Position - c
					return sqrt(d.X * d.X + d.Z * d.Z) - r - extra
				end
				local fr = max(g.fistRL or 0.4, g.fistRR or 0.4)
				local need = min(gap(rig.model:FindFirstChild("LeftHand"), fr * 1.2 + 0.1), gap(rig.model:FindFirstChild("RightHand"), fr * 1.2 + 0.1),
					gap(ut, fr + arm.dMax * BAG_REACH))
				if need < math.huge then
					want = min(want, (rig.stepIn or 0) + need)
				end
			end
			want = clamp(want, -0.8, 1.1)
			rig.bagWant = rig.bagWant and (rig.bagWant + (want - rig.bagWant) * 0.3) or want
		else
			rig.bagWant = nil
		end
		return
	end
	if rig.isTrainee or rig.isPreview then
		return -- eyes on the work (FaceFX looks at the camera in the Creator)
	end
	local name = a.Pose or loop
	if WATCHERS[name] or rig.isAmbient or not rig.isTagged then
		local o
		if name == "mitts" or name == "mittidle" or name == "coachwatch" then
			o = nearestRig(rig, pos, 30, isTraineeRig)
		end
		if rig.isTagged then
			o = o or nearestRig(rig, pos, 45, isFighterRig) or nearestRig(rig, pos, 30, isAthleteRig)
		end
		if o then
			rig.lookPart = o.model:FindFirstChild("Head")
			rig.watch = o.model
			return
		end
		-- people look at you when you walk past (the gym's people: another player's boxer looks where HE
		-- looks on his own screen, never round at you)
		local char = player.Character
		local head = rig.isTagged and char and char ~= rig.model and char:FindFirstChild("Head")
		if head and (head.Position - pos).Magnitude < 18 then
			rig.lookPart = head
		end
	end
end

local function updateLookPos(rig)
	local la = rig.a.LookAt
	if typeof(la) == "Vector3" then
		rig.lookPos = la
	elseif rig.lookPart and rig.lookPart.Parent then
		rig.lookPos = rig.lookPart.Position
	elseif rig.lookA and rig.lookA.Parent and rig.lookB and rig.lookB.Parent then
		rig.lookPos = (rig.lookA.Position + rig.lookB.Position) / 2
	else
		rig.lookPos = nil
	end
end

-- head and shoulders turn towards the look target (70% neck, 30% waist), never owl-like
local function applyLook(p, rig, dt)
	local ty, tp = 0, 0
	local wgt = rig.lookW
	if rig.lookPos and wgt > 0 then
		local lp = rig.root.CFrame:PointToObjectSpace(rig.lookPos)
		local yaw = atan2(-lp.X, -lp.Z)
		if abs(yaw) < 2.2 then
			ty = clamp(yaw, -1.25, 1.25) * wgt
			tp = clamp(atan2(lp.Y - 1.5, sqrt(lp.X * lp.X + lp.Z * lp.Z)), -0.5, 0.4) * wgt
		end
	end
	local k = 1 - exp(-dt * 4)
	rig.lookYaw += (ty - rig.lookYaw) * k
	rig.lookPitch += (tp - rig.lookPitch) * k
	if abs(rig.lookYaw) + abs(rig.lookPitch) > 1e-3 then
		p.W = p.W * A(0, rig.lookYaw * 0.3, 0)
		p.Neck = p.Neck * A(rig.lookPitch * 0.85, rig.lookYaw * 0.7, 0)
	end
end

------------------------------------------------------------------------
-- Player characters around the world: the gait, jumps / falls, seats
------------------------------------------------------------------------
local HST = Enum.HumanoidStateType
-- states where the default animation is better than anything we would invent
local SKIP_STATES = { [HST.Climbing] = true, [HST.Swimming] = true, [HST.Dead] = true, [HST.Physics] = true, [HST.Ragdoll] = true }
-- the shortest Freefall that shows as a fall (s): shorter is a kerb / stair edge, the gait carries on
local AIR_MIN = 0.14
local airParams = RaycastParams.new()
airParams.FilterType = Enum.RaycastFilterType.Exclude
airParams.RespectCanCollide = true

-- is there ground just under another player's feet? (a ray from the root, a little past the hip height)
local function groundUnder(rig)
	local root = rig.root
	local hum = rig.hum
	local reach = (hum and hum.HipHeight or 2) + root.Size.Y * 0.5 + 1.2
	airParams.FilterDescendantsInstances = { rig.model }
	local ok, hit = pcall(workspace.Raycast, workspace, root.Position, Vector3.new(0, -reach, 0), airParams)
	return ok and hit ~= nil
end

local function playerPose(p, rig, t, dt)
	local hum = rig.hum
	if not hum or not hum.Parent then
		rig.hum = rig.model:FindFirstChildOfClass("Humanoid")
		hum = rig.hum
	end
	local st = hum and hum:GetState()
	if st and SKIP_STATES[st] then
		return "skip"
	end
	if hum and (hum.Sit or hum.SeatPart) then
		POSE.sit(p, rig, t)
		rig.airT = nil
		return "sit"
	end
	local vy = rig.root.AssemblyLinearVelocity.Y
	-- (another player's Humanoid state is not reliable here: he is in the air when nothing is under him -
	-- running up or down stairs is NOT a jump)
	local air
	if rig.isLocal then
		air = st == HST.Freefall or st == HST.Jumping
	else
		air = abs(vy) > 6 and not groundUnder(rig)
	end
	if air then
		rig.airT0 = rig.airT0 or t
		rig.airVy = min(rig.airVy or 0, vy)
	else
		rig.airT0 = nil
	end
	-- a frame or two of Freefall (a kerb, a stair edge, a part seam) is not a jump: the gait carries on;
	-- a real jump (Jumping) or a fall that lasts tucks the legs
	if air and (st == HST.Jumping or t - rig.airT0 >= AIR_MIN or rig.airT) then
		-- airborne: knees tuck on the way up, legs reach for the ground on the way down
		rig.airT = rig.airT or t
		local up = clamp(vy / 25, -1, 1)
		local tuck = max(0, up) * 0.6 + 0.25
		p.Root = A(-0.08, 0, 0)
		p.W = A(0.05 - 0.1 * up, 0, 0)
		p.Neck = A(-0.05, 0, 0)
		p.LH = A(0.5 * tuck + 0.2, 0, -0.05)
		p.RH = A(0.2 * tuck, 0, 0.05)
		p.LK = A(-1.1 * tuck, 0, 0)
		p.RK = A(-0.6 * tuck - 0.2, 0, 0)
		p.LA = A(-0.3, 0, 0)
		p.RA = A(-0.25, 0, 0)
		p.LS = A(0.4 + 0.5 * up, 0, -0.35)
		p.RS = A(0.3 + 0.5 * up, 0, 0.35)
		p.LE = A(0.6, 0, 0)
		p.RE = A(0.6, 0, 0)
		return "air"
	end
	if rig.airT then
		-- landing: the knees absorb it, as hard as the fall was (a hop barely, a drop off a ledge fully)
		local k = clamp((-(rig.airVy or 0) - 4) / 36, 0.15, 1) * clamp((t - rig.airT) / 0.35, 0.3, 1)
		rig.landT = t
		rig.airT = nil
		R.kick(rig, -0.8 * k, 0, 0, -0.6 * k, 0, 0, 0, 0, 1.4 * k, 0, 0.3 * k, 0.3 * k, 0, 0)
	end
	if not air then
		rig.airVy = 0
	end
	POSE.idle(p, rig, t, 0, 1, rig.model, dt)
	return "ground"
end

------------------------------------------------------------------------
-- Per-rig update
------------------------------------------------------------------------
-- poses whose arms are free for a shout gesture (mitt work keeps the pads up: face only)
local SHOUT_ARMS = { idle = true, walk = true, coachwatch = true, ringside = true, cornerman = true, sitwatch = true,
	mittidle = true }
local PUBLISH_POSE = { heavybag = "heavybag", guard = "shadow", speedbag = "speedbag" }

-- the guards a fighter settles into slowly (AnimFight.guardPose; the base filter eases in after the change)
local SLOW_GUARD = { rest = true, win = true, lose = true, walkout = true, clinch = true }

local function updateRig(rig, model, t, dt, lod, rdt)
	-- joints get replaced (head swap, rescale, respawn): re-resolve dead motors
	if rig.resolveNow then
		rig.resolveNow = false
		R.resolveJoints(rig)
		rig.nextGeo = 0
	end
	if t >= rig.nextResolve then
		rig.nextResolve = t + 1
		for _, k in ipairs(KEYS) do
			local j = rig.joints[k]
			if not j or not j.motor.Parent then
				R.resolveJoints(rig)
				rig.nextGeo = 0
				break
			end
		end
		rig.head = model:FindFirstChild("Head")
		-- (a late Animator / Animate script, a replaced Humanoid - on every rig, NPCs too)
		hookAnimate(rig)
		-- [Studio] Avatar Joint Upgrade constraints still on the rig 1.5 s after they appeared: the server did not rebuild
		-- them as Motor6Ds (a client-local rig, an older server): this client does (RigJoints.EnsureMotors)
		if rig.acSeen and t - rig.acSeen >= (R.CONVERT_AFTER or 1.5) then
			rig.acSeen = nil
			localMotors(rig, nil)
		end
	end
	pollTracks(rig, t)
	if (t >= rig.nextGeo and lod >= 2) or rig.geoNow then
		rig.nextGeo = rig.geoNow and t + 0.5 or t + 2.5
		rig.geoNow = false
		R.computeGeo(rig)
		-- (a rig that could not be measured - its joints or torso not in place yet - is tried again soon: until it
		-- is, the guard and the punches run on the authored fallback, no IK, no planted feet)
		if not rig.geo.ok then
			rig.nextGeo = t + 0.4
		end
	end
	-- (the root moves in real time: sensing uses the real frame time, never the slowed one)
	Loco.sense(rig, rdt)
	R.clearPose(rig)
	rig.lod = lod
	rig.dt = dt
	local p = rig.p
	local a = rig.a
	local pose, loop = a.Pose, a.Loop
	chooseLook(rig, t)
	updateLookPos(rig)
	local guard
	local ropeOn = false
	rig.publish = false
	if rig.isFighter then
		if a.Guard == "down" then
			Down.pose(p, rig, t, dt)
			guard = "down"
		else
			if rig.down then
				Down.clear(rig)
			end
			guard = Fight.guardPose(p, rig, t, dt)
			if guard == "walk" then
				-- the ring walk: an upright, unhurried walk (it strides out rather than breaking into a jog),
				-- the gloves carried at the waist on half bent arms with half the swing, a swagger of the
				-- shoulders and a nod in step with the stride (standing: a slow bounce)
				rig.walkMax = 1.45
				POSE.idle(p, rig, t, 0, 1, model, dt)
				local lo = rig.loco
				local mv = lo.gaitW
				p.LE = p.LE:Lerp(A(1.05, 0, 0), 0.85)
				p.RE = p.RE:Lerp(A(1.05, 0, 0), 0.85)
				p.LS = p.LS * A(0.1, 0, -0.05)
				p.RS = p.RS * A(0.1, 0, 0.05)
				rig.armScale = 0.5
				-- (the pose is filtered on its way out: the stride's phase a touch ahead)
				local ph = 2 * PI * (lo.phase - (1 - lo.duty) + 0.06)
				p.W = p.W * A(0, 0.03 * sin(ph) * mv, 0.035 * math.cos(ph) * mv + 0.03 * sin(t * 3.5) * (1 - mv))
				p.Neck = p.Neck * A(0.035 * math.cos(2 * ph) * mv + 0.04 * sin(t * 7) * (1 - mv), 0, 0)
			end
		end
		rig.lookW = 0
	elseif (rig.isReferee or loop == "referee") and not pose then
		POSE.referee(p, rig, t, 0, 1, model, dt)
	elseif not rig.isTagged then
		-- a player walking around the world
		local st = playerPose(p, rig, t, dt)
		if st == "skip" then
			-- the default animation shows (climbing, swimming...): hand the joints back
			if not rig.released then
				rig.released = true
				Loco.release(rig)
				applyAnimate(rig)
			end
			return
		end
		if rig.released then
			rig.released = false
			applyAnimate(rig)
		end
	else
		local name = pose or loop or (rig.isPreview and "preview") or "idle"
		local w = num(a.PoseSpeed, 1)
		local drive = a.PoseDrive
		if loop == "walk" or loop == "run" then
			-- moving members: the real gait follows the root (AnimLoco)
			if not pose then
				name = "idle"
			end
		end
		if type(drive) ~= "number" then
			-- automatic reps for other players and gym members
			local cyc = (t * 0.55 * w + rig.phase) % 1
			drive = cyc < 0.5 and smooth(cyc * 2) or smooth(2 - cyc * 2)
			if name == "curl" then
				rig.curlCycle = floor(t * 0.55 * w + rig.phase)
			end
		elseif name == "curl" then
			rig.curlCycle = num(a.RepCount, 0)
		end
		if name == "rope" then
			local spin = a.RopeSpin
			if type(spin) == "number" then
				rig.ropePhase = spin
			else
				rig.ropePhase = (rig.ropePhase or 0) + dt * 9 * w
			end
			rig.ropeFoot = a.RopeFoot
			ropeOn = true
		end
		local fn = POSE[name] or POSE.idle
		fn(p, rig, t, drive, w, model, dt)
		rig.poseAct = rig.poseAct or POSE_ACT[name]
		-- a coach's chat bubble (ShoutAt): the shout gesture goes with the words whenever the arms
		-- are free; the watch poses draw their own gestures, the others get the overlay here
		if rig.shoutReq then
			if t - rig.shoutReq < 0.5 and not rig.gesture and SHOUT_ARMS[name] then
				Gym.startGesture(rig, "shout", t, 1.2)
			end
			rig.shoutReq = nil
		end
		if rig.gesture and rig.gestureDrawnT ~= t and SHOUT_ARMS[name] then
			Gym.gestureOverlay(p, rig, t)
		end
		-- other players' bag / shadow / speed-bag work is re-synthesized here and published
		local autoLoop
		if rig.isTrainee and not rig.isLocal then
			autoLoop = PUBLISH_POSE[pose]
			rig.publish = autoLoop ~= nil
		elseif rig.isAmbient and not pose and (loop == "heavybag" or loop == "shadow" or loop == "spar") then
			autoLoop = loop
			rig.publish = loop ~= "shadow"
			if loop == "spar" then
				Gym.findPartner(rig, t)
			end
		end
		if autoLoop == "speedbag" then
			-- one strike per half circle of the fists
			local n = floor(t * 16 * w / PI)
			if n ~= rig.sbCount then
				rig.sbCount = n
				rig.autoId += 1
				model:SetAttribute("AutoAct", string.format("jab|%s|head|0.05|0.40", n % 2 == 0 and "L" or "R"))
				model:SetAttribute("AutoActId", rig.autoId)
			end
		elseif autoLoop then
			Gym.ambientAct(rig, autoLoop, t)
		end
		-- the strain of a hard set: a fine tremor in the working arms
		local eff = num(a.Effort, 0)
		if eff > 0.8 then
			local tr = (eff - 0.8) * 0.12
			p.RS = p.RS * A(tr * sin(t * 113), 0, tr * sin(t * 97))
			p.LS = p.LS * A(tr * sin(t * 107), 0, tr * sin(t * 89))
			p.RE = p.RE * A(tr * sin(t * 101), 0, 0)
			p.LE = p.LE * A(tr * sin(t * 103), 0, 0)
		end
	end
	-- base filter: poses glide, dazed guards lag
	local rate = p.rate or 20
	if rig.isFighter and guard ~= "down" and rig.guardT then
		-- (a new guard - to the stool, the win, the loss, the clinch - is eased into: the filter starts slow and
		-- comes up to speed, so the body sets off from rest instead of at full speed on the first frame)
		-- (the fighting guards - the block, the shell, the stance - come up quicker: a beat, not a glide)
		local ge = t - rig.guardT
		local gd = SLOW_GUARD[a.Guard] and 0.45 or 0.16
		if ge < gd then
			rate *= 0.12 + 0.88 * smooth(ge / gd)
		end
	end
	local ab = p.snap and 1 or (1 - exp(-dt * rate))
	-- (a fighter's guard arms ride the trunk tighter than the rest glides: at the body's rate a 0.2 s bounce left the
	-- gloves a quarter of a stud behind their spots, trailing the chest like loose arms; a dazed guard keeps its lag)
	local abArm = ab
	if rig.isFighter and guard ~= "down" and not p.rate and not p.snap then
		abArm = 1 - exp(-dt * rate * GUARD_ARM_RATE)
	end
	local joints = rig.joints
	if rig.wasPlant and not rig.plant then
		-- leaving planted feet: the keyed legs start from where the IK left them
		for k in pairs(LEG_KEYS) do
			local j = joints[k]
			if j then
				j.base = j.cur
			end
		end
	end
	for _, k in ipairs(KEYS) do
		local j = joints[k]
		if j then
			j.base = j.base:Lerp(p[k], ARM_KEYS[k] and abArm or ab)
			p[k] = j.base
		end
	end
	-- overlays: reactions (springs: the cover-up here, the snaps after the filters), punches (per-hand
	-- layers), acts, gaze
	local springs = R.stepSprings(rig, dt)
	if springs then
		R.applySpringsPre(rig, p)
	end
	-- (a punch aims at its target - the man, the bag - in the middle band too: past near the generic path brings a
	-- big man's forearm back through his own chest, and only the rigs punching pay for it)
	local near = lod >= 2
	Gym.runPending(rig, t)
	if guard ~= "down" then
		Fight.reactionTick(p, rig, t)
		Fight.specialTick(p, rig, t)
		Fight.punches(p, rig, t, near)
	else
		rig.special = nil
	end
	if rig.autoAct and not applyAct(p, rig, rig.autoAct, t) then
		rig.autoAct = nil
	end
	if rig.act and (guard ~= "down" or rig.act.kind == "getup" or rig.act.kind == "hit" or rig.act.kind == "hitbody") then
		if guard == "down" and rig.act.kind ~= "getup" then
			-- a knockout punch: the springs already carry the snap, the fall owns the body
			if t - rig.act.start > rig.act.dur then
				rig.act = nil
			end
		elseif not applyAct(p, rig, rig.act, t) then
			rig.act = nil
		end
	end
	if p.override then
		for _, k in ipairs(KEYS) do
			local j = joints[k]
			if j then
				j.base = p[k]
			end
		end
	end
	if not rig.isFighter then
		applyLook(p, rig, dt)
	end
	-- output filter (fast enough to keep the snap of a punch); while a punch is out the upper body
	-- barely filters at all: the punch's own curves are smooth, and a 40/s low-pass would leave a fist
	-- at 30 studs/s most of a stud behind the spot it was aimed at
	local ao = 1 - exp(-dt * 40)
	local aoPunch = 1 - exp(-dt * 100)
	local punching = rig.pun and (rig.pun.L or rig.pun.R)
	local plantOn = rig.plant and rig.geo.ok and joints.Root ~= nil
	for _, k in ipairs(KEYS) do
		local j = joints[k]
		if j and not (plantOn and LEG_KEYS[k]) then
			if punching and ARM_KEYS[k] then
				-- (and the punching arms never turn faster than PUNCH_JOINT_RATE: where the body's turn and
				-- the fist's path add up, the arm lags its target by a hair instead of whipping round)
				-- (a soft limit: a joint eases into its top speed - a hard cap held the arm at one constant rate
				-- through the middle of a hook and stopped it dead on the cap's edges)
				local nxt = j.cur:Lerp(p[k], aoPunch)
				local _, ang = (j.cur:Inverse() * nxt):ToAxisAngle()
				local maxA = PUNCH_JOINT_RATE * dt
				local lim = K.softLimit(ang, maxA, 0.6)
				if lim < ang then
					nxt = j.cur:Lerp(nxt, lim / ang)
				end
				j.cur = nxt
			else
				j.cur = j.cur:Lerp(p[k], (punching and not LEG_KEYS[k]) and aoPunch or ao)
			end
		end
	end
	-- the gait's pelvis / shoulder motion and momentum, in step with the feet (after the filters)
	if joints.Root then
		local rx, ry, yawP, rollP, pitchP, wYaw, wPitch, wRoll, nYaw, nPitch, nRoll = Loco.bodyOffsets(rig, dt, t)
		local lo = rig.loco
		local jo = lo.jumpOff
		local jy = lo.jumpYaw
		local rootT = joints.Root.cur
		if rx ~= 0 or ry ~= 0 or yawP ~= 0 or rollP ~= 0 or pitchP ~= 0 then
			rootT = CF(rx, ry, 0) * rootT * A(pitchP, yawP, rollP)
		end
		-- a blow's hip / knee-drop translation (unfiltered; planted legs absorb it below)
		local st = springs and R.springRoot(rig)
		if st then
			rootT = st * rootT
		end
		-- a server nudge / pivot teleport glides instead of popping (the feet step after it)
		if (jo and jo.Magnitude > 1e-3) or (jy and abs(jy) > 1e-3) then
			local lj = jo and rig.root.CFrame:VectorToObjectSpace(jo) or Vector3.zero
			rootT = CF(lj) * A(0, jy or 0, 0) * rootT
		end
		rig.rootOut = rootT
		if joints.W and (wYaw ~= 0 or wPitch ~= 0 or wRoll ~= 0) then
			rig.wOut = joints.W.cur * A(wPitch, wYaw, wRoll)
		else
			rig.wOut = nil
		end
		if joints.Neck and (nYaw ~= 0 or nPitch ~= 0 or nRoll ~= 0) then
			rig.nOut = joints.Neck.cur * A(nPitch, nYaw, nRoll)
		else
			rig.nOut = nil
		end
	end
	-- a walker's arm swing, in step with the legs (after the filters, like the pelvis): opposite the legs,
	-- faded out while a gesture or a punch owns the arms (a punch thrown on the move: the swing laid over the punching
	-- arm swung it loose round its own line)
	local sL, eL, zL, sR, eR, zR, yL, yR, wL, wR = Loco.armOffsets(rig, dt, rig.gesture ~= nil or (punching and true or false))
	if sL and joints.LS and joints.LE and joints.RS and joints.RE then
		rig.armOut = true
		rig.lsOut = A(sL, yL, zL) * joints.LS.cur
		rig.leOut = joints.LE.cur * A(eL, 0, 0)
		rig.rsOut = A(sR, yR, zR) * joints.RS.cur
		rig.reOut = joints.RE.cur * A(eR, 0, 0)
		-- (the loose hands: AnimLoco's wrist flop)
		rig.lwOut = joints.LW and joints.LW.cur * A(wL or 0, 0, 0) or nil
		rig.rwOut = joints.RW and joints.RW.cur * A(wR or 0, 0, 0) or nil
	else
		rig.armOut = false
	end
	if plantOn then
		-- planting starts, or the rig crosses the foot-IK distance: blend the legs over (no pop)
		local nearLegs = lod >= 2
		if not rig.wasPlant or rig.nearLegs ~= nearLegs then
			-- (a distance switch eases over more slowly: the two leg solutions can be far apart)
			rig.plantBlend = (rig.wasPlant and rig.nearLegs ~= nil) and 0.45 or 0.25
			rig.plantT = t
			rig.nearLegs = nearLegs
			if not rig.wasPlant and nearLegs and rig.keyedLegs then
				-- out of keyed legs (a get-up, a fall, a seat): the feet start where they are
				Loco.seedFeet(rig, t)
			end
		end
		local rootT = rig.rootOut or joints.Root.cur
		if nearLegs then
			rootT = Loco.feet(rig, p, rootT, t, dt, true)
			rig.rootOut = rootT
		else
			Loco.farLegs(p, rig, rootT, t, dt)
			rig.foot.L.P, rig.foot.R.P = nil, nil
		end
		-- blend into the IK legs when planting starts (get-up, leaving a seat)
		local pb = rig.plantBlend or 0.25
		local bl = min(1, (t - (rig.plantT or 0)) / pb)
		-- (from rest: a hand-over that started a quarter of the way over popped the knees on its first frame)
		local l0 = pb > 0.3 and 0.03 or 0.06
		local la = bl < 1 and (l0 + (1 - l0) * smooth(bl)) or 1
		for k in pairs(LEG_KEYS) do
			local j = joints[k]
			if j then
				j.cur = la < 1 and j.cur:Lerp(p[k], la) or p[k]
			end
		end
	else
		Loco.release(rig)
	end
	rig.keyedLegs = not plantOn and joints.Root ~= nil
	if plantOn then
		rig.footLocks = nil
	end
	rig.wasPlant = plantOn
	-- the output: filtered pose + gait offsets, the reaction snaps composed on top (never low-passed)
	local out = rig.outT
	if not out then
		out = {}
		rig.outT = out
	end
	for _, k in ipairs(KEYS) do
		local j = joints[k]
		if j then
			local v = j.cur
			if k == "Root" and rig.rootOut then
				v = rig.rootOut
			elseif k == "W" and rig.wOut then
				v = rig.wOut
			elseif k == "Neck" and rig.nOut then
				v = rig.nOut
			elseif rig.armOut and ARM_OUT[k] and rig[ARM_OUT[k]] then
				v = rig[ARM_OUT[k]]
			end
			if springs then
				v = R.springOut(rig, k, v)
			end
			-- [Studio] a knee never bends backward: whatever wrote it (a filter lerping between two solutions, a spring's
			-- overshoot, a keyed pose on a leg of another length) a positive pitch on the knee joint - the shin swung
			-- forward through the thigh - is clipped at the output; the R15 knee flexes about -X only
			if k == "LK" or k == "RK" then
				local kx, ky, kz = v:ToEulerAnglesXYZ()
				if kx > 0.02 then
					v = CF(v.Position) * CFrame.fromEulerAnglesXYZ(0.02, ky, kz)
				end
			end
			out[k] = v
		else
			out[k] = I
		end
	end
	-- a body on the canvas (keyed legs: a fall, the get-up) never sinks into it, whatever the springs do
	if not plantOn and (rig.down or (rig.act and rig.act.kind == "getup")) and joints.Root then
		-- (feet that touch the canvas stay where they touched, with a little friction: no skating)
		if lod >= 2 then
			Down.footLock(rig, out, dt)
		end
		local co = rig.clampOut
		if not co then
			co = {}
			rig.clampOut = co
		end
		R.floorClamp(rig, out, co)
	end
	-- [Entrance] a ring-walk pose over the output (client-local visual: the root never moves for it)
	if Entrance and Entrance.active[model] then
		Entrance.output(rig, model, out, t, dt)
	end
	for _, k in ipairs(KEYS) do
		local j = joints[k]
		if j and j.motor.Parent then
			j.motor.Transform = out[k]
		end
	end
	Gym.ropeVisual(rig, model, ropeOn, rig.ropePhase or 0)
end

------------------------------------------------------------------------
-- [Studio] Do our joint writes take effect? The user's Studio video showed the character walking in the bind pose -
-- arms dead straight, knees never bending - with no error and Roblox's own walk off: the writes went to joints that did
-- not move the limbs (the Avatar Joint Upgrade's AnimationConstraints, in a place of their own where the upgrade is on).
-- So every rig, once it has been moving for CHECK_AFTER s, compares the pose its limbs really show (measured from the
-- parts: RigJoints.Measure) with the pose written to them on the frame before. Writes that do not show for CHECK_BAD s:
--   1. an AnimationConstraint rig is rebuilt on Motor6Ds on this client (RigJoints.EnsureMotors) and checked again;
--   2. still nothing (or a Motor6D rig): the rig goes to Roblox's own animation - a player's default Animate script
--      back on, an NPC Roblox's stock R15 idle / walk / run played on its Humanoid's Animator - so nobody ever walks
--      frozen. Each step is one Output warning naming the rig, its joint class and the numbers.
-- A rig whose writes show for CHECK_OK s is trusted (asked again whenever its joints change).
------------------------------------------------------------------------
local CHECK_KEYS = { "LK", "RK", "LE", "RE", "LH", "RH", "LS", "RS", "W", "Neck" }
local NAME_OF, KEY_OF = {}, {}
for k, def in pairs(R.JOINTS) do
	NAME_OF[k] = def[2]
	KEY_OF[def[2]] = k
end
local CHECK_AFTER = 2 -- s of moving before a rig is checked
local CHECK_BAD = 1 -- s of writes not showing before a rig is switched
local CHECK_OK = 1.5 -- s of writes showing: trusted
local CHECK_MIN = 8 -- deg: a joint written at least this far off its rest pose tells (a rest pose reads the same either way)
local CHECK_TOL = 6 -- deg: the mean gap between written and shown past which the writes do not take effect
-- Roblox's stock R15 animations (the default Animate script's idle / walk / run): an NPC's fallback
local FALLBACK_ANIMS = { idle = "rbxassetid://507766666", walk = "rbxassetid://507777826", run = "rbxassetid://507767714" }
R.selfCheck = { CHECK_AFTER = CHECK_AFTER, CHECK_BAD = CHECK_BAD, CHECK_OK = CHECK_OK } -- (tests)

-- written vs shown over the joints that tell: mean gap, worst gap, its joint, how many compared (nil: none tells)
local function writeGap(rig)
	local out = rig.outT
	if not out then
		return nil
	end
	local n, sum, worst, worstK = 0, 0, 0, nil
	for _, k in ipairs(CHECK_KEYS) do
		local j = rig.joints[k]
		local w = out[k]
		if j and w and j.motor.Parent and RigJoints.Angle(w) >= CHECK_MIN then
			local a = RigJoints.Measure(j.motor)
			if a then
				local gap = RigJoints.Angle(w:Inverse() * a)
				n += 1
				sum += gap
				if gap > worst then
					worst, worstK = gap, k
				end
			end
		end
	end
	if n == 0 then
		return nil
	end
	return sum / n, worst, worstK, n
end
R.writeGap = writeGap

-- this client rebuilds the rig's upgrade constraints as Motor6Ds (why: the Output line's reason); the converted count
localMotors = function(rig, why)
	local kind, _, na = RigJoints.Kind(rig.model)
	if na == 0 then
		return 0
	end
	local ok, conv = pcall(RigJoints.EnsureMotors, rig.model, { localOnly = true })
	conv = ok and conv or 0
	if conv > 0 then
		rig.localMotors = true
		rig.resolveNow = true
		rig.geoNow = true
		local nm, left = RigJoints.Count(rig.model)
		if why then
			warn(string.format("[Animator] joint writes are not taking effect on %s (%s rig): %s. Rebuilt its joints as Motor6Ds on this client (%d Motor6D / %d AnimationConstraint) and checking again",
				rig.model.Name, kind, why, nm, left))
		else
			print(string.format("[Animator] %s still had %d Avatar Joint Upgrade joints (AnimationConstraint) the server had not rebuilt: rebuilt as Motor6Ds on this client",
				rig.model.Name, conv))
		end
	elseif not ok then
		warn("[Animator] could not rebuild " .. rig.model.Name .. "'s joints as Motor6Ds: " .. tostring(conv))
	end
	return conv
end

stopFallback = function(rig)
	local fb = rig.fb
	rig.fb = nil
	if fb then
		for _, tr in pairs(fb.tracks) do
			pcall(tr.Stop, tr, 0.2)
		end
	end
end

-- Roblox's own animation for a rig our writes cannot move
local function enterFallback(rig, kind, why)
	rig.fallback = true
	rig.check = nil
	-- (our last pose off the joints: whatever does move them starts from the rest pose)
	for _, j in pairs(rig.joints) do
		if j.motor.Parent then
			pcall(function()
				j.motor.Transform = I
			end)
		end
	end
	local s = rig.animateScript
	local how
	if rig.isLocal and s and s.Parent then
		rig.fbMode = "Animate"
		how = "Switched it to Roblox's default animation (the Animate script is enabled again for it)"
	else
		rig.fbMode = "keyframe"
		how = "Switched it to Roblox's stock R15 idle / walk / run animations on its Humanoid's Animator"
	end
	applyAnimate(rig)
	local hint = (kind == "AnimationConstraint" or kind == "mixed" or rig.localMotors)
			and " In your own place set StarterPlayer > Properties > AvatarJointUpgrade = Disabled (README: Using your own place)."
		or " Something else holds its limbs (a weld from a limb to another part, a script writing the joints)."
	warn(string.format("[Animator] joint writes are not taking effect on %s (%s rig): %s. %s.%s", rig.model.Name, kind, why, how, hint))
end

-- every frame of a fallback rig in keyframe mode: the stock tracks, weighted by the root's speed
local function fallbackStep(rig)
	if rig.fbMode ~= "keyframe" then
		return
	end
	local hum = rig.hum
	if not (hum and hum.Parent) then
		return
	end
	local an = hum:FindFirstChildOfClass("Animator")
	if not an then
		-- (a client-local rig without one; a server NPC has its own)
		an = Instance.new("Animator")
		an.Parent = hum
	end
	local fb = rig.fb
	if not fb or fb.animator ~= an then
		stopFallback(rig)
		fb = { animator = an, tracks = {} }
		rig.fb = fb
		for name, id in pairs(FALLBACK_ANIMS) do
			local ok, tr = pcall(function()
				local anim = Instance.new("Animation")
				anim.AnimationId = id
				local track = an:LoadAnimation(anim)
				track.Looped = true
				track.Priority = name == "idle" and Enum.AnimationPriority.Idle or Enum.AnimationPriority.Movement
				track:Play(0.2, name == "idle" and 1 or 0.001, 1)
				return track
			end)
			if ok and tr then
				fb.tracks[name] = tr
			end
		end
	end
	local v = rig.root.AssemblyLinearVelocity
	local speed = Vector3.new(v.X, 0, v.Z).Magnitude
	local move = clamp(speed / 1.5, 0, 1)
	local run = clamp((speed - 11) / 4, 0, 1)
	local tr = fb.tracks
	pcall(function()
		if tr.idle then
			tr.idle:AdjustWeight(max(1 - move, 0.001), 0.2)
		end
		if tr.walk then
			tr.walk:AdjustWeight(max(move * (1 - run), 0.001), 0.2)
			tr.walk:AdjustSpeed(clamp(speed / 8, 0.5, 2))
		end
		if tr.run then
			tr.run:AdjustWeight(max(move * run, 0.001), 0.2)
			tr.run:AdjustSpeed(clamp(speed / 16, 0.6, 1.6))
		end
	end)
end

-- once per updated frame of a driven rig, before this frame's writes (the parts show the last frame's)
local function selfCheck(rig, dt)
	if rig.writesOk or not drives(rig) or rig.ragdoll or rig.down then
		return
	end
	local c = rig.check
	if not c then
		c = { moving = 0, bad = 0, good = 0 }
		rig.check = c
	end
	local lo = rig.loco
	if not (lo and (lo.speed or 0) > 1) then
		return
	end
	c.moving += dt
	if c.moving < CHECK_AFTER then
		return
	end
	local mean, worst, wk, n = writeGap(rig)
	if not mean or n < 2 then
		return
	end
	if mean > CHECK_TOL then
		c.bad += dt
		c.good = 0
		c.last = string.format("written vs actual pose off by %.0f deg on average over %d joints (%s %.0f deg) for %.1f s", mean, n,
			NAME_OF[wk] or tostring(wk), worst, c.bad)
	else
		c.good += dt
		c.bad = 0
	end
	if c.good >= CHECK_OK then
		rig.writesOk = true
		rig.check = nil
		return
	end
	if c.bad < CHECK_BAD then
		return
	end
	local kind = RigJoints.Kind(rig.model)
	c.bad, c.good = 0, 0
	if (kind == "AnimationConstraint" or kind == "mixed") and not rig.triedMotors then
		rig.triedMotors = true
		if localMotors(rig, c.last) > 0 then
			return
		end
	end
	enterFallback(rig, kind, c.last)
end
R.fallbackOf = function(model) -- (tests / diag) the rig's fallback mode or nil
	local rig = rigs[model]
	return rig and rig.fallback and rig.fbMode or nil
end

-- the diagnostic's view (Diag.SampleTick): what was written to a joint, and how the rig is driven
RigJoints.Written = function(model, jointName)
	local rig = rigs[model]
	local k = KEY_OF[jointName]
	if not (rig and k and rig.outT and rig.joints[k] and drives(rig)) then
		return nil
	end
	return rig.outT[k]
end
RigJoints.Status = function(model)
	local rig = rigs[model]
	if not rig then
		return "not driven by the Animator"
	end
	local kind, nm, na = RigJoints.Kind(model)
	local how = rig.fallback and ("FALLBACK (" .. tostring(rig.fbMode) .. ")") or (rig.released and "released (Roblox animation)" or "procedural")
	return string.format("%s, joints %s (Motor6D %d / AnimationConstraint %d)%s%s", how, kind, nm, na, rig.localMotors and ", rebuilt on this client" or "",
		rig.writesOk and ", writes verified" or "")
end

-- the startup line: the Animator is alive and what it drives (on the local character's arrival, every spawn)
local beatT = 0
heartbeat = function(model)
	beatT += 1
	local my = beatT
	task.delay(1, function()
		if my ~= beatT then
			return
		end
		local n, nm, na = 0, 0, 0
		for m in pairs(rigs) do
			if m.Parent then
				n += 1
				local _, a = RigJoints.Count(m)
				if a > 0 then
					na += 1
				else
					nm += 1
				end
			end
		end
		local kind = model and model.Parent and RigJoints.Kind(model) or "none"
		print(string.format("[Animator] running: driving %d rigs (Motor6D %d / AnimationConstraint %d); your character's joints: %s", n, nm, na, kind))
	end)
end
task.delay(6, function()
	if beatT == 0 then
		heartbeat(nil)
	end
end)

------------------------------------------------------------------------
-- Registration & main loop
------------------------------------------------------------------------
for _, tag in ipairs(TAGS) do
	CollectionService:GetInstanceAddedSignal(tag):Connect(function(m)
		task.defer(setup, m)
	end)
	CollectionService:GetInstanceRemovedSignal(tag):Connect(function(m)
		task.defer(teardown, m)
	end)
	for _, m in ipairs(CollectionService:GetTagged(tag)) do
		setup(m)
	end
end

-- every player character (the local one and everyone else's)
local function hookPlayer(plr)
	plr.CharacterAdded:Connect(function(char)
		task.defer(function()
			if char.Parent then
				setup(char)
			end
		end)
	end)
	if plr.Character then
		task.defer(setup, plr.Character)
	end
end
if DRIVE_PLAYERS then
	for _, plr in ipairs(Players:GetPlayers()) do
		hookPlayer(plr)
	end
	Players.PlayerAdded:Connect(hookPlayer)
end

local cam = workspace.CurrentCamera
-- one warning per rig and error (keyed by the rig table, weak: a rig dropped from `rigs` - its model gone,
-- torn down, or a respawn that makes a new rig for the same model - takes its memo with it, and a new
-- rig reports its own failures)
local warned = setmetatable({}, { __mode = "k" })
local fxWarned = {}

local function fxStep(name, fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok and not fxWarned[name] then
		fxWarned[name] = true
		warn("[Animator] " .. name .. " failed: " .. tostring(err))
	end
end

-- cost of the per-frame update (rigs + FX), readable by profilers / tests: R.stats
local stats = { frames = 0, total = 0, max = 0, rigs = 0 }
R.stats = stats
local frameNo = 0
RunService.PreSimulation:Connect(function(rawDt)
	local t = os.clock()
	frameNo += 1
	local dt = min(rawDt, 0.1)
	cam = workspace.CurrentCamera
	local camPos = cam and cam.CFrame.Position or Vector3.zero
	local localChar = player.Character
	local updated = 0
	for model, rig in pairs(rigs) do
		if not model.Parent then
			dropConns(rig)
			rigs[model] = nil
			continue
		end
		local root = rig.root
		if not root or not root.Parent then
			rig.root = model:FindFirstChild("HumanoidRootPart")
			root = rig.root
			if not root then
				continue
			end
			rig.nextGeo = 0
		end
		rig.isLocal = model == localChar
		if rig.fallback then
			-- (Roblox's animation moves this rig: selfCheck)
			local okF, errF = pcall(fallbackStep, rig)
			if not okF and not rig.fbWarned then
				rig.fbWarned = true
				warn("[Animator] " .. model.Name .. ": fallback animation failed: " .. tostring(errF))
			end
			continue
		end
		-- the rig's own frame time: the engine's dt summed over the frames since its last update (a culled, skipped
		-- or slowed rig catches up on the whole span). The wall clock (os.clock between two PreSimulations) is NOT
		-- the time the simulation advanced: it wanders with where in the frame the Lua step lands, and read as the
		-- root's travel over it the sensed speed jittered by 10-20 % a frame in Studio. (The whole hitch, uncapped: the
		-- root travelled all of it, the feet must know; the rig's update clamps it)
		rig.accDt += rawDt
		local pos = root.Position
		local dist = (pos - camPos).Magnitude
		-- (camDist for every rig, culled or not: the FX modules below cull by it without reading the parts again)
		rig.camDist, rig.camT = dist, t
		local b = (rig.isFighter or rig.isLocal) and HIGH or band
		if dist > b.cull then
			continue
		end
		local onScreen = true
		if cam and dist > 8 then
			local _, vis = cam:WorldToViewportPoint(pos)
			onScreen = vis
		end
		-- far and off-screen rigs update less often (time steps stay correct: dt is per rig)
		local step = dist > b.far and 3 or (dist > b.mid and 2 or 1)
		if not onScreen then
			step = max(step, b.off)
		end
		rig.frameSkip += 1
		local skip = rig.frameSkip < step
		if not skip then
			rig.frameSkip = 0
		end
		-- A background figure that stands its ground and moves slowly - between combinations at the bag,
		-- curling, skipping, stretching, watching from the apron - is drawn at half rate past the near band
		-- (under a tenth of the screen's height there: its motion reads the same, the gym's crowd costs a
		-- quarter less; Medium - every phone on Auto - from stillFrom, 15 studs, on) and at a sixth / an eighth
		-- off screen (only its shadow or a limb at the frame's edge can show).
		-- Never a walker (its root glides on every frame: planted feet re-solved on every other one shuffle
		-- with it, 3x the slide), never a punch, slip or step in flight or the treadmill run (a fast limb
		-- moves twice as far between two updates), never a fighter or your own character. The figures slowed
		-- here take turns by their slot (an even cost, never the whole crowd on one frame); every other rig
		-- keeps the cadence above
		if not rig.isFighter and not rig.isLocal then
			local lo, pun = rig.loco, rig.pun
			if lo.speed < 0.5 and abs(lo.yawRate) < 0.5 and not (pun.L or pun.R or rig.act or rig.autoAct) and rig.a.Pose ~= "run" then
				local slow = onScreen and (dist > (b.stillFrom or b.near) and b.still or 1) or b.stillOff
				if slow > step then
					skip = (frameNo + rig.slot) % slow ~= 0
				end
			end
		end
		if skip then
			-- (a player character's own Animate tracks write the joints every frame: a skipped frame holds
			-- our last pose instead of flashing Roblox's walk between ours)
			if rig.isPlayer and rig.outT and drives(rig) then
				local out = rig.outT
				for k, j in pairs(rig.joints) do
					local v = out[k]
					if v and j.motor.Parent then
						j.motor.Transform = v
					end
				end
			end
			continue
		end
		local rdt = clamp(rig.accDt, 1 / 240, 0.25)
		rig.accDt = 0
		-- the rig's own clock: a knockout plays its key moment in slow motion (a real-time envelope that
		-- both fighters share); a rig whose root is travelling is never slowed (its feet must keep up)
		local ts = Down.timeScale(rig, t)
		if ts < 1 and rig.loco.speed > 1.5 then
			ts = 1
		end
		rig.timeScale = ts
		local sdt = rdt * ts
		rig.clock += sdt
		local lod = (dist < b.near and onScreen) and 3 or (dist < b.mid and 2 or 1)
		updated += 1
		if not rig.writesOk then
			local okC, errC = pcall(selfCheck, rig, rdt)
			if not okC and not rig.checkWarned then
				rig.checkWarned = true
				warn("[Animator] " .. model.Name .. ": self-check failed: " .. tostring(errC))
			end
			if rig.fallback then
				continue
			end
		end
		local ok, err = pcall(updateRig, rig, model, rig.clock, sdt, lod, rdt)
		if not ok then
			-- the last good pose stays on the joints (never a frame of Roblox's own animation, or of the bind
			-- pose, between two of ours)
			if rig.outT and drives(rig) then
				local out = rig.outT
				for k, j in pairs(rig.joints) do
					local v = out[k]
					if v and j.motor.Parent then
						j.motor.Transform = v
					end
				end
			end
			-- (a different error on the same rig is reported too: at most 3 per rig, never every frame)
			local w = warned[rig]
			err = tostring(err)
			if not w or (w.n < 3 and w.last ~= err) then
				w = w or { n = 0 }
				w.n += 1
				w.last = err
				warned[rig] = w
				warn("[Animator] " .. model.Name .. ": " .. err)
			end
		end
	end
	if FaceFX then
		fxStep("FaceFX", FaceFX.Update, dt, t, camPos, rigs, 3)
	end
	if HairFX then
		fxStep("HairFX", HairFX.Update, dt, t, camPos, cam, rigs)
	end
	local cost = os.clock() - t
	stats.rigs = updated
	stats.frames += 1
	stats.total += cost
	if cost > stats.max then
		stats.max = cost
	end
end)

-- the local player's own character needs to be re-registered after respawning
player.CharacterAdded:Connect(function(char)
	for _, tag in ipairs(TAGS) do
		if CollectionService:HasTag(char, tag) then
			setup(char)
		end
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="117">
        <Properties>
          <string name="Name">BoxerClient</string>
        </Properties>
        <Item class="ModuleScript" referent="118">
          <Properties>
            <string name="Name">Activities</string>
            <string name="Source"><![CDATA[-- Activities: every training session and its minigame.
-- A session is a short structured workout: rounds or sets with rests in between, a live
-- heart-rate / calorie readout and the drill's own numbers on the panel (and on the smart
-- screens), coach technique tips during the rests, and a graded result with personal
-- bests (the server keeps the records).
--  combo     heavy bag: rhythm combinations (every punch on the beat of the last; the later ones called by number), power shots, speed burst
--  rhythm    speed bag: alternating rhythm that speeds up through the round, then doubles / triplets
--  reaction  double-end bag: react, slip & counter, then slip the bag's rebound off your own punch
--  mitts     mitt work: call & response - the coach calls the moves one at a time, feints must not be bitten on
--  shadow    mirror the coach: single moves on cue, then the called patterns copied in order
--  bench     keep the bar level as it drifts (one side is weaker), grind the sticking point, call the spotter
--  deadlift  set the back on the needle, drive through the knees, keep the grip squeezed
--  squat     sink (faster as you go) and stop in the depth zone, drive out of the hole in the bounce window
--  pullup    alternate arms through the bottom of the swing, go hollow to kill the swing
--  curls     tempo hold notes, one arm at a time (both at once is a swing)
--  medball   medicine ball: overhead slams on the pad, then a plank on the ball (shove it back in the green)
--  treadmill follow the program's speed and incline steps on the console
--  bike      a hill profile: pedal cadence in the band, gears for the gradient
--  rower     catch - drive - finish - recovery: the timing of every stroke at the piece's rate
--  ladder    stepped patterns: the drill's arrows reach the foot line on a quickening beat (reaction lights at the top level)
--  rope      basic bounce, boxer skip, double unders
--  icebath   full breaths from empty and long exhales against a cold-shock meter (cold waves)
--  stretch   four poses: hold the depth in a range that creeps deeper, never past it
--  massage   pick the sorest muscle groups off the body map, relax into the therapist's strokes
--  chamber   ride the pressure profile (pressurise / vent) and equalize the ears
--  sauna     the weight cut: stay in the heat for the water, step out before the red, sip
--  reps / pace / hold  the older shared lift / cardio / breathing drills (still playable)
--  course    roadwork loop      swim  pool lengths (both measured by the server)
-- Sparring opens the intensity picker and hands over to the fight client.
-- While you work the body shows it: Effort / LivePump (client-local attributes the Animator reads),
-- sweat drips onto the floor when your heart rate is high, the coaches react to great and sloppy
-- work, and the result screen lists every muscle part that grew, the pump and a FLEX button.
-- Gamepad: every drill plays on the controller with the fight layout (PAD_OF); VIEW / SHARE quits.
local Players = game:GetService("Players")
local GuiService = game:GetService("GuiService")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TextChatService = game:GetService("TextChatService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Catalog = require(Shared:WaitForChild("Catalog"))
local UI = require(Shared:WaitForChild("UI"))
