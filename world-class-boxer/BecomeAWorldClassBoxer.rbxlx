-- peaked referee cap (band in the venue shirt's colour, gold WCB badge), the spar coach (outfit "cornerman") a
-- baseball cap in his team colour. false = bare-headed
Config.OfficialCaps = true

-- daily growth of hair / beard (0..1.5 / 0..1) used by Training.dayTick
Config.HairGrowthPerDay = 0.02
Config.BeardGrowthPerDay = 0.02

------------------------------------------------------------------------
-- Sounds
------------------------------------------------------------------------
-- Only these ship with every Roblox client and are safe to play anywhere.
Config.BuiltinSounds = {
	Thud = "rbxasset://sounds/action_jump_land.mp3",
	Footsteps = "rbxasset://sounds/action_footsteps_plastic.mp3",
	Falling = "rbxasset://sounds/action_falling.ogg",
	Jump = "rbxasset://sounds/action_jump.mp3",
	GetUp = "rbxasset://sounds/action_get_up.mp3",
	Splash = "rbxasset://sounds/impact_water.mp3",
	SwordHit = "rbxasset://sounds/swordhit.wav",
	SwordLunge = "rbxasset://sounds/swordlunge.wav",
	Ping = "rbxasset://sounds/electronicpingshort.wav",
	Button = "rbxasset://sounds/button.wav",
	Click = "rbxasset://sounds/clickfast.wav",
	Grunt = "rbxasset://sounds/uuhhh.mp3",
}
-- Optional uploaded assets. Every entry defaults to "" and is SKIPPED when empty: the game ships
-- silent-safe (no uploaded audio can be vouched for), and code falls back to a shaped built-in from
-- Config.SoundFallbacks or to silence. Read through Config.SoundId(key) (upload only) or
-- Config.SoundSpec(key) (upload, else the shaped stand-in).
--
-- FOR THE OWNER: paste an audio asset you own or that is public on the Creator Store (Roblox-made or
-- licensed for any experience), as "rbxassetid://123456789" or just the number. Test each in Studio:
-- an id the experience may not play stays silent and only warns in the output.
--   key            where it plays                                 what to upload (length, loop)
--   CrowdMurmur    arena crowd bed, all fight night (VenueFX)      indoor crowd chatter/walla, 30-90 s seamless loop
--   CrowdRoar      arena roar swell on big shots / KDs / walkout   stadium cheer, 10-30 s loop (volume is driven)
--   CrowdOoh       crowd reaction to a hard landed shot            short "ooooh!" gasp, 1-2 s one-shot
--   CrowdBoo       crowd reaction to holding / a dull round        short boo, 2-3 s one-shot
--   RingBell       round start / end bell (venues + gym timers)    single boxing-bell ding, < 1 s (code repeats it)
--   WalkoutMusic   fighter walkout to the ring                     hype hip-hop / rock instrumental, 60 s+ loop
--   ArenaMusic     arena between rounds / before the walkout       arena PA music bed, 60 s+ loop
--   GymMusic       wall speakers in the gym                        upbeat workout instrumental, 60 s+ loop
--   CoachShout     coaches shouting instructions in the gym        short male shout ("Hey!" / "Go!"), < 1 s one-shot
--   CornerShout    your corner shouting during rounds              short urgent shout, < 1 s one-shot
--   RefereeCount   referee count over a knockdown                  one count word or a clap-like call, < 1 s (repeated)
--   Announcer      ring announcer intro                            "Let's get ready..." style intro, 3-8 s one-shot
--   BagThud / BagChain / SpeedBag / PunchImpact / BodyShot         gym and fight impacts (built-in thuds already
--                  play when empty; uploads replace them)
--   GymAmbience    gym room tone (Ambience)                        quiet gym room tone, 30 s+ loop
--   CityAmbience   city streets                                    distant traffic / city bed, 30 s+ loop
--   Heartbeat      fight heartbeat when hurt                       single low heartbeat thump, < 0.5 s
--   Breathing      heavy breathing when gassed                     exhausted breathing, 2-4 s loop
--   CameraFlash    ringside photographers                          camera shutter click, < 0.3 s
Config.SoundIds = {
	CrowdRoar = "", CrowdMurmur = "", CrowdBoo = "", CrowdOoh = "", -- arena crowd bed / reactions
	RingBell = "", -- round bell
	WalkoutMusic = "", ArenaMusic = "", GymMusic = "", -- music beds
	CoachShout = "", CornerShout = "", RefereeCount = "", Announcer = "", -- voices
	BagThud = "", BagChain = "", SpeedBag = "", PunchImpact = "", BodyShot = "", -- impacts
	GymAmbience = "", CityAmbience = "", Heartbeat = "", Breathing = "", CameraFlash = "",
}

-- an upload id in a usable form, or nil: "" / anything that is not an asset reference is skipped, a bare
-- number (or numeric string) becomes "rbxassetid://n", so a mistyped entry never errors or plays junk
function Config.SoundId(key)
	local id = Config.SoundIds[key]
	if type(id) == "number" then
		id = id == id and id > 0 and string.format("rbxassetid://%d", id) or nil
	elseif type(id) == "string" then
		id = string.gsub(id, "^%s+", "")
		id = string.gsub(id, "%s+$", "")
		if string.match(id, "^%d+$") then
			id = "rbxassetid://" .. id
		elseif not (string.match(id, "^rbxassetid://%d+$") or string.match(id, "^rbxasset://%S+$")
			or string.match(id, "^https?://www%.roblox%.com/asset/%?id=%d+$")) then
			id = nil
		end
	else
		id = nil
	end
	return id
end

-- Shaped stand-ins built from Config.BuiltinSounds for slots where a built-in can pass for the real
-- thing at a distance; false = no believable stand-in (music, spoken lines): stay silent and let the
-- speech bubble / HUD text carry it. volume is a multiplier on the caller's own level, spread a
-- random +- PlaybackSpeed share per play.
Config.SoundFallbacks = {
	CrowdMurmur = { builtin = "Footsteps", speed = 0.42, volume = 0.45, looped = true }, -- low shuffling rumble
	CrowdRoar = { builtin = "Falling", speed = 0.55, volume = 0.6, looped = true }, -- slowed wind rush
	CrowdOoh = { builtin = "Grunt", speed = 0.72, volume = 0.7, spread = 0.06 }, -- pitched-down "uuhh" = "oooh"
	CrowdBoo = { builtin = "Grunt", speed = 0.52, volume = 0.6, spread = 0.05 }, -- low "uuh" = "booo"
	RingBell = { builtin = "SwordHit", speed = 0.62, volume = 0.35, spread = 0.01 }, -- metallic ding
	CoachShout = { builtin = "Grunt", speed = 1.0, volume = 0.3, spread = 0.1 }, -- a barked "huh!"
	CornerShout = { builtin = "Grunt", speed = 1.08, volume = 0.3, spread = 0.1 },
	RefereeCount = { builtin = "Click", speed = 0.8, volume = 0.45 }, -- a tick per count (FightClient's own stand-in)
	Announcer = false, -- spoken words: text only
	WalkoutMusic = false, ArenaMusic = false, GymMusic = false, -- no built-in music
	BagThud = { builtin = "Thud", speed = 1.0, volume = 0.55, spread = 0.07 },
	BodyShot = { builtin = "Thud", speed = 0.82, volume = 0.6, spread = 0.06 },
	PunchImpact = { builtin = "Thud", speed = 1.6, volume = 0.38, spread = 0.12 },
	SpeedBag = { builtin = "Thud", speed = 2.4, volume = 0.32, spread = 0.12 },
	BagChain = { builtin = "SwordHit", speed = 1.9, volume = 0.07, spread = 0.25 },
	GymAmbience = false, -- Ambience already runs a slowed-wind HVAC bed
	CityAmbience = { builtin = "Falling", speed = 0.4, volume = 0.08, looped = true }, -- distant wind / traffic hush
	Heartbeat = { builtin = "Thud", speed = 0.55, volume = 0.5 },
	Breathing = false,
	CameraFlash = { builtin = "Click", speed = 1.4, volume = 0.25, spread = 0.1 }, -- shutter click
}

-- slots that are beds (looped) whether uploaded or stood in for
local LOOPED_SOUNDS = {
	CrowdMurmur = true, CrowdRoar = true, WalkoutMusic = true, ArenaMusic = true, GymMusic = true,
	GymAmbience = true, CityAmbience = true, Breathing = true,
}

-- (key) -> { id, speed, volume, looped, spread, uploaded } or nil (stay silent). An upload plays
-- unshaped (speed 1, volume 1); otherwise the Config.SoundFallbacks stand-in. Never errors.
function Config.SoundSpec(key)
	local id = Config.SoundId(key)
	if id then
		return { id = id, speed = 1, volume = 1, spread = 0, looped = LOOPED_SOUNDS[key] == true, uploaded = true }
	end
	local fb = Config.SoundFallbacks[key]
	local bid = type(fb) == "table" and Config.BuiltinSounds[fb.builtin] or nil
	if not bid then
		return nil
	end
	return {
		id = bid, speed = tonumber(fb.speed) or 1, volume = tonumber(fb.volume) or 1, spread = tonumber(fb.spread) or 0,
		looped = fb.looped == true or LOOPED_SOUNDS[key] == true, uploaded = false,
	}
end

------------------------------------------------------------------------
-- Helpers
------------------------------------------------------------------------
function Config.FindById(list, id)
	for _, item in ipairs(list) do
		if item.id == id or item.name == id then
			return item
		end
	end
	return nil
end

function Config.WeightClassIndex(name)
	for i, wc in ipairs(Config.WeightClasses) do
		if wc.name == name then
			return i
		end
	end
	return 5
end

function Config.HeightText(inches)
	inches = math.floor(inches + 0.5)
	return string.format("%d'%d\"", math.floor(inches / 12), inches % 12)
end

-- a whole number 0 .. 2^31 - 1 from a string (FNV-1a folded to 31 bits): the same on every server and in every
-- version of the engine, unlike Random's stream
local function keyHash(str)
	local h = 2166136261
	for i = 1, #str do
		h = bit32.bxor(h, string.byte(str, i))
		-- (x 16777619 = x 2^24 + x 403, mod 2^32, kept under 2^53 so the double stays exact)
		h = ((h % 256) * 16777216 + h * 403) % 4294967296
	end
	return h % 2147483647
end
Config.KeyHash = keyHash
-- the n-th uniform 0..1 of a key (deterministic)
local function keyUniform(key, n)
	return (keyHash(key .. "#" .. n) + 0.5) / 2147483647
end

-- an AI boxer's height in whole inches, deterministic: key = what identifies him (World: his id and name), ci = his
-- weight class index, female = bool. A normal draw round his division's mean (Config.BoxerHeights), clamped to the
-- field's range
function Config.BoxerHeight(key, ci, female)
	key = tostring(key or "")
	local row = Config.BoxerHeights[math.clamp(math.floor(tonumber(ci) or 5), 1, #Config.BoxerHeights)]
	local mean, sd = row[1], row[2]
	if female then
		mean, sd = mean - 5, sd * 0.9
	end
	-- (Box-Muller off two of the key's uniforms)
	local u1, u2 = keyUniform(key, 1), keyUniform(key, 2)
	local z = math.sqrt(-2 * math.log(u1)) * math.cos(2 * math.pi * u2)
	local lim = female and Config.BoxerHeightRange.women or Config.BoxerHeightRange.men
	-- (a draw past the field's edge is folded back inside it, not piled up on the edge: no division of 5'4" men)
	local h = mean + z * sd
	if h < lim[1] then
		h = lim[1] + (lim[1] - h) * 0.5
	elseif h > lim[2] + 0.49 then
		h = lim[2] - (h - lim[2]) * 0.5
	end
	return math.clamp(math.floor(h + 0.5), lim[1], lim[2])
end

-- the nickname a boxer of `inches` goes by: a tall one from Config.TallNicknames (deterministic by key; "%s" takes the
-- first name's initial), else nil (keep his own)
function Config.TallNick(key, inches, first)
	if (tonumber(inches) or 0) < Config.TALL_INCHES then
		return nil
	end
	key = tostring(key or "")
	local list = Config.TallNicknames
	local pick = list[math.clamp(math.floor(keyUniform(key, 3) * #list) + 1, 1, #list)]
	if pick:find("%s", 1, true) then
		local initial = string.upper(string.sub(tostring(first or ""), 1, 1))
		pick = initial:match("%a") and string.format(pick, initial) or "Big"
	end
	return pick
end
function Config.IsTallNick(nick)
	nick = tostring(nick or "")
	for _, w in ipairs({ "Big", "Tower", "Skyscraper", "Long", "Giant" }) do
		if nick:find(w, 1, true) then
			return true
		end
	end
	return false
end

function Config.Money(n)
	n = math.floor(n or 0)
	local s = tostring(math.abs(n))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return (n < 0 and "-$" or "$") .. out
end

-- grade letter (S/A/B/C/D) for a session quality
function Config.GradeFor(quality)
	local q = tonumber(quality) or 0
	for _, g in ipairs(Config.Grades) do
		if q >= g.min then
			return g.id
		end
	end
	return "D"
end

function Config.GradeInfo(id)
	for _, g in ipairs(Config.Grades) do
		if g.id == id then
			return g
		end
	end
	return Config.Grades[#Config.Grades]
end

-- session quality as the percentage the player sees (a perfect drill = 100%)
function Config.QualityPct(quality)
	local q = tonumber(quality) or 0
	if q ~= q then
		q = 0
	end
	return math.clamp(math.floor(q * 100 / 1.45 + 0.5), 0, 100)
end

function Config.Overall(stats)
	local total = 0
	for _, k in ipairs(Config.StatKeys) do
		total += stats[k] or 0
	end
	return math.floor(total / #Config.StatKeys + 0.5)
end

------------------------------------------------------------------------
-- Lighting: the global look (MapBuilder applies it; Ambience / VenueFX layer the per-place exposure and
-- grades on top; tools/sim/world_scene.luau exports it for the offline previews). Technology stays Future
-- (build.py sets it). The brief: bright, vivid and colourful by day, warm sun, lifted ambient so no interior
-- ever goes muddy, a saturated grade with a touch of bloom on the emissives.
------------------------------------------------------------------------
Config.Lighting = {
	-- Lighting service properties (a bright, warm early afternoon)
	Global = {
		ClockTime = 13.6, GeographicLatitude = 34,
		Brightness = 4.4, ExposureCompensation = 0.35,
		Ambient = { 156, 150, 146 }, OutdoorAmbient = { 166, 178, 204 },
		ColorShift_Top = { 255, 234, 196 }, ColorShift_Bottom = { 196, 214, 244 },
		EnvironmentDiffuseScale = 1, EnvironmentSpecularScale = 0.8, ShadowSoftness = 0.38,
	},
	-- the global grade (ColorCorrectionEffect "GymGrade"), bloom and sun rays
	Grade = { Brightness = 0.04, Contrast = 0.1, Saturation = 0.25, TintColor = { 255, 248, 238 } },
	Bloom = { Intensity = 0.5, Size = 34, Threshold = 1.2 },
	SunRays = { Intensity = 0.14, Spread = 0.8 },
	-- a thin, bright atmosphere with a saturated sky and a little glow round the sun
	Atmosphere = { Density = 0.2, Offset = 0.32, Color = { 228, 236, 250 }, Decay = { 96, 150, 230 }, Glare = 0.42, Haze = 1.9 },
	Sky = { SunAngularSize = 16, MoonAngularSize = 11, StarCount = 1500 },
	Clouds = { Cover = 0.34, Density = 0.45, Color = { 255, 255, 255 } },
	-- after dark (Ambience eases to these once the day cycle passes dusk): a colourful blue night, not grey
	Night = { OutdoorAmbient = { 82, 98, 164 }, Ambient = { 120, 118, 140 }, AtmosphereColor = { 150, 130, 200 }, AtmosphereDecay = { 40, 48, 120 } },
}
-- (r, g, b) tables above -> Color3 (a Color3 passes through)
function Config.LightingColor(c)
	if typeof(c) == "Color3" then
		return c
	end
	return Color3.fromRGB(c[1], c[2], c[3])
end

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="58">
        <Properties>
          <string name="Name">Diag</string>
          <string name="Source"><![CDATA[-- Diag: the in-game rig diagnostic ("/wcbdiag" in chat, Settings -> GAME -> COPY DIAGNOSTIC TO OUTPUT). Pure: given a
-- character model (and what the caller knows about it: the Animator's rig table on a client, a motion sample) it
-- returns the lines the caller prints, one block per model, every line prefixed [WCBDIAG]. Nothing here runs unless
-- invoked. It reports what the engine really built so a Studio report carries numbers, not impressions:
--  * every body part: class, Size, OriginalSize, mesh id, BodyTier / BodyLite / BodyRatio; the Head's class, its
--    SpecialMesh or MeshId and the face decal
--  * the Humanoid: HipHeight (against the legs' own, BuilderTiers.HipHeight), RigType, AutomaticScalingEnabled, the
--    applied description's scales, the scale values, the Animate script, the playing tracks
--  * every Motor6D: Part0 / Part1, C0 / C1 next to the RigAttachments they should equal, the live Transform, and -
--    for a tier part - the attachment position BodyAssetData expects (OriginalPosition x the part's scale)
--  * the bind-pose joint heights above the sole, next to BodyAssetData.unit's (x the height scale)
--  * BoxerLook: the headgear / cap parts (size, offset from the head), the attire pieces (part, size, offset)
--  * the Animator's view (client): AnimRig geo, LOD, state, and a motion sample (DiagClient takes it)
--  * a VERDICT line per check, OK or a plain description of what is off
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local BodyTiers = require(Shared:WaitForChild("BodyTiers"))
local BuilderTiers = require(Shared:WaitForChild("BuilderTiers"))
-- [Studio] the joints may be Motor6Ds or AnimationConstraints (StarterPlayer.AvatarJointUpgrade): one lookup for both
local RigJoints = require(Shared:WaitForChild("RigJoints"))

local Diag = {}
Diag.PREFIX = "[WCBDIAG] "
Diag.VERSION = 2 -- (2: the sample reports written vs shown joint angles and the Animator's mode)

local PARTS = { "HumanoidRootPart", "LowerTorso", "UpperTorso", "Head", "LeftUpperArm", "LeftLowerArm", "LeftHand", "RightUpperArm",
	"RightLowerArm", "RightHand", "LeftUpperLeg", "LeftLowerLeg", "LeftFoot", "RightUpperLeg", "RightLowerLeg", "RightFoot" }
local MOTORS = { "Root", "Waist", "Neck", "LeftShoulder", "LeftElbow", "LeftWrist", "RightShoulder", "RightElbow", "RightWrist",
	"LeftHip", "LeftKnee", "LeftAnkle", "RightHip", "RightKnee", "RightAnkle" }
local MOTOR_PARENT = { Root = "LowerTorso", Waist = "UpperTorso", Neck = "Head", LeftShoulder = "LeftUpperArm", LeftElbow = "LeftLowerArm",
	LeftWrist = "LeftHand", RightShoulder = "RightUpperArm", RightElbow = "RightLowerArm", RightWrist = "RightHand", LeftHip = "LeftUpperLeg",
	LeftKnee = "LeftLowerLeg", LeftAnkle = "LeftFoot", RightHip = "RightUpperLeg", RightKnee = "RightLowerLeg", RightAnkle = "RightFoot" }
local SCALE_VALUES = { "BodyHeightScale", "BodyWidthScale", "BodyDepthScale", "HeadScale", "BodyProportionScale", "BodyTypeScale" }

local function f2(x)
	return string.format("%.2f", x)
end
local function v3(v)
	if typeof(v) ~= "Vector3" then
		return tostring(v)
	end
	return string.format("(%.2f,%.2f,%.2f)", v.X, v.Y, v.Z)
end
local function v3f(v)
	return string.format("(%.3f,%.3f,%.3f)", v.X, v.Y, v.Z)
end
local function ang(cf)
	local x, y, z = cf:ToEulerAnglesXYZ()
	return string.format("%d/%d/%d", math.floor(math.deg(x) + 0.5), math.floor(math.deg(y) + 0.5), math.floor(math.deg(z) + 0.5))
end
local function cfs(cf)
	if typeof(cf) ~= "CFrame" then
		return tostring(cf)
	end
	return v3f(cf.Position) .. "r" .. ang(cf)
end
local function get(obj, k)
	local ok, v = pcall(function()
		return obj[k]
	end)
	if ok then
		return v
	end
	return nil
end
local function attr(obj, k)
	local ok, v = pcall(obj.GetAttribute, obj, k)
	return ok and v or nil
end
local function fullName(inst)
	local ok, n = pcall(inst.GetFullName, inst)
	return ok and n or tostring(inst)
end

------------------------------------------------------------------------
-- the pieces
------------------------------------------------------------------------
local function partLine(model, name)
	local p = model:FindFirstChild(name)
	if not (p and p:IsA("BasePart")) then
		return string.format("part %-16s MISSING", name)
	end
	local o = p:FindFirstChild("OriginalSize")
	local orig = (o and o:IsA("Vector3Value")) and o.Value or nil
	local mesh = ""
	if p:IsA("MeshPart") then
		mesh = " mesh=" .. tostring(get(p, "MeshId") or ""):gsub("rbxassetid://", "")
	else
		local sm = p:FindFirstChildOfClass("SpecialMesh")
		if sm then
			mesh = string.format(" SpecialMesh=%s scale=%s meshId=%s", tostring(sm.MeshType and sm.MeshType.Name or sm.MeshType), v3(sm.Scale),
				tostring(sm.MeshId or ""):gsub("rbxassetid://", ""))
		end
	end
	local tier = attr(p, "BodyTier")
	local extra = ""
	if tier ~= nil then
		local okE, e = pcall(BodyTiers.PartEntry, tonumber(tier), name, nil, attr(p, "BodyLite") == true)
		local want = okE and e and tostring(e.id) or "?"
		local have = p:IsA("MeshPart") and tostring(get(p, "MeshId") or ""):gsub("rbxassetid://", "") or "-"
		extra = string.format(" tier=%s%s ratio=%s expectMesh=%s%s", tostring(tier), attr(p, "BodyLite") and " lite" or "", v3(attr(p, "BodyRatio")), want,
			(have == want or want == "?") and "" or " MISMATCH")
	end
	extra ..= " color=" .. (typeof(p.Color) == "Color3" and string.format("%d,%d,%d", p.Color.R * 255, p.Color.G * 255, p.Color.B * 255) or "?")
	if name == "Head" then
		local decals = {}
		for _, d in ipairs(p:GetChildren()) do
			if d:IsA("Decal") then
				table.insert(decals, d.Name .. ":" .. tostring(d.Texture or ""):gsub("rbxassetid://", ""))
			end
		end
		extra ..= " decals=[" .. table.concat(decals, " ") .. "]"
	end
	return string.format("part %-16s %-8s size=%s orig=%s%s%s anch=%s coll=%s massless=%s", name, p.ClassName, v3(p.Size), orig and v3(orig) or "-",
		mesh, extra, tostring(get(p, "Anchored")), tostring(get(p, "CanCollide")), tostring(get(p, "Massless")))
end

-- what BodyAssetData expects for an attachment on a tier part: OriginalPosition x the part's ratio (nil when unknown)
local function expectedAtt(part, attName)
	local tier = tonumber(attr(part, "BodyTier"))
	if not tier then
		return nil
	end
	local ok, e = pcall(BodyTiers.PartEntry, tier, part.Name, nil, attr(part, "BodyLite") == true)
	local pos = ok and e and e.attachments and e.attachments[attName]
	if not pos then
		return nil
	end
	local ratio = BuilderTiers.RatioOf(part) or attr(part, "BodyRatio")
	if typeof(ratio) ~= "Vector3" then
		return nil
	end
	return Vector3.new(pos[1] * ratio.X, pos[2] * ratio.Y, pos[3] * ratio.Z)
end

local function motorLine(model, name, verdicts)
	local m = RigJoints.Find(model, name)
	if not m then
		table.insert(verdicts, "BAD  joint " .. name .. " is missing (no Motor6D, no AnimationConstraint): the Animator cannot drive this joint")
		return string.format("motor %-13s MISSING", name)
	end
	local holder = model:FindFirstChild(MOTOR_PARENT[name])
	local where = m.Parent ~= holder and (" under " .. fullName(m.Parent) .. " (not where the R15 rig keeps it)") or ""
	local p0, p1 = RigJoints.Parts(m)
	local C0, C1 = RigJoints.C0(m), RigJoints.C1(m)
	local an = name .. "RigAttachment"
	local a0 = p0 and p0:FindFirstChild(an)
	local a1 = p1 and p1:FindFirstChild(an)
	local s = string.format("motor %-13s %s %s->%s C0=%s C1=%s T=%s%s", name, m.ClassName, p0 and p0.Name or "nil", p1 and p1.Name or "nil", cfs(C0), cfs(C1),
		cfs(m.Transform), where)
	if a0 and a0:IsA("Attachment") then
		local d = (C0.Position - a0.CFrame.Position).Magnitude
		s ..= string.format(" att0=%s d=%.3f", v3f(a0.CFrame.Position), d)
		if d > 0.02 then
			table.insert(verdicts, string.format("BAD  %s.C0 is %.3f studs off %s.%s: the joint is not aimed at its RigAttachment", name, d, p0.Name, an))
		end
		local e0 = p0 and expectedAtt(p0, an)
		if e0 then
			local de = (a0.CFrame.Position - e0).Magnitude
			s ..= string.format(" exp0=%s d=%.3f", v3f(e0), de)
			if de > 0.02 then
				table.insert(verdicts, string.format("BAD  %s.%s is %.3f studs from where BodyAssetData puts it (%s): the part was scaled differently from its attachments", p0.Name, an, de, v3f(e0)))
			end
		end
	else
		s ..= " att0=MISSING"
	end
	if a1 and a1:IsA("Attachment") then
		local d = (C1.Position - a1.CFrame.Position).Magnitude
		s ..= string.format(" att1=%s d=%.3f", v3f(a1.CFrame.Position), d)
		if d > 0.02 then
			table.insert(verdicts, string.format("BAD  %s.C1 is %.3f studs off %s.%s: the joint is not aimed at its RigAttachment", name, d, p1.Name, an))
		end
		local e1 = p1 and expectedAtt(p1, an)
		if e1 then
			local de = (a1.CFrame.Position - e1).Magnitude
			s ..= string.format(" exp1=%s d=%.3f", v3f(e1), de)
			if de > 0.02 then
				table.insert(verdicts, string.format("BAD  %s.%s is %.3f studs from where BodyAssetData puts it (%s): the part was scaled differently from its attachments", p1.Name, an, de, v3f(e1)))
			end
		end
	else
		s ..= " att1=MISSING"
	end
	return s
end

-- the bind pose (every Transform identity): each part's CFrame in HumanoidRootPart space, from the Motor6D chain
local function bindPose(model)
	local out = { HumanoidRootPart = CFrame.identity }
	local joints = {}
	for _, name in ipairs(MOTORS) do
		local m = RigJoints.Find(model, name)
		local p0, p1 = RigJoints.Parts(m)
		if m and p0 and p1 then
			table.insert(joints, { p0 = p0, p1 = p1, cf = RigJoints.C0(m) * RigJoints.C1(m):Inverse() })
		end
	end
	for _ = 1, #joints do
		for _, j in ipairs(joints) do
			local base = out[j.p0.Name]
			if base and not out[j.p1.Name] then
				out[j.p1.Name] = base * j.cf
			end
		end
	end
	return out
end

local function lookLines(model, lines, verdicts)
	local look = model:FindFirstChild("BoxerLook")
	local head = model:FindFirstChild("Head")
	if not look then
		table.insert(lines, "look: no BoxerLook folder")
		return
	end
	local names = {}
	for _, f in ipairs(look:GetChildren()) do
		local n = 0
		for _, d in ipairs(f:GetDescendants()) do
			if d:IsA("BasePart") then
				n += 1
			end
		end
		table.insert(names, string.format("%s(%d parts, Detail=%s)", f.Name, n, tostring(attr(f, "Detail"))))
	end
	table.insert(lines, "look folders: " .. table.concat(names, " ") .. " | Hands attr=" .. tostring(attr(model, "Hands")) .. " Outfit=" .. tostring(attr(model, "Outfit"))
		.. " HeadgearColor=" .. tostring(attr(model, "HeadgearColor")) .. " HeadgearCorner=" .. tostring(attr(model, "HeadgearCorner")))
	-- the hands: gloves / wraps, each welded to a hand or forearm
	local hands = look:FindFirstChild("Hands")
	if hands then
		local n, loose, kinds = 0, 0, {}
		for _, p in ipairs(hands:GetDescendants()) do
			if p:IsA("BasePart") then
				n += 1
				local w = p:FindFirstChildOfClass("WeldConstraint") or p:FindFirstChildOfClass("Weld")
				local to = w and ((w.Part0 == p and w.Part1) or w.Part0)
				if not (to and to.Parent) then
					loose += 1
				end
				local k = p.Name:gsub("[LR]$", "")
				kinds[k] = (kinds[k] or 0) + 1
				if n <= 10 then
					table.insert(lines, string.format("hands %-14s %-8s size=%s on=%s color=%d,%d,%d mesh=%s", p.Name, p.ClassName, v3(p.Size), to and to.Name or "NONE",
						p.Color.R * 255, p.Color.G * 255, p.Color.B * 255, p:IsA("MeshPart") and tostring(get(p, "MeshId") or ""):gsub("rbxassetid://", "") or "-"))
				end
			end
		end
		local kl = {}
		for k, c in pairs(kinds) do
			table.insert(kl, k .. "x" .. c)
		end
		table.sort(kl)
		table.insert(lines, string.format("hands: %d parts (%s), %d welded to nothing", n, table.concat(kl, " "), loose))
		if n == 0 then
			table.insert(verdicts, "BAD  the Hands folder is empty: no gloves / wraps built")
		elseif loose > 0 then
			table.insert(verdicts, string.format("BAD  %d hand pieces are welded to nothing (they fall or stay behind)", loose))
		else
			table.insert(verdicts, string.format("OK   hands: %d pieces (%s) welded", n, table.concat(kl, " ")))
		end
	else
		table.insert(verdicts, "BAD  no Hands folder: the gloves / wraps step never ran (or was removed)")
	end
	-- HEADGEAR block: the live head (class, Size, its span = the smallest axis every head-worn part is sized from, the
	-- SpecialMesh's type / Scale or the MeshPart's id / MeshSize) against what the gear folders were fitted to (their
	-- HeadSize / HeadClass / HeadMesh), every gear part's offset and size in head spans and its weld's class and
	-- Part0 / Part1; a VERDICT per folder: detached (no weld), welded to a head no longer in the model, fitted to
	-- another head, or OK
	local liveHead = head and head:IsA("BasePart") and head or nil
	local hs = liveHead and math.min(liveHead.Size.X, liveHead.Size.Y, liveHead.Size.Z) or 0
	if liveHead then
		local sm = liveHead:FindFirstChildOfClass("SpecialMesh")
		table.insert(lines, string.format("HEADGEAR head %s size=%s span=%.3f mesh=%s meshScale=%s meshSize=%s HeadSizeAtBuild=%s refits=%s last=%s",
			liveHead.ClassName, v3f(liveHead.Size), hs,
			sm and tostring(get(sm, "MeshType")):gsub("^Enum%.MeshType%.", "") or (liveHead:IsA("MeshPart") and tostring(get(liveHead, "MeshId") or ""):gsub("rbxassetid://", "") or "none"),
			sm and v3(get(sm, "Scale")) or "-", liveHead:IsA("MeshPart") and v3(get(liveHead, "MeshSize")) or "-",
			v3(attr(model, "HeadSizeAtBuild")), tostring(attr(model, "HeadgearRefits") or 0), tostring(attr(model, "HeadgearRefitLast"))))
	else
		table.insert(lines, "HEADGEAR head MISSING")
	end
	for _, fname in ipairs({ "Headgear", "Hat" }) do
		local f = look:FindFirstChild(fname)
		if f then
			local n, inside, shell, loose, otherHead, far = 0, 0, nil, 0, 0, 0
			for _, p in ipairs(f:GetDescendants()) do
				if p:IsA("BasePart") then
					n += 1
					local rel = liveHead and liveHead.CFrame:ToObjectSpace(p.CFrame) or p.CFrame
					local w = p:FindFirstChildOfClass("Weld") or p:FindFirstChildOfClass("WeldConstraint")
					local to = w and ((w.Part0 == p and w.Part1) or w.Part0)
					local w0, w1 = w and w.Part0, w and w.Part1
					if not (w and w0 and w1) then
						loose += 1
					elseif liveHead and w0 ~= liveHead and w1 ~= liveHead then
						otherHead += 1
					end
					if liveHead and rel.Position.Magnitude > liveHead.Size.X * 2 then
						far += 1
					end
					if n <= 12 then
						table.insert(lines, string.format("%s %-12s %-8s size=%s relHead=%s color=%d,%d,%d massless=%s coll=%s weld->%s", fname:lower(), p.Name, p.ClassName,
							v3(p.Size), cfs(rel), p.Color.R * 255, p.Color.G * 255, p.Color.B * 255, tostring(p.Massless), tostring(p.CanCollide), to and to.Name or "NONE"))
						table.insert(lines, string.format("HEADGEAR %s %-12s spans off=%s size=%s weld=%s Part0=%s%s Part1=%s", fname, p.Name,
							hs > 0 and v3f(rel.Position / hs) or "-", hs > 0 and v3f(p.Size / hs) or "-", w and w.ClassName or "NONE",
							w0 and w0.Name or "nil", (w0 and liveHead and w0 ~= liveHead and w0.Name == "Head") and "(NOT the live Head)" or "",
							w1 and w1.Name or "nil"))
					end
					if p.Name == "HGShell" or p.Name == "CapCrown" or p.Name == "Crown" then
						shell = p
					end
					if liveHead and rel.Position.Magnitude < liveHead.Size.X * 0.25 and p.Size.X < liveHead.Size.X * 0.9 then
						inside += 1
					end
				end
			end
			table.insert(lines, string.format("%s: %d parts, %d of them small and centred in the head", fname:lower(), n, inside))
			local fitSize = attr(f, "HeadSize")
			table.insert(lines, string.format("HEADGEAR %s fitted to HeadSize=%s HeadClass=%s HeadMesh=%s Detail=%s Sig=%s; live: %d parts, %d no weld, %d on another head, %d far from the head",
				fname, v3(fitSize), tostring(attr(f, "HeadClass")), tostring(attr(f, "HeadMesh")), tostring(attr(f, "Detail")), tostring(attr(f, "Sig")), n, loose, otherHead, far))
			if n > 0 then
				if loose > 0 then
					table.insert(verdicts, string.format("BAD  %s detached: %d parts with no weld%s (the Humanoid died with BreakJointsOnDeath or the rig broke; they fall or stay behind)", fname:lower(), loose,
						far > 0 and string.format(", %d of them more than 2 heads away", far) or ""))
				elseif otherHead > 0 then
					table.insert(verdicts, string.format("BAD  %s welded to a head that is no longer in the model (%d parts): the engine replaced the Head after the gear was fitted", fname:lower(), otherHead))
				elseif liveHead and typeof(fitSize) == "Vector3" and (fitSize - liveHead.Size).Magnitude > 1e-3 then
					table.insert(verdicts, string.format("BAD  %s fitted to a %s head, the head is now %s: the head was rescaled after the gear was built and no re-fit ran", fname:lower(), v3(fitSize), v3(liveHead.Size)))
				elseif liveHead and type(attr(f, "HeadClass")) == "string" and attr(f, "HeadClass") ~= liveHead.ClassName then
					table.insert(verdicts, string.format("BAD  %s fitted to a %s head, the head is now a %s", fname:lower(), tostring(attr(f, "HeadClass")), liveHead.ClassName))
				elseif far > 0 then
					table.insert(verdicts, string.format("BAD  %s: %d parts more than 2 heads away from the head although welded (the weld's C0 is wrong)", fname:lower(), far))
				else
					table.insert(verdicts, string.format("OK   %s: %d parts welded to the live head, fitted to its size", fname:lower(), n))
				end
			end
			if shell and head and head:IsA("BasePart") then
				local hs = math.min(head.Size.X, head.Size.Y, head.Size.Z)
				if shell.Size.X < hs * 0.98 then
					table.insert(verdicts, string.format("BAD  %s %s (%.2f wide) is narrower than the head (%.2f): the %s sits inside the skull", fname, shell.Name,
						shell.Size.X, hs, fname:lower()))
				else
					table.insert(verdicts, string.format("OK   %s %s %.2f wide over a %.2f head", fname, shell.Name, shell.Size.X, hs))
				end
			end
		end
	end
	local att = look:FindFirstChild("Attire")
	if att then
		local fa = {}
		for k, v in pairs(att:GetAttributes()) do
			table.insert(fa, k .. "=" .. tostring(v))
		end
		table.sort(fa)
		table.insert(lines, "attire attributes: " .. table.concat(fa, " "))
		local n = 0
		for _, p in ipairs(att:GetDescendants()) do
			if p:IsA("BasePart") then
				n += 1
				local w = p:FindFirstChildOfClass("WeldConstraint") or p:FindFirstChildOfClass("Weld")
				local to = w and ((w.Part0 == p and w.Part1) or w.Part0)
				local rel = to and to:IsA("BasePart") and to.CFrame:ToObjectSpace(p.CFrame) or nil
				if n <= 16 then
					table.insert(lines, string.format("attire %-14s %-8s size=%s on=%s off=%s", p.Name, p.ClassName, v3(p.Size), to and to.Name or "NONE",
						rel and v3f(rel.Position) or "-"))
				end
				if not to then
					table.insert(verdicts, "BAD  attire piece " .. p.Name .. " is welded to nothing")
				end
			end
		end
		table.insert(lines, string.format("attire: %d parts", n))
		if n == 0 then
			table.insert(verdicts, "BAD  the Attire folder is empty: no trunks / outfit built")
		end
	else
		table.insert(verdicts, "BAD  no Attire folder: the attire step never ran (or was removed)")
	end
end

local function humanoidLines(model, hum, lines, verdicts)
	if not hum then
		table.insert(lines, "humanoid: NONE")
		table.insert(verdicts, "BAD  no Humanoid")
		return
	end
	local hh = hum.HipHeight
	local root = model:FindFirstChild("HumanoidRootPart")
	local legs = BuilderTiers.HipHeight(model)
	local desc
	pcall(function()
		desc = hum:GetAppliedDescription()
	end)
	local ds = desc and string.format("H%.2f W%.2f D%.2f Head%.2f Prop%.2f Type%.2f", desc.HeightScale, desc.WidthScale, desc.DepthScale, desc.HeadScale,
		desc.ProportionScale, desc.BodyTypeScale) or "n/a"
	local sv = {}
	for _, n in ipairs(SCALE_VALUES) do
		local v = hum:FindFirstChild(n)
		if v and v:IsA("NumberValue") then
			table.insert(sv, n:gsub("Body", ""):gsub("Scale", "") .. "=" .. f2(v.Value))
		end
	end
	local animate = model:FindFirstChild("Animate")
	local tracks = {}
	local animator = hum:FindFirstChildOfClass("Animator")
	if animator then
		pcall(function()
			for _, tr in ipairs(animator:GetPlayingAnimationTracks()) do
				table.insert(tracks, (tr.Name ~= "" and tr.Name or (tr.Animation and tr.Animation.Name) or "?") .. ":" .. f2(tr.Weight or 0))
			end
		end)
	end
	table.insert(lines, string.format("humanoid HipHeight=%.3f legsSay=%s RigType=%s AutoScale=%s state=%s WalkSpeed=%.1f AutoRotate=%s PlatformStand=%s EvalSM=%s",
		hh, legs and f2(legs) or "n/a", tostring(hum.RigType and hum.RigType.Name), tostring(get(hum, "AutomaticScalingEnabled")),
		tostring(get(hum, "GetState") and hum:GetState().Name or "?"), hum.WalkSpeed, tostring(hum.AutoRotate), tostring(hum.PlatformStand),
		tostring(get(hum, "EvaluateStateMachine"))))
	table.insert(lines, string.format("description %s | values %s | Animate=%s Animator=%s tracks=[%s] ProcAnim=%s", ds, table.concat(sv, " "),
		animate and (animate.ClassName .. (get(animate, "Disabled") and " DISABLED" or " ENABLED")) or "none", animator and "yes" or "NO",
		table.concat(tracks, " "), tostring(attr(model, "ProcAnim"))))
	if root and root:IsA("BasePart") then
		table.insert(lines, string.format("root pos=%s vel=%s size=%s anchored=%s", v3(root.Position), v3(root.AssemblyLinearVelocity), v3(root.Size),
			tostring(root.Anchored)))
	end
	if legs then
		if math.abs(legs - hh) <= 0.05 then
			table.insert(verdicts, string.format("OK   HipHeight %.2f vs the legs' own %.2f", hh, legs))
		else
			table.insert(verdicts, string.format("BAD  HipHeight %.2f vs the legs' own %.2f: the body stands %.2f studs %s the floor", hh, legs, math.abs(legs - hh),
				hh > legs and "above" or "into"))
		end
	end
	if #tracks > 0 then
		table.insert(verdicts, "BAD  Animate track(s) playing [" .. table.concat(tracks, " ") .. "]: a second writer on the joints (the Animator stops them; they came back)")
	else
		table.insert(verdicts, "OK   no Animate tracks playing")
	end
	if animate and get(animate, "Disabled") == false and attr(model, "ProcAnim") == true then
		table.insert(verdicts, "BAD  the Animate script is ENABLED on a procedurally driven character")
	end
end

------------------------------------------------------------------------
-- Report
------------------------------------------------------------------------
-- ctx (all optional): label, side ("client" | "server"), rig (the Animator's rig table), sample (DiagClient's motion
-- sample lines), unit (BodyAssetData.unit for the height comparison; BodyTiers.Data().unit by default)
function Diag.Report(model, ctx)
	ctx = ctx or {}
	local lines, verdicts = {}, {}
	local hum = model:FindFirstChildOfClass("Humanoid")
	local inGame = false
	pcall(function()
		inGame = model:IsDescendantOf(game)
	end)
	local tags = {}
	pcall(function()
		tags = game:GetService("CollectionService"):GetTags(model)
	end)
	table.insert(lines, string.format("== %s %q at %s | side=%s inDataModel=%s tags=[%s] BodyTiers=%s Detail=%s ScaleKey=%s AvatarFace=%s", ctx.label or "MODEL",
		model.Name, fullName(model.Parent or model), ctx.side or "?", tostring(inGame), table.concat(tags, ","), tostring(attr(model, "BodyTiers")),
		tostring(attr(model, "Detail")), tostring(attr(model, "ScaleKey")), tostring(attr(model, "AvatarFace"))))
	humanoidLines(model, hum, lines, verdicts)
	for _, name in ipairs(PARTS) do
		table.insert(lines, partLine(model, name))
	end
	-- the head: the classic head (a Part with the Head SpecialMesh) unless the rig keeps a player's avatar face; its size now
	-- against the size the layers (headgear, face) were fitted to, and the HipHeight now against the build's
	local head = model:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		local hb, hhb, refix = attr(model, "HeadSizeAtBuild"), attr(model, "HipHeightAtBuild"), attr(model, "HipHeightRefixed")
		local headScale = "?"
		pcall(function()
			local d = hum and hum:GetAppliedDescription()
			if d then
				headScale = f2(d.HeadScale)
			end
		end)
		table.insert(lines, string.format("head size now=%s atBuild=%s HeadScale=%s | HipHeight now=%s atBuild=%s refixedLater=%s", v3(head.Size),
			typeof(hb) == "Vector3" and v3(hb) or "n/a", headScale, hum and f2(hum.HipHeight) or "?", hhb and f2(hhb) or "n/a", refix and f2(refix) or "no"))
		if typeof(hb) == "Vector3" and (hb - head.Size).Magnitude > 1e-3 then
			table.insert(verdicts, string.format("BAD  the Head changed size after the layers were built (%s -> %s): the headgear / face were fitted to the old size",
				v3(hb), v3(head.Size)))
		elseif typeof(hb) == "Vector3" then
			table.insert(verdicts, "OK   the Head is the size the layers were built for")
		end
		if hum and type(hhb) == "number" and math.abs(hhb - hum.HipHeight) > 0.01 then
			table.insert(verdicts, string.format("BAD  HipHeight changed since the build (%.2f -> %.2f%s): something re-set it after Builder", hhb, hum.HipHeight,
				refix and ", re-fixed later to " .. f2(refix) or ""))
		end
		if refix then
			table.insert(verdicts, string.format("BAD  Builder had to put HipHeight back to %.2f after the build: the engine's scaling pass changed it", refix))
		end
		local sm = head:FindFirstChildOfClass("SpecialMesh")
		if attr(model, "AvatarFace") == true then
			table.insert(verdicts, "OK   Head kept as the avatar's (" .. head.ClassName .. ")")
		elseif head:IsA("MeshPart") then
			table.insert(verdicts, "BAD  Head is a MeshPart (expected Part + SpecialMesh Head): the classic head swap did not take; the face / headgear are built for the classic head")
		elseif not (sm and sm.MeshType == Enum.MeshType.Head) then
			table.insert(verdicts, "BAD  Head is a " .. head.ClassName .. " without the Head SpecialMesh")
		else
			table.insert(verdicts, string.format("OK   Head is a Part + SpecialMesh Head, %.2f studs", head.Size.Y))
		end
	end
	-- the tier parts: every part the key says is a tier part carries that tier, and is scaled exactly once
	local key = attr(model, "BodyTiers")
	local defaults, twice = {}, {}
	for _, name in ipairs(BodyTiers.PARTS) do
		local p = model:FindFirstChild(name)
		if p and p:IsA("BasePart") then
			local tier = attr(p, "BodyTier")
			if tier == nil then
				table.insert(defaults, name)
			else
				local okE, e = pcall(BodyTiers.PartEntry, tonumber(tier), name, nil, attr(p, "BodyLite") == true)
				local have = p:IsA("MeshPart") and tostring(get(p, "MeshId") or ""):gsub("rbxassetid://", "") or "-"
				if okE and e and have ~= tostring(e.id) then
					table.insert(verdicts, string.format("BAD  %s shows mesh %s, tier %s expects %s: not the tier part the attribute claims", name, have, tostring(tier), tostring(e.id)))
				end
				local r0 = attr(p, "BodyRatio")
				local r = BuilderTiers.RatioOf(p)
				if typeof(r0) == "Vector3" and r and (r - r0).Magnitude > 0.02 then
					table.insert(twice, string.format("%s %s vs %s", name, v3(r), v3(r0)))
				end
			end
		end
	end
	if type(key) == "string" and key:find("[1-9]") and #defaults > 0 then
		table.insert(verdicts, "BAD  default (untiered) parts on a tiered body: " .. table.concat(defaults, " ") .. " (their swaps did not take)")
	elseif #defaults == 0 then
		table.insert(verdicts, "OK   every body part is a tier part")
	else
		table.insert(verdicts, "OK   a body of default parts (no tiers asked for)")
	end
	if #twice > 0 then
		table.insert(verdicts, "BAD  tier parts whose Size / OriginalSize is not the ratio they were swapped at (scaled again since): " .. table.concat(twice, "; "))
	end
	for _, name in ipairs(MOTORS) do
		table.insert(lines, motorLine(model, name, verdicts))
	end
	-- the bind pose's joint heights above the lowest sole (HumanoidRootPart space), next to the unit rig's x the height scale
	local okB, pose = pcall(bindPose, model)
	if okB and pose.LowerTorso and pose.LeftFoot and pose.RightFoot then
		local lf, rf = model:FindFirstChild("LeftFoot"), model:FindFirstChild("RightFoot")
		local sole = math.min(pose.LeftFoot.Position.Y - (lf and lf.Size.Y or 0.3) / 2, pose.RightFoot.Position.Y - (rf and rf.Size.Y or 0.3) / 2)
		local function jy(_, mname)
			local m = RigJoints.Find(model, mname)
			local p0 = m and RigJoints.Part0(m)
			local base = p0 and pose[p0.Name]
			return base and (base * RigJoints.C0(m)).Position.Y - sole or nil
		end
		local hs = { Root = jy("LowerTorso", "Root"), Waist = jy("UpperTorso", "Waist"), RightHip = jy("RightUpperLeg", "RightHip"),
			RightKnee = jy("RightLowerLeg", "RightKnee"), RightAnkle = jy("RightFoot", "RightAnkle"), Neck = jy("Head", "Neck"), RightShoulder = jy("RightUpperArm", "RightShoulder") }
		local unit = ctx.unit
		if unit == nil then
			-- (v12: the frame's own rig heights, BodyAssetData.frames[id].unit; the default family's otherwise)
			local okU, u = pcall(BodyTiers.Unit, model:GetAttribute("BodyFrame") or model:GetAttribute("Frame"))
			unit = okU and type(u) == "table" and u or nil
		end
		local hscale = 1
		pcall(function()
			local d = hum and hum:GetAppliedDescription()
			if d and d.HeightScale > 0 then
				hscale = d.HeightScale
			end
		end)
		local parts = {}
		for _, k in ipairs({ "Root", "Waist", "RightHip", "RightKnee", "RightAnkle", "RightShoulder", "Neck" }) do
			local u = unit and unit.joints and unit.joints[k]
			parts[#parts + 1] = string.format("%s=%s%s", k, hs[k] and f2(hs[k]) or "?", u and string.format("(unit %.2f)", u[2] * hscale) or "")
		end
		local root = model:FindFirstChild("HumanoidRootPart")
		local soleUnderRoot = -sole
		table.insert(lines, string.format("bindpose heights above the sole: %s | HRP centre %.2f above the sole (HipHeight+HRP/2 = %s) heightScale=%.2f", table.concat(parts, " "),
			soleUnderRoot, (hum and root) and f2(hum.HipHeight + root.Size.Y / 2) or "?", hscale))
		if hum and root then
			local d = soleUnderRoot - (hum.HipHeight + root.Size.Y / 2)
			if math.abs(d) > 0.05 then
				table.insert(verdicts, string.format("BAD  the soles hang %.2f studs %s where HipHeight puts the floor: the feet %s", math.abs(d), d > 0 and "below" or "above",
					d > 0 and "sink into the ground (the Humanoid floats on HipHeight)" or "float (or the legs are bent to reach the ground)"))
			else
				table.insert(verdicts, string.format("OK   soles at HipHeight (%.2f vs %.2f)", soleUnderRoot, hum.HipHeight + root.Size.Y / 2))
			end
		end
	else
		table.insert(lines, "bindpose: could not be chained (" .. tostring(okB and "parts missing" or pose) .. ")")
	end
	lookLines(model, lines, verdicts)
	-- the Animator's view (client only)
	local rig = ctx.rig
	if rig then
		local g = rig.geo or {}
		local missing = {}
		for _, k in ipairs({ "Root", "W", "Neck", "RS", "RE", "RW", "LS", "LE", "LW", "RH", "RK", "RA", "LH", "LK", "LA" }) do
			if not (rig.joints and rig.joints[k]) then
				table.insert(missing, k)
			end
		end
		local lo = rig.loco or {}
		table.insert(lines, string.format("animator geo.ok=%s legLen=%s hipW=%s floorH=%s rootY=%s groundY=%s utScale=%s footW=%s meshFeet=%s | lod=%s released=%s isPlayer=%s isLocal=%s fighter=%s ambient=%s trainee=%s ref=%s pose=%s loop=%s speed=%s camDist=%s missingJoints=[%s]",
			tostring(g.ok), g.legLen and f2(g.legLen) or "-", g.hipW and f2(g.hipW) or "-", g.floorH and f2(g.floorH) or "-", g.rootY and f2(g.rootY) or "-",
			g.groundY and f2(g.groundY) or "-", g.utScale and v3(g.utScale) or "-", g.footW and f2(g.footW) or "-", tostring(g.meshFeet), tostring(rig.lod),
			tostring(rig.released), tostring(rig.isPlayer), tostring(rig.isLocal), tostring(rig.isFighter), tostring(rig.isAmbient), tostring(rig.isTrainee),
			tostring(rig.isReferee), tostring(rig.a and rig.a.Pose), tostring(rig.a and rig.a.Loop), lo.speed and f2(lo.speed) or "-", rig.camDist and f2(rig.camDist) or "-",
			table.concat(missing, ",")))
		if not g.ok then
			table.insert(verdicts, "BAD  the Animator could not measure this rig (geo.ok false; joints missing: " .. table.concat(missing, ",") .. "): no gait, no IK on it")
		elseif hum and g.floorH and g.rootY then
			local root = model:FindFirstChild("HumanoidRootPart")
			local want = root and (hum.HipHeight + root.Size.Y / 2) or nil
			local have = g.floorH - g.rootY
			local geo = g.geoGroundY and -g.geoGroundY or have
			if want and math.abs(have - want) > 0.05 then
				table.insert(verdicts, string.format("BAD  Animator floor %.2f under the root vs HipHeight's %.2f: the planted feet and the Humanoid disagree about the ground", have, want))
			elseif want and math.abs(geo - want) > 0.05 then
				table.insert(verdicts, string.format("WARN Animator floor %.2f follows HipHeight; the soles' own bind height says %.2f (HipHeight %.2f off the legs: BuilderTiers.FixHipHeight pending or not taken)", have, geo, geo - want))
			else
				table.insert(verdicts, string.format("OK   Animator floor %.2f under the root matches HipHeight", have))
			end
		end
	elseif ctx.side == "client" then
		table.insert(lines, "animator: this model is NOT in the Animator's rig registry (no tag / not a player character)")
		table.insert(verdicts, "BAD  the Animator does not drive this model")
	end
	if type(ctx.sample) == "table" then
		for _, s in ipairs(ctx.sample.lines or {}) do
			table.insert(lines, s)
		end
		for _, s in ipairs(ctx.sample.verdicts or {}) do
			table.insert(verdicts, s)
		end
	end
	for _, v in ipairs(verdicts) do
		table.insert(lines, "VERDICT " .. v)
	end
	table.insert(lines, "== end " .. model.Name)
	return lines, verdicts
end

-- the lines as one block (every line prefixed), ready for print / warn
function Diag.Block(lines)
	local out = table.create(#lines)
	for i, l in ipairs(lines) do
		out[i] = Diag.PREFIX .. l
	end
	return table.concat(out, "\n")
end

function Diag.Print(model, ctx)
	local ok, lines = pcall(Diag.Report, model, ctx)
	if ok then
		print(Diag.Block(lines))
	else
		print(Diag.PREFIX .. "report failed on " .. tostring(model) .. ": " .. tostring(lines))
	end
	return ok
end

-- the models worth reporting near a position: the player's own character first, then the nearest `n` other humanoid
-- models in workspace (NPCs, other players), nearest first
function Diag.Pick(center, own, n, root)
	root = root or workspace
	local list = {}
	local seen = {}
	if own then
		seen[own] = true
	end
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("Humanoid") then
			local m = d.Parent
			local hrp = m and m:FindFirstChild("HumanoidRootPart")
			if m and hrp and hrp:IsA("BasePart") and not seen[m] then
				seen[m] = true
				table.insert(list, { m = m, d = (hrp.Position - center).Magnitude })
			end
		end
	end
	table.sort(list, function(a, b)
		return a.d < b.d
	end)
	local out = {}
	if own then
		table.insert(out, own)
	end
	for i = 1, math.min(n or 2, #list) do
		table.insert(out, list[i].m)
	end
	return out
end

------------------------------------------------------------------------
-- Motion sample (the caller feeds frames; pure here): per tick the root's velocity and height, each foot's world Y
-- and horizontal travel while it is down, the hip / knee / elbow bend the limbs really show (measured from the parts)
-- next to the bend the Animator wrote (RigJoints.Written, client), and whether any Animate track was playing.
-- [Studio] the bend used to be read from the joint's Transform - the value written - so "knees never bent" could not
-- tell "never written" from "written and ignored by the engine"; written vs actual can.
-- Diag.NewSample() -> S; Diag.SampleTick(S, model, t); Diag.SampleLines(S) -> { lines, verdicts }
------------------------------------------------------------------------
-- the joint's bend (deg, about X) as the limb shows it, and as the Animator wrote it (nil when it writes nothing)
local function bend(model, _, mname)
	local m = RigJoints.Find(model, mname)
	if not m then
		return nil
	end
	local a = RigJoints.Measure(m)
	local actual = a and math.deg((a:ToEulerAnglesXYZ())) or nil
	local written
	local wf = RigJoints.Written
	if wf then
		local ok, w = pcall(wf, model, mname)
		if ok and typeof(w) == "CFrame" then
			written = math.deg((w:ToEulerAnglesXYZ()))
			-- (the whole rotation's gap too: a write that shows on another axis is still a write that shows)
			if a then
				return actual, written, RigJoints.Angle(w:Inverse() * a)
			end
		end
	end
	return actual, written, nil
end

-- a sampled foot is down when its sole's lowest corner is within this of the lowest any sole reached (studs)
Diag.SOLE_DOWN = 0.05

function Diag.NewSample()
	return { ticks = {}, lastL = nil, lastR = nil, slideL = 0, slideR = 0, downL = 0, downR = 0, tracks = 0 }
end

function Diag.SampleTick(S, model, t)
	local root = model:FindFirstChild("HumanoidRootPart")
	local lf, rf = model:FindFirstChild("LeftFoot"), model:FindFirstChild("RightFoot")
	if not (root and lf and rf) then
		return
	end
	local hum = model:FindFirstChildOfClass("Humanoid")
	local an = hum and hum:FindFirstChildOfClass("Animator")
	local playing = false
	if an then
		pcall(function()
			playing = #an:GetPlayingAnimationTracks() > 0
		end)
	end
	if playing then
		S.tracks += 1
	end
	local vel = root.AssemblyLinearVelocity
	local rcf = root.CFrame
	-- [Studio] "sways side to side": the root's own lateral travel relative to its facing since the last tick (studs) and
	-- its roll (deg) - what the Humanoid / physics does to the ROOT, which no joint write can cause
	local lat, roll = 0, 0
	do
		local prev = S.ticks[#S.ticks]
		if prev and prev.pos then
			local d = rcf.Position - prev.pos
			lat = Vector3.new(d.X, 0, d.Z):Dot(rcf.RightVector)
		end
		local _, _, rz = rcf:ToOrientation()
		roll = math.deg(rz)
	end
	local hip, hipW, hipG = bend(model, "RightUpperLeg", "RightHip")
	local knee, kneeW, kneeG = bend(model, "RightLowerLeg", "RightKnee")
	local elbow, elbowW, elbowG = bend(model, "RightLowerArm", "RightElbow")
	local tick = {
		t = t, vx = Vector3.new(vel.X, 0, vel.Z).Magnitude, rootY = root.Position.Y, lY = lf.Position.Y, rY = rf.Position.Y,
		lP = lf.Position, rP = rf.Position, hip = hip, knee = knee, elbow = elbow, hipW = hipW, kneeW = kneeW, elbowW = elbowW,
		gap = math.max(hipG or 0, kneeG or 0, elbowG or 0), gapN = (hipG and 1 or 0) + (kneeG and 1 or 0) + (elbowG and 1 or 0),
		playing = playing, pos = rcf.Position, lat = lat, roll = roll,
	}
	if S.status == nil and RigJoints.Status then
		local ok, st = pcall(RigJoints.Status, model)
		S.status = ok and st or nil
	end
	if S.kind == nil then
		local kind, nm, na = RigJoints.Kind(model)
		S.kind = string.format("%s (Motor6D %d / AnimationConstraint %d)", kind, nm, na)
	end
	-- the sole: the foot box's lowest corner (world height, and which corner: its part-space point)
	for _, f in ipairs({ { lf, "l" }, { rf, "r" } }) do
		local part, k = f[1], f[2]
		local h = part.Size / 2
		local cf = part.CFrame
		local lowY, lowQ = math.huge, nil
		for _, sx in ipairs({ -1, 1 }) do
			for _, sy in ipairs({ -1, 1 }) do
				for _, sz in ipairs({ -1, 1 }) do
					local q = Vector3.new(h.X * sx, h.Y * sy, h.Z * sz)
					local w = cf * q
					if w.Y < lowY then
						lowY, lowQ = w.Y, q
					end
				end
			end
		end
		tick[k .. "CF"], tick[k .. "SoleY"], tick[k .. "SoleQ"] = cf, lowY, lowQ
	end
	table.insert(S.ticks, tick)
	-- a foot is "down" when its sole's lowest corner is within SOLE_DOWN of the lowest seen so far on this tick and the
	-- last; its slide is how far the corner that touched has moved along the floor since. (The foot's
	-- centre within 0.12 of its lowest, as this read before, also caught a runner's foot a few centimetres over the
	-- ground in the last instant of its swing - moving at the body's pace - and the centre of a planted foot rolling up
	-- onto its toes: every 10 Hz sample of a run read as BAD "the planted feet slide" with the feet holding still)
	local n = #S.ticks
	S.soleLo = math.min(S.soleLo or math.huge, tick.lSoleY, tick.rSoleY)
	if n > 1 then
		local lo = S.soleLo
		local prev = S.ticks[n - 1]
		for _, k in ipairs({ "l", "r" }) do
			if prev[k .. "SoleQ"] and tick[k .. "SoleY"] < lo + Diag.SOLE_DOWN and prev[k .. "SoleY"] < lo + Diag.SOLE_DOWN then
				-- (the corner down on either tick, the one that held: a foot rolling from its heel onto its toes between
				-- two samples moves the heel corner and keeps the toe, landing heel first the other way round; a slide
				-- moves both)
				local d = math.huge
				for _, q in ipairs({ prev[k .. "SoleQ"], tick[k .. "SoleQ"] }) do
					local a, b = prev[k .. "CF"] * q, tick[k .. "CF"] * q
					d = math.min(d, Vector3.new(b.X - a.X, 0, b.Z - a.Z).Magnitude)
				end
				if k == "l" then
					S.slideL += d
					S.downL += 1
				else
					S.slideR += d
					S.downR += 1
				end
			end
		end
	end
end

function Diag.SampleLines(S)
	local lines, verdicts = {}, {}
	local n = #S.ticks
	if n == 0 then
		table.insert(lines, "sample: no ticks")
		return { lines = lines, verdicts = verdicts }
	end
	local vmax, rootMin, rootMax, lo = 0, math.huge, -math.huge, math.huge
	for _, k in ipairs(S.ticks) do
		vmax = math.max(vmax, k.vx)
		rootMin, rootMax = math.min(rootMin, k.rootY), math.max(rootMax, k.rootY)
		lo = math.min(lo, k.lY, k.rY)
	end
	-- (one header line, one line per tick: the joints' class and the Animator's mode ride on the header; hip / knee / elbow
	-- below are the bend the limb SHOWS, then (wN) the bend the Animator WROTE, gap = the largest written-vs-shown difference)
	table.insert(lines, string.format("sample %d ticks over %.1fs: vmax=%.2f rootY %.2f..%.2f (bob %.2f) lowestFootY=%.2f animateTicks=%d slideL=%.2f/%d slideR=%.2f/%d"
		.. " | joints: %s; Animator: %s | bends: shown(wWritten)",
		n, S.ticks[n].t - S.ticks[1].t, vmax, rootMin, rootMax, rootMax - rootMin, lo, S.tracks, S.slideL, S.downL, S.slideR, S.downR,
		tostring(S.kind or "?"), tostring(S.status or "no report (server view, or the Animator is not running)")))
	local latMax, rollMax = 0, 0
	local gapMax, gapTicks, wroteKnee = 0, 0, false
	local function ab(a, w)
		local sa = a and string.format("%d", math.round(a)) or "-"
		if w then
			return sa .. string.format("(w%d)", math.round(w))
		end
		return sa
	end
	for _, k in ipairs(S.ticks) do
		latMax = math.max(latMax, math.abs(k.lat or 0))
		rollMax = math.max(rollMax, math.abs(k.roll or 0))
		if (k.gapN or 0) > 0 then
			gapTicks += 1
			gapMax = math.max(gapMax, k.gap or 0)
		end
		if k.kneeW and math.abs(k.kneeW) > 8 then
			wroteKnee = true
		end
		table.insert(lines, string.format("  t=%.1f v=%.2f rootY=%.2f footL=%.2f footR=%.2f hip=%s knee=%s elbow=%s gap=%s lat=%+.3f roll=%+.1f%s", k.t, k.vx, k.rootY, k.lY, k.rY,
			ab(k.hip, k.hipW), ab(k.knee, k.kneeW), ab(k.elbow, k.elbowW), (k.gapN or 0) > 0 and string.format("%d", math.round(k.gap)) or "-",
			k.lat or 0, k.roll or 0, k.playing and " ANIMATE" or ""))
	end
	-- do the Animator's writes take effect? (client only: the server sees no writes)
	if gapTicks > 0 then
		if gapMax > 10 then
			table.insert(verdicts, string.format("BAD  joint writes are NOT taking effect: the limbs show up to %.0f deg away from the pose the Animator wrote (%s). "
				.. "The Animator switches such a rig to Roblox's animation by itself; in your own place set StarterPlayer > AvatarJointUpgrade = Disabled", gapMax, tostring(S.kind)))
		else
			table.insert(verdicts, string.format("OK   joint writes take effect (written vs shown within %.1f deg over %d ticks)", gapMax, gapTicks))
		end
	end
	-- the root itself (not the joints): a sideways travel per tick past 0.1 studs or a roll past 5 degrees is the
	-- Humanoid / physics rocking the character - a collider, a mass off the axis, a mover on the root
	if latMax > 0.1 then
		table.insert(verdicts, string.format("BAD  the ROOT sways sideways %.2f studs per tick relative to its facing: physics / the Humanoid moves it (a part with mass off the axis, a mover, HipHeight written per frame), not the joints", latMax))
	else
		table.insert(verdicts, string.format("OK   root lateral travel %.3f studs per tick", latMax))
	end
	if rollMax > 5 then
		table.insert(verdicts, string.format("BAD  the ROOT rolls %.1f degrees: the HumanoidRootPart itself tips (physics), the joint poses cannot do that", rollMax))
	else
		table.insert(verdicts, string.format("OK   root roll %.1f degrees", rollMax))
	end
	local moving = vmax > 2
	if not moving then
		table.insert(verdicts, "note the character did not move during the sample (walk while it runs for the gait numbers)")
	else
		local slide = (S.slideL + S.slideR) / math.max(1, S.downL + S.downR)
		if slide > 0.08 then
			table.insert(verdicts, string.format("BAD  the planted feet slide %.2f studs per tick while down: the gait and the root disagree (speed, HipHeight or a second writer)", slide))
		else
			table.insert(verdicts, string.format("OK   planted feet hold (%.2f studs per tick)", slide))
		end
		if rootMax - rootMin > 0.6 then
			table.insert(verdicts, string.format("BAD  the root bobs %.2f studs while walking", rootMax - rootMin))
		end
		local bentKnee = false
		for _, k in ipairs(S.ticks) do
			if k.knee and math.abs(k.knee) > 8 then
				bentKnee = true
			end
		end
		if not bentKnee then
			if wroteKnee then
				table.insert(verdicts, "BAD  the knees never bent while moving although the Animator wrote a bend: its writes do not reach the limbs")
			else
				table.insert(verdicts, "BAD  the knees never bent while moving: the Animator is not writing this rig's legs (or its writes are overwritten)")
			end
		end
	end
	if S.tracks > 0 then
		table.insert(verdicts, string.format("BAD  Animate tracks were playing on %d of %d ticks: a conflicting writer", S.tracks, n))
	end
	return { lines = lines, verdicts = verdicts }
end

------------------------------------------------------------------------
-- FIGHT block (server): the engine's view of a live fight (FightEngine.Active[player]), printed by /wcbdiag during
-- a bout: per fighter his mode and state, stamina, how long he is still busy, the distance, PunchRange (jab / cross /
-- hook), the separation and the floor, HitTest(jab, head) with why, the hit geometry's frame and its fallback, the
-- punches thrown / landed so far and the AI's last decisions with their reasons ("out of range 4.8 > 4.1", "busy",
-- "attack (work floor)", "clinch"), the last punch's verdict (why it missed, its margin, the facing, the network
-- delay and whether the lag compensation stood the client's hit) and the AI's read of the man in front of it (his
-- retreat, his circling, his favourite punch and guard). Every read is guarded: a field the
-- engine does not have prints as "?"
------------------------------------------------------------------------
local function try(fn, ...)
	local ok, v = pcall(fn, ...)
	if ok then
		return v
	end
	return nil
end
local function n2(v)
	return type(v) == "number" and string.format("%.2f", v) or "?"
end
function Diag.FightLines(fight)
	local lines, verdicts = {}, {}
	if type(fight) ~= "table" then
		return { "== FIGHT: none live" }
	end
	local now = try(fight.Now, fight) or 0
	local P, O = fight.P, fight.O
	local kind = fight.pvp and "PvP" or (fight.spar and ("spar " .. tostring(fight.spar))) or (fight.debut and "debut") or (fight.tutorial and "tutorial") or "career"
	local minSep = try(fight.MinSep, fight)
	local floor = try(fight.Floor, fight)
	local dist = (P and O) and try(fight.Distance, fight, P, O) or nil
	local roundLeft = type(fight.roundEnd) == "number" and math.max(0, fight.roundEnd - now) or nil
	table.insert(lines, string.format("== FIGHT %s round %s/%s live=%s paused=%s menuHold=%s roundLeft=%s rigK=%s sp.min=%s minSep=%s floor=%s dist=%s",
		kind, tostring(fight.round), tostring(fight.rounds), tostring(fight.live), tostring(fight.paused), tostring(fight.menuHold),
		roundLeft and f2(roundLeft) or "?", n2(fight.rigK), n2(fight.sp and fight.sp.min), n2(minSep), n2(floor), n2(dist)))
	local elapsed = 0
	if type(fight.roundSeconds) == "number" then
		elapsed = math.max(0, (tonumber(fight.round) or 1) - 1) * fight.roundSeconds + (roundLeft and (fight.roundSeconds - roundLeft) or 0)
	end
	for _, F in ipairs({ P, O }) do
		if F then
			local other = F == P and O or P
			local name = tostring(F.data and F.data.name or "?")
			local ai = F.ai
			local jab, cross, hook = try(fight.PunchRange, fight, F, "jab"), try(fight.PunchRange, fight, F, "cross"), try(fight.PunchRange, fight, F, "leadhook")
			local ht = (other and dist) and try(fight.HitTest, fight, F, other, "jab", false, dist) or nil
			local geo = F.geo
			table.insert(lines, string.format("-- %s (%s) state=%s mode=%s stamina=%s/%s busy=%+.2fs tier=%s hurt=%s blocking=%s onRopes=%s",
				name, F.isPlayer and "player" or (ai and (ai.tier and ("AI " .. tostring(ai.tier.name) .. " L" .. tostring(math.floor((ai.level or 0) + 0.5))) or "AI") or "no brain"),
				tostring(F.state), ai and tostring(ai.mode) or "-", n2(F.stamina), n2(F.maxStam), (tonumber(F.busyUntil) or 0) - now, tostring(F.tier),
				tostring(try(fight.IsHurt, fight, F)), tostring(F.blocking), tostring(F.onRopes)))
			table.insert(lines, string.format("   range jab=%s cross=%s hook=%s | HitTest(jab,head @%s)=%s%s | geo=%s%s",
				n2(jab), n2(cross), n2(hook), n2(dist), ht and tostring(ht.ok) or "?",
				ht and ((ht.why and (" why=" .. ht.why) or "") .. (ht.redirected and " (falls to the body)" or "") .. (type(ht.margin) == "number" and string.format(" margin=%.2f", ht.margin) or "")) or "",
				geo and (tostring(geo.source) .. string.format(" stand=%.2f arm=%.2f glove=%.2f", geo.stand or 0, geo.arm or 0, geo.glove or 0)) or "none",
				F.geoFallback and (" FALLBACK: " .. tostring(F.geoFallback)) or ""))
			local lh = F.lastHit
			if type(lh) == "table" then
				table.insert(lines, string.format("   last punch %s %.1fs ago: %s%s zone=%s margin=%s dist=%s facing=%s lag=%s%s | lag-compensated hits %s",
					tostring(lh.p), now - (tonumber(lh.t) or now), lh.ok and "LANDS" or "MISSES", lh.why and (" (" .. tostring(lh.why) .. ")") or "", tostring(lh.zone),
					n2(lh.margin), n2(lh.dist), type(lh.facing) == "number" and string.format("%.0fdeg", lh.facing) or "?", lh.lag and string.format("%.0fms", lh.lag * 1000) or "-",
					lh.lagComp and (" COMPENSATED (live: " .. tostring(lh.liveWhy) .. ")") or "", tostring(F.lagComps or 0)))
			end
			local tot, tal = F.totals or {}, F.tally or {}
			local ppm = elapsed > 5 and (tonumber(tot.thrown) or 0) / elapsed * 60 or nil
			table.insert(lines, string.format("   punches fight thrown=%s landed=%s (%s/min) round thrown=%s landed=%s kd=%s | last throw %s ago",
				tostring(tot.thrown), tostring(tot.landed), ppm and f2(ppm) or "?", tostring(tal.thrown), tostring(tal.landed), tostring(F.kdTotal),
				type(F.lastPunch) == "number" and f2(now - F.lastPunch) or "?"))
			if ai and type(ai.log) == "table" then
				local bits = {}
				for i = math.max(1, #ai.log - 4), #ai.log do
					local e = ai.log[i]
					if e then
						table.insert(bits, string.format("%s%s (%.1fs ago)", tostring(e.why), (e.n or 1) > 1 and (" x" .. e.n) or "", now - (e.t or now)))
					end
				end
				table.insert(lines, "   AI decisions: " .. (#bits > 0 and table.concat(bits, "; ") or "none yet"))
				table.insert(lines, string.format("   AI aggression=%s range=%s skill=%s tier work=%s floor=%s/min react=%s read=%s reachableSince=%s",
					n2(try(ai.Aggression, ai)), n2(try(ai.Range, ai)), n2(ai.skill), n2(ai.tier and ai.tier.work), n2(ai.tier and ai.tier.floor),
					n2(ai.tier and ai.tier.react), n2(ai.tier and ai.tier.read), ai.reachableSince and f2(now - ai.reachableSince) or "-"))
				local fav, share = nil, nil
				if ai.read and ai.read.Favourite then
					local okF, a, b = pcall(ai.read.Favourite, ai.read)
					if okF then
						fav, share = a, b
					end
				end
				table.insert(lines, string.format("   AI read: his favourite %s (%s) guard %s retreat %s studs/s circling %s | style %s",
					tostring(fav), n2(share), n2(ai.read and try(ai.read.BlockShare, ai.read)), n2(ai.oBack), n2(ai.oCircle),
					tostring(ai.style and ai.style.id)))
			end
			if F.geoFallback then
				table.insert(verdicts, "BAD  " .. name .. ": hit geometry fell back (" .. tostring(F.geoFallback) .. ")")
			end
			if type(jab) == "number" and type(minSep) == "number" then
				if minSep + 0.3 < jab then
					table.insert(verdicts, string.format("OK   %s: a jab reaches from the separation (%.2f + 0.3 < %.2f)", name, minSep, jab))
				else
					table.insert(verdicts, string.format("BAD  %s: the separation starves the jab (%.2f + 0.3 >= %.2f)", name, minSep, jab))
				end
			end
			if ai and fight.live and elapsed > 10 and (tonumber(tot.thrown) or 0) == 0 then
				table.insert(verdicts, "BAD  " .. name .. ": the AI has not thrown a punch in " .. f2(elapsed) .. " s of boxing")
			end
		end
	end
	for _, v in ipairs(verdicts) do
		table.insert(lines, "VERDICT " .. v)
	end
	table.insert(lines, "== end FIGHT")
	return lines
end

return Diag
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="59">
        <Properties>
          <string name="Name">DrillScore</string>
          <string name="Source"><![CDATA[-- DrillScore: how a training drill is judged. Shared by the client, which plays the drill with these
-- judges, and the server, which replays the client's input stream through the same judges to score
-- the session (Main.server.lua finishActivity): the session quality is the server's number.
--
-- A drill is a list of segments (Training.DrillPlan draws them on the server - the combos, zones,
-- cues, beats and limits - and sends the plan with StartActivity). The client sends every input the
-- drill takes as { id, down, t } (t = seconds on the drill clock) and a marker "@" when a segment
-- starts. Each segment is a small state machine:
--   j.input(id, down, t)  an input; returns what happened (the client's feedback) or nil
--   j.advance(t)          the clock moved on (notes missed, a lift that went too far, rope passes)
--   j.finish(t)           the segment is over at t (whatever was not done by then is not done)
--   j.endsAt()            when the segment was over for the player (the client moves on then), nil
--                         while that still depends on inputs to come
--   j.result()            the segment's numbers; DrillScore.Aggregate turns them into the 0..1 score
-- No Roblox services: it loads on both sides and in plain Luau tests.
local DrillScore = {}
-- the exercise-specific workouts' judges and plans (installed at the end of this file)
local Workouts = require(script.Parent:WaitForChild("DrillWorkouts"))

local TAP_HOLD = 0.35 -- a press held this long is a hold (released on let-go); shorter is a tap toggle
local RT_FLOOR = 0.1 -- an answer faster than this jumped the cue: nobody reacts in under a tenth
local TWO_PI = 2 * math.pi
DrillScore.TAP_HOLD = TAP_HOLD
DrillScore.BOUNCE = 0.2
DrillScore.RT_FLOOR = RT_FLOOR
-- the most inputs one session keeps (an honest drill sends a few hundred at most)
DrillScore.MAX_EVENTS = 1200
-- the drill's pacing: what the client waits between one segment's end and the next one's start (the
-- round banners, the rests, the beat after each combination / rep). Activities.lua waits exactly these,
-- Training.DrillPlan writes each segment's sum into seg.gap and the replay holds the stream to it.
-- (kept short on purpose: a workout is 20-40 s of input, the banners flash and the breathers are a
-- second - the dead time between reps and sets is what made the sessions feel slow)
DrillScore.WAIT = {
	intro = 0.6, -- the first round's banner (ctx.round)
	round = 0.5, -- a later round's / set's banner
	rest = 1.0, -- the breather between rounds and sets (ctx.rest)
	restLong = 1.2, -- the mitt coach's breather
	restShort = 1.0, -- the rope's and the ladder's breather
	combo = 0.4, -- after a heavy bag combination
	shot = 0.5, -- after a power shot
	react = 0.25, -- after a double-end cue
	counter = 0.3, -- after a slip & counter
	mitt = 0.45, -- after a called mitt combination
	move = 0.2, -- after a shadow boxing cue
	flow = 0.4, -- after a shadow boxing flow
	lower = 0.3, -- lowering the weight after a rep
	rerack = 0.15, -- the beat before the next rep
	slam = 0.2, -- the ball driven down after a slam
	catch = 0.25, -- the catch off the bounce
	ladder = 0.4, -- after a ladder drill
	rebound = 0.3, -- after a double-end rebound
	steps = 0.3, -- after the shadow boxing footwork pattern
}
-- an "@" may come this much before the plan's pacing allows (clock rounding); earlier, the segment
-- starts at the allowed time and what the client did before it counts for nothing
DrillScore.GAP_SLACK = 0.05
-- the punches a power shot takes (POWER = a cross)
local NEEDLE_IDS = { power = true, jab = true, cross = true, leadhook = true, rearhook = true, uppercut = true, overhand = true }

local function clamp(v, lo, hi)
	return math.max(lo, math.min(hi, v))
end

-- the power-shot needle: 0 -> 1 -> 0 at `sweep` crossings a second
function DrillScore.NeedlePos(el, sweep)
	local u = (math.max(0, el) * sweep) % 2
	return u < 1 and u or 2 - u
end

local J = {}

-- a sequence (combinations, shadow flows): press the ids in order before the limit; a wrong press is
-- counted and the sequence waits for the right one. With seg.beat (the heavy bag's rhythm combos) every
-- hit after the first is also timed against the one before it: a beat apart is on the beat (perfect
-- inside 30% of it, good inside 60%), the rest is off (the chain still goes on: nothing resets).
J.seq = function(seg, M)
	local ids, n = seg.ids, #seg.ids
	local endT = M + seg.limit
	local beat = tonumber(seg.beat)
	local s = { idx = 1, wrong = 0, presses = 0, perfectHits = 0, goodHits = 0, closed = false }
	function s.input(id, down, t)
		if not down or s.closed or t < M then
			return nil
		end
		if t >= endT then
			s.closed = true
			return nil
		end
		local at = s.idx
		-- forgiving input: the punch just landed pressed again within BOUNCE (a key bounce, a double tap on
		-- a touch button) is not a wrong press
		if id ~= ids[at] and s.lastHit and id == ids[at - 1] and t - s.lastHit <= DrillScore.BOUNCE then
			return nil
		end
		s.presses += 1
		if id == ids[at] then
			s.idx += 1
			local tempo
			if beat and s.lastHit then
				local e = math.abs(t - s.lastHit - beat)
				tempo = e <= beat * 0.3 and "perfect" or (e <= beat * 0.6 and "good" or "off")
				if tempo == "perfect" then
					s.perfectHits += 1
				elseif tempo == "good" then
					s.goodHits += 1
				end
			end
			s.lastHit = t
			if s.idx > n then
				s.doneAt = t
				s.closed = true
			end
			return { ok = true, idx = at, tempo = tempo }
		end
		s.wrong += 1
		return { ok = false, idx = at }
	end
	function s.advance(t)
		if t >= endT then
			s.closed = true
		end
	end
	function s.finish(t)
		s.advance(t)
		s.closed = true
	end
	function s.result()
		local done = s.idx - 1
		local frac = (done == n and s.doneAt) and math.max(0, 1 - (s.doneAt - M) / seg.limit) or 0
		-- the share of the timed hits on the beat (nil without a beat)
		local beatQ = beat and n > 1 and (s.perfectHits + 0.75 * s.goodHits) / (n - 1) or nil
		return { done = done, n = n, wrong = s.wrong, presses = s.presses, frac = frac, complete = done == n, time = s.doneAt and (s.doneAt - M) or nil,
			beatQ = beatQ, perfectHits = s.perfectHits, goodHits = s.goodHits }
	end
	function s.endsAt()
		return s.doneAt or endT
	end
	return s
end

-- one cue: the first press inside the window answers it (too soon = jumped the cue)
J.cue = function(seg, M)
	local s = { closed = false }
	function s.input(id, down, t)
		if not down or s.closed or t < M then
			return nil
		end
		if t - M >= seg.window then
			s.closed = true
			return nil
		end
		s.closed = true
		s.answered = true
		s.id = id
		s.rt = t - M
		s.early = s.rt < RT_FLOOR
		s.correct = id == seg.want and not s.early
		return { answered = true, correct = s.correct, early = s.early, rt = s.rt, id = id }
	end
	function s.advance(t)
		if t - M >= seg.window then
			s.closed = true
		end
	end
	function s.finish(t)
		s.advance(t)
		s.closed = true
	end
	function s.result()
		return { answered = s.answered == true, correct = s.correct == true, early = s.early == true, rt = s.rt }
	end
	function s.endsAt()
		return M + (s.answered and s.rt or seg.window)
	end
	return s
end

-- call & response (the mitts): the coach calls the moves one at a time - call k comes at
-- M + lead + (k - 1) * call and stays open for `window` - and each is answered with its move inside its
-- window (perfect inside half of it, good after). A FEINT call (id "feint") is one you must NOT bite on:
-- any press inside its window is bitten, nothing is a feint held. A wrong move answers (and spends)
-- the call; a press with no call open is a stray. Nothing resets: a missed call is just a missed call.
J.call = function(seg, M)
	local ids, n = seg.ids, #seg.ids
	local calls = {}
	for k, id in ipairs(ids) do
		calls[k] = { id = id, t = M + seg.lead + (k - 1) * seg.call, feint = id == "feint" }
	end
	local last = calls[n]
	local endT = (last and last.t or M) + seg.window
	local s = { calls = calls, closed = false, perfect = 0, good = 0, wrong = 0, missed = 0, held = 0, bitten = 0, stray = 0, feints = 0, endT = endT }
	for _, c in ipairs(calls) do
		if c.feint then
			s.feints += 1
		end
	end
	local function resolve(c, how, at)
		c.judged, c.how, c.at = true, how, at
		s[how] += 1
	end
	-- the calls whose window went by unanswered (the client's MISS / FEINT HELD)
	function s.advance(t)
		local out
		for k, c in ipairs(calls) do
			if not c.judged and t - c.t >= seg.window then
				resolve(c, c.feint and "held" or "missed", c.t + seg.window)
				out = out or {}
				table.insert(out, { k = k, how = c.how })
			end
		end
		if t >= endT then
			s.closed = true
		end
		return out
	end
	function s.input(id, down, t)
		if not down or s.closed or t < M then
			return nil
		end
		s.advance(t)
		if s.closed then
			return nil
		end
		-- the earliest open call for this move; failing that, the earliest open call (windows may overlap:
		-- the move of the next call, thrown while a missed one is still open, answers the next one)
		local c, k, first, firstK
		for i, cc in ipairs(calls) do
			if not cc.judged and t >= cc.t and t - cc.t < seg.window then
				if not first then
					first, firstK = cc, i
				end
				if cc.id == id then
					c, k = cc, i
					break
				end
			end
		end
		if not c then
			c, k = first, firstK
		end
		if not c then
			s.stray += 1
			return { stray = true, id = id }
		end
		local rt = t - c.t
		if c.feint then
			resolve(c, "bitten", t)
			return { k = k, how = "bitten", id = id, rt = rt }
		elseif id == c.id then
			local how = rt <= seg.window * 0.5 and "perfect" or "good"
			resolve(c, how, t)
			return { k = k, how = how, id = id, rt = rt }
		end
		resolve(c, "wrong", t)
		return { k = k, how = "wrong", id = id, rt = rt }
	end
	function s.finish(t)
		s.advance(t)
		s.closed = true
	end
	function s.result()
		return { n = n, real = n - s.feints, perfect = s.perfect, good = s.good, wrong = s.wrong, missed = s.missed,
			feints = s.feints, held = s.held, bitten = s.bitten, stray = s.stray }
	end
	-- the last call resolved (answered, or its window gone)
	function s.endsAt()
		local e = M
		for _, c in ipairs(calls) do
			e = math.max(e, c.at or (c.t + seg.window))
		end
		return e
	end
	return s
end

-- slip & counter: the defensive move inside the window, then PUNCH inside the counter window
J.counter = function(seg, M)
	local s = { step = 1, closed = false }
	function s.input(id, down, t)
		if not down or s.closed or t < M then
			return nil
		end
		if s.step == 1 then
			if t - M >= seg.window then
				s.closed = true
				return nil
			end
			if id == seg.want and t - M >= RT_FLOOR then
				s.step = 2
				s.shown2 = t
				return { step = 2, ok = true, id = id }
			end
			s.failed = true
			s.closed = true
			s.endT = t
			return { step = 1, ok = false, id = id, early = id == seg.want }
		end
		if t - s.shown2 >= seg.cw then
			s.closed = true
			return nil
		end
		s.closed = true
		s.endT = t
		if id == "punch" then
			s.rt = t - s.shown2
			s.step = 3
			return { step = 3, ok = true, id = id, rt = s.rt }
		end
		s.failed = true
		return { step = 2, ok = false, id = id }
	end
	function s.advance(t)
		if (s.step == 1 and t - M >= seg.window) or (s.step == 2 and t - s.shown2 >= seg.cw) then
			s.closed = true
		end
	end
	function s.finish(t)
		s.advance(t)
		s.closed = true
	end
	function s.result()
		return { step = s.step, failed = s.failed == true, rt = s.rt }
	end
	function s.endsAt()
		return s.endT or (s.step == 2 and s.shown2 + seg.cw) or (M + seg.window)
	end
	return s
end

-- the power-shot needle: the first punch thrown is judged by where the needle is at that moment
J.needle = function(seg, M)
	local s = { closed = false }
	function s.input(id, down, t)
		if not down or s.closed or t < M then
			return nil
		end
		if t - M >= seg.dur then
			s.closed = true
			return nil
		end
		if not NEEDLE_IDS[id] then
			return nil
		end
		s.closed = true
		local pos = DrillScore.NeedlePos(t - M, seg.sweep)
		local d, w = math.abs(pos - seg.c), seg.w
		local timing
		if d <= w then
			timing = 1 - 0.2 * d / w
		elseif d <= 2.5 * w then
			timing = 0.8 - 0.5 * (d - w) / (1.5 * w)
		else
			timing = math.max(0, 0.3 - (d - 2.5 * w) * 1.5)
		end
		s.thrown = { id = id, pos = pos, d = d, timing = timing }
		s.thrownAt = t
		return s.thrown
	end
	function s.advance(t)
		if t - M >= seg.dur then
			s.closed = true
		end
	end
	function s.finish(t)
		s.advance(t)
		s.closed = true
	end
	function s.result()
		return { thrown = s.thrown ~= nil, timing = s.thrown and s.thrown.timing or 0, d = s.thrown and s.thrown.d }
	end
	function s.endsAt()
		return s.thrownAt or (M + seg.dur)
	end
	return s
end

-- the speed burst: alternating LEFT / RIGHT presses for seg.dur seconds
J.burst = function(seg, M)
	local s = { count = 0, closed = false }
	function s.input(id, down, t)
		if not down or s.closed or t < M then
			return nil
		end
		if t - M >= seg.dur then
			s.closed = true
			return nil
		end
		if id ~= "L" and id ~= "R" then
			return nil
		end
		if id == s.last then
			return { alt = false, id = id }
		end
		s.last = id
		s.count += 1
		return { alt = true, id = id, count = s.count }
	end
	function s.advance(t)
		if t - M >= seg.dur then
			s.closed = true
		end
	end
	function s.finish(t)
		s.advance(t)
		s.closed = true
	end
	function s.result()
		return { count = s.count }
	end
	function s.endsAt()
		return M + seg.dur
	end
	return s
end

-- beats on two lanes (speed bag rhythm, russian twists): a press takes the nearest open note of its
-- lane inside hitW; |dt| under perfectW is perfect (the twists' "on the beat"), under goodW good. A
-- press with no note of its lane in reach is a stray (mashing both hands scores nothing)
-- With seg.accel (< 1) the tempo picks up: each gap is the last one times accel, never under
-- seg.minInterval (the speed bag's accelerating rhythm, the ladder's quickening feet).
J.notes = function(seg, M)
	local notes = {}
	local accel = tonumber(seg.accel) or 1
	local minIv = tonumber(seg.minInterval) or seg.interval * 0.5
	local at, iv = M + seg.lead, seg.interval
	for i, lane in ipairs(seg.lanes) do
		notes[i] = { t = at, lane = lane }
		at += iv
		iv = math.max(minIv, iv * accel)
	end
	local last = notes[#notes]
	local endT = (last and last.t or M) + seg.hitW
	local s = { notes = notes, perfect = 0, good = 0, off = 0, missed = 0, stray = 0, closed = false, endT = endT }
	function s.input(id, down, t)
		if not down or s.closed or t < M then
			return nil
		end
		local best, bestDt
		for i, n in ipairs(notes) do
			if not n.judged and n.lane == id then
				local dt = t - n.t
				if math.abs(dt) < seg.hitW and (not best or math.abs(dt) < math.abs(bestDt)) then
					best, bestDt = i, dt
				end
			end
		end
		if not best then
			if t >= M + seg.lead - seg.hitW and t <= endT then
				s.stray += 1
				return { id = id, stray = true }
			end
			return { id = id }
		end
		notes[best].judged = true
		notes[best].at = t
		local a = math.abs(bestDt)
		local grade
		if a < seg.perfectW then
			grade = "perfect"
			s.perfect += 1
		elseif seg.goodW and a < seg.goodW then
			grade = "good"
			s.good += 1
		else
			grade = "off"
			s.off += 1
		end
		return { id = id, note = best, dt = bestDt, grade = grade }
	end
	-- the notes that went by unplayed (the client's MISS)
	function s.advance(t)
		local missed
		for i, n in ipairs(notes) do
			if not n.judged and t - n.t > seg.hitW then
				n.judged = true
				n.at = n.t + seg.hitW
				s.missed += 1
				missed = missed or {}
				table.insert(missed, i)
			end
		end
		if t >= endT then
			s.closed = true
		end
		return missed
	end
	function s.finish(t)
		s.advance(t)
		s.closed = true
	end
	function s.result()
		return { perfect = s.perfect, good = s.good, off = s.off, stray = s.stray, count = #notes, hits = s.perfect + s.good }
	end
	-- the client moves on once every note is played or gone by
	function s.endsAt()
		local e = M
		for _, n in ipairs(notes) do
			e = math.max(e, n.at or (n.t + seg.hitW))
		end
		return e
	end
	return s
end

-- the tap-or-hold switch the hold drills share: a down starts (or, while on, ends) it; letting go of
-- a press held TAP_HOLD or longer ends it. Returns "on" / "off" when it flips.
local function tapHold(s, down, t)
	if down then
		if s.on then
			s.on = false
			s.at = nil
			return "off"
		end
		s.on = true
		s.at = t
		return "on"
	end
	local flip
	if s.at and t - s.at >= TAP_HOLD and s.on then
		s.on = false
		flip = "off"
	end
	s.at = nil
	return flip
end
DrillScore.TapHold = tapHold

-- one lift / slam: the bar rises at seg.speed per second from the press; let go inside [lo, lo + width];
-- at the top (f = 1) the rep fails
J.lift = function(seg, M)
	local s = { closed = false, f = 0 }
	local function release(t)
		s.closed = true
		local f = seg.speed * (t - s.holdStart)
		s.failed = f >= 1
		s.f = math.min(1, f)
		s.endT = s.failed and (s.holdStart + 1 / seg.speed) or t
	end
	function s.input(id, down, t)
		if s.closed or t < M then
			return nil
		end
		local flip = tapHold(s, down, t)
		if flip == "on" and not s.holdStart then
			s.holdStart = t
			return { holding = true }
		elseif flip == "off" and s.holdStart then
			release(t)
			return { holding = false }
		end
		return nil
	end
	-- the bar's height now (display) and the failure at the top
	function s.advance(t)
		-- (a rep nobody starts closes after seg.wait: an idle player still reaches the end of the set)
		if not s.closed and not s.holdStart and seg.wait and t - M >= seg.wait then
			s.closed = true
			s.endT = M + seg.wait
		end
		if s.closed or not s.holdStart then
			return s.f
		end
		local f = seg.speed * (t - s.holdStart)
		if f >= 1 then
			s.closed = true
			s.failed = true
			s.f = 1
			s.endT = s.holdStart + 1 / seg.speed
		else
			s.f = math.max(0, f)
		end
		return s.f
	end
	function s.finish(t)
		s.advance(t)
		s.closed = true
	end
	function s.result()
		local pressed = s.holdStart ~= nil and (s.failed or s.endT ~= nil)
		local f, lo, width = s.f, seg.lo, seg.width
		local q, verdict = 0, "none"
		-- (a rep that misses the zone still counts for something: failing a rep costs little)
		if not pressed then
			q = 0
		elseif s.failed then
			q, verdict = seg.mode == "slam" and 0.4 or 0.25, "over"
		elseif f >= lo and f <= lo + width then
			local center = math.abs(f - (lo + width / 2)) / (width / 2)
			q, verdict = center < 0.5 and 1 or 0.85, center < 0.5 and "perfect" or "good"
		elseif f < lo then
			q, verdict = 0.55, "short"
		else
			q, verdict = seg.mode == "slam" and 0.5 or 0.45, "long"
		end
		return { pressed = pressed, f = f, failed = s.failed == true, q = q, verdict = verdict }
	end
	-- (a rep waits for its press: nobody knows its end before that)
	function s.endsAt()
		return s.endT or (s.holdStart and s.holdStart + 1 / seg.speed) or (seg.wait and M + seg.wait) or nil
	end
	return s
end

-- the cardio pace: each press adds `kick` to the pace, which drains `decay` a second; the time spent
-- inside each interval's zone counts (integrated exactly, so both sides get the same number)
J.pace = function(seg, M)
	local phases, n = seg.phases, #seg.phases
	local dur = seg.duration
	local len = dur / n
	local s = { v = seg.v0, at = M, inZone = 0, closed = false }
	local function phaseOf(a)
		return math.min(n, math.floor((a - M) / len + 1e-7) + 1)
	end
	s.phaseOf = phaseOf
	local function integrate(a, b)
		local v = s.v
		while a < b - 1e-9 do
			local pi = phaseOf(a)
			local pe = pi >= n and b or math.min(b, M + pi * len)
			if pe <= a then
				pe = b
			end
			local lo, hi = phases[pi][1], phases[pi][2]
			-- v(x) = v - decay * (x - a) (until 0): inside [lo, hi] from a + (v - hi) / decay to a + (v - lo) / decay
			if v >= lo then
				local z0 = a + math.max(0, (v - hi) / seg.decay)
				local z1 = a + (v - lo) / seg.decay
				s.inZone += math.max(0, math.min(z1, pe) - math.max(z0, a))
			end
			v = math.max(0, v - seg.decay * (pe - a))
			a = pe
		end
		s.v = v
	end
	function s.advance(t)
		t = math.min(t, M + dur)
		if t > s.at then
			integrate(s.at, t)
			s.at = t
		end
		if t >= M + dur then
			s.closed = true
		end
		return s.v
	end
	function s.input(id, down, t)
		if not down or s.closed or t < M then
			return nil
		end
		s.advance(t)
		if s.closed then
			return nil
		end
		s.v = math.min(1, s.v + seg.kick)
		return { v = s.v }
	end
	function s.finish(t)
		s.advance(t)
		s.closed = true
	end
	function s.result()
		return { inZone = s.inZone, duration = dur }
	end
	function s.endsAt()
		return M + dur
	end
	return s
end

-- guided breathing: hold (or tap on) through the inhale, release through the exhale; the time in
-- sync with the circle counts
J.breath = function(seg, M)
	local cycle = seg.inhale + seg.exhale
	local dur = seg.breaths * cycle
	local s = { clock = M, sync = 0, on = false, closed = false, duration = dur }
	-- time spent inhaling between the start and x seconds in
	local function inhaled(x)
		local full = math.floor(x / cycle)
		return full * seg.inhale + math.min(x - full * cycle, seg.inhale)
	end
	function s.inPhase(t)
		return ((t - M) % cycle) < seg.inhale
	end
	function s.advance(t)
		t = math.min(t, M + dur)
		if t > s.clock then
			local inh = inhaled(t - M) - inhaled(s.clock - M)
			s.sync += s.on and inh or ((t - s.clock) - inh)
			s.clock = t
		end
		if t >= M + dur then
			s.closed = true
		end
	end
	function s.input(id, down, t)
		if s.closed or t < M then
			return nil
		end
		s.advance(t)
		if s.closed then
			return nil
		end
		local flip = tapHold(s, down, t)
		return flip and { holding = flip == "on" } or nil
	end
	function s.finish(t)
		s.advance(t)
		s.closed = true
	end
	function s.result()
		return { sync = s.sync, duration = dur }
	end
	function s.endsAt()
		return M + dur
	end
	return s
end

-- the jump rope: the rope turns at omega (x1.5 on a double under) from overhead; it passes the feet at
-- every full turn and the pass is judged seg.late (0.12 s) later on the jumps from seg.early (0.48 s)
-- before to seg.late after it. HOLD AND RELEASE: JUMP held is the crouch, its RELEASE is the jump (a
-- quick tap is a small hop and counts too); a DOUBLE UNDER is one jump loaded longer - JUMP held at
-- least seg.charge seconds before the release (the charge ring fills). The boxer skip's foot calls are
-- presses of the called foot. One jump earlier than the window since the last pass is forgiven (a
-- nervous hop); two or more are jumping on nothing: mistimed - mashing the button trips. A clean jump
-- speeds the rope up; a trip stops it for 0.45 s and slows it a little (the rhythm is lost, not the
-- progress: nothing resets). A clean jump released within seg.perfW of the pass is SWEET (perfect).
local ROPE_EARLY, ROPE_LATE, ROPE_TRIP, ROPE_CHARGE, ROPE_DOUBLE = 0.48, 0.12, 0.45, 0.22, 1.5
DrillScore.ROPE_DOUBLE = ROPE_DOUBLE
DrillScore.ROPE_CHARGE = ROPE_CHARGE
J.rope = function(seg, M)
	local cues = seg.cues
	local early, late, charge = seg.early or ROPE_EARLY, seg.late or ROPE_LATE, seg.charge or ROPE_CHARGE
	local perfW = seg.perfW or 0.08
	local s = { phase = math.pi, tau = M, omega = seg.omega, ci = 1, done = 0, clean = 0, sweet = 0, doubles = 0, pressed = {}, tripped = M, closed = false, charge = charge }
	s.cue = cues[1] or "jump"
	local function rate()
		return s.omega * (s.cue == "double" and ROPE_DOUBLE or 1)
	end
	s.w = rate()
	-- judgements made since the last call (the client's feedback)
	local function judge(out)
		local pass = s.pending
		local J0 = pass + late
		local count, good, wasEarly, earlyN, loaded, dt = 0, true, false, 0, false, math.huge
		local keep = {}
		for _, p in ipairs(s.pressed) do
			if p.t < pass - early then
				earlyN += 1
				if earlyN >= 2 then
					good, wasEarly = false, true
				end
			elseif p.t <= pass + late then
				count += 1
				if math.abs(p.t - pass) < math.abs(dt) then
					dt = p.t - pass
				end
				if s.passCue == "jump" or s.passCue == "double" then
					good = good and p.id == "jump"
					loaded = loaded or (p.held or 0) >= charge - 1e-6
				else
					good = good and p.id == s.passCue
				end
			end
			if p.t > J0 then
				table.insert(keep, p)
			end
		end
		s.pressed = keep
		s.phase += s.w * (J0 - s.tau)
		s.tau = J0
		s.done += 1
		-- (a double under is one jump, loaded: the hold before its release reached the charge)
		local clean = count >= 1 and good and (s.passCue ~= "double" or loaded)
		local sweet = clean and math.abs(dt) <= perfW
		if clean then
			s.clean += 1
			if sweet then
				s.sweet += 1
			end
			if s.passCue == "double" then
				s.doubles += 1
			end
			s.omega = math.min(11.5, s.omega + 0.12)
		else
			s.tripped = J0 + ROPE_TRIP
			s.omega = math.max(6, s.omega - 0.35)
			s.phase = math.pi
		end
		table.insert(out, { cue = s.passCue, clean = clean, count = count, early = wasEarly, short = s.passCue == "double" and count >= 1 and not loaded, sweet = sweet, dt = clean and dt or nil, t = J0 })
		s.pending = nil
		s.ci += 1
		s.cue = cues[s.ci] or "jump"
		s.w = rate()
	end
	function s.advance(t)
		local out = {}
		while s.done < seg.jumps do
			if s.tau < s.tripped then
				if t < s.tripped then
					break
				end
				s.tau = s.tripped
				local keep = {}
				for _, p in ipairs(s.pressed) do
					if p.t >= s.tripped then
						table.insert(keep, p)
					end
				end
				s.pressed = keep
			end
			if s.pending then
				if t < s.pending + late then
					break
				end
				judge(out)
			else
				local k = math.floor(s.phase / TWO_PI) + 1
				local tc = s.tau + (TWO_PI * k - s.phase) / s.w
				if t < tc then
					break
				end
				s.phase = TWO_PI * k
				s.tau = tc
				s.pending = tc
				s.passCue = s.cue
			end
		end
		if s.done >= seg.jumps then
			s.closed = true
		end
		return out
	end
	-- the rope's angle now (display)
	function s.angle(t)
		if t < s.tripped then
			return math.pi
		end
		return s.phase + s.w * (t - math.max(s.tau, s.tripped))
	end
	-- how long JUMP has been held (the crouch / the double under's charge), 0 when it is up
	function s.loading(t)
		return s.downAt and math.max(0, t - s.downAt) or 0
	end
	function s.input(id, down, t)
		if s.closed or t < M then
			return nil
		end
		local out = s.advance(t)
		if s.closed then
			return out
		end
		if id == "jump" then
			-- the press crouches, the release jumps (a press during a trip loads nothing)
			if down then
				s.downAt = t >= s.tripped and t or nil
			elseif s.downAt then
				table.insert(s.pressed, { id = id, t = t, held = t - s.downAt })
				s.downAt = nil
			end
		elseif down and t >= s.tripped then
			table.insert(s.pressed, { id = id, t = t })
		end
		return out
	end
	function s.finish(t)
		s.advance(t)
		s.closed = true
	end
	function s.result()
		return { clean = s.clean, sweet = s.sweet, done = s.done, doubles = s.doubles, jumps = seg.jumps }
	end
	-- the last jump judged (s.tau moves to each judgement)
	function s.endsAt()
		return s.done >= seg.jumps and s.tau or nil
	end
	return s
end

-- reaction lights (smart ladder): a pad lights after a short random gap; step to it (score by how
-- fast); a press with nothing lit does nothing
J.lights = function(seg, M)
	local ids, n = seg.ids, #seg.ids
	local s = { idx = 1, lit = false, nextLight = M + seg.first, score = 0, total = 0, correct = 0, closed = false }
	local function light(t)
		if not s.lit and s.idx <= n and t >= s.nextLight then
			s.lit = true
			s.lightAt = s.nextLight
			return true
		end
		return false
	end
	function s.input(id, down, t)
		if not down or s.closed or t < M then
			return nil
		end
		if t - M >= seg.limit then
			s.closed = true
			return nil
		end
		light(t)
		if not s.lit then
			return nil
		end
		s.total += 1
		local rt = t - s.lightAt
		if id == ids[s.idx] and rt >= RT_FLOOR then
			s.correct += 1
			-- (a human half-second is a good step; only a real hesitation costs)
			s.score += math.max(0.4, 1 - math.max(0, rt - 0.25) / 1.4)
			s.lit = false
			s.nextLight = t + (seg.delays[s.idx] or 0.2)
			s.idx += 1
			if s.idx > n then
				s.doneAt = t
				s.closed = true
			end
			return { ok = true, rt = rt }
		end
		return { ok = false, early = id == ids[s.idx] }
	end
	-- true when a pad lights up now (display)
	function s.advance(t)
		if t - M >= seg.limit then
			s.closed = true
			return false
		end
		return light(t)
	end
	function s.finish(t)
		s.advance(t)
		s.closed = true
	end
	function s.result()
		return { score = s.score, total = s.total, correct = s.correct, complete = s.idx > n, n = n, time = s.doneAt and (s.doneAt - M) or seg.limit }
	end
	function s.endsAt()
		return s.doneAt or (M + seg.limit)
	end
	return s
end

DrillScore.Judges = J

-- the judge for one plan segment, started at M (drill clock)
function DrillScore.Judge(seg, M)
	local make = type(seg) == "table" and J[seg.j]
	if not make then
		return nil
	end
	return make(seg, M)
end

------------------------------------------------------------------------
-- Session score from the segments' results (missing = not played)
------------------------------------------------------------------------
local AGG = {}
-- a wrong press costs this much of a step (the chain itself never resets)
DrillScore.WRONG_COST = 0.35
AGG.combo = function(plan, res)
	local good, total, rhythm, combos, powerSum, shots, speedScore = 0, 0, 0, 0, 0, 0, 0
	for i, seg in ipairs(plan.segs) do
		local r = res[i]
		if seg.j == "seq" then
			combos += 1
			total += #seg.ids
			if r then
				good += math.max(0, r.done - r.wrong * DrillScore.WRONG_COST)
				-- the rhythm of the hits (a combo without a beat: how quickly it came)
				rhythm += r.beatQ or clamp(r.frac / 0.6, 0, 1)
			end
		elseif seg.j == "needle" then
			shots += 1
			powerSum += r and r.timing or 0
		elseif seg.j == "burst" and r then
			speedScore = clamp(r.count / seg.dur / seg.target, 0, 1)
		end
	end
	local comboScore = clamp(0.7 * good / math.max(1, total) + 0.3 * rhythm / math.max(1, combos), 0, 1)
	local powerScore = clamp(powerSum / math.max(1, shots), 0, 1)
	return 0.5 * comboScore + 0.25 * powerScore + 0.25 * speedScore
end
-- a round of notes: perfect 1, good 0.75, a stray press -0.35 (mashing both hands scores nothing)
local function notesShare(seg, r)
	if not r then
		return 0
	end
	return clamp((r.perfect + r.good * 0.75 - 0.35 * (r.stray or 0)) / math.max(1, #seg.lanes), 0, 1)
end
DrillScore.NotesShare = notesShare
AGG.rhythm = function(plan, res)
	local sum = 0
	for i, seg in ipairs(plan.segs) do
		sum += notesShare(seg, res[i])
	end
	return sum / math.max(1, #plan.segs)
end
AGG.reaction = function(plan, res)
	local s1, n1, s2, n2, s3, n3 = 0, 0, 0, 0, 0, 0
	for i, seg in ipairs(plan.segs) do
		local r = res[i]
		if seg.j == "rebound" then
			n3 += 1
			s3 += Workouts.ReboundScore(seg, r)
		elseif seg.j == "cue" then
			n1 += 1
			if r and r.correct then
				s1 += 1 - 0.3 * (r.rt / seg.window)
			end
		elseif seg.j == "counter" then
			n2 += 1
			if r and r.step == 3 and r.rt then
				s2 += 0.7 + 0.3 * clamp(1 - r.rt / seg.cw, 0, 1)
			elseif r and r.step == 2 then
				s2 += 0.4
			end
		end
	end
	local react, counter = clamp(s1 / math.max(1, n1) / 0.9, 0, 1), clamp(s2 / math.max(1, n2) / 0.9, 0, 1)
	if n3 == 0 then
		return 0.55 * react + 0.45 * counter
	end
	return 0.35 * react + 0.3 * counter + 0.35 * clamp(s3 / n3 / 0.9, 0, 1)
end
-- a called combination / a flow chain: how much of it, minus half a step per wrong press, plus speed
function DrillScore.SeqScore(r, partW, fastW, cap)
	if not r then
		return 0
	end
	local part = math.max(0, r.done - r.wrong * DrillScore.WRONG_COST) / math.max(1, r.n)
	return math.min(cap, part * partW + r.frac * fastW)
end
-- a called combination (J.call): the answers (perfect 1, good 0.85, a wrong move a quarter) over the real
-- calls, times the feints held (biting on half of them costs a quarter)
function DrillScore.CallScore(r)
	if not r then
		return 0
	end
	local answers = (r.perfect + 0.85 * r.good + 0.25 * r.wrong) / math.max(1, r.real)
	local feint = 1 - 0.5 * r.bitten / math.max(1, r.feints)
	return clamp(answers * feint - 0.1 * (r.stray or 0) / math.max(1, r.real), 0, 1)
end
AGG.mitts = function(plan, res)
	local sum = 0
	for i, seg in ipairs(plan.segs) do
		if seg.j == "call" then
			sum += DrillScore.CallScore(res[i])
		else
			sum += DrillScore.SeqScore(res[i], 0.8, 0.35, 1.15)
		end
	end
	return sum / math.max(1, #plan.segs)
end
AGG.shadow = function(plan, res)
	local s1, n1, s2, n2, s3, n3 = 0, 0, 0, 0, 0, 0
	for i, seg in ipairs(plan.segs) do
		local r = res[i]
		if seg.j == "notes" then
			n3 += 1
			s3 += notesShare(seg, r)
		elseif seg.j == "cue" then
			n1 += 1
			if r and r.correct then
				s1 += 1 - 0.3 * r.rt / seg.window
			end
		else
			n2 += 1
			s2 += DrillScore.SeqScore(r, 0.8, 0.4, 1)
		end
	end
	local moves, flows = clamp(s1 / math.max(1, n1) / 0.9, 0, 1), clamp(s2 / math.max(1, n2), 0, 1)
	if n3 == 0 then
		return 0.5 * moves + 0.5 * flows
	end
	return 0.35 * moves + 0.3 * clamp(s3 / n3 / 0.9, 0, 1) + 0.35 * flows
end
AGG.reps = function(plan, res)
	local sum = 0
	for i in ipairs(plan.segs) do
		sum += res[i] and res[i].q or 0
	end
	return sum / math.max(1, #plan.segs)
end
AGG.medball = function(plan, res)
	local slam, slams, core = 0, 0, 0
	for i, seg in ipairs(plan.segs) do
		local r = res[i]
		if seg.j == "lift" then
			slams += 1
			slam += r and r.q or 0
		elseif seg.j == "notes" then
			core = notesShare(seg, r)
		elseif seg.j == "wobble" and r then
			-- the plank: the time held in the green (Workouts.TIMED_FULL of it is full marks), a slip costs a tenth
			core = clamp(r.acc / math.max(0.1, r.duration) / Workouts.TIMED_FULL - 0.1 * (r.lost or 0), 0, 1)
		end
	end
	return 0.55 * slam / math.max(1, slams) + 0.45 * core
end
-- this share of the cardio session spent in the zone is full marks (Activities grades each interval
-- on the same scale for the live QUALITY tile)
DrillScore.PACE_FULL = 0.85
AGG.pace = function(plan, res)
	local r, seg = res[1], plan.segs[1]
	return r and clamp(r.inZone / seg.duration / DrillScore.PACE_FULL, 0, 1) or 0
end
AGG.ladder = function(plan, res)
	local score, total, completed = 0, 0, 0
	for i, seg in ipairs(plan.segs) do
		local r = res[i]
		if r then
			if seg.j == "lights" then
				score += r.score
				total += r.total
				if r.complete then
					completed += 1
				end
			elseif seg.j == "notes" then
				-- the stepped pattern: the steps on the beat; a drill with most of its steps is run through
				score += math.max(0, r.perfect + 0.8 * r.good - 0.35 * (r.stray or 0))
				total += r.count
				if r.hits >= 0.6 * r.count then
					completed += 1
				end
			else
				score += r.done
				total += r.presses
				if r.complete then
					completed += 1
				end
			end
		end
	end
	return clamp(score / math.max(1, total), 0, 1) * (0.5 + 0.5 * completed / math.max(1, #plan.segs))
end
AGG.rope = function(plan, res)
	local clean, jumps = 0, 0
	for i, seg in ipairs(plan.segs) do
		jumps += seg.jumps
		clean += res[i] and res[i].clean or 0
	end
	return clean / math.max(1, jumps)
end
AGG.hold = function(plan, res)
	local r, seg = res[1], plan.segs[1]
	local dur = seg and seg.breaths * (seg.inhale + seg.exhale) or 1
	return r and r.sync / dur or 0
end

-- the session's 0..1 score from the segments' results (results[i] for plan.segs[i])
function DrillScore.Aggregate(plan, results)
	local agg = type(plan) == "table" and AGG[plan.kind]
	if not agg or type(plan.segs) ~= "table" then
		return 0
	end
	local ok, v = pcall(agg, plan, results or {})
	if not ok or type(v) ~= "number" or v ~= v then
		return 0
	end
	return clamp(v, 0, 1)
end

-- the server's replay: the recorded stream (in time order; "@" starts the next segment) through the
-- plan's judges up to tEnd (the drill clock when the session was handed in). The plan's pacing holds:
-- segment i starts no sooner than seg.gap after segment i - 1 was over (the drill's start for the
-- first) - an earlier "@" starts it at that moment instead, so a stream that skips the rounds' banners,
-- the rests or the cues' lead-ins finds its inputs before the segment began (they count for nothing).
-- Returns the score, the results and the pacing ({ late = segments started early, lost = their seconds }).
function DrillScore.Replay(plan, events, tEnd)
	local pacing = { late = 0, lost = 0 }
	if type(plan) ~= "table" or type(plan.segs) ~= "table" then
		return 0, {}, pacing
	end
	local results, i, judge = {}, 0, nil
	-- the segment is over at t: when it ended for the player (never later than t, the next marker)
	local function close(t)
		if not judge then
			return t
		end
		judge.finish(t)
		results[i] = judge.result()
		local e = judge.endsAt()
		judge = nil
		return (type(e) == "number" and e == e) and math.min(e, t) or t
	end
	local over = 0
	for _, e in ipairs(events or {}) do
		if e.t > tEnd then
			break
		end
		if e.id == "@" then
			if i > 0 then
				over = close(e.t)
			end
			i += 1
			local seg = plan.segs[i]
			if not seg then
				break
			end
			local gap = tonumber(seg.gap) or 0
			local M = e.t
			local allowed = over + gap - DrillScore.GAP_SLACK
			if M < allowed then
				pacing.late += 1
				pacing.lost += allowed - M
				M = allowed
			end
			judge = DrillScore.Judge(seg, M)
		elseif judge then
			judge.input(e.id, e.down, e.t)
		end
	end
	close(tEnd)
	return DrillScore.Aggregate(plan, results), results, pacing
end

-- the least time the plan takes played perfectly: every gap plus each segment's shortest honest length
-- (Main.server.lua: a session handed in under 80% of it is too quick to count)
function DrillScore.MinTime(plan)
	local total = 0
	for _, seg in ipairs(type(plan) == "table" and type(plan.segs) == "table" and plan.segs or {}) do
		total += tonumber(seg.gap) or 0
		local j = seg.j
		if j == "cue" then
			total += RT_FLOOR
		elseif j == "counter" then
			total += 2 * RT_FLOOR
		elseif j == "burst" then
			total += seg.dur
		elseif j == "notes" then
			local notes = J.notes(seg, 0).notes
			total += math.max(0, (notes[#notes] and notes[#notes].t or 0) - seg.hitW)
		elseif j == "call" then
			total += seg.lead + (#seg.ids - 1) * seg.call + RT_FLOOR
		elseif j == "lift" then
			total += seg.lo / seg.speed
		elseif j == "pace" then
			total += seg.duration
		elseif j == "breath" then
			total += seg.breaths * (seg.inhale + seg.exhale)
		elseif j == "rope" then
			total += seg.jumps * TWO_PI / (11.5 * 1.9) -- the rope's top speed, every pass a double under
		elseif j == "lights" then
			total += seg.first + #seg.ids * RT_FLOOR
			for k = 1, #seg.ids - 1 do
				total += seg.delays[k] or 0
			end
		else
			total += Workouts.MinTime(seg) or 0
		end
	end
	return total
end

DrillScore.Workouts = Workouts
Workouts.Install(DrillScore, J, AGG)

return DrillScore
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="60">
        <Properties>
          <string name="Name">DrillWorkouts</string>
          <string name="Source"><![CDATA[-- DrillWorkouts: the judges and plans of the exercise-specific workouts (the weight room, the cardio
-- machines, the recovery stations) and the extra boxing rounds (double-end rebounds, shadow footwork).
-- DrillScore installs them next to its own judges (DrillScore.Install at the end of DrillScore.lua);
-- Training.DrillPlan draws their plans with DrillWorkouts.Plan. Like DrillScore: no Roblox services,
-- the same code on the client (which plays the drill) and on the server (which replays the inputs).
--
-- The continuous drills (the bar's tilt, a swing, a cadence, a cold meter...) run on a fixed step of
-- TICK seconds counted from the segment's start: an input at t first brings the state up to t, then
-- changes what is held. The client's frames and the server's replay call advance() at different
-- moments; the fixed steps make both land on the same numbers.
--
-- Every judge closes on its own (a rep nobody starts closes after seg.wait), so an idle player always
-- reaches the end of the session.
local W = {}

local TICK = 1 / 30
W.TICK = TICK
-- a tap on a hold-to-correct control (the bar's sides, the chamber's valves) still counts for this long
local NUDGE = 0.15
W.NUDGE = NUDGE
local RT_FLOOR = 0.1

local function clamp(v, lo, hi)
	return math.max(lo, math.min(hi, v))
end

-- the fixed-step clock: s.advance(t) runs step(T) for every tick M + k * TICK <= t (until closed)
local function stepper(s, M, step)
	s.k = 0
	function s.advance(t)
		if t ~= t then
			return s
		end
		local n = math.floor((t - M) / TICK + 1e-6)
		while s.k < n and not s.closed do
			s.k += 1
			step(M + s.k * TICK)
		end
		return s
	end
end

-- a hold with a minimum length (a tap or a stick flick still nudges): held(id, T)
local function holds(s)
	s.hold, s.holdUntil = {}, {}
	function s.held(id, T)
		return s.hold[id] == true or (s.holdUntil[id] or -1) >= T
	end
	function s.setHold(id, down, t)
		s.hold[id] = down == true
		if down then
			s.holdUntil[id] = t + NUDGE
		end
	end
end

-- the power-shot style needle (0 -> 1 -> 0 at `sweep` crossings a second)
local function needle(el, sweep)
	local u = (math.max(0, el) * sweep) % 2
	return u < 1 and u or 2 - u
end
W.Needle = needle

local function finishOf(s)
	return function(t)
		s.advance(t)
		s.closed = true
	end
end

------------------------------------------------------------------------
-- Judges
------------------------------------------------------------------------
local J = {}

-- BENCH PRESS: PRESS (tap or hold) drives the bar up; the bar tilts on its own (seg.drift: two sine
-- waves and a weak side) and LEFT / RIGHT push that end up. x > 0: the LEFT end dips. Tilted past
-- tiltMax the spotter grabs it; SPOT asks for the spotter (an assisted rep); a rep that stalls for
-- seg.limit is taken by the spotter too. Released mid-rep, the bar sinks back.
J.bench = function(seg, M, TapHold)
	local s = { closed = false, p = 0, x = 0, press = {}, sum = 0, n = 0, maxX = 0 }
	holds(s)
	local d = seg.drift
	function s.driftAt(el)
		return d[1] * math.sin(d[2] * el + d[3]) + d[4] * math.sin(d[5] * el + d[6]) + (seg.bias or 0)
	end
	local function close(T, v)
		s.closed, s.endT, s.verdict = true, T, v
	end
	stepper(s, M, function(T)
		if not s.started then
			if T - M >= seg.wait then
				close(T, "none")
			end
			return
		end
		local stick = s.p >= seg.stickLo and s.p <= seg.stickHi
		if s.press.on then
			local v = seg.speed * (stick and seg.stickMult or 1) * (1 - 0.5 * math.min(1, math.abs(s.x) / seg.tiltMax))
			s.p = math.min(1, s.p + v * TICK)
		else
			s.p = math.max(0, s.p - seg.sink * TICK)
		end
		s.x += s.driftAt(T - s.startT) * TICK
		if s.held("L", T) then
			s.x -= seg.corr * TICK
		end
		if s.held("R", T) then
			s.x += seg.corr * TICK
		end
		local ax = math.abs(s.x)
		s.sum += ax
		s.n += 1
		s.maxX = math.max(s.maxX, ax)
		if ax >= seg.tiltMax then
			close(T, "tilted")
		elseif s.p >= 1 then
			close(T, "lockout")
		elseif T - s.startT >= seg.limit then
			close(T, "stalled")
		end
	end)
	function s.input(id, down, t)
		if s.closed or t < M then
			return nil
		end
		s.advance(t)
		if s.closed then
			return nil
		end
		if id == "press" then
			local flip = TapHold(s.press, down, t)
			if flip == "on" and not s.started then
				s.started, s.startT = true, t
			end
			return flip and { press = flip == "on" } or nil
		elseif id == "L" or id == "R" then
			s.setHold(id, down, t)
		elseif id == "spot" and down and s.started then
			close(t, "assisted")
			return { spot = true }
		end
		return nil
	end
	s.finish = finishOf(s)
	function s.result()
		local v = s.verdict or (s.started and "stalled" or "none")
		local q = 0
		local avg = s.sum / math.max(1, s.n)
		if v == "lockout" then
			-- (a level bar: the mean tilt under 0.12 is full marks, 0.47 the floor of a locked-out rep)
			q = clamp(1 - math.max(0, avg - 0.12) / 0.35, 0.5, 1)
			if s.maxX > 0.85 * seg.tiltMax then
				q *= 0.9
			end
		elseif v == "assisted" then
			q = 0.45 + 0.2 * s.p
		elseif v == "tilted" then
			q = 0.3
		elseif v == "stalled" then
			q = 0.25 + 0.2 * s.p
		end
		return { q = q, verdict = v, p = s.p, avgTilt = avg, maxTilt = s.maxX, pressed = s.started == true }
	end
	function s.endsAt()
		return s.endT or (not s.started and (M + seg.wait)) or nil
	end
	s.minTime = 1 / seg.speed
	return s
end

-- DEADLIFT: SET YOUR BACK - the back-angle needle swings between rounded and over-arched; the LIFT press
-- sets it where the needle is (neutral = the gold band) and starts the pull. LIFT held (or tapped on)
-- drives the bar; let go and it drops back. Off the floor the GRIP meter drains (faster through the
-- sticking point at the knees); GRIP squeezes it back up. Grip at zero: the bar slips.
J.deadlift = function(seg, M, TapHold)
	local s = { closed = false, phase = "set", p = 0, g = 1, minG = 1, lift = {}, grips = 0 }
	local function close(T, v)
		s.closed, s.endT, s.verdict = true, T, v
	end
	function s.needleAt(t)
		return needle(t - M, seg.sweep)
	end
	stepper(s, M, function(T)
		if s.phase == "set" then
			if T - M >= seg.wait then
				close(T, "none")
			end
			return
		end
		local stick = s.p >= seg.stickLo and s.p <= seg.stickHi
		if s.lift.on then
			s.p = math.min(1, s.p + seg.speed * (stick and seg.stickMult or 1) * TICK)
		else
			s.p = math.max(0, s.p - seg.drop * TICK)
		end
		if s.p > 0 then
			s.g -= seg.drain * (stick and 1.4 or 1) * TICK
			s.minG = math.min(s.minG, s.g)
			if s.g <= 0 then
				s.g = 0
				close(T, "grip")
				return
			end
		end
		if s.p >= 1 then
			close(T, "lockout")
		elseif T - s.setT >= seg.limit then
			close(T, "stalled")
		end
	end)
	function s.input(id, down, t)
		if s.closed or t < M then
			return nil
		end
		s.advance(t)
		if s.closed then
			return nil
		end
		if id == "lift" then
			local flip = TapHold(s.lift, down, t)
			if flip == "on" and s.phase == "set" then
				s.phase, s.setT = "drive", t
				local pos = s.needleAt(t)
				local dd, w = math.abs(pos - seg.c), seg.w
				if dd <= w then
					s.setQ = 1 - 0.1 * dd / w
				elseif dd <= 2.5 * w then
					s.setQ = 0.85 - 0.35 * (dd - w) / (1.5 * w)
				else
					s.setQ = 0.45
				end
				s.setPos = pos
				return { set = true, pos = pos, d = dd, setQ = s.setQ }
			end
			return flip and { lift = flip == "on" } or nil
		elseif id == "grip" and down and s.phase == "drive" then
			s.g = math.min(1, s.g + seg.gripTap)
			s.grips += 1
			return { grip = s.g }
		end
		return nil
	end
	s.finish = finishOf(s)
	function s.result()
		local v = s.verdict or (s.phase == "drive" and "stalled" or "none")
		local q = 0
		local setQ = s.setQ or 0
		if v == "lockout" then
			local band = seg.stickHi - seg.stickLo
			local ideal = band / (seg.speed * seg.stickMult) + (1 - band) / seg.speed
			local tq = clamp(ideal / math.max(0.01, s.endT - s.setT), 0.7, 1)
			local gq = clamp(0.5 + s.minG * 1.5, 0.5, 1)
			q = 0.4 * setQ + 0.35 * gq + 0.25 * tq
		elseif v == "grip" then
			q = 0.3 + 0.15 * s.p
		elseif v == "stalled" then
			q = 0.25 + 0.2 * s.p
		end
		return { q = q, verdict = v, p = s.p, setQ = setQ, minGrip = s.minG, grips = s.grips, pressed = s.phase == "drive" }
	end
	function s.endsAt()
		return s.endT or (s.phase == "set" and (M + seg.wait)) or nil
	end
	s.minTime = RT_FLOOR + 1 / seg.speed
	return s
end

-- SQUAT: SIT (tap or hold) starts the descent - it speeds up as you sink (v0 + acc * t); let go to stop
-- at the bottom: the depth is judged against the depth zone (parallel). Then SIT again inside the
-- bounce window (seg.bounce .. seg.pause after the bottom) and keep it on to drive up; letting go on the
-- way up stalls (the bar sinks a little). Sink all the way (depth 1) and you dive-bombed the hole.
J.squat = function(seg, M, TapHold)
	local s = { closed = false, phase = "ready", z = 0, u = 0, sit = {}, stalls = 0 }
	local function close(T, v)
		s.closed, s.endT, s.verdict = true, T, v
	end
	stepper(s, M, function(T)
		local ph = s.phase
		if ph == "ready" then
			if T - M >= seg.wait then
				close(T, "none")
			end
		elseif ph == "descend" then
			s.z += (seg.v0 + seg.acc * (T - s.descT)) * TICK
			if s.z >= 1 then
				s.z = 1
				s.phase, s.bottomT, s.bottomZ = "bottom", T, 1
			end
		elseif ph == "bottom" then
			if T - s.bottomT >= seg.lost then
				close(T, "stuck")
			end
		elseif ph == "drive" then
			if s.sit.on then
				s.u = math.min(1, s.u + seg.rise * TICK)
			else
				s.u = math.max(0, s.u - 0.3 * TICK)
			end
			if s.u >= 1 then
				close(T, "stand")
			elseif T - s.driveT >= seg.limit then
				close(T, "stalled")
			end
		end
	end)
	function s.depth()
		return s.phase == "drive" and (s.bottomZ or s.z) * (1 - s.u) or s.z
	end
	function s.input(id, down, t)
		if s.closed or t < M or id ~= "sit" then
			return nil
		end
		s.advance(t)
		if s.closed then
			return nil
		end
		local flip = TapHold(s.sit, down, t)
		if not flip then
			return nil
		end
		local ph = s.phase
		if ph == "ready" and flip == "on" then
			s.phase, s.descT = "descend", t
			return { descend = true }
		elseif ph == "descend" and flip == "off" then
			s.phase, s.bottomT, s.bottomZ = "bottom", t, s.z
			return { bottom = true, z = s.z }
		elseif ph == "bottom" and flip == "on" then
			s.phase, s.driveT = "drive", t
			s.pressDt = t - s.bottomT
			return { drive = true, dt = s.pressDt }
		elseif ph == "drive" and flip == "off" then
			s.stalls += 1
			return { stall = true }
		end
		return nil
	end
	s.finish = finishOf(s)
	function s.result()
		local v = s.verdict or ((s.phase == "drive" and "stalled") or (s.phase == "ready" and "none") or "stuck")
		local z, lo, hi = s.bottomZ or s.z, seg.lo, seg.hi
		local depthQ, depth
		if z >= 1 then
			depthQ, depth = 0.45, "dive"
		elseif z >= lo and z <= hi then
			depthQ, depth = 1 - 0.1 * math.abs(z - (lo + hi) / 2) / ((hi - lo) / 2), "zone"
		elseif z < lo then
			depthQ, depth = 0.5 + 0.3 * clamp(1 - (lo - z) / 0.2, 0, 1), "high"
		else
			depthQ, depth = 0.7, "deep"
		end
		local driveQ, drive = 0, "none"
		local dt = s.pressDt
		if dt then
			if dt < seg.bounce then
				driveQ, drive = 0.7, "bounce"
			elseif dt <= seg.pause then
				driveQ, drive = 1, "good"
			else
				driveQ, drive = clamp(1 - (dt - seg.pause) * 0.4, 0.6, 0.9), "pause"
			end
		end
		local q = 0
		if v == "stand" then
			q = 0.5 * depthQ + 0.3 * driveQ + 0.2 * math.max(0.5, 1 - 0.15 * s.stalls)
		elseif v == "stalled" then
			q = 0.25 + 0.2 * s.u
		elseif v == "stuck" then
			q = 0.3 * depthQ
		end
		return { q = q, verdict = v, z = z, depth = depth, depthQ = depthQ, drive = drive, pressDt = dt, stalls = s.stalls, pressed = v ~= "none" }
	end
	function s.endsAt()
		return s.endT or (s.phase == "ready" and (M + seg.wait)) or nil
	end
	s.minTime = 0.5 + 1 / seg.rise
	return s
end

-- PULL-UPS (hold and release, grip stamina): one segment is a set of seg.reps reps. PULL held climbs
-- (seg.speed a second, slower as the grip tires: x(0.6 + 0.4 grip)); RELEASE with the chin over the bar -
-- the height inside [seg.lo, 1] - is a rep (SWEET inside [seg.perfLo, seg.perfHi]); a release below it is
-- SHORT (no rep, nothing else lost). After a release the body lowers under control (seg.sink a second)
-- and the next pull starts from the bottom (h <= seg.ready). The GRIP drains while you pull (seg.drain, more
-- held at the top: seg.topDrain) and comes back while you hang (seg.regen): pace the set. A grip that runs
-- out drops you off the bar (a SLIP: no rep, the grip back to seg.slipGrip). The set closes on its reps or
-- at seg.limit; a set nobody starts closes after seg.wait.
J.pullup = function(seg, M, TapHold)
	local s = { closed = false, h = 0, grip = 1, pull = false, lowering = false, done = 0, perfect = 0, good = 0, short = 0, slips = 0, topT = 0, reps = {} }
	local function close(T, v)
		s.closed, s.endT, s.verdict = true, T, v
	end
	stepper(s, M, function(T)
		if not s.started then
			s.grip = 1
			if T - M >= seg.wait then
				close(T, "none")
			end
			return
		end
		if s.pull then
			s.h = math.min(1, s.h + seg.speed * (0.6 + 0.4 * s.grip) * TICK)
			s.grip -= (seg.drain + (s.h >= 1 and seg.topDrain or 0)) * TICK
			if s.h >= 1 then
				s.topT += TICK
			end
			if s.grip <= 0 then
				-- the grip gave out: off the bar
				s.grip, s.pull, s.lowering = seg.slipGrip, false, true
				s.slips += 1
				s.last = { verdict = "slip", T = T }
			end
		else
			s.grip = math.min(1, s.grip + seg.regen * (s.h <= seg.ready and 1.5 or 1) * TICK)
			if s.lowering then
				s.h = math.max(0, s.h - seg.sink * TICK)
				if s.h <= seg.ready then
					s.lowering = false
				end
			end
		end
		if s.done >= seg.reps then
			close(T, "set")
		elseif T - s.startT >= seg.limit then
			close(T, "time")
		end
	end)
	function s.ready()
		return not s.lowering and s.h <= seg.ready
	end
	function s.input(id, down, t)
		if s.closed or t < M or id ~= "pull" then
			return nil
		end
		s.advance(t)
		if s.closed then
			return nil
		end
		if down then
			if s.pull or not s.ready() then
				return nil
			end
			if not s.started then
				s.started, s.startT = true, t
			end
			s.pull, s.topT = true, 0
			return { pull = true }
		end
		if not s.pull then
			return nil
		end
		-- the release: where the chin is decides the rep
		s.pull, s.lowering = false, true
		local h = s.h
		local v
		if h >= seg.perfLo and h <= seg.perfHi and s.topT <= 0.25 then
			v = "sweet"
			s.perfect += 1
			s.done += 1
		elseif h >= seg.lo then
			v = "rep"
			s.good += 1
			s.done += 1
		else
			v = "short"
			s.short += 1
		end
		table.insert(s.reps, { verdict = v, h = h, t = t })
		s.last = { verdict = v, h = h, T = t }
		if s.done >= seg.reps then
			close(t, "set")
		end
		return { verdict = v, h = h, done = s.done }
	end
	s.finish = finishOf(s)
	function s.result()
		-- (a sweet rep 1, a rep 0.75; a short pull or a slip costs a little - a cheap failure, never a reset)
		local q = (s.perfect + 0.75 * s.good) / math.max(1, seg.reps) - 0.08 * s.short - 0.1 * s.slips
		return { q = clamp(q, 0, 1), verdict = s.verdict or (s.started and "time" or "none"), perfect = s.perfect, good = s.good, short = s.short, slips = s.slips,
			done = s.done, reps = seg.reps, h = s.h, grip = s.grip, pressed = s.started == true }
	end
	function s.endsAt()
		return s.endT or (not s.started and (M + seg.wait)) or nil
	end
	s.minTime = seg.reps * (seg.lo / seg.speed + (seg.lo - seg.ready) / seg.sink) * 0.8
	return s
end

-- DUMBBELL CURLS on a tempo: each curl is a hold note on its arm's lane (LEFT / RIGHT) - press as it
-- reaches the line (curl up), keep holding through the squeeze, let go as its tail passes (lower).
-- Both arms held at once is swinging the weight (a cheat, counted).
J.tempo = function(seg, M)
	local notes = {}
	local t0 = M + seg.lead
	for i, nd in ipairs(seg.notes) do
		notes[i] = { lane = nd[1], ts = t0 + nd[2] * seg.beat, te = t0 + nd[3] * seg.beat }
	end
	local last = notes[#notes]
	local endT = (last and last.te or M) + seg.relW
	local s = { notes = notes, closed = false, active = {}, down = {}, stray = 0, swings = 0, sum = 0, perfect = 0, missed = 0, endT = endT }
	local function judge(n, at, how)
		n.judged, n.at = true, at
		local sq = n.startErr and ((math.abs(n.startErr) < seg.perfW and 1) or (math.abs(n.startErr) < seg.hitW * 0.65 and 0.85) or 0.6) or 0
		local eq
		if how == "release" then
			local e = at - n.te
			if e < -seg.relW then
				eq = 0.3 + 0.3 * clamp((at - n.ts) / math.max(0.01, n.te - n.ts), 0, 1)
				n.endText = "early"
			else
				eq = 1 - 0.5 * math.abs(e) / seg.relW
				n.endText = "good"
			end
		elseif how == "held" then
			eq, n.endText = 0.55, "late"
		else
			eq, n.endText = 0, "miss"
		end
		n.q = how == "miss" and 0 or (0.5 * sq + 0.5 * eq)
		s.sum += n.q
		if n.q >= 0.9 then
			s.perfect += 1
		end
		if how == "miss" then
			s.missed += 1
		end
		return n
	end
	function s.advance(t)
		local out
		for _, n in ipairs(notes) do
			if not n.judged then
				local how
				if not n.startT and t - n.ts > seg.hitW then
					how = "miss"
				elseif n.startT and t - n.te > seg.relW then
					how = "held"
				end
				if how then
					judge(n, how == "miss" and (n.ts + seg.hitW) or (n.te + seg.relW), how)
					if s.active[n.lane] == n then
						s.active[n.lane] = nil
					end
					out = out or {}
					table.insert(out, n)
				end
			end
		end
		if t >= endT then
			s.closed = true
		end
		return out
	end
	function s.input(id, down, t)
		if s.closed or t < M or (id ~= "L" and id ~= "R") then
			return nil
		end
		s.advance(t)
		if s.closed then
			return nil
		end
		s.down[id] = down
		if down then
			local other = id == "L" and "R" or "L"
			local swing = s.down[other] == true
			if swing then
				s.swings += 1
			end
			local best, bestDt
			for _, n in ipairs(notes) do
				if not n.judged and not n.startT and n.lane == id then
					local dt = t - n.ts
					if math.abs(dt) < seg.hitW and (not best or math.abs(dt) < math.abs(bestDt)) then
						best, bestDt = n, dt
					end
				end
			end
			if not best then
				if t >= t0 - seg.hitW and t <= endT then
					s.stray += 1
				end
				return { id = id, stray = true, swing = swing }
			end
			best.startT, best.startErr = t, bestDt
			s.active[id] = best
			return { id = id, start = best, dt = bestDt, swing = swing }
		end
		local n = s.active[id]
		if not n then
			return nil
		end
		s.active[id] = nil
		judge(n, t, "release")
		return { id = id, release = n }
	end
	s.finish = finishOf(s)
	function s.result()
		return { sum = s.sum, count = #notes, perfect = s.perfect, missed = s.missed, stray = s.stray, swings = s.swings }
	end
	function s.endsAt()
		local e = M
		for _, n in ipairs(notes) do
			e = math.max(e, n.at or (n.te + seg.relW))
		end
		return e
	end
	s.minTime = math.max(0, (last and last.te or M) - M)
	return s
end

-- the time-on-target drills (treadmill, bike, chamber): s.acc counts the ticks' credit (0..1 each)
local function timed(seg, M)
	local s = { closed = false, acc = 0, duration = seg.duration }
	s.finish = function(t)
		s.advance(t)
		s.closed = true
	end
	function s.endsAt()
		return M + seg.duration
	end
	s.minTime = seg.duration
	return s
end
-- the program step in force el seconds in (a list of { t = start, ... })
local function stepAt(list, el)
	local cur = list[1]
	for _, p in ipairs(list) do
		if el + 1e-9 >= p.t then
			cur = p
		end
	end
	return cur
end
W.StepAt = stepAt

-- TREADMILL: the console follows a program of speed / incline targets; SPEED + / - and INCLINE + / -
-- step the belt (seg.stepMph, one % of incline). A tick on both targets is full credit, on one half.
-- A button held repeats (after REPEAT_DELAY, every REPEAT_EVERY): no mashing for a big change of pace.
local REPEAT_DELAY, REPEAT_EVERY = 0.35, 0.2
J.treadmill = function(seg, M)
	local s = timed(seg, M)
	s.mph, s.incl, s.onBoth = seg.mph0, seg.incl0, 0
	s.rep = {}
	function s.target(t)
		return stepAt(seg.program, t - M)
	end
	local function press(id)
		if id == "spdUp" then
			s.mph = math.min(seg.mphMax, s.mph + seg.stepMph)
		elseif id == "spdDn" then
			s.mph = math.max(seg.mphMin, s.mph - seg.stepMph)
		elseif id == "incUp" then
			s.incl = math.min(seg.inclMax, s.incl + 1)
		elseif id == "incDn" then
			s.incl = math.max(0, s.incl - 1)
		end
	end
	stepper(s, M, function(T)
		for id, nextT in pairs(s.rep) do
			if T + 1e-9 >= nextT then
				press(id)
				s.rep[id] = nextT + REPEAT_EVERY
			end
		end
		local tg = stepAt(seg.program, T - M)
		-- on target is full credit; just off (inside 1.5x the tolerance) half; the incline counts half
		local dS, dI = math.abs(s.mph - tg.mph), math.abs(s.incl - tg.incl)
		local okS, okI = dS <= seg.tolMph + 1e-6, dI <= seg.tolIncl + 1e-6
		local cs = okS and 1 or (dS <= 1.5 * seg.tolMph + 1e-6 and 0.5 or 0)
		local ci = okI and 1 or (dI <= 1.5 * seg.tolIncl + 1e-6 and 0.5 or 0)
		s.acc += cs * (0.5 + 0.5 * ci)
		if okS and okI then
			s.onBoth += 1
		end
		if T - M >= seg.duration - 1e-6 then
			s.closed = true
		end
	end)
	function s.input(id, down, t)
		if s.closed or t < M or not (id == "spdUp" or id == "spdDn" or id == "incUp" or id == "incDn") then
			return nil
		end
		s.advance(t)
		if s.closed then
			return nil
		end
		if not down then
			s.rep[id] = nil
			return nil
		end
		press(id)
		s.rep[id] = t + REPEAT_DELAY
		return { mph = s.mph, incl = s.incl }
	end
	function s.result()
		return { acc = s.acc * TICK, onBoth = s.onBoth * TICK, duration = seg.duration }
	end
	return s
end

-- BIKE: pedal LEFT / RIGHT in turn (the cadence comes from the time between strokes) and shift GEAR up /
-- down for the hill profile. The gear the gradient wants turns your strokes into the cadence band; too
-- high a gear bogs the cadence down, too low spins it out.
function W.IdealGear(grade, gears)
	return clamp(math.floor(4.5 - 0.45 * grade + 0.5), 1, gears or 6)
end
J.bike = function(seg, M)
	local s = timed(seg, M)
	s.gear, s.strokes, s.inBand = seg.gear0, 0, 0
	function s.hill(t)
		return stepAt(seg.hill, t - M)
	end
	function s.rpm(t)
		if not s.lastTap then
			return 0
		end
		local iv = math.max(s.lastIv or 1, t - s.lastTap)
		local ideal = W.IdealGear(stepAt(seg.hill, t - M).grade, seg.gears)
		local k = clamp(1 + 0.13 * (ideal - s.gear), 0.45, 1.7)
		return 30 / iv * k
	end
	stepper(s, M, function(T)
		local rpm = s.rpm(T)
		local ideal = W.IdealGear(stepAt(seg.hill, T - M).grade, seg.gears)
		local band = rpm >= seg.lo and rpm <= seg.hi
		local gearOk = math.abs(s.gear - ideal) <= 1
		s.acc += (band and gearOk) and 1 or (band and 0.7 or 0)
		if band then
			s.inBand += 1
		end
		if T - M >= seg.duration - 1e-6 then
			s.closed = true
		end
	end)
	function s.input(id, down, t)
		if not down or s.closed or t < M then
			return nil
		end
		s.advance(t)
		if s.closed then
			return nil
		end
		if id == "gearUp" or id == "gearDn" then
			s.gear = clamp(s.gear + (id == "gearUp" and 1 or -1), 1, seg.gears)
			return { gear = s.gear }
		elseif id == "L" or id == "R" then
			if id == s.lastFoot then
				return { alt = false }
			end
			if s.lastTap then
				s.lastIv = clamp(t - s.lastTap, 0.12, 2)
			end
			s.lastTap, s.lastFoot = t, id
			s.strokes += 1
			return { alt = true }
		end
		return nil
	end
	function s.result()
		return { acc = s.acc * TICK, inBand = s.inBand * TICK, strokes = s.strokes, duration = seg.duration }
	end
	return s
end

-- ROWER: ROW (tap or hold) is the drive - the handle comes from the catch to the finish in seg.drive
-- seconds; let go at the finish (past finishLo), the handle runs back to the catch on its own at the
-- piece's stroke rate (the recovery), and ROW again as it reaches the catch. A catch taken early rushes
-- the slide, one left waiting is a pause; a drive let go short is a short stroke, one held at the body
-- is hanging at the finish. Every stroke is graded (catch half, finish half).
J.rower = function(seg, M, TapHold)
	local s = { closed = false, x = 0, phase = "catch", reachedAt = M, row = {}, strokes = {}, sum = 0, hang = 0 }
	function s.piece(t)
		return stepAt(seg.pieces, t - M)
	end
	local function recT(T)
		return math.max(0.55, 60 / stepAt(seg.pieces, T - M).spm - seg.drive)
	end
	local function stroke(t, x)
		local fq
		if x >= seg.finishLo then
			fq = 1 - math.min(0.4, math.max(0, s.hang - 0.45) * 1.0)
		else
			fq = 0.35 + 0.5 * x / seg.finishLo
		end
		local q = 0.5 * s.cq + 0.5 * fq
		s.sum += q
		local st = { t = t, q = q, cq = s.cq, fq = fq, catch = s.catchText, finish = x < seg.finishLo and "short" or (s.hang > 0.3 and "hang" or "clean") }
		table.insert(s.strokes, st)
		s.last = st
		s.phase = "recover"
		return st
	end
	stepper(s, M, function(T)
		if s.phase == "drive" then
			if s.x < 1 then
				s.x = math.min(1, s.x + TICK / seg.drive)
			else
				s.hang += TICK
				if s.hang >= 1.2 then
					stroke(T, 1)
				end
			end
		elseif s.phase == "recover" then
			s.x = math.max(0, s.x - TICK / recT(T))
			if s.x <= 0 then
				s.phase, s.reachedAt = "catch", T
			end
		end
		if T - M >= seg.duration - 1e-6 then
			s.closed = true
		end
	end)
	function s.input(id, down, t)
		if s.closed or t < M or id ~= "row" then
			return nil
		end
		s.advance(t)
		if s.closed then
			return nil
		end
		local flip = TapHold(s.row, down, t)
		if flip == "on" and (s.phase == "catch" or s.phase == "recover") then
			if s.phase == "catch" then
				local w = t - s.reachedAt
				s.cq = w <= 0.45 and 1 or math.max(0.4, 1 - (w - 0.45) * 0.9)
				s.catchText = w <= 0.45 and "clean" or "pause"
			elseif s.x <= seg.catchW then
				s.cq, s.catchText = 1, "clean"
			else
				s.cq, s.catchText = math.max(0.35, 1 - s.x * 2), "rushed"
			end
			s.phase, s.hang = "drive", 0
			return { catch = s.catchText }
		elseif flip == "off" and s.phase == "drive" then
			return { stroke = stroke(t, s.x) }
		end
		return nil
	end
	s.finish = finishOf(s)
	-- the strokes a clean crew rows in the session (the catch taken at once)
	function s.expected()
		local n = 0
		for i, p in ipairs(seg.pieces) do
			local nextT = seg.pieces[i + 1] and seg.pieces[i + 1].t or seg.duration
			n += (nextT - p.t) / (seg.drive + math.max(0.55, 60 / p.spm - seg.drive))
		end
		return n
	end
	function s.result()
		return { sum = s.sum, strokes = #s.strokes, expected = s.expected(), duration = seg.duration }
	end
	function s.endsAt()
		return M + seg.duration
	end
	s.minTime = seg.duration
	return s
end

-- ICE BATH: BREATHE in (tap or hold) fills the lungs over seg.inhale seconds, letting go empties them over
-- seg.exhale. The cold meter climbs all the time (faster in the cold waves); a long, full exhale after a
-- full breath taken from empty brings it down; empty lungs left waiting (air hunger) push it up. Under
-- 0.5 is calm, past 0.8 you shiver.
J.icebath = function(seg, M, TapHold)
	local s = { closed = false, l = 0, S = seg.s0, br = {}, calmT = 0, breaths = 0, good = 0, emptyAt = M, duration = seg.duration }
	function s.wave(t)
		local el = t - M
		for _, w in ipairs(seg.waves) do
			if el >= w[1] and el < w[1] + w[2] then
				return true
			end
		end
		return false
	end
	stepper(s, M, function(T)
		local on = s.br.on
		if on then
			s.l = math.min(1, s.l + TICK / seg.inhale)
		else
			local was = s.l
			s.l = math.max(0, s.l - TICK / seg.exhale)
			if was > 0 and s.l <= 0 then
				s.emptyAt = T
			end
		end
		local dS = seg.cold * (s.wave(T) and seg.waveMult or 1)
		if not on and s.calm and s.l > 0.05 then
			dS -= seg.calmRate * s.calm
		end
		if not on and s.l <= 0 and T - s.emptyAt > 2.5 then
			dS += 0.03
		end
		if on and s.l >= 1 and T - (s.fullAt or T) > 1.5 then
			dS += 0.02
		end
		if on and s.l >= 1 and not s.fullAt then
			s.fullAt = T
		end
		s.S = clamp(s.S + dS * TICK, 0, 1)
		s.calmT += s.S < 0.5 and 1 or (s.S < 0.8 and 0.5 or 0)
		if T - M >= seg.duration - 1e-6 then
			s.closed = true
		end
	end)
	function s.input(id, down, t)
		if s.closed or t < M or id ~= "breathe" then
			return nil
		end
		s.advance(t)
		if s.closed then
			return nil
		end
		local flip = TapHold(s.br, down, t)
		if flip == "on" then
			s.startL, s.fullAt = s.l, nil
			return { inhale = true, from = s.l }
		elseif flip == "off" then
			-- how calming the breath was: how full (0.38 .. 0.88) times how empty it started (0.68 .. 0.18):
			-- a breath begun with a little air left is still a fair one
			local full, fromEmpty = s.l >= 0.8, (s.startL or 1) <= 0.3
			local q = clamp((s.l - 0.38) / 0.5, 0, 1) * clamp((0.68 - (s.startL or 1)) / 0.5, 0, 1)
			local good = q >= 0.75
			s.breaths += 1
			s.calm = q > 0 and q or nil
			s.good += q
			return { exhale = true, good = good, full = full, fromEmpty = fromEmpty }
		end
		return nil
	end
	s.finish = finishOf(s)
	function s.result()
		return { calm = s.calmT * TICK, duration = seg.duration, breaths = s.breaths, good = s.good, expected = seg.duration / (seg.inhale + seg.exhale) }
	end
	function s.endsAt()
		return M + seg.duration
	end
	s.minTime = seg.duration
	return s
end

-- STRETCH: one pose. SINK (tap or hold) eases deeper, letting go backs off; the target range creeps
-- deeper through the hold as the muscle lets go. In range is the score; past the top of it is an
-- overstretch (each one costs), and too long over it tweaks the muscle.
J.stretch = function(seg, M, TapHold)
	local s = { closed = false, z = 0, sink = {}, inT = 0, overs = 0, overT = 0, duration = seg.dur }
	function s.band(t)
		local k = clamp((t - M) / seg.dur, 0, 1)
		return seg.lo + seg.slide * k, seg.hi + seg.slide * k
	end
	stepper(s, M, function(T)
		if s.sink.on then
			s.z = math.min(1, s.z + seg.sinkRate * TICK)
		else
			s.z = math.max(0, s.z - seg.ease * TICK)
		end
		local lo, hi = s.band(T)
		local over = s.z > hi + seg.overMargin
		if over then
			s.overT += TICK
			if not s.wasOver then
				s.overs += 1
			end
		elseif s.z >= lo and s.z <= hi then
			s.inT += 1
		end
		s.wasOver = over
		if T - M >= seg.dur - 1e-6 then
			s.closed = true
		end
	end)
	function s.input(id, down, t)
		if s.closed or t < M or id ~= "sink" then
			return nil
		end
		s.advance(t)
		if s.closed then
			return nil
		end
		local flip = TapHold(s.sink, down, t)
		return flip and { sink = flip == "on" } or nil
	end
	s.finish = finishOf(s)
	function s.result()
		local reach = seg.lo / seg.sinkRate
		local share = s.inT * TICK / math.max(0.5, (seg.dur - reach - 0.3) * 0.9)
		local q = clamp(share, 0, 1) - 0.12 * s.overs
		local tweaked = s.overT > 1.0
		if tweaked then
			q *= 0.6
		end
		return { q = clamp(q, 0, 1), inRange = s.inT * TICK, overs = s.overs, tweaked = tweaked, duration = seg.dur }
	end
	function s.endsAt()
		return M + seg.dur
	end
	s.minTime = seg.dur
	return s
end

-- MASSAGE: rounds of CHOOSE (move the cursor over the muscle groups - their soreness is on the body map
-- - and pick one; picking the sorest group left is full marks) then WORK (the therapist's strokes come
-- on a slow beat: RELAX (the same button) on each stroke). seg.groups / seg.sore: the groups in order
-- and how sore each is (the player's own soreness, Training.MinigameParams).
J.massage = function(seg, M)
	local G = seg.groups
	local sore = {}
	for i, g in ipairs(G) do
		sore[g] = seg.sore[i] or 0
	end
	local s = { closed = false, phase = "choose", round = 1, cursor = 1, chooseAt = M, worked = {}, picks = {}, pickSum = 0, relax = 0, strokesTotal = 0, stray = 0, sore = sore }
	local function remainingMax()
		local m = 0
		for _, g in ipairs(G) do
			if not s.worked[g] then
				m = math.max(m, sore[g])
			end
		end
		return m
	end
	local function pick(g, t, timedOut)
		local m = remainingMax()
		-- (a spot nearly as sore as the worst one - 80% of it - is a full pick)
		local q = timedOut and 0 or (m > 0 and clamp(sore[g] / m / 0.8, 0, 1) or 1)
		s.pickSum += q
		s.worked[g] = true
		local p = { group = g, q = q, timedOut = timedOut == true, sore = sore[g] }
		table.insert(s.picks, p)
		s.phase, s.strokes = "work", {}
		for k = 1, seg.strokes do
			s.strokes[k] = { t = t + seg.firstStroke + (k - 1) * seg.beat }
		end
		s.strokesTotal += seg.strokes
		s.workEnd = s.strokes[#s.strokes].t + seg.hitW
		return p
	end
	function s.advance(t)
		local out
		if s.phase == "choose" and t - s.chooseAt >= seg.chooseT then
			local g = G[s.cursor]
			if s.worked[g] then
				for _, gg in ipairs(G) do
					if not s.worked[gg] then
						g = gg
						break
					end
				end
			end
			out = { picked = pick(g, s.chooseAt + seg.chooseT, true) }
		end
		if s.phase == "work" then
			for _, st in ipairs(s.strokes) do
				if not st.judged and t - st.t > seg.hitW then
					st.judged, st.grade = true, "miss"
					out = out or {}
					out.missed = (out.missed or 0) + 1
				end
			end
			if t >= s.workEnd then
				if s.round >= seg.rounds then
					s.closed, s.endT = true, s.workEnd
				else
					s.round += 1
					s.phase, s.chooseAt = "choose", s.workEnd
				end
			end
		end
		return out
	end
	function s.input(id, down, t)
		if not down or s.closed or t < M then
			return nil
		end
		s.advance(t)
		if s.closed then
			return nil
		end
		if s.phase == "choose" then
			if id == "prev" or id == "next" then
				s.cursor = (s.cursor - 1 + (id == "next" and 1 or -1)) % #G + 1
				return { cursor = s.cursor }
			elseif id == "ok" then
				local g = G[s.cursor]
				if s.worked[g] then
					return { already = true }
				end
				return { picked = pick(g, t, false) }
			end
			return nil
		end
		if id ~= "ok" then
			return nil
		end
		local best, bestDt
		for _, st in ipairs(s.strokes) do
			if not st.judged and math.abs(t - st.t) < seg.hitW and (not best or math.abs(t - st.t) < math.abs(bestDt)) then
				best, bestDt = st, t - st.t
			end
		end
		if not best then
			s.stray += 1
			return { stray = true }
		end
		best.judged = true
		best.grade = math.abs(bestDt) < seg.perfW and "perfect" or "good"
		s.relax += best.grade == "perfect" and 1 or 0.6
		return { stroke = best }
	end
	s.finish = finishOf(s)
	function s.result()
		return { pickSum = s.pickSum, picks = #s.picks, rounds = seg.rounds, relax = s.relax, strokes = seg.rounds * seg.strokes, stray = s.stray }
	end
	function s.endsAt()
		return s.endT
	end
	s.minTime = seg.rounds * (RT_FLOOR + seg.firstStroke + (seg.strokes - 1) * seg.beat)
	return s
end

-- RECOVERY CHAMBER: follow the pressure profile (up to depth, hold, back up to the surface): PRESSURISE
-- and VENT are held; the chamber leaks a little on its own. Every change of pressure loads the ears;
-- EQUALIZE clears them. Ears full: pain - you can't pressurise and nothing counts for two seconds.
J.chamber = function(seg, M)
	local s = timed(seg, M)
	s.P, s.ear, s.eqs, s.pains, s.painUntil = 1, 0, 0, 0, -math.huge
	holds(s)
	function s.target(t)
		local el, pts = t - M, seg.profile
		for i = 2, #pts do
			if el <= pts[i][1] then
				local a, b = pts[i - 1], pts[i]
				return a[2] + (b[2] - a[2]) * clamp((el - a[1]) / math.max(1e-6, b[1] - a[1]), 0, 1)
			end
		end
		return pts[#pts][2]
	end
	stepper(s, M, function(T)
		local pain = T < s.painUntil
		local dp = 0
		if s.held("up", T) and not pain then
			dp += seg.rise * TICK
		end
		if s.held("down", T) then
			dp -= seg.vent * TICK
		end
		if s.P > 1 then
			-- (the seal breathes: the leak comes and goes - top the pressure up as it sags)
			dp -= seg.leak * (1 + (seg.leakWave or 0) * math.sin(1.3 * (T - M))) * TICK
		end
		local P0 = s.P
		s.P = clamp(s.P + dp, 1, seg.maxP)
		s.ear = math.max(0, s.ear + seg.earRate * math.abs(s.P - P0) - 0.02 * TICK)
		if s.ear >= 1 and not pain then
			s.ear = 1
			s.pains += 1
			s.painUntil = T + 1.2
			pain = true
		end
		if not pain then
			local d = math.abs(s.P - s.target(T))
			s.acc += d <= seg.tol and 1 or (d <= 1.5 * seg.tol and 0.5 or 0)
		end
		if T - M >= seg.duration - 1e-6 then
			s.closed = true
		end
	end)
	function s.input(id, down, t)
		if s.closed or t < M then
			return nil
		end
		s.advance(t)
		if s.closed then
			return nil
		end
		if id == "up" or id == "down" then
			s.setHold(id, down, t)
		elseif id == "eq" and down then
			local before = s.ear
			s.ear = math.max(0, s.ear - 0.6)
			s.eqs += 1
			return { eq = true, cleared = before - s.ear }
		end
		return nil
	end
	function s.result()
		return { acc = s.acc * TICK, pains = s.pains, eqs = s.eqs, duration = seg.duration }
	end
	return s
end

-- SAUNA (weight cut): inside, the core temperature climbs and the water comes off faster the hotter you
-- run; STEP OUT cools you down (and the cut all but stops), STEP IN goes back. SIP (every 2 s at most)
-- takes the edge off the heat and puts a little water back. Past 0.85 is the danger zone; at 1 you go
-- light-headed and the coach pulls you out for 4 s. The score: the water cut against the goal, safely.
J.sauna = function(seg, M)
	local s = { closed = false, T = seg.t0, w = 0, inside = true, forcedUntil = -math.huge, lastSip = -math.huge, sips = 0, faints = 0, danger = 0, duration = seg.duration }
	stepper(s, M, function(T)
		if s.inside then
			s.T += seg.heat * TICK
			s.w += (seg.lossBase + seg.lossT * s.T) * TICK
		else
			s.T = math.max(seg.t0 * 0.8, s.T - seg.cool * TICK)
			s.w += 0.01 * TICK
		end
		if s.T > 0.85 then
			s.danger += TICK
		end
		if s.T >= 1 then
			s.faints += 1
			s.inside = false
			s.forcedUntil = T + 4
			s.T = 0.9
		end
		if T - M >= seg.duration - 1e-6 then
			s.closed = true
		end
	end)
	function s.input(id, down, t)
		if not down or s.closed or t < M then
			return nil
		end
		s.advance(t)
		if s.closed then
			return nil
		end
		if id == "door" then
			if t < s.forcedUntil then
				return { forced = true }
			end
			s.inside = not s.inside
			return { inside = s.inside }
		elseif id == "sip" then
			if t - s.lastSip < 2 then
				return { wait = true }
			end
			s.lastSip = t
			s.sips += 1
			s.w = math.max(0, s.w - 0.12)
			s.T = math.max(seg.t0 * 0.8, s.T - 0.08)
			return { sip = true }
		end
		return nil
	end
	s.finish = finishOf(s)
	function s.result()
		return { w = s.w, goal = seg.goal, danger = s.danger, faints = s.faints, sips = s.sips, duration = seg.duration }
	end
	function s.endsAt()
		return M + seg.duration
	end
	s.minTime = seg.duration
	return s
end

-- DOUBLE-END REBOUND: PUNCH the bag, then slip its return: it comes back seg.ret seconds after the punch
-- and the slip (seg.want) must land inside +-seg.w of that moment. Too soon and you are back in its path.
J.rebound = function(seg, M)
	local s = { closed = false, step = 1 }
	local function close(t)
		s.closed, s.endT = true, t
	end
	function s.returnAt()
		return s.punchT and (s.punchT + seg.ret) or nil
	end
	function s.advance(t)
		if s.closed then
			return
		end
		if s.step == 1 and t - M >= seg.window then
			close(M + seg.window)
		elseif s.step == 2 and t > s.punchT + seg.ret + seg.w then
			s.hit = true
			close(s.punchT + seg.ret + seg.w)
		end
	end
	function s.input(id, down, t)
		if not down or s.closed or t < M then
			return nil
		end
		s.advance(t)
		if s.closed then
			return nil
		end
		if s.step == 1 then
			if id == "punch" and t - M >= RT_FLOOR then
				s.step, s.punchT = 2, t
				return { step = 2, punch = true }
			end
			s.failed = true
			close(t)
			return { step = 1, ok = false }
		end
		local dt = t - (s.punchT + seg.ret)
		close(t)
		if id == seg.want and math.abs(dt) <= seg.w then
			s.ok, s.dt = true, dt
			return { step = 3, ok = true, dt = dt }
		end
		s.failed, s.early, s.dt = true, id == seg.want and dt < 0, dt
		return { step = 2, ok = false, early = s.early }
	end
	s.finish = finishOf(s)
	function s.result()
		return { step = s.ok and 3 or s.step, ok = s.ok == true, dt = s.dt, early = s.early == true, hit = s.hit == true, punched = s.punchT ~= nil }
	end
	function s.endsAt()
		return s.endT or (s.step == 2 and (s.punchT + seg.ret + seg.w)) or (M + seg.window)
	end
	s.minTime = RT_FLOOR + seg.ret - seg.w
	return s
end

-- PLANK (the medicine ball's core set): the ball is under your hands and it wants to roll - the balance
-- drifts (seg.drift: two sine waves and a lean) and LEFT / RIGHT taps shove it back by seg.kick. In the
-- green (|x| <= band) is full credit, inside twice the band half; rolled to the edge (|x| = 1) is a slip
-- (counted, the ball is caught there: nothing resets). The time in the green is the score.
J.wobble = function(seg, M)
	local s = timed(seg, M)
	s.x, s.inBand, s.lost, s.taps = 0, 0, 0, 0
	local d = seg.drift
	function s.driftAt(el)
		return d[1] * math.sin(d[2] * el + d[3]) + d[4] * math.sin(d[5] * el + d[6]) + (seg.bias or 0)
	end
	stepper(s, M, function(T)
		local x = s.x + s.driftAt(T - M) * TICK
		if math.abs(x) >= 1 then
			x = x > 0 and 1 or -1
			if not s.atEdge then
				s.lost += 1
			end
			s.atEdge = true
		else
			s.atEdge = false
		end
		s.x = x
		local ax = math.abs(x)
		s.acc += ax <= seg.band and 1 or (ax <= 2 * seg.band and 0.5 or 0)
		if ax <= seg.band then
			s.inBand += 1
		end
		if T - M >= seg.duration - 1e-6 then
			s.closed = true
		end
	end)
	function s.input(id, down, t)
		if not down or s.closed or t < M or (id ~= "L" and id ~= "R") then
			return nil
		end
		s.advance(t)
		if s.closed then
			return nil
		end
		s.taps += 1
		s.x = clamp(s.x + (id == "L" and -seg.kick or seg.kick), -1, 1)
		return { x = s.x, id = id }
	end
	function s.result()
		return { acc = s.acc * TICK, inBand = s.inBand * TICK, lost = s.lost, taps = s.taps, duration = seg.duration }
	end
	return s
end

-- SLED PUSH (mash bursts): seg.bursts drives of seg.push seconds, each followed by a seg.reset breather
-- (the sled settles; presses then do nothing). In a drive LEFT / RIGHT in turn are the steps - the same
-- leg twice is no step - and seg.target steps make a full drive (the sled's metres). Every drive is its own
-- grade: a slow one costs that drive, nothing carries over.
J.mash = function(seg, M)
	local period = seg.push + seg.reset
	local dur = seg.bursts * period - seg.reset
	local s = { closed = false, steps = {}, wrong = 0, early = 0, duration = dur }
	for k = 1, seg.bursts do
		s.steps[k] = 0
	end
	-- the drive at t (1..bursts) and whether it is pushing (false: the reset after it)
	function s.burstAt(t)
		local el = t - M
		local k = math.floor(el / period) + 1
		return math.clamp(k, 1, seg.bursts), (el - (k - 1) * period) < seg.push and el >= 0
	end
	function s.advance(t)
		if t >= M + dur then
			s.closed = true
		end
		return s
	end
	function s.input(id, down, t)
		if not down or s.closed or t < M or (id ~= "L" and id ~= "R") then
			return nil
		end
		s.advance(t)
		if s.closed then
			return nil
		end
		local k, pushing = s.burstAt(t)
		if not pushing then
			s.early += 1
			return { reset = true }
		end
		if id == s.last then
			s.wrong += 1
			return { same = true, k = k }
		end
		s.last = id
		s.steps[k] += 1
		return { step = true, k = k, n = s.steps[k] }
	end
	function s.finish(t)
		s.closed = true
	end
	function s.result()
		local sum, grades = 0, {}
		for k = 1, seg.bursts do
			local g = math.min(1, s.steps[k] / math.max(1, seg.target))
			grades[k] = g
			sum += g
		end
		return { q = sum / seg.bursts, grades = grades, steps = table.clone(s.steps), wrong = s.wrong, bursts = seg.bursts, target = seg.target, duration = dur }
	end
	function s.endsAt()
		return M + dur
	end
	s.minTime = dur
	return s
end

-- HOLD GAUGE (the neck harness, the forearm squeeze): SQUEEZE held raises the force (seg.rise a second),
-- let go and it falls (seg.fall); the force wavers on its own (two sines, seg.amp growing with the
-- seconds held: seg.grow - the tremor of a tiring muscle) and only the steady band [seg.lo, seg.hi]
-- counts. seg.need seconds in the band inside seg.dur is a full hold. A tap still nudges (W.NUDGE).
J.gauge = function(seg, M)
	local s = { closed = false, f = 0, acc = 0, heldT = 0, duration = seg.dur }
	holds(s)
	local w = seg.wave
	function s.tremor(T)
		local el = T - M
		return (seg.amp + seg.grow * s.heldT) * (math.sin(w[1] * el + w[2]) + 0.6 * math.sin(w[3] * el + w[4]))
	end
	function s.shown(T)
		return clamp(s.f + s.tremor(T), 0, 1.2)
	end
	stepper(s, M, function(T)
		if T - M > seg.dur then
			s.closed = true
			return
		end
		if s.held("sq", T) then
			s.f = math.min(1.1, s.f + seg.rise * TICK)
			s.heldT += TICK
		else
			s.f = math.max(0, s.f - seg.fall * TICK)
		end
		local v = s.shown(T)
		if v >= seg.lo and v <= seg.hi then
			s.acc += TICK
		end
	end)
	function s.input(id, down, t)
		if s.closed or t < M or id ~= "sq" then
			return nil
		end
		s.advance(t)
		if s.closed then
			return nil
		end
		s.setHold("sq", down, t)
		return { sq = down }
	end
	s.finish = finishOf(s)
	function s.result()
		return { q = clamp(s.acc / seg.need, 0, 1), acc = s.acc, need = seg.need, duration = seg.dur }
	end
	function s.endsAt()
		return M + seg.dur
	end
	s.minTime = seg.dur
	return s
end

-- ROADWORK PACE (the treadmill's road lane): STRIDE taps push the runner's pace up (seg.kick), it eases
-- off on its own (seg.decay a second); the pacer's band moves through seg.legs ({ t, lo, hi, name }) and
-- the time inside it counts. BREATHE taps on the breathing cues (seg.breaths, seconds in) from seg.breathW
-- before to 1.4 x seg.breathW after (a reaction to a cue is late more often than early) are breaths in
-- rhythm; a breath tap with no cue near is just a breath (nothing lost).
J.road = function(seg, M)
	local s = { closed = false, v = seg.v0, acc = 0, duration = seg.duration, breathHit = {}, hits = 0, sweet = 0 }
	function s.legAt(T)
		return stepAt(seg.legs, T - M)
	end
	stepper(s, M, function(T)
		if T - M > seg.duration then
			s.closed = true
			return
		end
		s.v = math.max(0, s.v - seg.decay * TICK)
		local leg = s.legAt(T)
		if leg and s.v >= leg.lo and s.v <= leg.hi then
			s.acc += TICK
		end
	end)
	-- the next breathing cue not yet taken (index, seconds to it; negative: just passed)
	function s.nextBreath(t)
		for i, b in ipairs(seg.breaths) do
			if not s.breathHit[i] and (t - M) <= b + 1.4 * seg.breathW then
				return i, b - (t - M)
			end
		end
		return nil
	end
	function s.input(id, down, t)
		if not down or s.closed or t < M then
			return nil
		end
		s.advance(t)
		if s.closed then
			return nil
		end
		if id == "stride" then
			s.v = math.min(1, s.v + seg.kick)
			return { v = s.v }
		elseif id == "breathe" then
			local i, dt = s.nextBreath(t)
			if i and dt <= seg.breathW and dt >= -1.4 * seg.breathW then
				s.breathHit[i] = true
				s.hits += 1
				local sweet = math.abs(dt) <= seg.breathW * 0.4
				if sweet then
					s.sweet += 1
				end
				return { breath = true, sweet = sweet }
			end
			return { breath = false }
		end
		return nil
	end
	s.finish = finishOf(s)
	function s.result()
		local n = #seg.breaths
		local q = 0.7 * clamp(s.acc / seg.duration / W.TIMED_FULL, 0, 1) + 0.3 * s.hits / math.max(1, n)
		return { q = q, acc = s.acc, duration = seg.duration, hits = s.hits, sweet = s.sweet, breaths = n }
	end
	function s.endsAt()
		return M + seg.duration
	end
	s.minTime = seg.duration
	return s
end

W.Judges = J

------------------------------------------------------------------------
-- Session scores (plan.kind -> 0..1)
------------------------------------------------------------------------
local AGG = {}
local function avgQ(plan, res)
	local sum = 0
	for i in ipairs(plan.segs) do
		sum += res[i] and res[i].q or 0
	end
	return sum / math.max(1, #plan.segs)
end
AGG.bench, AGG.pullup, AGG.stretch = avgQ, avgQ, avgQ
-- a lift's reps with a finisher of another kind (the squat's sled push, the deadlift's neck harness):
-- the reps' mean and the finisher's grade, weighted (the finisher: share of the session score)
local function withFinisher(main, share)
	return function(plan, res)
		local sum, n, fin, has = 0, 0, 0, false
		for i, seg in ipairs(plan.segs) do
			if seg.j == main then
				n += 1
				sum += res[i] and res[i].q or 0
			else
				has = true
				fin += res[i] and res[i].q or 0
			end
		end
		local reps = sum / math.max(1, n)
		return has and ((1 - share) * reps + share * fin) or reps
	end
end
AGG.squat = withFinisher("squat", 0.4)
AGG.deadlift = withFinisher("deadlift", 0.25)
AGG.curls = function(plan, res)
	local sum, n, grip, has = 0, 0, 0, false
	for i, seg in ipairs(plan.segs) do
		local r = res[i]
		if seg.j == "gauge" then
			has = true
			grip = r and r.q or 0
		else
			n += #seg.notes
			if r then
				sum += r.sum - 0.1 * (r.swings or 0) - 0.15 * (r.stray or 0)
			end
		end
	end
	local curls = clamp(sum / math.max(1, n), 0, 1)
	return has and (0.75 * curls + 0.25 * grip) or curls
end
-- this share of a time-on-target drill is full marks (nobody is on target the moment a step changes)
W.TIMED_FULL = 0.8
local function accShare(plan, res)
	local r, seg = res[1], plan.segs[1]
	return r and clamp(r.acc / seg.duration / W.TIMED_FULL, 0, 1) or 0
end
AGG.bike = accShare
-- the chamber's profile is slow and always in view: full marks want nearly all of it on target
W.CHAMBER_FULL = 0.92
AGG.chamber = function(plan, res)
	local r, seg = res[1], plan.segs[1]
	return r and clamp(r.acc / seg.duration / W.CHAMBER_FULL, 0, 1) or 0
end
-- the console's program, then the road lane (J.road) when the plan has one
AGG.treadmill = function(plan, res)
	local console = accShare(plan, res)
	local i = #plan.segs
	if i >= 2 and plan.segs[i].j == "road" then
		return 0.6 * console + 0.4 * (res[i] and res[i].q or 0)
	end
	return console
end
-- the strokes' mean grade, times the share of the pieces' strokes rowed (rushing the slide for extra
-- strokes earns nothing: their grade drops)
AGG.rower = function(plan, res)
	local r = res[1]
	if not r or r.strokes == 0 then
		return 0
	end
	return clamp(r.sum / r.strokes, 0, 1) * clamp(r.strokes / math.max(1, 0.8 * r.expected), 0, 1)
end
AGG.icebath = function(plan, res)
	local r = res[1]
	if not r then
		return 0
	end
	return 0.6 * clamp(r.calm / r.duration / W.TIMED_FULL, 0, 1) + 0.4 * clamp(r.good / math.max(1, 0.85 * r.expected), 0, 1)
end
AGG.massage = function(plan, res)
	local r = res[1]
	if not r then
		return 0
	end
	return 0.6 * r.pickSum / math.max(1, r.rounds) + 0.4 * clamp((r.relax - 0.5 * r.stray) / math.max(1, r.strokes), 0, 1)
end
function W.SaunaScore(r)
	local cut = clamp(r.w / math.max(0.1, r.goal), 0, 1)
	local safe = 1 - clamp(r.danger / 5, 0, 1)
	return (0.7 * cut + 0.3 * safe) * (0.5 ^ r.faints)
end
AGG.sauna = function(plan, res)
	return res[1] and W.SaunaScore(res[1]) or 0
end
W.Agg = AGG

-- the extra boxing rounds' share of their drills (DrillScore's own AGG.reaction / AGG.shadow call these)
function W.ReboundScore(seg, r)
	if not r then
		return 0
	end
	if r.ok then
		return 1 - 0.4 * math.abs(r.dt or 0) / seg.w
	end
	return r.punched and 0.25 or 0
end

------------------------------------------------------------------------
-- Plans (Training.DrillPlan draws these; r = a Random)
------------------------------------------------------------------------
local FOOTWORK = {
	{ name = "BOX STEP", steps = { "F", "R", "B", "L" } },
	{ name = "IN & OUT", steps = { "F", "B", "F", "B" } },
	{ name = "CIRCLE LEFT", steps = { "L", "L", "F", "L" } },
	{ name = "CIRCLE RIGHT", steps = { "R", "R", "F", "R" } },
	{ name = "L-STEP", steps = { "F", "L", "F", "L" } },
	{ name = "ANGLE OUT", steps = { "F", "R", "R", "B" } },
}
W.Footwork = FOOTWORK
W.MassageGroups = { "back", "shoulders", "legs", "arms", "chest", "core", "neck" }

-- 0 at station level 1 .. 1 at level 5
local function lvf(lv)
	return clamp((lv - 1) / 4, 0, 1)
end
W.LevelFrac = lvf

local function repGap(Wt, set, rep)
	if rep > 1 then
		return Wt.lower + Wt.rerack
	end
	return set == 1 and Wt.intro or (Wt.lower + Wt.rerack + Wt.rest + Wt.round)
end
W.RepGap = repGap

local PLAN = {}
-- (every workout: 20-35 s of work, two short sets where there are sets; the zones and tolerances are
-- generous at level 1 and tighten with the level, never past a comfortable floor)
PLAN.bench = function(segs, lv, r, Wt)
	local f = lvf(lv)
	for set = 1, 2 do
		local weak = r:NextNumber() < 0.5 and -1 or 1
		for rep = 1, 3 do
			-- (the drift: gentle on the first bench, a real fight up top; the correction always outpaces it)
			local amp = 0.18 + 0.1 * f + rep * 0.015 + (set - 1) * 0.03
			table.insert(segs, { j = "bench", set = set, rep = rep, speed = 0.5 - 0.06 * f, sink = 0.15,
				drift = { amp, 1.6 + r:NextNumber() * 1.2, r:NextNumber() * 6.28, amp * 0.6, 3.1 + r:NextNumber() * 1.5, r:NextNumber() * 6.28 },
				bias = weak * (0.05 + 0.03 * rep + 0.05 * (set - 1)), corr = 1.0, tiltMax = 1.2,
				stickLo = 0.42, stickHi = 0.6, stickMult = 0.65 - 0.05 * rep - 0.05 * (set - 1), wait = 4, limit = 6, gap = repGap(Wt, set, rep) })
		end
	end
end
PLAN.deadlift = function(segs, lv, r, Wt)
	local f = lvf(lv)
	for set = 1, 2 do
		for rep = 1, 3 do
			table.insert(segs, { j = "deadlift", set = set, rep = rep, sweep = 0.5 + 0.25 * f + 0.03 * rep, c = 0.5, w = 0.13 - 0.04 * f,
				speed = 0.5, stickLo = 0.32, stickHi = 0.58, stickMult = 0.5 - 0.04 * (set - 1), drop = 0.5,
				drain = 0.22 + 0.08 * f + 0.015 * rep + 0.03 * (set - 1), gripTap = 0.35, wait = 4, limit = 6, gap = repGap(Wt, set, rep) })
		end
	end
	-- the finisher: the NECK HARNESS - a short steady hold (the traps and the neck the deadlift loads)
	table.insert(segs, W.GaugeSeg("NECK HARNESS", f, r, Wt.lower + Wt.rerack + Wt.rest + Wt.round))
end
-- a short hold gauge (the neck harness, the forearm squeeze): the band is wide on the first station and
-- narrows with the level; the tremor grows the longer you hold (a full hold is 60% of the time in it)
function W.GaugeSeg(name, f, r, gap)
	local mid = 0.55 + r:NextNumber() * 0.15
	local half = 0.16 - 0.04 * f
	return { j = "gauge", name = name, dur = 6, need = 3.6, lo = mid - half, hi = mid + half, rise = 0.9, fall = 0.7, amp = 0.03 + 0.02 * f, grow = 0.012 + 0.008 * f,
		wave = { 2.2 + r:NextNumber() * 0.8, r:NextNumber() * 6.28, 5.1 + r:NextNumber() * 1.2, r:NextNumber() * 6.28 }, gap = gap }
end
PLAN.squat = function(segs, lv, r, Wt)
	local f = lvf(lv)
	-- set 1: back squats; set 2: the SLED PUSH (four drives, the legs alternating as fast as they go)
	for set = 1, 1 do
		for rep = 1, 3 do
			local width = math.max(0.1, 0.22 - 0.08 * f - 0.006 * rep)
			local lo = 0.6 + r:NextNumber() * 0.14
			table.insert(segs, { j = "squat", set = set, rep = rep, v0 = 0.28, acc = 0.45 + 0.1 * f, lo = lo, hi = lo + width,
				bounce = 0.12, pause = 0.75 - 0.2 * f, lost = 2.5, rise = 0.7 - 0.03 * rep, wait = 4, limit = 5, gap = repGap(Wt, set, rep) })
		end
	end
	-- (a full drive: 4.5 steps a second on the first station, 5.5 on the top one; the reset is part of the
	-- rhythm: drive, settle, drive)
	table.insert(segs, { j = "mash", name = "SLED PUSH", bursts = 4, push = 2.0, reset = 0.8, target = math.floor(9 + 2 * f + 0.5), gap = repGap(Wt, 2, 1) })
end
PLAN.pullup = function(segs, lv, r, Wt)
	local f = lvf(lv)
	-- two sets of three: overhand pull-ups, then close-grip chin-ups (a little quicker to the bar, the
	-- grip drains faster); the chin zone and the sweet band narrow with the level, never past a comfortable
	-- floor (the zone stays ~0.4 s of climb wide, the sweet band ~0.2 s)
	for set = 1, 2 do
		table.insert(segs, { j = "pullup", set = set, rep = 1, reps = 3, name = set == 1 and "PULL-UPS" or "CHIN-UPS",
			speed = 0.6 - 0.05 * f + 0.04 * (set - 1), lo = 0.74 + 0.04 * f, perfLo = 0.87, perfHi = 0.97 - 0.015 * f, ready = 0.12, sink = 1.1,
			drain = 0.2 + 0.06 * f + 0.03 * (set - 1), topDrain = 0.5, regen = 0.35, slipGrip = 0.35, wait = 4, limit = 11 - f,
			gap = set == 1 and Wt.intro or (Wt.lower + Wt.rest + Wt.round) })
	end
end
PLAN.curls = function(segs, lv, r, Wt)
	local f = lvf(lv)
	-- set 1: alternating curls, up one beat (hold) and a beat to lower; set 2: tempo curls (two-beat squeeze)
	-- (six and four curls: with the grip finisher the session stays near half a minute)
	local bpm1 = math.floor(72 + 12 * f)
	local notes1, lane = {}, r:NextNumber() < 0.5 and "L" or "R"
	for k = 0, 5 do
		table.insert(notes1, { lane, k * 2, k * 2 + 1 })
		lane = lane == "L" and "R" or "L"
	end
	table.insert(segs, { j = "tempo", name = "ALTERNATING CURLS", bpm = bpm1, beat = 60 / bpm1, lead = 1.2, notes = notes1, hitW = 0.32, perfW = 0.13 - 0.04 * f, relW = 0.32 - 0.07 * f, gap = Wt.intro })
	local bpm2 = math.floor(78 + 14 * f)
	local notes2 = {}
	local at = 0
	for k = 1, 4 do
		local hold = (k == 3 and lv >= 3) and 3 or 2
		table.insert(notes2, { lane, at, at + hold })
		lane = lane == "L" and "R" or "L"
		at += hold + 1
	end
	table.insert(segs, { j = "tempo", name = "TEMPO CURLS", bpm = bpm2, beat = 60 / bpm2, lead = 1.2, notes = notes2, hitW = 0.3, perfW = 0.12 - 0.04 * f, relW = 0.3 - 0.07 * f, gap = Wt.rest + Wt.round })
	-- the finisher: a FOREARM GRIP squeeze (the grip the curls tired) held steady
	table.insert(segs, W.GaugeSeg("FOREARM GRIP", f, r, Wt.rest + Wt.round))
end
PLAN.treadmill = function(segs, lv, r, Wt)
	local f = lvf(lv)
	local program = {}
	local t, mph, incl = 0, 4, 0
	-- (whole-mph steps: a change of pace is a few presses, not a dozen)
	local names = { "WARM-UP", "TEMPO", "HILL", "SPRINT" }
	for k = 1, 4 do
		local name = names[k]
		if name == "WARM-UP" then
			mph, incl = 5, 1
		elseif name == "TEMPO" then
			mph, incl = 7 + math.floor(r:NextNumber() * 2), 1
		elseif name == "HILL" then
			mph, incl = 6, 4 + math.floor(r:NextNumber() * 2 + 2 * f)
		elseif name == "SPRINT" then
			mph, incl = 9 + math.floor(r:NextNumber() * 2 + 2 * f), 0
		elseif name == "RECOVER" then
			mph, incl = 5, 0
		else
			mph, incl = 10 + math.floor(2 * f + r:NextNumber() * 2), 2
		end
		table.insert(program, { t = t, mph = mph, incl = incl, name = name })
		t += 5 - 0.4 * f
	end
	-- (a change of pace is a few presses: the tolerances keep a comfortable floor of 0.75 mph / 1.25 %)
	table.insert(segs, { j = "treadmill", duration = t, program = program, mph0 = 3, incl0 = 0, stepMph = 1, tolMph = 1.0 - 0.25 * f, tolIncl = 1.75 - 0.5 * f,
		mphMin = 1, mphMax = 14, inclMax = 12, gap = Wt.intro })
	-- then the ROAD PACE lane: stride with the pacer's band, breathe on the cues (every ~2.4 s)
	local legs, breaths = {}, {}
	local band = 0.13 - 0.03 * f
	for k, ph in ipairs({ { 0, 0.45, "EASY" }, { 3.5, 0.62, "PICK IT UP" }, { 7, 0.5, "SETTLE" } }) do
		legs[k] = { t = ph[1], lo = ph[2] - band, hi = ph[2] + band, name = ph[3] }
	end
	for b = 1.5, 9.6, 2.4 do
		table.insert(breaths, math.floor(b * 100 + 0.5) / 100)
	end
	table.insert(segs, { j = "road", name = "ROAD PACE", duration = 10, legs = legs, breaths = breaths, breathW = 0.4 - 0.08 * f, v0 = 0.35, kick = 0.07, decay = 0.22,
		gap = Wt.rest + Wt.round })
end
PLAN.bike = function(segs, lv, r, Wt)
	local f = lvf(lv)
	local hill = {}
	local t = 0
	local profile = { { 0, "FLAT" }, { 4 + math.floor(3 * f + r:NextNumber() * 2), "CLIMB" }, { 7 + math.floor(4 * f), "STEEP" }, { -4, "DESCENT" }, { 6 + math.floor(r:NextNumber() * 3), "FINAL CLIMB" } }
	for _, p in ipairs(profile) do
		table.insert(hill, { t = t, grade = p[1], name = p[2] })
		t += 5
	end
	table.insert(segs, { j = "bike", duration = t, hill = hill, gears = 6, gear0 = 4, lo = 58, hi = 100 - 6 * f, gap = Wt.intro })
end
PLAN.rower = function(segs, lv, r, Wt)
	local f = lvf(lv)
	local pieces = { { t = 0, spm = 20, name = "STEADY STATE" }, { t = 8, spm = 24 + math.floor(2 * f), name = "RATE UP" }, { t = 16, spm = 28 + math.floor(4 * f), name = "SPRINT FINISH" } }
	table.insert(segs, { j = "rower", duration = 24, pieces = pieces, drive = 0.8 - 0.1 * f, finishLo = 0.8 + 0.08 * f, catchW = 0.15, gap = Wt.intro })
end
PLAN.icebath = function(segs, lv, r, Wt)
	local f = lvf(lv)
	local w1 = 5 + math.floor(r:NextNumber() * 3)
	table.insert(segs, { j = "icebath", duration = 26, inhale = 3, exhale = 5, s0 = 0.35, cold = 0.045 + 0.02 * f, calmRate = 0.16, waveMult = 2.4,
		waves = { { w1, 3 }, { w1 + 10 + math.floor(r:NextNumber() * 3), 3 } }, gap = Wt.intro })
end
PLAN.stretch = function(segs, lv, r, Wt, params)
	local f = lvf(lv)
	local names = params.stretchNames or {}
	for k = 1, 4 do
		local width = 0.24 - 0.08 * f
		local lo = 0.45 + r:NextNumber() * 0.15
		table.insert(segs, { j = "stretch", name = names[k], pose = (k - 1) % 3, dur = 5, lo = lo, hi = lo + width, slide = 0.1 + 0.06 * f,
			sinkRate = 0.4, ease = 0.26, overMargin = 0.08, gap = k == 1 and Wt.intro or Wt.round })
	end
end
PLAN.massage = function(segs, lv, r, Wt, params)
	local G = W.MassageGroups
	local given = type(params.sore) == "table" and params.sore or {}
	local sore, lit = {}, 0
	for i, g in ipairs(G) do
		sore[i] = clamp(tonumber(given[g]) or 0, 0, 1)
		if sore[i] >= 0.08 then
			lit += 1
		end
	end
	-- nothing sore enough to tell apart: the therapist finds the tight spots (still on the map)
	if lit < 3 then
		for _ = 1, 4 do
			local i = r:NextInteger(1, #G)
			sore[i] = math.max(sore[i], 0.2 + r:NextNumber() * 0.6)
		end
	end
	for i = 1, #sore do
		sore[i] = math.floor(sore[i] * 100 + 0.5) / 100
	end
	table.insert(segs, { j = "massage", groups = table.clone(G), sore = sore, rounds = 3, chooseT = 6, strokes = 4, beat = 0.9, firstStroke = 0.8,
		hitW = 0.45, perfW = 0.2, gap = Wt.intro })
end
PLAN.chamber = function(segs, lv, r, Wt)
	local f = lvf(lv)
	local depth = 1.3 + 0.1 * f
	-- down to depth, a deeper stage in the middle, back to depth, then up to the surface
	table.insert(segs, { j = "chamber", duration = 26, profile = { { 0, 1 }, { 6, depth }, { 9, depth }, { 11, depth + 0.12 }, { 15, depth + 0.12 }, { 17, depth }, { 20, depth }, { 26, 1 } },
		rise = 0.12, vent = 0.1, leak = 0.025 + 0.01 * f, leakWave = 0.8,
		earRate = 2.0 + 0.5 * f, tol = 0.08 - 0.02 * f, maxP = 1.6, gap = Wt.intro })
end
PLAN.sauna = function(segs, lv, r, Wt)
	local f = lvf(lv)
	table.insert(segs, { j = "sauna", duration = 26, t0 = 0.3, heat = 0.04 + 0.01 * f, cool = 0.07, lossBase = 0.055, lossT = 0.06, goal = 1.4 + 0.2 * f, gap = Wt.intro })
end

-- the segments of a new-style drill (nil for a kind this module doesn't draw)
function W.Plan(kind, lv, params, r, Wt)
	local make = PLAN[kind]
	if not make then
		return nil
	end
	local segs = {}
	make(segs, math.max(1, lv), r, Wt, type(params) == "table" and params or {})
	return segs
end

-- DrillScore wires these in (its judges, aggregates and minimum times)
function W.Install(DrillScore, JT, AT)
	local tapHold = DrillScore.TapHold
	for name, make in pairs(J) do
		JT[name] = function(seg, M)
			return make(seg, M, tapHold)
		end
	end
	for kind, fn in pairs(AGG) do
		AT[kind] = fn
	end
end

-- the shortest honest length of a segment of these judges (DrillScore.MinTime)
function W.MinTime(seg)
	local make = J[seg.j]
	if not make then
		return nil
	end
	local ok, s = pcall(make, seg, 0, function()
		return nil
	end)
	return ok and s and s.minTime or 0
end

return W
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="61">
        <Properties>
          <string name="Name">Entrance</string>
          <string name="Source"><![CDATA[-- Entrance: the pre-fight ring walk's rules, shared by the server (RingWalk runs the beats) and the client
-- (EntranceFX films them, AnimEntrance animates them, EntrancePicker lets the player choose).
--   * Entrance.CELEBS / Entrance.ById: the entrance celebrations (walk = done in the tunnel or down the aisle, ring =
--     done in the corner once he is through the ropes; belt = needs a belt he owns)
--   * Entrance.Sanitize(choice) -> { walk1, walk2, ring, carry }: a saved / sent choice made safe (old saves: nil ->
--     the defaults); Entrance.View(profile) -> what the client's picker shows
--   * Entrance.AIPick(personality, belts, seed): an AI boxer's celebrations by his ring personality
--   * Entrance.ShouldCarry(ctx) / Entrance.CarryAfterWin(ctx): when the crowd carries him to the ring (or round the
--     ring after a big win) on their shoulders
--   * Entrance.Plan(ctx): one walk's plan (what the server sends with the "entrance" message)
--   * Entrance.Timeline(plan) -> beats, total: the beats of one walk in seconds from its message. The server waits
--     exactly this long (RingWalk) and the client cuts the camera on the same beats, so the fight starts when it
--     always would have after the last beat, and a skip ends both sides together.
-- Pure: no services, no Instances (tests require it under lune).
local Entrance = {}

------------------------------------------------------------------------
-- The celebrations
------------------------------------------------------------------------
-- dur = how long the gesture runs (s); ringDur = the time the ring beat gives it after he reaches his corner;
-- move = it plays while walking (upper body only); keyed = it owns the legs (AnimEntrance keys them)
Entrance.CELEBS = {
	{ id = "fistpump", name = "Fist Pump", desc = "Throws a glove up to the crowd and pumps it.", walk = true, ring = true, move = true, dur = 1.6, ringDur = 1.4 },
	{ id = "point", name = "Point at the Crowd", desc = "Picks out his fans and points at them.", walk = true, ring = true, move = true, dur = 1.8, ringDur = 1.4 },
	{ id = "shadowbox", name = "Shadowbox", desc = "Throws quick combinations down the aisle.", walk = true, ring = true, move = true, dur = 2.2, ringDur = 1.6 },
	{ id = "chestbeat", name = "Chest Beat", desc = "Pounds his chest with both gloves.", walk = true, ring = true, move = true, dur = 1.6, ringDur = 1.4 },
	{ id = "bow", name = "Gloves-Together Bow", desc = "Touches his gloves together and bows to the room.", walk = true, ring = true, dur = 1.6, ringDur = 1.5 },
	{ id = "shakeout", name = "Hop & Shake Out", desc = "Bounces on his toes and shakes the arms loose.", walk = true, ring = true, dur = 1.6, ringDur = 1.4 },
	{ id = "comeatme", name = "Come at Me", desc = "Arms wide, chest out: bring it on.", walk = true, ring = true, move = true, dur = 1.6, ringDur = 1.4 },
	{ id = "beltlift", name = "Belt Lift", desc = "Raises his championship belt over his head.", walk = true, ring = true, move = true, belt = true, dur = 2.0, ringDur = 1.6 },
	{ id = "stare", name = "Stare-Walk", desc = "A slow, cold walk. Eyes locked on the ring.", walk = true, move = true, dur = 3.0 },
	{ id = "turnitup", name = "Turn It Up", desc = "Palms up, pumping: louder!", walk = true, ring = true, move = true, dur = 1.6, ringDur = 1.4 },
	{ id = "victorylap", name = "Champion's Lap", desc = "Jogs a lap of his corner with a glove raised.", ring = true, keyed = true, dur = 2.2, ringDur = 2.2 },
	{ id = "turnbuckle", name = "Turnbuckle Salute", desc = "Climbs onto the ropes in his corner and salutes.", ring = true, keyed = true, dur = 2.0, ringDur = 2.0 },
}
Entrance.ById = {}
for i, c in ipairs(Entrance.CELEBS) do
	c.order = i
	Entrance.ById[c.id] = c
end
Entrance.WALK, Entrance.RING = {}, {}
for _, c in ipairs(Entrance.CELEBS) do
	if c.walk then
		table.insert(Entrance.WALK, c.id)
	end
	if c.ring then
		table.insert(Entrance.RING, c.id)
	end
end

Entrance.DEFAULT = { walk1 = "fistpump", walk2 = "point", ring = "turnbuckle", carry = true }
Entrance.NONE = "none"

local function valid(id, slot)
	if type(id) ~= "string" or #id > 24 then
		return nil
	end
	local c = Entrance.ById[id]
	if not c then
		return nil
	end
	if slot == "walk" and not c.walk then
		return nil
	end
	if slot == "ring" and not c.ring then
		return nil
	end
	return id
end
Entrance.Valid = valid

-- a choice from a save (nil on an old save) or from the client, made safe: unknown / wrong-slot ids and junk fall
-- back to the defaults, the second walk celebration may be "none" (never the same as the first), carry is on unless
-- it is explicitly false
function Entrance.Sanitize(e)
	e = type(e) == "table" and e or {}
	local D = Entrance.DEFAULT
	local out = {
		walk1 = valid(e.walk1, "walk") or D.walk1,
		walk2 = e.walk2 == Entrance.NONE and Entrance.NONE or (valid(e.walk2, "walk") or D.walk2),
		ring = valid(e.ring, "ring") or D.ring,
		carry = e.carry ~= false,
	}
	if out.walk2 == out.walk1 then
		out.walk2 = Entrance.NONE
	end
	return out
end

-- how many belts a profile holds, read defensively (the world belts, the regional / national titles, and any
-- tournament belts a newer save keeps: a table of truthy values or a list)
function Entrance.BeltCount(profile)
	if type(profile) ~= "table" then
		return 0
	end
	local n = 0
	local function count(t)
		if type(t) ~= "table" then
			return
		end
		for _, v in pairs(t) do
			if v == true or (type(v) == "table" and next(v) ~= nil) or (type(v) == "string" and v ~= "") then
				n += 1
			end
		end
	end
	count(profile.belts)
	count(profile.regional)
	count(profile.tournamentBelts)
	if type(profile.tournaments) == "table" then
		count(profile.tournaments.belts)
	end
	return n
end

-- the picker's view of a profile (Main's summary)
function Entrance.View(profile)
	local p = type(profile) == "table" and profile or {}
	return { choice = Entrance.Sanitize(p.entrance), belts = Entrance.BeltCount(p) }
end

------------------------------------------------------------------------
-- AI picks by ring personality (Config.Personalities); a champion lifts his belt first
------------------------------------------------------------------------
Entrance.AI = {
	["Trash Talker"] = { "comeatme", "point", "chestbeat" },
	["Respectful Veteran"] = { "bow", nil, "fistpump" },
	["Showman"] = { "turnitup", "shadowbox", "turnbuckle" },
	["Silent Assassin"] = { "stare", nil, "shakeout" },
	["Hothead"] = { "chestbeat", "comeatme", "comeatme" },
	["Technician"] = { "shadowbox", nil, "shakeout" },
}
function Entrance.AIPick(personality, belts, seed)
	local row = Entrance.AI[personality]
	if not row then
		-- no known personality: one of the rows by the seed, the same every time for this boxer
		local keys = { "Trash Talker", "Respectful Veteran", "Showman", "Silent Assassin", "Hothead", "Technician" }
		row = Entrance.AI[keys[(math.floor(tonumber(seed) or 0) % #keys) + 1]]
	end
	local pick = { walk1 = row[1], walk2 = row[2] or Entrance.NONE, ring = row[3], carry = false }
	if (tonumber(belts) or 0) > 0 then
		pick.walk2 = pick.walk1 ~= "stare" and pick.walk1 or Entrance.NONE
		pick.walk1 = "beltlift"
	end
	return pick
end

------------------------------------------------------------------------
-- Carried by the crowd
------------------------------------------------------------------------
-- venues with a walkway and a house to carry him (the community centre's aisle is a gym floor with folding chairs)
Entrance.CARRY_VENUES = { ClubArena = true, Arena = true, Stadium = true }
Entrance.CARRY_POP = 75 -- a fan favourite is carried into any fight
Entrance.CARRY_POP_BIG = 50 -- a well-known boxer on a big night (a title fight, or importance >= BIG)
Entrance.CARRY_BIG = 0.8
Entrance.AFTER_WIN_POP = 60 -- carried round the ring after a big non-title win (title wins are the ceremony's)

-- ctx = { popularity 0..100, importance 0..1, title, venue, spar, tutorial, ai, pref (false = the player said no) }
function Entrance.ShouldCarry(ctx)
	ctx = type(ctx) == "table" and ctx or {}
	if ctx.spar or ctx.tutorial or ctx.ai or ctx.pref == false then
		return false
	end
	if not Entrance.CARRY_VENUES[ctx.venue or ""] then
		return false
	end
	local pop = math.clamp(tonumber(ctx.popularity) or 0, 0, 100)
	local imp = math.clamp(tonumber(ctx.importance) or 0, 0, 1)
	if pop >= Entrance.CARRY_POP then
		return true
	end
	return pop >= Entrance.CARRY_POP_BIG and (ctx.title == true or imp >= Entrance.CARRY_BIG)
end

-- after the final bell: ctx as ShouldCarry plus won, method ("KO" / "TKO" / "UD" ...). A title win is the victory
-- ceremony's (another module, another trigger), never this.
function Entrance.CarryAfterWin(ctx)
	ctx = type(ctx) == "table" and ctx or {}
	if not ctx.won or ctx.title or ctx.spar or ctx.tutorial or ctx.ai or ctx.pref == false then
		return false
	end
	if not Entrance.CARRY_VENUES[ctx.venue or ""] then
		return false
	end
	local pop = math.clamp(tonumber(ctx.popularity) or 0, 0, 100)
	local imp = math.clamp(tonumber(ctx.importance) or 0, 0, 1)
	local stoppage = ctx.method == "KO" or ctx.method == "TKO"
	return pop >= Entrance.AFTER_WIN_POP and (stoppage or imp >= 0.6)
end

------------------------------------------------------------------------
-- Plans and the timeline
------------------------------------------------------------------------
-- beat lengths (s). FULL = a player's walk; SHORT = an AI opponent's (no crowd shot, no carry, one walk
-- celebration). setdown only when carried; robe only on the night's last walk (both robes come off then).
-- ring = RING_WALK (to his corner) + the ring celebration's ringDur
Entrance.FULL = { tunnel = 1.6, aisle = 2.6, crowd = 1.2, setdown = 1.0, steps = 1.2, ropes = 0.9, robe = 1.2 }
Entrance.SHORT = { tunnel = 1.0, aisle = 2.0, steps = 1.0, ropes = 0.8 }
Entrance.RING_WALK = 1.1
Entrance.SHORT_RING_MAX = 1.2
Entrance.LEAD = 0.5 -- before the first walk (the commentary line)
Entrance.SPEED = { walk = 9, carried = 7, short = 10, ring = 8 }

-- ctx = { corner "Red"|"Blue", ai, short, choice (sanitized) | nil (AI: AIPick), personality, seed, belts, popularity,
-- importance, title, venue, spar, tutorial, last, pyro }
function Entrance.Plan(ctx)
	ctx = type(ctx) == "table" and ctx or {}
	local belts = math.max(0, math.floor(tonumber(ctx.belts) or 0))
	local choice = ctx.ai and Entrance.AIPick(ctx.personality, belts, ctx.seed) or Entrance.Sanitize(ctx.choice)
	local short = ctx.ai == true or ctx.short == true
	-- the belt lift needs a belt: without one he pumps a fist instead (the choice is kept for when he wins one)
	local function resolve(id)
		if id == "beltlift" and belts <= 0 then
			return "fistpump"
		end
		return id
	end
	local walk = { resolve(choice.walk1) }
	if not short and choice.walk2 ~= Entrance.NONE then
		local w2 = resolve(choice.walk2)
		if w2 ~= walk[1] then
			table.insert(walk, w2)
		end
	end
	local ring = resolve(choice.ring)
	local carryCtx = { popularity = ctx.popularity, importance = ctx.importance, title = ctx.title, venue = ctx.venue, spar = ctx.spar,
		tutorial = ctx.tutorial, ai = ctx.ai, pref = choice.carry }
	local carry = (not short) and Entrance.ShouldCarry(carryCtx)
	local plan = {
		corner = ctx.corner == "Blue" and "Blue" or "Red",
		short = short, ai = ctx.ai == true, carry = carry, walk = walk, ring = ring,
		last = ctx.last == true, venue = ctx.venue, pyro = ctx.pyro == true, title = ctx.title == true,
		popularity = math.clamp(tonumber(ctx.popularity) or 0, 0, 100), importance = math.clamp(tonumber(ctx.importance) or 0, 0, 1),
		belt = belts > 0 and (walk[1] == "beltlift" or walk[2] == "beltlift" or ring == "beltlift"),
		pref = choice.carry, seed = math.floor(tonumber(ctx.seed) or 0),
	}
	plan.speed = short and Entrance.SPEED.short or (carry and Entrance.SPEED.carried or Entrance.SPEED.walk)
	-- eligible for the post-win carry (the client checks the result: Entrance.CarryAfterWin)
	plan.afterWin = Entrance.CarryAfterWin({ won = true, method = "KO", popularity = plan.popularity, importance = 1, title = plan.title,
		venue = plan.venue, spar = ctx.spar, tutorial = ctx.tutorial, ai = ctx.ai, pref = choice.carry })
	return plan
end

-- the ring beat's length: the walk to the corner and the celebration
function Entrance.RingTime(plan)
	local c = Entrance.ById[plan.ring] or Entrance.ById.fistpump
	local d = c.ringDur or 1.4
	if plan.short then
		d = math.min(d, Entrance.SHORT_RING_MAX)
	end
	return Entrance.RING_WALK + d
end

-- beats = { { id, t0, t1 } ... } in order, total = the walk's length. Shots and moves key off the ids:
-- tunnel (the reveal at the stage), aisle (tracking), crowd (the crowd shot), setdown (carried: put down at the
-- steps), steps (the climb), ropes (through the ropes), ring (to the corner + the ring celebration), robe
function Entrance.Timeline(plan)
	plan = type(plan) == "table" and plan or {}
	local D = plan.short and Entrance.SHORT or Entrance.FULL
	local order = { "tunnel", "aisle" }
	if not plan.short then
		table.insert(order, "crowd")
		if plan.carry then
			table.insert(order, "setdown")
		end
	end
	table.insert(order, "steps")
	table.insert(order, "ropes")
	table.insert(order, "ring")
	if plan.last then
		table.insert(order, "robe")
	end
	local beats, t = {}, 0
	for _, id in ipairs(order) do
		local d = id == "ring" and Entrance.RingTime(plan) or (D[id] or Entrance.FULL[id] or 1)
		table.insert(beats, { id = id, t0 = t, t1 = t + d })
		t += d
	end
	return beats, t
end

-- the beat at time el (s from the walk's start): beat, its index, seconds into it (nil past the end)
function Entrance.BeatAt(beats, el)
	for i, b in ipairs(beats) do
		if el < b.t1 then
			return b, i, math.max(0, el - b.t0)
		end
	end
	return nil
end

-- when each celebration plays inside a walk: { { id, t0, t1, beat } } (s from the walk's start)
function Entrance.Celebrations(plan, beats)
	local out = {}
	local function at(id)
		for _, b in ipairs(beats) do
			if b.id == id then
				return b
			end
		end
		return nil
	end
	local tb, ab, rb = at("tunnel"), at("aisle"), at("ring")
	if tb and plan.walk[1] then
		local c = Entrance.ById[plan.walk[1]]
		if c.id == "stare" then
			-- the stare is the whole walk's attitude: tunnel and aisle
			local e = at("crowd") or ab or tb
			table.insert(out, { id = c.id, t0 = tb.t0 + 0.15, t1 = e.t1, beat = "tunnel" })
		else
			table.insert(out, { id = c.id, t0 = tb.t0 + 0.15, t1 = math.min(tb.t1 + 0.3, tb.t0 + 0.15 + c.dur), beat = "tunnel" })
		end
	end
	if ab and plan.walk[2] then
		local c = Entrance.ById[plan.walk[2]]
		local e = at("crowd") or ab
		local t0 = ab.t0 + 0.5
		table.insert(out, { id = c.id, t0 = t0, t1 = c.id == "stare" and e.t1 or math.min(e.t1, t0 + c.dur), beat = "aisle" })
	end
	if rb then
		local c = Entrance.ById[plan.ring] or Entrance.ById.fistpump
		table.insert(out, { id = c.id, t0 = rb.t0 + Entrance.RING_WALK, t1 = rb.t1, beat = "ring" })
	end
	return out
end

-- the whole entrance on the server: the lead, the opponent's walk, the player's walk
function Entrance.Total(planFirst, planLast)
	local _, a = Entrance.Timeline(planFirst)
	local _, b = Entrance.Timeline(planLast)
	return Entrance.LEAD + a + b
end

return Entrance
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="62">
        <Properties>
          <string name="Name">Evasion</string>
          <string name="Source"><![CDATA[-- Evasion: the head movement and the dodges, as data (shared and pure: FightEngine runs them, FightAI picks them,
-- Keymap / ControlsMenu / the tutorial describe them, tools/sim/test_combos checks them).
--
-- Each dodge is a short EVADE WINDOW (seconds, from the press) and a longer RECOVERY (the act's length, when the
-- next action may start). A punch that arrives inside the window misses when the dodge beats its kind (the
-- `beats` share: 1 = always, 0.5 = half the time, 0 = never); one that arrives after the window but inside the
-- recovery CATCHES the fighter mid-dodge (CAUGHT_HIT more accuracy, CAUGHT_DMG more damage), so the timing has to
-- be right. A dodge that wins opens a counter window (`counter` seconds): a punch thrown in it is a counter
-- (FightEngine's counter damage) with COUNTER_HIT more accuracy, and it continues a combo chain that started with
-- the dodge (Combos: SLIP-COUNTER, WEAVE-COUNTER, DUCK-UPPERCUT, STEP-COUNTER). `punish` = what a punch of that
-- kind does to a fighter it catches in this dodge (an uppercut into a weave or a duck lands bigger).
--
-- Acts (model attribute Act, CONTRACTS section 7; the Animator plays them): slip|L / slip|R, roll (the dodge /
-- quick dodge), weave|L / weave|R (bob and weave), duck, pull (lean back), sidestep|L / sidestep|R (a step off the
-- line: the server also moves the root a little sideways, as a pivot does). A dodge that made a punch miss is
-- told to the clients as `defense` { who, move = its text, dodge = kind } (the HUD's call-out).
--
-- Stamina: `stam` per dodge (a side-step costs the most: it beats everything). A new dodge may replace one started
-- less than CANCEL seconds ago (the controller's flick-then-button chords: the flick's slip turns into the weave,
-- the duck, the pull or the side-step), with half the first one's cost given back.
local Evasion = {}

Evasion.CAUGHT_HIT, Evasion.CAUGHT_DMG = 0.1, 1.15
Evasion.COUNTER_HIT = 0.08
Evasion.CANCEL = 0.35
Evasion.GAP = 0.08 -- the shortest stretch of a dodge's recovery after its window (gap = true: the new dodges)
-- a dodge beats a punch only when it VISIBLY began before the contact: its act had this long (two frames at 60 Hz)
-- to move the head before the glove arrived, as the attacker's screen showed it (FightEngine:Evaded; a player's
-- punch also counts the delay before his client saw the dodge start). FightAI does not start a dodge it cannot get
-- going in time
Evasion.VISIBLE = 0.035

-- window = base + reflexes x Reflexes + head x HeadMovement + feet x Footwork (stats 0..100), times the
-- concussion / daze factor (FightEngine:DefenseMul)
Evasion.Moves = {
	slip = { act = "slip", sided = true, base = 0.26, reflexes = 0.003, head = 0.002, recover = 0.42, stam = 4, counter = 0.85,
		beats = { straight = 1, hook = 0.5 }, text = "SLIPPED", key = "slipL",
		desc = "Head off the line: beats straights (half the hooks)." },
	roll = { act = "roll", base = 0.30, head = 0.003, recover = 0.55, stam = 5, counter = 0.8,
		beats = { hook = 1, overhand = 1, straight = 0.5 }, punish = { uppercut = 1.4 }, text = "ROLLED UNDER", key = "dodge",
		desc = "Roll under: beats hooks and overhands (half the straights). Never into an uppercut." },
	weave = { act = "weave", sided = true, gap = true, base = 0.22, head = 0.003, reflexes = 0.001, recover = 0.5, stam = 5, counter = 0.95,
		beats = { hook = 1, overhand = 1, straight = 0.35 }, punish = { uppercut = 1.35 }, text = "WEAVED", key = "weaveL",
		desc = "Bob and weave under it to one side: beats hooks and overhands, and the counter window is the longest." },
	duck = { act = "duck", gap = true, base = 0.24, head = 0.0025, recover = 0.4, stam = 4, counter = 0.75,
		beats = { hook = 1, overhand = 0.8, straight = 0.6 }, punish = { uppercut = 1.5 }, text = "DUCKED", key = "duck",
		desc = "Drop straight down: beats hooks (most overhands and straights). An uppercut lands huge." },
	pull = { act = "pull", gap = true, base = 0.24, reflexes = 0.003, recover = 0.45, stam = 4, counter = 0.9,
		beats = { straight = 1, uppercut = 0.6, hook = 0.3 }, text = "PULLED BACK", key = "pull",
		desc = "Lean back out of range: beats straights. Hooks still find you." },
	sidestep = { act = "sidestep", sided = true, gap = true, base = 0.30, feet = 0.0025, recover = 0.55, stam = 9, counter = 0.7, body = true, step = 1.6, angle = 1.0,
		beats = { straight = 1, hook = 1, overhand = 1, uppercut = 1 }, text = "SIDESTEPPED", key = "sidestepL",
		desc = "Step off the line: beats everything, body shots too, and leaves you at an angle. The dearest on the gas." },
}
Evasion.List = { "slip", "roll", "weave", "duck", "pull", "sidestep" }

function Evasion.Window(kind, stats, defMul)
	local E = Evasion.Moves[kind]
	if not E then
		return 0
	end
	stats = type(stats) == "table" and stats or {}
	local w = E.base + (E.reflexes or 0) * (tonumber(stats.Reflexes) or 50) + (E.head or 0) * (tonumber(stats.HeadMovement) or 50)
		+ (E.feet or 0) * (tonumber(stats.Footwork) or 50)
	if E.gap then
		-- (the new dodges always leave a gap before the recovery ends: a punch that comes late catches him)
		w = math.min(w, E.recover - Evasion.GAP)
	end
	return w * (tonumber(defMul) or 1)
end

-- the act string for the model (dir = -1 left / 1 right for a sided dodge; dur = the act's length, optional: the
-- Animator reads it as the last field, "weave|L|0.50", "duck|0.40")
function Evasion.Act(kind, dir, dur)
	local E = Evasion.Moves[kind]
	if not E then
		return nil
	end
	local a = E.act
	if E.sided then
		a ..= "|" .. (dir == -1 and "L" or "R")
	end
	if tonumber(dur) then
		a ..= string.format("|%.2f", dur)
	end
	return a
end

-- does the dodge make this punch miss? (punchKind = Config.Punches[p].kind; roll = 0..1 from the server's rng)
function Evasion.Beats(kind, punchKind, body, roll)
	local E = Evasion.Moves[kind]
	if not E then
		return false
	end
	if body and not E.body then
		return false
	end
	local share = E.beats[punchKind] or 0
	return (tonumber(roll) or 0) < share
end

-- what a punch of that kind does to a fighter it catches in this dodge (damage multiplier)
function Evasion.Punish(kind, punchKind)
	local E = Evasion.Moves[kind]
	return (E and E.punish and E.punish[punchKind]) or 1
end

-- the AI: how much each style leans on its head movement (FightAI multiplies its dodge weights by it); the
-- counter-punchers and out-boxers dodge most, the swarmer weaves (peek-a-boo), the slugger mostly blocks
Evasion.StyleDodge = { CounterPuncher = 1.5, OutBoxer = 1.4, BoxerPuncher = 1.1, Swarmer = 1.15, Slugger = 0.65 }
-- each dodge's weight by the punch coming (FightAI:OnOppPunch), before the style and archetype
Evasion.AIWeights = {
	straight = { slip = 1, pull = 0.6, duck = 0.25, sidestep = 0.15 },
	hook = { weave = 1, duck = 0.6, roll = 0.5, sidestep = 0.15 },
	overhand = { weave = 0.8, roll = 0.6, duck = 0.5, sidestep = 0.2 },
	uppercut = { pull = 0.7, sidestep = 0.3 },
}
-- the style's favourite (an extra share on top): the swarmer weaves, the out-boxer steps off and pulls
Evasion.StyleFavourite = { Swarmer = "weave", OutBoxer = "sidestep", CounterPuncher = "pull", BoxerPuncher = "slip", Slugger = "duck" }

return Evasion
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="63">
        <Properties>
          <string name="Name">FightMotion</string>
          <string name="Source"><![CDATA[--!strict
-- FightMotion: shared fight-animation data (R-anim, round 2). The server picks HOW a fighter goes down
-- (from the punch, the severity and where he stands in the ring) and publishes it on the model; the
-- client's Animator (AnimDown) plays it. Pure data + pure functions: no Instances, unit-testable.
--
-- Attributes on the downed fighter's model (all set BEFORE Guard = "down"; cleared when he is up):
--   DownPose  string  how he falls. Round-1 values stay valid: back, side, knee, sit, face.
--                     Round-2 additions: flash, forward, ropes, corner, standing.
--   DownDir   number  fall direction in radians relative to his facing at the moment of the knockdown
--                     (0 = forward, pi = backward, +pi/2 = to his left, -pi/2 = to his right).
--   DownDist  number  studs from him to the ropes along DownDir; for ropes / corner falls: how far the
--                     server walks his root back into the ropes / the corner while he staggers there.
--   KOKind    string  only on a knockout (severity "out"): oneshot | delayed | standing | crumple.
--                     (crumple + back is the backward collapse: knees first, then the fold onto his back)
local FightMotion = {}

local PI = math.pi

-- every DownPose value the client understands (old first)
FightMotion.Falls = { "back", "side", "knee", "sit", "face", "flash", "forward", "ropes", "corner", "standing" }
FightMotion.ValidFall = {} :: { [string]: boolean }
for _, f in ipairs(FightMotion.Falls) do
	FightMotion.ValidFall[f] = true
end

-- KOKind values: oneshot = stiff timber fall off one punch; delayed = out on his feet for a beat, then the
-- legs go; standing = out on his feet, the referee catches him; crumple = folds where he stands
FightMotion.KOKinds = { "oneshot", "delayed", "standing", "crumple" }

-- the server can still ragdoll an out-cold NPC with physics (round 1); animated knockouts are the default
FightMotion.ANIMATED_KO = true

-- seconds the referee holds a fighter knocked out on his feet before he waves it off
FightMotion.CATCH_TIME = 2.2

-- how far inside the rope line a fighter's root stays (FightEngine:ClampToRing)
FightMotion.ROPE_MARGIN = 1.5

-- Fight spacing (studs, root to root), fitted to the rigs: with their shoulders and arms a jab lands
-- with the arm nearly straight at about 4.4, and the two guards have about a stud of air between them
-- at the AI's usual distance (0.72-0.94 of its jab range = 3.4-4.4). Round 1 used 3.5 / 2.85 / 2.6,
-- where the guards already touched.
--   base    PunchRange before the punch's Config range multiplier (jab 1.10 -> 4.73)
--   min     no punch range is shorter (uppercuts / hooks up close)
--   minSep  the bodies are never pushed closer than this (except in a clinch)
--   inside  closer than this is "inside" (hooks and uppercuts do more, straights less)
--   clinch  a clinch can be tied up from this close
--   pivot   the AI pivots off the ropes when the other man is this close
--   cover   a hurt AI covers up when the other man is this close
FightMotion.Spacing = { base = 4.3, min = 3.4, minSep = 3.25, inside = 3.65, clinch = 4.8, pivot = 3.9, cover = 5.8 }

-- The numbers above were fitted on the classic R15 body (a 2 x 1.6 x 1 UpperTorso at scale 1). Builder's
-- athletic proportions blend toward Rthro: at the same HumanoidDescription scales the chest is deeper and
-- the hands (and the gloves on them) bigger, so two guards meet a good half stud sooner. Every distance
-- grows with the pair's rig factor: the UpperTorso's depth over its DepthScale (1 on the classic rig,
-- about 1.1-1.2 on the athletic one; the depth alone when the scale is unknown). The arms' joint chain
-- is the classic length on both rigs, so a punch's reach (`base`) is the same: FightEngine keeps it.
function FightMotion.RigFactor(utDepth: number, depthScale: number?): number
	local d = (depthScale and depthScale > 0.2) and depthScale or 1
	return math.clamp(utDepth / d, 1, 1.35)
end

-- FightMotion.Spacing for a pair whose mean rig factor is k
function FightMotion.ScaledSpacing(k: number): { [string]: number }
	local out = {}
	for key, v in pairs(FightMotion.Spacing) do
		out[key] = v * k
	end
	return out
end

-- room (studs, centre to centre) a fall that folds forward needs in front of the man going down: the
-- attacker backs off to it. Fitted on a classic body about FALL_HEIGHT tall; a taller man needs more
-- (FightEngine scales it by the fallen man's standing height). The referee catches a man knocked out on
-- his feet from CATCH_DIST (scaled the same way).
FightMotion.FALL_ROOM = { face = 5.0, forward = 4.2, standing = 5.0, knee = 3.8, flash = 3.8 }
FightMotion.FALL_HEIGHT = 5.3
FightMotion.CATCH_DIST = 2.4
function FightMotion.BodyScale(height: number?): number
	return math.clamp((height or FightMotion.FALL_HEIGHT) / FightMotion.FALL_HEIGHT, 1, 1.5)
end

-- seconds the get-up takes per fall (FightEngine sends it in the getup act; the client stages it:
-- off the back he rolls to his side, onto hands and knees, one knee, then up; off the ropes he pulls
-- himself up on them). The eight count and the referee check wait for it.
local GETUP = {
	flash = 1.1, sit = 1.3, knee = 1.4, standing = 1.0, forward = 2.0, face = 2.2, back = 2.4, side = 2.3, ropes = 2.0, corner = 2.0,
}
function FightMotion.GetUpTime(fall: string?): number
	return GETUP[fall or "back"] or 2.4
end

-- wall-clock seconds from a knockout punch until the client's fall has landed and settled (the slow-motion
-- beat included). The server waits this long before the referee waves it off and the fight ends, so the
-- KO close-up and the "KO!" banner never cut away from a man still falling.
local KO_WALL = { oneshot = 1.75, crumple = 1.75, delayed = 2.6, standing = 0.6 }
function FightMotion.KOFallWall(ko: string?, pose: string?): number
	local w = KO_WALL[ko or "crumple"] or 1.75
	if pose == "ropes" or pose == "corner" then
		w += 0.35 -- the stagger into the ropes comes first
	elseif ko == "crumple" and pose == "back" then
		w += 0.2 -- the backward collapse goes down in two stages
	end
	return w
end

local function wrap(a: number): number
	return (a + PI) % (2 * PI) - PI
end

-- studs from p (ring-relative, flat) to the rope square of half-size `half` along unit direction (dx, dz)
local function ropeDistance(px: number, pz: number, dx: number, dz: number, half: number): number
	local best = 99
	if dx > 1e-3 then
		best = math.min(best, (half - px) / dx)
	elseif dx < -1e-3 then
		best = math.min(best, (-half - px) / dx)
	end
	if dz > 1e-3 then
		best = math.min(best, (half - pz) / dz)
	elseif dz < -1e-3 then
		best = math.min(best, (-half - pz) / dz)
	end
	return math.max(0, best)
end
FightMotion.ropeDistance = ropeDistance

export type FallInfo = {
	ptype: string?, -- jab / cross / leadhook / rearhook / uppercut / overhand
	kind: string?, -- Config.Punches[ptype].kind: straight / hook / uppercut / overhand
	body: boolean?,
	hand: string?, -- the punching hand, "L" / "R"
	severity: string?, -- flash / normal / heavy / out
	cause: string?, -- liver / legs / nil
	tier: number?, -- the victim's damage tier before the punch (0..3)
	counter: boolean?,
	-- geometry (flat world coordinates); any missing value disables the ring logic
	victimX: number?,
	victimZ: number?,
	victimYaw: number?, -- yaw of his facing (radians, Roblox convention: look = (-sin, 0, -cos))
	attackerX: number?,
	attackerZ: number?,
	ringX: number?,
	ringZ: number?,
	ringHalf: number?, -- rope line half size (studs)
	roll: number?, -- 0..1 random numbers from the server's rng
	roll2: number?,
}

-- moveX / moveZ: for ropes / corner falls, the flat world offset the server walks his root over while he
-- staggers into the ropes (so the body never drifts away from the root); nil otherwise
export type FallChoice = { pose: string, dir: number, dist: number, ko: string?, moveX: number?, moveZ: number? }

-- yaw of a flat world direction in the Roblox convention (look = (-sin, 0, -cos))
local function yawOf(dx: number, dz: number): number
	return math.atan2(-dx, -dz)
end

-- forward falls go past the attacker's shoulder, never through him: diagonal (about 43 degrees, so a
-- face-first timber fall of a whole body length clears a man backed off to 5 studs), to the side the
-- blow turned him (or either side for straight shots)
local function forwardDir(info: FallInfo, roll: number): number
	local kind = info.kind or "straight"
	if kind == "hook" or kind == "overhand" then
		local left = (info.hand or "R") == "L"
		if kind == "overhand" then
			left = not left
		end
		return left and 0.75 or -0.75
	end
	return roll < 0.5 and 0.72 or -0.72
end

-- the direction the blow pushes him, relative to his facing (radians, see DownDir)
local function pushDir(info: FallInfo): number
	local kind = info.kind or "straight"
	local hand = info.hand or "R"
	if info.body then
		return PI -- folds back over the shot (and down)
	elseif kind == "hook" then
		-- a left hook (from the attacker's left) lands on his right side and spins him to his left
		return hand == "L" and (PI / 2 + 0.35) or -(PI / 2 + 0.35)
	elseif kind == "overhand" then
		-- over the top: down and across, forward of his feet
		return hand == "L" and 0.6 or -0.6
	elseif kind == "uppercut" then
		return PI
	end
	return PI -- straights drive him straight back
end

-- ropes / corner falls: where his root goes and which way his back turns. Ropes: along the push until
-- the root reaches the rope margin, his back to that rope line; corner: into the corner, his back to
-- the post. DownDist becomes the length of that stagger. Without ring geometry nothing moves.
function FightMotion.RopeTravel(choice: FallChoice, info: FallInfo, push: number): FallChoice
	local half = info.ringHalf
	if not (half and info.victimX and info.victimZ and info.ringX and info.ringZ and info.victimYaw) then
		return choice
	end
	local px, pz = info.victimX - info.ringX, info.victimZ - info.ringZ
	local lim = half - FightMotion.ROPE_MARGIN
	local gx, gz, nx, nz
	if choice.pose == "corner" then
		local sx, sz = px >= 0 and 1 or -1, pz >= 0 and 1 or -1
		gx, gz = sx * lim, sz * lim
		nx, nz = sx * 0.7071, sz * 0.7071
	else
		local yaw = info.victimYaw + push
		local dx, dz = -math.sin(yaw), -math.cos(yaw)
		local t = ropeDistance(px, pz, dx, dz, lim)
		gx, gz = math.clamp(px + dx * t, -lim, lim), math.clamp(pz + dz * t, -lim, lim)
		-- the rope line he meets: the axis whose limit he reaches first
		if math.abs(math.abs(gx) - lim) <= math.abs(math.abs(gz) - lim) then
			nx, nz = gx >= 0 and 1 or -1, 0
		else
			nx, nz = 0, gz >= 0 and 1 or -1
		end
	end
	local mx, mz = gx - px, gz - pz
	choice.moveX, choice.moveZ = mx, mz
	choice.dist = math.min(math.sqrt(mx * mx + mz * mz), 20)
	-- DownDir: his back turns to the ropes / the post (where he goes, relative to his facing)
	choice.dir = wrap(yawOf(nx, nz) - info.victimYaw)
	return choice
end

-- Choose the fall. Pure: same info -> same answer.
function FightMotion.ChooseFall(info: FallInfo): FallChoice
	local sev = info.severity or "normal"
	local kind = info.kind or "straight"
	local roll = info.roll or 0.5
	local roll2 = info.roll2 or 0.5
	local dir = pushDir(info)
	-- distance to the ropes along the push (needs the ring geometry)
	local dist, nearCorner = 99, false
	local half = info.ringHalf
	if half and info.victimX and info.victimZ and info.ringX and info.ringZ and info.victimYaw then
		local px, pz = info.victimX - info.ringX, info.victimZ - info.ringZ
		local yaw = info.victimYaw + dir
		local dx, dz = -math.sin(yaw), -math.cos(yaw)
		dist = ropeDistance(px, pz, dx, dz, half)
		nearCorner = math.abs(px) > half - 3.2 and math.abs(pz) > half - 3.2
	end
	local ropesBehind = dist < 2.6
	local choice: FallChoice = { pose = "back", dir = dir, dist = math.min(dist, 20), ko = nil }

	if sev == "out" then
		-- knockouts: rare and memorable
		local hurt = (info.tier or 0) >= 2
		if info.body or info.cause == "liver" then
			-- a body shot that ends it: he folds onto his knees over it, then goes down onto his side (the
			-- Animator's koKnee: the fall's room is a kneel's, KOFallWall's crumple time)
			choice.ko, choice.pose, choice.dir = "crumple", "knee", 0
			return choice
		elseif hurt and roll < 0.3 then
			-- out on his feet: the referee catches him
			choice.ko = "standing"
			choice.pose = "standing"
			choice.dir = PI
		elseif kind == "hook" or kind == "overhand" then
			-- the lights go out mid-turn: face first, or spun to the side
			if roll < 0.45 then
				choice.ko, choice.pose, choice.dir = "oneshot", "face", forwardDir(info, roll2)
			elseif roll < 0.75 then
				choice.ko, choice.pose = "crumple", "side"
			else
				choice.ko, choice.pose, choice.dir = "delayed", "face", forwardDir(info, roll2)
			end
		else
			-- straights and uppercuts: the stiff backward fall, or the legs go a beat later
			if roll < 0.55 then
				choice.ko, choice.pose, choice.dir = "oneshot", "back", PI
			elseif roll < 0.8 then
				choice.ko, choice.pose, choice.dir = "delayed", "forward", forwardDir(info, roll2)
			else
				choice.ko, choice.pose, choice.dir = "crumple", "back", PI
			end
		end
		-- nobody timbers through the ropes: against them he slides down instead
		if choice.ko ~= "standing" and ropesBehind and math.abs(wrap(choice.dir - dir)) < 1.0 then
			choice.pose = nearCorner and "corner" or "ropes"
			choice.ko = "crumple"
			return FightMotion.RopeTravel(choice, info, dir)
		end
		return choice
	end
	if sev == "flash" then
		-- a flash knockdown: down and straight back up, more surprised than hurt
		choice.pose = roll < 0.6 and "flash" or "sit"
		return choice
	end
	if info.body or info.cause == "liver" then
		choice.pose = "knee"
		choice.dir = 0
		return choice
	end
	if info.cause == "legs" then
		-- the legs simply go: he folds forward onto a knee or his hands
		choice.pose = roll < 0.5 and "knee" or "forward"
		choice.dir = choice.pose == "forward" and forwardDir(info, roll2) or 0
		return choice
	end
	-- driven into the ropes / the corner: he sags down them
	if ropesBehind and (kind ~= "hook" or roll2 < 0.6) then
		choice.pose = nearCorner and "corner" or "ropes"
		return FightMotion.RopeTravel(choice, info, dir)
	end
	if kind == "hook" then
		choice.pose = (sev == "heavy" or roll < 0.65) and "side" or "knee"
		if choice.pose == "knee" then
			choice.dir = 0
		end
	elseif kind == "overhand" then
		choice.pose = roll < 0.6 and "forward" or "face"
		choice.dir = forwardDir(info, roll2)
	elseif kind == "uppercut" then
		choice.pose = roll < 0.6 and "back" or "sit"
	else
		-- jab / cross: a sit-down or a backward collapse (heavier shots go all the way)
		if sev == "heavy" then
			choice.pose = roll < 0.7 and "back" or "sit"
		else
			choice.pose = roll < 0.5 and "sit" or (roll < 0.8 and "back" or "forward")
			if choice.pose == "forward" then
				choice.dir = forwardDir(info, roll2)
			end
		end
	end
	return choice
end

------------------------------------------------------------------------
-- Special moves: the act "special|<id>|<hand>|<windup>|<power>" (hand and power optional). The Animator
-- plays the set-up (pre seconds: a shoulder roll, a pull back, a bob and weave, a crouch...) and then
-- throws the punch(es) listed here, each with the act's windup (a follow-up punch starts `after` x windup
-- into the first and is thrown with `wk` x windup). A hand other than the default mirrors the move
-- (a southpaw's check hook is thrown with the right hand). The server lands each punch at
-- FightMotion.SpecialHits(id, windup)[i] seconds after it sets the act.
------------------------------------------------------------------------
export type SpecialPunch = { kind: string, hand: string?, after: number?, wk: number?, zone: string? }
export type Special = { pre: number, hand: string, zone: string, punches: { SpecialPunch }, move: number?, label: string }
-- (move = how far the root should travel forward over the set-up for the move to read fully, studs;
-- negative = back. The Animator steps the feet in place; the server may move the root. A punch's own zone
-- overrides the move's: the body-head hook's first hook goes low. The punches' hands and zones match
-- Moves.Data hands / bodies.)
FightMotion.Specials = {
	checkhook = { pre = 0.06, hand = "L", zone = "head", punches = { { kind = "leadhook" } }, move = 0, label = "Check hook" },
	phillyshell = { pre = 0.3, hand = "R", zone = "head", punches = { { kind = "cross" } }, move = 0, label = "Philly shell counter" },
	pullcounter = { pre = 0.28, hand = "R", zone = "head", punches = { { kind = "cross" } }, move = 0, label = "Pull counter" },
	livershot = { pre = 0.14, hand = "L", zone = "body", punches = { { kind = "leadhook" } }, move = 0, label = "Liver shot" },
	gazelle = { pre = 0.3, hand = "L", zone = "head", punches = { { kind = "leadhook" } }, move = 1.2, label = "Gazelle punch" },
	peekaboo = { pre = 0.7, hand = "L", zone = "head", punches = { { kind = "leadhook" }, { kind = "rearhook", hand = "R", after = 0.85, wk = 0.9 } }, move = 1.5, label = "Peek-a-boo rush" },
	stepback = { pre = 0.26, hand = "R", zone = "head", punches = { { kind = "cross" } }, move = -0.8, label = "Step-back counter" },
	overhand = { pre = 0.12, hand = "R", zone = "head", punches = { { kind = "overhand" } }, move = 0, label = "Loaded overhand" },
	leaduppercut = { pre = 0.12, hand = "L", zone = "head", punches = { { kind = "uppercut" } }, move = 0, label = "Lead uppercut" },
	-- the fight moves (Moves.lua: unlocked by bouts, wins and KOs)
	doublejab = { pre = 0.06, hand = "L", zone = "head", punches = { { kind = "jab" }, { kind = "jab", hand = "L", after = 1.25, wk = 0.75 } }, move = 0.35, label = "Double jab" },
	feintcross = { pre = 0.24, hand = "R", zone = "head", punches = { { kind = "cross" } }, move = 0, label = "Feint-cross" },
	bodyhead = { pre = 0.12, hand = "L", zone = "head", punches = { { kind = "leadhook", zone = "body" }, { kind = "leadhook", hand = "L", after = 1.4, wk = 0.85 } }, move = 0, label = "Body-head hook" },
	onetwothree = { pre = 0.04, hand = "L", zone = "head", punches = { { kind = "jab" }, { kind = "cross", hand = "R", after = 0.9, wk = 1.4 }, { kind = "leadhook", hand = "L", after = 2.2, wk = 1.5 } }, move = 0.3, label = "Jab-cross-hook" },
	shovelhook = { pre = 0.14, hand = "L", zone = "head", punches = { { kind = "leadhook" } }, move = 0, label = "Shovel hook" },
} :: { [string]: Special }
-- (older names of the same moves, accepted everywhere an id is)
FightMotion.SpecialAlias = { phillycounter = "phillyshell", overhandright = "overhand" } :: { [string]: string }

-- the canonical id of a special (aliases resolved), or nil for an unknown one
function FightMotion.SpecialId(id: string?): string?
	if type(id) ~= "string" then
		return nil
	end
	id = FightMotion.SpecialAlias[id] or id
	return FightMotion.Specials[id] and id or nil
end

-- the whole move's length (s after the act starts): the last punch's contact plus its recovery
-- (the Animator drops the move then; the server should refuse the next act until about then)
function FightMotion.SpecialDuration(id: string, windup: number): number
	local sid = FightMotion.SpecialId(id)
	if not sid then
		return 0
	end
	local sp = FightMotion.Specials[sid]
	windup = math.clamp(windup, 0.08, 0.9)
	local last = sp.punches[#sp.punches]
	return sp.pre + (last.after or 0) * windup + windup * (last.wk or 1) * 2.4 + (sid == "checkhook" and 1.1 or 0)
end

-- the contact times (s after the act starts) of a special's punches, in order; {} for an unknown id
function FightMotion.SpecialHits(id: string, windup: number): { number }
	local sid = FightMotion.SpecialId(id)
	local out = {}
	if not sid then
		return out
	end
	local sp = FightMotion.Specials[sid]
	windup = math.clamp(windup, 0.08, 0.9)
	for _, pu in ipairs(sp.punches) do
		local start = sp.pre + (pu.after or 0) * windup
		table.insert(out, start + windup * (pu.wk or 1))
	end
	return out
end

return FightMotion
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="64">
        <Properties>
          <string name="Name">FightRead</string>
          <string name="Source"><![CDATA[-- FightRead: an AI's rolling read of the man in front of it (FightAI owns one per fight). Shared and pure: no Roblox
-- services, so tools/sim/test_fightai drives it directly.
--
-- Everything it counts decays with a half-life of HALF_LIFE seconds of fight time, so it reads what he is doing
-- NOW (a man who spammed the jab in round 1 and switched to the body in round 3 reads as a body puncher):
--   punches     each punch type thrown, to the head and to the body (favourite punch, head / body share)
--   follow-ups  which punch follows which (the previous token -> the next: "after his jab comes the cross")
--   combos      how long his combinations run, and what he does when one ends (punches again / blocks /
--               backs off / nothing): the AI times its attack to the end of his combinations
--   dodges      which way he slips (left / right) and which dodges he uses
--   guard       how much of the time he blocks, and how often he blocks the moment the AI throws
--   gas         how often he still throws when tired (his stamina management)
--   distance    the distance he likes to fight at
--   feints      how many of his "punches" were feints (the AI learns to stop biting)
-- The read never sees anything the AI could not see in a real ring: only what he already did.
local FightRead = {}
FightRead.__index = FightRead

FightRead.HALF_LIFE = 30
FightRead.MIN_SEEN = 4 -- weight before a prediction is trusted at all

local PUNCH_KIND = { jab = "straight", cross = "straight", leadhook = "hook", rearhook = "hook", uppercut = "uppercut", overhand = "overhand" }
FightRead.KIND = PUNCH_KIND

function FightRead.new()
	local self = setmetatable({}, FightRead)
	self.t = 0
	self.punch = {} -- ptype -> w
	self.kind = {} -- kind -> w
	self.head, self.body = 0, 0
	self.trans = {} -- prev ptype -> { ptype -> w }
	self.slip = { [-1] = 0, [1] = 0 }
	self.dodge = {} -- kind -> w
	self.blockT, self.timeT = 0, 0
	self.reactBlock, self.reactSeen = 0, 0
	self.tiredThrows, self.tiredTime = 0, 0
	self.distSum, self.distW = 0, 0
	self.feints, self.leads = 0, 0
	self.chainLen, self.chains = 0, 0
	self.after = { punch = 0, block = 0, move = 0, idle = 0 }
	self.prev = nil
	self.prevAt = -10
	self.total = 0
	return self
end

-- the decay factor for dt seconds
local function decay(dt)
	return 0.5 ^ (dt / FightRead.HALF_LIFE)
end

local function scaleMap(m, k)
	for key, v in pairs(m) do
		m[key] = v * k
	end
end

-- once a frame (or every few): the decay, the guard time, the tired time
function FightRead:Tick(dt, blocking, tired)
	if dt <= 0 then
		return
	end
	self.t += dt
	local k = decay(dt)
	scaleMap(self.punch, k)
	scaleMap(self.kind, k)
	scaleMap(self.dodge, k)
	scaleMap(self.after, k)
	for _, m in pairs(self.trans) do
		scaleMap(m, k)
	end
	self.slip[-1] *= k
	self.slip[1] *= k
	self.head *= k
	self.body *= k
	self.total *= k
	self.feints *= k
	self.leads *= k
	self.blockT = self.blockT * k + (blocking and dt or 0)
	self.timeT = self.timeT * k + dt
	self.tiredTime = self.tiredTime * k + (tired and dt or 0)
	self.tiredThrows *= k
	self.reactBlock *= k
	self.reactSeen *= k
	self.distSum *= k
	self.distW *= k
	self.chainLen *= k
	self.chains *= k
end

-- he threw a punch (chainPos = its place in his combination, 1 = an opener; dist = the distance; tired = his
-- stamina is low)
function FightRead:Punch(ptype, body, chainPos, dist, tired)
	self.punch[ptype] = (self.punch[ptype] or 0) + 1
	local kind = PUNCH_KIND[ptype] or "straight"
	self.kind[kind] = (self.kind[kind] or 0) + 1
	if body then
		self.body += 1
	else
		self.head += 1
	end
	self.total += 1
	if (tonumber(chainPos) or 1) >= 2 and self.prev then
		local m = self.trans[self.prev]
		if not m then
			m = {}
			self.trans[self.prev] = m
		end
		m[ptype] = (m[ptype] or 0) + 1
	else
		self.leads += 1
	end
	self.prev = ptype
	if tired then
		self.tiredThrows += 1
	end
	if dist then
		self.distSum += dist
		self.distW += 1
	end
end

-- he feinted (counted as a lead the AI may have bitten on)
function FightRead:Feint()
	self.feints += 1
end

-- his combination ended after n punches; what = what he did next ("punch" | "block" | "move" | "idle")
function FightRead:ComboEnd(n)
	if (tonumber(n) or 0) >= 2 then
		self.chainLen += n
		self.chains += 1
	end
	self.prev = nil
end
function FightRead:After(what)
	if self.after[what] ~= nil then
		self.after[what] += 1
	end
end

-- he dodged (kind, dir = -1 left / 1 right for a slip or a weave)
function FightRead:Dodge(kind, dir)
	self.dodge[kind] = (self.dodge[kind] or 0) + 1
	if (kind == "slip" or kind == "weave") and (dir == -1 or dir == 1) then
		self.slip[dir] += 1
	end
end

-- the AI threw at him: did he block it on the spot?
function FightRead:Reacted(blocked)
	self.reactSeen += 1
	if blocked then
		self.reactBlock += 1
	end
end

------------------------------------------------------------------------
-- What it knows
------------------------------------------------------------------------
-- his favourite punch and its share of what he throws
function FightRead:Favourite()
	local best, bw = nil, 0
	for p, w in pairs(self.punch) do
		if w > bw or (w == bw and best and p < best) then
			best, bw = p, w
		end
	end
	return best, self.total > 0 and bw / self.total or 0
end

-- the share of a punch type in what he throws
function FightRead:Share(ptype)
	return self.total > 0 and (self.punch[ptype] or 0) / self.total or 0
end
function FightRead:KindShare(kind)
	return self.total > 0 and (self.kind[kind] or 0) / self.total or 0
end

function FightRead:BodyShare()
	local n = self.head + self.body
	return n > 0 and self.body / n or 0
end

function FightRead:BlockShare()
	return self.timeT > 0 and self.blockT / self.timeT or 0
end

-- how often he blocks the moment the AI throws (0..1, 0.5 until seen)
function FightRead:ReactBlock()
	if self.reactSeen < 2 then
		return 0.5
	end
	return self.reactBlock / self.reactSeen
end

-- his slip side (-1 left / 1 right) and how one-sided it is (0 = even, 1 = always that side)
function FightRead:SlipSide()
	local l, r = self.slip[-1], self.slip[1]
	local n = l + r
	if n < 2 then
		return 0, 0
	end
	if l >= r then
		return -1, (l - r) / n
	end
	return 1, (r - l) / n
end

-- the distance he likes to fight at (nil until seen)
function FightRead:Distance()
	return self.distW > 0.5 and self.distSum / self.distW or nil
end

-- his punches per minute of read time while tired / overall: a man who keeps throwing when gassed
function FightRead:TiredOutput()
	return self.tiredTime > 1 and self.tiredThrows / self.tiredTime * 60 or 0
end

function FightRead:FeintShare()
	local n = self.feints + self.leads
	return n > 0.5 and self.feints / n or 0
end

-- the average length of his combinations (0 until seen)
function FightRead:ComboLength()
	return self.chains > 0.3 and self.chainLen / self.chains or 0
end

-- what he does most after a combination ("punch" | "block" | "move" | "idle") and its share
function FightRead:AfterCombo()
	local best, bw, n = nil, 0, 0
	for k, w in pairs(self.after) do
		n += w
		if w > bw then
			best, bw = k, w
		end
	end
	if n < 1.5 then
		return nil, 0
	end
	return best, bw / n
end

-- the punch he throws next after `prev` (nil = as a lead): ptype, confidence 0..1 (how much of his record
-- after that punch it is, scaled by how much it has seen)
function FightRead:Predict(prev)
	local m = prev and self.trans[prev]
	local src, n = m, 0
	if m then
		for _, w in pairs(m) do
			n += w
		end
	end
	if n < 1.5 then
		src, n = self.punch, self.total
	end
	if not src or n <= 0 then
		return nil, 0
	end
	local best, bw = nil, 0
	for p, w in pairs(src) do
		if w > bw or (w == bw and best and p < best) then
			best, bw = p, w
		end
	end
	local seen = math.clamp(n / FightRead.MIN_SEEN, 0, 1)
	return best, (bw / n) * seen
end

return FightRead
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="65">
        <Properties>
          <string name="Name">FrameTraits</string>
          <string name="Source"><![CDATA[-- FrameTraits: what a boxer's body frame (Config.BodyTypes: Lean, Athletic, Muscular, Power Build, Heavyweight
-- Build) does to him in the ring, for his whole career, player and AI alike. Pure data and helpers: no engine
-- state. FightEngine multiplies these in at the places marked `-- [FrameTraits]` (damage, knockdowns, stamina,
-- movement, the punch windows, the dodge windows, the clinch, the get-up); FightAI fights to its frame
-- (FrameTraits.Data[id].ai); FightClient predicts its punch windows with the same handSpeed; the Creator and the
-- fighter card read Pros / Cons / Read for the copy. (The frame's muscle cap and the one-off starting-stat mods
-- stay in Config.BodyTypes: these are the permanent traits on top.)
--
-- Every multiplier is 1 for a trait the frame does not change. The meaning of each key:
--   power        damage of his own punches (head and body)
--   kdPower      the knockdown odds of his own head shots (Power Build: the biggest single punch)
--   handSpeed    the punch wind-up (and so the recovery) is DIVIDED by it: 1.1 = 10% faster hands
--   footSpeed    his walking speed in the ring
--   tank         the size of his stamina tank (the max; the second wind and the rounds' erosion scale with it)
--   staminaDrain the stamina every punch costs
--   powerDrain   on top of it for the power punches (everything but the jab)
--   staminaRegen the stamina coming back, in the round and in the corner
--   chin         head damage taken is DIVIDED by it: 1.1 = takes 10% less
--   bodyAbsorb   body damage (and the gas it drains) is DIVIDED by it
--   reachBonus   the arm's length for the hit geometry (a long-armed frame reaches further at the same height)
--   kdResist     the odds of being dropped by a head shot are DIVIDED by it
--   getUpTime    the get-up after a knockdown (the animation and the presses the count asks for)
--   clinch       the inside work in a clinch: what he lands in it, and how long his hold keeps the other man tied up
--   insideBonus  hooks and uppercuts thrown from inside (FightMotion's inside spacing)
--   dodgeWindow  the slip / roll / weave / duck / pull / side-step / parry windows
--   target       the odds of a punch landing on him (the bigger man is the bigger target; HitGeometry already
--                reaches him sooner from his real size)
local FrameTraits = {}

FrameTraits.Keys = { "power", "kdPower", "handSpeed", "footSpeed", "tank", "staminaDrain", "powerDrain", "staminaRegen", "chin", "bodyAbsorb", "reachBonus",
	"kdResist", "getUpTime", "clinch", "insideBonus", "dodgeWindow", "target" }

-- (tuned in pairs, Boxer-Puncher vs Boxer-Puncher at level 60, both corners, on an engine whose equal men go 4+
-- rounds: Heavyweight vs Lean ~50/50, the heavyweight's wins mostly stoppages, the Lean's more often on the cards -
-- tools/sim/test_frametraits; the Lean's finishing power and chin are what keep his speed from winning by stoppage).
-- Retuned with the busier AI and the engine's damage rebalance (fights 5+ rounds at 40-50 punches a minute): the
-- heavy frames' gas (tank / drain / regen), the heavyweight's target, hands and dodge and his chin, knockdown
-- resistance and power moved up and the Lean's power down - on the old short slugfests the heavyweight's stamina
-- never came into it; in fights that go deep it lost him every fight (Heavyweight vs Lean 16%, Lean the stopper)
-- ai: how the AI fights to the frame. range = its preferred distance as a share of the jab range (added to the
-- style's); aggr = aggression added; clinch = the chance per decision inside clinch range to tie up (on top of a
-- hurt man's); inside = weight on hooks / uppercuts (under 1: the straights); press = cuts the ring more
FrameTraits.Data = {
	Lean = {
		name = "Lean", short = "Lean", tag = "Fast hands, long jab",
		power = 0.86, kdPower = 0.80, handSpeed = 1.12, footSpeed = 1.08, tank = 1.04, staminaDrain = 0.92, powerDrain = 1, staminaRegen = 1.10,
		chin = 0.94, bodyAbsorb = 0.90, reachBonus = 1.04, kdResist = 0.96, getUpTime = 0.95, clinch = 0.88, insideBonus = 0.95, dodgeWindow = 1.15, target = 0.92,
		ai = { range = 0.04, aggr = 0.02, clinch = 0.0, inside = 0.8, press = 0 },
		pros = { "Fastest hands: shorter punch windows, quicker recovery", "Quick feet and longer slip and dodge windows", "Spends less stamina a punch, recovers more", "Long arms: reaches further at the same height" },
		cons = { "Less power behind every punch", "A softer chin: goes down easier", "Body shots hurt more and take more gas" },
	},
	Athletic = {
		name = "Athletic", short = "Athletic", tag = "The all-rounder",
		power = 1, kdPower = 1, handSpeed = 1, footSpeed = 1, tank = 1.02, staminaDrain = 0.97, powerDrain = 1, staminaRegen = 1.05,
		chin = 1, bodyAbsorb = 1, reachBonus = 1, kdResist = 1, getUpTime = 1, clinch = 1, insideBonus = 1, dodgeWindow = 1, target = 1,
		ai = { range = 0, aggr = 0, clinch = 0, inside = 1, press = 0 },
		pros = { "No weaknesses: the baseline frame", "A little more stamina and recovery" },
		cons = { "No standout strength either" },
	},
	Muscular = {
		name = "Muscular", short = "Muscular", tag = "Power with a chin",
		power = 1.04, kdPower = 1.02, handSpeed = 0.97, footSpeed = 1, tank = 1, staminaDrain = 1, powerDrain = 1.06, staminaRegen = 1,
		chin = 1.03, bodyAbsorb = 1.02, reachBonus = 1, kdResist = 1.03, getUpTime = 1, clinch = 1.04, insideBonus = 1.03, dodgeWindow = 0.98, target = 1.01,
		ai = { range = -0.02, aggr = 0.04, clinch = 0.02, inside = 1.08, press = 0.05 },
		pros = { "More power in every punch", "A better chin, harder to drop", "Normal footwork" },
		cons = { "Slightly slower hands", "Power punches drain a little more stamina" },
	},
	["Power Build"] = {
		name = "Power Build", short = "Power", tag = "One-punch power inside",
		power = 1.04, kdPower = 1.05, handSpeed = 0.95, footSpeed = 0.94, tank = 0.99, staminaDrain = 1.01, powerDrain = 1.06, staminaRegen = 0.97,
		chin = 1.03, bodyAbsorb = 1.04, reachBonus = 1, kdResist = 1.05, getUpTime = 1.05, clinch = 1.12, insideBonus = 1.06, dodgeWindow = 0.96, target = 1.01,
		ai = { range = -0.08, aggr = 0.08, clinch = 0.06, inside = 1.2, press = 0.12 },
		pros = { "The biggest single punch and knockdown chance", "A hard chin: very hard to drop", "Strong in the clinch and inside: hooks and uppercuts land harder" },
		cons = { "Slower hands and feet", "Gasses in the later rounds", "Easier to outbox at range" },
	},
	["Heavyweight Build"] = {
		name = "Heavyweight Build", short = "Heavyweight", tag = "Raw power, slow burn",
		power = 1.08, kdPower = 1.03, handSpeed = 0.90, footSpeed = 0.88, tank = 0.97, staminaDrain = 1.03, powerDrain = 1.06, staminaRegen = 0.93,
		chin = 1.12, bodyAbsorb = 1.12, reachBonus = 1, kdResist = 1.18, getUpTime = 1.18, clinch = 1.20, insideBonus = 1.06, dodgeWindow = 0.94, target = 1.03,
		ai = { range = -0.10, aggr = 0.1, clinch = 0.09, inside = 1.2, press = 0.15 },
		pros = { "The strongest raw power", "Absorbs body shots best and is the hardest to knock down", "The heaviest clinch: holds and wears the other man" },
		cons = { "The slowest feet and hands", "The worst stamina", "The biggest target, and slower up off the canvas" },
	},
}
FrameTraits.Order = { "Lean", "Athletic", "Muscular", "Power Build", "Heavyweight Build" }

-- [FrameTraits] how fast the frame's stats grow in training (Training.GainMultiplier): small, the frame's nature.
-- A stat not listed grows at the usual rate.
FrameTraits.Growth = {
	Lean = { PunchSpeed = 1.08, Footwork = 1.08, Reflexes = 1.05, Power = 0.94, Chin = 0.95 },
	Athletic = { Stamina = 1.04, Recovery = 1.04 },
	Muscular = { Power = 1.05, Chin = 1.04, PunchSpeed = 0.97 },
	["Power Build"] = { Power = 1.08, Chin = 1.06, PunchSpeed = 0.95, Footwork = 0.95 },
	["Heavyweight Build"] = { Power = 1.08, Chin = 1.08, Endurance = 1.04, PunchSpeed = 0.94, Footwork = 0.93, Stamina = 0.96 },
}
function FrameTraits.GrowthMul(id, statKey)
	local g = FrameTraits.Growth[id]
	local v = g and g[statKey]
	return type(v) == "number" and v or 1
end

local NEUTRAL = {}
for _, k in ipairs(FrameTraits.Keys) do
	NEUTRAL[k] = 1
end
NEUTRAL.name, NEUTRAL.short, NEUTRAL.tag, NEUTRAL.ai, NEUTRAL.pros, NEUTRAL.cons = "Athletic", "Athletic", "", { range = 0, aggr = 0, clinch = 0, inside = 1, press = 0 }, {}, {}
FrameTraits.Neutral = NEUTRAL

-- the traits of a frame id (an unknown / missing id: Athletic's, the baseline)
function FrameTraits.Get(id)
	return FrameTraits.Data[id] or FrameTraits.Data.Athletic or NEUTRAL
end

-- the frame id of a fighter's data (FightEngine: data.app.body.frame; a profile summary: appearance.body.frame)
function FrameTraits.IdOf(data)
	local app = type(data) == "table" and (data.app or data.appearance) or nil
	local body = type(app) == "table" and app.body or nil
	local id = type(body) == "table" and body.frame or nil
	return FrameTraits.Data[id] and id or "Athletic"
end

function FrameTraits.For(data)
	return FrameTraits.Get(FrameTraits.IdOf(data))
end

-- one multiplier, 1 when the id or the key is unknown
function FrameTraits.Mul(id, key)
	local t = FrameTraits.Data[id]
	local v = t and t[key]
	return type(v) == "number" and v or 1
end

-- the short read for the opponent's scouting line and the fighter card: "Heavyweight - raw power, slow burn"
function FrameTraits.Read(id)
	local t = FrameTraits.Data[id]
	if not t then
		return nil
	end
	return string.format("%s - %s", t.short, string.lower(t.tag))
end

-- the pros / cons lists (copies) for the UI
function FrameTraits.Pros(id)
	return table.clone(FrameTraits.Get(id).pros)
end
function FrameTraits.Cons(id)
	return table.clone(FrameTraits.Get(id).cons)
end

-- the display name of a frame ("Heavyweight" for "Heavyweight Build")
function FrameTraits.ShortName(id)
	local t = FrameTraits.Data[id]
	return t and t.short or tostring(id or "?"):gsub(" Build$", "")
end

return FrameTraits
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="66">
        <Properties>
          <string name="Name">Gamepad</string>
          <string name="Source"><![CDATA[-- Gamepad: which device the player is using right now (keyboard and mouse, gamepad or touch), the names
-- of the controller's buttons for on-screen prompts and a thumbstick flick detector.
--   Gamepad.Mode()          "keyboard" | "gamepad" | "touch" (follows UserInputService's last input type)
--   Gamepad.IsPad()         Mode() == "gamepad"
--   Gamepad.Changed         fires (mode) when the player picks up another device
--   Gamepad.Brand()         "xbox" | "ps" | "generic" (read from the connected controller's button names)
--   Gamepad.Label(keyCode)  "X" / "SQUARE" / "RT" / "R2" / "D-PAD UP" / "RS LEFT" ... and keyboard keys
--                           ("SPACE", "1", "SHIFT") for the hint texts
--   Gamepad.Short(keyCode)  the same for tight key caps (the D-pad as "D-UP" ...)
--   Gamepad.IsPadKey(k)     a gamepad KeyCode (buttons, D-pad, thumbsticks)
--   Gamepad.Flick()         a flick detector: f:Update(x, y, now) returns "L" / "R" / "U" / "D" once per flick
--   Gamepad.Rumble(large, small, dur)  controller vibration through HapticService (0..1 each motor, dur s),
--                           scaled by Gamepad.SetVibration(k) (0 = off; the Settings toggle / strength)
-- Client-side; the server never needs it (it loads there and stays in "keyboard" mode).
local UserInputService = game:GetService("UserInputService")
local K = Enum.KeyCode
local IT = Enum.UserInputType

local Gamepad = {}

local PAD_TYPES = {
	[IT.Gamepad1] = true, [IT.Gamepad2] = true, [IT.Gamepad3] = true, [IT.Gamepad4] = true,
	[IT.Gamepad5] = true, [IT.Gamepad6] = true, [IT.Gamepad7] = true, [IT.Gamepad8] = true,
}
-- mouse movement alone does not switch the prompts back to keys: a desk bump while playing on a pad
-- would flicker every hint on screen (a click or a key press does)
local KEYBOARD_TYPES = {
	[IT.Keyboard] = true, [IT.MouseButton1] = true, [IT.MouseButton2] = true, [IT.MouseButton3] = true,
	[IT.MouseWheel] = true, [IT.TextInput] = true,
}

local function modeOf(t)
	if PAD_TYPES[t] then
		return "gamepad"
	elseif t == IT.Touch then
		return "touch"
	elseif KEYBOARD_TYPES[t] then
		return "keyboard"
	end
	return nil
end

local function initialMode()
	local ok, t = pcall(UserInputService.GetLastInputType, UserInputService)
	local m = ok and modeOf(t) or nil
	if m then
		return m
	end
	local okPad, pad = pcall(function()
		return UserInputService.GamepadEnabled
	end)
	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		return "touch"
	elseif okPad and pad and not UserInputService.KeyboardEnabled then
		return "gamepad" -- a console
	end
	return "keyboard"
end

local mode = initialMode()
local brand = nil -- resolved on first use, again after a controller connects
local changed = Instance.new("BindableEvent")
Gamepad.Changed = changed.Event

function Gamepad.Mode()
	return mode
end

function Gamepad.IsPad()
	return mode == "gamepad"
end

UserInputService.LastInputTypeChanged:Connect(function(t)
	local m = modeOf(t)
	if m and m ~= mode then
		mode = m
		changed:Fire(mode)
	end
end)
UserInputService.GamepadConnected:Connect(function()
	brand = nil
end)

-- GetStringForKeyCode names the face buttons after the connected controller: "ButtonA" on an Xbox pad,
-- "ButtonCross" on a PlayStation one
function Gamepad.Brand()
	if brand then
		return brand
	end
	local ok, s = pcall(UserInputService.GetStringForKeyCode, UserInputService, K.ButtonA)
	if ok and type(s) == "string" and s:find("Cross", 1, true) then
		brand = "ps"
	elseif ok and s == "ButtonA" then
		brand = "xbox"
	else
		brand = "generic"
	end
	return brand
end

local XBOX = {
	[K.ButtonA] = "A", [K.ButtonB] = "B", [K.ButtonX] = "X", [K.ButtonY] = "Y",
	[K.ButtonL1] = "LB", [K.ButtonR1] = "RB", [K.ButtonL2] = "LT", [K.ButtonR2] = "RT",
	[K.ButtonL3] = "LS CLICK", [K.ButtonR3] = "RS CLICK", [K.ButtonSelect] = "VIEW", [K.ButtonStart] = "MENU",
	[K.Thumbstick1] = "LS", [K.Thumbstick2] = "RS",
}
local PS = {
	[K.ButtonA] = "CROSS", [K.ButtonB] = "CIRCLE", [K.ButtonX] = "SQUARE", [K.ButtonY] = "TRIANGLE",
	[K.ButtonL1] = "L1", [K.ButtonR1] = "R1", [K.ButtonL2] = "L2", [K.ButtonR2] = "R2",
	[K.ButtonL3] = "L3", [K.ButtonR3] = "R3", [K.ButtonSelect] = "SHARE", [K.ButtonStart] = "OPTIONS",
	[K.Thumbstick1] = "LS", [K.Thumbstick2] = "RS",
}
local COMMON = {
	[K.DPadUp] = "D-PAD UP", [K.DPadDown] = "D-PAD DOWN", [K.DPadLeft] = "D-PAD LEFT", [K.DPadRight] = "D-PAD RIGHT",
	-- the right-stick flicks (slips, rolls) ride on these KeyCodes in the key maps
	[K.Thumbstick2Left] = "RS LEFT", [K.Thumbstick2Right] = "RS RIGHT", [K.Thumbstick2Up] = "RS UP", [K.Thumbstick2Down] = "RS DOWN",
	[K.Thumbstick1Left] = "LS LEFT", [K.Thumbstick1Right] = "LS RIGHT", [K.Thumbstick1Up] = "LS UP", [K.Thumbstick1Down] = "LS DOWN",
}
local KEYS = {
	[K.Space] = "SPACE", [K.LeftShift] = "SHIFT", [K.RightShift] = "SHIFT", [K.Return] = "ENTER", [K.Backspace] = "BACKSPACE",
	[K.One] = "1", [K.Two] = "2", [K.Three] = "3", [K.Four] = "4", [K.Five] = "5", [K.Six] = "6", [K.Semicolon] = ";",
	[K.Seven] = "7", [K.Eight] = "8", [K.Nine] = "9", [K.Zero] = "0", [K.Tab] = "TAB", [K.LeftControl] = "CTRL", [K.RightControl] = "CTRL",
	[K.LeftAlt] = "ALT", [K.RightAlt] = "ALT", [K.Comma] = ",", [K.Period] = ".", [K.CapsLock] = "CAPS",
	[K.Up] = "UP", [K.Down] = "DOWN", [K.Left] = "LEFT", [K.Right] = "RIGHT",
}

function Gamepad.Label(k)
	if typeof(k) ~= "EnumItem" then
		return ""
	end
	local t = (Gamepad.Brand() == "ps" and PS or XBOX)[k] or COMMON[k] or KEYS[k]
	return t or string.upper(k.Name)
end

-- a short name for tight key caps (HUD buttons): the D-pad as "D-UP" / "D-DOWN" / ...
local SHORT = { [K.DPadUp] = "D-UP", [K.DPadDown] = "D-DOWN", [K.DPadLeft] = "D-LEFT", [K.DPadRight] = "D-RIGHT" }
function Gamepad.Short(k)
	return SHORT[k] or Gamepad.Label(k)
end

function Gamepad.IsPadKey(k)
	if typeof(k) ~= "EnumItem" or k.EnumType ~= Enum.KeyCode then
		return false
	end
	local n = k.Name
	return n:sub(1, 6) == "Button" or n:sub(1, 4) == "DPad" or n:sub(1, 10) == "Thumbstick"
end

-- the flick detector: the stick has to travel from near rest (inside INNER) to the edge (OUTER) within
-- WINDOW seconds of leaving the middle; it fires once, then re-arms when the stick comes back toward the
-- middle. A slow push or a held stick never repeats. Plain fields only: Update allocates nothing.
local Flick = {}
Flick.__index = Flick
local INNER, OUTER, WINDOW = 0.3, 0.72, 0.3

function Gamepad.Flick()
	return setmetatable({ armed = true, leftAt = nil }, Flick)
end

function Flick:Update(x, y, now)
	x, y = tonumber(x) or 0, tonumber(y) or 0
	local m = math.sqrt(x * x + y * y)
	if m < INNER then
		self.armed = true
		self.leftAt = nil
		return nil
	end
	if not self.leftAt then
		self.leftAt = now
	end
	if self.armed and m >= OUTER then
		self.armed = false
		if now - self.leftAt > WINDOW then
			return nil
		end
		if math.abs(x) >= math.abs(y) then
			return x < 0 and "L" or "R"
		end
		return y < 0 and "D" or "U"
	end
	return nil
end

function Flick:Reset()
	self.armed = true
	self.leftAt = nil
end

------------------------------------------------------------------------
-- Vibration (HapticService): every call is guarded, a controller without motors is a silent no-op.
-- Pulses overlap sanely: a stronger pulse replaces a weaker one, each motor idles once its own pulse ends.
------------------------------------------------------------------------
local vibration = 1
local rumble = { token = 0 }
local HapticService
function Gamepad.SetVibration(k)
	vibration = math.clamp(tonumber(k) or 0, 0, 1)
	if vibration <= 0 then
		Gamepad.Rumble(0, 0, 0)
	end
end

function Gamepad.Vibration()
	return vibration
end

local function motor(name, k)
	if not HapticService then
		local ok, svc = pcall(game.GetService, game, "HapticService")
		HapticService = ok and svc or false
	end
	if not HapticService then
		return false
	end
	local ok = pcall(HapticService.SetMotor, HapticService, IT.Gamepad1, Enum.VibrationMotor[name], k)
	return ok
end

-- large / small = 0..1 motor strengths, dur = seconds (default 0.15); returns true when a call went through
function Gamepad.Rumble(large, small, dur)
	large = math.clamp((tonumber(large) or 0) * vibration, 0, 1)
	small = math.clamp((tonumber(small) or 0) * vibration, 0, 1)
	if large <= 0 and small <= 0 then
		rumble.token += 1
		motor("Large", 0)
		motor("Small", 0)
		return false
	end
	if mode ~= "gamepad" then
		return false
	end
	local ok = motor("Large", large)
	motor("Small", small)
	rumble.token += 1
	local token = rumble.token
	task.delay(dur or 0.15, function()
		if rumble.token == token then
			motor("Large", 0)
			motor("Small", 0)
		end
	end)
	return ok
end

return Gamepad
