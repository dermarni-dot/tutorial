	{ id = "ToyStore", label = "Toys", emoji = "🧸", kind = "store" },
	{ id = "Electronics", label = "Electronics", emoji = "📱", kind = "store" },
	{ id = "Florist", label = "Flowers", emoji = "💐", kind = "store" },
	{ id = "PetShop", label = "Pet Shop", emoji = "🐶", kind = "store" },
