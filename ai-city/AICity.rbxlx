	C(c, 0.5, 0.5, 0.82, GOLD, { grad = { GOLD_LIGHT, GOLD, 90 } })
	O(c, 0.5, 0.5, 0.62, 0.05, GOLD_DARK, { t = 0.3 })
	T(c, 0.5, 0.51, 0.36, "★", GOLD_DARK)
	R(c, 0.33, 0.28, 0.16, 0.06, WHITE, { r = 0.5, rot = -40, t = 0.3 })
end

D.heart = function(c)
