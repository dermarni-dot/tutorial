	part(f, head, "CapBrim", Vector3.new(w * 0.9, 0.08, h.Z * 0.5), CFrame.new(0, top - h.Y * 0.15, -h.Z * 0.7), c:Lerp(rgb(0, 0, 0), 0.15))
end
FASHION.Beanie = function(f, ch, head, c)
