	{ title = "Night Officer", place = "PoliceStation", slots = 2, start = 18, stop = 24, pay = 18 },
	{ title = "Teacher", place = "School", slots = 3, start = 7, stop = 15, pay = 14 },
	{ title = "Factory Worker", place = "Factory", slots = 6, start = 6, stop = 15, pay = 12 },
