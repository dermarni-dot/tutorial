	attach(f, lower, "Wrench", Vector3.new(0.14, 0.8, 0.1), CFrame.new(lower.Size.X * 0.45, -0.3, -lower.Size.Z / 2 - 0.08), SILVER, nil, Enum.Material.Metal)
end
function ITEMS.Smudge(f, b)
