	MapKit.ball(r.B.Model, "ToyBall", 0.8, r.At(x - 0.6, 1.9, z), MapKit.FLOWERS[r.Rng:NextInteger(1, #MapKit.FLOWERS)], Enum.Material.SmoothPlastic)
