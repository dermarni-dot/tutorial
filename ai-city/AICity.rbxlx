	if arm then
		attach(f, arm, "Watch", Vector3.new(arm.Size.X + 0.06, 0.16, arm.Size.Z + 0.06), CFrame.new(0, if b.R15 then arm.Size.Y / 2 else -arm.Size.Y / 2 + 0.5, 0), GOLD, nil, Enum.Material.Metal)
	end
end
