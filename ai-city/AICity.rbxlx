	for k = 0, 2 do
		r.Box("Shoe", Vector3.new(0.5, 0.4, 1), x - 1 + k * 1, 0.2, z, ({ rgb(30, 30, 34), rgb(240, 240, 240), rgb(160, 60, 50) })[k + 1], Enum.Material.Leather)
	end
