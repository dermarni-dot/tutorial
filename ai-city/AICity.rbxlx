			attach(f, hand, "Wristband", Vector3.new(hand.Size.X + 0.08, 0.2, hand.Size.Z + 0.08), CFrame.new(0, if b.R15 then hand.Size.Y / 2 else -hand.Size.Y / 2 + 0.55, 0), WHITE, nil, Enum.Material.Fabric)
		end
	end
end
